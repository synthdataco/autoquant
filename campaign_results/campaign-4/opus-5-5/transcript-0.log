{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01L6hx4pYdZwkLzBcJzGDnuj","type":"tool_result","content":"\"\"\"Fit a horizon-bucketed log-HAR for the deseasonalised variance level by QLIKE.\n\nf_B = exp(b0_B + sum_i b_iB * log(feature_i / l7d)) * l7d for horizon bucket B.\nFitted on hourly points before --split; reports out-of-sample QLIKE vs the v1 blend.\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport sys\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import minimize\nsys.path.insert(0, \"agent\")\nfrom volstudy import zseries\n\nCRYPTO = [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"]\nEQU = [\"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\"]\nHLS = [15, 60, 240, 720, 1440]\nBUCKETS = [(0, 5), (5, 15), (15, 60), (60, 180), (180, 480), (480, 1440)]\n\n\ndef build(asset):\n    z = zseries(asset)\n    z = z.where(np.isfinite(z))\n    F = {f\"e{h}\": z.ewm(halflife=h, ignore_na=True, min_periods=h).mean() for h in HLS}\n    F[\"l7d\"] = z.rolling(7 * 1440, min_periods=3 * 1440).mean()\n    F = pd.DataFrame(F)\n    cs = z.fillna(0).cumsum()\n    cnt = z.notna().astype(float).cumsum()\n    Y = {}\n    for a, b in BUCKETS:\n        s = cs.shift(-b) - cs.shift(-a)\n        n = cnt.shift(-b) - cnt.shift(-a)\n        Y[f\"y{a}_{b}\"] = (s / n).where(n >= 0.5 * (b - a))\n    D = pd.concat([F, pd.DataFrame(Y)], axis=1).iloc[::60].dropna()\n    D[\"asset\"] = asset\n    return D\n\n\ndef X_of(D):\n    l = D[\"l7d\"].clip(lower=1e-12)\n\n\nif __name__ == \"__main__\":\n    split = pd.Timestamp(sys.argv[1] if len(sys.argv) > 1 else \"2026-08-01\", tz=\"UTC\")\n    data = {a: build(a) for a in CRYPTO + EQU}\n    coefs = {}\n    for gname, assets in ((\"crypto\", CRYPTO), (\"equ\", EQU)):\n        D = pd.concat([data[a] for a in assets])\n        tr, te = D[D.index < split], D[D.index >= split]\n        coefs[gname] = {}\n        for a, b in BUCKETS:\n            yc = f\"y{a}_{b}\"\n            beta = fit(tr, yc)\n            coefs[gname][yc] = beta.tolist()\n            Xt, lt = X_of(te)\n            fh = np.exp(Xt @ beta) * lt\n            res = []\n            for asset in assets:\n                m = (te.asset == asset).to_numpy()\n                yt = te[yc].to_numpy()[m]\n                res.append((asset, qlike(yt, fh[m]), qlike(yt, v1_blend(te[m], (a + b) / 2)), qlike(yt, te[\"l7d\"].to_numpy()[m])))\n            r = pd.DataFrame(res, columns=[\"asset\", \"har\", \"v1\", \"l7d\"]).set_index(\"asset\")\n            print(gname, yc, \"beta\", np.round(beta, 3), \"\\n\", r.round(4).T.to_string())\n    json.dump({\"hls\": HLS, \"buckets\": BUCKETS, \"coefs\": coefs}, open(f\"agent/artifacts/har_{split.date()}.json\", \"w\"), indent=1)\n1:\"\"\"Vol-level forecast study (no simulation): QLIKE of candidate deseasonalised-variance forecasts\n2:against realised deseasonalised variance over the next H minutes, on an hourly grid.\"\"\"\n10:SEASON = np.load(\"agent/artifacts/season_2026-08-01.npz\")\n19:    return r2 / SEASON[asset][b]","is_error":false}]},"parent_tool_use_id":null,"session_id":"2d6fedfa-14d9-4a81-8f98-858ec201a373","uuid":"ba8f644a-2c58-44dc-b89a-7e558bf8dee4","timestamp":"2026-09-30T06:06:51.892Z","tool_use_result":{"stdout":"\"\"\"Fit a horizon-bucketed log-HAR for the deseasonalised variance level by QLIKE.\n\nf_B = exp(b0_B + sum_i b_iB * log(feature_i / l7d)) * l7d for horizon bucket B.\nFitted on hourly points before --split; reports out-of-sample QLIKE vs the v1 blend.\n\"\"\"\nfrom __future__ import annotations\nimport json\nimport sys\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import minimize\nsys.path.insert(0, \"agent\")\nfrom volstudy import zseries\n\nCRYPTO = [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"]\nEQU = [\"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\"]\nHLS = [15, 60, 240, 720, 1440]\nBUCKETS = [(0, 5), (5, 15), (15, 60), (60, 180), (180, 480), (480, 1440)]\n\n\ndef build(asset):\n    z = zseries(asset)\n    z = z.where(np.isfinite(z))\n    F = {f\"e{h}\": z.ewm(halflife=h, ignore_na=True, min_periods=h).mean() for h in HLS}\n    F[\"l7d\"] = z.rolling(7 * 1440, min_periods=3 * 1440).mean()\n    F = pd.DataFrame(F)\n    cs = z.fillna(0).cumsum()\n    cnt = z.notna().astype(float).cumsum()\n    Y = {}\n    for a, b in BUCKETS:\n        s = cs.shift(-b) - cs.shift(-a)\n        n = cnt.shift(-b) - cnt.shift(-a)\n        Y[f\"y{a}_{b}\"] = (s / n).where(n >= 0.5 * (b - a))\n    D = pd.concat([F, pd.DataFrame(Y)], axis=1).iloc[::60].dropna()\n    D[\"asset\"] = asset\n    return D\n\n\ndef X_of(D):\n    l = D[\"l7d\"].clip(lower=1e-12)\n\n\nif __name__ == \"__main__\":\n    split = pd.Timestamp(sys.argv[1] if len(sys.argv) > 1 else \"2026-08-01\", tz=\"UTC\")\n    data = {a: build(a) for a in CRYPTO + EQU}\n    coefs = {}\n    for gname, assets in ((\"crypto\", CRYPTO), (\"equ\", EQU)):\n        D = pd.concat([data[a] for a in assets])\n        tr, te = D[D.index < split], D[D.index >= split]\n        coefs[gname] = {}\n        for a, b in BUCKETS:\n            yc = f\"y{a}_{b}\"\n            beta = fit(tr, yc)\n            coefs[gname][yc] = beta.tolist()\n            Xt, lt = X_of(te)\n            fh = np.exp(Xt @ beta) * lt\n            res = []\n            for asset in assets:\n                m = (te.asset == asset).to_numpy()\n                yt = te[yc].to_numpy()[m]\n                res.append((asset, qlike(yt, fh[m]), qlike(yt, v1_blend(te[m], (a + b) / 2)), qlike(yt, te[\"l7d\"].to_numpy()[m])))\n            r = pd.DataFrame(res, columns=[\"asset\", \"har\", \"v1\", \"l7d\"]).set_index(\"asset\")\n            print(gname, yc, \"beta\", np.round(beta, 3), \"\\n\", r.round(4).T.to_string())\n    json.dump({\"hls\": HLS, \"buckets\": BUCKETS, \"coefs\": coefs}, open(f\"agent/artifacts/har_{split.date()}.json\", \"w\"), indent=1)\n1:\"\"\"Vol-level forecast study (no simulation): QLIKE of candidate deseasonalised-variance forecasts\n2:against realised deseasonalised variance over the next H minutes, on an hourly grid.\"\"\"\n10:SEASON = np.load(\"agent/artifacts/season_2026-08-01.npz\")\n19:    return r2 / SEASON[asset][b]","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
