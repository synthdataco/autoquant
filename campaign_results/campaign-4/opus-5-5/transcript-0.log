 < cutoff) & (c.index >= cutoff - pd.Timedelta(days=days))]","+    c5 = c.ffill().resample(\"5min\").last()","+    zero = (c5.diff() == 0).astype(float)[c5.diff().notna()]","+    w = 0.5 ** ((cutoff - zero.index).total_seconds().to_numpy() / 86400 / hl_days)","+    b = week_bin(zero.index)","+    p = np.bincount(b, weights=zero.to_numpy() * w, minlength=NB) / np.maximum(np.bincount(b, weights=w, minlength=NB), 1e-12)","+    p = p.reshape(7, 288)","+    pooled = p[0:4].mean(0)","+    for d in range(0, 5):","+        p[d] = wd_pool * pooled + (1 - wd_pool) * p[d]","+    return np.clip(p.reshape(-1), 0, 0.95)","+","+","+if __name__ == \"__main__\":","+    ap = argparse.ArgumentParser()","+    ap.add_argument(\"--cutoff\", required=True)","+    ap.add_argument(\"--days\", type=int, default=180)","+    ap.add_argument(\"--hl-days\", type=float, default=30.0)","+    ap.add_argument(\"--wd-pool\", type=float, default=0.5)","+    ap.add_argument(\"--out\", required=True)","+    a = ap.parse_args()","+    cutoff = pd.Timestamp(a.cutoff, tz=\"UTC\")","+    ps = {x: fit_one(x, cutoff, a.days, a.hl_days, a.wd_pool) for x in ASSETS}","+    np.savez(a.out, **ps)","+    for x, p in ps.items():","+        q = p.reshape(7, 288)","+        print(f\"{x:7s} mean {p.mean():.3f} wkday {q[:5].mean():.3f} sat {q[5].mean():.3f} sun {q[6].mean():.3f}\")"]}],"created":true}],"moreFiles":2,"changedFiles":["/workspace/agent/fit_zero.py","/workspace/agent/artifacts/zero_2026-08-01.npz","/workspace/agent/artifacts/zero_2026-08-29.npz"]}}}
