or a, b in spec[\"buckets\"]:","+            m = (h - 3 > a) & (h - 3 <= b)","+            if m.any():","+                out[m] = np.nanmean(fz[a:b]) if np.isfinite(fz[a:b]).any() else np.nanmean(fz)","+        return out","+    M._har_level = lvl","+    try:","+        return M.simulate(asset, start_time, time_increment, time_length, num_simulations, context_prices)","+    finally:","+        M._har_level = _orig"]}],"created":true},{"filePath":"/workspace/results/modeling.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":169,"lines":["+\"\"\"Seasonal-HAR volatility model with fat-tailed, vol-mixed innovations.","+","+Per prompt:","+  1. Deseasonalise the context's 1-minute squared log returns with a per-asset New-York-time","+     5-minute-of-week variance profile (artifacts/season.npz).","+  2. Forecast the deseasonalised variance level as a blend of EWMAs (short / medium / long),","+     with the short component decaying toward the long one as the horizon grows.","+  3. Future per-minute variance = level(h) x profile(bin); aggregate to the requested step.","+  4. Innovations: unit-variance Student-t, times a per-path log-normal volatility multiplier","+     (vol-of-vol uncertainty), cumulated into log prices starting at the last context close.","+Handles any time_increment/time_length (24h/5min and 1h/1min both).","+\"\"\"","+from __future__ import annotations","+","+import os","+from pathlib import Path","+","+import numpy as np","+import pandas as pd","+","+HERE = Path(__file__).resolve().parent","+PARAMS = {","+    \"season_file\": str(HERE / \"artifacts\" / \"season.npz\"),","+    \"hl_short\": 60.0,        # minutes","+    \"hl_med\": 360.0,","+    \"w_short\": 0.3,","+    \"w_med\": 0.3,            # remainder goes to the long (full-context) level","+    \"tau_short\": 240.0,      # minutes: decay of the short/med deviation with horizon","+    \"scale\": 1.0,            # global variance multiplier","+    \"nu\": 5.0,               # Student-t dof","+    \"sv\": 0.25,              # per-path log-vol std at the start of the horizon","+    \"sv_inf\": None,          # stationary log-vol std (None -> = sv, i.e. constant multiplier)","+    \"kappa\": 0.0,            # log-vol mean-reversion rate per minute (OU)","+    \"seed\": 12345,","+    \"har_file\": str(HERE / \"artifacts\" / \"har.json\"),   # \"none\" -> v1 EWMA blend","+    \"har_file_1h\": None,     # used when time_increment == 60 (None -> har_file)","+    # per-configuration overrides (C24 = crypto 24h, E24 = commodities/equities 24h, C1H = crypto 1h)","+    \"groups\": {","+        \"C24\": {\"scale\": 0.75, \"sv\": 0.4},","+        \"E24\": {\"scale\": 0.9, \"sv\": 0.4},","+        \"C1H\": {\"scale\": 1.0, \"sv\": 0.4},","+    },","+}","+_SEASON = {}","+_HAR = {}","+CRYPTO = {\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"}","+","+","+def _har(asset, time_increment):","+    f = PARAMS[\"har_file\"]","+    if time_increment == 60 and PARAMS.get(\"har_file_1h\"):","+        f = PARAMS[\"har_file_1h\"]","+    if f == \"none\":","+        return None","+    if f not in _HAR:","+        import json","+        _HAR[f] = json.loads(Path(f).read_text())","+    h = _HAR[f]","+    return h, h[\"coefs\"][\"crypto\" if asset in CRYPTO else \"equ\"]","+","+","+def _har_level(z, har, h_min):","+    \"\"\"log-HAR forecast of the mean deseasonalised variance at each future minute h_min.\"\"\"","+    spec, coefs = har","+    l7 = np.nanmean(z)","+    x = [1.0] + [np.clip(np.log(max(_ewma_level(z, hl), 1e-12 * l7) / l7), -6, 6) for hl in spec[\"hls\"]]","+    x = np.asarray(x)","+    mids, logf = [], []","+    for a, b in spec[\"buckets\"]:","+        mids.append(np.log((a + b) / 2))","+        logf.append(float(np.dot(coefs[f\"y{a}_{b}\"], x)))","+    lf = np.interp(np.log(h_min), mids, logf)","+    return l7 * np.exp(lf)","+","+","+def _season(asset):","+    f = PARAMS[\"season_file\"]","+    if f == \"none\":","+        return np.ones(2016)","+    if f not in _SEASON:","+        z = np.load(f)","+        _SEASON[f] = {k: z[k] for k in z.files}","+    return _SEASON[f].get(asset, np.ones(2016))","+","+","+def _minute_profile(prof, idx):","+    ny = idx.tz_convert(\"America/New_York\")","+    b = (ny.dayofweek * 288 + ny.hour * 12 + ny.minute // 5).to_numpy()","+    return prof[b]","+","+","+def _ewma_level(z, hl):","+    \"\"\"EWMA of z (ordered oldest->newest) evaluated at the end; z may contain NaN (skipped).\"\"\"","+    n = len(z)","+    w = 0.5 ** (np.arange(n)[::-1] / hl)","+    m = np.isfinite(z)","+    return float(np.sum(w[m] * z[m]) / max(np.sum(w[m]), 1e-12))","+","+","+def simulate(asset, start_time, time_increment=300, time_length=86_400, num_simulations=1000,","+             context_prices=None):","+    grp = \"C1H\" if time_increment == 60 else (\"C24\" if asset in CRYPTO else \"E24\")","+    p = {**PARAMS, **PARAMS[\"groups\"].get(grp, {})}","+    seed = int(os.environ.get(\"SYNTH_BENCHMARK_SEED\", p[\"seed\"]))","+    rng = np.random.default_rng(seed)","+    steps = time_length // time_increment","+    close = context_prices[\"close\"]","+    valid = close.dropna()","+    last = float(valid.iloc[-1])","+    prof = _season(asset)","+","+    # deseasonalised squared 1-min returns over the context (ffill only to MEASURE variance)","+    lp = np.log(close.astype(float)).ffill()","+    r2 = (lp.diff() ** 2).to_numpy()[1:]","+    s_ctx = _minute_profile(prof, close.index[1:])","+    z = r2 / s_ctx","+    z = np.where(np.isfinite(z), z, np.nan)","+    L_long = np.nanmean(z) if np.isfinite(z).sum() > 100 else 1e-8","+    L_s = _ewma_level(z, p[\"hl_short\"])","+    L_m = _ewma_level(z, p[\"hl_med\"])","+    w_s, w_m = p[\"w_short\"], p[\"w_med\"]","+","+    # future minutes covered by the scored path: the realized path's point j is the close of the","+    # bar labelled t0 + j*step, i.e. the price at t0 + j*step + 1min. Scored changes are relative","+    # to point 0, so the minutes between the last context close and t0 are not simulated.","+    t0 = pd.Timestamp(start_time)","+    if t0.tzinfo is None:","+        t0 = t0.tz_localize(\"UTC\")","+    n_min = time_length // 60","+    fut = t0 + pd.to_timedelta(np.arange(1, n_min + 1), unit=\"min\")","+    s_fut = _minute_profile(prof, fut)","+    h = np.arange(1, n_min + 1, dtype=float) + 3.0","+    har = _har(asset, time_increment)","+    if har is not None:","+        L = _har_level(z, har, h)","+    else:","+        dec = np.exp(-h / p[\"tau_short\"])","+        L = L_long + (w_s * (L_s - L_long) + w_m * (L_m - L_long)) * dec","+        L = np.maximum(L, 0.05 * L_long)","+    v = p[\"scale\"] * L * s_fut  # per-minute variance","+","+    k = time_increment // 60","+    v_steps = v.reshape(steps, k).sum(1)","+    sd = np.sqrt(v_steps)","+","+    nu = p[\"nu\"]","+    eps = rng.standard_t(nu, size=(num_simulations, steps)) * np.sqrt((nu - 2) / nu)","+    sv = p[\"sv\"]","+    sv_inf = sv if p[\"sv_inf\"] is None else p[\"sv_inf\"]","+    if p[\"kappa\"] <= 0 and sv_inf == sv:","+        mult = np.exp(sv * rng.standard_normal((num_simulations, 1)) - sv * sv)","+    else:","+        # OU log-vol per path: X_0 ~ N(0, sv^2), stationary std sv_inf, rate kappa per minute","+        a = np.exp(-p[\"kappa\"] * k)","+        xi = rng.standard_normal((num_simulations, steps))","+        X = np.empty((num_simulations, steps))","+        X[:, 0] = sv * xi[:, 0]","+        var = np.empty(steps)","+        var[0] = sv * sv","+        innov = np.sqrt(max(1 - a * a, 0.0)) * sv_inf","+        for j in range(1, steps):","+            X[:, j] = a * X[:, j - 1] + innov * xi[:, j]","+            var[j] = a * a * var[j - 1] + innov * innov","+        mult = np.exp(X - var[None, :])","+    inc = eps * sd[None, :] * mult","+    inc -= 0.5 * (sd[None, :] * mult) ** 2","+    logp = np.concatenate([np.zeros((num_simulations, 1)), np.cumsum(inc, axis=1)], axis=1)","+    paths = last * np.exp(logp)","+    return (start_time, time_increment, *paths.tolist())"]}],"created":true},{"filePath":"/workspace/results/research_oracle.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":41,"lines":["+\"\"\"RESEARCH ONLY (uses the future!): modeling.py with the vol LEVEL replaced by the realised","+deseasonalised variance over the prompt's horizon. Bounds what a perfect level forecast buys.\"\"\"","+import sys","+from pathlib import Path","+import numpy as np","+import pandas as pd","+sys.path.insert(0, str(Path(__file__).resolve().parent))","+import modeling as M  # noqa: E402","+from data import load_asset  # noqa: E402","+","+PARAMS = M.PARAMS","+PARAMS[\"oracle_mode\"] = \"flat\"   # flat: one level for the whole horizon; \"buckets\": per HAR bucket","+_orig = M._har_level","+","+","+def simulate(asset, start_time, time_increment=300, time_length=86400, num_simulations=1000, context_prices=None):","+    t0 = pd.Timestamp(start_time)","+    c = load_asset(asset)[\"close\"]","+    lp = np.log(c.loc[t0 - pd.Timedelta(days=7, minutes=5): t0 + pd.Timedelta(seconds=time_length + 120)]).ffill()","+    r2 = lp.diff() ** 2","+    prof = M._season(asset)","+    z = (r2 / M._minute_profile(prof, r2.index))","+    fut = z.loc[t0 + pd.Timedelta(minutes=1): t0 + pd.Timedelta(seconds=time_length)]","+","+    def lvl(zc, har, h):","+        if PARAMS[\"oracle_mode\"] == \"flat\":","+            return np.full(len(h), np.nanmean(fut.to_numpy()))","+        # piecewise: realised mean over each HAR bucket","+        spec, _ = har","+        out = np.empty(len(h))","+        fz = fut.to_numpy()","+        for a, b in spec[\"buckets\"]:","+            m = (h - 3 > a) & (h - 3 <= b)","+            if m.any():","+                out[m] = np.nanmean(fz[a:b]) if np.isfinite(fz[a:b]).any() else np.nanmean(fz)","+        return out","+    M._har_level = lvl","+    try:","+        return M.simulate(asset, start_time, time_increment, time_length, num_simulations, context_prices)","+    finally:","+        M._har_level = _orig"]}],"created":true},{"filePath":"/workspace/results/data.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":17,"lines":["+\"\"\"Lenient minute-price loader over the frozen snapshot (NaN kept, never interpolated).\"\"\"","+from __future__ import annotations","+from functools import lru_cache","+from pathlib import Path","+import pandas as pd","+","+WORKSPACE = Path(__file__).resolve().parent.parent","+ROOT = WORKSPACE / \"market_data\" / \"prices\"","+OHLCV = [\"open\", \"high\", \"low\", \"close\", \"volume\", \"trade_count\"]","+","+","+@lru_cache(maxsize=32)","+def load_asset(asset: str) -> pd.DataFrame:","+    files = sorted((ROOT / asset / \"1m\").glob(\"date=*.parquet\"))","+    df = pd.concat([pd.read_parquet(f, columns=[\"timestamp\", *OHLCV]) for f in files], ignore_index=True)","+    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)","+    return df.set_index(\"timestamp\").sort_index()"]}],"created":true},{"filePath":"/workspace/results/tune_oracle.txt","hunks":[],"created":true}],"moreFiles":0,"changedFiles":["/workspace/agent/research_oracle.py","/workspace/results/modeling.py","/workspace/results/research_oracle.py","/workspace/results/data.py","/workspace/results/tune_oracle.txt"]}}}
