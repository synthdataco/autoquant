 * 288 + ny.hour * 12 + ny.minute // 5).to_numpy()","+    return prof[b]","+","+","+def _ewma_level(z, hl):","+    \"\"\"EWMA of z (ordered oldest->newest) evaluated at the end; z may contain NaN (skipped).\"\"\"","+    n = len(z)","+    w = 0.5 ** (np.arange(n)[::-1] / hl)","+    m = np.isfinite(z)","+    return float(np.sum(w[m] * z[m]) / max(np.sum(w[m]), 1e-12))","+","+","+def simulate(asset, start_time, time_increment=300, time_length=86_400, num_simulations=1000,","+             context_prices=None):","+    grp = \"C1H\" if time_increment == 60 else (\"C24\" if asset in CRYPTO else \"E24\")","+    p = {**PARAMS, **PARAMS[\"groups\"].get(grp, {})}","+    seed = int(os.environ.get(\"SYNTH_BENCHMARK_SEED\", p[\"seed\"]))","+    rng = np.random.default_rng(seed)","+    steps = time_length // time_increment","+    close = context_prices[\"close\"]","+    valid = close.dropna()","+    last = float(valid.iloc[-1])","+    prof = _season(asset)","+","+    # deseasonalised squared 1-min returns over the context (ffill only to MEASURE variance)","+    lp = np.log(close.astype(float)).ffill()","+    r2 = (lp.diff() ** 2).to_numpy()[1:]","+    s_ctx = _minute_profile(prof, close.index[1:])","+    z = r2 / s_ctx","+    z = np.where(np.isfinite(z), z, np.nan)","+    L_long = np.nanmean(z) if np.isfinite(z).sum() > 100 else 1e-8","+    L_s = _ewma_level(z, p[\"hl_short\"])","+    L_m = _ewma_level(z, p[\"hl_med\"])","+    w_s, w_m = p[\"w_short\"], p[\"w_med\"]","+","+    # future minutes covered by the scored path: the realized path's point j is the close of the","+    # bar labelled t0 + j*step, i.e. the price at t0 + j*step + 1min. Scored changes are relative","+    # to point 0, so the minutes between the last context close and t0 are not simulated.","+    t0 = pd.Timestamp(start_time)","+    if t0.tzinfo is None:","+        t0 = t0.tz_localize(\"UTC\")","+    n_min = time_length // 60","+    fut = t0 + pd.to_timedelta(np.arange(1, n_min + 1), unit=\"min\")","+    s_fut = _minute_profile(prof, fut)","+    h = np.arange(1, n_min + 1, dtype=float) + 3.0","+    har = _har(asset, time_increment)","+    if har is not None:","+        L = _har_level(z, har, h)","+    else:","+        dec = np.exp(-h / p[\"tau_short\"])","+        L = L_long + (w_s * (L_s - L_long) + w_m * (L_m - L_long)) * dec","+        L = np.maximum(L, 0.05 * L_long)","+    v = p[\"scale\"] * L * s_fut  # per-minute variance","+","+    k = time_increment // 60","+    v_steps = v.reshape(steps, k).sum(1)","+    sd = np.sqrt(v_steps)","+","+    nu = p[\"nu\"]","+    eps = rng.standard_t(nu, size=(num_simulations, steps)) * np.sqrt((nu - 2) / nu)","+    sv = p[\"sv\"]","+    sv_inf = sv if p[\"sv_inf\"] is None else p[\"sv_inf\"]","+    if p[\"kappa\"] <= 0 and sv_inf == sv:","+        mult = np.exp(sv * rng.standard_normal((num_simulations, 1)) - sv * sv)","+    else:","+        # OU log-vol per path: X_0 ~ N(0, sv^2), stationary std sv_inf, rate kappa per minute","+        a = np.exp(-p[\"kappa\"] * k)","+        xi = rng.standard_normal((num_simulations, steps))","+        X = np.empty((num_simulations, steps))","+        X[:, 0] = sv * xi[:, 0]","+        var = np.empty(steps)","+        var[0] = sv * sv","+        innov = np.sqrt(max(1 - a * a, 0.0)) * sv_inf","+        for j in range(1, steps):","+            X[:, j] = a * X[:, j - 1] + innov * xi[:, j]","+            var[j] = a * a * var[j - 1] + innov * innov","+        mult = np.exp(X - var[None, :])","+    inc = eps * sd[None, :] * mult","+    inc -= 0.5 * (sd[None, :] * mult) ** 2","+    logp = np.concatenate([np.zeros((num_simulations, 1)), np.cumsum(inc, axis=1)], axis=1)","+    paths = last * np.exp(logp)","+    return (start_time, time_increment, *paths.tolist())"]}],"created":true},{"filePath":"/workspace/agent/BUDGET.md","hunks":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":5,"lines":[" # BUDGET — maintained by the harness (read-only for you)"," ","-- Credits: 4.59 / 100.00 USD (5%)","-- Time   : 1.1 h elapsed, 16.9 h remaining (6%)","+- Credits: 4.61 / 100.00 USD (5%)","+- Time   : 1.2 h elapsed, 16.8 h remaining (6%)"," - Phase  : normal"]}]}],"moreFiles":1,"changedFiles":["/workspace/results/snap_cur.py","/workspace/results/M_E24_0829.parquet","/workspace/agent/BUDGET.md"]}}}
