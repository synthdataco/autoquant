    base_params = base_params or {}","+    rows = []","+    with ProcessPoolExecutor(14) as ex:","+        for wname in windows:","+            s, e, sf = WINDOWS[wname]","+            for g in groups:","+                assets, tl = GROUPS[g]","+                for a in assets:","+                    for vname, vp in variants.items():","+                        p = {\"season_file\": sf, **base_params, **vp}","+                        r = evaluate(model, a, tl, s, e, p, nsim=nsim, stride=stride, pool=ex)","+                        rows.append(dict(win=wname, grp=g, asset=a, var=vname, crps=r.crps.mean(),","+                                         vol=r.crps_vol.mean() if \"crps_vol\" in r else float(\"nan\"),","+                                         f_med=r.f_med.mean()))","+    df = pd.DataFrame(rows)","+    piv = df.pivot_table(index=[\"win\", \"grp\", \"asset\"], columns=\"var\", values=\"crps\")","+    base = list(variants)[0]","+    rel = 100 * (piv.div(piv[base], axis=0) - 1)","+    pd.set_option(\"display.width\", 250)","+    print(rel.round(2).to_string())","+    print(\"--- mean % change by window/group\")","+    print(rel.groupby(level=[0, 1]).mean().round(3).to_string())","+    print(\"--- overall mean by group\")","+    print(rel.groupby(level=1).mean().round(3).to_string())","+    return df","+","+","+if __name__ == \"__main__\":","+    variants = json.loads(sys.argv[1])","+    kw = json.loads(sys.argv[2]) if len(sys.argv) > 2 else {}","+    run(variants, **kw)"]}],"created":true}],"moreFiles":0,"changedFiles":["/workspace/agent/tune.py"]}}}
