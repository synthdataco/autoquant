(path):","+    return dict(np.load(path))","+","+","+def _zero_prob(asset, step_start, time_increment, p):","+    \"\"\"Per-step probability of an exact-zero change, looked up by NY 5-min-of-week bin.\"\"\"","+    f = p.get(\"zero_file\")","+    if not f or time_increment != 300:","+        return None","+    z = _zero_file(str(f)).get(asset)","+    if z is None:","+        return None","+    ny = step_start.tz_convert(\"America/New_York\")","+    b = (ny.dayofweek * 288 + ny.hour * 12 + ny.minute // 5).to_numpy()","+    return np.clip(p[\"zero_w\"] * z[b], 0.0, 0.95)","+","+"," def simulate(asset, start_time, time_increment=300, time_length=86_400, num_simulations=1000,","              context_prices=None):","     grp = \"C1H\" if time_increment == 60 else (\"C24\" if asset in CRYPTO else \"E24\")"]},{"oldStart":112,"oldLines":7,"newStart":164,"newLines":7,"lines":["     # deseasonalised squared 1-min returns over the context (ffill only to MEASURE variance)","     lp = np.log(close.astype(float)).ffill()","     r2 = (lp.diff() ** 2).to_numpy()[1:]","-    s_ctx = _minute_profile(prof, close.index[1:])","+    s_ctx = _minute_profile(prof, close.index[1:]) * _event_mult(asset, close.index[1:])","     z = r2 / s_ctx","     z = np.where(np.isfinite(z), z, np.nan)","     L_long = np.nanmean(z) if np.isfinite(z).sum() > 100 else 1e-8"]},{"oldStart":128,"oldLines":7,"newStart":180,"newLines":7,"lines":["         t0 = t0.tz_localize(\"UTC\")","     n_min = time_length // 60","     fut = t0 + pd.to_timedelta(np.arange(1, n_min + 1), unit=\"min\")","-    s_fut = _minute_profile(prof, fut)","+    s_fut = _minute_profile(prof, fut) * _event_mult(asset, fut)","     h = np.arange(1, n_min + 1, dtype=float) + 3.0","     har = _har(asset, time_increment)","     if har is not None:"]},{"oldStart":162,"oldLines":6,"newStart":214,"newLines":11,"lines":["             X[:, j] = a * X[:, j - 1] + innov * xi[:, j]","             var[j] = a * a * var[j - 1] + innov * innov","         mult