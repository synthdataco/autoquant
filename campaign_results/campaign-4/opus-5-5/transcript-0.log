hl), 1e-12 * l7) / l7), -6, 6) for hl in spec[\"hls\"]]","+    x = np.asarray(x)","+    mids, logf = [], []","+    for a, b in spec[\"buckets\"]:","+        mids.append(np.log((a + b) / 2))","+        logf.append(float(np.dot(coefs[f\"y{a}_{b}\"], x)))","+    lf = np.interp(np.log(h_min), mids, logf)","+    return l7 * np.exp(lf)","+","+","+def _season(asset):","+    f = PARAMS[\"season_file\"]","+    if f == \"none\":","+        return np.ones(2016)","+    if f not in _SEASON:","+        z = np.load(f)","+        _SEASON[f] = {k: z[k] for k in z.files}","+    return _SEASON[f].get(asset, np.ones(2016))","+","+","+def _minute_profile(prof, idx):","+    ny = idx.tz_convert(\"America/New_York\")","+    b = (ny.dayofweek * 288 + ny.hour * 12 + ny.minute // 5).to_numpy()","+    return prof[b]","+","+","+def _ewma_level(z, hl):","+    \"\"\"EWMA of z (ordered oldest->newest) evaluated at the end; z may contain NaN (skipped).\"\"\"","+    n = len(z)","+    w = 0.5 ** (np.arange(n)[::-1] / hl)","+    m = np.isfinite(z)","+    return float(np.sum(w[m] * z[m]) / max(np.sum(w[m]), 1e-12))","+","+","+@lru_cache(maxsize=4)","+def _zero_file(path):","+    return dict(np.load(path))","+","+","+def _zero_prob(asset, step_start, time_increment, p):","+    \"\"\"Per-step probability of an exact-zero change, looked up by NY 5-min-of-week bin.\"\"\"","+    f = p.get(\"zero_file\")","+    if not f or time_increment != 300:","+        return None","+    z = _zero_file(str(f)).get(asset)","+    if z is None:","+        return None","+    ny = step_start.tz_convert(\"America/New_York\")","+    b = (ny.dayofweek * 288 + ny.hour * 12 + ny.minute // 5).to_numpy()","+    return np.clip(p[\"zero_w\"] * z[b], 0.0, 0.95)","+","+","+def simulate(asset, start_time, time_increment=300, time_length=86_400, num_simulations=1000,","+             context_prices=None):","+    grp = \"C1H\" if time_increment == 60 else (\"C24\" if asset in CRYPTO else \"E24\")","+    p = {**PARAMS, **PARAMS[\"groups\"].get(grp, {})}","+    seed = int(os.environ.get(\"SYNTH_BENCHMARK_SEED\", p[\"seed\"]))","+    rng = np.random.default_rng(seed)","+    steps = time_length // time_increment","+    close = context_prices[\"close\"]","+    valid = close.dropna()","+    last = float(valid.iloc[-1])","+    prof = _season(asset)","+","+    # deseasonalised squared 1-min returns over the context (ffill only to MEASURE variance)","+    lp = np.log(close.astype(float)).ffill()","+    r2 = (lp.diff() ** 2).to_numpy()[1:]","+    s_ctx = _minute_profile(prof, close.index[1:])","+    z = r2 / s_ctx","+    z = np.where(np.isfinite(z), z, np.nan)","+    L_long = np.nanmean(z) if np.isfinite(z).sum() > 100 else 1e-8","+    L_s = _ewma_level(z, p[\"hl_short\"])","+    L_m = _ewma_level(z, p[\"hl_med\"])","+    w_s, w_m = p[\"w_short\"], p[\"w_med\"]","+","+    # future minutes covered by the scored path: the realized path's point j is the close of the","+    # bar labelled t0 + j*step, i.e. the price at t0 + j*step + 1min. Scored changes are relative","+    # to point 0, so the minutes between the last context close and t0 are not simulated.","+    t0 = pd.Timestamp(start_time)","+    if t0.tzinfo is None:","+        t0 = t0.tz_localize(\"UTC\")","+    n_min = time_length // 60","+    fut = t0 + pd.to_timedelta(np.arange(1, n_min + 1), unit=\"min\")","+    s_fut = _minute_profile(prof, fut)","+    h = np.arange(1, n_min + 1, dtype=float) + 3.0","+    har = _har(asset, time_increment)","+    if har is not None:","+        L = _har_level(z, har, h)","+    else:","+        dec = np.exp(-h / p[\"tau_short\"])","+        L = L_long + (w_s * (L_s - L_long) + w_m * (L_m - L_long)) * dec","+        L = np.maximum(L, 0.05 * L_long)","+    v = p[\"scale\"] * L * s_fut  # per-minute variance","+","+    k = time_increment // 60","+    v_steps = v.reshape(steps, k).sum(1)","+    sd = np.sqrt(v_steps)","+","+    nu = p[\"nu\"]","+    eps = rng.standard_t(nu, size=(num_simulations, steps)) * np.sqrt((nu - 2) / nu)","+    sv = p[\"sv\"]","+    sv_inf = sv if p[\"sv_inf\"] is None else p[\"sv_inf\"]","+    if p[\"kappa\"] <= 0 and sv_inf == sv:","+        mult = np.exp(sv * rng.standard_normal((num_simulations, 1)) - sv * sv)","+    else:","+        # OU log-vol per path: X_0 ~ N(0, sv^2), stationary std sv_inf, rate kappa per minute","+        a = np.exp(-p[\"kappa\"] * k)","+        xi = rng.standard_normal((num_simulations, steps))","+        X = np.empty((num_simulations, steps))","+        X[:, 0] = sv * xi[:, 0]","+        var = np.empty(steps)","+        var[0] = sv * sv","+        innov = np.sqrt(max(1 - a * a, 0.0)) * sv_inf","+        for j in range(1, steps):","+            X[:, j] = a * X[:, j - 1] + innov * xi[:, j]","+            var[j] = a * a * var[j - 1] + innov * innov","+        mult = np.exp(X - var[None, :])","+    p0 = _zero_prob(asset, fut[::k] - pd.Timedelta(minutes=1), time_increment, p)","+    if p0 is not None:","+        # stale/closed market or tick discreteness: exact-zero changes with prob p0, variance kept","+        stay = rng.random((num_simulations, steps)) >= p0[None, :]","+        eps = eps * stay / np.sqrt(1 - p0)[None, :]","+    inc = eps * sd[None, :] * mult","+    inc -= 0.5 * (sd[None, :] * mult) ** 2","+    logp = np.concatenate([np.zeros((num_simulations, 1)), np.cumsum(inc, axis=1)], axis=1)","+    paths = last * np.exp(logp)","+    return (start_time, time_increment, *paths.tolist())"]}],"created":true},{"filePath":"/workspace/agent/BUDGET.md","hunks":[{"oldStart":1,"oldLines":5,"newStart":1,"newLines":5,"lines":[" # BUDGET — maintained by the harness (read-only for you)"," ","-- Credits: 5.33 / 100.00 USD (5%)","-- Time   : 1.3 h elapsed, 16.7 h remaining (7%)","+- Credits: 5.37 / 100.00 USD (5%)","+- Time   : 1.4 h elapsed, 16.6 h remaining (8%)"," - Phase  : normal"]}]}],"moreFiles":0,"changedFiles":["/workspace/results/snap_1790749411701.py","/workspace/agent/BUDGET.md"]}}}
