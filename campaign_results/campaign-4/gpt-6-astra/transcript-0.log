{"type":"item.started","item":{"id":"item_139","type":"command_execution","command":"/bin/bash -lc \"cat > agent/run_fomc.py <<'PY'\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\nimport subprocess,os\n\ndef run(scale):\n tag='fomc_'+scale.replace('.','p')\n env=os.environ.copy();env.update(MODEL_MODE='har',MODEL_MIX='.4',MODEL_FOMC=scale,SEASON_FILE='jul20_seasonality_abs48.json',HAR_FILE='jul20_har_abs48.json',OPENBLAS_NUM_THREADS='1')\n if 'LANDING ORDER' in Path('agent/BUDGET.md').read_text():return 'landing'\n with open('agent/results_'+tag+'.log','w') as log:\n  p=subprocess.run(['uv','run','agent/predict.py','--research','--model','agent/modeling.py','--tag',tag,'--start','2026-07-28','--end','2026-07-31','--hours','1','--assets','BTC,ETH,SOL,XRP,HYPE'],env=env,stdout=log,stderr=subprocess.STDOUT)\n return tag,p.returncode\nwith ThreadPoolExecutor(max_workers=3) as pool:\n for r in pool.map(run,['1','1.5','2']):print(r,flush=True)\nPY\nuv run agent/run_fomc.py > agent/fomc_eval.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.started","item":{"id":"item_140","type":"command_execution","command":"/bin/bash -lc \"cat > agent/paired_summary.py <<'PY'\n\\\"\\\"\\\"Paired daily differences; day-cluster uncertainty acknowledges overlapping prompts.\\\"\\\"\\\"\nimport sys\nimport numpy as np\nimport pandas as pd\nfrom synth.validator.moving_average import ASSET_COEFFICIENTS\ncrypto={'BTC','ETH','SOL','XRP','HYPE'}\na=pd.read_csv('agent/results/'+sys.argv[1]+'.csv');b=pd.read_csv('agent/results/'+sys.argv[2]+'.csv')\nd=a.merge(b,on=['asset','horizon','start'],suffixes=('_a','_b'),validate='one_to_one')\nassert np.allclose(d.coverage_a,d.coverage_b)\nd['config']=['CRYPTO_1H' if h==3600 else 'CRYPTO_24H' if x in crypto else 'COM_EQU_24H' for x,h in zip(d.asset,d.horizon)]\nd['day']=d.start.str[:10];d['coef']=d.asset.map(ASSET_COEFFICIENTS)\nd['diff']=d.crps_b-d.crps_a\nrng=np.random.default_rng(123)\nfor config,g in d.groupby('config'):\n daily=g.groupby('day').apply(lambda x:np.average(x['diff'],weights=x.coef),include_groups=False).to_numpy()\n reps=np.mean(rng.choice(daily,size=(10000,len(daily))),axis=1)\n base=np.average(g.crps_a,weights=g.coef);new=np.average(g.crps_b,weights=g.coef)\n print(config,'n',len(g),'weighted CRPS',round(base,4),round(new,4),'change%',round((new/base-1)*100,3),'daily bootstrap difference 95%',np.quantile(reps,[.025,.975]).round(4).tolist())\nPY\nuv run agent/paired_summary.py har_orig_augmid har48_augmid && uv run agent/paired_summary.py har48_augmid har48_ma_augmid\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
