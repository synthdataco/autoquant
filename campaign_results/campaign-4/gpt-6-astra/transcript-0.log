e/uv/archive-v0/_FAkeQZkcwrj0qTc/synth_lib/backtester/caveats.py\n/root/.cache/uv/archive-v0/_FAkeQZkcwrj0qTc/synth_lib/preparation/market_data.py\n/root/.cache/uv/archive-v0/_FAkeQZkcwrj0qTc/synth_lib/preparation/config.py\n/root/.cache/uv/git-v1/checkouts/319c37acd7f2d469/56fa368/synth_lib/backtester/plots/rank.py\n/root/.cache/uv/git-v1/checkouts/319c37acd7f2d469/56fa368/synth_lib/backtester/plots/__init__.py\n","exit_code":0,"status":"completed"}}
