{"type":"item.started","item":{"id":"item_153","type":"command_execution","command":"/bin/bash -lc \"cat > agent/ohlcv_features.py <<'PY'\n\\\"\\\"\\\"Causal range/activity features for the HAR ablation.\\\"\\\"\\\"\nimport numpy as np\nimport pandas as pd\nHOURS=[.25,1,6,24,72,168]\ndef features(frame,step,season,asset):\n    grid=frame.resample(f'{step}s').agg(dict(close='last',high='max',low='min',volume='sum',trade_count='sum'))\n    close=grid.close\n    r=np.log(close).diff()\n    bins=season.get('bins',24)\n    shape=np.array(season['tables'][asset])\n    norm=np.sqrt(shape[grid.index.dayofweek*bins+(grid.index.hour*60+grid.index.minute)//(1440//bins)])\n    a=r.abs()/norm\n    rg=np.log(grid.high/grid.low).where(grid.high>=grid.low)/norm\n    f={}\n    means={}\n    for h in HOURS:\n        n=max(1,int(h*3600/step))\n        means[h]=a.rolling(n,min_periods=1).mean()\n        f[f'abs{h}']=np.log(means[h].clip(lower=1e-10))\n    for h in [1,6,24]:\n        n=int(h*3600/step)\n        rangemean=rg.rolling(n,min_periods=1).mean()\n        f[f'range{h}']=np.log((rangemean/means[h]).clip(lower=.01,upper=100))\n        for col in ['volume','trade_count']:\n            short=grid[col].rolling(n,min_periods=1).mean()\n            long=grid[col].rolling(168*3600//step,min_periods=1).mean()\n            f[f'{col}{h}']=np.log((short/long).clip(lower=.01,upper=100)).fillna(0.)\n    for h in [6,24]:\n        n=int(h*3600/step)\n        rms=np.sqrt((r/norm).pow(2).rolling(n,min_periods=1).mean())\n        f[f'jump{h}']=np.log((rms/means[h]).clip(lower=.5,upper=10))\n    return pd.DataFrame(f,index=grid.index),a\nPY\ncat > agent/fit_ohlcv.py <<'PY'\nimport json\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom predict import load_lenient,ensure_workspace_cwd\nfrom ohlcv_features import features\nensure_workspace_cwd()\nseason=json.loads(Path('agent/seasonality_abs48.json').read_text());models={};metrics=[]\nfor asset in season['tables']:\n    begin='2026-01-01' if asset in ['BTC','ETH','SOL','XRP','HYPE','XAU','NVDAX','GOOGLX','TSLAX','AAPLX'] else '2026-06-01'\n    df=load_lenient(asset,pd.Timestamp(begin,tz='UTC'),pd.Timestamp('2026-07-31 23:59',tz='UTC'))\n    for step in [60,300] if asset in ['BTC','ETH','SOL','XRP','HYPE'] else [300]:\n        x,a=features(df,step,season,asset)\n        horizon=3600//step if step==60 else 86400//step\n        target=a.shift(-1).iloc[::-1].rolling(horizon,min_periods=max(1,int(.75*horizon))).mean().iloc[::-1]\n        rows=x.copy();rows['y']=np.log(target.clip(lower=1e-10));rows=rows.iloc[168*3600//step:-horizon:3600//step].replace([np.inf,-np.inf],np.nan).dropna()\n        y=rows.pop('y').to_numpy();X=rows.to_numpy();center=X.mean(axis=0);sd=np.maximum(X.std(axis=0),.1)\n        xx=np.c_[np.ones(len(X)),(X-center)/sd]\n        reg=np.eye(xx.shape[1])*100;reg[0,0]=0\n        beta=np.linalg.solve(xx.T@xx+reg,xx.T@y);res=y-xx@beta\n        correction=float(np.exp(res).mean())\n        models[f'{asset}_{step}']=dict(center=center.tolist(),sd=sd.tolist(),beta=beta.tolist(),correction=correction)\n        metrics.append(dict(asset=asset,step=step,n=len(X),log_rmse=float(res.std())))\nPath('agent/ohlcv.json').write_text(json.dumps(dict(fit_end='2026-07-31',models=models),indent=2))\nprint(pd.DataFrame(metrics).to_string(index=False))\nPY\nOPENBLAS_NUM_THREADS=1 uv run agent/fit_ohlcv.py > agent/ohlcv_fit.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
