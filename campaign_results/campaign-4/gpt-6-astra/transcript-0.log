{"type":"item.started","item":{"id":"item_96","type":"command_execution","command":"/bin/bash -lc \"cat > agent/vol_features.py <<'PY'\n\\\"\\\"\\\"Shared causal features for training and serving the nonlinear ablation.\\\"\\\"\\\"\nimport numpy as np\nimport pandas as pd\nASSETS='BTC ETH SOL XRP HYPE XAU NVDAX GOOGLX TSLAX AAPLX WTIOIL SPCX SP500'.split()\nHOURS=[.25,1,6,24,72,168]\ndef features(raw,asset,step,season):\n    close=raw.resample(f'{step}s').last()\n    r=np.log(close).diff()\n    bins=season.get('bins',24)\n    shape=np.array(season['tables'][asset])\n    norm=np.sqrt(shape[close.index.dayofweek*bins+(close.index.hour*60+close.index.minute)//(1440//bins)])\n    a=r.abs()/norm\n    means={h:a.rolling(max(1,int(h*3600/step)),min_periods=1).mean() for h in HOURS}\n    rms={h:np.sqrt((r/norm).pow(2).rolling(max(1,int(h*3600/step)),min_periods=1).mean()) for h in HOURS}\n    base=means[168].clip(lower=1e-10)\n    f={'base':np.log(base)}\n    for h in HOURS:\n        f[f'a{h}']=np.log((means[h]/base).clip(lower=1e-5,upper=1e5))\n        f[f'rms{h}']=np.log((rms[h]/base).clip(lower=1e-5,upper=1e5))\n    for h in [.25,1,6,24]:\n        count=max(1,int(h*3600/step))\n        f[f'signed{h}']=((np.log(close)-np.log(close.shift(count)))/(base*np.sqrt(count))).clip(-10,10)\n    f['zeros']=r.eq(0).rolling(86400//step,min_periods=1).mean()\n    f['coverage']=r.notna().rolling(86400//step,min_periods=1).mean()\n    hour=close.index.hour+close.index.minute/60\n    f['hour_sin']=np.sin(hour*np.pi/12)\n    f['hour_cos']=np.cos(hour*np.pi/12)\n    f['weekend']=(close.index.dayofweek>=5).astype(float)\n    f['asset']=float(ASSETS.index(asset))\n    return pd.DataFrame(f,index=close.index),a,base\nPY\ncat > agent/fit_gbm.py <<'PY'\nimport os\nos.environ.setdefault('OMP_NUM_THREADS','4')\nimport json,pickle\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom predict import load_lenient,ensure_workspace_cwd\nfrom vol_features import features,ASSETS\nensure_workspace_cwd()\nseason=json.loads(Path('agent/seasonality.json').read_text())\ndata={key:[] for key in ['crypto1','crypto24','com24']}\nfor asset in ASSETS:\n    begin='2026-01-01' if asset in ASSETS[:5] else '2026-06-01'\n    df=load_lenient(asset,pd.Timestamp(begin,tz='UTC'),pd.Timestamp('2026-07-31 23:59',tz='UTC'))\n    for step in [60,300] if asset in ASSETS[:5] else [300]:\n        x,a,base=features(df.close,asset,step,season)\n        horizon=3600//step if step==60 else 86400//step\n        target=a.shift(-1).iloc[::-1].rolling(horizon,min_periods=max(1,horizon//2)).mean().iloc[::-1]\n        rows=x.copy();rows['y']=np.log((target/base).clip(lower=1e-6))\n        rows=rows.iloc[168*3600//step:-horizon:3600//step]\n        rows=rows.replace([np.inf,-np.inf],np.nan).dropna(subset=['y','base'])\n        key='crypto1' if step==60 else 'crypto24' if asset in ASSETS[:5] else 'com24'\n        data[key].append(rows)\nartifacts={}\nfor key,frames in data.items():\n    d=pd.concat(frames);y=d.pop('y').to_numpy();X=d.to_numpy()\n    model=HistGradientBoostingRegressor(max_iter=200,max_leaf_nodes=15,min_samples_leaf=100,l2_regularization=10,learning_rate=.04,early_stopping=False,random_state=42,categorical_features=[X.shape[1]-1])\n    model.fit(X,y);residual=y-model.predict(X)\n    correction=float(np.mean(np.exp(residual)))\n    artifacts[key]=dict(model=model,correction=correction)\n    print(key,len(X),'training log residual sd',float(residual.std()),'bias correction',correction,flush=True)\nwith open('agent/gbm.pkl','wb') as f:pickle.dump(dict(fit_end='2026-07-31',models=artifacts),f)\nPY\nOMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=1 uv run agent/fit_gbm.py > agent/gbm_fit.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
