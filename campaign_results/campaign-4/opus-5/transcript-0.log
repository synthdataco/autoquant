if step_min > 1 else c","+    r = np.log(c).diff()","+    r = r[r.notna()]","+    if r.size < 5000:","+        return float(\"nan\")","+    p = _bend(prof, gamma)","+    mow = (r.index.dayofweek.values * 24 * 60 + r.index.hour.values * 60","+           + r.index.minute.values)","+    u = r.to_numpy() / p[_bidx(mow, p)]","+    z = np.abs(u / _ewma_sd(u, halflives, weights))","+    z = z[np.isfinite(z) & (z > 0)]","+    qh, ql = np.quantile(z, HI), np.quantile(z, LO)","+    if not (np.isfinite(qh) and ql > 0):","+        return float(\"nan\")","+    return _invert(float(qh / ql))","+","+","+def build(fit_end: str | None, tow_name: str, out_name: str, gammas: dict,","+          halflives, weights) -> None:","+    from harness import ALL_ASSETS_24H","+","+    prof = _seas.load(tow_name)","+    ART_DIR.mkdir(parents=True, exist_ok=True)","+    data = {}","+    for asset in ALL_ASSETS_24H:","+        for step in (1, 5):","+            key = f\"{asset}_{step}\"","+            p = prof.get(key)","+            if p is None:","+                continue","+            v = fit_nu(asset, step, p, float(gammas.get(step, 1.0)), halflives, weights, fit_end)","+            if np.isfinite(v):","+                data[key] = np.float64(v)","+    np.savez_compressed(ART_DIR / out_name, **data)","+    print(f\"wrote {ART_DIR / out_name}  ({len(data)} indices)\")","+","+","+_LOADED: dict[str, dict] = {}","+","+","+def load(name: str) -> dict:","+    if name not in _LOADED:","+        with np.load(ART_DIR / name) as z:","+            _LOADED[name] = {k: float(z[k]) for k in z.files}","+    return _LOADED[name]","+","+","+if __name__ == \"__main__\":","+    from modeling import CHAMPION_SPEC, SEAS_GAMMA","+","+    kw = CHAMPION_SPEC[1]","+    hl, wt = kw[\"halflives\"], kw[\"weights\"]","+    build(\"2026-06-30\", \"tow_pre0701.npz\", \"nu_pre0701.npz\", SEAS_GAMMA, hl, wt)","+    build(None, \"tow_full.npz\", \"nu_full.npz\", SEAS_GAMMA, hl, wt)","+    d = load(\"nu_pre0701.npz\")","+    f