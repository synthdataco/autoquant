ed here is fitted strictly before all three validation windows."," \"\"\""," "," from __future__ import annotations"]},{"oldStart":34,"oldLines":7,"newStart":28,"newLines":8,"lines":[" "," def main() -> None:","     _, base = CHAMPION_SPEC","-    kw = dict(base, profile=\"tow_pre0701.npz\", nu_art=\"nu_pre0701.npz\")","+    kw = dict(base, profile=\"tow_pre0701.npz\", nu_art=\"nu_pre0701.npz\",","+              vlong_art=\"vlong_pre0701.npz\")  # every artifact fitted before the windows","     for label, group, tl, ti in LEGS:","         step = ti // 60","         res: dict[float, dict[str, float]] = {}"]}]}],"moreFiles":0,"changedFiles":["/workspace/agent/exp_nu.py"]}}}
