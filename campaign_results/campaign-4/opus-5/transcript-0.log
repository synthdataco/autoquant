{"type":"assistant","message":{"model":"claude-opus-5","id":"msg_011CfY5r5rmUnHpiDPCgeNTY","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KPrvNFKKEGMZrPYddN4NQJ","name":"Write","input":{"file_path":"/workspace/agent/evaluate.py","content":"\"\"\"Parallel CRPS evaluation of a model over frozen prompt sets.\n\n`run(model_spec, windows, assets, ...)` -> tidy DataFrame with one row per (asset, prompt).\nThe model is addressed by a spec `(module, factory_name, kwargs)` so it can be rebuilt inside\neach worker process; nothing but numpy arrays crosses the process boundary.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport importlib\nimport os\nimport sys\nfrom concurrent.futures import ProcessPoolExecutor\nfrom dataclasses import dataclass, field\nfrom typing import Any\n\nimport numpy as np\nimport pandas as pd\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\n\nfrom harness import build_prompts, score_paths  # noqa: E402\n\n# ---------------------------------------------------------------- worker side\n\n_WORKER_STATE: dict[str, Any] = {}\n\n\ndef _get_model(spec):\n    key = repr(spec)\n    if key not in _WORKER_STATE:\n        module, factory, kwargs = spec\n        mod = importlib.import_module(module)\n        _WORKER_STATE[key] = getattr(mod, factory)(**kwargs)\n    return _WORKER_STATE[key]\n\n\ndef _work(args):\n    spec, asset, window, tl, ti, cadence, idx_lo, idx_hi, num_sims, seed = args\n    ps = build_prompts(asset, window[0], window[1], tl, ti, cadence)\n    model = _get_model(spec)\n    comp = ps.competition\n    out = []\n    for i in range(idx_lo, min(idx_hi, len(ps.starts))):\n        rng = np.random.default_rng(seed + i * 7919)\n        paths = model(\n            asset=asset,\n            start_time=ps.starts[i],\n            time_increment=ti,\n            time_length=tl,\n            num_simulations=num_sims,\n            context_prices=ps.contexts[i],\n            rng=rng,\n        )\n        paths = np.asarray(paths, dtype=np.float32).astype(float)\n        crps = score_paths(paths, ps.reals[i], comp)\n        out.append((asset, ps.starts[i], crps))\n    return out\n\n\n# ---------------------------------------------------------------- driver side\n\n\n@dataclass\nclass EvalConfig:\n    windows: list[tuple[str, str]]\n    assets: list[str]\n    time_length: int = 86_400\n    time_increment: int = 300\n    cadence_minutes: int = 120\n    num_simulations: int = 1000\n    seed: int = 12345\n    workers: int = 13\n    chunk: int = 6\n    extra: dict = field(default_factory=dict)\n\n\ndef run(spec, cfg: EvalConfig, executor: ProcessPoolExecutor | None = None) -> pd.DataFrame:\n    jobs = []\n    for asset in cfg.assets:\n        for window in cfg.windows:\n            ps = build_prompts(\n                asset, window[0], window[1], cfg.time_length, cfg.time_increment, cfg.cadence_minutes\n            )\n            n = len(ps.starts)\n            for lo in range(0, n, cfg.chunk):\n                jobs.append(\n                    (\n                        spec,\n                        asset,\n                        window,\n                        cfg.time_length,\n                        cfg.time_increment,\n                        cfg.cadence_minutes,\n                        lo,\n                        lo + cfg.chunk,\n                        cfg.num_simulations,\n                        cfg.seed,\n                    )\n                )\n    own = executor is None\n    ex = executor or ProcessPoolExecutor(max_workers=cfg.workers)\n    try:\n        rows = []\n        for chunk_rows in ex.map(_work, jobs):\n            rows.extend(chunk_rows)\n    finally:\n        if own:\n            ex.shutdown()\n    return pd.DataFrame(rows, columns=[\"asset\", \"start\", \"crps\"])\n\n\ndef summarize(df: pd.DataFrame) -> pd.Series:\n    return df.groupby(\"asset\")[\"crps\"].mean()\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":4936,"cache_read_input_tokens":85240,"cache_creation":{"ephemeral_5m_input_tokens":4936,"ephemeral_1h_input_tokens":0},"output_tokens":4,"service_tier":"standard","inference_geo":"global"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e0fdc998-0d4c-4bec-aa01-713aae481473","uuid":"d275ae8e-cb32-43ea-a550-e2b41ef5c43a","timestamp":"2026-09-29T16:57:40.496Z"}
