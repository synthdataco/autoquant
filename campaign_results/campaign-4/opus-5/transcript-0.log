ad_input_tokens":121871,"cache_creation":{"ephemeral_5m_input_tokens":1440,"ephemeral_1h_input_tokens":0},"output_tokens":5,"service_tier":"standard","inference_geo":"global"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e0fdc998-0d4c-4bec-aa01-713aae481473","uuid":"d14baade-b24d-476e-b373-1cf1314867a0","timestamp":"2026-09-30T02:41:06.754Z"}
