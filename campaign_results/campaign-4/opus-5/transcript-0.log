n) & np.isfinite(r_all)\n    r_all = np.where(gap_ok, r_all, np.nan)\n    end_min = idx[1:]\n    u_all = _deseason(r_all, end_min, prof)\n\n    hl = halflives_for(step_min)\n    pool = pool_for(step_min)\n    stride = max(1, stride_min // step_min)\n\n    X, y = [], []\n    for t in range(pool, u_all.size - horizon_steps, stride):\n        past = u_all[t - pool : t]\n        past = past[np.isfinite(past)]\n        fut = u_all[t : t + horizon_steps]\n        fut = fut[np.isfinite(fut)]\n        if past.size < pool // 3 or fut.size < horizon_steps // 3:\n            continue\n        s0 = 1.4826 * np.median(np.abs(fut - np.median(fut))) + 1e-12\n        target = np.sqrt(np.mean(np.clip(fut, -WINSOR * s0, WINSOR * s0) ** 2))\n        if not np.isfinite(target) or target <= 0:\n            continue\n        X.append(features(past, hl))\n        y.append(np.log(target))\n    return np.array(X), np.array(y)\n\n\ndef fit_asset(asset, step_min, horizon_steps, fit_end, ridge=1e-3, profile=\"tow_full.npz\"):\n    X, y = build_dataset(asset, step_min, horizon_steps, fit_end, profile=profile)\n    if len(y) < 200:\n        return None\n    A = np.column_stack([np.ones(len(y)), X])\n    P = ridge * np.eye(A.shape[1])\n    P[0, 0] = 0.0  # never shrink the intercept\n    coef = np.linalg.solve(A.T @ A + P, A.T @ y)\n    pred = A @ coef\n    return coef, float(np.var(y - pred)), float(np.var(y))\n\n\ndef build(fit_end: str | None, out_name: str, profile: str = \"tow_full.npz\"):\n    ART_DIR.mkdir(parents=True, exist_ok=True)\n    data, rows = {}, []\n    for asset in ALL_ASSETS_24H:\n        for step_min, horizon in ((5, 288), (1, 60)):\n            if step_min == 1 and asset not in (\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"):\n                continue  # only crypto is prompted at the 1-hour horizon\n            res = fit_asset(asset, step_min, horizon, fit_end, profile=profile)\n            if res is None:\n                continue\n            coef, resid, tot = res\n      