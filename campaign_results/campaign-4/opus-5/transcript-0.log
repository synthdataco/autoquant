{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01DGLQFhRd2FKYtGxQDYzLyx","type":"tool_result","content":"160\t\n161\t    return f\n162\t\n163\t\n164\t# --------------------------------------------------------------------------- seasonal SV family\n165\t\n166\timport seasonality as _seas  # noqa: E402\n167\t\n168\t\n169\tdef _tow_index(ts0, n: int, step_min: int) -> np.ndarray:\n170\t    \"\"\"Time-of-week bucket for each of the n future scoring points starting at ts0.\"\"\"\n171\t    t0 = pd.Timestamp(ts0)\n172\t    minute_of_week = (t0.dayofweek * 24 * 60 + t0.hour * 60 + t0.minute) + np.arange(n) * step_min\n173\t    return (minute_of_week % (7 * 24 * 60)) // _seas.BUCKET_MIN\n174\t\n175\t\n176\tdef _ewma_var_multi(x2: np.ndarray, halflives) -> np.ndarray:\n177\t    \"\"\"EWMA of x2 at several half-lives (in steps), evaluated at the last point.\"\"\"\n178\t    out = []\n179\t    n = x2.size\n180\t    ar = np.arange(n - 1, -1, -1)\n181\t    for hl in halflives:\n182\t        w = 0.5 ** (ar / hl)\n183\t        out.append(np.sum(w * x2) / np.sum(w))\n184\t    return np.array(out)\n185\t\n186\t\n187\tdef sv_model(\n188\t    profile: str = \"tow_pre0701.npz\",\n189\t    seasonal: bool = True,\n190\t    # Profile is raised to this power: 0 = flat, 1 = as measured, >1 = un-shrink it. A dict maps\n191\t    # step size in minutes -> exponent, because the 5-minute and 1-minute profiles want opposite\n192\t    # corrections (see journal Iter 12); a bare float applies to every step size.\n193\t    seas_gamma: float | dict = 1.0,\n194\t    # Optional separate exponent for profile values BELOW 1 (quiet buckets). None = symmetric.\n195\t    seas_gamma_lo: float | dict | None = None,\n196\t    # Width responds to how busy the tape is right now vs normal for this time of week, as a\n197\t    # single bounded multiplier exp(beta * a) clipped to [1/act_cap, act_cap]. 0 disables it.\n198\t    act_beta: float = 0.0,\n199\t    act_halflives=(24.0, 1152.0),   # steps: ~2h and ~4d at the 5-minute step\n200\t    act_cap: float = 1.30,\n201\t    scale: float = 0.9,\n202\t    scale_map=None,   # per-asset multiplier on top of `scale`, fitted out-of-sample\n203\t    dist: str = \"t\",\n204\t    nu: float = 4.0,\n205\t    halflives=(12.0, 72.0, 576.0),\n206\t    weights=(0.3, 0.3, 0.4),\n207\t    revert_halflife: float = 0.0,   # steps; 0 = no mean reversion toward the long level\n208\t    long_halflife: float = 2016.0,\n209\t    vol_of_vol: float = 0.0,        # sd of a per-path log-level shock\n210\t    est: str = \"rms\",               # \"rms\" (EWMA of u^2) or \"mad\" (EWMA of |u|)\n211\t    level: str = \"ewma\",            # \"ewma\" = blended EWMA vols; \"fit\" = volfit regression\n212\t    volfit_art: str = \"volfit_pre0701.npz\",\n213\t    winsor: float = 6.0,\n214\t    pool_steps: int = 4032,\n215\t):\n216\t    \"\"\"Seasonal stochastic-volatility simulator.\n217\t\n218\t      r_k = sigma_k * z,   sigma_k = scale * v_k * s(t_k)\n219\t\n220\t    `s` is the committed time-of-week profile; `v_k` is a log-linear reversion from the current\n221\t    deseasonalised level `v0` (a weighted blend of EWMA variances) toward the long-run level.\n222\t    \"\"\"\n223\t    prof_raw = _seas.load(profile)\n224\t    fitc = None\n225\t    if level == \"fit\":\n226\t        import volfit as _vf0\n227\t        fitc = _vf0.load(volfit_art)\n228\t    _gammas = dict(seas_gamma) if isinstance(seas_gamma, dict) else None\n229\t    _gammas_lo = dict(seas_gamma_lo) if isinstance(seas_gamma_lo, dict) else None\n230\t    _prof_cache: dict[tuple, dict] = {}\n231\t\n232\t    def _bend(v, g_hi, g_lo):\n233\t        \"\"\"Raise the profile to g_hi above 1 and g_lo below it, then renormalise to mean 1.\n234\t\n235\t        The profile is already mean-normalised, so 1 is the natural hinge: values above it are\n236\t        busy buckets and values below are quiet ones. They get separate exponents because the\n237\t        shrinkage being undone is not symmetric -- the 0.25 floor in seasonality.py only ever\n238\t        binds at the bottom.\n239\t        \"\"\"\n240\t        out = np.where(v >= 1.0, v**g_hi, v**g_lo)\n241\t        return out / out.mean()\n242\t\n243\t    def _profile_for(step_min: int):\n244\t        g = float(_gammas.get(step_min, 1.0)) if _gammas is not None else float(seas_gamma)\n245\t        if seas_gamma_lo is None:\n246\t            g_lo = g\n247\t        else:\n248\t            g_lo = (float(_gammas_lo.get(step_min, 1.0)) if _gammas_lo is not None\n249\t                    else float(seas_gamma_lo))\n250\t        key = (g, g_lo)\n251\t        if key not in _prof_cache:\n252\t            _prof_cache[key] = (\n253\t                prof_raw if g == 1.0 and g_lo == 1.0\n254\t                else {k: _bend(v, g, g_lo) for k, v in prof_raw.items()}\n255\t            )\n256\t        return _prof_cache[key]\n257\t    hl = np.asarray(halflives, dtype=float)\n258\t    wts = np.asarray(weights, dtype=float)\n259\t    wts = wts / wts.sum()\n260\t\n261\t    def f(asset, start_time, time_increment, time_length, num_simulations, context_prices, rng):\n262\t        steps = time_length // time_increment + 1\n263\t        step_min = max(1, time_increment // 60)\n264\t        vals, idx, last = _step_closes(context_prices, step_min)\n265\t        r, rend = _log_returns(vals, idx, step_min)\n266\t        if r.size < 30 or not np.isfinite(last):\n267\t            sigma_path = np.full(steps - 1, 5e-4)\n268\t        else:\n269\t            r = r[-pool_steps:]\n270\t            rend = rend[-pool_steps:]\n271\t            if seasonal:\n272\t                key = f\"{asset}_{step_min}\"\n273\t                p = _profile_for(step_min).get(key)\n274\t                if p is None:\n275\t                    p = np.ones(_seas.N_BUCKETS)\n276\t                # bucket of each observed return, from its END minute\n277\t                b = (rend % (7 * 24 * 60)) // _seas.BUCKET_MIN\n278\t                s_hist = p[b]\n279\t                fut_b = _tow_index(pd.Timestamp(start_time), steps, step_min)[1:]\n280\t                s_fut = p[fut_b]\n281\t            else:\n282\t                s_hist = np.ones(r.size)\n283\t                s_fut = np.ones(steps - 1)\n284\t\n285\t            u = r / s_hist\n286\t            s0 = 1.4826 * np.median(np.abs(u - np.median(u))) + 1e-12\n287\t            u = np.clip(u, -winsor * s0, winsor * s0)\n288\t            if est == \"mad\":\n289\t                # EWMA of |u| rescaled to a Gaussian sd. For fat-tailed prints the RMS is\n290\t                # dominated by a handful of jumps while CRPS is paid on the bulk; the L1\n291\t                # estimator tracks the bulk and should need less per-asset shrink.\n292\t                u2 = np.abs(u) * np.sqrt(np.pi / 2.0)\n293\t                v_multi = np.maximum(_ewma_var_multi(u2, hl), MIN_SIGMA)\n294\t            else:\n295\t                u2 = u * u\n296\t                v_multi = np.sqrt(np.maximum(_ewma_var_multi(u2, hl), MIN_SIGMA**2))\n297\t            v0 = float(np.exp(np.sum(wts * np.log(v_multi))))\n298\t            if fitc is not None:\n299\t                # Same deseasonalised returns, but the level comes from the fitted regression.\n300\t                # Features must be built on the RAW (gamma=1) profile the fit was trained on.\n301\t                import volfit as _vf1\n302\t                C = fitc.get(f\"{asset}_{step_min}\")\n303\t                if C is not None:\n304\t                    praw = prof_raw.get(f\"{asset}_{step_min}\", np.ones(_seas.N_BUCKETS))\n305\t                    uf = r / praw[(rend % (7 * 24 * 60)) // _seas.BUCKET_MIN]\n306\t                    xf = _vf1.features(uf, _vf1.halflives_for(step_min))\n307\t                    v0 = float(np.exp((C @ np.concatenate([[1.0], xf]))[-1]))\n308\t            if revert_halflife > 0:\n309\t                _vl = float(_ewma_var_multi(u2, [long_halflife])[0])\n310\t                v_long = max(_vl if est == \"mad\" else np.sqrt(max(_vl, MIN_SIGMA**2)), MIN_SIGMA)\n311\t                k = np.arange(1, steps)\n312\t                phi = 0.5 ** (k / revert_halflife)\n313\t                v_k = np.exp(np.log(v_long) + phi * (np.log(v0) - np.log(v_long)))\n314\t            else:\n315\t                v_k = np.full(steps - 1, v0)\n316\t            sigma_path = v_k * s_fut\n317\t\n318\t        sc = scale * (1.0 if scale_map is None else float(scale_map.get(asset, 1.0)))\n319\t        if act_beta:"}]},"parent_tool_use_id":null,"session_id":"e0fdc998-0d4c-4bec-aa01-713aae481473","uuid":"81ef1505-72cd-4259-a284-422b301d8f30","timestamp":"2026-09-29T22:23:52.210Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/agent/models.py","content":"\n    return f\n\n\n# --------------------------------------------------------------------------- seasonal SV family\n\nimport seasonality as _seas  # noqa: E402\n\n\ndef _tow_index(ts0, n: int, step_min: int) -> np.ndarray:\n    \"\"\"Time-of-week bucket for each of the n future scoring points starting at ts0.\"\"\"\n    t0 = pd.Timestamp(ts0)\n    minute_of_week = (t0.dayofweek * 24 * 60 + t0.hour * 60 + t0.minute) + np.arange(n) * step_min\n    return (minute_of_week % (7 * 24 * 60)) // _seas.BUCKET_MIN\n\n\ndef _ewma_var_multi(x2: np.ndarray, halflives) -> np.ndarray:\n    \"\"\"EWMA of x2 at several half-lives (in steps), evaluated at the last point.\"\"\"\n    out = []\n    n = x2.size\n    ar = np.arange(n - 1, -1, -1)\n    for hl in halflives:\n        w = 0.5 ** (ar / hl)\n        out.append(np.sum(w * x2) / np.sum(w))\n    return np.array(out)\n\n\ndef sv_model(\n    profile: str = \"tow_pre0701.npz\",\n    seasonal: bool = True,\n    # Profile is raised to this power: 0 = flat, 1 = as measured, >1 = un-shrink it. A dict maps\n    # step size in minutes -> exponent, because the 5-minute and 1-minute profiles want opposite\n    # corrections (see journal Iter 12); a bare float applies to every step size.\n    seas_gamma: float | dict = 1.0,\n    # Optional separate exponent for profile values BELOW 1 (quiet buckets). None = symmetric.\n    seas_gamma_lo: float | dict | None = None,\n    # Width responds to how busy the tape is right now vs normal for this time of week, as a\n    # single bounded multiplier exp(beta * a) clipped to [1/act_cap, act_cap]. 0 disables it.\n    act_beta: float = 0.0,\n    act_halflives=(24.0, 1152.0),   # steps: ~2h and ~4d at the 5-minute step\n    act_cap: float = 1.30,\n    scale: float = 0.9,\n    scale_map=None,   # per-asset multiplier on top of `scale`, fitted out-of-sample\n    dist: str = \"t\",\n    nu: float = 4.0,\n    halflives=(12.0, 72.0, 576.0),\n    weights=(0.3, 0.3, 0.4),\n    revert_halflife: float = 0.0,   # steps; 0 = no mean reversion toward the long level\n    long_halflife: float = 2016.0,\n    vol_of_vol: float = 0.0,        # sd of a per-path log-level shock\n    est: str = \"rms\",               # \"rms\" (EWMA of u^2) or \"mad\" (EWMA of |u|)\n    level: str = \"ewma\",            # \"ewma\" = blended EWMA vols; \"fit\" = volfit regression\n    volfit_art: str = \"volfit_pre0701.npz\",\n    winsor: float = 6.0,\n    pool_steps: int = 4032,\n):\n    \"\"\"Seasonal stochastic-volatility simulator.\n\n      r_k = sigma_k * z,   sigma_k = scale * v_k * s(t_k)\n\n    `s` is the committed time-of-week profile; `v_k` is a log-linear reversion from the current\n    deseasonalised level `v0` (a weighted blend of EWMA variances) toward the long-run level.\n    \"\"\"\n    prof_raw = _seas.load(profile)\n    fitc = None\n    if level == \"fit\":\n        import volfit as _vf0\n        fitc = _vf0.load(volfit_art)\n    _gammas = dict(seas_gamma) if isinstance(seas_gamma, dict) else None\n    _gammas_lo = dict(seas_gamma_lo) if isinstance(seas_gamma_lo, dict) else None\n    _prof_cache: dict[tuple, dict] = {}\n\n    def _bend(v, g_hi, g_lo):\n        \"\"\"Raise the profile to g_hi above 1 and g_lo below it, then renormalise to mean 1.\n\n        The profile is already mean-normalised, so 1 is the natural hinge: values above it are\n        busy buckets and values below are quiet ones. They get separate exponents because the\n        shrinkage being undone is not symmetric -- the 0.25 floor in seasonality.py only ever\n        binds at the bottom.\n        \"\"\"\n        out = np.where(v >= 1.0, v**g_hi, v**g_lo)\n        return out / out.mean()\n\n    def _profile_for(step_min: int):\n        g = float(_gammas.get(step_min, 1.0)) if _gammas is not None else float(seas_gamma)\n        if seas_gamma_lo is None:\n            g_lo = g\n        else:\n            g_lo = (float(_gammas_lo.get(step_min, 1.0)) if _gammas_lo is not None\n                    else float(seas_gamma_lo))\n        key = (g, g_lo)\n        if key not in _prof_cache:\n            _prof_cache[key] = (\n                prof_raw if g == 1.0 and g_lo == 1.0\n                else {k: _bend(v, g, g_lo) for k, v in prof_raw.items()}\n            )\n        return _prof_cache[key]\n    hl = np.asarray(halflives, dtype=float)\n    wts = np.asarray(weights, dtype=float)\n    wts = wts / wts.sum()\n\n    def f(asset, start_time, time_increment, time_length, num_simulations, context_prices, rng):\n        steps = time_length // time_increment + 1\n        step_min = max(1, time_increment // 60)\n        vals, idx, last = _step_closes(context_prices, step_min)\n        r, rend = _log_returns(vals, idx, step_min)\n        if r.size < 30 or not np.isfinite(last):\n            sigma_path = np.full(steps - 1, 5e-4)\n        else:\n            r = r[-pool_steps:]\n            rend = rend[-pool_steps:]\n            if seasonal:\n                key = f\"{asset}_{step_min}\"\n                p = _profile_for(step_min).get(key)\n                if p is None:\n                    p = np.ones(_seas.N_BUCKETS)\n                # bucket of each observed return, from its END minute\n                b = (rend % (7 * 24 * 60)) // _seas.BUCKET_MIN\n                s_hist = p[b]\n                fut_b = _tow_index(pd.Timestamp(start_time), steps, step_min)[1:]\n                s_fut = p[fut_b]\n            else:\n                s_hist = np.ones(r.size)\n                s_fut = np.ones(steps - 1)\n\n            u = r / s_hist\n            s0 = 1.4826 * np.median(np.abs(u - np.median(u))) + 1e-12\n            u = np.clip(u, -winsor * s0, winsor * s0)\n            if est == \"mad\":\n                # EWMA of |u| rescaled to a Gaussian sd. For fat-tailed prints the RMS is\n                # dominated by a handful of jumps while CRPS is paid on the bulk; the L1\n                # estimator tracks the bulk and should need less per-asset shrink.\n                u2 = np.abs(u) * np.sqrt(np.pi / 2.0)\n                v_multi = np.maximum(_ewma_var_multi(u2, hl), MIN_SIGMA)\n            else:\n                u2 = u * u\n                v_multi = np.sqrt(np.maximum(_ewma_var_multi(u2, hl), MIN_SIGMA**2))\n            v0 = float(np.exp(np.sum(wts * np.log(v_multi))))\n            if fitc is not None:\n                # Same deseasonalised returns, but the level comes from the fitted regression.\n                # Features must be built on the RAW (gamma=1) profile the fit was trained on.\n                import volfit as _vf1\n                C = fitc.get(f\"{asset}_{step_min}\")\n                if C is not None:\n                    praw = prof_raw.get(f\"{asset}_{step_min}\", np.ones(_seas.N_BUCKETS))\n                    uf = r / praw[(rend % (7 * 24 * 60)) // _seas.BUCKET_MIN]\n                    xf = _vf1.features(uf, _vf1.halflives_for(step_min))\n                    v0 = float(np.exp((C @ np.concatenate([[1.0], xf]))[-1]))\n            if revert_halflife > 0:\n                _vl = float(_ewma_var_multi(u2, [long_halflife])[0])\n                v_long = max(_vl if est == \"mad\" else np.sqrt(max(_vl, MIN_SIGMA**2)), MIN_SIGMA)\n                k = np.arange(1, steps)\n                phi = 0.5 ** (k / revert_halflife)\n                v_k = np.exp(np.log(v_long) + phi * (np.log(v0) - np.log(v_long)))\n            else:\n                v_k = np.full(steps - 1, v0)\n            sigma_path = v_k * s_fut\n\n        sc = scale * (1.0 if scale_map is None else float(scale_map.get(asset, 1.0)))\n        if act_beta:","numLines":160,"startLine":160,"totalLines":446}}}
