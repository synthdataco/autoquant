rather than hash() -- Python salts str hashing per process, so hash() would make a\n    run irreproducible across processes even with the env var pinned.\n    \"\"\"\n    env = os.environ.get(\"SYNTH_BENCHMARK_SEED\")\n    base = int(env) if env not in (None, \"\") else DEFAULT_SEED\n    tag = f\"{base}|{asset}|{start_time}\".encode()\n    return int.from_bytes(hashlib.blake2b(tag, digest_size=8).digest(), \"big\") % (2**63 - 1)\n\n\ndef simulate(\n    asset: str,\n    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    rng = np.random.default_rng(_seed(asset, start_time))\n    paths = _model()(\n        asset=asset,\n        start_time=start_time,\n        time_increment=time_increment,\n        time_length=time_length,\n        num_simulations=num_simulations,\n        context_prices=context_prices,\n        rng=rng,\n    )\n    paths = np.asarray(paths, dtype=float)\n    steps = time_length // time_increment + 1\n    assert paths.shape == (num_simulations, steps), paths.shape\n    return (start_time, time_increment, *[p.tolist() for p in paths])\n","structuredPatch":[{"oldStart":1,"oldLines":14,"newStart":1,"newLines":35,"lines":[" \"\"\"Champion model — the entry point the validator calls."," ","-`simulate()` delegates to a factory in `models.py` selected by CHAMPION_SPEC, so the exact","-object the evaluation harness swept is the object that gets served.","+One configuration serves all three scoring configurations (CRYPTO_24H, COM_EQU_24H, CRYPTO_1H).","+Everything in it survived an out-of-sample check: fitted or tuned on one window, and kept only","+if it still helped on a later, disjoint one."," ","+    r_k = scale(asset) * v_k * s(t_k) * z,    price_k = last * exp(cumsum(r))","+","+  * `s` — committed time-of-week volatility profile (`seasonality.py`). The venues never close","+    but the underlying markets do; mean |5-min return| swings ~1.8x over the week for cryp