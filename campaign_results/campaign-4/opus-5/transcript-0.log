","+context -- and shrinking toward it should cut the part of the forecast error that comes from the","+context being an unrepresentative week.","+","+Each validation window is scored against an artifact fitted strictly before it.","+\"\"\"","+","+from __future__ import annotations","+","+import sys","+from pathlib import Path","+","+import pandas as pd","+","+sys.path.insert(0, str(Path(__file__).resolve().parent))","+","+from evaluate import EvalConfig, run  # noqa: E402","+from modeling import CHAMPION_SPEC  # noqa: E402","+from sweep import ASSETS  # noqa: E402","+","+WINDOWS = {\"dev\": [(\"2026-07-05\", \"2026-07-23\")], \"val3\": [(\"2026-07-24\", \"2026-08-25\")],","+           \"test\": [(\"2026-08-26\", \"2026-09-13\")]}","+BLENDS = (0.0, 0.25, 0.5, 0.75, 1.0)","+LEVELS = (0.90, 0.95, 1.00)","+LEGS = ((\"comequ-24h\", \"comequ\", 86400, 300),","+        (\"crypto-24h\", \"crypto\", 86400, 300),","+        (\"crypto-1h\", \"crypto\", 3600, 60))","+","+","+def main() -> None:","+    _, base = CHAMPION_SPEC","+    kw = dict(base, profile=\"tow_pre0701.npz\", nu_art=\"nu_pre0701.npz\")","+    for label, group, tl, ti in LEGS:","+        step = ti // 60","+        res: dict[float, dict[str, float]] = {}","+        for wname, win in WINDOWS.items():","+            cfg = EvalConfig(windows=win, assets=ASSETS[group], time_length=tl, time_increment=ti,","+                             cadence_minutes=180, num_simulations=500)","+            for b in BLENDS:","+                res.setdefault(b, {})[wname] = min(","+                    run((\"models\", \"sv_model\", dict(kw, nu_blend=b, scale={step: lv})), cfg)","+                    .groupby(\"asset\")[\"crps\"].mean().mean() for lv in LEVELS)","+        tab = pd.DataFrame(res).T","+        for w in WINDOWS:","+            tab[w + \"_%\"] = 100 * (tab[w] / tab.loc[0.0, w] - 1)","+        tab.index.name = \"nu_blend\"","+        print(f\"### {label}  (min over level grid {LEVELS})\")","+        print(tab.round(3).to_string())","+        print()","+","+","+if __name__ == \"__main__\":","+    main()"]}],"created":true}],"moreFiles":0,"changedFiles":["/workspace/agent/exp_nu.py"]}}}
