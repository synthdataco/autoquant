ength: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    rng = np.random.default_rng(_seed(start_time))\n    paths = _model()(\n        asset=asset,\n        start_time=start_time,\n        time_increment=time_increment,\n        time_length=time_length,\n        num_simulations=num_simulations,\n        context_prices=context_prices,\n        rng=rng,\n    )\n    paths = np.asarray(paths, dtype=float)\n    steps = time_length // time_increment + 1\n    assert paths.shape == (num_simulations, steps), paths.shape\n    return (start_time, time_increment, *[p.tolist() for p in paths])\n","structuredPatch":[{"oldStart":1,"oldLines":15,"newStart":1,"newLines":47,"lines":["-\"\"\"Starter model written by the harness: log-normal martingale calibrated on the context.","+\"\"\"Champion model — the entry point the validator calls."," ","-This is a deliberately simple STARTING POINT — replace it with your own model.","+`simulate()` delegates to a factory in `models.py` selected by CHAMPION_SPEC, so the exact","+object the evaluation harness swept is the object that gets served.","+"," Contract: simulate(...) -> (start_timestamp, time_increment, *paths), each path has","-time_length//time_increment + 1 points starting at the context's last price.","+time_length // time_increment + 1 floats and starts at the last observed close of the context."," \"\"\""," "," from __future__ import annotations"," ","+import os","+import sys","+from pathlib import Path","+"," import numpy as np"," ","+sys.path.insert(0, str(Path(__file__).resolve().parent))"," ","+import models  # noqa: E402","+","+# (factory name in models.py, kwargs)","+CHAMPION_SPEC = (\"iid_model\", {\"dist\": \"t\", \"scale\": 0.9, \"nu\": 4.0})","+","+_MODEL = None","+","+","+def _model():","+    global _MODEL","+    if _MODEL is None:","+        name, kwargs = CHAMPION_SPEC","+        _MODEL = getattr(models, name)(**kwargs)","+    return _MODEL","+","+","+def _seed(start_time) -> int:","+    \"\"\"Seed every generator from SYNTH_BENCHMARK_SEED when it is set (evaluation), and from a","+    deterministic function of the prompt otherwise (our own runs), so nothing is ever left to","+    the clock or OS entropy.\"\"\"","+    env = os.environ.get(\"SYNTH_BENCHMARK_SEED\")","+    base = int(env) if env not in (None, \"\") else 20260914","+    return (base * 1_000_003 + hash(str(start_time)) % 1_000_003) % (2**63 - 1)","+","+"," def simulate(","     asset: str,","     start_time,"]},{"oldStart":18,"oldLines":14,"newStart":50,"newLines":17,"lines":["     num_simulations: int = 1000,","     context_prices=None,"," ):","+    rng = np.random.default_rng(_seed(start_time))","+    paths = _model()(","+        asset=asset,","+        start_time=start_time,","+        time_increment=time_increment,","+        time_length=time_length,","+        num_simulations=num_simulations,","+        context_prices=context_prices,","+        rng=rng,","+    )","+    paths = np.asarray(paths, dtype=float)","     steps = time_length // time_increment + 1","-    closes = context_prices[\"close\"].dropna()","-    last = float(closes.iloc[-1])","-    rets = np.diff(np.log(np.asarray(closes, dtype=float)))","-    rets = rets[np.isfinite(rets)]","-    per_step_sigma = float(np.std(rets)) * (time_increment / 60.0) ** 0.5 if rets.size > 10 else 1e-3","-    rng = np.random.default_rng()","-    shocks = rng.normal(0.0, per_step_sigma, size=(num_simulations, steps))","-    shocks[:, 0] = 0.0","-    paths = last * np.exp(np.cumsum(shocks, axis=1))","+    assert paths.shape == (num_simulations, steps), paths.shape","     return (start_time, time_increment, *[p.tolist() for p in paths])"]}],"originalFile":"\"\"\"Starter model written by the harness: log-normal martingale calibrated on the context.\n\nThis is a deliberately simple STARTING POINT — replace it with your own model.\nContract: simulate(...) -> (start_timestamp, time_increment, *paths), each path has\ntime_length//time_increment + 1 points starting at the context's last price.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\n\n\ndef simulate(\n    asset: str,\n    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    steps = time_length // time_increment + 1\n    closes = context_prices[\"close\"].dropna()\n    last = float(closes.iloc[-1])\n    rets = np.diff(np.log(np.asarray(closes, dtype=float)))\n    rets = rets[np.isfinite(rets)]\n    per_step_sigma = float(np.std(rets)) * (time_increment / 60.0) ** 0.5 if rets.size > 10 else 1e-3\n    rng = np.random.default_rng()\n    shocks = rng.normal(0.0, per_step_sigma, size=(num_simulations, steps))\n    shocks[:, 0] = 0.0\n    paths = last * np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *[p.tolist() for p in paths])\n","userModified":false}}
