AX\": 0.758,","+    \"GOOGLX\": 0.744,","+    \"TSLAX\": 0.727,","+    \"AAPLX\": 0.770,","+    \"WTIOIL\": 0.883,","+    \"SPCX\": 0.833,","+    \"SP500\": 0.873,","+}"," ","+CHAMPION_SPEC = (","+    \"sv_model\",","+    {","+        \"profile\": \"tow_full.npz\",","+        \"seasonal\": True,","+        \"seas_gamma\": 0.85,","+        \"scale\": 0.90,","+        \"scale_map\": SCALE_MAP,","+        \"dist\": \"t\",","+        \"nu\": 4.0,","+        \"halflives\": (12.0, 72.0, 576.0),","+        \"weights\": (0.3, 0.3, 0.4),","+        \"revert_halflife\": 96.0,","+        \"long_halflife\": 2016.0,","+        \"winsor\": 6.0,","+        \"pool_steps\": 4032,","+    },","+)","+","+DEFAULT_SEED = 20260914","+"," _MODEL = None"," "," "]},{"oldStart":33,"oldLines":13,"newStart":86,"newLines":17,"lines":["     return _MODEL"," "," ","-def _seed(start_time) -> int:","-    \"\"\"Seed every generator from SYNTH_BENCHMARK_SEED when it is set (evaluation), and from a","-    deterministic function of the prompt otherwise (our own runs), so nothing is ever left to","-    the clock or OS entropy.\"\"\"","+def _seed(asset, start_time) -> int:","+    \"\"\"Deterministic seed, taken from SYNTH_BENCHMARK_SEED whenever it is set.","+","+    Mixed with the prompt so that two prompts in the same run do not draw identical shocks, via","+    blake2b rather than hash() -- Python salts str hashing per process, so hash() would make a","+    run irreproducible across processes even with the env var pinned.","+    \"\"\"","     env = os.environ.get(\"SYNTH_BENCHMARK_SEED\")","-    base = int(env) if env not in (None, \"\") else 20260914","-    return (base * 1_000_003 + hash(str(start_time)) % 1_000_003) % (2**63 - 1)","+    base = int(env) if env not in (None, \"\") else DEFAULT_SEED","+    tag = f\"{base}|{asset}|{start_time}\".encode()","+    return int.from_bytes(hashlib.blake2b(tag, digest_size=8).digest(), \"big\") % (2**63 - 1)"," "," "," def simulate("]},{"oldStart":50,"oldLines":7,"newStart":107,"newLines":7,"lines":["     num_simulations: int = 1000,","     context_prices=None,"," ):","-    rng = np.random.default_rng(_seed(start_time))","+    rng = np.random.default_rng(_seed(asset, start_time))","     paths = _model()(","         asset=asset,","         start_time=start_time,"]}],"originalFile":"\"\"\"Champion model — the entry point the validator calls.\n\n`simulate()` delegates to a factory in `models.py` selected by CHAMPION_SPEC, so the exact\nobject the evaluation harness swept is the object that gets served.\n\nContract: simulate(...) -> (start_timestamp, time_increment, *paths), each path has\ntime_length // time_increment + 1 floats and starts at the last observed close of the context.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport sys\nfrom pathlib import Path\n\nimport numpy as np\n\nsys.path.insert(0, str(Path(__file__).resolve().parent))\n\nimport models  # noqa: E402\n\n# (factory name in models.py, kwargs)\nCHAMPION_SPEC = (\"iid_model\", {\"dist\": \"t\", \"scale\": 0.9, \"nu\": 4.0})\n\n_MODEL = None\n\n\ndef _model():\n    global _MODEL\n    if _MODEL is None:\n        name, kwargs = CHAMPION_SPEC\n        _MODEL = getattr(models, name)(**kwargs)\n    return _MODEL\n\n\ndef _seed(start_time) -> int:\n    \"\"\"Seed every generator from SYNTH_BENCHMARK_SEED when it is set (evaluation), and from a\n    deterministic function of the prompt otherwise (our own runs), so nothing is ever left to\n    the clock or OS entropy.\"\"\"\n    env = os.environ.get(\"SYNTH_BENCHMARK_SEED\")\n    base = int(env) if env not in (None, \"\") else 20260914\n    return (base * 1_000_003 + hash(str(start_time)) % 1_000_003) % (2**63 - 1)\n\n\ndef simulate(\n    asset: str,\n    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    rng = np.random.default_rng(_seed(start_time))\n    paths = _model()(\n        asset=asset,\n        start_time=start_time,\n        time_increment=time_increment,\n        time_length=time_length,\n        num_simulations=num_simulations,\n        context_prices=context_prices,\n        rng=rng,\n    )\n    paths = np.asarray(paths, dtype=float)\n    steps = time_length // time_increment + 1\n    assert paths.shape == (num_simulations, steps), paths.shape\n    return (start_time, time_increment, *[p.tolist() for p in paths])\n","userModified":false}}
