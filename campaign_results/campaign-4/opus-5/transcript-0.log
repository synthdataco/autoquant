{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UfNjiNWEDBXDBPrcLKVfjQ","type":"tool_result","content":"1\t\"\"\"Self-evaluation via the official synth-lib backtester.\n2\t\n3\tUsage: uv run agent/predict.py --asset BTC --days 3 --eval-end 2026-07-15\n4\tGenerates predictions from agent/modeling.py over a grid of past prompts (covered by the\n5\tsnapshot), writes them in the standard format, then scores them with backtest() (validator\n6\tCRPS + rank vs the real field via the Synth API).\n7\t\n8\t--num-simulations defaults to 1000, matching the validator's real serving size\n9\t(PromptConfig.num_simulations). Lowering it (e.g. for a quick local iteration loop) speeds up\n10\tgeneration at the cost of a slightly pessimistic CRPS: empirical CRPS is biased upward for\n11\tfewer sampled paths, and the real field's CRPS was computed at 1000.\n12\t\n13\tThe context a prompt gets ends BEFORE its start_time, and that is not an off-by-one. The store\n14\tlabels a minute bar by its OPEN time, so the bar labelled t closes at t+60s — and that close is\n15\tthe first point the prompt is scored against. A prompt is also issued before the start_time it is\n16\tscored from (ISSUANCE_LEAD_SECONDS). Ending the context at t would hand the model the answer to\n17\tits own first step, and a model tuned that way is optimising a problem it will not be scored on.\n18\t\"\"\"\n19\t\n20\tfrom __future__ import annotations\n21\t\n22\timport argparse\n23\timport json\n24\timport os\n25\timport sys\n26\tfrom datetime import datetime, timedelta, timezone\n27\tfrom pathlib import Path\n28\t\n29\timport pandas as pd\n30\t\n31\tfrom synth_lib.backtester.orchestration import backtest\n32\tfrom synth_lib.benchmark.generate_predictions import context_end\n33\tfrom synth_lib.preparation.config import OHLCV_COLUMNS, STORE_SUBDIR\n34\tfrom synth_lib.preparation.market_data import MinutePriceStore\n35\t\n36\t# All paths are resolved from the location of THIS file, never from the cwd: the\n37\t# script therefore works whether launched from the workspace root (`uv run agent/predict.py`)\n38\t# or from agent/. The price snapshot is mounted at the workspace root, not inside agent/.\n39\tAGENT_DIR = Path(__file__).resolve().parent\n40\tWORKSPACE = AGENT_DIR.parent\n41\tsys.path.insert(0, str(AGENT_DIR))\n42\t\n43\tfrom modeling import simulate  # noqa: E402  (import after adding AGENT_DIR to sys.path)\n44\t\n45\tCONTEXT_MINUTES = 7 * 24 * 60\n46\tPREDICTIONS_DIR = WORKSPACE / \"miner_outputs\" / \"campaign\" / \"predictions\"\n47\t\n48\t\n49\tdef ensure_workspace_cwd() -> None:\n50\t    \"\"\"Force the cwd to the workspace root.\n51\t\n52\t    NECESSARY: synth-lib's `backtest()` resolves the realized-price store via\n53\t    `MinutePriceStore(asset)` WITHOUT an explicit root (see `_price_store`), so it resolves\n54\t    relative to the cwd. Launched from agent/, it would look for `agent/market_data/`, find\n55\t    nothing, and attempt an `ingest_range` (download + write) against a snapshot mounted\n56\t    READ-ONLY — a cryptic error. The snapshot is mounted at the workspace root: we move there.\"\"\"\n57\t    os.chdir(WORKSPACE)\n58\t\n59\t\n60\tdef store_root(asset: str) -> Path:\n61\t    \"\"\"Where this asset's partitions live inside the snapshot.\n62\t\n63\t    Resolved by synth-lib rather than hardcoded: the canonical directory is `market_data/prices/`,\n64\t    with a fallback to the legacy `market_data/pyth/` when that is what the snapshot contains. Do\n65\t    Anchored on WORKSPACE, not the cwd — synth-lib's default_store_root() resolves relative to the\n66\t    cwd, which would break the invariant this file relies on everywhere else.\"\"\"\n67\t    return WORKSPACE / \"market_data\" / STORE_SUBDIR / asset / \"1m\"\n68\t\n69\t\n70\tdef check_snapshot_coverage(asset: str, start: datetime, end: datetime) -> None:\n71\t    \"\"\"Fails EARLY and clearly if the requested window falls outside the frozen snapshot.\n72\t\n73\t    Without this guard, synth-lib would try to ingest the missing days (network + write) and\n74\t    the error would surface in an unreadable form.\"\"\"\n75\t    root = store_root(asset)\n76\t    missing = []\n77\t    cursor = start.date()\n78\t    while cursor <= end.date():\n79\t        if not (root / f\"date={cursor.isoformat()}.parquet\").exists():\n80\t            missing.append(cursor.isoformat())\n81\t        cursor += timedelta(days=1)\n82\t    if missing:\n83\t        raise SystemExit(\n84\t            f\"window outside snapshot for {asset}: missing partitions {missing[:5]}\"\n85\t            f\"{' …' if len(missing) > 5 else ''}\\n\"\n86\t            f\"The snapshot is frozen (read-only) and stops at the campaign's data_cutoff. \"\n87\t            f\"Reduce --eval-end / --days to stay within the available coverage ({root}).\"\n88\t        )\n89\t\n90\t\n91\tdef generate(\n92\t    asset: str,\n93\t    start: datetime,\n94\t    end: datetime,\n95\t    cadence_minutes: int = 60,\n96\t    time_increment: int = 300,\n97\t    time_length: int = 86_400,\n98\t    num_simulations: int = 1000,\n99\t) -> int:\n100\t    store = MinutePriceStore(asset, root=store_root(asset))\n101\t    df = store.load_range(start - timedelta(minutes=CONTEXT_MINUTES), end).set_index(\"timestamp\")\n102\t    prices = df[OHLCV_COLUMNS]\n103\t    PREDICTIONS_DIR.mkdir(parents=True, exist_ok=True)\n104\t    end_ts = pd.Timestamp(end)\n105\t    n = 0\n106\t    for t in pd.date_range(start, end, freq=f\"{cadence_minutes}min\", tz=\"UTC\"):\n107\t        if t >= end_ts:\n108\t            break\n109\t        # Never `prices.loc[:t]` — see the module docstring. Same cut the scored evaluation uses.\n110\t        context = prices.loc[: context_end(t, time_length)][-CONTEXT_MINUTES:]\n111\t        out = simulate(\n112\t            asset=asset,\n113\t            start_time=t.isoformat(),\n114\t            time_increment=time_increment,\n115\t            time_length=time_length,\n116\t            num_simulations=num_simulations,\n117\t            context_prices=context,\n118\t        )\n119\t        paths = [list(map(float, p)) for p in out[2:]]\n120\t        record = {\n121\t            \"start_timestamp\": t.isoformat(),\n122\t            \"asset\": asset,\n123\t            \"time_increment\": time_increment,\n124\t            \"time_length\": time_length,\n125\t            \"num_simulations\": len(paths),\n126\t            \"num_steps\": len(paths[0]),\n127\t            \"paths\": paths,\n128\t        }\n129\t        name = t.strftime(\"%Y-%m-%d_%H:%M:%SZ\") + f\"_{asset}_{time_length}.json\"\n130\t        (PREDICTIONS_DIR / name).write_text(json.dumps(record))\n131\t        n += 1\n132\t    return n\n133\t\n134\t\n135\tdef main() -> None:\n136\t    ap = argparse.ArgumentParser()\n137\t    ap.add_argument(\"--asset\", default=\"BTC\")\n138\t    ap.add_argument(\"--days\", type=int, default=3)\n139\t    ap.add_argument(\"--eval-end\", required=True, help=\"YYYY-MM-DD, must be <= data_cutoff\")\n140\t    ap.add_argument(\"--time-increment\", type=int, default=300, help=\"seconds between points (60 for CRYPTO_1H)\")\n141\t    ap.add_argument(\"--time-length\", type=int, default=86_400, help=\"horizon in seconds (3600 for CRYPTO_1H)\")\n142\t    ap.add_argument(\n143\t        \"--num-simulations\",\n144\t        type=int,\n145\t        default=1000,\n146\t        help=\"Paths per prompt. The validator uses 1000; lowering this speeds up iteration at \"\n147\t        \"the cost of a slightly pessimistic CRPS (empirical CRPS is biased upward for fewer \"\n148\t        \"sampled paths, and the real field's CRPS was computed at 1000).\",\n149\t    )\n150\t    args = ap.parse_args()\n151\t    ensure_workspace_cwd()\n152\t    end = datetime.fromisoformat(args.eval_end).replace(tzinfo=timezone.utc)\n153\t    start = end - timedelta(days=args.days)\n154\t    # the context reaches back 7 days before the first prompt: coverage must extend that far\n155\t    check_snapshot_coverage(args.asset, start - timedelta(minutes=CONTEXT_MINUTES), end)\n156\t    n = generate(\n157\t        args.asset,\n158\t        start,\n159\t        end,\n160\t        time_increment=args.time_increment,\n161\t        time_length=args.time_length,\n162\t        num_simulations=args.num_simulations,\n163\t    )\n164\t    print(f\"predictions generated: {n}\")\n165\t    result = backtest(\n166\t        miner_name=\"campaign\",\n167\t        asset=args.asset,\n168\t        time_length=args.time_length,\n169\t        time_increment=args.time_increment,\n170\t        n_backtest_days=args.days,\n171\t        predictions_dir=PREDICTIONS_DIR,\n172\t        eval_end=end,\n173\t    )\n174\t    print(\"summary:\", result.summary)\n175\t\n176\t\n177\tif __name__ == \"__main__\":\n178\t    main()\n179\t"}]},"parent_tool_use_id":null,"session_id":"e0fdc998-0d4c-4bec-aa01-713aae481473","uuid":"f6d0fc9e-4d7a-4c57-b669-65f2e6c82f1a","timestamp":"2026-09-29T16:52:18.282Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/agent/predict.py","content":"\"\"\"Self-evaluation via the official synth-lib backtester.\n\nUsage: uv run agent/predict.py --asset BTC --days 3 --eval-end 2026-07-15\nGenerates predictions from agent/modeling.py over a grid of past prompts (covered by the\nsnapshot), writes them in the standard format, then scores them with backtest() (validator\nCRPS + rank vs the real field via the Synth API).\n\n--num-simulations defaults to 1000, matching the validator's real serving size\n(PromptConfig.num_simulations). Lowering it (e.g. for a quick local iteration loop) speeds up\ngeneration at the cost of a slightly pessimistic CRPS: empirical CRPS is biased upward for\nfewer sampled paths, and the real field's CRPS was computed at 1000.\n\nThe context a prompt gets ends BEFORE its start_time, and that is not an off-by-one. The store\nlabels a minute bar by its OPEN time, so the bar labelled t closes at t+60s — and that close is\nthe first point the prompt is scored against. A prompt is also issued before the start_time it is\nscored from (ISSUANCE_LEAD_SECONDS). Ending the context at t would hand the model the answer to\nits own first step, and a model tuned that way is optimising a problem it will not be scored on.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport sys\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nimport pandas as pd\n\nfrom synth_lib.backtester.orchestration import backtest\nfrom synth_lib.benchmark.generate_predictions import context_end\nfrom synth_lib.preparation.config import OHLCV_COLUMNS, STORE_SUBDIR\nfrom synth_lib.preparation.market_data import MinutePriceStore\n\n# All paths are resolved from the location of THIS file, never from the cwd: the\n# script therefore works whether launched from the workspace root (`uv run agent/predict.py`)\n# or from agent/. The price snapshot is mounted at the workspace root, not inside agent/.\nAGENT_DIR = Path(__file__).resolve().parent\nWORKSPACE = AGENT_DIR.parent\nsys.path.insert(0, str(AGENT_DIR))\n\nfrom modeling import simulate  # noqa: E402  (import after adding AGENT_DIR to sys.path)\n\nCONTEXT_MINUTES = 7 * 24 * 60\nPREDICTIONS_DIR = WORKSPACE / \"miner_outputs\" / \"campaign\" / \"predictions\"\n\n\ndef ensure_workspace_cwd() -> None:\n    \"\"\"Force the cwd to the workspace root.\n\n    NECESSARY: synth-lib's `backtest()` resolves the realized-price store via\n    `MinutePriceStore(asset)` WITHOUT an explicit root (see `_price_store`), so it resolves\n    relative to the cwd. Launched from agent/, it would look for `agent/market_data/`, find\n    nothing, and attempt an `ingest_range` (download + write) against a snapshot mounted\n    READ-ONLY — a cryptic error. The snapshot is mounted at the workspace root: we move there.\"\"\"\n    os.chdir(WORKSPACE)\n\n\ndef store_root(asset: str) -> Path:\n    \"\"\"Where this asset's partitions live inside the snapshot.\n\n    Resolved by synth-lib rather than hardcoded: the canonical directory is `market_data/prices/`,\n    with a fallback to the legacy `market_data/pyth/` when that is what the snapshot contains. Do\n    Anchored on WORKSPACE, not the cwd — synth-lib's default_store_root() resolves relative to the\n    cwd, which would break the invariant this file relies on everywhere else.\"\"\"\n    return WORKSPACE / \"market_data\" / STORE_SUBDIR / asset / \"1m\"\n\n\ndef check_snapshot_coverage(asset: str, start: datetime, end: datetime) -> None:\n    \"\"\"Fails EARLY and clearly if the requested window falls outside the frozen snapshot.\n\n    Without this guard, synth-lib would try to ingest the missing days (network + write) and\n    the error would surface in an unreadable form.\"\"\"\n    root = store_root(asset)\n    missing = []\n    cursor = start.date()\n    while cursor <= end.date():\n        if not (root / f\"date={cursor.isoformat()}.parquet\").exists():\n            missing.append(cursor.isoformat())\n        cursor += timedelta(days=1)\n    if missing:\n        raise SystemExit(\n            f\"window outside snapshot for {asset}: missing partitions {missing[:5]}\"\n            f\"{' …' if len(missing) > 5 else ''}\\n\"\n            f\"The snapshot is frozen (read-only) and stops at the campaign's data_cutoff. \"\n            f\"Reduce --eval-end / --days to stay within the available coverage ({root}).\"\n        )\n\n\ndef generate(\n    asset: str,\n    start: datetime,\n    end: datetime,\n    cadence_minutes: int = 60,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n) -> int:\n    store = MinutePriceStore(asset, root=store_root(asset))\n    df = store.load_range(start - timedelta(minutes=CONTEXT_MINUTES), end).set_index(\"timestamp\")\n    prices = df[OHLCV_COLUMNS]\n    PREDICTIONS_DIR.mkdir(parents=True, exist_ok=True)\n    end_ts = pd.Timestamp(end)\n    n = 0\n    for t in pd.date_range(start, end, freq=f\"{cadence_minutes}min\", tz=\"UTC\"):\n        if t >= end_ts:\n            break\n        # Never `prices.loc[:t]` — see the module docstring. Same cut the scored evaluation uses.\n        context = prices.loc[: context_end(t, time_length)][-CONTEXT_MINUTES:]\n        out = simulate(\n            asset=asset,\n            start_time=t.isoformat(),\n            time_increment=time_increment,\n            time_length=time_length,\n            num_simulations=num_simulations,\n            context_prices=context,\n        )\n        paths = [list(map(float, p)) for p in out[2:]]\n        record = {\n            \"start_timestamp\": t.isoformat(),\n            \"asset\": asset,\n            \"time_increment\": time_increment,\n            \"time_length\": time_length,\n            \"num_simulations\": len(paths),\n            \"num_steps\": len(paths[0]),\n            \"paths\": paths,\n        }\n        name = t.strftime(\"%Y-%m-%d_%H:%M:%SZ\") + f\"_{asset}_{time_length}.json\"\n        (PREDICTIONS_DIR / name).write_text(json.dumps(record))\n        n += 1\n    return n\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--asset\", default=\"BTC\")\n    ap.add_argument(\"--days\", type=int, default=3)\n    ap.add_argument(\"--eval-end\", required=True, help=\"YYYY-MM-DD, must be <= data_cutoff\")\n    ap.add_argument(\"--time-increment\", type=int, default=300, help=\"seconds between points (60 for CRYPTO_1H)\")\n    ap.add_argument(\"--time-length\", type=int, default=86_400, help=\"horizon in seconds (3600 for CRYPTO_1H)\")\n    ap.add_argument(\n        \"--num-simulations\",\n        type=int,\n        default=1000,\n        help=\"Paths per prompt. The validator uses 1000; lowering this speeds up iteration at \"\n        \"the cost of a slightly pessimistic CRPS (empirical CRPS is biased upward for fewer \"\n        \"sampled paths, and the real field's CRPS was computed at 1000).\",\n    )\n    args = ap.parse_args()\n    ensure_workspace_cwd()\n    end = datetime.fromisoformat(args.eval_end).replace(tzinfo=timezone.utc)\n    start = end - timedelta(days=args.days)\n    # the context reaches back 7 days before the first prompt: coverage must extend that far\n    check_snapshot_coverage(args.asset, start - timedelta(minutes=CONTEXT_MINUTES), end)\n    n = generate(\n        args.asset,\n        start,\n        end,\n        time_increment=args.time_increment,\n        time_length=args.time_length,\n        num_simulations=args.num_simulations,\n    )\n    print(f\"predictions generated: {n}\")\n    result = backtest(\n        miner_name=\"campaign\",\n        asset=args.asset,\n        time_length=args.time_length,\n        time_increment=args.time_increment,\n        n_backtest_days=args.days,\n        predictions_dir=PREDICTIONS_DIR,\n        eval_end=end,\n    )\n    print(\"summary:\", result.summary)\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":179,"startLine":1,"totalLines":179}}}
