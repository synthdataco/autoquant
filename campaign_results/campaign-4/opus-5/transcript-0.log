ontainer":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":159382,"cache_read_input_tokens":0,"cache_creation":{"ephemeral_5m_input_tokens":159382,"ephemeral_1h_input_tokens":0},"output_tokens":2,"service_tier":"standard","inference_geo":"global"},"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"e0fdc998-0d4c-4bec-aa01-713aae481473","uuid":"77fec41c-3dca-4133-b4e2-86caa04b5f70","timestamp":"2026-09-30T00:04:15.090Z"}
