t/results_table.py off_champ.json off_base.json # renders the tables in §6"," uv run python agent/eda_range.py                    # §5: range estimators, the diagnostic"," uv run python agent/eda_activity.py                 # §5: activity features, the diagnostic"," uv run python agent/exp_activity_crps.py            # §5: activity features, the CRPS test"," uv run python agent/exp_resolution.py               # §5: time-of-week resolution (24h legs)"," uv run python agent/exp_resolution.py 1h            # §5: the same at the 1-minute step"," uv run python agent/exp_scale_1h.py                 # §5: the width level at the 1-minute step","+uv run python agent/exp_leverage.py                 # §5: the leverage effect, both forms","+uv run python agent/exp_vov.py                      # §4: the AR(1) vol-of-vol factor"," ```"," "," `agent/harness.py` + `agent/evaluate.py` + `agent/sweep.py` are the fast iteration loop — 545"]}]}],"moreFiles":0,"changedFiles":["/workspace/agent/report.md"]}}}
