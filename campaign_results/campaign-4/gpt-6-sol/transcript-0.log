{"type":"item.started","item":{"id":"item_187","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport numpy as np,pandas as pd\nfrom datetime import date,timedelta\nfrom synth_lib.preparation.config import default_store_root\nimport sys\nsys.path.insert(0,'agent')\nfrom modeling import _factors\nfor asset in ['BTC','ETH','XAU']:\n root=default_store_root(asset);day=date(2026,5,18);frames=[]\n while day<=date(2026,7,31):\n  p=root/f'date={day}.parquet'\n  if p.exists():frames.append(pd.read_parquet(p,columns=['timestamp','close']))\n  day+=timedelta(days=1)\n df=pd.concat(frames,ignore_index=True);ts=pd.DatetimeIndex(pd.to_datetime(df.timestamp,utc=True));p=df.close.to_numpy(float)\n good=np.isfinite(p[1:])&np.isfinite(p[:-1])&(p[1:]>0)&(p[:-1]>0)&(np.diff(ts.to_numpy())==np.timedelta64(1,'m'))\n r=np.zeros(len(ts)-1);r[good]=np.log(p[1:][good]/p[:-1][good]);f=_factors(asset,ts[1:]);adj=r/np.sqrt(f)\n var=pd.Series(adj*adj).ewm(halflife=1440,min_periods=1440).mean().shift(1).to_numpy()\n z=adj/np.sqrt(var);z=z[good&np.isfinite(z)]\n print(asset,'n',len(z),'abs_q99',round(float(np.quantile(np.abs(z),.99)),3),'abs_q999',round(float(np.quantile(np.abs(z),.999)),3),'kurtosis',round(float(np.mean((z-np.mean(z))**4)/np.var(z)**2),1),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
