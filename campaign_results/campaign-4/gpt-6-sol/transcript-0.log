:41.195771+00:00\", \"asset\": \"SPCX\", \"time_length\": 86400, \"time_increment\": 300, \"prompt_selection\": \"exact historical starts\", \"file_format\": \"npy\", \"eval_end\": \"2026-09-10\", \"days\": 1, \"model_module\": \"fiveminute_calendar\", \"summary\": {\"miner_name\": \"campaign\", \"miner_id\": 999, \"num_prompts\": 48, \"mean_crps\": 4004.2035200364166, \"final_smoothed_score\": 178.97232146161886, \"realized_points_expected\": 13872, \"realized_points_scored\": 13872, \"realized_coverage\": 1.0}, \"experiment_label\": \"fiveminute-calendar-sep10\"}\n{\"run_at\": \"2026-09-30T19:41:30.762349+00:00\", \"asset\": \"SP500\", \"time_length\": 86400, \"time_increment\": 300, \"prompt_selection\": \"exact historical starts\", \"file_format\": \"npy\", \"eval_end\": \"2026-09-10\", \"days\": 1, \"model_module\": \"fiveminute_calendar\", \"summary\": {\"miner_name\": \"campaign\", \"miner_id\": 999, \"num_prompts\": 48, \"mean_crps\": 768.4636247080907, \"final_smoothed_score\": 11.660895024330214, \"realized_points_expected\": 13872, \"realized_points_scored\": 13872, \"realized_coverage\": 1.0}, \"experiment_label\": \"fiveminute-calendar-sep10\"}\n{\"run_at\": \"2026-09-30T19:45:08.191333+00:00\", \"asset\": \"XAU\", \"time_length\": 86400, \"time_increment\": 300, \"prompt_selection\": \"exact historical starts\", \"file_format\": \"npy\", \"eval_end\": \"2026-09-12\", \"days\": 9, \"model_module\": \"fiveminute_calendar\", \"summary\": {\"miner_name\": \"campaign\", \"miner_id\": 999, \"num_prompts\": 240, \"mean_crps\": 1454.7808782829504, \"final_smoothed_score\": 49.08276011750665, \"realized_points_expected\": 69360, \"realized_points_scored\": 69360, \"realized_coverage\": 1.0}, \"experiment_label\": \"fiveminute-calendar-sep-full\"}\n{\"run_at\": \"2026-09-30T19:48:30.838861+00:00\", \"asset\": \"NVDAX\", \"time_length\": 86400, \"time_increment\": 300, \"prompt_selection\": \"exact historical starts\", \"file_format\": \"npy\", \"eval_end\": \"20