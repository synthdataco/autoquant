{"type":"item.completed","item":{"id":"item_306","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' agent/predict.py\"","aggregated_output":"\"\"\"Self-evaluation via the official synth-lib backtester.\n\nUsage: uv run agent/predict.py --asset BTC --days 3 --eval-end 2026-07-15\nGenerates predictions from agent/modeling.py at exact historical prompt start times\nfrom the offline score cache, writes them in the standard format, then scores them\nwith backtest() (validator CRPS plus field-relative diagnostics). Both date bounds\nare inclusive in the cached score query, so --days 1 spans two scored dates.\n\n--num-simulations defaults to 1000, matching the validator's real serving size\n(PromptConfig.num_simulations). Lowering it (e.g. for a quick local iteration loop) speeds up\ngeneration at the cost of a slightly pessimistic CRPS: empirical CRPS is biased upward for\nfewer sampled paths, and the real field's CRPS was computed at 1000.\n\nThe context a prompt gets ends BEFORE its start_time, and that is not an off-by-one. The store\nlabels a minute bar by its OPEN time, so the bar labelled t closes at t+60s — and that close is\nthe first point the prompt is scored against. A prompt is also issued before the start_time it is\nscored from (ISSUANCE_LEAD_SECONDS). Ending the context at t would hand the model the answer to\nits own first step, and a model tuned that way is optimising a problem it will not be scored on.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport importlib\nimport json\nimport os\nimport sys\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nimport pandas as pd\nimport numpy as np\n\nfrom synth_lib.backtester.orchestration import backtest\nfrom synth_lib.backtester.loading import get_miner_scores\nfrom synth_lib.benchmark.generate_predictions import context_end\nfrom synth_lib.preparation.config import OHLCV_COLUMNS, default_store_root\nfrom synth_lib.preparation.market_data import MinutePriceStore\n\n# All paths are resolved from the location of THIS file, never from the cwd: the\n# script therefore works whether launched from the workspace root (`uv run agent/predict.py`)\n# or from agent/. The price snapshot is mounted at the workspace root, not inside agent/.\nAGENT_DIR = Path(__file__).resolve().parent\nWORKSPACE = AGENT_DIR.parent\nsys.path.insert(0, str(AGENT_DIR))\n\nCONTEXT_MINUTES = 7 * 24 * 60\nPREDICTIONS_DIR = WORKSPACE / \"miner_outputs\" / \"campaign\" / \"predictions\"\n\n\ndef ensure_workspace_cwd() -> None:\n    \"\"\"Force the cwd to the workspace root.\n\n    NECESSARY: synth-lib's `backtest()` resolves the realized-price store via\n    `MinutePriceStore(asset)` WITHOUT an explicit root (see `_price_store`), so it resolves\n    relative to the cwd. Launched from agent/, it would look for `agent/market_data/`, find\n    nothing, and attempt an `ingest_range` (download + write) against a snapshot mounted\n    READ-ONLY — a cryptic error. The snapshot is mounted at the workspace root: we move there.\"\"\"\n    os.chdir(WORKSPACE)\n\n\ndef store_root(asset: str) -> Path:\n    \"\"\"Where this asset's partitions live inside the snapshot.\n\n    synth-lib chooses the canonical or legacy store. main() first moves to the\n    workspace root so the library's relative-path check sees this snapshot.\"\"\"\n    root = default_store_root(asset)\n    return root if root.is_absolute() else WORKSPACE / root\n\n\ndef check_snapshot_coverage(asset: str, start: datetime, end: datetime) -> None:\n    \"\"\"Fails EARLY and clearly if the requested window falls outside the frozen snapshot.\n\n    Without this guard, synth-lib would try to ingest the missing days (network + write) and\n    the error would surface in an unreadable form.\"\"\"\n    root = store_root(asset)\n    missing = []\n    cursor = start.date()\n    while cursor <= end.date():\n        if not (root / f\"date={cursor.isoformat()}.parquet\").exists():\n            missing.append(cursor.isoformat())\n        cursor += timedelta(days=1)\n    if missing:\n        raise SystemExit(\n            f\"window outside snapshot for {asset}: missing partitions {missing[:5]}\"\n            f\"{' …' if len(missing) > 5 else ''}\\n\"\n            f\"The snapshot is frozen (read-only) and stops at the campaign's data_cutoff. \"\n            f\"Reduce --eval-end / --days to stay within the available coverage ({root}).\"\n        )\n\n\ndef generate(\n    asset: str,\n    prompt_times: pd.DatetimeIndex,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    model_module: str = \"modeling\",\n    predictions_dir: Path = PREDICTIONS_DIR,\n    file_format: str = \"json\",\n) -> int:\n    simulate = importlib.import_module(model_module).simulate\n    start = prompt_times.min().to_pydatetime()\n    end = prompt_times.max().to_pydatetime()\n    store = MinutePriceStore(asset, root=store_root(asset))\n    # load_range rejects NaN closes, which are legitimate no-trade minutes for\n    # several scored assets. Keep the raw minute grid and let simulate drop gaps.\n    first_day = (start - timedelta(minutes=CONTEXT_MINUTES)).date()\n    last_day = end.date()\n    frames = []\n    day = first_day\n    while day <= last_day:\n        frames.append(pd.read_parquet(store.day_path(day)))\n        day += timedelta(days=1)\n    df = pd.concat(frames, ignore_index=True)\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    df = df.set_index(\"timestamp\").sort_index()\n    prices = df[OHLCV_COLUMNS]\n    predictions_dir.mkdir(parents=True, exist_ok=True)\n    daily_runs: dict[str, list[tuple[str, np.ndarray]]] = {}\n    n = 0\n    for t in prompt_times:\n        # Never `prices.loc[:t]` — see the module docstring. Same cut the scored evaluation uses.\n        context = prices.loc[: context_end(t, time_length)][-CONTEXT_MINUTES:]\n        out = simulate(\n            asset=asset,\n            start_time=t.isoformat(),\n            time_increment=time_increment,\n            time_length=time_length,\n            num_simulations=num_simulations,\n            context_prices=context,\n        )\n        if file_format == \"npy\":\n            daily_runs.setdefault(t.strftime(\"%Y-%m-%d\"), []).append(\n                (t.isoformat(), np.asarray(out[2:], dtype=np.float32))\n            )\n            n += 1\n            continue\n        paths = [list(map(float, p)) for p in out[2:]]\n        record = {\n            \"start_timestamp\": t.isoformat(),\n            \"asset\": asset,\n            \"time_increment\": time_increment,\n            \"time_length\": time_length,\n            \"num_simulations\": len(paths),\n            \"num_steps\": len(paths[0]),\n            \"paths\": paths,\n        }\n        name = t.strftime(\"%Y-%m-%d_%H:%M:%SZ\") + f\"_{asset}_{time_length}.json\"\n        (predictions_dir / name).write_text(json.dumps(record))\n        n += 1\n    for day, items in daily_runs.items():\n        root = predictions_dir / asset / f\"{time_length}_{time_increment}\"\n        root.mkdir(parents=True, exist_ok=True)\n        stacked = np.stack([paths for _, paths in items])\n        np.save(root / f\"date={day}.npy\", stacked)\n        (root / f\"date={day}.json\").write_text(json.dumps({\n            \"start_times\": [start for start, _ in items],\n            \"asset\": asset,\n            \"time_increment\": time_increment,\n            \"time_length\": time_length,\n            \"num_simulations\": int(stacked.shape[1]),\n            \"num_steps\": int(stacked.shape[2]),\n        }))\n    return n\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--asset\", default=\"BTC\")\n    ap.add_argument(\"--days\", type=int, default=3)\n    ap.add_argument(\"--eval-end\", required=True, help=\"YYYY-MM-DD, must be <= data_cutoff\")\n    ap.add_argument(\"--time-increment\", type=int, default=300, help=\"seconds between points (60 for CRYPTO_1H)\")\n    ap.add_argument(\"--time-length\", type=int, default=86_400, help=\"horizon in seconds (3600 for CRYPTO_1H)\")\n    ap.add_argument(\"--model-module\", default=\"modeling\", help=\"agent module exposing simulate (default: modeling)\")\n    ap.add_argument(\"--predictions-dir\", type=Path, default=None, help=\"separate output directory for isolated experiments\")\n    ap.add_argument(\"--file-format\", choices=[\"json\", \"npy\"], default=\"json\", help=\"prediction storage; npy requires an isolated directory\")\n    ap.add_argument(\n        \"--num-simulations\",\n        type=int,\n        default=1000,\n        help=\"Paths per prompt. The validator uses 1000; lowering this speeds up iteration at \"\n        \"the cost of a slightly pessimistic CRPS (empirical CRPS is biased upward for fewer \"\n        \"sampled paths, and the real field's CRPS was computed at 1000).\",\n    )\n    args = ap.parse_args()\n    ensure_workspace_cwd()\n    if args.file_format == \"npy\" and args.predictions_dir is None:\n        raise SystemExit(\"--file-format npy requires --predictions-dir to avoid mixing with JSON prompts\")\n    end = datetime.fromisoformat(args.eval_end).replace(tzinfo=timezone.utc)\n    start = end - timedelta(days=args.days)\n    if end.date() > datetime(2026, 9, 14, tzinfo=timezone.utc).date():\n        raise SystemExit(\"eval-end exceeds the frozen data cutoff of 2026-09-14\")\n    scores = get_miner_scores(\n        start_time=start,\n        end_time=end,\n        asset=args.asset,\n        time_length=args.time_length,\n        time_increment=args.time_increment,\n    )\n    if scores.empty:\n        raise SystemExit(\"no historical prompts in requested window\")\n    prompt_times = pd.DatetimeIndex(pd.to_datetime(scores[\"start_time\"].drop_duplicates(), utc=True)).sort_values()\n    predictions_dir = args.predictions_dir or PREDICTIONS_DIR\n    if not predictions_dir.is_absolute():\n        predictions_dir = WORKSPACE / predictions_dir\n    # The context precedes the earliest prompt and each realized path extends to\n    # its horizon. Guard both edges before invoking the backtester.\n    check_snapshot_coverage(\n        args.asset,\n        prompt_times.min().to_pydatetime() - timedelta(minutes=CONTEXT_MINUTES),\n        # synth-lib's backtester currently reads through latest start + 26h,\n        # even for a 1h prompt. Guard that read range before it can ingest a\n        # missing day beyond this read-only snapshot.\n        prompt_times.max().to_pydatetime() + timedelta(seconds=max(args.time_length, 26 * 3600)),\n    )\n    n = generate(\n        args.asset,\n        prompt_times,\n        time_increment=args.time_increment,\n        time_length=args.time_length,\n        num_simulations=args.num_simulations,\n        model_module=args.model_module,\n        predictions_dir=predictions_dir,\n        file_format=args.file_format,\n    )\n    print(f\"predictions generated: {n}\")\n    result = backtest(\n        miner_name=\"campaign\",\n        asset=args.asset,\n        time_length=args.time_length,\n        time_increment=args.time_increment,\n        n_backtest_days=args.days,\n        predictions_dir=predictions_dir,\n        eval_end=end,\n    )\n    print(\"summary:\", result.summary)\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"status":"completed"}}
