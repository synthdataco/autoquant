y:139:        if not paths_file.exists():\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py:140:            continue  # an index without its paths is an interrupted write, not a prompt\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py:143:            index.setdefault(key, {})[pd.Timestamp(start)] = PredictionRef(paths_file, row)\n# BUDGET — maintained by the harness (read-only for you)\n\n- Credits: 0.26 / 100.00 USD (0%)\n- Time   : 0.0 h elapsed, 18.0 h remaining (0%)\n- Phase  : normal\n\n## Harness notes\n\n- GPU: 0 min busy so far, peak memory 0.0 GiB\n/workspace/.venv/lib/python3.12/site-packages/properscoring/_crps.py:246: SyntaxWarning: invalid escape sequence '\\i'\n  \"\"\"\n/workspace/.venv/lib/python3.12/site-packages/properscoring/_brier.py:7: SyntaxWarning: invalid escape sequence '\\i'\n  \"\"\"\n/workspace/.venv/lib/python3.12/site-packages/properscoring/_brier.py:95: SyntaxWarning: invalid escape sequence '\\i'\n  \"\"\"\n","exit_code":0,"status":"completed"}}
