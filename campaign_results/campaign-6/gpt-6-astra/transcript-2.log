{"type":"item.started","item":{"id":"item_67","type":"command_execution","command":"/bin/bash -lc \"OPENBLAS_NUM_THREADS=1 uv run python - <<'PY'\nimport sys,os,time,json\nimport numpy as np\nfrom pathlib import Path\nsys.path.insert(0,'agent')\nfrom qmc_pca import pca_normals\nrng=np.random.default_rng(int(os.environ.get('SYNTH_BENCHMARK_SEED','20261011')));rows=[]\nfor n in [1,7,60,288]:\n for kind in ['constant','heterogeneous']:\n  sig=np.ones(n) if kind=='constant' else np.exp(rng.normal(size=n))\n  z=pca_normals(np.eye(n),sig)\n  err=np.max(np.abs(z.T@z-np.eye(n)))\n  assert err<1e-8,(n,err)\n  paths=np.cumsum(z*sig,axis=1);clock=np.cumsum(sig**2)\n  assert np.allclose(paths.T@paths,np.minimum.outer(clock,clock),rtol=1e-10,atol=1e-9)\n  normal=rng.normal(size=(1000,n));t=time.perf_counter();a=pca_normals(normal,sig);elapsed=time.perf_counter()-t\n  assert np.array_equal(a,pca_normals(normal,sig))\n  rows.append(dict(steps=n,clock=kind,increment_covariance_max_error=float(err),seconds1000=elapsed))\nPath('agent/results/pca_algebra_gate.json').write_text(json.dumps(rows,indent=2));print(json.dumps(rows[-4:]))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
