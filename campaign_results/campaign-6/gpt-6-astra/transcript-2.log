{"type":"item.completed","item":{"id":"item_205","type":"command_execution","command":"/bin/bash -lc 'head -90 agent/fit_clock.py; head -110 agent/fit_events.py'","aggregated_output":"\"\"\"Diagnose within-hour volatility seasonality before validation.\"\"\"\nfrom pathlib import Path\nimport json,argparse\nimport numpy as np,pandas as pd\nfrom synth_lib.preparation.config import default_store_root\nfrom research_model import shape_at\np=argparse.ArgumentParser();p.add_argument('--start',default='2026-06-01');p.add_argument('--end',default='2026-09-01');p.add_argument('--table',default='seasonality.json');p.add_argument('--output',default='agent/clock.json');a=p.parse_args()\nout={}\nfor asset in ['BTC','ETH','SOL','XRP','HYPE']:\n fs=[f for f in sorted(default_store_root(asset).glob('date=*.parquet')) if a.start<=f.stem[5:]<a.end]\n df=pd.concat([pd.read_parquet(f,columns=['timestamp','close']) for f in fs]).set_index('timestamp').sort_index()\n r=np.log(df.close.astype(float)).diff();r2=r*r\n norm=r2.rolling(1440*7,min_periods=1440).mean();z2=(r2/norm).clip(upper=64)/shape_at(r.index,asset,True,a.table)\n bymin=z2.groupby(z2.index.minute).mean();bymin/=bymin.mean()\n byabs=np.sqrt(z2).groupby(z2.index.minute).mean()**2;byabs/=byabs.mean()\n shape=.5*bymin+.5*byabs;shape=.75*shape+.25\n out[asset]=shape.to_list()\n print(asset,'first minute variance',round(shape.iloc[0],2),'minute30',round(shape.iloc[30],2),'first5/rest ratio',round(shape.iloc[:5].mean()/shape.iloc[5:].mean(),2),flush=True)\nPath(a.output).write_text(json.dumps({'train_start':a.start,'train_end_exclusive':a.end,'assets':out},indent=2))\n\"\"\"Pooled event multipliers, with event dates as independent sampling units.\"\"\"\nimport json,argparse\nfrom pathlib import Path\nimport numpy as np,pandas as pd\nap=argparse.ArgumentParser();ap.add_argument('--fine',action='store_true');ap.add_argument('--end',default='2026-09-01');ap.add_argument('--suffix',default=None);args=ap.parse_args();suffix=args.suffix if args.suffix is not None else ('_fine' if args.fine else '')\nx=pd.read_csv(f'agent/results/event_diagnostics{suffix}.csv')\nx=x[pd.to_datetime(x.time,utc=True)<pd.Timestamp(args.end,tz='UTC')]\nx['group']=np.where(x.asset.isin(['BTC','ETH','SOL','XRP','HYPE']),'crypto','other')\nx['ratio']=x.ratio.clip(.02,100)\nout={}; diagnostics=[]\nfor (group,event,lo),g in x.groupby(['group','event','lo']):\n if event in ['EARNINGS','NYSE_CLOSED','NYSE_EARLY_CLOSE'] or lo==120:continue\n # Assets at one release share a shock: collapse to one datum per release.\n z=g.groupby('time').ratio.median()\n if len(z)<4:continue\n estimate=float(np.exp(.67*np.log(z).median()))\n estimate=max(1.,min(12.,estimate))\n loeo=[float(np.exp(.67*np.log(z.drop(i)).median())) for i in z.index]\n diagnostics.append(dict(group=group,event=event,lo=int(lo),n_dates=len(z),mult=estimate,leave_one_out_min=min(loeo),leave_one_out_max=max(loeo)))\n out.setdefault(group,{}).setdefault(event,{})[str(lo)]=estimate\nPath(f'agent/event_multipliers{suffix}.json').write_text(json.dumps({'train_end_exclusive':args.end,'groups':out},indent=2))\npd.DataFrame(diagnostics).to_csv(f'agent/results/event_fit{suffix}.csv',index=False)\nprint(pd.DataFrame(diagnostics).round(3).to_string(index=False))\n","exit_code":0,"status":"completed"}}
