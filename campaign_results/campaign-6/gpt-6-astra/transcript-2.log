{"type":"item.started","item":{"id":"item_253","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport json,ast\nfrom pathlib import Path\nimport pandas as pd\ncrypto=['BTC','ETH','SOL','XRP','HYPE'];com=['XAU','NVDAX','GOOGLX','TSLAX','AAPLX','WTIOIL','SPCX','SP500'];rows=[]\nfor end in ['2026-09-19','2026-10-11']:\n for config,assets,fmt,tag in [('CRYPTO_24H',crypto,'24h','scale95_v5_float32'),('COM_EQU_24H',com,'24h','floor02_scale95_v7_float32'),('CRYPTO_1H',crypto,'1h','bridge_v8_full')]:\n  for source in ['baseline_float32',tag]:\n   settings=ast.literal_eval((Path('agent/results')/source/'config.txt').read_text());assert settings['paths']==1000 and settings['prediction_dtype']=='float32'\n  for asset in assets:\n   name=f'{asset}_{fmt}_{end}.json'\n   b=json.loads((Path('agent/results/baseline_float32')/name).read_text());c=json.loads((Path('agent/results')/tag/name).read_text())\n   assert b['num_prompts']==c['num_prompts'] and c['mean_crps']<b['mean_crps']\n   rows.append({'end':end,'configuration':config,'asset':asset,'baseline':b['mean_crps'],'champion':c['mean_crps'],'prompts':c['num_prompts'],'source':tag})\nf=pd.DataFrame(rows);f.to_csv('agent/results/final_comparison_cells.csv',index=False)\ng=f.groupby(['end','configuration'],sort=False)[['baseline','champion']].mean().reset_index();g['reduction_pct']=100*(1-g.champion/g.baseline)\nPath('agent/results/final_comparison.json').write_text(json.dumps({'paths':1000,'prediction_dtype':'float32','latest_crypto_1h_formula':True,'asset_window_cells':len(rows),'cells_improved':len(rows),'results':g.to_dict(orient='records')},indent=2))\nprint(g.round(4).to_string(index=False))\nPY\nrg -n 'title|ylabel|change|improv|mean' agent/plot_results.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_253","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport json,ast\nfrom pathlib import Path\nimport pandas as pd\ncrypto=['BTC','ETH','SOL','XRP','HYPE'];com=['XAU','NVDAX','GOOGLX','TSLAX','AAPLX','WTIOIL','SPCX','SP500'];rows=[]\nfor end in ['2026-09-19','2026-10-11']:\n for config,assets,fmt,tag in [('CRYPTO_24H',crypto,'24h','scale95_v5_float32'),('COM_EQU_24H',com,'24h','floor02_scale95_v7_float32'),('CRYPTO_1H',crypto,'1h','bridge_v8_full')]:\n  for source in ['baseline_float32',tag]:\n   settings=ast.literal_eval((Path('agent/results')/source/'config.txt').read_text());assert settings['paths']==1000 and settings['prediction_dtype']=='float32'\n  for asset in assets:\n   name=f'{asset}_{fmt}_{end}.json'\n   b=json.loads((Path('agent/results/baseline_float32')/name).read_text());c=json.loads((Path('agent/results')/tag/name).read_text())\n   assert b['num_prompts']==c['num_prompts'] and c['mean_crps']<b['mean_crps']\n   rows.append({'end':end,'configuration':config,'asset':asset,'baseline':b['mean_crps'],'champion':c['mean_crps'],'prompts':c['num_prompts'],'source':tag})\nf=pd.DataFrame(rows);f.to_csv('agent/results/final_comparison_cells.csv',index=False)\ng=f.groupby(['end','configuration'],sort=False)[['baseline','champion']].mean().reset_index();g['reduction_pct']=100*(1-g.champion/g.baseline)\nPath('agent/results/final_comparison.json').write_text(json.dumps({'paths':1000,'prediction_dtype':'float32','latest_crypto_1h_formula':True,'asset_window_cells':len(rows),'cells_improved':len(rows),'results':g.to_dict(orient='records')},indent=2))\nprint(g.round(4).to_string(index=False))\nPY\nrg -n 'title|ylabel|change|improv|mean' agent/plot_results.py\"","aggregated_output":"       end configuration  baseline  champion  reduction_pct\n2026-09-19    CRYPTO_24H 4296.6726 4201.6155         2.2123\n2026-09-19   COM_EQU_24H 2316.0261 2080.2779        10.1790\n2026-09-19     CRYPTO_1H  960.4266  923.5471         3.8399\n2026-10-11    CRYPTO_24H 3531.2042 3406.1522         3.5413\n2026-10-11   COM_EQU_24H 2065.4112 1783.6086        13.6439\n2026-10-11     CRYPTO_1H  741.2317  690.6868         6.8190\n18: rows.append({'end':end,'group':group,'reduction':100*(1-x['mean_crps']/y['mean_crps'])})\n19:d=pd.DataFrame(rows).groupby(['group','end']).reduction.mean().unstack().reindex(['Crypto 24h','Commodities/equities 24h','Crypto 1h'])\n24:ax.set_xticks(positions,d.index);ax.set_ylabel('CRPS reduction (%)');ax.set_ylim(0,float(d.max().max())*1.2);ax.spines[['top','right']].set_visible(False);ax.grid(axis='y',alpha=.18);ax.set_axisbelow(True);ax.legend(frameon=False)\n25:ax.set_title((a.output_name or a.candidate)+' versus seeded starter',loc='left',fontweight='bold',pad=18)\n26:fig.text(.08,.025,'1000 paths · Equal-asset mean percentage changes · Development-inclusive validation windows',fontsize=9,color='#555555')\n","exit_code":0,"status":"completed"}}
