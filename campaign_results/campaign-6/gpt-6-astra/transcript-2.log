{"type":"item.completed","item":{"id":"item_159","type":"command_execution","command":"/bin/bash -lc \"sed -n '185,275p' agent/predict.py; sed -n '275,350p' agent/predict.py; cat agent/BUDGET.md\"","aggregated_output":"    def recorder(function):\n        def call(*args,**kwargs):\n            result=function(*args,**kwargs)\n            captured.extend(result[1])\n            return result\n        return call\n    with ExitStack() as stack:\n        # Preserve the official function's result exactly; retain its otherwise-discarded diagnostics.\n        if score_details:\n            for name in ['calculate_total_score_for_miner','calculate_crps_for_miner']:\n                stack.enter_context(patch.object(scoring_module,name,recorder(getattr(scoring_module,name))))\n        for t in times:\n            captured.clear()\n            reference=_slice_real_prices(prices,t,time_length,time_increment)\n            if _has_missing_prices(reference):reference=cached[t]\n            if len(reference)!=time_length//time_increment+1:raise ValueError('Cached reference length mismatch')\n            expected+=len(reference);scored+=int(np.isfinite(np.asarray(reference,dtype=float)).sum())\n            row=_score_single_prompt(index[t],t,asset,t+pd.Timedelta(seconds=time_length),time_length,\n                time_increment,reference,competition.scoring_intervals,competition.vol_scoring_blocks,CANDIDATE_ID,latest_formula)\n            if score_details:\n                row['component_crps']=json.dumps({v['Interval']:float(v['CRPS']) for v in captured if v['Increment']=='Total'})\n            rows.append(row)\n    frame=pd.DataFrame(rows)\n    valid=frame.loc[frame.crps>=0,'crps']\n    if valid.empty:raise RuntimeError('No valid official CRPS scores')\n    return SimpleNamespace(prompt_df=frame,summary={\n        'miner_name':'campaign','miner_id':CANDIDATE_ID,'num_prompts':len(frame),\n        'mean_crps':float(valid.mean()),'final_smoothed_score':None,\n        'realized_points_expected':expected,'realized_points_scored':scored,\n        'realized_coverage':scored/expected,'mode':'official_backtester_cached_prompts'})\n\n\ndef generate(\n    asset: str,\n    times: list[pd.Timestamp],\n    out_dir: Path,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    prediction_dtype: str = \"float64\",\n) -> int:\n    # The same loader the scored evaluation uses. NOT MinutePriceStore.load_range, which raises\n    # on a single NaN close: an untraded minute is normal on the thin markets (42% of AAPLX\n    # minutes never trade), so that loader cannot read 9 of the 13 assets at all. NaN reaches\n    # simulate() untouched, which is the contract — never interpolate it away.\n    prices = load_minute_prices(\n        WORKSPACE / \"market_data\", asset, times[0] - pd.Timedelta(minutes=CONTEXT_MINUTES), times[-1]\n    )\n    out_dir.mkdir(parents=True, exist_ok=True)\n    from itertools import groupby\n    from time import perf_counter\n    begin = perf_counter()\n    for day, day_times in groupby(times, key=lambda t: t.date().isoformat()):\n        day_times = list(day_times)\n        runs = []\n        for t in day_times:\n            context = prices.loc[t - pd.Timedelta(minutes=CONTEXT_MINUTES):context_end(t, time_length)]\n            out = simulate(asset=asset, start_time=t.isoformat(), time_increment=time_increment,\n                           time_length=time_length, num_simulations=num_simulations, context_prices=context)\n            runs.append(np.asarray(out[2:], dtype=np.dtype(prediction_dtype)))\n        root = out_dir / asset / f\"{time_length}_{time_increment}\"\n        root.mkdir(parents=True, exist_ok=True)\n        np.save(root / f\"date={day}.npy\", np.stack(runs))\n        (root / f\"date={day}.json\").write_text(json.dumps({\n            \"start_times\": [t.isoformat() for t in day_times], \"asset\": asset,\n            \"time_increment\": time_increment, \"time_length\": time_length,\n            \"num_simulations\": num_simulations, \"num_steps\": time_length // time_increment + 1}))\n    print(f\"generation seconds/prompt: {(perf_counter()-begin)/len(times):.4f}\", flush=True)\n    return len(times)\n\n\ndef print_event_split(prompts: pd.DataFrame, asset: str, time_length: int) -> None:\n    \"\"\"Your gap to each prompt's best miner, over the prompts whose horizon holds an event of each type\n    and over the prompts that hold none.\"\"\"\n    path = Path(os.environ[CALENDAR_ENV])\n    if not path.exists():\n        return\n    view = pd.read_parquet(path)\n    view = view[concerns(view, asset)]\n    scored = prompts[prompts[\"crps\"] > 0]  # -1 marks a prompt the backtester could not score\n    best = scored.groupby([\"asset\", \"scored_time\"])[\"crps\"].min().rename(\"best\")\n    ours = scored[scored[\"miner_id\"] == CANDIDATE_ID].join(best, on=[\"asset\", \"scored_time\"])\n    if ours.empty:\n        return\n    gap = ours[\"crps\"].to_numpy() / ours[\"best\"].to_numpy() - 1\n    starts = pd.to_datetime(ours[\"start_time\"], utc=True).dt.tz_localize(None).to_numpy()\n    ends = starts + np.timedelta64(time_length, \"s\")\n    spans_any = np.zeros(len(ours), dtype=bool)\n    lines = []\n    for event, rows in view.groupby(\"event\"):\n        times = np.sort(pd.to_datetime(rows[\"time_utc\"], utc=True).dt.tz_localize(None).to_numpy())\n        times = np.sort(pd.to_datetime(rows[\"time_utc\"], utc=True).dt.tz_localize(None).to_numpy())\n        at = np.searchsorted(times, starts)\n        spans = (at < len(times)) & (times[np.minimum(at, len(times) - 1)] < ends)\n        spans_any |= spans\n        if spans.any():\n            lines.append(f\"  {event:<17} {spans.sum():5d} prompts  gap {gap[spans].mean():+.2%}\")\n    if not spans_any.all():\n        lines.insert(0, f\"  {'no event':<17} {(~spans_any).sum():5d} prompts  gap {gap[~spans_any].mean():+.2%}\")\n    print(\"event split (mean gap to each prompt's best miner):\")\n    print(\"\\n\".join(lines))\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--asset\", default=\"BTC\")\n    ap.add_argument(\"--prediction-dtype\",choices=[\"float32\",\"float64\"],default=\"float64\")\n    ap.add_argument(\"--model\", default=\"modeling\", help=\"agent module providing simulate\")\n    ap.add_argument(\"--cached-prompts\",action=\"store_true\",help=\"official CRPS worker on cached prompts; no field ranking\")\n    ap.add_argument(\"--score-details\",action=\"store_true\",help=\"retain official score components; requires cached-prompts\")\n    ap.add_argument(\"--days\", type=int, default=3)\n    ap.add_argument(\"--eval-end\", required=True, help=\"YYYY-MM-DD, at most the snapshot's last day\")\n    ap.add_argument(\"--time-increment\", type=int, default=300, help=\"seconds between points (60 for CRYPTO_1H)\")\n    ap.add_argument(\"--time-length\", type=int, default=86_400, help=\"horizon in seconds (3600 for CRYPTO_1H)\")\n    ap.add_argument(\n        \"--num-simulations\",\n        type=int,\n        default=1000,\n        help=\"Paths per prompt. The validator uses 1000; lowering this speeds up iteration at \"\n        \"the cost of a slightly pessimistic CRPS (empirical CRPS is biased upward for fewer \"\n        \"sampled paths, and the real field's CRPS was computed at 1000).\",\n    )\n    ap.add_argument(\n        \"--cadence-minutes\",\n        type=int,\n        default=None,\n        help=\"answer an even grid every N minutes instead of the validator's own start times. A \"\n        \"cadence that divides an hour puts every prompt on the round hour\",\n    )\n    ap.add_argument(\n        \"--latest-formula\",\n        action=\"store_true\",\n        help=\"score every crypto-1h prompt with the volatility term, as prompts are scored now, \"\n        \"including those scored before it went live. Field ranks before that day then compare \"\n        \"two formulas; CRPS does not\",\n    )\n    ap.add_argument(\"--keep-predictions\", action=\"store_true\", help=\"keep this run's prediction files\")\n    ap.add_argument(\"--output\", help=\"persist summary and candidate prompt scores under this prefix\")\n    args = ap.parse_args()\n    if args.score_details and not args.cached_prompts:ap.error('--score-details requires --cached-prompts')\n    import importlib\n    global simulate\n    simulate = importlib.import_module(args.model).simulate\n    require_offline_bundle()\n    ensure_workspace_cwd()\n    end = datetime.fromisoformat(args.eval_end).replace(tzinfo=timezone.utc)\n    if args.cached_prompts:\n        if args.cadence_minutes is not None:raise SystemExit('Cached prompt mode uses exact cached start times, not a cadence.')\n        times,cached=cached_prompt_times(args.asset,end,args.days,args.time_length,args.time_increment)\n    else:\n        times = prompt_times(\n            args.asset, end, args.days, args.time_length, args.time_increment, cadence_minutes=args.cadence_minutes\n        )\n    # the context reaches back 7 days before the first prompt: coverage must extend that far\n    check_snapshot_coverage(args.asset, times[0] - timedelta(minutes=CONTEXT_MINUTES), end)\n    PREDICTIONS_ROOT.mkdir(parents=True, exist_ok=True)\n    out_dir = Path(tempfile.mkdtemp(prefix=\"run-\", dir=PREDICTIONS_ROOT))\n    try:\n        n = generate(\n            args.asset,\n            times,\n            out_dir,\n            time_increment=args.time_increment,\n            time_length=args.time_length,\n            num_simulations=args.num_simulations,\n            prediction_dtype=args.prediction_dtype,\n        )\n# BUDGET — maintained by the harness (read-only for you)\n\n- Credits: 73.56 / 100.00 USD (74%)\n- Time   : 4.0 h elapsed, 14.0 h remaining (22%)\n- Phase  : normal\n\n## Harness notes\n\n- GPU: 78 min busy so far, peak memory 0.5 GiB\n","exit_code":0,"status":"completed"}}
