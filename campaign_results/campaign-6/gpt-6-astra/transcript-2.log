{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -lc 'cat agent/timesfm_vol.py; cat agent/.gitignore .gitignore; cat agent/summarize.py; tail -20 agent/results/queue_heat_scale.log; cat agent/BUDGET.md'","aggregated_output":"\"\"\"Offline TimesFM-v1 point-log-variance study using its unchanged public decoder.\"\"\"\nfrom functools import lru_cache\nfrom pathlib import Path\nimport os,random\nimport numpy as np,pandas as pd\nos.environ['TORCH_DISABLE_NATIVE_JIT']='1'\n\n@lru_cache(maxsize=1)\ndef pipeline():\n    import torch\n    from vendor.timesfm_v1.pytorch_patched_decoder import TimesFMConfig,PatchedTimeSeriesDecoder\n    torch.set_num_threads(1)\n    model=PatchedTimeSeriesDecoder(TimesFMConfig())\n    checkpoint=Path(__file__).parent/'models'/'timesfm-1.0-200m'/'torch_model.ckpt'\n    state=torch.load(checkpoint,map_location='cpu',weights_only=True,mmap=True)\n    model.load_state_dict(state,strict=True)\n    return model.float().eval()\n\n@lru_cache(maxsize=2048)\ndef predict_hourly(asset,origin,seed,values):\n    import torch\n    random.seed(seed);torch.manual_seed(seed)\n    x=np.asarray(values,dtype=float);center=float(np.median(x))\n    series=np.log(np.maximum(x,center*.001)/center)\n    left=(-len(series))%32\n    padded=np.pad(series,(left,0)).astype(np.float32)\n    padding=np.r_[np.ones(left),np.zeros(len(series)+25)].astype(np.float32)\n    model=pipeline()\n    random.seed(seed);torch.manual_seed(seed)\n    with torch.inference_mode():\n        point,_=model.decode(torch.from_numpy(padded[None,:]),torch.from_numpy(padding[None,:]),torch.zeros((1,1),dtype=torch.long),horizon_len=25)\n    point=point.detach().cpu().numpy()[0]\n    return np.exp(np.clip(point,-3,3))*center\n\ndef forecast_variance(frame,asset,future,seed,shape_name='seasonality.json'):\n    from research_model import shape_at\n    ret=np.log(frame.close.astype(float)).diff()\n    rv=ret.pow(2)/shape_at(frame.index,asset,True,shape_name)\n    hourly=rv.resample('h').mean();count=frame.close.resample('h').size()\n    hourly=hourly.where(count==60)\n    hourly=hourly[hourly.index+pd.Timedelta(hours=1)<=frame.index[-1]+pd.Timedelta(minutes=1)].iloc[-144:]\n    bad=np.flatnonzero(~np.isfinite(hourly.to_numpy()))\n    if len(bad):hourly=hourly.iloc[bad[-1]+1:]\n    if len(hourly)<48 or float(hourly.median())<=0:return None\n    origin=hourly.index[-1]+pd.Timedelta(hours=1)\n    forecast=predict_hourly(asset,str(origin),seed,tuple(hourly.to_numpy(dtype=float)))\n    at=np.asarray((future-origin).total_seconds())//3600\n    return forecast[np.clip(at.astype(int),0,len(forecast)-1)]\n# The agent is told to commit often, so anything huge and regenerable must be excluded here:\n# a `git add -A` would otherwise commit a multi-GB .venv (torch + CUDA on GPU campaigns) and\n# 1000-path prediction files at ~5.5MB each. Committed weights are the exception — the champion\n# must stay runnable offline, so DO NOT add model artifacts to this list.\n.venv/\n__pycache__/\n*.pyc\nminer_outputs/\nmarket_data/\nagent/hf_cache/\nagent/models/*/.cache/\n# Rejected capacity experiment; immutable revision retained in provenance.\nagent/models/chronos-t5-small/model.safetensors\n# Research-only forecasts, reproducible from committed weights and full keyed inputs.\nagent/results/chronos_forecast_cache/\n# New architecture research weights: commit only if selected for offline serving.\nagent/models/timesfm-1.0-200m/torch_model.ckpt\ncat: agent/.gitignore: No such file or directory\n\"\"\"Compare official CRPS summaries, preserving asset/window cells.\"\"\"\nimport argparse,json\nfrom pathlib import Path\nimport pandas as pd\np=argparse.ArgumentParser();p.add_argument('tags',nargs='+');p.add_argument('--base',default='baseline');p.add_argument('--base-com');p.add_argument('--base-short');a=p.parse_args()\nrows=[]\nfor tag in list(dict.fromkeys([a.base]+([a.base_com] if a.base_com else [])+([a.base_short] if a.base_short else [])+a.tags)):\n for f in (Path('agent/results')/tag).glob('*.json'):\n  d=json.loads(f.read_text());asset,fmt,end=f.stem.split('_');rows.append(dict(tag=tag,asset=asset,fmt=fmt,end=end,crps=d['mean_crps'],n=d['num_prompts'],coverage=d['realized_coverage'],config='CRYPTO_1H' if fmt=='1h' else 'CRYPTO_24H' if asset in ['BTC','ETH','SOL','XRP','HYPE'] else 'COM_EQU_24H'))\ndf=pd.DataFrame(rows)\nif df.empty:raise SystemExit('no results')\ncontrols=df[df.tag==a.base]\nif a.base_com:controls=pd.concat([controls[controls.config!='COM_EQU_24H'],df[(df.tag==a.base_com)&(df.config=='COM_EQU_24H')]])\nif a.base_short:controls=pd.concat([controls[controls.config!='CRYPTO_1H'],df[(df.tag==a.base_short)&(df.config=='CRYPTO_1H')]])\ncontrols=controls.set_index(['asset','fmt','end']);base=controls.crps\nif a.base_com or a.base_short:print('Controls:',a.base,'default;',a.base_com,'COM override;',a.base_short,'1h override')\nfor tag in a.tags:\n d=df[df.tag==tag].copy();d['base']=[base.get((r.asset,r.fmt,r.end),float('nan')) for r in d.itertuples()];d['change']=d.crps/d.base-1;d=d[d.base.notna()]\n for r in d.itertuples():\n  if r.n!=controls.loc[(r.asset,r.fmt,r.end),'n']:raise ValueError('Mismatched prompt counts: '+str((tag,r.asset,r.fmt,r.end)))\n print('\\n',tag,'cells',len(d))\n print(d.groupby(['end','config']).agg(crps=('crps','mean'),base=('base','mean'),pct=('change',lambda x:100*x.mean()),wins=('change',lambda x:(x<0).sum()),cells=('change','count')).round(4).to_string())\n print(d.pivot_table(index=['asset','fmt'],columns='end',values='change').mul(100).round(2).to_string())\n{\"cmd\": [\"uv\", \"run\", \"agent/run_suite.py\", \"--tag\", \"heat_scale_v9_full\", \"--model\", \"candidate_v9_research\", \"--config\", \"{\\\"heat_scale\\\": true}\", \"--cached-prompts\", \"--prediction-dtype\", \"float32\", \"--days\", \"10\", \"--ends\", \"2026-09-19\", \"2026-10-11\", \"--assets\", \"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\", \"--formats\", \"24h\", \"--workers\", \"4\"], \"exit\": 0}\n{\"cmd\": [\"uv\", \"run\", \"agent/run_suite.py\", \"--tag\", \"sep_late_heat_scale\", \"--model\", \"candidate_v9_research\", \"--config\", \"{\\\"heat_scale\\\": true}\", \"--cached-prompts\", \"--prediction-dtype\", \"float32\", \"--days\", \"8\", \"--ends\", \"2026-10-01\", \"--assets\", \"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\", \"--formats\", \"24h\", \"--workers\", \"4\"], \"exit\": 0}\n{\"cmd\": [\"uv\", \"run\", \"agent/run_suite.py\", \"--tag\", \"historical_heat_scale\", \"--model\", \"candidate_v9_research\", \"--config\", \"{\\\"table\\\": \\\"seasonality_jul01.json\\\", \\\"clock_table\\\": \\\"clock_jul01.json\\\", \\\"event_table\\\": \\\"event_multipliers_jul01.json\\\", \\\"heat_scale\\\": true}\", \"--cached-prompts\", \"--prediction-dtype\", \"float32\", \"--days\", \"2\", \"--ends\", \"2026-07-22\", \"2026-08-22\", \"--assets\", \"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\", \"--formats\", \"24h\", \"--workers\", \"4\"], \"exit\": 0}\n{\"cmd\": [\"uv\", \"run\", \"agent/run_suite.py\", \"--tag\", \"historical_new_v9_crypto24h\", \"--model\", \"candidate_v9_research\", \"--config\", \"{\\\"table\\\": \\\"seasonality_jul01.json\\\", \\\"clock_table\\\": \\\"clock_jul01.json\\\", \\\"event_table\\\": \\\"event_multipliers_jul01.json\\\"}\", \"--cached-prompts\", \"--prediction-dtype\", \"float32\", \"--days\", \"2\", \"--ends\", \"2026-07-29\", \"2026-08-29\", \"--assets\", \"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\", \"--formats\", \"24h\", \"--workers\", \"4\"], \"exit\": 0}\n{\"cmd\": [\"uv\", \"run\", \"agent/run_suite.py\", \"--tag\", \"historical_new_heat_scale\", \"--model\", \"candidate_v9_research\", \"--config\", \"{\\\"table\\\": \\\"seasonality_jul01.json\\\", \\\"clock_table\\\": \\\"clock_jul01.json\\\", \\\"event_table\\\": \\\"event_multipliers_jul01.json\\\", \\\"heat_scale\\\": true}\", \"--cached-prompts\", \"--prediction-dtype\", \"float32\", \"--days\", \"2\", \"--ends\", \"2026-07-29\", \"2026-08-29\", \"--assets\", \"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\", \"--formats\", \"24h\", \"--workers\", \"4\"], \"exit\": 0}\n# BUDGET — maintained by the harness (read-only for you)\n\n- Credits: 62.52 / 100.00 USD (63%)\n- Time   : 3.4 h elapsed, 14.6 h remaining (19%)\n- Phase  : normal\n\n## Harness notes\n\n- GPU: 68 min busy so far, peak memory 0.5 GiB\n","exit_code":0,"status":"completed"}}
