near_residual.py','--phase','historical'],'log':'agent/results/nonlinear_historical.log'}]\nfor kind in ['tree','ridge']:\n for historical,jobs in [(False,late),(True,history)]:\n  tag=('historical' if historical else 'sep_late')+'_nonlinear_'+kind\n  config={'nonlinear':kind}\n  if historical:config.update(nonlinear_model='nonlinear_historical.json',table='seasonality_jul01.json',clock_table='clock_jul01.json',event_table='event_multipliers_jul01.json')\n  cmd=['uv','run','agent/run_suite.py','--tag',tag,'--model','candidate_v9_research','--config',json.dumps(config),'--cached-prompts','--prediction-dtype','float32','--days','2' if historical else '8','--ends',*(['2026-07-22','2026-08-22'] if historical else ['2026-10-01']),'--assets','BTC','ETH','SOL','XRP','HYPE','--formats','1h','--workers','4']\n  jobs.append({'cmd':cmd,'log':'agent/results/'+tag+'_suite.log'})\nfor name,jobs in [('nonlinear_late',late),('nonlinear_history',history)]:\n path='agent/queue_'+name+'.json';Path(path).write_text(json.dumps(jobs,indent=2))\n with open('agent/results/queue_'+name+'.log','w') as f:p=subprocess.Popen(['uv','run','agent/queue_research.py','--jobs',path],stdout=f,stderr=subprocess.STDOUT,start_new_session=True,env=dict(os.environ,OPENBLAS_NUM_THREADS='1',OMP_NUM_THREADS='1',MKL_NUM_THREADS='1'))\n print(name,p.pid)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
