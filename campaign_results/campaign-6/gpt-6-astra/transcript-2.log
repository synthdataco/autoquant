{"type":"item.completed","item":{"id":"item_52","type":"command_execution","command":"/bin/bash -lc 'cat agent/chronos_vol.py; cat agent/benchmark_timesfm_cpu.py; cat agent/download_timesfm.py'","aggregated_output":"\"\"\"Offline Chronos residual-volatility experiment; one GPU worker only.\"\"\"\nfrom functools import lru_cache\nfrom pathlib import Path\nimport os,random,hashlib,json\nimport numpy as np\nimport pandas as pd\n\n# PyTorch's optional native-JIT overrides require a system C compiler absent here.\n# Its precompiled CUDA operators implement the same inference without compilation.\nos.environ['TORCH_DISABLE_NATIVE_JIT']='1'\n\n@lru_cache(maxsize=1)\ndef pipeline(model_name='chronos-t5-tiny'):\n    os.environ['HF_HUB_OFFLINE']='1';os.environ['TRANSFORMERS_OFFLINE']='1'\n    import torch\n    from chronos import ChronosPipeline\n    torch.set_num_threads(1)\n    device='cuda' if torch.cuda.is_available() else 'cpu'\n    if device=='cuda':torch.cuda.set_per_process_memory_fraction(.2)\n    return ChronosPipeline.from_pretrained(str(Path(__file__).parent/'models'/model_name),device_map=device,dtype=torch.float32,local_files_only=True)\n\n@lru_cache(maxsize=2048)\ndef predict_hourly(asset,origin,seed,values,model_name='chronos-t5-tiny'):\n    cache_file=None\n    cache_root=os.environ.get('CHRONOS_RESEARCH_CACHE')\n    if cache_root:\n        model_dir=Path(__file__).parent/'models'/model_name\n        provenance_path=model_dir/'provenance.json'\n        if not provenance_path.exists():provenance_path=model_dir/'revision.txt'\n        provenance=provenance_path.read_bytes()\n        key=hashlib.sha256(Path(__file__).read_bytes()+provenance+json.dumps([asset,origin,seed,model_name]).encode()+np.asarray(values,dtype=np.float64).tobytes()).hexdigest()\n        cache_file=Path(cache_root)/key[:2]/(key+'.npy')\n        try:\n            saved=np.load(cache_file,allow_pickle=False)\n            if saved.shape==(25,) and np.all(np.isfinite(saved)) and np.all(saved>0):return saved\n        except (OSError,ValueError):pass\n        if os.environ.get('CHRONOS_RESEARCH_CACHE_ONLY')=='1':\n            raise FileNotFoundError('Research forecast cache miss: '+str(cache_file))\n    import torch\n    random.seed(seed);torch.manual_seed(seed)\n    if torch.cuda.is_available():torch.cuda.manual_seed_all(seed)\n    x=np.asarray(values,dtype=float)\n    center=float(np.nanmedian(x))\n    if not np.isfinite(center) or center<=0:return np.full(25,1e-8)\n    series=np.log(np.maximum(x,center*.001)/center)\n    model=pipeline(model_name)\n    random.seed(seed);torch.manual_seed(seed)\n    if torch.cuda.is_available():torch.cuda.manual_seed_all(seed)\n    with torch.inference_mode():\n        pred=model.predict(torch.tensor(series,dtype=torch.float32),prediction_length=25,num_samples=32)\n    pred=pred.detach().cpu().numpy()[0]\n    result=np.mean(np.exp(np.clip(pred,-3,3)),axis=0)*center\n    if cache_file is not None:\n        cache_file.parent.mkdir(parents=True,exist_ok=True)\n        temporary=cache_file.with_suffix('.'+str(os.getpid())+'.tmp')\n        with temporary.open('wb') as stream:np.save(stream,result,allow_pickle=False)\n        temporary.replace(cache_file)\n    return result\n\ndef forecast_variance(frame,asset,future,seed,persistence=False,model_name='chronos-t5-tiny',shape_name='seasonality.json'):\n    from research_model import shape_at\n    ret=np.log(frame.close.astype(float)).diff()\n    rv=ret.pow(2)/shape_at(frame.index,asset,True,shape_name)\n    hourly=rv.resample('h').mean()\n    count=frame.close.resample('h').size()\n    # Complete clock hours only. Missing trades remain NaN; never interpolate prices.\n    hourly=hourly[(count==60)&(hourly.index+pd.Timedelta(hours=1)<=frame.index[-1]+pd.Timedelta(minutes=1))].iloc[-144:]\n    if hourly.notna().sum()<48:return np.full(len(future),float(rv.mean()))\n    if persistence:\n        if persistence=='median':estimate=hourly.median()\n        elif persistence=='ewma':estimate=hourly.ewm(halflife=6).mean().iloc[-1]\n        else:estimate=hourly.dropna().iloc[-1]\n        return np.full(len(future),float(estimate))\n    origin=hourly.index[-1]+pd.Timedelta(hours=1)\n    values=tuple(hourly.to_numpy(dtype=float))\n    forecast=predict_hourly(asset,str(origin),seed,values,model_name)\n    at=np.asarray((future-origin).total_seconds())//3600\n    return forecast[np.clip(at.astype(int),0,len(forecast)-1)]\n\"\"\"Fresh-process, uncached1000-path CPU latency and repeatability gate.\"\"\"\nimport os,time,json,resource\nstarted=time.perf_counter();os.environ['TORCH_DISABLE_NATIVE_JIT']='1'\nimport torch,numpy as np,pandas as pd\nfrom synth_lib.preparation.config import default_store_root\nfrom predict import load_minute_prices,context_end\nfrom candidate_v9_research import simulate\nfrom timesfm_vol import predict_hourly\nframework=time.perf_counter()-started\nt=pd.Timestamp('2026-10-08T12:17:00Z');end=context_end(t,3600)\nframe=load_minute_prices(default_store_root('BTC').parents[2],'BTC',t-pd.Timedelta(days=8),t)\nframe=frame.loc[(frame.index>end-pd.Timedelta(days=7))&(frame.index<=end)]\nos.environ['MODEL_CONFIG']='{\"timesfm\":true}'\nlatencies=[];previous=None\nfor _ in range(3):\n predict_hourly.cache_clear();started=time.perf_counter();result=simulate('BTC',t,60,3600,1000,frame);latencies.append(time.perf_counter()-started)\n assert len(result)==1002 and np.isfinite(np.asarray(result[2:])).all()\n if previous is not None:assert previous==result\n previous=result\nsummary={'device':'cpu','framework_startup_seconds':framework,'uncached_simulate_seconds':latencies,'cold_response_seconds':framework+latencies[0],'peak_rss_gib':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1024**2,'paths':1000,'repeatable':True}\nprint(json.dumps(summary),flush=True)\nassert summary['cold_response_seconds']<60 and max(latencies[1:])<5\n\"\"\"Fetch only immutable public model/code artifacts, with provenance and license.\"\"\"\nimport os,json,hashlib,urllib.request,zipfile,io\nfrom pathlib import Path\nos.environ['HF_HOME']=str(Path('agent/hf_cache').resolve())\nfrom huggingface_hub import hf_hub_download\nrevision='0581e2c56cb06feb51cfd98fc2b4005b74f7187b';repo='google/timesfm-1.0-200m-pytorch'\nwith urllib.request.urlopen('https://pypi.org/pypi/timesfm/1.3.0/json',timeout=30) as r:metadata=json.load(r)\nitem=next(x for x in metadata['urls'] if x['filename'].endswith('.whl'))\nwith urllib.request.urlopen(item['url'],timeout=30) as r:payload=r.read()\nassert hashlib.sha256(payload).hexdigest()==item['digests']['sha256']=='a99e22b13654bdbfaecb14a48e4a8dc6c990b191a0322a5cacd09eb0df3bfebe'\narchive=zipfile.ZipFile(io.BytesIO(payload));vendor=Path('agent/vendor/timesfm_v1');vendor.mkdir(parents=True,exist_ok=True)\n(vendor/'__init__.py').write_text('')\n(vendor/'pytorch_patched_decoder.py').write_bytes(archive.read('timesfm/pytorch_patched_decoder.py'))\nlicense_name=next(n for n in archive.namelist() if n.rsplit('/',1)[-1].upper()=='LICENSE')\n(vendor/'LICENSE').write_bytes(archive.read(license_name))\n(vendor/'provenance.json').write_text(json.dumps({'package':'timesfm','version':'1.3.0','wheel_url':item['url'],'wheel_sha256':item['digests']['sha256'],'source_file':'timesfm/pytorch_patched_decoder.py','modified':False},indent=2))\nmodel_dir=Path('agent/models/timesfm-1.0-200m');model_dir.mkdir(parents=True,exist_ok=True)\nfor filename in ['README.md','torch_model.ckpt']:\n path=hf_hub_download(repo_id=repo,filename=filename,revision=revision,local_dir=str(model_dir))\n print(filename,Path(path).stat().st_size,'bytes',flush=True)\n(model_dir/'provenance.json').write_text(json.dumps({'repo':repo,'revision':revision,'metadata_last_modified':'2024-08-29T23:52:11.000Z','license':'Apache-2.0'},indent=2))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_53","type":"command_execution","command":"/bin/bash -lc \"cat >> agent/journal.md <<'EOF'\n\n## Iteration74 — direct pretrained quantile forecasting\n\nHypothesis: Chronos-Bolt-tiny's direct multi-horizon forecast may provide a useful and cheaper hourly variance predictor than autoregressive Chronos or TimesFM. Public metadata for amazon/chronos-bolt-tiny pins revision a0e552de83495b5c28c14c71c374f3e33280b340,last modified2025-11-21,Apache2.0,before all evaluation periods. Download only public weights/config/model card. Use CPU float32,existing chronos-forecasting research dependency,offline local loading,and environment-derived seed.\n\nKeep TimesFM's144 complete-clock-hour log-variance inputs and contiguous finite suffix policy, use native median log prediction, exponentiate clipped[-3,3], and the same25% blend/ratio clipping. This matches TimesFM's point-in-log-space aggregation more closely than sampled Chronos's mean-exp aggregation; do not claim architectural causality. No quantile-tail extrapolation is needed. Gate cold<60s,warm<5s,repeatability1000 paths before official scoring. Require both full-window means and most cells, then unchanged added-period and causal historical criteria. No serving change from model metadata or forecast proxy metrics.\nEOF\nuv run --group research python - <<'PY'\nimport os,json\nfrom pathlib import Path\nos.environ['HF_HOME']=str(Path('agent/hf_cache').resolve())\nfrom huggingface_hub import hf_hub_download\nroot=Path('agent/models/chronos-bolt-tiny');root.mkdir(parents=True,exist_ok=True)\nrepo='amazon/chronos-bolt-tiny';rev='a0e552de83495b5c28c14c71c374f3e33280b340'\nfor name in ['README.md','config.json','model.safetensors']:\n p=Path(hf_hub_download(repo_id=repo,filename=name,revision=rev,local_dir=str(root)));print(name,p.stat().st_size)\n(root/'provenance.json').write_text(json.dumps({'repo':repo,'revision':rev,'metadata_last_modified':'2025-11-21T12:54:42.000Z','license':'Apache-