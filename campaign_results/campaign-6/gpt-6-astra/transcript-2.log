ched validator path only if that prompt's slice contains missing prices.\n    No CRPS formula is implemented here and no missing data is fetched.\n    \"\"\"\n    from types import SimpleNamespace\n    from synth_lib.backtester.config import competition_for\n    from synth_lib.backtester.preparation import build_prediction_index,_slice_real_prices,_has_missing_prices\n    from synth_lib.backtester.scoring import _score_single_prompt\n    import synth_lib.backtester.scoring as scoring_module\n    from contextlib import ExitStack\n    from unittest.mock import patch\n    competition=competition_for(asset,time_length)\n    index=build_prediction_index(out_dir)[(asset,time_length)]\n    prices=load_minute_prices(WORKSPACE/'market_data',asset,times[0],times[-1]+pd.Timedelta(seconds=time_length))\n    rows=[];expected=scored=0\n    captured=[]\n    def recorder(function):\n","exit_code":0,"status":"completed"}}
