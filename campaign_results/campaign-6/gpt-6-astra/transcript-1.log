{"type":"item.completed","item":{"id":"item_314","type":"command_execution","command":"/bin/bash -lc \"sed -n '130,160p' agent/research_model.py; cat agent/results/chronos_forecast_diagnostics.csv | head -2; cat agent/results/queue_quiet_floor.log; cat agent/block_uncertainty.py | head -50\"","aggregated_output":"            shape_name=c.get('refresh_table','seasonality_oct01.json')\n    if c.get('refresh_schedule'):\n        available=context_prices.index[-1]+pd.Timedelta(minutes=1)\n        selected_end=table_end(shape_name)\n        for name in c['refresh_schedule']:\n            trained=table_end(name)\n            if selected_end<trained<=available:\n                shape_name=name;selected_end=trained\n    close=context_prices.close.astype(float)\n    valid=close.dropna();last=float(valid.iloc[-1])\n    # A lag of 1 minute for 1h and 5 minutes for 24h matches the base scored increments.\n    lag=c.get('lag',1 if short else 5)\n    r=np.log(close).diff(lag)\n    good=np.isfinite(r.to_numpy())\n    rv=r.to_numpy()[good]**2/lag\n    idx=close.index[good]\n    weights_shape=shape_at(idx,asset,seasonal,shape_name,c.get('seasonal_shrink',.1))\n    if c.get('clock',False):weights_shape*=clock_at(idx,asset,lag)\n    rv=rv/weights_shape\n    age=np.asarray((pd.Timestamp(start_time)-idx).total_seconds())/60\n    if len(rv)<10:\n        rv=np.array([1e-8]);age=np.array([1.0])\n    def estimate(half):\n        w=np.exp2(-age/half)\n        raw=np.sum(w*rv)/max(np.sum(w),1e-12)\n        blend=c.get('robust',0.)\n        if blend:\n            correction=float(table('robust_factors.json')[asset][str(lag)])\n            absolute=(np.sum(w*np.sqrt(rv))/max(np.sum(w),1e-12))**2*correction\n            return (1-blend)*raw+blend*absolute\n        return raw\nmodel,asset,end,start_time,ratio_mean,lower_clip_share,upper_clip_share,learned_over_median\nchronos-t5-tiny,BTC,2026-09-16,2026-09-13 23:00:00+00:00,0.28068244342694976,0.0,0.0,0.4572812014966356\n\"\"\"Descriptive paired block intervals on already-official CRPS values.\"\"\"\nimport argparse,json,os\nfrom pathlib import Path\nimport numpy as np,pandas as pd\np=argparse.ArgumentParser();p.add_argument('candidate');p.add_argument('baseline');a=p.parse_args();rows=[]\nfor f in (Path('agent/results')/a.candidate).glob('*.parquet'):\n b=Path('agent/results')/a.baseline/f.name\n if not b.exists():continue\n keys=['asset','time_length','start_time','scored_time']\n x=pd.read_parquet(f);y=pd.read_parquet(b)\n d=x[keys+['crps']].merge(y[keys+['crps']],on=keys,suffixes=('_new','_base'),validate='one_to_one')\n d['day']=pd.to_datetime(d.scored_time).dt.strftime('%Y-%m-%d');d['window']=f.stem.rsplit('_',1)[1];rows.append(d)\nx=pd.concat(rows)\nx['config']=np.where(x.time_length==3600,'CRYPTO_1H',np.where(x.asset.isin(['BTC','ETH','SOL','XRP','HYPE']),'CRYPTO_24H','COM_EQU_24H'))\ng=x.groupby(['config','window','day','asset'])[['crps_new','crps_base']].mean();g['pct']=(g.crps_new/g.crps_base-1)*100\nd=g.groupby(['config','window','day']).pct.mean().reset_index()\nrng=np.random.default_rng(int(os.environ.get('SYNTH_BENCHMARK_SEED','20261011')));results=[]\nfor (config,window),v in d.groupby(['config','window']):\n y=v.sort_values('day').pct.to_numpy();n=len(y)\n starts=rng.integers(0,n,size=(10000,(n+1)//2));indices=np.stack([starts,(starts+1)%n],axis=-1).reshape(10000,-1)[:,:n]\n boot=y[indices].mean(axis=1)\n results.append({'config':config,'window':window,'days':n,'daily_mean_pct':float(y.mean()),'days_improved':int((y<0).sum()),'block2_interval95':np.quantile(boot,[.025,.975]).tolist()})\nprint(json.dumps(results,indent=2))\n(Path('agent/results')/(a.candidate+'_block_intervals.json')).write_text(json.dumps(results,indent=2))\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_315","type":"command_execution","command":"/bin/bash -lc \"cat > agent/summarize_sessions.py <<'PY'\n\\\"\\\"\\\"Paired official CRPS split by forecast-origin New York weekday/weekend.\n\nA 24h path can span both regimes; this is descriptive origin stratification,\nnot an attribution of each interval's score to the session it covers.\n\\\"\\\"\\\"\nimport argparse\nfrom pathlib import Path\nimport pandas as pd\np=argparse.ArgumentParser();p.add_argument('candidate');p.add_argument('--base',required=True);a=p.parse_args()\nrows=[]\nfor f in (Path('agent/results')/a.candidate).glob('*.parquet'):\n b=Path('agent/results')/a.base/f.name\n if not b.exists():continue\n x=pd.read_parquet(f);y=pd.read_parquet(b)\n keys=['asset','time_length','start_time','scored_time']\n d=x[keys+['crps']].merge(y[keys+['crps']],on=keys,suffixes=('_new','_base'),validate='one_to_one')\n if len(d)\"'!=len(x) or len(d)!=len(y):raise ValueError('\"'Unequal prompt sets: '+f.name)\n d['weekend_origin']=pd.to_datetime(d.start_time,utc=True).dt.tz_convert('America/New_York').dt.dayofweek>=5\n d['window']=f.stem.rsplit('_',1)[1];rows.append(d)\nif not rows:raise SystemExit('No paired artifacts')\nd=pd.concat(rows).groupby(['window','asset','weekend_origin'])[['crps_new','crps_base']].mean().reset_index()\nd['change_pct']=100*(d.crps_new/d.crps_base-1)\nprint(d.groupby(['window','weekend_origin']).agg(mean_pct=('change_pct','mean'),wins=('change_pct',lambda x:int((x<0).sum())),cells=('change_pct','size')).to_string())\nd.to_csv(Path('agent/results')/(a.candidate+'_sessions.csv'),index=False)\nPY\nuv run agent/summarize_sessions.py floor02_v7_float32 --base candidate_v7_float32\nuv run agent/summarize.py median_v3_full --base chronos_v3_full\n git log -1 --oneline\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
