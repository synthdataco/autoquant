{"type":"item.started","item":{"id":"item_219","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nfrom pathlib import Path\np=Path('agent/chronos_vol.py');s=p.read_text().replace('def pipeline():', \\\"def pipeline(model_name='chronos-t5-tiny'):\\\").replace(\\\"str(Path(__file__).parent/'models/chronos-t5-tiny')\\\", \\\"str(Path(__file__).parent/'models'/model_name)\\\").replace('def predict_hourly(asset,origin,seed,values):', \\\"def predict_hourly(asset,origin,seed,values,model_name='chronos-t5-tiny'):\\\").replace('    model=pipeline()', '    model=pipeline(model_name)').replace('def forecast_variance(frame,asset,future,seed,persistence=False):', \\\"def forecast_variance(frame,asset,future,seed,persistence=False,model_name='chronos-t5-tiny'):\\\").replace('forecast=predict_hourly(asset,str(origin),seed,values)', 'forecast=predict_hourly(asset,str(origin),seed,values,model_name)');p.write_text(s)\np=Path('agent/research_model.py');s=p.read_text().replace(\\\"c.get('hourly_persistence',False))\\\", \\\"c.get('hourly_persistence',False),c.get('chronos_model','chronos-t5-tiny'))\\\");p.write_text(s)\nPY\ncat > agent/benchmark_chronos_small.py <<'PY'\n\\\"\\\"\\\"Single-GPU capacity probe; queued behind the existing model job.\\\"\\\"\\\"\nimport time,json,os\nfrom pathlib import Path\nimport numpy as np\nfrom chronos_vol import pipeline,predict_hourly\nimport torch\nseed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261011'));torch.manual_seed(seed)\nvalues=tuple(np.exp(np.sin(np.arange(144)/12))*1e-6)\nt=time.perf_counter();pipeline('chronos-t5-small');load=time.perf_counter()-t\nlatencies=[];forecasts=[]\nfor i in range(3):\n predict_hourly.cache_clear();t=time.perf_counter()\n forecasts.append(predict_hourly('TEST','origin',seed,values,'chronos-t5-small'))\n torch.cuda.synchronize();latencies.append(time.perf_counter()-t)\nassert all(np.array_equal(forecasts[0],f) for f in forecasts[1:])\nresult={'load_seconds':load,'predict_seconds':latencies,'first_response_seconds':load+latencies[0],'max_allocated_gib':torch.cuda.max_memory_allocated()/2**30,'repeatable':True}\nPath('agent/results/chronos_small_latency.json').write_text(json.dumps(result,indent=2));print(result)\nif load+latencies[0]>5 or max(latencies)>5:raise SystemExit('Preregistered practical latency gate failed')\nPY\nuv run python - <<'PY'\nfrom pathlib import Path\nimport json\njobs=[{'cmd':['uv','run','--group','research','agent/benchmark_chronos_small.py'],'log':'agent/results/chronos_small_latency.log'},{'cmd':['uv','run','agent/run_suite.py','--tag','chronos_small_fast15','--model','research_model','--research','--config',json.dumps({'seasonal':True,'fast_half':15,'chronos':True,'chronos_model':'chronos-t5-small'}),'--assets','BTC','ETH','SOL','XRP','HYPE','--formats','1h','--workers','1'],'log':'agent/results/chronos_small_fast15_suite.log'}]\nPath('agent/queue_chronos_small.json').write_text(json.dumps(jobs,indent=2))\nPY\nuv run agent/queue_research.py --jobs agent/queue_chronos_small.json --after-pid 20277 > agent/results/queue_chronos_small.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
