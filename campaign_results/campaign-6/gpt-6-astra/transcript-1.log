ent/results/residual_all/SOL_1h_2026-09-16.json\nagent/results/residual_all/XRP_1h_2026-10-10.json\nagent/results/residual_diagnostics.json\n[project]\nname = \"campaign-workspace\"\nversion = \"0.1.0\"\nrequires-python = \">=3.12,<3.14\"\ndependencies = [\"synth-lib\", \"numpy>=2.2\", \"pandas>=2.3\", \"torch>=2.0\"]\n\n[tool.uv.sources]\n# rev is substituted by workspace.py with the commit the HOST was installed from, so the agent\n# evaluates on the same library the verdict will score with.\nsynth-lib = { git = \"https://github.com/synthdataco/synth-lib\", rev = \"6117938d00077e29747e17db96f77db541bff456\" }\n\n[dependency-groups]\nresearch = [\n    \"chronos-forecasting>=2.3.2\",\n]\n","exit_code":0,"status":"completed"}}
