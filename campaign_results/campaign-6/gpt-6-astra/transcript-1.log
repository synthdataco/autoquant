,tz='UTC')\n for asset in ['BTC','ETH','SOL','XRP','HYPE','XAU','NVDAX','GOOGLX','TSLAX','AAPLX','WTIOIL','SPCX','SP500']:\n  f=load_minute_prices(default_store_root(asset).parents[2],asset,t-pd.Timedelta(days=8),t)\n  for length,step in ([(86400,300),(3600,60)] if asset in candidate_v8.CRYPTO else [(86400,300)]):\n   end=context_end(t,length);frame=f.loc[(f.index>end-pd.Timedelta(days=7))&(f.index<=end)]\n   x=modeling.simulate(asset,t,step,length,17,frame);y=candidate_v8.simulate(asset,t,step,length,17,frame)\n   assert x==y,(asset,date,length)\n   assert np.isfinite(np.asarray(x[2:])).all();count+=1\nprint('Exact serving parity:',count,'calls; MODEL_CONFIG ignored; arbitrary17 paths finite')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
