{"type":"item.completed","item":{"id":"item_309","type":"command_execution","command":"/bin/bash -lc 'uv run agent/summarize.py candidate_v7_float32 --base baseline_float32; cat agent/plot_results.py | head -70; uv run agent/summarize.py median_v3_full --base chronos_v3_full'","aggregated_output":"\n candidate_v7_float32 cells 16\n                             crps       base      pct  wins  cells\nend        config                                                 \n2026-09-19 COM_EQU_24H  2090.3574  2316.0261  -9.1704     8      8\n2026-10-11 COM_EQU_24H  1798.7229  2065.4112 -12.7837     8      8\nend         2026-09-19  2026-10-11\nasset  fmt                        \nAAPLX  24h      -14.49      -17.38\nGOOGLX 24h       -7.01      -14.85\nNVDAX  24h       -7.09      -12.79\nSP500  24h       -4.38       -8.71\nSPCX   24h      -14.73      -14.07\nTSLAX  24h      -14.36      -17.18\nWTIOIL 24h       -4.95       -8.43\nXAU    24h       -6.35       -8.85\n\"\"\"Plot official evaluation summaries; no metric reimplementation.\"\"\"\nimport argparse,json\nfrom pathlib import Path\nimport numpy as np,pandas as pd\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\np=argparse.ArgumentParser();p.add_argument('--candidate',default='candidate_v1_full');p.add_argument('--baseline',default='baseline_full');a=p.parse_args();rows=[]\nfor f in (Path('agent/results')/a.candidate).glob('*.json'):\n b=Path('agent/results')/a.baseline/f.name\n if not b.exists():continue\n asset,fmt,end=f.stem.split('_');x=json.loads(f.read_text());y=json.loads(b.read_text())\n group='Crypto 1h' if fmt=='1h' else 'Crypto 24h' if asset in ['BTC','ETH','SOL','XRP','HYPE'] else 'Commodities/equities 24h'\n rows.append({'end':end,'group':group,'reduction':100*(1-x['mean_crps']/y['mean_crps'])})\nd=pd.DataFrame(rows).groupby(['group','end']).reduction.mean().unstack().reindex(['Crypto 24h','Commodities/equities 24h','Crypto 1h'])\nfig,ax=plt.subplots(figsize=(10,5.4));colors=['#3366a5','#23866a'];positions=np.arange(3)\nfor j,end in enumerate(d.columns):\n bars=ax.bar(positions+(j-.5)*.34,d[end],width=.32,color=colors[j],label={'2026-09-19':'Sep 09–18','2026-10-11':'Oct 01–10'}.get(end,end))\n ax.bar_label(bars,fmt='%.2f%%',padding=4,fontsize=10)\nax.set_xticks(positions,d.index);ax.set_ylabel('CRPS reduction (%)');ax.set_ylim(0,float(d.max().max())*1.2);ax.spines[['top','right']].set_visible(False);ax.grid(axis='y',alpha=.18);ax.set_axisbelow(True);ax.legend(frameon=False)\nax.set_title(a.candidate+' versus seeded starter',loc='left',fontweight='bold',pad=18)\nfig.text(.08,.025,'1000 paths · Equal-asset mean percentage changes · Development-inclusive validation windows',fontsize=9,color='#555555')\nfig.tight_layout(rect=[0,.06,1,1]);out=Path('agent/figures');out.mkdir(exist_ok=True)\nfor ext in ['png','pdf']:fig.savefig(out/(a.candidate+'.'+ext),dpi=160)\nprint('Wrote',out/(a.candidate+'.png'))\n\n median_v3_full cells 0\nEmpty DataFrame\nColumns: [crps, base, pct, wins, cells]\nIndex: []\nEmpty DataFrame\nColumns: []\nIndex: []\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_310","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nfrom pathlib import Path\np=Path('agent/report.md');s=p.read_text().replace('candidate v5','candidate v7').replace('Provisional v5','Provisional v7').replace('2096.5230','2090.3574').replace('1803.7327','1798.7229').replace('commodity/equity results come from v5’s direct run','commodity/equity results come from v7’s direct run').replace('2.17%, 8.92%, 3.96%','2.17%, 9.17%, 3.96%').replace('3.13%, 12.53%, 6.96%','3.13%, 12.78%, 6.96%')\ns=s.replace('They are being checked with the refreshed profiles in a canonical float32 combined run.','The combined model passes canonical float32 validation. Commodity/equity forecasts additionally use ten-minute seasonal bins, shrunk halfway to their half-hour parent, and causal profile refreshes. Fine resolution plus refresh improves all16 cells over each individual change. COM-only Sobol sampling improves15/16 further cells; three-seed testing also supports its modest benefit. Adding latent-volatility reversion on top of Sobol worsens both windows and is discarded.')\ns=s.replace('The pretrained model remains experimental until it passes full-window tests with the selected volatility mixture. Offline weights, exact revision, latency and reproducibility checks are recorded in the journal.','Tiny improves all10 full-window cells beyond v3, but a144-hour median control beats it in9/10 initial-window cells. Full-window median validation is underway; pretrained dynamics have not established an advantage over robust level shrinkage. A matched GARCH blend loses9/10 cells against tiny. Chronos-small fails the predeclared both-window mean criterion against tiny despite8/10 favorable cells. Offline revisions, latency and reproducibility checks are recorded in the journal. Fair fresh-process1000-path benchmarks measure tiny/small cold responses8.30/8.38s and warm responses0.232–0.241/0.306–0.309s. The original small-model5s cold gate failed; the journal records an explicit pre-scoring amendment separating the constitution’s60s hard response bound from its5s practical throughput target.')\ns=s.replace('Finish incremental checks of faster volatility memory, calendar strength and profile refresh; test filtered empirical innovations; check canonical float32 output precision and multiple seeds of the final combination. These studies remain active. Final selection will follow official paired CRPS and serving reproducibility.','Finish the hourly-median comparison, local5% width calibration and quiet-session floor tests. Validate retained combinations on the added late-September dates and check final serving reproducibility. Both baseline and earlier v1 already passed36-cell float32 comparisons; maximum cell-mean precision effects are about0.000012%. The final choice will follow official paired CRPS.')\np.write_text(s)\nPY\n git add .gitignore agent ':\"'!agent/BUDGET.md'\"'\n git commit -qm 'Validate refined COM sampling; promote v7 and test robust hourly controls'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
