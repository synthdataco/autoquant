{"type":"item.started","item":{"id":"item_14","type":"command_execution","command":"/bin/bash -lc \"cat > agent/queue_research.py <<'PY'\n\\\"\\\"\\\"Sequential bounded suites queued behind a verified current-process dependency.\n\nThe caller must reserve \"'`workers` cores once the predecessor exits. Arguments and\nlogs are durable. A vanished dependency is not interpreted as a completed experiment:\nonly scheduling resources are released; run_suite itself checks artifact completeness.\n\"\"\"\nimport argparse,os,time,subprocess,json\nfrom pathlib import Path\np=argparse.ArgumentParser();p.add_argument('\"'--after-pid',type=int,default=0);p.add_argument('--jobs',required=True);a=p.parse_args()\nif a.after_pid:\n while Path(f'/proc/{a.after_pid}').exists():\n  stat=Path(f'/proc/{a.after_pid}/stat').read_text().split()\n  if stat[2]=='Z':break\n  time.sleep(5)\nfor job in json.loads(Path(a.jobs).read_text()):\n cmd=job['cmd'];env=dict(os.environ,OPENBLAS_NUM_THREADS='1',OMP_NUM_THREADS='1',MKL_NUM_THREADS='1',**job.get('env',{}))\n with Path(job['log']).open('w') as f:\n  r=subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT,env=env)\n print(json.dumps({'cmd':cmd,'exit':r.returncode}),flush=True)\n if r.returncode:raise SystemExit(r.returncode)\nPY\nuv run python - <<'PY'\nimport json,subprocess\nfrom pathlib import Path\njobs=[{'cmd':['uv','run','agent/fit_residual.py'],'log':'agent/results/residual_fit.log'}, {'cmd':['uv','run','agent/analyze_events.py','--fine'],'log':'agent/results/events_fine.log'}, {'cmd':['uv','run','agent/fit_events.py','--fine'],'log':'agent/results/event_fit_fine.log'}, {'cmd':['uv','run','agent/run_suite.py','--tag','sobol','--model','research_model','--workers','2','--config','{\\\"seasonal\\\":true,\\\"sampler\\\":\\\"sobol\\\"}'],'log':'agent/results/sobol_suite.log'}]\nPath('agent/queue_after_clock.json').write_text(json.dumps(jobs,indent=2))\nwith open('agent/results/queue_after_clock.log','w') as f:\n p=subprocess.Popen(['uv','run','agent/queue_research.py','--after-pid','181','--jobs','agent/queue_after_clock.json'],stdout=f,stderr=subprocess.STDOUT,start_new_session=True)\nprint('queue PID',p.pid,'reserved 2 cores after current clock suite PID 181 exits')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
