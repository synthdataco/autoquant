{"type":"item.started","item":{"id":"item_253","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nfrom pathlib import Path\nimport pandas as pd,numpy as np\nrows=[]\nfor f in Path('agent/results/candidate_v4_float32').glob('*.parquet'):\n selected=Path('agent/results/candidate_v5_float32')/f.name\n if not selected.exists():selected=f\n x=pd.read_parquet(selected);y=pd.read_parquet(Path('agent/results/baseline_float32')/f.name)\n keys=['asset','time_length','start_time','scored_time'];d=x.merge(y,on=keys,suffixes=('_new','_base'),validate='one_to_one');rows.append(d)\nx=pd.concat(rows);x['day']=pd.to_datetime(x.scored_time).dt.strftime('%Y-%m-%d')\nx['config']=np.where(x.time_length==3600,'CRYPTO_1H',np.where(x.asset.isin(['BTC','ETH','SOL','XRP','HYPE']),'CRYPTO_24H','COM_EQU_24H'))\na=x.groupby(['config','asset','day'])[['crps_new','crps_base']].mean();a['pct']=100*(a.crps_new/a.crps_base-1)\ng=a.groupby(['config','day']).pct.mean()\nprint(g.groupby('config').agg(['mean','min','max',lambda v:int((v<0).sum()),'count']).to_string())\nprint('Largest asset-day regressions:');print(a.nlargest(5,'pct').round(3).to_string())\na.to_csv('agent/results/candidate_v5_composed_daily.csv')\nPY\ncat agent/BUDGET.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
