{"type":"item.completed","item":{"id":"item_294","type":"command_execution","command":"/bin/bash -lc \"cat agent/candidate_v5_research.py; tail -35 agent/modeling.py; cat agent/queue_chronos_diagnostics.json; rg -n 'hourly_persistence|chronos' agent/research_model.py; cat agent/queue_research.py; head -35 agent/run_suite.py\"","aggregated_output":"\"\"\"Research-only configurable ablation of candidate v5.\"\"\"\nimport os\nimport numpy as np\nfrom research_model import simulate_config\nCRYPTO={'BTC','ETH','SOL','XRP','HYPE'}\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261011'));short=time_length<=3600\n    config={'seasonal':True,'clock':True,'events':True,'event_power':1.5,'event_bar_alignment':short,\n            'mix':.35 if short or asset not in CRYPTO else 0.,\n            'fast_half':15 if short else 720,\n            'seasonal_shrink':.02 if asset in CRYPTO and not short else .1,\n            'refresh':asset not in CRYPTO,\n            'robust':.5 if asset not in CRYPTO else 0.,\n            '_calendar_path':os.environ.get('SYNTH_BENCHMARK_CALENDAR',''),'_seed':seed,**__import__('json').loads(os.environ.get('MODEL_CONFIG','{}'))}\n    return simulate_config(asset,start_time,time_increment,time_length,num_simulations,context_prices,np.random.default_rng(seed),config)\n    elif c.get('sampler')=='stratified':\n        from scipy.special import ndtri\n        ranks=rng.uniform(size=(n,steps)).argsort(axis=0)\n        z=ndtri((ranks+.5)/n)\n    elif c.get('antithetic',False) or c.get('paired',False):\n        z=rng.normal(size=((n+1)//2,steps));z=np.concatenate([z,-z])[:n]\n    else:z=rng.normal(size=(n,steps))\n    if c.get('empirical',False):\n        from scipy.special import ndtr\n        quantiles=np.asarray(table('innovations.json')[asset][str(lag)])\n        u=2*np.abs(ndtr(z)-.5)\n        z=np.sign(z)*np.interp(u,(np.arange(len(quantiles))+.5)/len(quantiles),quantiles)\n    df=c.get('df',0)\n    if df:z=z/np.sqrt(rng.chisquare(df,size=z.shape)/df)*np.sqrt((df-2)/df)\n    mix=c.get('mix',0)\n    if c.get('mix_scope')=='non_crypto24h' and not short and asset in ['BTC','ETH','SOL','XRP','HYPE']:\n        mix=0\n    if mix:\n        # Multiplicative path-level volatility uncertainty, E[scale^2]=1.\n        if mixture_normal is None:\n            if c.get('paired',False):\n                half=rng.normal(size=((n+1)//2,1));mixture_normal=np.concatenate([half,half])[:n]\n            else:mixture_normal=rng.normal(size=(n,1))\n        if c.get('mix_revert',False):\n            from scipy.signal import lfilter\n            half_seconds=time_length*c.get('mix_half_fraction',.25)\n            rho=2**(-time_increment/half_seconds)\n            shocks=rng.normal(size=(n,steps))*np.sqrt(1-rho*rho)\n            shocks[:,0]=mixture_normal[:,0]\n            mixture_normal=lfilter([1.],[1.,-rho],shocks,axis=1)\n        z*=np.exp(mix*mixture_normal-mix*mix)\n    shocks=z*sig\n    logs=np.column_stack([np.zeros(n),np.cumsum(shocks,axis=1)])\n    paths=last*np.exp(np.clip(logs,-50,50))\n    return (start_time,time_increment,*paths.tolist())\n[\n  {\n    \"cmd\": [\n      \"uv\",\n      \"run\",\n      \"--group\",\n      \"research\",\n      \"agent/diagnose_chronos_forecasts.py\"\n    ],\n    \"log\": \"agent/results/chronos_forecast_diagnostics.log\"\n  }\n]180:        if c.get('chronos',False):raise ValueError('GARCH/Chronos combination requires an explicit ensemble design')\n185:    if c.get('chronos',False) or c.get('hourly_persistence',False):\n186:        from chronos_vol import forecast_variance\n187:        learned=forecast_variance(context_prices,asset,future,c['_seed'],c.get('hourly_persistence',False),c.get('chronos_model','chronos-t5-tiny'))\n191:        blend=c.get('chronos_blend',.25)\n\"\"\"Sequential bounded suites queued behind a verified current-process dependency.\n\nThe caller must reserve `workers` cores once the predecessor exits. Arguments and\nlogs are durable. A vanished dependency is not interpreted as a completed experiment:\nonly scheduling resources are released; run_suite itself checks artifact completeness.\n\"\"\"\nimport argparse,os,time,subprocess,json\nfrom pathlib import Path\np=argparse.ArgumentParser();p.add_argument('--after-pid',type=int,default=0);p.add_argument('--jobs',required=True);a=p.parse_args()\nif a.after_pid:\n while Path(f'/proc/{a.after_pid}').exists():\n  stat=Path(f'/proc/{a.after_pid}/stat').read_text().split()\n  if stat[2]=='Z':break\n  time.sleep(5)\nfor job in json.loads(Path(a.jobs).read_text()):\n cmd=job['cmd'];env=dict(os.environ,OPENBLAS_NUM_THREADS='1',OMP_NUM_THREADS='1',MKL_NUM_THREADS='1',**job.get('env',{}))\n with Path(job['log']).open('w') as f:\n  r=subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT,env=env)\n print(json.dumps({'cmd':cmd,'exit':r.returncode}),flush=True)\n if r.returncode:raise SystemExit(r.returncode)\n\"\"\"Bounded parallel official-backtester experiments, with durable per-cell artifacts.\"\"\"\nimport argparse, subprocess, os, json\nimport pyarrow.parquet as pq\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\n\nCRYPTO = ['BTC','ETH','SOL','XRP','HYPE']\nCOM = ['XAU','NVDAX','GOOGLX','TSLAX','AAPLX','WTIOIL','SPCX','SP500']\np=argparse.ArgumentParser();p.add_argument('--score-details',action='store_true');p.add_argument('--skip-crypto24h',action='store_true');p.add_argument('--prediction-dtype',choices=['float32','float64'],default='float64');p.add_argument('--cached-prompts',action='store_true');p.add_argument('--research',action='store_true');p.add_argument('--seed',type=int,default=20261011);p.add_argument('--config',default='{}');p.add_argument('--tag',required=True);p.add_argument('--model',default='modeling');p.add_argument('--ends',nargs='+',default=['2026-09-16','2026-10-10']);p.add_argument('--days',type=int,default=2);p.add_argument('--workers',type=int,default=4);p.add_argument('--assets',nargs='+',default=CRYPTO+COM);p.add_argument('--formats',nargs='+',default=['24h','1h']);p.add_argument('--paths',type=int,default=1000)\na=p.parse_args();root=Path('agent/results')/a.tag;root.mkdir(parents=True,exist_ok=True)\n(root/'config.txt').write_text(str(vars(a)))\ndef run(cell):\n asset,fmt,end=cell;prefix=root/f'{asset}_{fmt}_{end}'\n if prefix.with_suffix('.json').exists() and prefix.with_suffix('.parquet').exists():\n  try:\n   summary=json.loads(prefix.with_suffix('.json').read_text())\n   if summary['num_prompts']>0 and pq.ParquetFile(prefix.with_suffix('.parquet')).metadata.num_rows>0:return\n  except (ValueError,OSError,KeyError):pass\n cmd=['uv','run','agent/predict.py','--asset',asset,'--model',a.model,'--days',str(a.days),'--eval-end',end,'--num-simulations',str(a.paths),'--latest-formula','--output',str(prefix),'--prediction-dtype',a.prediction_dtype]\n if a.research:cmd[2:2]=['--group','research']\n if a.cached_prompts:cmd+=['--cached-prompts']\n if a.score_details:cmd+=['--score-details']\n if fmt=='1h':cmd+=['--time-length','3600','--time-increment','60']\n env=dict(os.environ,OPENBLAS_NUM_THREADS='1',OMP_NUM_THREADS='1',MKL_NUM_THREADS='1',MODEL_CONFIG=a.config,SYNTH_BENCHMARK_SEED=str(a.seed))\n with prefix.with_suffix('.log').open('w') as f:r=subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT,env=env)\n print(prefix,r.returncode,flush=True)\n if r.returncode:raise RuntimeError(str(prefix))\ncells=[(asset,fmt,end) for end in a.ends for asset in a.assets for fmt in a.formats if (fmt=='24h' or asset in CRYPTO) and not(a.skip_crypto24h and asset in CRYPTO and fmt=='24h')]\nwith ThreadPoolExecutor(max_workers=a.workers) as pool:list(pool.map(run,cells))\n","exit_code":0,"status":"completed"}}
