{"type":"item.completed","item":{"id":"item_9","type":"command_execution","command":"/bin/bash -lc \"sed -n '20,57p' .venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py && cat agent/analyze_events.py agent/fit_events.py\"","aggregated_output":")\nfrom synth_lib.preparation.realized_path_store import (\n    RealizedPathStore,\n    prefetch_realized_paths,\n)\n\n\ndef _slice_real_prices(\n    prices: pd.DataFrame,\n    start_time: Any,\n    time_length: int,\n    time_increment: int,\n) -> list[float]:\n    \"\"\"Slice a prompt's realized prices out of the local minute frame.\n\n    Raises on a length mismatch (window doesn't cover the prompt — unrepairable);\n    missing minutes come back as NaN for _fill_gaps_from_realized_paths.\n    \"\"\"\n    step_minutes = time_increment // 60\n    window = prices[\"close\"].loc[start_time : start_time + pd.Timedelta(seconds=time_length) : step_minutes]\n    # Coerce: older object-dtype partitions read back as None, which np.isfinite rejects.\n    real_prices = pd.to_numeric(window, errors=\"coerce\").tolist()\n    expected_steps = (time_length // time_increment) + 1\n    if len(real_prices) != expected_steps:\n        raise ValueError(\n            f\"Price data length mismatch at {start_time}: got {len(real_prices)} prices, expected {expected_steps}\"\n        )\n    return real_prices\n\n\ndef _has_missing_prices(real_prices: list[float]) -> bool:\n    \"\"\"True when any price is missing or non-finite. Coerces None to NaN first.\"\"\"\n    coerced = pd.to_numeric(pd.Series(real_prices), errors=\"coerce\")\n    return not bool(np.isfinite(coerced).all())\n\n\ndef _fill_gaps_from_realized_paths(\n    prompts: list[dict[str, Any]],\n\"\"\"Event volatility diagnostics (not a substitute for official CRPS evaluation).\"\"\"\nimport os,json\nfrom pathlib import Path\nimport numpy as np,pandas as pd\nfrom synth_lib.preparation.config import default_store_root\nfrom research_model import shape_at\ncal=pd.read_parquet(os.environ['SYNTH_BENCHMARK_CALENDAR'])\ncal=cal[(cal.time_utc<pd.Timestamp('2026-09-01',tz='UTC')) & (cal.time_utc>=pd.Timestamp('2026-01-01',tz='UTC'))]\nrows=[]\nfor asset in ['BTC','ETH','SOL','XRP','HYPE','XAU','SP500','WTIOIL','NVDAX','TSLAX','AAPLX','GOOGLX','SPCX']:\n fs=[f for f in sorted(default_store_root(asset).glob('date=*.parquet')) if '2026-01-01'<=f.stem[5:]<'2026-09-01']\n df=pd.concat([pd.read_parquet(f,columns=['timestamp','close']) for f in fs]).set_index('timestamp').sort_index()\n r=np.log(df.close.astype(float)).diff();var=r*r/shape_at(r.index,asset,True)\n for e in cal.itertuples():\n  if e.scope!='all' and asset not in e.scope.split(','):continue\n  t=e.time_utc\n  past=var.loc[t-pd.Timedelta(days=7):t-pd.Timedelta(minutes=1)]\n  if past.notna().sum()<1000:continue\n  level=past.mean()\n  for lo,hi in [(0,5),(5,30),(30,120),(120,360)]:\n   x=var.loc[t+pd.Timedelta(minutes=lo):t+pd.Timedelta(minutes=hi-1)]\n   if x.notna().sum()<max(1,len(x)*.4):continue\n   rows.append(dict(asset=asset,event=e.event,time=str(t),lo=lo,hi=hi,ratio=x.mean()/level))\nres=pd.DataFrame(rows);res.to_csv('agent/results/event_diagnostics.csv',index=False)\nprint(res[res.asset.isin(['BTC','ETH','SOL','XRP','HYPE'])].groupby(['event','lo']).ratio.agg(['count','median','mean']).round(2).to_string())\nprint('\\nCOM/EQU\\n',res[~res.asset.isin(['BTC','ETH','SOL','XRP','HYPE'])].groupby(['event','lo']).ratio.agg(['count','median','mean']).round(2).to_string())\n\"\"\"Pooled event multipliers, with event dates as independent sampling units.\"\"\"\nimport json\nfrom pathlib import Path\nimport numpy as np,pandas as pd\nx=pd.read_csv('agent/results/event_diagnostics.csv')\nx['group']=np.where(x.asset.isin(['BTC','ETH','SOL','XRP','HYPE']),'crypto','other')\nx['ratio']=x.ratio.clip(.02,100)\nout={}; diagnostics=[]\nfor (group,event,lo),g in x.groupby(['group','event','lo']):\n if event in ['EARNINGS','NYSE_CLOSED','NYSE_EARLY_CLOSE'] or lo==120:continue\n # Assets at one release share a shock: collapse to one datum per release.\n z=g.groupby('time').ratio.median()\n if len(z)<4:continue\n estimate=float(np.exp(.67*np.log(z).median()))\n estimate=max(1.,min(12.,estimate))\n loeo=[float(np.exp(.67*np.log(z.drop(i)).median())) for i in z.index]\n diagnostics.append(dict(group=group,event=event,lo=int(lo),n_dates=len(z),mult=estimate,leave_one_out_min=min(loeo),leave_one_out_max=max(loeo)))\n out.setdefault(group,{}).setdefault(event,{})[str(lo)]=estimate\nPath('agent/event_multipliers.json').write_text(json.dumps({'train_end_exclusive':'2026-09-01','groups':out},indent=2))\npd.DataFrame(diagnostics).to_csv('agent/results/event_fit.csv',index=False)\nprint(pd.DataFrame(diagnostics).round(3).to_string(index=False))\n","exit_code":0,"status":"completed"}}
