   1h        -0.15       -0.05       -0.01\n       24h       -0.10       -0.07       -0.00\n\n stress_shrink02 cells 54\n                             crps       base     pct  wins  cells\nend        config                                                \n2026-09-13 COM_EQU_24H  2273.9580  2285.1979 -0.4850     7      8\n           CRYPTO_1H     835.1175   835.6859 -0.0775     5      5\n           CRYPTO_24H   4223.2512  4229.3753 -0.1582     5      5\n2026-09-19 COM_EQU_24H  2246.9372  2245.5888  0.1193     3      8\n           CRYPTO_1H    1068.8554  1068.8934 -0.0164     4      5\n           CRYPTO_24H   5077.7375  5079.6741 -0.0314     4      5\n2026-10-05 COM_EQU_24H  1574.6257  1600.2236 -1.5978     8      8\n           CRYPTO_1H     611.8021   611.9980 -0.0339     4      5\n           CRYPTO_24H   3219.9464  3226.5443 -0.2282     5      5\nend         2026-09-13  2026-09-19  2026-10-05\nasset  fmt                                    \nAAPLX  24h       -0.84       -0.02       -1.89\nBTC    1h        -0.14       -0.05       -0.09\n       24h       -0.27        0.00       -0.47\nETH    1h        -0.09       -0.02       -0.02\n       24h       -0.18       -0.00       -0.27\nGOOGLX 24h       -0.39        0.80       -1.88\nHYPE   1h        -0.02        0.11       -0.06\n       24h       -0.11       -0.03       -0.23\nNVDAX  24h       -0.32        0.67       -1.46\nSOL    1h        -0.05       -0.05        0.06\n       24h       -0.10       -0.04       -0.05\nSP500  24h       -0.14        0.06       -0.62\nSPCX   24h       -0.99       -0.58       -2.52\nTSLAX  24h       -0.52       -0.25       -1.92\nWTIOIL 24h        0.03        0.12       -0.82\nXAU    24h       -0.71        0.17       -1.68\nXRP    1h        -0.09       -0.06       -0.06\n       24h       -0.13       -0.09       -0.12\n\"\"\"Bounded parallel official-backtester experiments, with durable per-cell artifacts.\"\"\"\nimport argparse, subprocess, os, json\nimport pyarrow.parquet as pq\nfrom concurrent.futures import ThreadPoolExecutor\nfrom pathlib import Path\n\nCRYPTO = ['BTC','ETH','SOL','XRP','HYPE']\nCOM = ['XAU','NVDAX','GOOGLX','TSLAX','AAPLX','WTIOIL','SPCX','SP500']\np=argparse.ArgumentParser();p.add_argument('--cached-prompts',action='store_true');p.add_argument('--research',action='store_true');p.add_argument('--seed',type=int,default=20261011);p.add_argument('--config',default='{}');p.add_argument('--tag',required=True);p.add_argument('--model',default='modeling');p.add_argument('--ends',nargs='+',default=['2026-09-16','2026-10-10']);p.add_argument('--days',type=int,default=2);p.add_argument('--workers',type=int,default=4);p.add_argument('--assets',nargs='+',default=CRYPTO+COM);p.add_argument('--formats',nargs='+',default=['24h','1h']);p.add_argument('--paths',type=int,default=1000)\na=p.parse_args();root=Path('agent/results')/a.tag;root.mkdir(parents=True,exist_ok=True)\n(root/'config.txt').write_text(str(vars(a)))\ndef run(cell):\n asset,fmt,end=cell;prefix=root/f'{asset}_{fmt}_{end}'\n if prefix.with_suffix('.json').exists() and prefix.with_suffix('.parquet').exists():\n  try:\n   summary=json.loads(prefix.with_suffix('.json').read_text())\n   if summary['num_prompts']>0 and pq.ParquetFile(prefix.with_suffix('.parquet')).metadata.num_rows>0:return\n  except (ValueError,OSError,KeyError):pass\n cmd=['uv','run','agent/predict.py','--asset',asset,'--model',a.model,'--days',str(a.days),'--eval-end',end,'--num-simulations',str(a.paths),'--latest-formula','--output',str(prefix)]\n if a.research:cmd[2:2]=['--group','research']\n if a.cached_prompts:cmd+=['--cached-prompts']\n if fmt=='1h':cmd+=['--time-length','3600','--time-increment','60']\n env=dict(os.environ,OPENBLAS_NUM_THREADS='1',OMP_NUM_THREADS='1',MKL_NUM_THREADS='1',MODEL_CONFIG=a.config,SYNTH_BENCHMARK_SEED=str(a.seed))\n with prefix.with_suffix('.log').open('w') as f:r=subprocess.run(cmd,stdout=f,stderr=subprocess.STDOUT,env=env)\n print(prefix,r.returncode,flush=True)\n if r.returncode:raise RuntimeError(str(prefix))\ncells=[(asset,fmt,end) for end in a.ends for asset in a.assets for fmt in a.formats if fmt=='24h' or asset in CRYPTO]\nwith ThreadPoolExecutor(max_workers=a.workers) as pool:list(pool.map(run,cells))\n118:    if c.get('refresh',False):\n152:        sf*=event_factor(event_index,asset,time_increment,c.get('_calendar_path',''),c.get('holidays',False),c.get('event_fine',False),c.get('event_power',1.))\n","exit_code":0,"status":"completed"}}
