orch.manual_seed(seed)\n    with torch.inference_mode():\n        point,_=model.decode(torch.from_numpy(padded[None,:]),torch.from_numpy(padding[None,:]),torch.zeros((1,1),dtype=torch.long),horizon_len=25)\n    point=point.detach().cpu().numpy()[0]\n    return np.exp(np.clip(point,-3,3))*center\n\ndef forecast_variance(frame,asset,future,seed,shape_name='seasonality.json'):\n    from research_model import shape_at\n    ret=np.log(frame.close.astype(float)).diff()\n    rv=ret.pow(2)/shape_at(frame.index,asset,True,shape_name)\n    hourly=rv.resample('h').mean();count=frame.close.resample('h').size()\n    hourly=hourly.where(count==60)\n    hourly=hourly[hourly.index+pd.Timedelta(hours=1)<=frame.index[-1]+pd.Timedelta(minutes=1)].iloc[-144:]\n    bad=np.flatnonzero(~np.isfinite(hourly.to_numpy()))\n    if len(bad):hourly=hourly.iloc[bad[-1]+1:]\n    if len(hourly)<48 or float(hourly.median())<=0:return None\n    origin=hourly.index[-1]+pd.Timedelta(hours=1)\n    forecast=predict_hourly(asset,str(origin),seed,tuple(hourly.to_numpy(dtype=float)))\n    at=np.asarray((future-origin).total_seconds())//3600\n    return forecast[np.clip(at.astype(int),0,len(forecast)-1)]\nPY\nuv run python - <<'PY'\nfrom pathlib import Path\np=Path('agent/research_model.py');s=p.read_text();needle=\\\"    scale=c.get('scale',1.0)\\\";assert needle in s;s=s.replace(needle,\\\"    if c.get('timesfm',False):\\\\n        if not short or c.get('chronos',False) or c.get('garch',False) or c.get('hourly_persistence',False):\\\\n            raise ValueError('TimesFM study is an independent one-hour model')\\\\n        from timesfm_vol import forecast_variance\\\\n        learned=forecast_variance(context_prices,asset,future,c['_seed'],shape_name)\\\\n        if learned is not None:\\\\n            base=np.maximum(long+(initial-long)*decay,1e-14)\\\\n            variance*=.75+.25*np.clip(learned/base,.25,4.)\\\\n\\\"+needle);p.write_text(s)\nPY\ncat > agent/benchmark_timesfm_cpu.py <<'PY'\n\\\"\\\"\\\"Fresh-process, uncached1000-path CPU latency and repeatability gate.\\\"\\\"\\\"\nimport os,time,json,resource\nstarted=time.perf_counter();os.environ['TORCH_DISABLE_NATIVE_JIT']='1'\nimport torch,numpy as np,pandas as pd\nfrom synth_lib.preparation.config import default_store_root\nfrom predict import load_minute_prices,context_end\nfrom candidate_v9_research import simulate\nfrom timesfm_vol import predict_hourly\nframework=time.perf_counter()-started\nt=pd.Timestamp('2026-10-08T12:17:00Z');end=context_end(t,3600)\nframe=load_minute_prices(default_store_root('BTC').parents[2],'BTC',t-pd.Timedelta(days=8),t)\nframe=frame.loc[(frame.index>end-pd.Timedelta(days=7))&(frame.index<=end)]\nos.environ['MODEL_CONFIG']='{\\\"timesfm\\\":true}'\nlatencies=[];previous=None\nfor _ in range(3):\n predict_hourly.cache_clear();started=time.perf_counter();result=simulate('BTC',t,60,3600,1000,frame);latencies.append(time.perf_counter()-started)\n assert len(result)==1002 and np.isfinite(np.asarray(result[2:])).all()\n if previous is not None:assert previous==result\n previous=result\nsummary={'device':'cpu','framework_startup_seconds':framework,'uncached_simulate_seconds':latencies,'cold_response_seconds':framework+latencies[0],'peak_rss_gib':resource.getrusage(resource.RUSAGE_SELF).ru_maxrss/1024**2,'paths':1000,'repeatable':True}\nprint(json.dumps(summary),flush=True)\nassert summary['cold_response_seconds']<60 and max(latencies[1:])<5\nPY\nOPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 uv run agent/benchmark_timesfm_cpu.py > agent/results/timesfm_cpu_benchmark.log 2>&1\"","aggregated_output":"","exit_code":0,"status":"completed"}}
