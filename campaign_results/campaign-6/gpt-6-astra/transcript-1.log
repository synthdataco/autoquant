t/results/{tag}_suite.log'})\nPath('agent/queue_history_bridge.json').write_text(json.dumps(jobs,indent=2))\nPY\nuv run agent/queue_research.py --jobs agent/queue_history_bridge.json > agent/results/queue_history_bridge.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
