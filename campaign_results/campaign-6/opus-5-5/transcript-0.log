{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011D7vN6NkHWNRvSgX56AZJ8","type":"tool_result","content":"\"\"\"Backtest result type and the skip signal for assets with no scores.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\nimport pandas as pd\n\n\nclass NoScoresAvailable(RuntimeError):\n    \"\"\"An asset has no scored prompts in the window — a skip, not a failure.\n\n    Distinct type so run_backtest can tell it apart from a genuine break.\n    \"\"\"\n\n\n@dataclass\nclass BacktestResult:\n    miner_name: str\n    prompt_df: pd.DataFrame\n    smoothed_scores: pd.DataFrame\n    summary: dict[str, Any]\n90:def backtest(\n91-    miner_name: str = \"initial_research\",\n92-    asset: str = \"BTC\",\n93-    *,\n94-    time_length: int,\n95-    time_increment: int | None = None,\n96-    n_backtest_days: int = 15,\n97-    miner_id: int = 999,\n98-    predictions_dir: Path | None = None,\n99-    scoring_intervals: dict[str, int] | None = None,\n100-    competition: CompetitionConfig | None = None,\n101-    scoring_executor: ProcessPoolExecutor | None = None,\n102-    eval_end: datetime | None = None,\n103-    simulate_registration: datetime | None = None,\n104-    simulate_deregistration: datetime | None = None,\n105-    registrations: Registrations | None = None,\n106-    match_tolerance_minutes: int = PREDICTION_MATCH_TOLERANCE_MINUTES,\n107-    latest_formula: bool = False,\n108-) -> BacktestResult:\n109-    \"\"\"Backtest a local miner against Synth subnet scoring data.\n110-    Loads predictions from predictions_dir (or miner_outputs/{miner_name}/predictions/).\n111-    `registrations` (uid -> registration time(s) of its occupants inside the data, see\n112-    `get_registrations`) scores each field uid that changed hands as the miners live sees.\n113-    A scored prompt is answered by the latest prediction starting at or before it, at most\n114-    `match_tolerance_minutes` earlier; predictions on a grid pass its cadence.\n115-    `latest_formula` scores every prompt with the latest crypto-1h formula instead of the one live\n116-    when it was scored: CRPS then compares across the change, field ranks before it do not.\n117-    \"\"\"\n118-    if competition is None:\n119-        competition = competition_for(asset, time_length)\n120-    if time_increment is None:\n121-        time_increment = competition.time_increment\n122-    if scoring_intervals is None:\n123-        scoring_intervals = competition.scoring_intervals\n124-\n125-    # Discover predictions and their date range\n126-    predictions_root = predictions_dir or (DEFAULT_MINER_OUTPUT_ROOT / miner_name / \"predictions\")\n127-    prediction_index = build_prediction_index(predictions_root)\n128-    pred_times = [t.to_pydatetime() for prompts in prediction_index.values() for t in prompts]\n129-    if not pred_times:\n130-        raise FileNotFoundError(\n131-            f\"No predictions found in {predictions_root}. Expected the day layout \"\n132-            \"<asset>/<time_length>_<time_increment>/date=*.npy, or one JSON per prompt \"\n133-            \"named like 2026-03-28_00:00:00Z_BTC_86400.json\"\n134-        )\n135-    pred_start = min(pred_times)\n136-    pred_end = max(pred_times)\n137-\n138-    # Constrain backtest window to prediction coverage, scored_time against the first prediction's\n139-    # start less the default match tolerance, and the last one's horizon plus the match tolerance\n140-    # (at least an hour): a prediction answers prompts up to that tolerance after its start.\n141-    # Anchor priority: simulate_deregistration > eval_end > now. When the user passes\n142-    # simulate_registration, the window's lower bound shifts to it (minus 10d for the\n143-    # smoothed-score moving-average lookback) instead of `anchor − n_backtest_days`,\n144-    # so the API actually fetches scored prompts in the simulated mining period.\n145-    if simulate_deregistratio