+    close = close.astype(float)","+    idx = pd.DatetimeIndex(close.index)","+    idx = idx.tz_localize(\"UTC\") if idx.tz is None else idx.tz_convert(\"UTC\")","+    vals = close.to_numpy()","+    ok = np.isfinite(vals) & (vals > 0)","+    last = float(vals[ok][-1])","+","+    # gap-aware returns between consecutive valid closes; seasonal weight = profile summed over the gap","+    pm = _week_minute_profile(asset, idx)","+    pos = np.flatnonzero(ok)","+    lv = np.log(vals[pos])","+    r2 = np.diff(lv) ** 2","+    cum = np.concatenate([[0.0], np.cumsum(pm)])","+    s = cum[pos[1:] + 1] - cum[pos[:-1] + 1]","+    t_end = (idx[-1] - idx[0]).total_seconds() / 60.0","+    age = t_end - (idx[pos[1:]] - idx[0]).total_seconds().to_numpy() / 60.0","+    if r2.size < 30:","+        v_s = v_l = 1e-8","+    else:","+        cap = P(\"WINS\", 30.0) * np.median(r2 / np.maximum(s, 1e-9))","+        r2c = np.minimum(r2, cap * s) if cap > 0 else r2","+        v_s = _ewma_level(r2c, s, age, P(\"HL_S\", 120))","+        v_l = _ewma_level(r2c, s, age, P(\"HL_L\", 2880))","+","+    # future per-minute variance: profile x level decaying from short to long EWMA","+    lead = (start - idx[-1]).total_seconds() / 60.0","+    fut = start + pd.to_timedelta(np.arange(time_length // 60) * 60, unit=\"s\")","+    k = lead + np.arange(time_length // 60)","+    lvl = v_l + (v_s - v_l) * np.exp(-k / P(\"TAU_MR\", 240))","+    var_min = _week_minute_profile(asset, fut) * lvl * P(\"SCALE\", 1.0) ** 2","+    mps = time_increment // 60","+    var_step = var_min[: n_steps * mps].reshape(n_steps, mps).sum(axis=1)","+    sig = np.sqrt(var_step)","+","+    nu = P(\"NU\", 5.0)","+    eta = P(\"ETA\", 0.2)","+    z = rng.standard_t(nu, size=(num_simulations, n_steps)) * np.sqrt((nu - 2) / nu)","+    m = np.exp(eta * rng.standard_normal((num_simulations, 1)) - eta**2)","+    inc = z * sig[None, :] * m","+    inc -= 0.5 * (sig[None, :] * m) ** 2","+    logp = np.concatenate([np.zeros((num_simulations, 1)), np.cumsum(inc, axis=1)], axis=1)","+    paths = last * np.exp(logp)","+    return (start_time, time_increment, *paths)"]}],"originalFile":"\"\"\"Starter model written by the harness: log-normal martingale calibrated on the context.\n\nThis is a deliberately simple STARTING POINT — replace it with your own model.\nContract: simulate(...) -> (start_timestamp, time_increment, *paths), each path has\ntime_length//time_increment + 1 points starting at the context's last price.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport numpy as np\n\n\ndef simulate(\n    asset: str,\n    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    steps = time_length // time_increment + 1\n    closes = context_prices[\"close\"].dropna()\n    last = float(closes.iloc[-1])\n    rets = np.diff(np.log(np.asarray(closes, dtype=float)))\n    rets = rets[np.isfinite(rets)]\n    per_step_sigma = float(np.std(rets)) * (time_increment / 60.0) ** 0.5 if rets.size > 10 else 1e-3\n    rng = np.random.default_rng()\n    shocks = rng.normal(0.0, per_step_sigma, size=(num_simulations, steps))\n    shocks[:, 0] = 0.0\n    paths = last * np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *[p.tolist() for p in paths])\n","userModified":false}}
