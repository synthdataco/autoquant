ol_use_result":{"stdout":"\"\"\"Fit per-asset intraday/weekly volatility profiles (New York local time, 15-min bins of the week).\n\nuv run agent/fit_season.py --cutoff 2026-09-08 --out agent/artifacts/season_pre0908.json\nProfile p[bin] multiplies a deseasonalised per-minute variance; mean over the week = 1.\nEstimated from 1-min squared log returns (consecutive valid closes only, never interpolated),\neach divided by a centred 3-day rolling mean of squared returns to strip the slow level.\nMon-Fri bins are shrunk halfway to the pooled weekday profile of their slot.\n\"\"\"\nimport argparse, glob, json, os\nfrom pathlib import Path\nimport numpy as np, pandas as pd\n\nASSETS = [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\", \"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\"]\nROOT = Path(__file__).resolve().parent.parent / \"market_data\" / \"prices\"\nNB = 96  # 15-min slots per day\n\n\ndef load(a, start, end):\n    fs = [f for f in sorted(glob.glob(str(ROOT / a / \"1m\" / \"date=*.parquet\"))) if start <= f[-18:-8] < end]\n    df = pd.concat([pd.read_parquet(f, columns=[\"timestamp\", \"close\"]) for f in fs])\n    df[\"timestamp\"] = pd.to_datetime(df.timestamp, utc=True)\n    return df.set_index(\"timestamp\").close\n\n\nMACRO = (\"CPI\", \"NFP\", \"FOMC\", \"PPI\", \"GDP\", \"PCE\", \"RETAIL_SALES\")\n\n\ndef event_mask(idx, asset):\n    \"\"\"Minutes within [-30, +240) of a scheduled macro release (or EIA for WTIOIL): kept out of the profile,\n    the model adds them back as explicit event multipliers.\"\"\"\n    path = os.environ.get(\"SYNTH_BENCHMARK_CALENDAR\")\n    m = np.zeros(len(idx), dtype=bool)\n    if not path or os.environ.get(\"NO_EVENT_MASK\"):\n        return m\n    ev = pd.read_parquet(path)\n    ev = ev[ev.event.isin(MACRO) | ((ev.event == \"EIA_PETROLEUM\") & (asset == \"WTIOIL\"))]\n    t = pd.DatetimeIndex(pd.to_datetime(ev.time_utc, utc=True)).tz_localize(None).sort_values().to_numpy().astype(\"datetime64[ns]\")\n    x = idx.tz_convert(\"UTC\").tz_localize(None).to_numpy().astype(\"datetime64[ns]\")\n    k = np.searchsorted(t, x + np.timedelta64(30, \"m\"), side=\"right\") - 1\n    ok = k >= 0\n    dt = (x[ok] - t[k[ok]]) / np.timedelta64(1, \"m\")\n    m[ok] = (dt >= -30) & (dt < 240)\n    return m\n\n\ndef week_bin(idx_utc):\n    ny = idx_utc.tz_convert(\"America/New_York\")\n    return ny.dayofweek * NB + (ny.hour * 60 + ny.minute) // 15\n\n\ndef fit(a, start, cutoff, shrink=0.5, wins=100.0, hl_days=0.0, step=1, l1=False):\n    c = load(a, start, cutoff)\n    r = np.log(c.ffill()).diff(step)  # no trade = unchanged last price (estimation only, never served)\n    r2 = r**2\n    lvl = r2.rolling(10080, center=True, min_periods=5000).mean()  # one full week: keeps the weekly shape in the profile\n    keep = np.isfinite(r2) & np.isfinite(lvl) & (lvl > 0) & ~event_mask(r2.index, a)\n    r2, lvl = r2[keep], lvl[keep]\n    z = np.minimum(r2, wins * lvl)\n    b = week_bin(z.index - pd.Timedelta(minutes=step // 2))\n    age = (pd.Timestamp(cutoff, tz=\"UTC\") - z.index).total_seconds().to_numpy() / 86400\n    w = 0.5 ** (age / hl_days) if hl_days > 0 else np.ones(len(z))\n    if l1:  # robust: ratio of mean |r| to mean sqrt(level), squared\n        num = pd.Series(np.sqrt(z.values) * w).groupby(b).sum()\n        den = pd.Series(np.sqrt(lvl.values) * w).groupby(b).sum()\n        prof = ((num / den) ** 2).reindex(range(7 * NB))\n    else:\n        num = pd.Series(z.values * w).groupby(b).sum()\n        den = pd.Series(lvl.values * w).groupby(b).sum()\n        prof = (num / den).reindex(range(7 * NB))\n    cnt = pd.Series(z.values).groupby(b).size().reindex(range(7 * NB)).fillna(0)\n    P = prof.values.reshape(7, NB).copy()\n    wk = np.nanmean(P[:5], axis=0)\n    P[:5] = shrink * wk + (1 - shrink) * np.where(np.isnan(P[:5]), wk, P[:5])\n    P = np.where(np.isnan(P), np.nanmean(P), P)\n    P = P / P.mean()\n    # share of step returns that are exactly zero (both ends traded), same bins and recency weights\n    rr = np.log(c).diff(step)\n    rr = rr[np.isfinite(rr)]\n    ag = (pd.Timestamp(cutoff, tz=\"UTC\") - rr.index).total_seconds().to_numpy() / 86400\n    wz = 0.5 ** (ag / hl_days) if hl_days > 0 else np.ones(len(rr))\n    bz = week_bin(rr.index - pd.Timedelta(minutes=step // 2))\n    zf = (pd.Series((rr.values == 0) * wz).groupby(bz).sum() / pd.Series(wz).groupby(bz).sum()).reindex(range(7 * NB))\n    Z = zf.values.reshape(7, NB).copy()\n    zwk = np.nanmean(Z[:5], axis=0)\n    Z[:5] = shrink * zwk + (1 - shrink) * np.where(np.isnan(Z[:5]), zwk, Z[:5])\n    Z = np.where(np.isnan(Z), np.nanmean(Z), Z)\n    return P.ravel(), int(cnt.sum()), Z.ravel()\n\n\nif __name__ == \"__main__\":\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--cutoff\", required=True)\n    ap.add_argument(\"--start\", default=\"2026-03-01\")\n    ap.add_argument(\"--out\", required=True)\n    ap.add_argument(\"--hl\", type=float, default=0.0)\n    ap.add_argument(\"--shrink\", type=float, default=0.5)\n    ap.add_argument(\"--l1\", action=\"store_true\")\n    a = ap.parse_args()\n    res = {\"nb\": NB, \"tz\": \"America/New_York\", \"cutoff\": a.cutoff, \"hl\": a.hl}\n    for step in (1, 5):\n        out, zout = {}, {}\n        for x in ASSETS:\n            p, n, zz = fit(x, a.start, a.cutoff, shrink=a.shrink, hl_days=a.hl, step=step, l1=a.l1)\n            out[x] = [round(float(v), 4) for v in p]\n            zout[x] = [round(float(v), 4) for v in zz]\n            print(step, x, n, \"wkday/wkend ratio\", round(p[: 5 * NB].mean() / p[5 * NB:].mean(), 2), \"max\", round(p.max(), 2))\n        res[f\"profiles_{step}\"] = out\n        res[f\"zero_{step}\"] = zout\n    Path(a.out).write_text(json.dumps(res))\n28:def _profiles(fname):\n29-    d = json.loads((ART / fname).read_text())\n30-    prof = {s: {k: np.asarray(v) for k, v in d[f\"profiles_{s}\"].items()} for s in (1, 5)}\n31-    zero = {s: {k: np.asarray(v) for k, v in d.get(f\"zero_{s}\", {}).items()} for s in (1, 5)}\n32-    return d[\"nb\"], prof, zero\n33-\n34-\n35:def _week_minute_profile(asset, idx_utc, step, kind=1):\n36-    \"\"\"Profile value for each UTC timestamp in idx_utc (DatetimeIndex), fitted on `step`-minute returns.\n37-    kind=1: variance multiplier; kind=2: probability that a step return is exactly zero.\"\"\"\n38-    nb, prof, zero = _profiles(SEASON_FILE)\n39-    p = (prof if kind == 1 else zero)[step].get(asset)\n40-    if p is None and kind == 2:\n41-        return np.zeros(len(idx_utc))\n42-    if p is None:\n43-        return np.ones(len(idx_utc))\n44-    ny = idx_utc.tz_convert(\"America/New_York\")\n45-    b = ny.dayofweek * nb + (ny.hour * 60 + ny.minute) // (1440 // nb)\n46-    return p[np.asarray(b)]\n47-\n48-\n49-CRYPTO = (\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\")\n50-\n51-# Variance multipliers around scheduled releases, relative to a non-event day at the same clock time.\n52-# Windows in minutes from the release; values = median over 13 assets x past releases of the squared\n53-# L1 ratio (agent/analysis/events.py, data < 2026-10-11). Same-minute releases: the max applies.\n54-EV_WIN = np.array([-30, 0, 2, 5, 15, 30, 60, 120, 240])\n55-EV_MULT = {\n56-    \"CPI\": [0.85, 26.0, 5.5, 3.0, 1.8, 1.05, 1.1, 1.0],\n57-    \"NFP\": [0.8, 10.0, 3.4, 2.3, 1.7, 1.1, 1.0, 1.0],\n--\n146:    pm = _week_minute_profile(asset, idx, step) * _event_mult(asset, idx)\n147-    lp = np.log(pd.Series(np.where(ok, vals, np.nan)).ffill().to_numpy())\n148-    r = lp[step:] - lp[:-step]\n149-    cum = np.concatenate([[0.0], np.cumsum(pm)])\n150-    s_all = cum[step + 1:] - cum[1:-step]\n151-    good = np.isfinite(r)\n152-    r2, s = r[good] ** 2, s_all[good]\n153-    age = (len(vals) - 1 - np.arange(step, len(vals)))[good].astype(float)\n154-    if r2.size < 30:\n155-        v_s = v_l = 1e-8\n156-    else:\n157-        cap = P(\"WINS\", 30.0) * np.median(r2 / np.maximum(s, 1e-9))\n158-        r2c = np.minimum(r2, cap * s) if cap > 0 else r2\n159-        v_s = _ewma_level(r2c, s, age, P(\"HL_S\", 120))\n160-        v_l = _ewma_level(r2c, s, age, P(\"HL_L\", 2880))\n161-        rw = P(\"RANGE_W\", 0.0)\n162-        if rw > 0 and isinstance(ctx, pd.DataFrame) and {\"high\", \"low\"} <= set(ctx.columns):\n163-            # Parkinson range per minute: same information as r^2, far less sampling noise on short windows.\n164-            # Put on the close-return scale by the ratio of the two over the whole context.\n165-            hi, lo = ctx[\"high\"].to_numpy(float), ctx[\"low\"].to_numpy(float)\n166-            pk = np.log(hi / lo) ** 2 / (4 * np.log(2))\n167-            okp = np.isfinite(pk) & ok\n168-            if okp.sum() > 100:\n--\n182:    var_min = _week_minute_profile(asset, fut, step) * _event_mult(asset, fut) * lvl * P(\"SCALE\", 1.0) ** 2\n183-    we_k = P(\"WE_SCALE\", 1.0) ** 2\n184-    gam = P(\"WE_GAMMA\", 0.0)\n185-    if gam > 0 and r2.size > 100:\n186-        # last weekend vs the weekdays in the context, deseasonalised (L1): how far the profile is off now\n187-        wk_ctx = _weekend(idx[step:])[good]\n188-        a_we, a_wd = np.sqrt(r2[wk_ctx]).sum(), np.sqrt(r2[~wk_ctx]).sum()\n189-        b_we, b_wd = np.sqrt(s[wk_ctx]).sum(), np.sqrt(s[~wk_ctx]).sum()\n190-        if a_we > 0 and a_wd > 0 and b_we > 0 and b_wd > 0:\n191-            rho = ((a_we / b_we) / (a_wd / b_wd)) ** 2\n192-            we_k *= float(np.clip(rho, 0.05, 5.0)) ** gam\n193-    if we_k != 1.0 and (asset not in CRYPTO or P(\"WE_CRYPTO\", 0.0) > 0):\n194-        var_min = np.where(_weekend(fut), var_min * we_k, var_min)\n195-    mps = time_increment // 60\n196-    var_step = var_min[: n_steps * mps].reshape(n_steps, mps).sum(axis=1)","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false}}
