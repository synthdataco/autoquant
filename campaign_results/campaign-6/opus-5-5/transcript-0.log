g())\nprint(d[d.win == '0-5'].groupby(['asset', 'event']).l1.median().unstack().round(1).to_string())\nEOF\nuv run agent/analysis/events.py BTC ETH SOL XRP HYPE XAU NVDAX GOOGLX TSLAX AAPLX WTIOIL SPCX SP500 2>&1 | grep -v Warn","uuid":"190a728d-37cc-4856-8ac1-0b913f986821","session_id":"fdbca538-ca84-498b-80c3-b8a33e6553ce"}
