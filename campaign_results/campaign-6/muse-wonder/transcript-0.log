me_length // 60\n    t0 = pd.Timestamp(start_time)\n    fut = pd.date_range(t0, periods=minutes, freq=\"1min\")\n    seas_f = prof[fut.weekday, fut.hour] * _event_mult(asset, fut)\n\n    mu = 0.5 * np.log(slow)\n    start_log = mu + FAST_W * (0.5 * np.log(fast) - mu) if USE_SV else mu\n    eps_sd = VOL_SD * np.sqrt(1 - _PHI_MIN ** 2) if USE_SV else 0.0","numLines":60,"startLine":70,"totalLines":144}}}
