{"type":"user","message":{"role":"user","content":[{"tool_use_id":"call_01a163cfa2f8767cb86c358e0a03f858","type":"tool_result","content":"1\t\"\"\"Self-evaluation via the official synth-lib backtester.\n2\t\n3\tUsage: uv run agent/predict.py --asset BTC --days 3 --eval-end 2026-07-15\n4\tAnswers, with agent/modeling.py, the prompts the validator scored in the --days before --eval-end,\n5\tat the start times it actually used (read from the offline field bundle), then scores them with\n6\tbacktest() (validator CRPS + rank vs the real field, from the same bundle). A prompt is scored one\n7\thorizon after it starts, so generation begins one horizon before the scored days.\n8\t--cadence-minutes N answers an even grid over the same span instead; each scored prompt is then\n9\tanswered by the grid point at or before it.\n10\t\n11\tWorks on every asset, including the ones whose minutes do not all trade. Prices load through the\n12\tsame lenient path the scored evaluation uses, so a NaN close reaches simulate() rather than\n13\tstopping the run — your model must tolerate them (drop, never interpolate).\n14\t\n15\tWhen the snapshot carries an event calendar ($SYNTH_BENCHMARK_CALENDAR), the summary is followed by\n16\tyour gap to each prompt's best miner, over the prompts whose horizon holds an event of each type and\n17\tover those that hold none: where an event costs you, that gap is wider.\n18\t\n19\t--num-simulations defaults to 1000, matching the validator's real serving size\n20\t(PromptConfig.num_simulations). Lowering it (e.g. for a quick local iteration loop) speeds up\n21\tgeneration at the cost of a slightly pessimistic CRPS: empirical CRPS is biased upward for\n22\tfewer sampled paths, and the real field's CRPS was computed at 1000.\n23\t\n24\tThe context a prompt gets ends BEFORE its start_time, and that is not an off-by-one. The store\n25\tlabels a minute bar by its OPEN time, so the bar labelled t closes at t+60s — and that close is\n26\tthe first point the prompt is scored against. A prompt is also issued before the start_time it is\n27\tscored from (ISSUANCE_LEAD_SECONDS). Ending the context at t would hand the model the answer to\n28\tits own first step, and a model tuned that way is optimising a problem it will not be scored on.\n29\t\"\"\"\n30\t\n31\tfrom __future__ import annotations\n32\t\n33\timport argparse\n34\timport json\n35\timport os\n36\timport shutil\n37\timport sys\n38\timport tempfile\n39\tfrom datetime import datetime, timedelta, timezone\n40\tfrom pathlib import Path\n41\t\n42\timport numpy as np\n43\timport pandas as pd\n44\t\n45\tfrom synth_lib.backtester.config import PREDICTION_MATCH_TOLERANCE_MINUTES\n46\tfrom synth_lib.backtester.loading import get_miner_scores\n47\tfrom synth_lib.backtester.orchestration import backtest\n48\tfrom synth_lib.benchmark.generate_predictions import context_end, load_minute_prices\n49\tfrom synth_lib.preparation.config import STORE_SUBDIR\n50\tfrom synth_lib.preparation.event_calendar.events import CALENDAR_ENV, concerns\n51\t\n52\t# All paths are resolved from the location of THIS file, never from the cwd: the\n53\t# script therefore works whether launched from the workspace root (`uv run agent/predict.py`)\n54\t# or from agent/. The price snapshot is mounted at the workspace root, not inside agent/.\n55\tAGENT_DIR = Path(__file__).resolve().parent\n56\tWORKSPACE = AGENT_DIR.parent\n57\tsys.path.insert(0, str(AGENT_DIR))\n58\t\n59\tfrom modeling import simulate  # noqa: E402  (import after adding AGENT_DIR to sys.path)\n60\t\n61\tCONTEXT_MINUTES = 7 * 24 * 60\n62\t# Each run writes its predictions to its own directory under this one.\n63\tPREDICTIONS_ROOT = WORKSPACE / \"miner_outputs\" / \"campaign\"\n64\t# Must match synth_lib.backtester.config._OFFLINE_ENV_VAR.\n65\tOFFLINE_ROOT_ENV = \"SYNTH_BACKTESTER_OFFLINE_DATA_ROOT\"\n66\t# backtest()'s default miner_id: the rows of prompt_df that are yours.\n67\tCANDIDATE_ID = 999\n68\t\n69\t\n70\tdef ensure_workspace_cwd() -> None:\n71\t    \"\"\"Force the cwd to the workspace root.\n72\t\n73\t    NECESSARY: synth-lib's `backtest()` resolves the realized-price store via\n74\t    `MinutePriceStore(asset)` WITHOUT an explicit root (see `_price_store`), so it resolves\n75\t    relative to the cwd. Launched from agent/, it would look for `agent/market_data/`, find\n76\t    nothing, and attempt an `ingest_range` (download + write) against a snapshot mounted\n77\t    READ-ONLY — a cryptic error. The snapshot is mounted at the workspace root: we move there.\"\"\"\n78\t    os.chdir(WORKSPACE)\n79\t\n80\t\n81\tdef require_offline_bundle() -> None:\n82\t    \"\"\"Fails unless backtest() reads the field from the offline bundle.\n83\t\n84\t    backtest() reads scores and rewards a day past --eval-end; from the live API that is data from\n85\t    after your cutoff.\"\"\"\n86\t    if not os.environ.get(OFFLINE_ROOT_ENV):\n87\t        raise SystemExit(\n88\t            f\"{OFFLINE_ROOT_ENV} is not set, so backtest() would read the field from the live API, past \"\n89\t            f\"--eval-end. The harness points it at the bundle in your snapshot; restore it.\"\n90\t        )\n91\t\n92\t\n93\tdef store_root(asset: str) -> Path:\n94\t    \"\"\"Where this asset's partitions live inside the snapshot.\n95\t\n96\t    Resolved by synth-lib rather than hardcoded: the canonical directory is `market_data/prices/`,\n97\t    with a fallback to the legacy `market_data/pyth/` when that is what the snapshot contains. Do\n98\t    Anchored on WORKSPACE, not the cwd — synth-lib's default_store_root() resolves relative to the\n99\t    cwd, which would break the invariant this file relies on everywhere else.\"\"\"\n100\t    return WORKSPACE / \"market_data\" / STORE_SUBDIR / asset / \"1m\"\n101\t\n102\t\n103\tdef check_snapshot_coverage(asset: str, start: datetime, end: datetime) -> None:\n104\t    \"\"\"Fails EARLY and clearly if the requested window falls outside the frozen snapshot.\n105\t\n106\t    Without this guard, synth-lib would try to ingest the missing days (network + write) and\n107\t    the error would surface in an unreadable form.\"\"\"\n108\t    root = store_root(asset)\n109\t    missing = []\n110\t    cursor = start.date()\n111\t    while cursor <= end.date():\n112\t        if not (root / f\"date={cursor.isoformat()}.parquet\").exists():\n113\t            missing.append(cursor.isoformat())\n114\t        cursor += timedelta(days=1)\n115\t    if missing:\n116\t        raise SystemExit(\n117\t            f\"window outside snapshot for {asset}: missing partitions {missing[:5]}\"\n118\t            f\"{' …' if len(missing) > 5 else ''}\\n\"\n119\t            f\"The snapshot is frozen (read-only) and stops at the campaign's data_cutoff. \"\n120\t            f\"Reduce --eval-end / --days to stay within the available coverage ({root}).\"\n121\t        )\n122\t\n123\t\n124\tdef prompt_times(\n125\t    asset: str,\n126\t    end: datetime,\n127\t    days: int,\n128\t    time_length: int,\n129\t    time_increment: int,\n130\t    cadence_minutes: int | None = None,\n131\t) -> list[pd.Timestamp]:\n132\t    \"\"\"Start times of the prompts scored in the `days` before `end`: the validator's own, from the\n133\t    offline bundle, or every `cadence_minutes` over the same span.\"\"\"\n134\t    first = end - timedelta(days=days)\n135\t    if cadence_minutes is not None:\n136\t        horizon = timedelta(seconds=time_length)\n137\t        return list(pd.date_range(first - horizon, end - horizon, freq=f\"{cadence_minutes}min\", inclusive=\"left\"))\n138\t    scores = get_miner_scores(first, end, asset, time_length, time_increment)\n139\t    if scores.empty:\n140\t        raise SystemExit(\n141\t            f\"the offline bundle has no scored {asset} prompt for --time-length {time_length} in \"\n142\t            f\"{first.date()} → {end.date()} (DATA.md gives its span); --cadence-minutes answers a grid \"\n143\t            f\"instead, for CRPS only.\"\n144\t        )\n145\t    return sorted(pd.to_datetime(scores[\"start_time\"], utc=True).unique())\n146\t\n147\t\n148\tdef generate(\n149\t    asset: str,\n150\t    times: list[pd.Timestamp],\n151\t    out_dir: Path,\n152\t    time_increment: int = 300,\n153\t    time_length: int = 86_400,\n154\t    num_simulations: int = 1000,\n155\t) -> int:\n156\t    # The same loader the scored evaluation uses. NOT MinutePriceStore.load_range, which raises\n157\t    # on a single NaN close: an untraded minute is normal on the thin markets (42% of AAPLX\n158\t    # minutes never trade), so that loader cannot read 9 of the 13 assets at all. NaN reaches\n159\t    # simulate() untouched, which is the contract — never interpolate it away.\n160\t    prices = load_minute_prices(\n161\t        WORKSPACE / \"market_data\", asset, times[0] - pd.Timedelta(minutes=CONTEXT_MINUTES), times[-1]\n162\t    )\n163\t    out_dir.mkdir(parents=True, exist_ok=True)\n164\t    for t in times:\n165\t        # Never `prices.loc[:t]` — see the module docstring. Same cut the scored evaluation uses.\n166\t        context = prices.loc[: context_end(t, time_length)][-CONTEXT_MINUTES:]\n167\t        out = simulate(\n168\t            asset=asset,\n169\t            start_time=t.isoformat(),\n170\t            time_increment=time_increment,\n171\t            time_length=time_length,\n172\t            num_simulations=num_simulations,\n173\t            context_prices=context,\n174\t        )\n175\t        paths = [list(map(float, p)) for p in out[2:]]\n176\t        record = {\n177\t            \"start_timestamp\": t.isoformat(),\n178\t            \"asset\": asset,\n179\t            \"time_increment\": time_increment,\n180\t            \"time_length\": time_length,\n181\t            \"num_simulations\": len(paths),\n182\t            \"num_steps\": len(paths[0]),\n183\t            \"paths\": paths,\n184\t        }\n185\t        name = t.strftime(\"%Y-%m-%d_%H:%M:%SZ\") + f\"_{asset}_{time_length}.json\"\n186\t        (out_dir / name).write_text(json.dumps(record))\n187\t    return len(times)\n188\t\n189\t\n190\tdef print_event_split(prompts: pd.DataFrame, asset: str, time_length: int) -> None:\n191\t    \"\"\"Your gap to each prompt's best miner, over the prompts whose horizon holds an event of each type\n192\t    and over the prompts that hold none.\"\"\"\n193\t    path = Path(os.environ[CALENDAR_ENV])\n194\t    if not path.exists():\n195\t        return\n196\t    view = pd.read_parquet(path)\n197\t    view = view[concerns(view, asset)]\n198\t    scored = prompts[prompts[\"crps\"] > 0]  # -1 marks a prompt the backtester could not score\n199\t    best = scored.groupby([\"asset\", \"scored_time\"])[\"crps\"].min().rename(\"best\")\n200\t    ours = scored[scored[\"miner_id\"] == CANDIDATE_ID].join(best, on=[\"asset\", \"scored_time\"])\n201\t    if ours.empty:\n202\t        return\n203\t    gap = ours[\"crps\"].to_numpy() / ours[\"best\"].to_numpy() - 1\n204\t    starts = pd.to_datetime(ours[\"start_time\"], utc=True).dt.tz_localize(None).to_numpy()\n205\t    ends = starts + np.timedelta64(time_length, \"s\")\n206\t    spans_any = np.zeros(len(ours), dtype=bool)\n207\t    lines = []\n208\t    for event, rows in view.groupby(\"event\"):\n209\t        times = np.sort(pd.to_datetime(rows[\"time_utc\"], utc=True).dt.tz_localize(None).to_numpy())\n210\t        at = np.searchsorted(times, starts)\n211\t        spans = (at < len(times)) & (times[np.minimum(at, len(times) - 1)] < ends)\n212\t        spans_any |= spans\n213\t        if spans.any():\n214\t            lines.append(f\"  {event:<17} {spans.sum():5d} prompts  gap {gap[spans].mean():+.2%}\")\n215\t    if not spans_any.all():\n216\t        lines.insert(0, f\"  {'no event':<17} {(~spans_any).sum():5d} prompts  gap {gap[~spans_any].mean():+.2%}\")\n217\t    print(\"event split (mean gap to each prompt's best miner):\")\n218\t    print(\"\\n\".join(lines))\n219\t\n220\t\n221\tdef main() -> None:\n222\t    ap = argparse.ArgumentParser()\n223\t    ap.add_argument(\"--asset\", default=\"BTC\")\n224\t    ap.add_argument(\"--days\", type=int, default=3)\n225\t    ap.add_argument(\"--eval-end\", required=True, help=\"YYYY-MM-DD, at most the snapshot's last day\")\n226\t    ap.add_argument(\"--time-increment\", type=int, default=300, help=\"seconds between points (60 for CRYPTO_1H)\")\n227\t    ap.add_argument(\"--time-length\", type=int, default=86_400, help=\"horizon in seconds (3600 for CRYPTO_1H)\")\n228\t    ap.add_argument(\n229\t        \"--num-simulations\",\n230\t        type=int,\n231\t        default=1000,\n232\t        help=\"Paths per prompt. The validator uses 1000; lowering this speeds up iteration at \"\n233\t        \"the cost of a slightly pessimistic CRPS (empirical CRPS is biased upward for fewer \"\n234\t        \"sampled paths, and the real field's CRPS was computed at 1000).\",\n235\t    )\n236\t    ap.add_argument(\n237\t        \"--cadence-minutes\",\n238\t        type=int,\n239\t        default=None,\n240\t        help=\"answer an even grid every N minutes instead of the validator's own start times. A \"\n241\t        \"cadence that divides an hour puts every prompt on the round hour\",\n242\t    )\n243\t    ap.add_argument(\n244\t        \"--latest-formula\",\n245\t        action=\"store_true\",\n246\t        help=\"score every crypto-1h prompt with the volatility term, as prompts are scored now, \"\n247\t        \"including those scored before it went live. Field ranks before that day then compare \"\n248\t        \"two formulas; CRPS does not\",\n249\t    )\n250\t    ap.add_argument(\"--keep-predictions\", action=\"store_true\", help=\"keep this run's prediction files\")\n251\t    args = ap.parse_args()\n252\t    require_offline_bundle()\n253\t    ensure_workspace_cwd()\n254\t    end = datetime.fromisoformat(args.eval_end).replace(tzinfo=timezone.utc)\n255\t    times = prompt_times(\n256\t        args.asset, end, args.days, args.time_length, args.time_increment, cadence_minutes=args.cadence_minutes\n257\t    )\n258\t    # the context reaches back 7 days before the first prompt: coverage must extend that far\n259\t    check_snapshot_coverage(args.asset, times[0] - timedelta(minutes=CONTEXT_MINUTES), end)\n260\t    PREDICTIONS_ROOT.mkdir(parents=True, exist_ok=True)\n261\t    out_dir = Path(tempfile.mkdtemp(prefix=\"run-\", dir=PREDICTIONS_ROOT))\n262\t    try:\n263\t        n = generate(\n264\t            args.asset,\n265\t            times,\n266\t            out_dir,\n267\t            time_increment=args.time_increment,\n268\t            time_length=args.time_length,\n269\t            num_simulations=args.num_simulations,\n270\t        )\n271\t        print(f\"predictions generated: {n}\")\n272\t        result = backtest(\n273\t            miner_name=\"campaign\",\n274\t            asset=args.asset,\n275\t            time_length=args.time_length,\n276\t            time_increment=args.time_increment,\n277\t            n_backtest_days=args.days,\n278\t            predictions_dir=out_dir,\n279\t            eval_end=end,\n280\t            latest_formula=args.latest_formula,\n281\t            match_tolerance_minutes=args.cadence_minutes or PREDICTION_MATCH_TOLERANCE_MINUTES,\n282\t        )\n283\t        print(\"summary:\", result.summary)\n284\t        if os.environ.get(CALENDAR_ENV):\n285\t            print_event_split(result.prompt_df, args.asset, args.time_length)\n286\t    finally:\n287\t        if args.keep_predictions:\n288\t            print(f\"predictions kept in {out_dir}\")\n289\t        else:\n290\t            shutil.rmtree(out_dir, ignore_errors=True)\n291\t\n292\t\n293\tif __name__ == \"__main__\":\n294\t    main()\n295\t"}]},"parent_tool_use_id":null,"session_id":"7c4d1346-5ef5-4ae8-af7f-555535414d85","uuid":"dcc009b4-3699-404d-84c3-0652cbd278d3","timestamp":"2026-10-22T13:31:54.875Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/agent/predict.py","content":"\"\"\"Self-evaluation via the official synth-lib backtester.\n\nUsage: uv run agent/predict.py --asset BTC --days 3 --eval-end 2026-07-15\nAnswers, with agent/modeling.py, the prompts the validator scored in the --days before --eval-end,\nat the start times it actually used (read from the offline field bundle), then scores them with\nbacktest() (validator CRPS + rank vs the real field, from the same bundle). A prompt is scored one\nhorizon after it starts, so generation begins one horizon before the scored days.\n--cadence-minutes N answers an even grid over the same span instead; each scored prompt is then\nanswered by the grid point at or before it.\n\nWorks on every asset, including the ones whose minutes do not all trade. Prices load through the\nsame lenient path the scored evaluation uses, so a NaN close reaches simulate() rather than\nstopping the run — your model must tolerate them (drop, never interpolate).\n\nWhen the snapshot carries an event calendar ($SYNTH_BENCHMARK_CALENDAR), the summary is followed by\nyour gap to each prompt's best miner, over the prompts whose horizon holds an event of each type and\nover those that hold none: where an event costs you, that gap is wider.\n\n--num-simulations defaults to 1000, matching the validator's real serving size\n(PromptConfig.num_simulations). Lowering it (e.g. for a quick local iteration loop) speeds up\ngeneration at the cost of a slightly pessimistic CRPS: empirical CRPS is biased upward for\nfewer sampled paths, and the real field's CRPS was computed at 1000.\n\nThe context a prompt gets ends BEFORE its start_time, and that is not an off-by-one. The store\nlabels a minute bar by its OPEN time, so the bar labelled t closes at t+60s — and that close is\nthe first point the prompt is scored against. A prompt is also issued before the start_time it is\nscored from (ISSUANCE_LEAD_SECONDS). Ending the context at t would hand the model the answer to\nits own first step, and a model tuned that way is optimising a problem it will not be scored on.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport shutil\nimport sys\nimport tempfile\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\nfrom synth_lib.backtester.config import PREDICTION_MATCH_TOLERANCE_MINUTES\nfrom synth_lib.backtester.loading import get_miner_scores\nfrom synth_lib.backtester.orchestration import backtest\nfrom synth_lib.benchmark.generate_predictions import context_end, load_minute_prices\nfrom synth_lib.preparation.config import STORE_SUBDIR\nfrom synth_lib.preparation.event_calendar.events import CALENDAR_ENV, concerns\n\n# All paths are resolved from the location of THIS file, never from the cwd: the\n# script therefore works whether launched from the workspace root (`uv run agent/predict.py`)\n# or from agent/. The price snapshot is mounted at the workspace root, not inside agent/.\nAGENT_DIR = Path(__file__).resolve().parent\nWORKSPACE = AGENT_DIR.parent\nsys.path.insert(0, str(AGENT_DIR))\n\nfrom modeling import simulate  # noqa: E402  (import after adding AGENT_DIR to sys.path)\n\nCONTEXT_MINUTES = 7 * 24 * 60\n# Each run writes its predictions to its own directory under this one.\nPREDICTIONS_ROOT = WORKSPACE / \"miner_outputs\" / \"campaign\"\n# Must match synth_lib.backtester.config._OFFLINE_ENV_VAR.\nOFFLINE_ROOT_ENV = \"SYNTH_BACKTESTER_OFFLINE_DATA_ROOT\"\n# backtest()'s default miner_id: the rows of prompt_df that are yours.\nCANDIDATE_ID = 999\n\n\ndef ensure_workspace_cwd() -> None:\n    \"\"\"Force the cwd to the workspace root.\n\n    NECESSARY: synth-lib's `backtest()` resolves the realized-price store via\n    `MinutePriceStore(asset)` WITHOUT an explicit root (see `_price_store`), so it resolves\n    relative to the cwd. Launched from agent/, it would look for `agent/market_data/`, find\n    nothing, and attempt an `ingest_range` (download + write) against a snapshot mounted\n    READ-ONLY — a cryptic error. The snapshot is mounted at the workspace root: we move there.\"\"\"\n    os.chdir(WORKSPACE)\n\n\ndef require_offline_bundle() -> None:\n    \"\"\"Fails unless backtest() reads the field from the offline bundle.\n\n    backtest() reads scores and rewards a day past --eval-end; from the live API that is data from\n    after your cutoff.\"\"\"\n    if not os.environ.get(OFFLINE_ROOT_ENV):\n        raise SystemExit(\n            f\"{OFFLINE_ROOT_ENV} is not set, so backtest() would read the field from the live API, past \"\n            f\"--eval-end. The harness points it at the bundle in your snapshot; restore it.\"\n        )\n\n\ndef store_root(asset: str) -> Path:\n    \"\"\"Where this asset's partitions live inside the snapshot.\n\n    Resolved by synth-lib rather than hardcoded: the canonical directory is `market_data/prices/`,\n    with a fallback to the legacy `market_data/pyth/` when that is what the snapshot contains. Do\n    Anchored on WORKSPACE, not the cwd — synth-lib's default_store_root() resolves relative to the\n    cwd, which would break the invariant this file relies on everywhere else.\"\"\"\n    return WORKSPACE / \"market_data\" / STORE_SUBDIR / asset / \"1m\"\n\n\ndef check_snapshot_coverage(asset: str, start: datetime, end: datetime) -> None:\n    \"\"\"Fails EARLY and clearly if the requested window falls outside the frozen snapshot.\n\n    Without this guard, synth-lib would try to ingest the missing days (network + write) and\n    the error would surface in an unreadable form.\"\"\"\n    root = store_root(asset)\n    missing = []\n    cursor = start.date()\n    while cursor <= end.date():\n        if not (root / f\"date={cursor.isoformat()}.parquet\").exists():\n            missing.append(cursor.isoformat())\n        cursor += timedelta(days=1)\n    if missing:\n        raise SystemExit(\n            f\"window outside snapshot for {asset}: missing partitions {missing[:5]}\"\n            f\"{' …' if len(missing) > 5 else ''}\\n\"\n            f\"The snapshot is frozen (read-only) and stops at the campaign's data_cutoff. \"\n            f\"Reduce --eval-end / --days to stay within the available coverage ({root}).\"\n        )\n\n\ndef prompt_times(\n    asset: str,\n    end: datetime,\n    days: int,\n    time_length: int,\n    time_increment: int,\n    cadence_minutes: int | None = None,\n) -> list[pd.Timestamp]:\n    \"\"\"Start times of the prompts scored in the `days` before `end`: the validator's own, from the\n    offline bundle, or every `cadence_minutes` over the same span.\"\"\"\n    first = end - timedelta(days=days)\n    if cadence_minutes is not None:\n        horizon = timedelta(seconds=time_length)\n        return list(pd.date_range(first - horizon, end - horizon, freq=f\"{cadence_minutes}min\", inclusive=\"left\"))\n    scores = get_miner_scores(first, end, asset, time_length, time_increment)\n    if scores.empty:\n        raise SystemExit(\n            f\"the offline bundle has no scored {asset} prompt for --time-length {time_length} in \"\n            f\"{first.date()} → {end.date()} (DATA.md gives its span); --cadence-minutes answers a grid \"\n            f\"instead, for CRPS only.\"\n        )\n    return sorted(pd.to_datetime(scores[\"start_time\"], utc=True).unique())\n\n\ndef generate(\n    asset: str,\n    times: list[pd.Timestamp],\n    out_dir: Path,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n) -> int:\n    # The same loader the scored evaluation uses. NOT MinutePriceStore.load_range, which raises\n    # on a single NaN close: an untraded minute is normal on the thin markets (42% of AAPLX\n    # minutes never trade), so that loader cannot read 9 of the 13 assets at all. NaN reaches\n    # simulate() untouched, which is the contract — never interpolate it away.\n    prices = load_minute_prices(\n        WORKSPACE / \"market_data\", asset, times[0] - pd.Timedelta(minutes=CONTEXT_MINUTES), times[-1]\n    )\n    out_dir.mkdir(parents=True, exist_ok=True)\n    for t in times:\n        # Never `prices.loc[:t]` — see the module docstring. Same cut the scored evaluation uses.\n        context = prices.loc[: context_end(t, time_length)][-CONTEXT_MINUTES:]\n        out = simulate(\n            asset=asset,\n            start_time=t.isoformat(),\n            time_increment=time_increment,\n            time_length=time_length,\n            num_simulations=num_simulations,\n            context_prices=context,\n        )\n        paths = [list(map(float, p)) for p in out[2:]]\n        record = {\n            \"start_timestamp\": t.isoformat(),\n            \"asset\": asset,\n            \"time_increment\": time_increment,\n            \"time_length\": time_length,\n            \"num_simulations\": len(paths),\n            \"num_steps\": len(paths[0]),\n            \"paths\": paths,\n        }\n        name = t.strftime(\"%Y-%m-%d_%H:%M:%SZ\") + f\"_{asset}_{time_length}.json\"\n        (out_dir / name).write_text(json.dumps(record))\n    return len(times)\n\n\ndef print_event_split(prompts: pd.DataFrame, asset: str, time_length: int) -> None:\n    \"\"\"Your gap to each prompt's best miner, over the prompts whose horizon holds an event of each type\n    and over the prompts that hold none.\"\"\"\n    path = Path(os.environ[CALENDAR_ENV])\n    if not path.exists():\n        return\n    view = pd.read_parquet(path)\n    view = view[concerns(view, asset)]\n    scored = prompts[prompts[\"crps\"] > 0]  # -1 marks a prompt the backtester could not score\n    best = scored.groupby([\"asset\", \"scored_time\"])[\"crps\"].min().rename(\"best\")\n    ours = scored[scored[\"miner_id\"] == CANDIDATE_ID].join(best, on=[\"asset\", \"scored_time\"])\n    if ours.empty:\n        return\n    gap = ours[\"crps\"].to_numpy() / ours[\"best\"].to_numpy() - 1\n    starts = pd.to_datetime(ours[\"start_time\"], utc=True).dt.tz_localize(None).to_numpy()\n    ends = starts + np.timedelta64(time_length, \"s\")\n    spans_any = np.zeros(len(ours), dtype=bool)\n    lines = []\n    for event, rows in view.groupby(\"event\"):\n        times = np.sort(pd.to_datetime(rows[\"time_utc\"], utc=True).dt.tz_localize(None).to_numpy())\n        at = np.searchsorted(times, starts)\n        spans = (at < len(times)) & (times[np.minimum(at, len(times) - 1)] < ends)\n        spans_any |= spans\n        if spans.any():\n            lines.append(f\"  {event:<17} {spans.sum():5d} prompts  gap {gap[spans].mean():+.2%}\")\n    if not spans_any.all():\n        lines.insert(0, f\"  {'no event':<17} {(~spans_any).sum():5d} prompts  gap {gap[~spans_any].mean():+.2%}\")\n    print(\"event split (mean gap to each prompt's best miner):\")\n    print(\"\\n\".join(lines))\n\n\ndef main() -> None:\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--asset\", default=\"BTC\")\n    ap.add_argument(\"--days\", type=int, default=3)\n    ap.add_argument(\"--eval-end\", required=True, help=\"YYYY-MM-DD, at most the snapshot's last day\")\n    ap.add_argument(\"--time-increment\", type=int, default=300, help=\"seconds between points (60 for CRYPTO_1H)\")\n    ap.add_argument(\"--time-length\", type=int, default=86_400, help=\"horizon in seconds (3600 for CRYPTO_1H)\")\n    ap.add_argument(\n        \"--num-simulations\",\n        type=int,\n        default=1000,\n        help=\"Paths per prompt. The validator uses 1000; lowering this speeds up iteration at \"\n        \"the cost of a slightly pessimistic CRPS (empirical CRPS is biased upward for fewer \"\n        \"sampled paths, and the real field's CRPS was computed at 1000).\",\n    )\n    ap.add_argument(\n        \"--cadence-minutes\",\n        type=int,\n        default=None,\n        help=\"answer an even grid every N minutes instead of the validator's own start times. A \"\n        \"cadence that divides an hour puts every prompt on the round hour\",\n    )\n    ap.add_argument(\n        \"--latest-formula\",\n        action=\"store_true\",\n        help=\"score every crypto-1h prompt with the volatility term, as prompts are scored now, \"\n        \"including those scored before it went live. Field ranks before that day then compare \"\n        \"two formulas; CRPS does not\",\n    )\n    ap.add_argument(\"--keep-predictions\", action=\"store_true\", help=\"keep this run's prediction files\")\n    args = ap.parse_args()\n    require_offline_bundle()\n    ensure_workspace_cwd()\n    end = datetime.fromisoformat(args.eval_end).replace(tzinfo=timezone.utc)\n    times = prompt_times(\n        args.asset, end, args.days, args.time_length, args.time_increment, cadence_minutes=args.cadence_minutes\n    )\n    # the context reaches back 7 days before the first prompt: coverage must extend that far\n    check_snapshot_coverage(args.asset, times[0] - timedelta(minutes=CONTEXT_MINUTES), end)\n    PREDICTIONS_ROOT.mkdir(parents=True, exist_ok=True)\n    out_dir = Path(tempfile.mkdtemp(prefix=\"run-\", dir=PREDICTIONS_ROOT))\n    try:\n        n = generate(\n            args.asset,\n            times,\n            out_dir,\n            time_increment=args.time_increment,\n            time_length=args.time_length,\n            num_simulations=args.num_simulations,\n        )\n        print(f\"predictions generated: {n}\")\n        result = backtest(\n            miner_name=\"campaign\",\n            asset=args.asset,\n            time_length=args.time_length,\n            time_increment=args.time_increment,\n            n_backtest_days=args.days,\n            predictions_dir=out_dir,\n            eval_end=end,\n            latest_formula=args.latest_formula,\n            match_tolerance_minutes=args.cadence_minutes or PREDICTION_MATCH_TOLERANCE_MINUTES,\n        )\n        print(\"summary:\", result.summary)\n        if os.environ.get(CALENDAR_ENV):\n            print_event_split(result.prompt_df, args.asset, args.time_length)\n    finally:\n        if args.keep_predictions:\n            print(f\"predictions kept in {out_dir}\")\n        else:\n            shutil.rmtree(out_dir, ignore_errors=True)\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":295,"startLine":1,"totalLines":295}}}
