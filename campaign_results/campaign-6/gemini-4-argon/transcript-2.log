{"type":"tool_use","timestamp":"2026-10-22T11:59:06.046Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_139617","parameters":{"command":"uv run python -c '\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth.validator.crps_calculation import (\n    calculate_crps_for_miner,\n    SCORING_INTERVALS,\n    HIGH_FREQUENCY_SCORING_INTERVALS,\n    HIGH_FREQUENCY_VOLATILITY_INTERVALS,\n    VOL_CRPS_LAMBDA,\n)\nfrom synth_lib.backtester.realized_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nimport sys\nsys.path.insert(0, \"agent\")\nfrom modeling import simulate\n\nWORKSPACE = Path(\"/workspace\")\nrstore = RealizedPathStore()\n\ndef analyze_comp(assets, tl, ti, n_sims=200, step_hours=12):\n    times = list(pd.date_range(\"2026-07-16\", \"2026-09-13\", freq=f\"{step_hours}h\", tz=\"UTC\"))\n    mid_t = pd.Timestamp(\"2026-08-15\", tz=\"UTC\")\n    for asset in assets:\n        prices = load_minute_prices(WORKSPACE / \"market_data\", asset, times[0] - pd.Timedelta(days=7), times[-1] + pd.Timedelta(seconds=tl))\n        int_crps = {1: {}, 2: {}}\n        for t in times:\n            realized = rstore.get(asset, t.to_pydatetime(), tl, ti)\n            if realized is None or np.all(np.isnan(realized)):\n                continue\n            ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, tl)]\n            out = simulate(asset, t.isoformat(), ti, tl, n_sims, ctx)\n            paths = np.asarray(out[2:], dtype=np.float32)\n            tot, details = calculate_crps_for_miner(paths, realized, ti, None if tl > 3600 else HIGH_FREQUENCY_SCORING_INTERVALS, True if tl <= 3600 else False)\n            h = 1 if t < mid_t else 2\n            for d in details:\n                if d[\"total_crps\"] > 0:\n                    int_crps[h].setdefault(d[\"interval\"], []).append(d[\"total_crps\"])\n        print(f\"=== {asset} (tl={tl}) ===\")\n        all_k = list(int_crps[1].keys())\n        s1 = sum(np.mean(int_crps[1][k]) for k in all_k)\n        s2 = sum(np.mean(int_crps[2][k]) for k in all_k)\n        print(f\"  Total H1={s1:.2f}  H2={s2:.2f}\")\n        for k in all_k:\n            m1 = np.mean(int_crps[1][k])\n            m2 = np.mean(int_crps[2][k])\n            print(f\"    {k:<16} H1={m1:8.2f} ({m1/s1*100:4.1f}%)  H2={m2:8.2f} ({m2/s2*100:4.1f}%)\")\n\nanalyze_comp([\"BTC\", \"SOL\", \"HYPE\"], 3600, 60, n_sims=200, step_hours=12)\nanalyze_comp([\"BTC\", \"SOL\", \"XAU\", \"NVDAX\", \"SP500\"], 86400, 300, n_sims=200, step_hours=24)\n'","description":"Analyze per-interval CRPS share across H1 and H2 on pre-validation data"}}
