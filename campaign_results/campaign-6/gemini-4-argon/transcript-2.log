{"type":"tool_use","timestamp":"2026-10-22T12:20:34.178Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_187192","parameters":{"command":"uv run python -c '\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.backtester.preparation import _slice_real_prices, _has_missing_prices\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nimport sys\nsys.path.insert(0, \"agent\")\nimport modeling as mod\n\nWORKSPACE = Path(\"/workspace\")\n\ndef hierarchical_secant(shocks_inc, eta_sub=1.0, n_sub=48, eta_blk=1.0, n_blks=8, eta_tot=1.0):\n    out = shocks_inc.copy()\n    if abs(eta_sub - 1.0) > 1e-6 and out.shape[1] >= n_sub:\n        s_len = out.shape[1] // n_sub\n        for s in range(n_sub):\n            sl = slice(s * s_len, (s + 1) * s_len)\n            sub = out[:, sl]\n            s2 = np.var(sub, axis=0)\n            w = s2 / max(float(np.sum(s2)), 1e-12)\n            s_sum = np.sum(sub, axis=1, keepdims=True)\n            out[:, sl] = sub + (eta_sub - 1.0) * s_sum * w[None, :]\n    eff_blk = eta_blk / eta_sub if eta_sub != 0 else eta_blk\n    if abs(eff_blk - 1.0) > 1e-6 and out.shape[1] >= n_blks:\n        b_len = out.shape[1] // n_blks\n        for b in range(n_blks):\n            sl = slice(b * b_len, (b + 1) * b_len)\n            sub = out[:, sl]\n            s2 = np.var(sub, axis=0)\n            w = s2 / max(float(np.sum(s2)), 1e-12)\n            b_sum = np.sum(sub, axis=1, keepdims=True)\n            out[:, sl] = sub + (eff_blk - 1.0) * b_sum * w[None, :]\n    eff_tot = eta_tot / eta_blk if eta_blk != 0 else eta_tot\n    if abs(eff_tot - 1.0) > 1e-6:\n        s2 = np.var(out, axis=0)\n        w = s2 / max(float(np.sum(s2)), 1e-12)\n        t_sum = np.sum(out, axis=1, keepdims=True)\n        out = out + (eff_tot - 1.0) * t_sum * w[None, :]\n    return out\n\nfor comp, assets, freq, n_sims in [\n    (CRYPTO_24H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], \"23h\", 1000),\n    (CRYPTO_1H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], \"17h\", 1000),\n]:\n    all_times = list(pd.date_range(\"2026-07-16 00:15:00\", \"2026-09-13 00:00:00\", freq=freq, tz=\"UTC\"))\n    mid_t = pd.Timestamp(\"2026-08-15\", tz=\"UTC\")\n    tl, ti = comp.time_length, comp.time_increment\n    n_inc = tl // ti\n    for asset in assets:\n        _, sig_path_vv, sig_step_vv = mod._distribution_params(asset, tl)\n        prices = load_minute_prices(WORKSPACE / \"market_data\", asset, all_times[0] - pd.Timedelta(days=7), all_times[-1] + pd.Timedelta(seconds=tl))\n        rstore = RealizedPathStore(asset, tl, ti)\n        res = {m: {1: [], 2: []} for m in [\"base\", \"pre_col_std\", \"hier_sec\", \"both\"]}\n        for t in all_times:\n            rp = _slice_real_prices(prices, t, tl, ti)\n            if _has_missing_prices(rp):\n                s = rstore.get(t.to_pydatetime())\n                if s is not None and len(s) == len(rp):\n                    rp = s.to_list()\n            realized = np.asarray(rp, dtype=np.float64)\n            if np.mean(np.isfinite(realized)) < 0.8:\n                continue\n            ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, tl)]\n            out_base = mod.simulate(asset, t.isoformat(), ti, tl, n_sims, ctx)\n            paths_base = np.asarray(out_base[2:], dtype=np.float64)\n            p0 = paths_base[0, 0]\n            shocks_base = np.diff(np.log(paths_base), axis=1)\n\n            # Reconstruct exact z_base and z_pre\n            rng = mod._make_rng(asset, t.isoformat(), tl)\n            half = n_sims // 2\n            eps = rng.standard_normal((half, n_inc))\n            eta = rng.standard_normal((half, n_inc))\n            eps_s = eps * np.exp(sig_step_vv * eta - 0.5 * sig_step_vv**2)\n            q_z = mod._stratified_normal_quantiles(half)\n            m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv**2)[:, None]\n\n            z_post = np.vstack([eps_s * m_half, -eps_s * m_half])\n            z_post = z_post / np.std(z_post, axis=0, keepdims=True)\n\n            z_pre0 = np.vstack([eps_s, -eps_s])\n            z_pre0 = z_pre0 / np.std(z_pre0, axis=0, keepdims=True)\n            m_full = np.vstack([m_half, m_half]) / float(np.sqrt(np.mean(m_half**2)))\n            z_pre = z_pre0 * m_full\n\n            # Extract per_step_sigma before secant\n            if tl <= 3600:\n                # In 1h base, _apply_secant_shocks(z_post * ps_sig, 1.0, 0.95, 4) was called (except ETH)\n                # Easier: temporarily call mod._apply_secant_shocks on z_post to get ratio, or recover ps_sig from shocks_base\n                z_post_sec = mod._apply_secant_shocks(z_post, 1.0, 0.95, 4) if asset != \"ETH\" else z_post\n                ps_sig = np.std(shocks_base, axis=0, keepdims=True) / np.std(z_post_sec, axis=0, keepdims=True)\n            else:\n                ps_sig = np.std(shocks_base, axis=0, keepdims=True)\n\n            h = 1 if t < mid_t else 2\n            for m in [\"base\", \"pre_col_std\", \"hier_sec\", \"both\"]:\n                if m == \"base\":\n                    paths = paths_base.astype(np.float32)\n                else:\n                    z_use = z_pre if m in (\"pre_col_std\", \"both\") else z_post\n                    sh = z_use * ps_sig\n                    if m in (\"hier_sec\", \"both\"):\n                        if tl <= 3600:\n                            if asset == \"HYPE\":\n                                sh = hierarchical_secant(sh, 1.02, 12, 0.99, 4, 1.04)\n                            elif asset == \"ETH\":\n                                sh = hierarchical_secant(sh, 1.01, 12, 0.98, 4, 1.03)\n                            else:\n                                sh = hierarchical_secant(sh, 1.00, 12, 0.96, 4, 1.02)\n                        else:\n                            if asset == \"HYPE\":\n                                sh = hierarchical_secant(sh, 0.98, 48, 0.96, 8, 1.03)\n                            else:\n                                sh = hierarchical_secant(sh, 0.96, 48, 0.93, 8, 1.00)\n                    else:\n                        if tl <= 3600 and asset != \"ETH\":\n                            sh = mod._apply_secant_shocks(sh, 1.0, 0.95, 4)\n                    paths = np.empty_like(paths_base, dtype=np.float32)\n                    paths[:, 0] = p0\n                    paths[:, 1:] = (p0 * np.exp(np.cumsum(sh, axis=1))).astype(np.float32)\n                sc, _ = calculate_total_score_for_miner(paths, realized, ti, comp.scoring_intervals, comp.vol_scoring_blocks)\n                if sc > 0:\n                    res[m][h].append(sc)\n        b1, b2 = np.mean(res[\"base\"][1]), np.mean(res[\"base\"][2])\n        print(f\"=== {asset} ({comp.label}, N=1000) base H1={b1:.2f} H2={b2:.2f} ===\")\n        for m in [\"pre_col_std\", \"hier_sec\", \"both\"]:\n            m1, m2 = np.mean(res[m][1]), np.mean(res[m][2])\n            print(f\"  {m:<14} dH1={m1-b1:+6.2f}  dH2={m2-b2:+6.2f}  dMean={0.5*(m1+m2-b1-b2):+6.2f}\")\n'","description":"Test pre_col_std and hier_sec at N=1000 on CRYPTO_24H and CRYPTO_1H across H1 and H2 pre-validation splits"}}
