{"type":"tool_use","timestamp":"2026-10-22T12:16:01.337Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_174093","parameters":{"description":"Test pre_col_std and blk_vv_0.12 on CRYPTO_1H and CRYPTO_24H across H1 and H2 pre-validation splits","command":"uv run python -c '\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.backtester.preparation import _slice_real_prices, _has_missing_prices\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nimport sys\nsys.path.insert(0, \"agent\")\nimport modeling as mod\n\nWORKSPACE = Path(\"/workspace\")\n\ndef gen_z_variants( asset, start_time, time_length, num_simulations, n_inc, sig_path_vv, sig_step_vv, mode=\"base\"):\n    rng = mod._make_rng(asset, start_time, time_length)\n    half = num_simulations // 2\n    eps = rng.standard_normal((half, n_inc))\n    if sig_step_vv > 0.0:\n        eta = rng.standard_normal((half, n_inc))\n        eps = eps * np.exp(sig_step_vv * eta - 0.5 * sig_step_vv * sig_step_vv)\n    if mode == \"pre_col_std\":\n        # Standardize base step shocks before applying stratified path multipliers\n        z_base = np.vstack([eps, -eps])\n        c_std = np.std(z_base, axis=0, keepdims=True)\n        eps = eps / np.where(c_std > 1e-8, c_std, 1.0)\n        q_z = mod._stratified_normal_quantiles(half)\n        m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv * sig_path_vv)[:, None]\n        m_rms = float(np.sqrt(np.mean(m_half ** 2)))\n        eps = eps * (m_half / m_rms)\n        z = np.vstack([eps, -eps])\n        return z\n    elif mode == \"blk_vv_0.12\":\n        n_b = 4 if n_inc == 60 else 8\n        b_len = n_inc // n_b\n        eta_b = rng.standard_normal((half, n_b))\n        sb = 0.12\n        m_b = np.repeat(np.exp(sb * eta_b - 0.5 * sb * sb), b_len, axis=1)\n        eps = eps * m_b\n        if sig_path_vv > 0.0:\n            sp = np.sqrt(max(sig_path_vv**2 - sb**2, 0.01))\n            q_z = mod._stratified_normal_quantiles(half)\n            m_half = np.exp(sp * q_z - 0.5 * sp * sp)[:, None]\n            eps = eps * m_half\n        z = np.vstack([eps, -eps])\n        col_std = np.std(z, axis=0, keepdims=True)\n        return z / np.where(col_std > 1e-8, col_std, 1.0)\n    else:\n        if sig_path_vv > 0.0:\n            q_z = mod._stratified_normal_quantiles(half)\n            m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv * sig_path_vv)[:, None]\n            eps = eps * m_half\n        z = np.vstack([eps, -eps])\n        col_std = np.std(z, axis=0, keepdims=True)\n        return z / np.where(col_std > 1e-8, col_std, 1.0)\n\nfor comp, assets, freq in [(CRYPTO_1H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], \"11h\"), (CRYPTO_24H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], \"17h\")]:\n    all_times = list(pd.date_range(\"2026-07-16 00:15:00\", \"2026-09-13 00:00:00\", freq=freq, tz=\"UTC\"))\n    mid_t = pd.Timestamp(\"2026-08-15\", tz=\"UTC\")\n    tl, ti = comp.time_length, comp.time_increment\n    n_inc = tl // ti\n    _, sig_path_vv, sig_step_vv = mod._distribution_params(assets[0], tl)\n    for asset in assets:\n        prices = load_minute_prices(WORKSPACE / \"market_data\", asset, all_times[0] - pd.Timedelta(days=7), all_times[-1] + pd.Timedelta(seconds=tl))\n        rstore = RealizedPathStore(asset, tl, ti)\n        res = {m: {1: [], 2: []} for m in [\"base\", \"pre_col_std\", \"blk_vv_0.12\"]}\n        for t in all_times:\n            rp = _slice_real_prices(prices, t, tl, ti)\n            if _has_missing_prices(rp):\n                s = rstore.get(t.to_pydatetime())\n                if s is not None and len(s) == len(rp):\n                    rp = s.to_list()\n            realized = np.asarray(rp, dtype=np.float64)\n            if np.mean(np.isfinite(realized)) < 0.8:\n                continue\n            ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, tl)]\n            out_base = mod.simulate(asset, t.isoformat(), ti, tl, 200, ctx)\n            paths_base = np.asarray(out_base[2:], dtype=np.float64)\n            p0 = paths_base[0, 0]\n            # extract per_step_sigma from base before secant by running gen_z_variants\n            z_b = gen_z_variants(asset, t.isoformat(), tl, 200, n_inc, sig_path_vv, sig_step_vv, \"base\")\n            shocks_base = np.diff(np.log(paths_base), axis=1)\n            # wait: for 1h, base applied secant, so get per_step_sigma from std of shocks_base\n            ps_sig = np.std(shocks_base, axis=0, keepdims=True)\n            h = 1 if t < mid_t else 2\n            for m in [\"base\", \"pre_col_std\", \"blk_vv_0.12\"]:\n                if m == \"base\":\n                    paths = paths_base.astype(np.float32)\n                else:\n                    z_m = gen_z_variants(asset, t.isoformat(), tl, 200, n_inc, sig_path_vv, sig_step_vv, m)\n                    sh = z_m * ps_sig\n                    if tl <= 3600 and asset != \"ETH\":\n                        sh = mod._apply_secant_shocks(sh, eta_tot=1.0, eta_blk=0.95, n_blks=4)\n                    paths = np.empty_like(paths_base, dtype=np.float32)\n                    paths[:, 0] = p0\n                    paths[:, 1:] = (p0 * np.exp(np.cumsum(sh, axis=1))).astype(np.float32)\n                sc, _ = calculate_total_score_for_miner(paths, realized, ti, comp.scoring_intervals, comp.vol_scoring_blocks)\n                if sc > 0:\n                    res[m][h].append(sc)\n        b1, b2 = np.mean(res[\"base\"][1]), np.mean(res[\"base\"][2])\n        print(f\"=== {asset} ({comp.label}) base H1={b1:.2f} H2={b2:.2f} ===\")\n        for m in [\"pre_col_std\", \"blk_vv_0.12\"]:\n            m1, m2 = np.mean(res[m][1]), np.mean(res[m][2])\n            print(f\"  {m:<16} dH1={m1-b1:+6.2f}  dH2={m2-b2:+6.2f}  dMean={0.5*(m1+m2-b1-b2):+6.2f}\")\n'"}}
