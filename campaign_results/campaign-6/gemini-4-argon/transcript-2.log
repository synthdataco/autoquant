{"type":"tool_use","timestamp":"2026-10-22T12:02:52.422Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_92119","parameters":{"command":"uv run python -c '\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom properscoring import crps_ensemble\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import (\n    calculate_total_score_for_miner,\n    calculate_price_changes_over_intervals,\n    label_observed_blocks,\n    sum_crps_over_blocks,\n    block_volatilities,\n)\nfrom synth_lib.backtester.realized_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nimport sys\nsys.path.insert(0, \"agent\")\nfrom modeling import simulate\n\nWORKSPACE = Path(\"/workspace\")\nrstore = RealizedPathStore()\n\ndef diag_comp(comp, assets, step_hours=12, n_sims=200):\n    times = list(pd.date_range(\"2026-07-16\", \"2026-09-13\", freq=f\"{step_hours}h\", tz=\"UTC\"))\n    mid_t = pd.Timestamp(\"2026-08-15\", tz=\"UTC\")\n    tl, ti = comp.time_length, comp.time_increment\n    alphas = [0.88, 0.92, 0.96, 1.00, 1.04, 1.08, 1.12]\n    for asset in assets:\n        prices = load_minute_prices(WORKSPACE / \"market_data\", asset, times[0] - pd.Timedelta(days=7), times[-1] + pd.Timedelta(seconds=tl))\n        int_scores = {1: {}, 2: {}}\n        vol_spread_scores = {1: {}, 2: {}}\n        for t in times:\n            realized = rstore.get(asset, t.to_pydatetime(), tl, ti)\n            if realized is None or np.all(np.isnan(realized)):\n                continue\n            ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, tl)]\n            out = simulate(asset, t.isoformat(), ti, tl, n_sims, ctx)\n            paths = np.asarray(out[2:], dtype=np.float32)\n            h = 1 if t < mid_t else 2\n            for iname, isec in comp.scoring_intervals.items():\n                if iname.endswith(\"_gaps\") and iname not in (\"0_15min_gaps\", \"0_30min_gaps\", \"0_60min_gaps\"):\n                    continue\n                isteps = int(isec / ti)\n                abs_p = iname.endswith(\"_abs\")\n                is_g = iname.endswith(\"_gaps\")\n                sim_c = calculate_price_changes_over_intervals(paths, isteps, abs_p, is_g)\n                real_c = calculate_price_changes_over_intervals(realized.reshape(1, -1), isteps, abs_p, is_g)\n                if abs_p:\n                    p0 = paths[:, 0:1]\n                    sim_d = sim_c - p0\n                else:\n                    sim_d = sim_c\n                db = label_observed_blocks(real_c[0])\n                if len(db) == 0:\n                    continue\n                row = []\n                for a in alphas:\n                    sc = (p0 + a * sim_d) if abs_p else (a * sim_d)\n                    row.append(sum_crps_over_blocks(sc, real_c, db, abs_p, realized))\n                int_scores[h].setdefault(iname, []).append(row)\n            for vname, (bsec, w) in comp.vol_scoring_blocks.items():\n                bsteps = int(bsec / ti)\n                sv = block_volatilities(paths, bsteps)\n                rv = block_volatilities(realized.reshape(1, -1), bsteps)[0]\n                obs = np.flatnonzero(~np.isnan(rv))\n                if obs.size == 0:\n                    continue\n                row_a = []\n                for a in alphas:\n                    row_a.append(w * sum(crps_ensemble(rv[b], a * sv[:, b]) for b in obs))\n                int_scores[h].setdefault(vname, []).append(row_a)\n                med = np.median(sv, axis=0, keepdims=True)\n                l_sv = np.log(np.maximum(sv, 1e-6) / np.maximum(med, 1e-6))\n                betas = [0.7, 0.85, 1.0, 1.15, 1.3, 1.5]\n                row_b = []\n                for beta in betas:\n                    sv_b = med * np.exp(beta * l_sv)\n                    row_b.append(w * sum(crps_ensemble(rv[b], sv_b[:, b]) for b in obs))\n                vol_spread_scores[h].setdefault(vname, []).append(row_b)\n        print(f\"=== {asset} ({comp.label}) ===\")\n        for iname in int_scores[1]:\n            m1 = np.mean(int_scores[1][iname], axis=0)\n            m2 = np.mean(int_scores[2][iname], axis=0)\n            i1, i2 = int(np.argmin(m1)), int(np.argmin(m2))\n            print(f\"  {iname:<14} H1_base={m1[3]:7.2f} best_a={alphas[i1]:.2f} ({m1[i1]-m1[3]:+5.2f}) | H2_base={m2[3]:7.2f} best_a={alphas[i2]:.2f} ({m2[i2]-m2[3]:+5.2f})\")\n        for vname in vol_spread_scores[1]:\n            betas = [0.7, 0.85, 1.0, 1.15, 1.3, 1.5]\n            m1 = np.mean(vol_spread_scores[1][vname], axis=0)\n            m2 = np.mean(vol_spread_scores[2][vname], axis=0)\n            i1, i2 = int(np.argmin(m1)), int(np.argmin(m2))\n            print(f\"  {vname}_spread H1_base={m1[2]:7.2f} best_b={betas[i1]:.2f} ({m1[i1]-m1[2]:+5.2f}) | H2_base={m2[2]:7.2f} best_b={betas[i2]:.2f} ({m2[i2]-m2[2]:+5.2f})\")\n\ndiag_comp(CRYPTO_1H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], step_hours=12, n_sims=200)\ndiag_comp(CRYPTO_24H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], step_hours=24, n_sims=200)\ndiag_comp(COM_EQU_24H, [\"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\"], step_hours=24, n_sims=200)\n'","description":"Measure per-interval scale and volatility spread optimality across H1 and H2 on pre-validation data"}}
