{"type":"tool_use","timestamp":"2026-10-22T12:27:48.718Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_218721","parameters":{"command":"uv run python -c '\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth.validator.competition_config import COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.backtester.preparation import _slice_real_prices, _has_missing_prices\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nimport sys\nsys.path.insert(0, \"agent\")\nimport modeling as mod\n\nWORKSPACE = Path(\"/workspace\")\nall_times = list(pd.date_range(\"2026-07-16 00:15:00\", \"2026-09-13 00:00:00\", freq=\"13h\", tz=\"UTC\"))\nmid_t = pd.Timestamp(\"2026-08-15\", tz=\"UTC\")\ntl, ti = 86400, 300\nn_inc = tl // ti\nmid_lead_mins = (np.arange(n_inc, dtype=np.float64) + 0.5) * 5.0\ndec0 = np.exp(-mid_lead_mins / 360.0)\n\nfor asset in COM_EQU_24H.asset_list:\n    prices = load_minute_prices(WORKSPACE / \"market_data\", asset, all_times[0] - pd.Timedelta(days=7), all_times[-1] + pd.Timedelta(seconds=tl))\n    rstore = RealizedPathStore(asset, tl, ti)\n    res = {k: {1: [], 2: []} for k in [\"base\", \"act_all_neg\", \"act_sym_24h\", \"act_pos_neg\"]}\n    for t in all_times:\n        rp = _slice_real_prices(prices, t, tl, ti)\n        if _has_missing_prices(rp):\n            s = rstore.get(t.to_pydatetime())\n            if s is not None and len(s) == len(rp): rp = s.to_list()\n        realized = np.asarray(rp, dtype=np.float64)\n        if np.mean(np.isfinite(realized)) < 0.8: continue\n        ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, tl)]\n        out_base = mod.simulate(asset, t.isoformat(), ti, tl, 200, ctx)\n        paths_base = np.asarray(out_base[2:], dtype=np.float64)\n        p0 = paths_base[0, 0]\n        shocks_base = np.diff(np.log(paths_base), axis=1)\n\n        vals = ctx[\"close\"].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        s2_back = mod._S2_BACK_336.get(asset)\n        s2_fwd = mod._S2_FWD_336.get(asset, s2_back)\n        lt_sigma = mod.LONG_TERM_SIGMA_1M.get(asset, 5e-4)\n        start_us = mod._timestamp_to_utc_us(t.isoformat())\n        fwd_us = start_us + np.arange(1, n_inc * 5 + 1, dtype=np.int64) * 60_000_000\n        fwd_s2_min = s2_fwd[mod._slots_from_utc_us(fwd_us)] * mod._subslot_modulation(fwd_us, asset, False) * mod._event_variance_multiplier(fwd_us, asset)\n        s2_fwd_mean = float(np.mean(fwd_s2_min))\n        grid_us = mod._index_to_utc_us(ctx.index)\n        grid_s2 = s2_back[mod._slots_from_utc_us(grid_us)] * mod._subslot_modulation(grid_us, asset, False) * mod._event_variance_multiplier(grid_us, asset)\n        grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n        rate_ds = (rets ** 2) / ds2\n        pos_rates = rate_ds[rate_ds > 0]\n        cap_ds = float(np.percentile(pos_rates, 98.5)) if pos_rates.size > 10 else 1.0\n        r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        s2_grid_active = grid_s2[g_slice]\n        ewma_l2, ewma_l1, s2_bar_k = np.empty(6), np.empty(6), np.empty(6)\n        for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n            w_bar = np.exp(-lam * age_bar_min)\n            w_grid = np.exp(-lam * age_grid_min)\n            den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n            s2_bar_k[i] = den / max(float(np.sum(w_grid)), 1e-6)\n            ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n            ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n        log_l2 = np.log(np.maximum(ewma_l2, 1e-6))\n        log_l1 = np.log(np.maximum(ewma_l1, 1e-6))\n        log_mad5 = mod._compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n        log_hl = mod._compute_ohlc_log_ewma(ctx, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n\n        if asset == \"XAU\":\n            le_raw = 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n        else:\n            le_raw = 0.55 * log_l2 + 0.15 * (log_l1 + 0.05) + 0.22 * (log_mad5 + 0.05) + 0.08 * log_hl\n\n        alpha_k = np.minimum(s2_bar_k / max(s2_fwd_mean, 0.1), 1.0)\n        diff_5 = le_raw - le_raw[5]\n        diff_4 = le_raw - (0.5 * le_raw[4] + 0.5 * le_raw[5])\n\n        # Base\n        if asset in {\"XAU\", \"WTIOIL\", \"GOOGLX\", \"TSLAX\"}:\n            le0 = np.where(diff_5 < 0.0, le_raw[5] + (0.5 + 0.5 * alpha_k) * diff_5, le_raw)\n        else:\n            le0 = le_raw\n\n        # Variant 1: apply negative damping to ALL 8 COM_EQU_24H assets\n        le1 = np.where(diff_5 < 0.0, le_raw[5] + (0.5 + 0.5 * alpha_k) * diff_5, le_raw)\n\n        # Variant 2: also damp positive off-hours spikes when alpha_k < 0.5\n        le2 = np.where(\n            diff_5 < 0.0,\n            le0,\n            le_raw[5] + (0.75 + 0.25 * alpha_k) * diff_5,\n        )\n\n        # Variant 3: damp both positive and negative on all 8 assets\n        le3 = np.where(\n            diff_5 < 0.0,\n            le_raw[5] + (0.5 + 0.5 * alpha_k) * diff_5,\n            le_raw[5] + (0.75 + 0.25 * alpha_k) * diff_5,\n        )\n\n        def to_sb(le):\n            s_s = float(np.exp(np.dot(mod.WEIGHTS_24H_SHORT, le)))\n            s_lc = float(np.exp(np.dot(mod.WEIGHTS_24H_LONG, le)))\n            s_l = float(np.exp(0.90 * np.log(s_lc) + 0.10 * np.log(lt_sigma)))\n            return s_l * ((s_s / s_l) ** dec0)\n\n        sb0 = to_sb(le0)\n        h = 1 if t < mid_t else 2\n        for k, le in [(\"base\", le0), (\"act_all_neg\", le1), (\"act_sym_24h\", le2), (\"act_pos_neg\", le3)]:\n            if k == \"base\":\n                paths = paths_base.astype(np.float32)\n            else:\n                sb = to_sb(le)\n                sh = shocks_base * ((sb / sb0)[None, :])\n                paths = np.empty_like(paths_base, dtype=np.float32)\n                paths[:, 0] = p0\n                paths[:, 1:] = (p0 * np.exp(np.cumsum(sh, axis=1))).astype(np.float32)\n            sc, _ = calculate_total_score_for_miner(paths, realized, ti, COM_EQU_24H.scoring_intervals, COM_EQU_24H.vol_scoring_blocks)\n            if sc > 0:\n                res[k][h].append(sc)\n    b1, b2 = np.mean(res[\"base\"][1]), np.mean(res[\"base\"][2])\n    print(f\"=== {asset} (Com/Equ 24h) base H1={b1:.2f} H2={b2:.2f} ===\")\n    for k in [\"act_all_neg\", \"act_sym_24h\", \"act_pos_neg\"]:\n        m1, m2 = np.mean(res[k][1]), np.mean(res[k][2])\n        print(f\"  {k:<14} dH1={m1-b1:+6.2f}  dH2={m2-b2:+6.2f}  dMean={0.5*(m1+m2-b1-b2):+6.2f}\")\n'","description":"Test off-hours activity damping variants across all 8 COM_EQU_24H assets on H1 and H2 pre-validation splits"}}
