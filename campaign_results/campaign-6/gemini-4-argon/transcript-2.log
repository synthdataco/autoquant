{"type":"tool_use","timestamp":"2026-10-22T12:13:59.483Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_211675","parameters":{"command":"uv run python -c '\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.backtester.preparation import _slice_real_prices, _has_missing_prices\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nimport sys\nsys.path.insert(0, \"agent\")\nimport modeling as mod\n\nWORKSPACE = Path(\"/workspace\")\n\ndef hierarchical_secant(shocks_inc, eta_sub=1.0, n_sub=48, eta_blk=1.0, n_blks=8, eta_tot=1.0):\n    out = shocks_inc.copy()\n    if abs(eta_sub - 1.0) > 1e-6 and out.shape[1] >= n_sub:\n        s_len = out.shape[1] // n_sub\n        for s in range(n_sub):\n            sl = slice(s * s_len, (s + 1) * s_len)\n            sub = out[:, sl]\n            s2 = np.var(sub, axis=0)\n            w = s2 / max(float(np.sum(s2)), 1e-12)\n            s_sum = np.sum(sub, axis=1, keepdims=True)\n            out[:, sl] = sub + (eta_sub - 1.0) * s_sum * w[None, :]\n    eff_blk = eta_blk / eta_sub if eta_sub != 0 else eta_blk\n    if abs(eff_blk - 1.0) > 1e-6 and out.shape[1] >= n_blks:\n        b_len = out.shape[1] // n_blks\n        for b in range(n_blks):\n            sl = slice(b * b_len, (b + 1) * b_len)\n            sub = out[:, sl]\n            s2 = np.var(sub, axis=0)\n            w = s2 / max(float(np.sum(s2)), 1e-12)\n            b_sum = np.sum(sub, axis=1, keepdims=True)\n            out[:, sl] = sub + (eff_blk - 1.0) * b_sum * w[None, :]\n    eff_tot = eta_tot / eta_blk if eta_blk != 0 else eta_tot\n    if abs(eff_tot - 1.0) > 1e-6:\n        s2 = np.var(out, axis=0)\n        w = s2 / max(float(np.sum(s2)), 1e-12)\n        t_sum = np.sum(out, axis=1, keepdims=True)\n        out = out + (eff_tot - 1.0) * t_sum * w[None, :]\n    return out\n\ndef test_comequ_secant(assets, freq=\"17h\", n_sims=200):\n    all_times = list(pd.date_range(\"2026-07-16 00:15:00\", \"2026-09-13 00:00:00\", freq=freq, tz=\"UTC\"))\n    mid_t = pd.Timestamp(\"2026-08-15\", tz=\"UTC\")\n    tl, ti = 86400, 300\n    configs = {\n        \"base_iter8\": lambda sh, a: sh,\n        \"sub0.98_blk0.98_tot_same\": lambda sh, a: hierarchical_secant(sh, 0.98, 48, 0.98, 8, 1.0),\n        \"sub1.02_blk1.00_tot_same\": lambda sh, a: hierarchical_secant(sh, 1.02, 48, 1.00, 8, 1.0),\n        \"blk0.97_tot1.02_rel\": lambda sh, a: hierarchical_secant(sh, 1.00, 48, 0.97, 8, 1.02),\n        \"blk1.02_tot1.04_rel\": lambda sh, a: hierarchical_secant(sh, 1.00, 48, 1.02, 8, 1.04),\n    }\n    for asset in assets:\n        prices = load_minute_prices(WORKSPACE / \"market_data\", asset, all_times[0] - pd.Timedelta(days=7), all_times[-1] + pd.Timedelta(seconds=tl))\n        rstore = RealizedPathStore(asset, tl, ti)\n        res = {name: {1: [], 2: []} for name in configs}\n        for t in all_times:\n            rp = _slice_real_prices(prices, t, tl, ti)\n            if _has_missing_prices(rp):\n                s = rstore.get(t.to_pydatetime())\n                if s is not None and len(s) == len(rp):\n                    rp = s.to_list()\n            realized = np.asarray(rp, dtype=np.float64)\n            if np.mean(np.isfinite(realized)) < 0.8:\n                continue\n            ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, tl)]\n            out_base = mod.simulate(asset, t.isoformat(), ti, tl, n_sims, ctx)\n            paths_base = np.asarray(out_base[2:], dtype=np.float64)\n            p0 = paths_base[0, 0]\n            shocks_base = np.diff(np.log(paths_base), axis=1)\n            h = 1 if t < mid_t else 2\n            for name, fn in configs.items():\n                sh = fn(shocks_base, asset)\n                paths = np.empty_like(paths_base, dtype=np.float32)\n                paths[:, 0] = p0\n                paths[:, 1:] = (p0 * np.exp(np.cumsum(sh, axis=1))).astype(np.float32)\n                sc, _ = calculate_total_score_for_miner(paths, realized, ti, COM_EQU_24H.scoring_intervals, COM_EQU_24H.vol_scoring_blocks)\n                if sc > 0:\n                    res[name][h].append(sc)\n        b1, b2 = np.mean(res[\"base_iter8\"][1]), np.mean(res[\"base_iter8\"][2])\n        bm = 0.5 * (b1 + b2)\n        print(f\"=== {asset} (Com/Equ 24h) base H1={b1:.2f} H2={b2:.2f} mean={bm:.2f} ===\")\n        for name in configs:\n            if name == \"base_iter8\": continue\n            m1, m2 = np.mean(res[name][1]), np.mean(res[name][2])\n            mm = 0.5 * (m1 + m2)\n            print(f\"  {name:<24} dH1={m1-b1:+6.2f}  dH2={m2-b2:+6.2f}  dMean={mm-bm:+6.2f}\")\n\ntest_comequ_secant([\"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\"], freq=\"17h\", n_sims=200)\n'","description":"Test hierarchical secant configurations on COM_EQU_24H across H1 and H2 pre-validation splits"}}
