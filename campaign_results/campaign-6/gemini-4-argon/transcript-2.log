{"type":"tool_use","timestamp":"2026-10-22T12:05:57.074Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_278822","parameters":{"command":"uv run python -c '\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom properscoring import crps_ensemble\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import (\n    calculate_price_changes_over_intervals,\n    label_observed_blocks,\n    sum_crps_over_blocks,\n    block_volatilities,\n)\nfrom synth_lib.backtester.preparation import _slice_real_prices, _has_missing_prices\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nimport sys\nsys.path.insert(0, \"agent\")\nfrom modeling import simulate\n\nWORKSPACE = Path(\"/workspace\")\n\ndef diag_comp(comp, assets, freq=\"13h\", n_sims=200):\n    all_times = list(pd.date_range(\"2026-07-16 00:15:00\", \"2026-09-13 00:00:00\", freq=freq, tz=\"UTC\"))\n    mid_t = pd.Timestamp(\"2026-08-15\", tz=\"UTC\")\n    tl, ti = comp.time_length, comp.time_increment\n    alphas = [0.88, 0.92, 0.96, 1.00, 1.04, 1.08, 1.12]\n    betas = [0.70, 0.85, 1.00, 1.15, 1.30, 1.50]\n    for asset in assets:\n        prices = load_minute_prices(WORKSPACE / \"market_data\", asset, all_times[0] - pd.Timedelta(days=7), all_times[-1] + pd.Timedelta(seconds=tl))\n        rstore = RealizedPathStore(asset, tl, ti)\n        int_scores = {1: {}, 2: {}}\n        vol_spread_scores = {1: {}, 2: {}}\n        for t in all_times:\n            rp = _slice_real_prices(prices, t, tl, ti)\n            if _has_missing_prices(rp):\n                s = rstore.get(t.to_pydatetime())\n                if s is not None and len(s) == len(rp):\n                    rp = s.to_list()\n            realized = np.asarray(rp, dtype=np.float64)\n            if np.mean(np.isfinite(realized)) < 0.8:\n                continue\n            ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, tl)]\n            out = simulate(asset, t.isoformat(), ti, tl, n_sims, ctx)\n            paths = np.asarray(out[2:], dtype=np.float32)\n            h = 1 if t < mid_t else 2\n            for iname, isec in comp.scoring_intervals.items():\n                if iname.endswith(\"_gaps\") and iname not in (\"0_15min_gaps\", \"0_30min_gaps\", \"0_60min_gaps\"):\n                    continue\n                isteps = int(isec / ti)\n                abs_p = iname.endswith(\"_abs\")\n                is_g = iname.endswith(\"_gaps\")\n                sim_c = calculate_price_changes_over_intervals(paths, isteps, abs_p, is_g)\n                real_c = calculate_price_changes_over_intervals(realized.reshape(1, -1), isteps, abs_p, is_g)\n                p0 = paths[:, 0:1]\n                sim_d = (sim_c - p0) if abs_p else sim_c\n                db = label_observed_blocks(real_c[0])\n                if len(db) == 0 or np.all(db == -1):\n                    continue\n                row = [sum_crps_over_blocks((p0 + a * sim_d) if abs_p else (a * sim_d), real_c, db, abs_p, realized) for a in alphas]\n                if np.all(np.isfinite(row)):\n                    int_scores[h].setdefault(iname, []).append(row)\n            for vname, (bsec, w) in comp.vol_scoring_blocks.items():\n                bsteps = int(bsec / ti)\n                sv = block_volatilities(paths, bsteps)\n                rv = block_volatilities(realized.reshape(1, -1), bsteps)[0]\n                obs = np.flatnonzero(~np.isnan(rv))\n                if obs.size == 0:\n                    continue\n                row_a = [w * sum(crps_ensemble(rv[b], a * sv[:, b]) for b in obs) for a in alphas]\n                int_scores[h].setdefault(vname, []).append(row_a)\n                med = np.median(sv, axis=0, keepdims=True)\n                l_sv = np.log(np.maximum(sv, 1e-6) / np.maximum(med, 1e-6))\n                row_b = [w * sum(crps_ensemble(rv[b], (med * np.exp(beta * l_sv))[:, b]) for b in obs) for beta in betas]\n                vol_spread_scores[h].setdefault(vname, []).append(row_b)\n        print(f\"=== {asset} ({comp.label}, n={len(all_times)}) ===\")\n        for iname in int_scores[1]:\n            m1 = np.mean(int_scores[1][iname], axis=0)\n            m2 = np.mean(int_scores[2][iname], axis=0)\n            i1, i2 = int(np.argmin(m1)), int(np.argmin(m2))\n            print(f\"  {iname:<14} H1={m1[3]:7.2f} a*={alphas[i1]:.2f}({m1[i1]-m1[3]:+5.2f}) | H2={m2[3]:7.2f} a*={alphas[i2]:.2f}({m2[i2]-m2[3]:+5.2f})\")\n        for vname in vol_spread_scores[1]:\n            m1 = np.mean(vol_spread_scores[1][vname], axis=0)\n            m2 = np.mean(vol_spread_scores[2][vname], axis=0)\n            i1, i2 = int(np.argmin(m1)), int(np.argmin(m2))\n            print(f\"  {vname}_sprd   H1={m1[2]:7.2f} b*={betas[i1]:.2f}({m1[i1]-m1[2]:+5.2f}) | H2={m2[2]:7.2f} b*={betas[i2]:.2f}({m2[i2]-m2[2]:+5.2f})\")\n\ndiag_comp(CRYPTO_1H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], freq=\"11h\", n_sims=200)\ndiag_comp(CRYPTO_24H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], freq=\"17h\", n_sims=200)\ndiag_comp(COM_EQU_24H, [\"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\"], freq=\"17h\", n_sims=200)\n'","description":"Run pre-validation per-interval diagnostic over 2026-07-16 to 2026-09-13"}}
