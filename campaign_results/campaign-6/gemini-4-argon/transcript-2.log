{"type":"tool_use","timestamp":"2026-10-22T12:23:39.596Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_214140","parameters":{"description":"Test blend_hl_mad5, cascade_decay, and lt_anc on CRYPTO_24H and CRYPTO_1H across H1 and H2 pre-validation splits","command":"uv run python -c '\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.backtester.preparation import _slice_real_prices, _has_missing_prices\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nimport sys\nsys.path.insert(0, \"agent\")\nimport modeling as mod\n\nWORKSPACE = Path(\"/workspace\")\n\ndef compute_ewmas(asset, start_time, time_length, time_increment, context_prices):\n    steps = time_length // time_increment + 1\n    n_inc = steps - 1\n    step_mins = max(time_increment // 60, 1)\n    is_1h = time_length <= 3600\n    close_series = context_prices[\"close\"]\n    full_idx = context_prices.index\n    vals = close_series.to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    last = float(vals[valid_pos[-1]])\n    s2_back = mod._S2_BACK_336.get(asset, mod._DEFAULT_S2_336)\n    if is_1h:\n        s2_f_raw = mod._S2_FWD_336.get(asset, s2_back)\n        s2_f_norm = s2_f_raw / np.mean(s2_f_raw)\n        s2_btc_raw = mod._S2_FWD_336.get(\"BTC\", s2_back)\n        s2_btc_norm = s2_btc_raw / np.mean(s2_btc_raw)\n        s2_fwd = 0.35 * s2_back + 0.45 * s2_f_norm + 0.20 * s2_btc_norm\n    else:\n        s2_fwd = mod._S2_FWD_336.get(asset, s2_back)\n        if asset in mod.CRYPTO_ASSETS and float(np.mean(s2_fwd[240:])) > 0.70 * float(np.mean(s2_fwd[:240])):\n            s2_fwd = s2_fwd.copy()\n            s2_fwd[240:288] *= 0.94\n    lt_sigma = mod.LONG_TERM_SIGMA_1M.get(asset, 5e-4)\n    start_us = mod._timestamp_to_utc_us(start_time)\n    fwd_min_offsets = np.arange(1, n_inc * step_mins + 1, dtype=np.int64)\n    fwd_us = start_us + fwd_min_offsets * 60_000_000\n    fwd_slots = mod._slots_from_utc_us(fwd_us)\n    fwd_s2_min = s2_fwd[fwd_slots] * mod._subslot_modulation(fwd_us, asset, is_1h) * mod._event_variance_multiplier(fwd_us, asset)\n    fwd_s2 = fwd_s2_min.reshape(n_inc, step_mins).sum(axis=1)\n    step_seas_sqrt = np.sqrt(np.maximum(fwd_s2, 1e-4))\n    s2_fwd_mean = float(np.mean(fwd_s2_min))\n\n    grid_us = mod._index_to_utc_us(full_idx)\n    grid_slots = mod._slots_from_utc_us(grid_us)\n    grid_s2 = s2_back[grid_slots] * mod._subslot_modulation(grid_us, asset, is_1h) * mod._event_variance_multiplier(grid_us, asset)\n    grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n    valid_vals = vals[valid_pos]\n    rets = np.diff(np.log(valid_vals))\n    ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n    rate_ds = (rets ** 2) / ds2\n    pos_rates = rate_ds[rate_ds > 0]\n    cap_ds = float(np.percentile(pos_rates, 98.5)) if pos_rates.size > 10 else 1.0\n    r2_win = np.minimum(rate_ds, cap_ds) * ds2\n    r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n    t_end_us = int(grid_us[-1])\n    valid_us = grid_us[valid_pos]\n    t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n    age_bar_min = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n    g_slice = slice(int(valid_pos[0]), len(grid_us))\n    age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n    s2_grid_active = grid_s2[g_slice]\n\n    ewma_l2 = np.empty(6, dtype=np.float64)\n    ewma_l1 = np.empty(6, dtype=np.float64)\n    s2_bar_k = np.empty(6, dtype=np.float64)\n    for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n        w_bar = np.exp(-lam * age_bar_min)\n        w_grid = np.exp(-lam * age_grid_min)\n        den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n        s2_bar_k[i] = den / max(float(np.sum(w_grid)), 1e-6)\n        ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n        ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n    log_l2 = np.log(np.maximum(ewma_l2, 1e-6))\n    log_l1 = np.log(np.maximum(ewma_l1, 1e-6))\n    log_mad5 = mod._compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n    if log_mad5 is None: log_mad5 = log_l2\n    log_hl = mod._compute_ohlc_log_ewma(context_prices, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n    if log_hl is None: log_hl = log_l2\n    return last, step_seas_sqrt, s2_fwd_mean, s2_bar_k, log_l2, log_l1, log_mad5, log_hl, lt_sigma, vals, valid_pos, rets\n\nfor comp, assets, freq in [(CRYPTO_24H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], \"17h\"), (CRYPTO_1H, [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"], \"11h\")]:\n    all_times = list(pd.date_range(\"2026-07-16 00:15:00\", \"2026-09-13 00:00:00\", freq=freq, tz=\"UTC\"))\n    mid_t = pd.Timestamp(\"2026-08-15\", tz=\"UTC\")\n    tl, ti = comp.time_length, comp.time_increment\n    n_inc = tl // ti\n    step_mins = max(ti // 60, 1)\n    mid_lead_mins = (np.arange(n_inc, dtype=np.float64) + 0.5) * step_mins\n    for asset in assets:\n        prices = load_minute_prices(WORKSPACE / \"market_data\", asset, all_times[0] - pd.Timedelta(days=7), all_times[-1] + pd.Timedelta(seconds=tl))\n        rstore = RealizedPathStore(asset, tl, ti)\n        res = {k: {1: [], 2: []} for k in [\"base\", \"blend_hl_mad5\", \"cascade_decay\", \"lt_anc_1h\"]}\n        for t in all_times:\n            rp = _slice_real_prices(prices, t, tl, ti)\n            if _has_missing_prices(rp):\n                s = rstore.get(t.to_pydatetime())\n                if s is not None and len(s) == len(rp): rp = s.to_list()\n            realized = np.asarray(rp, dtype=np.float64)\n            if np.mean(np.isfinite(realized)) < 0.8: continue\n            ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, tl)]\n            out_base = mod.simulate(asset, t.isoformat(), ti, tl, 200, ctx)\n            paths_base = np.asarray(out_base[2:], dtype=np.float64)\n            p0 = paths_base[0, 0]\n            shocks_base = np.diff(np.log(paths_base), axis=1)\n            last, step_seas_sqrt, s2_fwd_mean, s2_bar_k, log_l2, log_l1, log_mad5, log_hl, lt_sigma, vals, valid_pos, rets = compute_ewmas(asset, t.isoformat(), tl, ti, ctx)\n\n            if tl <= 3600:\n                le_base = 0.45 * log_l2 + 0.20 * log_l1 + 0.20 * log_mad5 + 0.15 * log_hl\n                s_s0 = float(np.exp(np.dot(mod.WEIGHTS_1H_START, le_base)))\n                s_l0 = float(np.exp(np.dot(mod.WEIGHTS_1H_END, le_base)))\n                dec0 = np.exp(-mid_lead_mins / 30.0)\n                sb0 = s_l0 * ((s_s0 / s_l0) ** dec0)\n\n                # Variant 1: higher HL + anchored mad5\n                mad5_anc = log_mad5 - log_mad5[5] + log_l2[5]\n                le_v1 = 0.40 * log_l2 + 0.15 * (log_l1 + 0.12) + 0.20 * mad5_anc + 0.25 * log_hl\n                s_s1 = float(np.exp(np.dot(mod.WEIGHTS_1H_START, le_v1)))\n                s_l1 = float(np.exp(np.dot(mod.WEIGHTS_1H_END, le_v1)))\n                sb1 = s_l1 * ((s_s1 / s_l1) ** dec0)\n\n                # Variant 2: multi-rate cascade decay\n                le_fast = 0.25 * le_base[0] + 0.45 * le_base[1] + 0.30 * le_base[2]\n                le_med = 0.25 * le_base[2] + 0.45 * le_base[3] + 0.30 * le_base[4]\n                le_slow = 0.35 * le_base[3] + 0.40 * le_base[4] + 0.25 * le_base[5]\n                sb2 = np.exp(le_slow + (le_med - le_slow) * np.exp(-mid_lead_mins / 45.0) + (le_fast - le_med) * np.exp(-mid_lead_mins / 15.0))\n\n                # Variant 3: 5% LT anchor on sigma_long in 1h\n                s_l3 = float(np.exp(0.94 * np.log(s_l0) + 0.06 * np.log(lt_sigma)))\n                sb3 = s_l3 * ((s_s0 / s_l3) ** dec0)\n            else:\n                le_base = 0.80 * log_l2 + 0.20 * (log_l1 + 0.20)\n                s_s0 = float(np.exp(np.dot(mod.WEIGHTS_24H_SHORT, le_base)))\n                s_lc0 = float(np.exp(np.dot(mod.WEIGHTS_24H_LONG, le_base)))\n                s_l0 = float(np.exp(0.90 * np.log(s_lc0) + 0.10 * np.log(lt_sigma)))\n                dec0 = np.exp(-mid_lead_mins / 360.0)\n                sb0 = s_l0 * ((s_s0 / s_l0) ** dec0)\n\n                # Variant 1: blend log_mad5 and log_hl into CRYPTO_24H\n                mad5_anc = log_mad5 - log_mad5[5] + log_l2[5]\n                le_v1 = 0.60 * log_l2 + 0.15 * (log_l1 + 0.20) + 0.15 * mad5_anc + 0.10 * log_hl\n                s_s1 = float(np.exp(np.dot(mod.WEIGHTS_24H_SHORT, le_v1)))\n                s_lc1 = float(np.exp(np.dot(mod.WEIGHTS_24H_LONG, le_v1)))\n                s_l1 = float(np.exp(0.90 * np.log(s_lc1) + 0.10 * np.log(lt_sigma)))\n                sb1 = s_l1 * ((s_s1 / s_l1) ** dec0)\n\n                # Variant 2: multi-rate cascade decay\n                le_fast = 0.30 * le_base[1] + 0.45 * le_base[2] + 0.25 * le_base[3]\n                le_med = 0.25 * le_base[3] + 0.45 * le_base[4] + 0.30 * le_base[5]\n                le_slow = np.log(s_l0)\n                sb2 = np.exp(le_slow + (le_med - le_slow) * np.exp(-mid_lead_mins / 600.0) + (le_fast - le_med) * np.exp(-mid_lead_mins / 120.0))\n\n                # Variant 3: 15% LT anchor\n                s_l3 = float(np.exp(0.85 * np.log(s_lc0) + 0.15 * np.log(lt_sigma)))\n                sb3 = s_l3 * ((s_s0 / s_l3) ** dec0)\n\n            h = 1 if t < mid_t else 2\n            for k, sb in [(\"base\", sb0), (\"blend_hl_mad5\", sb1), (\"cascade_decay\", sb2), (\"lt_anc_1h\", sb3)]:\n                if k == \"base\":\n                    paths = paths_base.astype(np.float32)\n                else:\n                    sh = shocks_base * ((sb / sb0)[None, :])\n                    paths = np.empty_like(paths_base, dtype=np.float32)\n                    paths[:, 0] = p0\n                    paths[:, 1:] = (p0 * np.exp(np.cumsum(sh, axis=1))).astype(np.float32)\n                sc, _ = calculate_total_score_for_miner(paths, realized, ti, comp.scoring_intervals, comp.vol_scoring_blocks)\n                if sc > 0:\n                    res[k][h].append(sc)\n        b1, b2 = np.mean(res[\"base\"][1]), np.mean(res[\"base\"][2])\n        print(f\"=== {asset} ({comp.label}) base H1={b1:.2f} H2={b2:.2f} ===\")\n        for k in [\"blend_hl_mad5\", \"cascade_decay\", \"lt_anc_1h\"]:\n            m1, m2 = np.mean(res[k][1]), np.mean(res[k][2])\n            print(f\"  {k:<16} dH1={m1-b1:+6.2f}  dH2={m2-b2:+6.2f}  dMean={0.5*(m1+m2-b1-b2):+6.2f}\")\n'"}}
