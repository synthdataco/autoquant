{"type":"tool_use","timestamp":"2026-10-22T12:33:22.373Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_302019","parameters":{"description":"Verify combined Iteration 10 candidate across all 18 (asset, competition) pairs on H1 and H2 pre-validation splits","command":"uv run python -c '\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.backtester.preparation import _slice_real_prices, _has_missing_prices\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nimport sys\nsys.path.insert(0, \"agent\")\nimport modeling as mod\n\nWORKSPACE = Path(\"/workspace\")\n\ndef apply_hier_secant(shocks_inc, eta_sub=1.0, n_sub=48, eta_blk=1.0, n_blks=8, eta_tot=1.0):\n    out = shocks_inc\n    if abs(eta_sub - 1.0) > 1e-6 and out.shape[1] >= n_sub:\n        s_len = out.shape[1] // n_sub\n        out = out.copy()\n        for s in range(n_sub):\n            sl = slice(s * s_len, (s + 1) * s_len)\n            sub = out[:, sl]\n            s2 = np.var(sub, axis=0)\n            w = s2 / max(float(np.sum(s2)), 1e-12)\n            s_sum = np.sum(sub, axis=1, keepdims=True)\n            out[:, sl] = sub + (eta_sub - 1.0) * s_sum * w[None, :]\n    eff_blk = eta_blk / eta_sub if eta_sub != 0.0 else eta_blk\n    if abs(eff_blk - 1.0) > 1e-6 and out.shape[1] >= n_blks:\n        b_len = out.shape[1] // n_blks\n        if out is shocks_inc:\n            out = out.copy()\n        for b in range(n_blks):\n            sl = slice(b * b_len, (b + 1) * b_len)\n            sub = out[:, sl]\n            s2 = np.var(sub, axis=0)\n            w = s2 / max(float(np.sum(s2)), 1e-12)\n            b_sum = np.sum(sub, axis=1, keepdims=True)\n            out[:, sl] = sub + (eff_blk - 1.0) * b_sum * w[None, :]\n    eff_tot = eta_tot / eta_blk if eta_blk != 0.0 else eta_tot\n    if abs(eff_tot - 1.0) > 1e-6:\n        s2 = np.var(out, axis=0)\n        w = s2 / max(float(np.sum(s2)), 1e-12)\n        t_sum = np.sum(out, axis=1, keepdims=True)\n        out = out + (eff_tot - 1.0) * t_sum * w[None, :]\n    return out\n\ndef simulate_iter10(asset, start_time, time_increment=300, time_length=86400, num_simulations=1000, context_prices=None):\n    rng = mod._make_rng(asset, start_time, time_length)\n    steps = time_length // time_increment + 1\n    n_inc = steps - 1\n    step_mins = max(time_increment // 60, 1)\n    is_1h = time_length <= 3600\n    close_series = context_prices[\"close\"] if isinstance(context_prices, pd.DataFrame) else context_prices\n    full_idx = context_prices.index\n    vals = close_series.to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    last = float(vals[valid_pos[-1]]) if valid_pos.size > 0 else 1.0\n\n    s2_back = mod._S2_BACK_336.get(asset, mod._DEFAULT_S2_336)\n    if is_1h:\n        s2_f_raw = mod._S2_FWD_336.get(asset, s2_back)\n        s2_f_norm = s2_f_raw / np.mean(s2_f_raw)\n        s2_btc_raw = mod._S2_FWD_336.get(\"BTC\", s2_back)\n        s2_btc_norm = s2_btc_raw / np.mean(s2_btc_raw)\n        s2_fwd = 0.35 * s2_back + 0.45 * s2_f_norm + 0.20 * s2_btc_norm\n    else:\n        s2_fwd = mod._S2_FWD_336.get(asset, s2_back)\n        if asset in mod.CRYPTO_ASSETS and float(np.mean(s2_fwd[240:])) > 0.70 * float(np.mean(s2_fwd[:240])):\n            s2_fwd = s2_fwd.copy()\n            s2_fwd[240:288] *= 0.94\n    lt_sigma = mod.LONG_TERM_SIGMA_1M.get(asset, 5e-4)\n    start_us = mod._timestamp_to_utc_us(start_time)\n    fwd_min_offsets = np.arange(1, n_inc * step_mins + 1, dtype=np.int64)\n    fwd_us = start_us + fwd_min_offsets * 60_000_000\n    fwd_slots = mod._slots_from_utc_us(fwd_us)\n    fwd_s2_min = s2_fwd[fwd_slots] * mod._subslot_modulation(fwd_us, asset, is_1h) * mod._event_variance_multiplier(fwd_us, asset)\n    fwd_s2 = fwd_s2_min.reshape(n_inc, step_mins).sum(axis=1)\n    step_seas_sqrt = np.sqrt(np.maximum(fwd_s2, 1e-4))\n    s2_fwd_mean = float(np.mean(fwd_s2_min))\n\n    brk_mult = 1.0\n    if valid_pos.size > 10:\n        grid_us = mod._index_to_utc_us(full_idx)\n        grid_slots = mod._slots_from_utc_us(grid_us)\n        grid_s2 = s2_back[grid_slots] * mod._subslot_modulation(grid_us, asset, is_1h) * mod._event_variance_multiplier(grid_us, asset)\n        grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        valid_vals = vals[valid_pos]\n        rets = np.diff(np.log(valid_vals))\n        finite = np.isfinite(rets)\n        if not np.all(finite):\n            rets = np.where(finite, rets, 0.0)\n        ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n        rate_ds = (rets ** 2) / ds2\n        pos_rates = rate_ds[rate_ds > 0]\n        cap_ds = float(np.percentile(pos_rates, 98.5)) if pos_rates.size > 10 else 1.0\n        r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar_min = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        s2_grid_active = grid_s2[g_slice]\n\n        ewma_l2 = np.empty(6, dtype=np.float64)\n        ewma_l1 = np.empty(6, dtype=np.float64)\n        s2_bar_k = np.empty(6, dtype=np.float64)\n        for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n            w_bar = np.exp(-lam * age_bar_min)\n            w_grid = np.exp(-lam * age_grid_min)\n            den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n            s2_bar_k[i] = den / max(float(np.sum(w_grid)), 1e-6)\n            ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n            ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n\n        log_l2 = np.log(np.maximum(ewma_l2, 1e-6))\n        log_l1 = np.log(np.maximum(ewma_l1, 1e-6))\n        log_mad5 = mod._compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n        if log_mad5 is None: log_mad5 = log_l2\n        mad5_anc = log_mad5 - log_mad5[5] + log_l2[5]\n        log_hl = mod._compute_ohlc_log_ewma(context_prices, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n        if log_hl is None: log_hl = log_l2\n\n        if is_1h:\n            log_ewma = 0.40 * log_l2 + 0.15 * (log_l1 + 0.12) + 0.20 * mad5_anc + 0.25 * log_hl\n            sigma_short = float(np.exp(np.dot(mod.WEIGHTS_1H_START, log_ewma)))\n            sigma_long_ctx = float(np.exp(np.dot(mod.WEIGHTS_1H_END, log_ewma)))\n            sigma_long = float(np.exp(0.94 * np.log(sigma_long_ctx) + 0.06 * np.log(lt_sigma)))\n        else:\n            if asset in mod.CRYPTO_ASSETS:\n                log_ewma = 0.60 * log_l2 + 0.15 * (log_l1 + 0.20) + 0.15 * mad5_anc + 0.10 * log_hl\n            else:\n                if asset == \"XAU\":\n                    log_ewma = 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n                else:\n                    log_ewma = 0.55 * log_l2 + 0.15 * (log_l1 + 0.05) + 0.22 * (log_mad5 + 0.05) + 0.08 * log_hl\n                if asset in {\"XAU\", \"WTIOIL\", \"GOOGLX\", \"TSLAX\", \"SPCX\", \"SP500\"}:\n                    alpha_k = np.minimum(s2_bar_k / max(s2_fwd_mean, 0.1), 1.0)\n                    diff_k = log_ewma - log_ewma[5]\n                    log_ewma = np.where(diff_k < 0.0, log_ewma[5] + (0.5 + 0.5 * alpha_k) * diff_k, log_ewma)\n            sigma_short = float(np.exp(np.dot(mod.WEIGHTS_24H_SHORT, log_ewma)))\n            sigma_long_ctx = float(np.exp(np.dot(mod.WEIGHTS_24H_LONG, log_ewma)))\n            sigma_long = float(np.exp(0.90 * np.log(sigma_long_ctx) + 0.10 * np.log(lt_sigma)))\n            if asset in mod.CRYPTO_ASSETS and len(vals) >= 1440:\n                idx_24h = int(np.searchsorted(valid_pos, max(0, len(vals) - 1440)))\n                rv_24h = float(np.sqrt(np.sum(rets[idx_24h:] ** 2)))\n                er_24h = abs(float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_24h]]))) / max(rv_24h, 1e-6)\n                if er_24h < 0.35:\n                    brk_mult = 1.0 - 0.06 * (0.35 - er_24h)\n                elif er_24h > 0.55 and sigma_short > sigma_long:\n                    brk_mult = 1.0 + 0.05 * min(er_24h - 0.55, 0.45)\n    else:\n        sigma_short = lt_sigma\n        sigma_long = lt_sigma\n\n    c_scale, sig_path_vv, sig_step_vv = mod._distribution_params(asset, time_length)\n    mid_lead_mins = (np.arange(n_inc, dtype=np.float64) + 0.5) * step_mins\n    rev_tau = mod.REVERSION_TAU_1H if is_1h else mod.REVERSION_TAU_24H\n    decay = np.exp(-mid_lead_mins / rev_tau)\n    sigma_base_t = sigma_long * ((sigma_short / max(sigma_long, 1e-8)) ** decay)\n    per_step_sigma = (c_scale * brk_mult * sigma_base_t) * step_seas_sqrt\n\n    half = num_simulations // 2\n    eps = rng.standard_normal((half, n_inc))\n    if sig_step_vv > 0.0:\n        eta = rng.standard_normal((half, n_inc))\n        eps = eps * np.exp(sig_step_vv * eta - 0.5 * sig_step_vv * sig_step_vv)\n    if asset in mod.CRYPTO_ASSETS and not is_1h:\n        z_step = np.vstack([eps, -eps])\n        c_std = np.std(z_step, axis=0, keepdims=True)\n        eps = eps / np.where(c_std > 1e-8, c_std, 1.0)\n        q_z = mod._stratified_normal_quantiles(half)\n        m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv * sig_path_vv)[:, None]\n        m_rms = float(np.sqrt(np.mean(m_half ** 2)))\n        eps = eps * (m_half / m_rms)\n        z = np.vstack([eps, -eps])\n    else:\n        q_z = mod._stratified_normal_quantiles(half)\n        m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv * sig_path_vv)[:, None]\n        eps = eps * m_half\n        z = np.vstack([eps, -eps])\n        col_std = np.std(z, axis=0, keepdims=True)\n        z = z / np.where(col_std > 1e-8, col_std, 1.0)\n\n    shocks_inc = z * per_step_sigma[None, :]\n    if is_1h:\n        if asset == \"HYPE\":\n            shocks_inc = apply_hier_secant(shocks_inc, eta_sub=1.02, n_sub=12, eta_blk=0.99, n_blks=4, eta_tot=1.04)\n        elif asset != \"ETH\":\n            shocks_inc = apply_hier_secant(shocks_inc, eta_sub=1.0, n_sub=12, eta_blk=0.95, n_blks=4, eta_tot=0.95)\n    elif asset in mod.CRYPTO_ASSETS:\n        if asset != \"HYPE\":\n            shocks_inc = apply_hier_secant(shocks_inc, eta_sub=0.96, n_sub=48, eta_blk=0.93, n_blks=8, eta_tot=1.00)\n    else:\n        eta_equ = 1.05 if asset == \"SPCX\" else 1.09\n        shocks_inc = apply_hier_secant(shocks_inc, eta_sub=1.0, n_sub=48, eta_blk=1.0, n_blks=8, eta_tot=eta_equ)\n\n    shocks = np.empty((num_simulations, steps), dtype=np.float64)\n    shocks[:, 0] = 0.0\n    shocks[:, 1:] = shocks_inc\n    paths = last * np.exp(np.cumsum(shocks, axis=1))\n    return paths\n\nfor comp, freq in [(CRYPTO_24H, \"17h\"), (CRYPTO_1H, \"11h\"), (COM_EQU_24H, \"17h\")]:\n    all_times = list(pd.date_range(\"2026-07-16 00:15:00\", \"2026-09-13 00:00:00\", freq=freq, tz=\"UTC\"))\n    mid_t = pd.Timestamp(\"2026-08-15\", tz=\"UTC\")\n    tl, ti = comp.time_length, comp.time_increment\n    print(f\"================ {comp.label} ================\")\n    for asset in comp.asset_list:\n        prices = load_minute_prices(WORKSPACE / \"market_data\", asset, all_times[0] - pd.Timedelta(days=7), all_times[-1] + pd.Timedelta(seconds=tl))\n        rstore = RealizedPathStore(asset, tl, ti)\n        b_res, n_res = {1: [], 2: []}, {1: [], 2: []}\n        for t in all_times:\n            rp = _slice_real_prices(prices, t, tl, ti)\n            if _has_missing_prices(rp):\n                s = rstore.get(t.to_pydatetime())\n                if s is not None and len(s) == len(rp): rp = s.to_list()\n            realized = np.asarray(rp, dtype=np.float64)\n            if np.mean(np.isfinite(realized)) < 0.8: continue\n            ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, tl)]\n            p_b = np.asarray(mod.simulate(asset, t.isoformat(), ti, tl, 200, ctx)[2:], dtype=np.float32)\n            p_n = simulate_iter10(asset, t.isoformat(), ti, tl, 200, ctx).astype(np.float32)\n            h = 1 if t < mid_t else 2\n            sc_b, _ = calculate_total_score_for_miner(p_b, realized, ti, comp.scoring_intervals, comp.vol_scoring_blocks)\n            sc_n, _ = calculate_total_score_for_miner(p_n, realized, ti, comp.scoring_intervals, comp.vol_scoring_blocks)\n            if sc_b > 0 and sc_n > 0:\n                b_res[h].append(sc_b)\n                n_res[h].append(sc_n)\n        b1, b2 = np.mean(b_res[1]), np.mean(b_res[2])\n        n1, n2 = np.mean(n_res[1]), np.mean(n_res[2])\n        print(f\"  {asset:<8} dH1={n1-b1:+6.2f}  dH2={n2-b2:+6.2f}  dMean={0.5*(n1+n2-b1-b2):+6.2f}\")\n'"}}
