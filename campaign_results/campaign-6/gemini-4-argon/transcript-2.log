    dH1= -0.05  dH2= -0.13  dMean= -0.09\n  blk1.02_tot1.04_rel      dH1= -0.25  dH2= +0.51  dMean= +0.13\n=== SPCX (Com/Equ 24h) base H1=5330.92 H2=2828.40 mean=4079.66 ===\n  sub0.98_blk0.98_tot_same dH1= +0.81  dH2= -0.48  dMean= +0.17\n  sub1.02_blk1.00_tot_same dH1= -0.33  dH2= +0.39  dMean= +0.03\n  blk0.97_tot1.02_rel      dH1= +0.42  dH2= -0.07  dMean= +0.18\n  blk1.02_tot1.04_rel      dH1= -0.21  dH2= +0.70  dMean= +0.24\n=== SP500 (Com/Equ 24h) base H1=886.25 H2=645.93 mean=766.09 ===\n  sub0.98_blk0.98_tot_same dH1= +0.12  dH2= -0.01  dMean= +0.06\n  sub1.02_blk1.00_tot_same dH1= -0.07  dH2= +0.00  dMean= -0.03\n  blk0.97_tot1.02_rel      dH1= -0.02  dH2= -0.04  dMean= -0.03\n  blk1.02_tot1.04_rel      dH1= -0.12  dH2= +0.04  dMean= -0.04"}
