{"type":"tool_use","timestamp":"2026-10-22T01:24:02.632Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_248348","parameters":{"description":"Test structured 336-slot 1-minute CRPS forward calibration on CRYPTO_1H across 2026-08-16 to 2026-09-06.","command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import minimize_scalar\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\nfit_start = pd.Timestamp('2026-06-25', tz='UTC')\nfit_end = pd.Timestamp('2026-08-15', tz='UTC')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\ndef fit_c_crps(z_res, z_template_1d):\n    z_res = z_res[np.isfinite(z_res)]\n    if len(z_res) < 20:\n        return 1.0\n    if len(z_res) > 2500:\n        z_res = z_res[::len(z_res)//2500]\n    x = np.sort(z_template_1d)\n    M = len(x)\n    weights = (2 * np.arange(1, M + 1) - M - 1)\n    half_spread = float(np.sum(weights * x) / (M * M))\n    def obj(c):\n        return float(np.mean(np.abs(c * x[:, None] - z_res[None, :]))) - c * half_spread\n    res = minimize_scalar(obj, bounds=(0.30, 2.2), method='bounded')\n    return float(res.x)\n\ndef fit_structured_c336(z_by_slot336, z_1d):\n    # Pool Mon-Fri 48 half-hours (slots 0..239) to get 48 weekday intraday CRPS multipliers\n    c_wk_48 = np.ones(48)\n    for hh in range(48):\n        z_hh = np.concatenate([z_by_slot336[d * 48 + hh] for d in range(5) if len(z_by_slot336[d * 48 + hh]) > 0])\n        c_wk_48[hh] = fit_c_crps(z_hh, z_1d)\n    # Smooth c_wk_48 slightly with [0.2, 0.6, 0.2] except at sharp open/macro slots (24..30, 39..41)\n    c_wk_sm = np.convolve(np.pad(c_wk_48, 1, mode='edge'), [0.2, 0.6, 0.2], mode='valid')\n    for hh in (24, 25, 26, 27, 28, 29, 39, 40):\n        c_wk_sm[hh] = 0.8 * c_wk_48[hh] + 0.2 * c_wk_sm[hh]\n        \n    # Day of week multiplier for Mon..Fri (normalized by c_wk_sm)\n    dow_mult = np.ones(5)\n    for d in range(5):\n        z_d = np.concatenate([z_by_slot336[d * 48 + hh] / c_wk_sm[hh] for hh in range(42) if len(z_by_slot336[d * 48 + hh]) > 0])\n        dow_mult[d] = 0.6 * fit_c_crps(z_d, z_1d) + 0.4 * 1.0\n        \n    c_grid = np.ones((7, 48))\n    for d in range(5):\n        c_grid[d, :] = c_wk_sm * dow_mult[d]\n    # Fri 21:00..24:00 (d=4, 42..47)\n    z_fri_cl = np.concatenate([z_by_slot336[4 * 48 + hh] for hh in range(42, 48) if len(z_by_slot336[4 * 48 + hh]) > 0])\n    c_grid[4, 42:] = fit_c_crps(z_fri_cl, z_1d)\n    # Sat (d=5): 4 blocks of 6 hours (12 half-hours each)\n    for b in range(4):\n        z_sat_b = np.concatenate([z_by_slot336[5 * 48 + hh] for hh in range(b*12, (b+1)*12) if len(z_by_slot336[5 * 48 + hh]) > 0])\n        c_grid[5, b*12:(b+1)*12] = fit_c_crps(z_sat_b, z_1d)\n    # Sun 00:00..21:00 (d=6, 0..41): 3 blocks (0..14, 14..28, 28..42)\n    for h0, h1 in [(0, 14), (14, 28), (28, 42)]:\n        z_sun_b = np.concatenate([z_by_slot336[6 * 48 + hh] for hh in range(h0, h1) if len(z_by_slot336[6 * 48 + hh]) > 0])\n        c_grid[6, h0:h1] = fit_c_crps(z_sun_b, z_1d)\n    # Sun 21:00..24:00 (d=6, 42..47)\n    z_sun_op = np.concatenate([z_by_slot336[6 * 48 + hh] for hh in range(42, 48) if len(z_by_slot336[6 * 48 + hh]) > 0])\n    c_grid[6, 42:] = fit_c_crps(z_sun_op, z_1d)\n    return c_grid.reshape(336)\n\ndef make_z(n_sims, n_inc, sig_p, sig_s):\n    rng = np.random.default_rng(42)\n    half = n_sims // 2\n    eps = rng.standard_normal((half, n_inc)) * np.exp(sig_s * rng.standard_normal((half, n_inc)) - 0.5 * sig_s**2)\n    eps = eps * np.exp(sig_p * m._stratified_normal_quantiles(half) - 0.5 * sig_p**2)[:, None]\n    z = np.vstack([eps, -eps])\n    return z / np.std(z, axis=0, keepdims=True)\n\nprint('=== 1. CRYPTO_1H: Structured 336-Slot 1m Forward Calibration (2026-08-16..2026-09-06) ===')\nz1h = make_z(200, 60, 0.30, 0.20)\nz1h_1d = z1h[:, 0]\nfor asset in CRYPTO_1H.asset_list:\n    p = load_minute_prices(root, asset, fit_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=1))\n    s2_b = m._S2_BACK_336[asset]\n    moh_s2 = m._MOH_S2[asset]\n    \n    fit_times = pd.date_range(fit_start, fit_end, freq='2h', tz='UTC')\n    z_by_slot = [[] for _ in range(336)]\n    for ts in fit_times:\n        ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        real = p['close'].loc[ts : ts + pd.Timedelta(seconds=3600)].to_numpy(dtype=float)\n        if len(real) != 61 or not np.isfinite(real).all():\n            continue\n        r1 = np.diff(np.log(real))\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        grid_us = m._index_to_utc_us(ctx.index)\n        gs2 = s2_b[m._slots_from_utc_us(grid_us)] * m._subslot_modulation(grid_us, asset, True) * m._event_variance_multiplier(grid_us, asset)\n        cs = np.concatenate(([0.0], np.cumsum(gs2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n        r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        s2_g = gs2[g_sl]\n        ew_l2, ew_l1 = [], []\n        for lam in m.EWMA_LAMBDAS_6:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n        le = 0.70 * np.log(ew_l2) + 0.30 * np.log(ew_l1)\n        s0 = float(np.exp(np.dot(m.WEIGHTS_1H_START, le)))\n        s1 = float(np.exp(np.dot(m.WEIGHTS_1H_END, le)))\n        dec30 = np.exp(-(np.arange(60) + 0.5) / 30.0)\n        base_t = 1.05 * (s1 * ((s0 / s1) ** dec30))\n        fwd_us = int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 61, dtype=np.int64) * 60_000_000\n        fwd_slots = m._slots_from_utc_us(fwd_us)\n        fs2 = s2_b[fwd_slots] * m._subslot_modulation(fwd_us, asset, True) * m._event_variance_multiplier(fwd_us, asset)\n        pred_1m = base_t * np.sqrt(np.maximum(fs2, 1e-4))\n        z_step = r1 / pred_1m\n        for sl_i, z_v in zip(fwd_slots, z_step):\n            z_by_slot[sl_i].append(np.array([z_v]))\n            \n    c336_1h = fit_structured_c336([np.concatenate(lst) if lst else np.array([]) for lst in z_by_slot], z1h_1d)\n    \n    # Evaluate on tune_start..tune_end\n    tune_times = pd.date_range(tune_start, tune_end, freq='2h', inclusive='left')\n    res_it5, res_a50, res_a75, res_a100 = [], [], [], []\n    for ts in tune_times:\n        ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        real = p['close'].loc[ts : ts + pd.Timedelta(seconds=3600)].to_numpy(dtype=float)\n        if len(real) != 61 or not np.isfinite(real).all():\n            continue\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        gs2 = s2_b[m._slots_from_utc_us(grid_us)] * m._subslot_modulation(grid_us, asset, True) * m._event_variance_multiplier(grid_us, asset)\n        cs = np.concatenate(([0.0], np.cumsum(gs2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n        r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        s2_g = gs2[g_sl]\n        ew_l2, ew_l1 = [], []\n        for lam in m.EWMA_LAMBDAS_6:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n        le = 0.70 * np.log(ew_l2) + 0.30 * np.log(ew_l1)\n        s0 = float(np.exp(np.dot(m.WEIGHTS_1H_START, le)))\n        s1 = float(np.exp(np.dot(m.WEIGHTS_1H_END, le)))\n        dec30 = np.exp(-(np.arange(60) + 0.5) / 30.0)\n        base_t = 1.05 * (s1 * ((s0 / s1) ** dec30))\n        fwd_us = int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 61, dtype=np.int64) * 60_000_000\n        fwd_slots = m._slots_from_utc_us(fwd_us)\n        fs2_base = s2_b[fwd_slots] * m._subslot_modulation(fwd_us, asset, True) * m._event_variance_multiplier(fwd_us, asset)\n        for lst, alpha in [(res_it5, 0.0), (res_a50, 0.50), (res_a75, 0.75), (res_a100, 1.00)]:\n            stp = base_t * np.sqrt(np.maximum(fs2_base, 1e-4)) * (c336_1h[fwd_slots] ** alpha)\n            shocks = np.zeros((200, 61))\n            shocks[:, 1:] = z1h * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 60, CRYPTO_1H.scoring_interv