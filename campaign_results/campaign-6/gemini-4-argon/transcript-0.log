{"type":"tool_use","timestamp":"2026-10-21T22:22:16.553Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_165181","parameters":{"description":"Compare log-volatility MSE of raw 7d std vs deseasonalized 7d vs deseasonalized multi-scale HAR-EWMA on 24h and 1h horizons across 2026-07-01 to 2026-09-05.","dir_path":"/workspace","command":"uv run python -c \"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices\n\nroot = Path('/workspace/market_data')\nfit_start = pd.Timestamp('2026-05-18', tz='UTC')\nfit_end = pd.Timestamp('2026-09-07', tz='UTC')\nall_assets = CRYPTO_24H.asset_list + COM_EQU_24H.asset_list\n\ndef get_structured_336(p):\n    cd = p['close'].dropna()\n    r = np.diff(np.log(cd.to_numpy(dtype=float))) * 10000.0\n    t_idx = cd.index[1:]\n    dt = np.diff(cd.index.view('int64')) / (60 * 1_000_000)\n    rate = (r**2) / np.maximum(dt, 1.0)\n    cap = np.percentile(rate[rate > 0], 98.0)\n    r2_c = np.minimum(rate, cap) * dt\n    slot_c = t_idx.dayofweek * 48 + t_idx.hour * 2 + (t_idx.minute // 30)\n    full_slot = p.index.dayofweek * 48 + p.index.hour * 2 + (p.index.minute // 30)\n    cal_mins = np.bincount(full_slot, minlength=336).astype(float)\n    raw = np.bincount(slot_c, weights=r2_c, minlength=336) / np.maximum(cal_mins, 1.0)\n    raw = np.maximum(raw, 1e-4 * np.mean(raw))\n    raw /= np.mean(raw)\n    grid = raw.reshape(7, 48)\n    wk_intraday = np.mean(grid[:5, :], axis=0)\n    dow_scale = 0.6 * (np.mean(grid[:5, :42], axis=1) / np.maximum(np.mean(wk_intraday[:42]), 1e-6)) + 0.4\n    model = np.zeros((7, 48))\n    for d in range(5):\n        model[d, :] = wk_intraday * dow_scale[d]\n    model[4, 42:] = 0.3 * grid[4, 42:] + 0.7 * np.mean(grid[4, 42:])\n    for d, sl in [(5, slice(0, 48)), (6, slice(0, 42))]:\n        seg = grid[d, sl]\n        sm = np.convolve(np.pad(seg, 1, mode='edge'), [0.25, 0.5, 0.25], mode='valid')\n        model[d, sl] = 0.4 * sm + 0.6 * np.mean(seg)\n    model[6, 42:] = 0.7 * grid[6, 42:] + 0.3 * wk_intraday[42:]\n    out = 0.85 * model.reshape(336) + 0.15 * raw\n    out /= np.mean(out)\n    return np.sqrt(out)\n\nfor asset in ['BTC', 'ETH', 'SOL', 'XRP', 'HYPE', 'XAU', 'NVDAX', 'AAPLX', 'WTIOIL', 'SP500']:\n    p = load_minute_prices(root, asset, fit_start, fit_end)\n    s336 = get_structured_336(p)\n    # Build 1-minute series of deseasonalized squared returns (with 0 on untraded minutes, or exact dropna)\n    # Wait: let's test on a 1-hour grid of prompts in July-Aug 2026\n    cd = p['close'].dropna()\n    r = np.diff(np.log(cd.to_numpy(dtype=float))) * 10000.0\n    t_idx = cd.index[1:]\n    dt = np.diff(cd.index.view('int64')) / (60 * 1_000_000)\n    slot = t_idx.dayofweek * 48 + t_idx.hour * 2 + (t_idx.minute // 30)\n    s2_bar = (s336[slot]**2) * dt\n    # Winsorize r^2 / s2_bar at 16x median\n    rate_ds = (r**2) / np.maximum(s2_bar, 1e-6)\n    cap_ds = np.percentile(rate_ds[rate_ds > 0], 98.5)\n    r2_win = np.minimum(rate_ds, cap_ds) * s2_bar\n    \n    # Evaluate on 400 timestamps between 2026-07-01 and 2026-09-05\n    eval_ts = pd.date_range('2026-07-01', '2026-09-05', freq='4h', tz='UTC')\n    errs_7d_raw, errs_7d_ds, errs_har_ds = [], [], []\n    errs_1h_raw, errs_1h_har = [], []\n    t_ns = t_idx.view('int64')\n    for ts in eval_ts:\n        ts_val = ts.value // 1000  # us\n        # Context: [ts - 7d, ts]\n        m_ctx = (t_ns >= ts_val - 7*86400*1_000_000) & (t_ns <= ts_val)\n        m_fwd24 = (t_ns > ts_val) & (t_ns <= ts_val + 86400*1_000_000)\n        m_fwd1 = (t_ns > ts_val) & (t_ns <= ts_val + 3600*1_000_000)\n        if m_ctx.sum() < 100 or m_fwd24.sum() < 20:\n            continue\n        # Realized deseasonalized sigma over next 24h and next 1h\n        # Wait: denominator is seasonal calendar time!\n        fwd24_slots = ((ts + pd.timedelta_range('1min', '1440min', freq='1min')).dayofweek * 48 +\n                       (ts + pd.timedelta_range('1min', '1440min', freq='1min')).hour * 2 +\n                       ((ts + pd.timedelta_range('1min', '1440min', freq='1min')).minute // 30))\n        denom_24 = np.sum(s336[fwd24_slots]**2)\n        real_sig24 = np.sqrt(np.sum(r2_win[m_fwd24]) / denom_24)\n        \n        fwd1_slots = fwd24_slots[:60]\n        denom_1 = np.sum(s336[fwd1_slots]**2)\n        real_sig1 = np.sqrt(np.sum(r2_win[m_fwd1]) / denom_1) if m_fwd1.sum() > 5 else np.nan\n        \n        # Starter 7d raw sigma\n        sig_7d_raw = np.std(r[m_ctx])\n        \n        # Deseasonalized EWMAs at half-lives: 30m, 120m, 720m, 2880m, 10080m\n        age_min = (ts_val - t_ns[m_ctx]) / (60 * 1_000_000)\n        r2_c = r2_win[m_ctx]\n        s2_c = s2_bar[m_ctx]\n        sigs = []\n        for hl in [30.0, 120.0, 720.0, 2880.0, 10080.0]:\n            w = np.exp(-np.log(2.0) * age_min / hl)\n            # Note: to account for untraded minutes, denominator uses effective seasonal time s2_c\n            sigs.append(np.sqrt(np.sum(w * r2_c) / np.sum(w * s2_c)))\n        sig_7d_ds = sigs[4]\n        sig_har_24 = 0.10 * sigs[0] + 0.20 * sigs[1] + 0.30 * sigs[2] + 0.25 * sigs[3] + 0.15 * sigs[4]\n        sig_har_1 = 0.30 * sigs[0] + 0.35 * sigs[1] + 0.20 * sigs[2] + 0.10 * sigs[3] + 0.05 * sigs[4]\n        \n        if real_sig24 > 0.1:\n            errs_7d_raw.append(np.log(sig_7d_raw / real_sig24)**2)\n            errs_7d_ds.append(np.log(sig_7d_ds / real_sig24)**2)\n            errs_har_ds.append(np.log(sig_har_24 / real_sig24)**2)\n        if np.isfinite(real_sig1) and real_sig1 > 0.1:\n            errs_1h_raw.append(np.log(sig_7d_raw / real_sig1)**2)\n            errs_1h_har.append(np.log(sig_har_1 / real_sig1)**2)\n    print(f'{asset:<8} 24h_LogMSE: raw7d={np.mean(errs_7d_raw):.4f} ds7d={np.mean(errs_7d_ds):.4f} dsHAR={np.mean(errs_har_ds):.4f} | 1h_LogMSE: raw7d={np.mean(errs_1h_raw):.4f} dsHAR={np.mean(errs_1h_har):.4f}')\n\""}}
