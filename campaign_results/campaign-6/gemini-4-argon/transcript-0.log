{"type":"tool_use","timestamp":"2026-10-21T23:00:20.095Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_254049","parameters":{"command":"uv run python -c \"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import brentq\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H, CRYPTO_1H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\nfit_start = pd.Timestamp('2026-05-18', tz='UTC')\nfit_end = pd.Timestamp('2026-08-15', tz='UTC')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\ndef slots_from_utc_us(ts_us):\n    total_mins = ts_us // 60_000_000\n    min_of_week = (total_mins + 3 * 1440) % 10080\n    return (min_of_week // 30).astype(np.int64)\n\ndef build_seas(p, l1_weight=0.0):\n    vals = p['close'].to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    rets = np.diff(np.log(vals[valid_pos]))\n    dt = np.diff(valid_pos).astype(np.float64)\n    rate = (rets ** 2) / np.maximum(dt, 1.0)\n    cap = np.percentile(rate[rate > 0], 98.0)\n    rate_c = np.minimum(rate, cap)\n    short = dt <= 15.0\n    t_us = p.index.as_unit('us').asi8\n    slot_end = slots_from_utc_us(t_us[valid_pos[1:]])\n    full_slot = slots_from_utc_us(t_us)\n    cal_mins = np.bincount(full_slot, minlength=336).astype(float)\n    \n    r2_short = rate_c[short] * dt[short]\n    raw_l2 = np.bincount(slot_end[short], weights=r2_short, minlength=336) / np.maximum(cal_mins, 1.0)\n    raw_l2 = np.maximum(raw_l2, 1e-4 * np.mean(raw_l2))\n    raw_l2 /= np.mean(raw_l2)\n    \n    if l1_weight > 0:\n        r1_short = np.abs(rets[short]) * np.sqrt(dt[short])\n        raw_l1 = (np.bincount(slot_end[short], weights=r1_short, minlength=336) / np.maximum(cal_mins, 1.0)) ** 2\n        raw_l1 = np.maximum(raw_l1, 1e-4 * np.mean(raw_l1))\n        raw_l1 /= np.mean(raw_l1)\n        raw = (1.0 - l1_weight) * raw_l2 + l1_weight * raw_l1\n        raw /= np.mean(raw)\n    else:\n        raw = raw_l2\n        \n    lt_var_1m = float(np.sum(rate_c * dt) / np.sum(cal_mins))\n    grid = raw.reshape(7, 48)\n    wk_intraday = np.mean(grid[:5, :], axis=0)\n    dow_scale = 0.6 * (np.mean(grid[:5, :42], axis=1) / np.maximum(np.mean(wk_intraday[:42]), 1e-6)) + 0.4\n    model = np.zeros((7, 48))\n    for d in range(5):\n        model[d, :] = wk_intraday * dow_scale[d]\n    model[4, 42:] = 0.3 * grid[4, 42:] + 0.7 * np.mean(grid[4, 42:])\n    for d, sl in [(5, slice(0, 48)), (6, slice(0, 42))]:\n        seg = grid[d, sl]\n        sm = np.convolve(np.pad(seg, 1, mode='edge'), [0.25, 0.5, 0.25], mode='valid')\n        model[d, sl] = 0.4 * sm + 0.6 * np.mean(seg)\n    model[6, 42:] = 0.7 * grid[6, 42:] + 0.3 * wk_intraday[42:]\n    out = 0.85 * model.reshape(336) + 0.15 * raw\n    out /= np.mean(out)\n    return np.sqrt(out), np.sqrt(lt_var_1m)\n\n# Evaluate CRPS on tune_start .. tune_end across scales c in [0.75, 0.80, 0.85, 0.90, 0.95, 1.00]\nfor asset in ['BTC', 'ETH', 'XRP', 'XAU', 'NVDAX', 'AAPLX', 'WTIOIL', 'SPCX', 'SP500']:\n    p_fit = load_minute_prices(root, asset, fit_start, fit_end)\n    s336, lt_sig = build_seas(p_fit, l1_weight=0.35)\n    s2_table = s336 ** 2\n    \n    p_tune = load_minute_prices(root, asset, tune_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=2))\n    store = RealizedPathStore(asset, 86400, 300)\n    # Collect 80 prompts from RealizedPathStore in tune_start .. tune_end\n    prompts = []\n    for f in sorted(store.root.glob('date=*.parquet')):\n        d_str = f.stem.split('=')[1]\n        if '2026-08-16' <= d_str <= '2026-09-05':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::6], df_p['prices'].iloc[::6]):\n                prompts.append((ts, np.asarray(arr, dtype=float)))\n    \n    rng = np.random.default_rng(42)\n    z_half = rng.standard_normal((100, 288))\n    z = np.vstack([z_half, -z_half])\n    z /= np.std(z, axis=0, keepdims=True)\n    \n    comp = CRYPTO_24H if asset in CRYPTO_24H.asset_list else COM_EQU_24H\n    scores_by_c = {c: [] for c in [0.75, 0.80, 0.85, 0.90, 0.95, 1.00]}\n    for ts, real in prompts:\n        ctx = p_tune.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = ctx.index.as_unit('us').asi8\n        grid_s2 = s2_table[slots_from_utc_us(grid_us)]\n        grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        \n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1]\n        ds2 = np.maximum(ds2, 1e-4)\n        rate_ds = (rets ** 2) / ds2\n        cap_ds = float(np.percentile(rate_ds[rate_ds > 0], 98.5))\n        r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        \n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar_min = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        s2_grid_active = grid_s2[g_slice]\n        \n        ewma_sigmas = []\n        for hl in (15.0, 60.0, 240.0, 1440.0, 10080.0):\n            lam = 0.6931471805599453 / hl\n            num = float(np.dot(np.exp(-lam * age_bar_min), r2_win))\n            den = float(np.dot(np.exp(-lam * age_grid_min), s2_grid_active))\n            ewma_sigmas.append(np.sqrt(max(num / max(den, 1e-6), 1e-12)))\n        log_ewma = np.log(ewma_sigmas)\n        sig_short = float(np.exp(np.dot([0.25, 0.30, 0.20, 0.15, 0.10], log_ewma)))\n        sig_long = float(np.exp(0.9 * np.dot([0.0, 0.05, 0.20, 0.35, 0.40], log_ewma) + 0.1 * np.log(lt_sig)))\n        \n        start_us = int(ts.as_unit('us').value)\n        fwd_us = start_us + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n        fwd_s2 = s2_table[slots_from_utc_us(fwd_us)].reshape(288, 5).sum(axis=1)\n        step_seas = np.sqrt(np.maximum(fwd_s2, 1e-4))\n        decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n        sig_base_t = sig_long * ((sig_short / sig_long) ** decay)\n        per_step = sig_base_t * step_seas\n        \n        for c in scores_by_c:\n            shocks = np.zeros((200, 289))\n            shocks[:, 1:] = z * (c * per_step)[None, :]\n            paths = last * np.exp(np.cumsum(shocks, axis=1))\n            sc, _ = calculate_total_score_for_miner(paths, real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n            scores_by_c[c].append(sc)\n    res_str = ' '.join(f'c={c:.2f}:{np.mean(scores_by_c[c]):7.1f}' for c in scores_by_c)\n    print(f'{asset:<8} ({len(prompts):2d}p) {res_str}')\n\"","description":"Evaluate CRPS across scale factors c in [0.75..1.00] on the pre-validation tune window 2026-08-16 to 2026-09-06.","dir_path":"/workspace"}}
