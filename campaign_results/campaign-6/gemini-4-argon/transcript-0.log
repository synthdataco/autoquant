{"type":"tool_use","timestamp":"2026-10-22T00:01:18.392Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_136003","parameters":{"command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_1H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\n\nroot = Path('/workspace/market_data')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\nc_1h, sig_p, sig_s = m.PARAMS_1H\nrng = np.random.default_rng(42)\neps = rng.standard_normal((100, 60))\neta = rng.standard_normal((100, 60))\neps = eps * np.exp(sig_s * eta - 0.5 * sig_s**2)\nq_z = m._stratified_normal_quantiles(100)\neps = eps * np.exp(sig_p * q_z - 0.5 * sig_p**2)[:, None]\nz = np.vstack([eps, -eps])\nz /= np.std(z, axis=0, keepdims=True)\n\nhls6 = (5.0, 15.0, 60.0, 240.0, 1440.0, 10080.0)\nlams6 = tuple(0.6931471805599453 / hl for hl in hls6)\n\nprint(f'{\\\"Asset\\\":<6} {\\\"Iter3\\\":>8} {\\\"Fast1H\\\":>8} {\\\"+L1_MAD\\\":>8} {\\\"+OHLC_Rng\\\":>10} {\\\"Combined\\\":>9}')\nfor asset in CRYPTO_1H.asset_list:\n    s2 = m._S2_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    p_tune = load_minute_prices(root, asset, tune_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=1))\n    times = pd.date_range(tune_start, tune_end, freq='3h', inclusive='left')\n    res = {k: [] for k in ['it3', 'fast', 'l1', 'rng', 'comb']}\n    for ts in times:\n        ctx = p_tune.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        real = p_tune['close'].loc[ts : ts + pd.Timedelta(seconds=3600)].to_numpy(dtype=float)\n        if len(real) != 61 or not np.isfinite(real).all():\n            continue\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        rets = np.diff(np.log(vals[valid_pos]))\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        grid_s2 = s2[m._slots_from_utc_us(grid_us)]\n        cs = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n        \n        # Robust L1 (MAD) term: sqrt(pi/2) * |rets| * sqrt(ds2)\n        r1_scaled = np.sqrt(np.pi / 2.0) * np.abs(rets) * np.sqrt(ds2)\n        \n        # OHLC range on valid bars\n        hi = ctx['high'].to_numpy(dtype=np.float64)[g_sl]\n        lo = ctx['low'].to_numpy(dtype=np.float64)[g_sl]\n        ok_hl = np.isfinite(hi) & np.isfinite(lo) & (lo > 0) & (hi >= lo)\n        hl_r2 = np.zeros_like(hi)\n        hl_r2[ok_hl] = (np.log(hi[ok_hl] / lo[ok_hl]) ** 2) / (4.0 * np.log(2.0))\n        s2_g = grid_s2[g_sl]\n        hl_rate = hl_r2 / np.maximum(s2_g, 1e-4)\n        if np.any(hl_rate > 0):\n            hl_cap = np.percentile(hl_rate[hl_rate > 0], 98.5)\n            hl_r2 = np.minimum(hl_rate, hl_cap) * s2_g\n        \n        ew_l2 = []\n        ew_l1 = []\n        ew_hl = []\n        for lam in lams6:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_scaled)) / den, 1e-6))\n            ew_hl.append(np.sqrt(max(float(np.dot(wg[ok_hl], hl_r2[ok_hl])) / max(float(np.dot(wg[ok_hl], s2_g[ok_hl])), 1e-6), 1e-12)))\n            \n        le_l2 = np.log(ew_l2)\n        le_l1 = np.log(ew_l1)\n        # Scale-anchored OHLC range: align 1440m HL to 1440m L2\n        le_hl = np.log(ew_hl) - np.log(ew_hl[4]) + le_l2[4]\n        \n        fwd_s2 = s2[m._slots_from_utc_us(int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 61, dtype=np.int64) * 60_000_000)]\n        seas_1h = np.sqrt(np.maximum(fwd_s2, 1e-4))\n        \n        # 1) Iter 3\n        sh_it3 = float(np.exp(np.dot(m.WEIGHTS_SHORT, le_l2[1:])))\n        lg_it3 = float(np.exp(0.9 * np.dot(m.WEIGHTS_LONG, le_l2[1:]) + 0.1 * np.log(lt_v)))\n        dec_it3 = np.exp(-(np.arange(60) + 0.5) / 360.0)\n        stp_it3 = (lg_it3 * ((sh_it3 / lg_it3) ** dec_it3)) * seas_1h\n        \n        # 2) Fast 1H: start at [0.20, 0.30, 0.25, 0.15, 0.05, 0.05] (5m, 15m, 60m, 240m, 1440m, 10080m)\n        # and decay with tau=30m toward [0.0, 0.10, 0.30, 0.30, 0.20, 0.10]\n        w_1h_0 = np.array([0.20, 0.30, 0.25, 0.15, 0.05, 0.05])\n        w_1h_60 = np.array([0.00, 0.10, 0.30, 0.30, 0.20, 0.10])\n        dec_fast = np.exp(-(np.arange(60) + 0.5) / 30.0)\n        s0_fast = float(np.exp(np.dot(w_1h_0, le_l2)))\n        s1_fast = float(np.exp(np.dot(w_1h_60, le_l2)))\n        stp_fast = (s1_fast * ((s0_fast / s1_fast) ** dec_fast)) * seas_1h\n        \n        # 3) +L1_MAD blend (70% L2 + 30% L1 in log space, with scale compensation 1.03)\n        le_hyb = 0.70 * le_l2 + 0.30 * le_l1 + np.log(1.03)\n        s0_l1 = float(np.exp(np.dot(w_1h_0, le_hyb)))\n        s1_l1 = float(np.exp(np.dot(w_1h_60, le_hyb)))\n        stp_l1 = (s1_l1 * ((s0_l1 / s1_l1) ** dec_fast)) * seas_1h\n        \n        # 4) +OHLC_Rng blend (70% L2 + 30% HL on fast scales)\n        le_rng = 0.70 * le_l2 + 0.30 * le_hl\n        s0_rng = float(np.exp(np.dot(w_1h_0, le_rng)))\n        s1_rng = float(np.exp(np.dot(w_1h_60, le_rng)))\n        stp_rng = (s1_rng * ((s0_rng / s1_rng) ** dec_fast)) * seas_1h\n        \n        # 5) Combined (55% L2 + 25% L1 + 20% HL)\n        le_comb = 0.55 * le_l2 + 0.25 * (le_l1 + np.log(1.08)) + 0.20 * le_hl\n        s0_c = float(np.exp(np.dot(w_1h_0, le_comb)))\n        s1_c = float(np.exp(np.dot(w_1h_60, le_comb)))\n        stp_comb = (s1_c * ((s0_c / s1_c) ** dec_fast)) * seas_1h\n        \n        for k, stp in [('it3', stp_it3), ('fast', stp_fast), ('l1', stp_l1), ('rng', stp_rng), ('comb', stp_comb)]:\n            shocks = np.zeros((200, 61))\n            shocks[:, 1:] = z * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 60, CRYPTO_1H.scoring_intervals, CRYPTO_1H.vol_scoring_blocks)\n            res[k].append(sc)\n    print(f'{asset:<6} {np.mean(res[\\\"it3\\\"]):8.2f} {np.mean(res[\\\"fast\\\"]):8.2f} {np.mean(res[\\\"l1\\\"]):8.2f} {np.mean(res[\\\"rng\\\"]):10.2f} {np.mean(res[\\\"comb\\\"]):9.2f}')\n\"","dir_path":"/workspace","description":"Test fast 5m EWMA + 30m intra-hour decay, L1 MAD blend, and OHLC range ratio on CRYPTO_1H (2026-08-16 to 2026-09-06)."}}
