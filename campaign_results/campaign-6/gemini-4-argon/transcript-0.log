{"type":"tool_use","timestamp":"2026-10-22T00:02:55.353Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_135543","parameters":{"command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\ndef make_ar1_innovations(n_sims, n_inc, sig_path, sig_step, rho, seed=42):\n    rng = np.random.default_rng(seed)\n    half = n_sims // 2\n    eps = rng.standard_normal((half, n_inc))\n    if rho != 0.0:\n        # Apply AR(1) filter along steps: x_t = rho * x_{t-1} + sqrt(1 - rho^2) * eps_t\n        ar = np.empty_like(eps)\n        ar[:, 0] = eps[:, 0]\n        s_rho = np.sqrt(1.0 - rho * rho)\n        for t in range(1, n_inc):\n            ar[:, t] = rho * ar[:, t - 1] + s_rho * eps[:, t]\n        eps = ar\n    if sig_step > 0:\n        eta = rng.standard_normal((half, n_inc))\n        eps = eps * np.exp(sig_step * eta - 0.5 * sig_step**2)\n    if sig_path > 0:\n        q_z = m._stratified_normal_quantiles(half)\n        eps = eps * np.exp(sig_path * q_z - 0.5 * sig_path**2)[:, None]\n    z = np.vstack([eps, -eps])\n    z /= np.std(z, axis=0, keepdims=True)\n    return z\n\nprint('=== 1. CRYPTO_1H Interval CRPS vs Scale c and AR(1) rho (BTC & ETH) ===')\nfor asset in ['BTC', 'ETH', 'SOL', 'XRP', 'HYPE']:\n    s2 = m._S2_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    p_tune = load_minute_prices(root, asset, tune_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=1))\n    times = pd.date_range(tune_start, tune_end, freq='4h', inclusive='left')\n    \n    z_r0 = make_ar1_innovations(200, 60, 0.30, 0.20, 0.0)\n    z_r05 = make_ar1_innovations(200, 60, 0.30, 0.20, 0.05)\n    z_r08 = make_ar1_innovations(200, 60, 0.30, 0.20, 0.08)\n    z_rn05 = make_ar1_innovations(200, 60, 0.30, 0.20, -0.05)\n    \n    configs = [\n        ('r0_c0.90', z_r0, 0.90),\n        ('r0_c0.95', z_r0, 0.95),\n        ('r0_c1.00', z_r0, 1.00),\n        ('r05_c0.94', z_r05, 0.94),\n        ('r08_c0.92', z_r08, 0.92),\n        ('rn05_c1.02', z_rn05, 1.02),\n    ]\n    tot_res = {k: [] for k, _, _ in configs}\n    int_res = {k: {} for k, _, _ in configs}\n    for ts in times:\n        ctx = p_tune.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        real = p_tune['close'].loc[ts : ts + pd.Timedelta(seconds=3600)].to_numpy(dtype=float)\n        if len(real) != 61 or not np.isfinite(real).all():\n            continue\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        rets = np.diff(np.log(vals[valid_pos]))\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        grid_s2 = s2[m._slots_from_utc_us(grid_us)]\n        cs = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n        ew = [np.sqrt(max(np.dot(np.exp(-lam * age_bar), r2) / max(np.dot(np.exp(-lam * age_grid), grid_s2[g_sl]), 1e-6), 1e-12)) for lam in m.EWMA_LAMBDAS]\n        le = np.log(ew)\n        sh = float(np.exp(np.dot(m.WEIGHTS_SHORT, le)))\n        lg = float(np.exp(0.9 * np.dot(m.WEIGHTS_LONG, le) + 0.1 * np.log(lt_v)))\n        decay = np.exp(-(np.arange(60) + 0.5) / 360.0)\n        fwd_fix = s2[m._slots_from_utc_us(int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 61, dtype=np.int64) * 60_000_000)]\n        stp_fix = (lg * ((sh / lg) ** decay)) * np.sqrt(np.maximum(fwd_fix, 1e-4))\n        for k, z_m, c_v in configs:\n            shocks = np.zeros((200, 61))\n            shocks[:, 1:] = z_m * (c_v * stp_fix)[None, :]\n            sc, det = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 60, CRYPTO_1H.scoring_intervals, CRYPTO_1H.vol_scoring_blocks)\n            tot_res[k].append(sc)\n            for d in det:\n                int_res[k].setdefault(d['Interval'], []).append(d['CRPS'])\n    print(f'{asset:<6} ' + ' '.join(f'{k}:{np.mean(tot_res[k]):7.2f}' for k, _, _ in configs))\n    if asset == 'BTC':\n        for iv in ['1min', '2min', '5min', '15min', '30min', '60min_abs', 'Gaps', 'Vol']:\n            print(f'   {iv:<10}: ' + ' '.join(f'{np.mean(int_res[k][iv]):7.2f}' for k, _, _ in configs))\n\"","description":"Analyze interval-by-interval CRPS on CRYPTO_1H across scale c and AR(1) correlation rho.","dir_path":"/workspace"}}
