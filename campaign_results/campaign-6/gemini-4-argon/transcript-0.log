{"type":"tool_use","timestamp":"2026-10-22T01:01:51.351Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_343950","parameters":{"dir_path":"/workspace","command":"uv run python -c \"\nimport os, sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nfrom synth_lib.preparation.event_calendar.events import CALENDAR_ENV, concerns\n\nroot = Path('/workspace/market_data')\ncal = pd.read_parquet(os.environ[CALENDAR_ENV])\ncal['dt'] = pd.to_datetime(cal['time_utc'], utc=True)\ncal['us'] = cal['dt'].map(lambda t: int(round(t.timestamp() * 1_000_000)))\n\ndef event_mult_s2(ts_us, asset, sub_cal):\n    mult = np.ones(len(ts_us), dtype=np.float64)\n    if sub_cal.empty:\n        return mult\n    t_min, t_max = int(ts_us[0]), int(ts_us[-1])\n    # Filter events overlapping [t_min - 6h, t_max + 1h]\n    rel = sub_cal[(sub_cal['us'] >= t_min - 6 * 3600_000_000) & (sub_cal['us'] <= t_max)]\n    for _, row in rel.iterrows():\n        ev = row['event']\n        ev_us = int(row['us'])\n        if ev == 'FOMC':\n            m_val = 2.10 if asset in m.SINGLE_EQUITY_ASSETS else (1.0 if asset == 'WTIOIL' else 3.40)\n            dur = 60 * 60_000_000\n        elif ev == 'NFP':\n            m_val = 2.10 if asset in (m.CRYPTO_ASSETS | {'XAU', 'SP500'}) else 1.0\n            dur = 30 * 60_000_000\n        elif ev == 'CPI':\n            m_val = 1.80 if asset != 'WTIOIL' else 1.0\n            dur = 30 * 60_000_000\n        elif ev == 'EARNINGS':\n            m_val = 12.0\n            dur = 90 * 60_000_000\n        elif ev == 'NYSE_CLOSED':\n            m_val = 0.25 if asset == 'SP500' else 0.05\n            dur = 390 * 60_000_000  # 13:30 to 20:00 UTC = 6.5h = 390m\n        elif ev == 'NYSE_EARLY_CLOSE':\n            m_val = 0.30 if asset == 'SP500' else 0.12\n            dur = 120 * 60_000_000\n        else:\n            continue\n        if m_val != 1.0:\n            mask = (ts_us > ev_us) & (ts_us <= ev_us + dur)\n            mult[mask] *= m_val\n    return mult\n\ndef make_z(n_sims, n_inc, sig_p, sig_s):\n    rng = np.random.default_rng(42)\n    half = n_sims // 2\n    eps = rng.standard_normal((half, n_inc)) * np.exp(sig_s * rng.standard_normal((half, n_inc)) - 0.5 * sig_s**2)\n    eps = eps * np.exp(sig_p * m._stratified_normal_quantiles(half) - 0.5 * sig_p**2)[:, None]\n    z = np.vstack([eps, -eps])\n    return z / np.std(z, axis=0, keepdims=True)\n\nfor asset in ['BTC', 'ETH', 'XAU', 'SP500', 'NVDAX', 'TSLAX', 'AAPLX']:\n    p = load_minute_prices(root, asset, pd.Timestamp('2026-06-15', tz='UTC'), pd.Timestamp('2026-09-08', tz='UTC'))\n    store = RealizedPathStore(asset, 86400, 300)\n    sub_cal = cal[(cal['dt'] >= '2026-06-22') & (cal['dt'] <= '2026-09-08') & concerns(cal, asset)]\n    target_evs = sub_cal[sub_cal['event'].isin(['FOMC', 'NFP', 'CPI', 'EARNINGS', 'NYSE_CLOSED'])]\n    \n    _, sig_p, sig_s = m._distribution_params(asset, 86400)\n    z24 = make_z(200, 288, sig_p, sig_s)\n    s2_b = m._S2_BACK_336[asset]\n    s2_f = m._S2_FWD_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    comp = CRYPTO_24H if asset in m.CRYPTO_ASSETS else COM_EQU_24H\n    \n    by_ev_base, by_ev_cal = {}, {}\n    for f in sorted(store.root.glob('date=*.parquet')):\n        d_str = f.stem.split('=')[1]\n        if '2026-06-22' <= d_str <= '2026-09-07':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::3], df_p['prices'].iloc[::3]):\n                ts_us = int(round(ts.timestamp() * 1_000_000))\n                # Check if [ts_us, ts_us + 86400s] spans any target event\n                spanned = target_evs[(target_evs['us'] >= ts_us) & (target_evs['us'] < ts_us + 86400_000_000)]\n                if spanned.empty:\n                    continue\n                ev_name = spanned['event'].iloc[0]\n                real = np.asarray(arr, dtype=float)\n                ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n                vals = ctx['close'].to_numpy(dtype=np.float64)\n                valid_pos = np.flatnonzero(np.isfinite(vals))\n                last = float(vals[valid_pos[-1]])\n                grid_us = m._index_to_utc_us(ctx.index)\n                rets = np.diff(np.log(vals[valid_pos]))\n                t_end_us = int(grid_us[-1])\n                valid_us = grid_us[valid_pos]\n                t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n                age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n                g_sl = slice(int(valid_pos[0]), len(grid_us))\n                age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n                fwd_us = ts_us + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n                fwd_slots = m._slots_from_utc_us(fwd_us)\n                decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n                \n                for use_cal, d_map in [(False, by_ev_base), (True, by_ev_cal)]:\n                    gs2 = s2_b[m._slots_from_utc_us(grid_us)]\n                    fs2 = s2_f[fwd_slots]\n                    if use_cal:\n                        gs2 = gs2 * event_mult_s2(grid_us, asset, sub_cal)\n                        fs2 = fs2 * event_mult_s2(fwd_us, asset, sub_cal)\n                    cs = np.concatenate(([0.0], np.cumsum(gs2)))\n                    ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n                    rate = (rets ** 2) / ds2\n                    r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n                    r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n                    s2_g = gs2[g_sl]\n                    ew_l2, ew_l1 = [], []\n                    for lam in m.EWMA_LAMBDAS_6:\n                        wb = np.exp(-lam * age_bar)\n                        wg = np.exp(-lam * age_grid)\n                        den = max(float(np.dot(wg, s2_g)), 1e-6)\n                        ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n                        ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n                    log_l2 = np.log(ew_l2)\n                    log_l1 = np.log(ew_l1)\n                    log_ew = (0.80 * log_l2 + 0.20 * (log_l1 + 0.20)) if asset in m.CRYPTO_ASSETS else log_l2\n                    sh = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, log_ew)))\n                    lg = float(np.exp(0.9 * np.dot(m.WEIGHTS_24H_LONG, log_ew) + 0.1 * np.log(lt_v)))\n                    base_t = 0.96 * (lg * ((sh / lg) ** decay))\n                    stp = base_t * np.sqrt(np.maximum(fs2.reshape(288, 5).sum(axis=1), 1e-4))\n                    shocks = np.zeros((200, 289))\n                    shocks[:, 1:] = z24 * stp[None, :]\n                    sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n                    d_map.setdefault(ev_name, []).append(sc)\n    print(f'=== {asset} Pre-Validation Event CRPS ===')\n    for ev in sorted(by_ev_base):\n        b_m = np.mean(by_ev_base[ev])\n        c_m = np.mean(by_ev_cal[ev])\n        print(f'  {ev:<14} (n={len(by_ev_base[ev]):2d}): Base={b_m:8.1f} -> +Cal={c_m:8.1f} (diff={c_m-b_m:+7.1f})')\n\"","description":"Test scheduled calendar event multipliers on pre-validation prompts spanning FOMC, NFP, CPI, EARNINGS, and NYSE_CLOSED (2026-06-22 to 2026-09-07)."}}
