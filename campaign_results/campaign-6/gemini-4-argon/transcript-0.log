p.maximum(np.mean(wk_intraday[:42]), 1e-6)) + 0.4\n    model = np.zeros((7, 48))\n    for d in range(5):\n        model[d, :] = wk_intraday * dow_scale[d]\n    model[4, 42:] = 0.3 * grid[4, 42:] + 0.7 * np.mean(grid[4, 42:])\n    for d, sl in [(5, slice(0, 48)), (6, slice(0, 42))]:\n        seg = grid[d, sl]\n        sm = np.convolve(np.pad(seg, 1, mode='edge'), [0.25, 0.5, 0.25], mode='valid')\n        model[d, sl] = 0.4 * sm + 0.6 * np.mean(seg)\n    model[6, 42:] = 0.7 * grid[6, 42:] + 0.3 * wk_intraday[42:]\n    out = 0.85 * model.reshape(336) + 0.15 * raw\n    out /= np.mean(out)\n    return np.sqrt(out), np.sqrt(lt_var_1m)\n\nrng = np.random.default_rng(42)\nz_half = rng.standard_normal((100, 60))\nz_norm = np.vstack([z_half, -z_half])\nz_norm /= np.std(z_norm, axis=0, keepdims=True)\n\nq_u = (np.arange(200) + 0.5) / 200.0\nz_sv35 = z_norm * np.exp(0.35 * norm.ppf(q_u) - 0.5 * 0.35**2)[:, None]\nz_sv35 /= np.std(z_sv35, axis=0, keepdims=True)\n\nt_half = student_t.rvs(df=8.0, size=(100, 60), random_state=42)\nz_t8 = np.vstack([t_half, -t_half])\nz_t8 /= np.std(z_t8, axis=0, keepdims=True)\nz_sv35_t8 = z_t8 * np.exp(0.35 * norm.ppf(q_u) - 0.5 * 0.35**2)[:, None]\nz_sv35_t8 /= np.std(z_sv35_t8, axis=0, keepdims=True)\n\nprint(f'{\\\"Asset\\\":<8} {\\\"Iter1(c=1)\\\":>11} {\\\"Norm(c=.88)\\\":>12} {\\\"SV35(c=.88)\\\":>12} {\\\"SV35_t8(.88)\\\":>13} {\\\"VolScore_It1->SV\\\":>18}')\nfor asset in CRYPTO_1H.asset_list:\n    p_fit = load_minute_prices(root, asset, fit_start, fit_end)\n    s_a, lt_a = build_seas_iter1(p_fit)\n    s2 = s_a ** 2\n    p_tune = load_minute_prices(root, asset, tune_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=1))\n    times = pd.date_range(tune_start, tune_end, freq='4h', inclusive='left')\n    res = {k: [] for k in ['it1', 'c88', 'sv35', 'sv35_t8', 'vol_it1', 'vol_sv']}\n    for ts in times:\n        ctx = p_tune.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        real = p_tune['close'].loc[ts : ts + pd.Timedelt