{"type":"tool_use","timestamp":"2026-10-21T22:16:09.514Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_146918","parameters":{"dir_path":"/workspace","command":"uv run python -c \"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices\n\nroot = Path('/workspace/market_data')\nstart_dt = pd.Timestamp('2026-06-25', tz='UTC')\nend_dt = pd.Timestamp('2026-09-07', tz='UTC')\nall_assets = CRYPTO_24H.asset_list + COM_EQU_24H.asset_list\n\nprint('=== 1. Variance Ratio sqrt(Var(r_k) / (k * Var(r_1))) on consecutive valid bars ===')\nprint(f'{\\\"Asset\\\":<8} {\\\"sig1m_elap\\\":>10} {\\\"VR_2m\\\":>7} {\\\"VR_5m\\\":>7} {\\\"VR_15m\\\":>7} {\\\"VR_30m\\\":>7} {\\\"VR_60m\\\":>7} {\\\"VR_180m\\\":>8} {\\\"MAD/STD_5m\\\":>11}')\nfor asset in all_assets:\n    p = load_minute_prices(root, asset, start_dt, end_dt)\n    c = p['close']\n    # Elapsed 1m sigma from dropna\n    cd = c.dropna()\n    r_d = np.diff(np.log(cd.to_numpy(dtype=float))) * 10000.0\n    dt_d = np.diff(cd.index.view('int64')) / (60 * 1_000_000)\n    sig1_elap = np.sqrt(np.sum(r_d**2) / np.sum(dt_d))\n    \n    # For k-min grid where no trade in a minute means price unchanged (as in RealizedPathStore):\n    cf = c.ffill().dropna()\n    arr = np.log(cf.to_numpy(dtype=float)) * 10000.0\n    vrs = {}\n    for k in [2, 5, 15, 30, 60, 180]:\n        rk = arr[k:] - arr[:-k]\n        sig_k = np.sqrt(np.mean(rk**2) / k)\n        vrs[k] = sig_k / sig1_elap\n    r5 = arr[5::5] - arr[:-5:5]\n    mad_std = (np.mean(np.abs(r5)) * np.sqrt(np.pi / 2.0)) / np.std(r5)\n    print(f'{asset:<8} {sig1_elap:10.3f} {vrs[2]:7.3f} {vrs[5]:7.3f} {vrs[15]:7.3f} {vrs[30]:7.3f} {vrs[60]:7.3f} {vrs[180]:8.3f} {mad_std:11.3f}')\n\"","description":"Measure variance ratios across horizons and MAD-to-STD ratios on pre-validation data (2026-06-25 to 2026-09-07)."}}
