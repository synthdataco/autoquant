(1.253314 * np.mean(np.abs(z5))) + 0.40 * np.sqrt(np.mean(z5**2))\n                if sig_3h <= 1e-6 or sig_24h <= 1e-6:\n                    continue\n                ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n                vals = ctx['close'].to_numpy(dtype=np.float64)\n                valid_pos = np.flatnonzero(np.isfinite(vals))\n                grid_us = m._index_to_utc_us(ctx.index)\n                rets = np.diff(np.log(vals[valid_pos]))\n                t_end_us = int(grid_us[-1])\n                valid_us = grid_us[valid_pos]\n                t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n                age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n                g_sl = slice(int(valid_pos[0]), len(grid_us))\n                age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n                grid_s2 = s2_b[m._slots_from_utc_us(grid_us)]\n                cs = np.concatenate(([0.0], np.cumsum(grid_s2)))\n                ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n                rate = (rets ** 2) / ds2\n                r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n                r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n                s2_g = grid_s2[g_sl]\n                \n                hi = ctx['high'].to_numpy(dtype=np.float64)[g_sl]\n                lo = ctx['low'].to_numpy(dtype=np.float64)[g_sl]\n                ok_hl = np.isfinite(hi) & np.isfinite(lo) & (lo > 0) & (hi >= lo)\n                hl_r2 = np.zeros_like(hi)\n                hl_r2[ok_hl] = (np.log(hi[ok_hl] / lo[ok_hl]) ** 2) / (4.0 * np.log(2.0))\n                hl_rate = hl_r2 / np.maximum(s2_g, 1e-4)\n                if np.any(hl_rate > 0):\n                    hl_r2 = np.minimum(hl_rate, np.percentile(hl_rate[hl_rate > 0], 98.5)) * s2_g\n                ew_l2, ew_l1, ew_hl = [], [], []\n                for lam in m.EWMA_LAMBDAS_6:\n                    wb = np.exp(-lam * age_bar)\n                    wg = np.exp(-lam * age_grid)\n                    den = max(float(np.dot(wg, s2_g)), 1e-6)\n                    ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n                    ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n                    ew_hl.append(np.sqrt(max(float(np.dot(wg[ok_hl], hl_r2[ok_hl])) / den, 1e-12)))\n                X_l2.append(np.log(ew_l2))\n                X_l1.append(np.log(ew_l1))\n                X_hl.append(np.log(ew_hl))\n                y_3h.append(np.log(sig_3h))\n                y_24h.append(np.log(sig_24h))\n    X_l2, X_l1, X_hl, y_3h, y_24h = map(np.array, (X_l2, X_l1, X_hl, y_3h, y_24h))\n    X_comb = 0.75 * X_l2 + 0.25 * X_hl\n    res24 = minimize(lambda p: np.mean((X_comb @ p[:6] + p[6] - y_24h)**2), [0.0, 0.1, 0.2, 0.25, 0.25, 0.2, 0.0], bounds=[(0,1)]*6 + [(-1,1)])\n    w24 = res24.x[:6] / np.sum(res24.x[:6])\n    mse_l2 = np.mean((X_l2 @ w24 + np.mean(y_24h - X_l2 @ w24) - y_24h)**2)\n    mse_cb = np.mean((X_comb @ w24 + np.mean(y_24h - X_comb @ w24) - y_24h)**2)\n    print(f'{asset:<8} w24={np.round(w24, 2)} | 24h_MSE: L2={mse_l2:.4f} -> L2+HL={mse_cb:.4f} | opt_scale={np.exp(np.mean(y_24h - X_comb @ w24)):.3f}')\n\"","description":"Fit optimal 24H multi-scale EWMA weights and compare close-to-close L2 vs L2+Parkinson-HL across all 13 assets on 2026-06-25 to 2026-08-14.","dir_path":"/workspace"}}
