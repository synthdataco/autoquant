{"type":"tool_use","timestamp":"2026-10-22T01:30:48.216Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_256507","parameters":{"description":"Test 5-minute block-binned MAD EWMA (compute_5m_mad_ewma) and reduced long-term prior drag on the pre-validation tune window (2026-08-16 to 2026-09-05).","command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\n\ndef compute_5m_mad_ewma(valid_pos, rets, grid_us, gs2, lams):\n    start_idx = int(valid_pos[0])\n    n_active = len(grid_us) - start_idx\n    n_blocks = n_active // 5\n    if n_blocks < 10:\n        return None\n    trim_start = len(grid_us) - n_blocks * 5\n    # Map each return (at valid_pos[1:]) into its 5-minute block [0 .. n_blocks-1]\n    ret_pos = valid_pos[1:]\n    in_range = ret_pos >= trim_start\n    b_idx = ((ret_pos[in_range] - trim_start) // 5).astype(np.int64)\n    b_idx = np.clip(b_idx, 0, n_blocks - 1)\n    r5_blk = np.bincount(b_idx, weights=rets[in_range], minlength=n_blocks)\n    \n    s2_blk = gs2[trim_start:].reshape(n_blocks, 5).sum(axis=1)\n    s2_blk = np.maximum(s2_blk, 1e-4)\n    # Clip extreme 5m block returns at 98.5th percentile\n    rate5 = (r5_blk ** 2) / s2_blk\n    if np.any(rate5 > 0):\n        cap5 = np.percentile(rate5[rate5 > 0], 98.5)\n        r5_abs_win = np.minimum(np.abs(r5_blk), np.sqrt(cap5 * s2_blk))\n    else:\n        r5_abs_win = np.abs(r5_blk)\n    \n    # Effective 1-minute MAD contribution of each 5m block:\n    # Since E|R_5m| = sqrt(2/pi) * sigma_1m * sqrt(s2_blk),\n    # 1.253314 * |R_5m| * sqrt(s2_blk) has expectation sigma_1m * s2_blk!\n    mad_num_blk = 1.2533141373155001 * r5_abs_win * np.sqrt(s2_blk)\n    age_blk_min = (np.arange(n_blocks - 1, -1, -1, dtype=np.float64) + 0.5) * 5.0\n    \n    ew_mad5 = np.empty(len(lams), dtype=np.float64)\n    for i, lam in enumerate(lams):\n        w = np.exp(-lam * age_blk_min)\n        ew_mad5[i] = max(float(np.dot(w, mad_num_blk)) / max(float(np.dot(w, s2_blk)), 1e-6), 1e-6)\n    return ew_mad5\n\ndef make_z(n_sims, n_inc, sig_p, sig_s):\n    rng = np.random.default_rng(42)\n    half = n_sims // 2\n    eps = rng.standard_normal((half, n_inc)) * np.exp(sig_s * rng.standard_normal((half, n_inc)) - 0.5 * sig_s**2)\n    eps = eps * np.exp(sig_p * m._stratified_normal_quantiles(half) - 0.5 * sig_p**2)[:, None]\n    z = np.vstack([eps, -eps])\n    return z / np.std(z, axis=0, keepdims=True)\n\nprint('=== Pre-Validation Tune Window (2026-08-16 .. 2026-09-05) CRPS: Iter5 vs +5mBlockMAD ===')\nfor asset in COM_EQU_24H.asset_list + CRYPTO_24H.asset_list:\n    _, sig_p, sig_s = m._distribution_params(asset, 86400)\n    z24 = make_z(200, 288, sig_p, sig_s)\n    s2_b = m._S2_BACK_336[asset]\n    s2_f = m._S2_FWD_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    p = load_minute_prices(root, asset, pd.Timestamp('2026-08-08', tz='UTC'), pd.Timestamp('2026-09-07', tz='UTC'))\n    store = RealizedPathStore(asset, 86400, 300)\n    prompts = []\n    for f in sorted(store.root.glob('date=*.parquet')):\n        ds = f.stem.split('=')[1]\n        if '2026-08-16' <= ds <= '2026-09-05':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::6], df_p['prices'].iloc[::6]):\n                prompts.append((ts, np.asarray(arr, dtype=float)))\n    comp = CRYPTO_24H if asset in m.CRYPTO_ASSETS else COM_EQU_24H\n    res = {k: [] for k in ['it5', 'mad5_w30', 'mad5_w45', 'mad5_w45_p02']}\n    for ts, real in prompts:\n        ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        gs2 = s2_b[m._slots_from_utc_us(grid_us)] * m._subslot_modulation(grid_us, asset, False) * m._event_variance_multiplier(grid_us, asset)\n        cs = np.concatenate(([0.0], np.cumsum(gs2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n        r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        s2_g = gs2[g_sl]\n        ew_l2, ew_l1 = [], []\n        for lam in m.EWMA_LAMBDAS_6:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n        ew_mad5 = compute_5m_mad_ewma(valid_pos, rets, grid_us, gs2, m.EWMA_LAMBDAS_6)\n        log_l2 = np.log(ew_l2)\n        log_l1 = np.log(ew_l1)\n        log_mad5 = np.log(ew_mad5)\n        \n        fwd_us = int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n        fwd_slots = m._slots_from_utc_us(fwd_us)\n        fs2 = (s2_f[fwd_slots] * m._subslot_modulation(fwd_us, asset, False) * m._event_variance_multiplier(fwd_us, asset)).reshape(288, 5).sum(axis=1)\n        seas_step = np.sqrt(np.maximum(fs2, 1e-4))\n        decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n        \n        # Iter 5\n        le5 = (0.80 * log_l2 + 0.20 * (log_l1 + 0.20)) if asset in m.CRYPTO_ASSETS else log_l2\n        sh5 = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, le5)))\n        lg5 = float(np.exp(0.9 * np.dot(m.WEIGHTS_24H_LONG, le5) + 0.1 * np.log(lt_v)))\n        b_it5 = 0.96 * (lg5 * ((sh5 / lg5) ** decay))\n        \n        # mad5_w30: 70% log_l2 + 30% (log_mad5 + offset) where offset=0.14 matches mean log_l2 on train\n        le_m30 = 0.70 * log_l2 + 0.30 * (log_mad5 + 0.14)\n        sh_30 = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, le_m30)))\n        lg_30 = float(np.exp(0.9 * np.dot(m.WEIGHTS_24H_LONG, le_m30) + 0.1 * np.log(lt_v)))\n        b_m30 = 0.96 * (lg_30 * ((sh_30 / lg_30) ** decay))\n        \n        # mad5_w45: 55% log_l2 + 45% (log_mad5 + 0.14)\n        le_m45 = 0.55 * log_l2 + 0.45 * (log_mad5 + 0.14)\n        sh_45 = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, le_m45)))\n        lg_45 = float(np.exp(0.9 * np.dot(m.WEIGHTS_24H_LONG, le_m45) + 0.1 * np.log(lt_v)))\n        b_m45 = 0.96 * (lg_45 * ((sh_45 / lg_45) ** decay))\n        \n        # mad5_w45_p02: same with prior weight 0.03 and faster long weights [0, 0, 0.08, 0.22, 0.40, 0.30]\n        w_lg2 = np.array([0.00, 0.00, 0.08, 0.22, 0.40, 0.30])\n        lg_45_p = float(np.exp(0.97 * np.dot(w_lg2, le_m45) + 0.03 * np.log(lt_v)))\n        b_m45_p = 0.96 * (lg_45_p * ((sh_45 / lg_45_p) ** decay))\n        \n        for k, bs in [('it5', b_it5), ('mad5_w30', b_m30), ('mad5_w45', b_m45), ('mad5_w45_p02', b_m45_p)]:\n            stp = bs * seas_step\n            shocks = np.zeros((200, 289))\n            shocks[:, 1:] = z24 * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n            res[k].append(sc)\n    print(f'{asset:<8} ' + ' '.join(f'{k}:{np.mean(res[k]):7.1f}' for k in res))\n\"","dir_path":"/workspace"}}
