{"type":"tool_use","timestamp":"2026-10-22T00:09:35.130Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_221820","parameters":{"command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\nfit_start = pd.Timestamp('2026-06-25', tz='UTC')\nfit_end = pd.Timestamp('2026-08-15', tz='UTC')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\nhls = (5.0, 15.0, 60.0, 240.0, 1440.0, 10080.0)\nlams = tuple(0.6931471805599453 / hl for hl in hls)\ntau0s = (10.0, 15.0, 15.0, 10.0, 0.0, 0.0)\n\ndef make_z(n_sims, n_inc, sig_p, sig_s):\n    rng = np.random.default_rng(42)\n    half = n_sims // 2\n    eps = rng.standard_normal((half, n_inc))\n    eta = rng.standard_normal((half, n_inc))\n    eps = eps * np.exp(sig_s * eta - 0.5 * sig_s**2)\n    q_z = m._stratified_normal_quantiles(half)\n    eps = eps * np.exp(sig_p * q_z - 0.5 * sig_p**2)[:, None]\n    z = np.vstack([eps, -eps])\n    z /= np.std(z, axis=0, keepdims=True)\n    return z\n\ndef compute_ewmas(ctx, s2, lt_v):\n    vals = ctx['close'].to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    grid_us = m._index_to_utc_us(ctx.index)\n    rets = np.diff(np.log(vals[valid_pos]))\n    t_end_us = int(grid_us[-1])\n    valid_us = grid_us[valid_pos]\n    t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n    age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n    g_sl = slice(int(valid_pos[0]), len(grid_us))\n    age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n    grid_s2 = s2[m._slots_from_utc_us(grid_us)]\n    cs = np.concatenate(([0.0], np.cumsum(grid_s2)))\n    ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n    rate = (rets ** 2) / ds2\n    r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n    \n    # Raw EWMAs (5m, 15m, 60m, 240m, 1440m, 10080m)\n    ew_raw = np.empty(6)\n    ew_shr = np.empty(6)\n    for idx in (5, 4, 3, 2, 1, 0):\n        lam = lams[idx]\n        wb = np.exp(-lam * age_bar)\n        wg = np.exp(-lam * age_grid)\n        num = float(np.dot(wb, r2))\n        den = float(np.dot(wg, grid_s2[g_sl]))\n        ew_raw[idx] = np.sqrt(max(num / max(den, 1e-6), 1e-12))\n        anchor_var = (lt_v ** 2) if idx == 5 else (ew_shr[idx + 1] ** 2)\n        t0 = tau0s[idx]\n        ew_shr[idx] = np.sqrt(max((num + t0 * anchor_var) / max(den + t0, 1e-6), 1e-12))\n    return float(vals[valid_pos[-1]]), ew_raw, ew_shr\n\n# Step 1: Fit Jensen debias offsets on fit_start..fit_end for ew_shr\ndebias_map = {}\nfor asset in CRYPTO_24H.asset_list + COM_EQU_24H.asset_list:\n    s2 = m._S2_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    p_fit = load_minute_prices(root, asset, fit_start - pd.Timedelta(days=8), fit_end)\n    times = pd.date_range(fit_start, fit_end, freq='6h', tz='UTC')\n    ls_list = []\n    for ts in times:\n        ctx = p_fit.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        _, _, ew_shr = compute_ewmas(ctx, s2, lt_v)\n        ls_list.append(np.log(ew_shr))\n    mean_ls = np.mean(ls_list, axis=0)\n    # Offset to align mean(log(ew_shr[k])) to mean(log(ew_shr[5]))\n    debias_map[asset] = mean_ls[5] - mean_ls\n\nprint('=== 1. CRYPTO_1H TUNE (2026-08-16 .. 2026-09-06) ===')\nz1h = make_z(200, 60, 0.30, 0.20)\nw1h_0 = np.array([0.15, 0.25, 0.25, 0.15, 0.10, 0.10])\nw1h_1 = np.array([0.00, 0.10, 0.25, 0.30, 0.20, 0.15])\nfor asset in CRYPTO_1H.asset_list:\n    s2 = m._S2_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    deb = debias_map[asset]\n    p_tune = load_minute_prices(root, asset, tune_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=1))\n    times = pd.date_range(tune_start, tune_end, freq='4h', inclusive='left')\n    res = {k: [] for k in ['it3', 'deb_1.00', 'deb_0.97', 'rms_0.97', 'lin_1.00']}\n    for ts in times:\n        ctx = p_tune.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        real = p_tune['close'].loc[ts : ts + pd.Timedelta(seconds=3600)].to_numpy(dtype=float)\n        if len(real) != 61 or not np.isfinite(real).all():\n            continue\n        last, ew_raw, ew_shr = compute_ewmas(ctx, s2, lt_v)\n        fwd_fix = s2[m._slots_from_utc_us(int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 61, dtype=np.int64) * 60_000_000)]\n        seas = np.sqrt(np.maximum(fwd_fix, 1e-4))\n        \n        # Iter 3\n        le_raw5 = np.log(ew_raw[1:])\n        sh3 = float(np.exp(np.dot(m.WEIGHTS_SHORT, le_raw5)))\n        lg3 = float(np.exp(0.9 * np.dot(m.WEIGHTS_LONG, le_raw5) + 0.1 * np.log(lt_v)))\n        stp_it3 = (lg3 * ((sh3 / lg3) ** np.exp(-(np.arange(60) + 0.5) / 360.0))) * seas\n        \n        # Debiased shrunk geometric\n        le_deb = np.log(ew_shr) + deb\n        dec1h = np.exp(-(np.arange(60) + 0.5) / 30.0)\n        s0_d = float(np.exp(np.dot(w1h_0, le_deb)))\n        s1_d = float(np.exp(np.dot(w1h_1, le_deb)))\n        stp_deb = (s1_d * ((s0_d / s1_d) ** dec1h)) * seas\n        \n        # RMS of ew_shr\n        s0_rms = float(np.sqrt(np.dot(w1h_0, ew_shr ** 2)))\n        s1_rms = float(np.sqrt(np.dot(w1h_1, ew_shr ** 2)))\n        stp_rms = (s1_rms * ((s0_rms / s1_rms) ** dec1h)) * seas\n        \n        # Linear of ew_shr\n        s0_lin = float(np.dot(w1h_0, ew_shr))\n        s1_lin = float(np.dot(w1h_1, ew_shr))\n        stp_lin = (s1_lin * ((s0_lin / s1_lin) ** dec1h)) * seas\n        \n        for k, stp in [('it3', stp_it3), ('deb_1.00', 1.00*stp_deb), ('deb_0.97', 0.97*stp_deb), ('rms_0.97', 0.97*stp_rms), ('lin_1.00', 1.00*stp_lin)]:\n            shocks = np.zeros((200, 61))\n            shocks[:, 1:] = z1h * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 60, CRYPTO_1H.scoring_intervals, CRYPTO_1H.vol_scoring_blocks)\n            res[k].append(sc)\n    print(f'{asset:<8} ' + ' '.join(f'{k}:{np.mean(res[k]):7.2f}' for k in res))\n\nprint('\\n=== 2. 24H TUNE (2026-08-16 .. 2026-09-06) ===')\nw24_0 = np.array([0.05, 0.20, 0.30, 0.20, 0.15, 0.10])\nw24_1 = np.array([0.00, 0.00, 0.05, 0.20, 0.35, 0.40])\nfor asset in CRYPTO_24H.asset_list + COM_EQU_24H.asset_list:\n    _, sig_p, sig_s = m._distribution_params(asset, 86400)\n    z24 = make_z(200, 288, sig_p, sig_s)\n    s2 = m._S2_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    deb = debias_map[asset]\n    p_tune = load_minute_prices(root, asset, tune_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=2))\n    store = RealizedPathStore(asset, 86400, 300)\n    prompts = []\n    for f in sorted(store.root.glob('date=*.parquet')):\n        d_str = f.stem.split('=')[1]\n        if '2026-08-16' <= d_str <= '2026-09-05':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::6], df_p['prices'].iloc[::6]):\n                prompts.append((ts, np.asarray(arr, dtype=float)))\n    comp = CRYPTO_24H if asset in CRYPTO_24H.asset_list else COM_EQU_24H\n    res = {k: [] for k in ['it3', 'deb_0.96', 'deb_0.93', 'rms_0.94', 'lin_0.96']}\n    for ts, real in prompts:\n        ctx = p_tune.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n        last, ew_raw, ew_shr = compute_ewmas(ctx, s2, lt_v)\n        fwd_fix = s2[m._slots_from_utc_us(int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000)].reshape(288, 5).sum(axis=1)\n        seas = np.sqrt(np.maximum(fwd_fix, 1e-4))\n        decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n        \n        le_raw5 = np.log(ew_raw[1:])\n        sh3 = float(np.exp(np.dot(m.WEIGHTS_SHORT, le_raw5)))\n        lg3 = float(np.exp(0.9 * np.dot(m.WEIGHTS_LONG, le_raw5) + 0.1 * np.log(lt_v)))\n        stp_it3 = 0.96 * (lg3 * ((sh3 / lg3) ** decay)) * seas\n        \n        le_deb = np.log(ew_shr) + deb\n        s0_d = float(np.exp(np.dot(w24_0, le_deb)))\n        s1_d = float(np.exp(0.9 * np.dot(w24_1, le_deb) + 0.1 * np.log(lt_v)))\n        stp_deb = (s1_d * ((s0_d / s1_d) ** decay)) * seas\n        \n        s0_rms = float(np.sqrt(np.dot(w24_0, ew_shr ** 2)))\n        s1_rms = float(np.exp(0.9 * np.log(np.sqrt(np.dot(w24_1, ew_shr ** 2))) + 0.1 * np.log(lt_v)))\n        stp_rms = (s1_rms * ((s0_rms / s1_rms) ** decay)) * seas\n        \n        s0_lin = float(np.dot(w24_0, ew_shr))\n        s1_lin = float(np.exp(0.9 * np.log(np.dot(w24_1, ew_shr)) + 0.1 * np.log(lt_v)))\n        stp_lin = (s1_lin * ((s0_lin / s1_lin) ** decay)) * seas\n        \n        for k, stp in [('it3', stp_it3), ('deb_0.96', 0.96*stp_deb), ('deb_0.93', 0.93*stp_deb), ('rms_0.94', 0.94*stp_rms), ('lin_0.96', 0.96*stp_lin)]:\n            shocks = np.zeros((200, 289))\n            shocks[:, 1:] = z24 * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n            res[k].append(sc)\n    print(f'{asset:<8} ' + ' '.join(f'{k}:{np.mean(res[k]):7.1f}' for k in res))\n\"","dir_path":"/workspace","description":"Compare Iteration 3 against Jensen-debiased geometric, RMS, and linear EWMA combinations on 2026-08-16 to 2026-09-06."}}
