{"type":"tool_use","timestamp":"2026-10-22T00:45:30.396Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_216277","parameters":{"command":"uv run python -c \"\nimport os\nfrom pathlib import Path\nimport pandas as pd\n\noffline_root = Path(os.environ['SYNTH_BACKTESTER_OFFLINE_DATA_ROOT'])\nfor win_name, t0, t1 in [('Window B (2026-10-01..2026-10-11)', '2026-10-01', '2026-10-11'), ('Window A (2026-09-15..2026-09-25)', '2026-09-15', '2026-09-25')]:\n    print(f'=== {win_name} Top Individual Miner Mean CRPS (min 90% prompt participation) ===')\n    for p in sorted(offline_root.glob('miner_scores_*.parquet')):\n        df = pd.read_parquet(p, columns=['scored_time', 'crps', 'miner_uid'])\n        df = df[(df['scored_time'] >= t0) & (df['scored_time'] <= t1) & (df['crps'] > 0)]\n        n_tot = df['scored_time'].nunique()\n        counts = df.groupby('miner_uid')['crps'].count()\n        full_miners = counts[counts >= 0.90 * n_tot].index\n        miner_means = df[df['miner_uid'].isin(full_miners)].groupby('miner_uid')['crps'].mean().sort_values()\n        oracle_best = df.groupby('scored_time')['crps'].min().mean()\n        print(f'  {p.stem.replace(\\\"miner_scores_\\\", \\\"\\\"):<24} oracle_prompt_min={oracle_best:8.2f} | #1_miner={miner_means.iloc[0]:8.2f} | #5_miner={miner_means.iloc[4]:8.2f} | median_miner={miner_means.median():8.2f}')\n\"","description":"Compare ex-post per-prompt oracle min CRPS against the actual #1, #5, and median individual miners in Window A and Window B.","dir_path":"/workspace"}}
