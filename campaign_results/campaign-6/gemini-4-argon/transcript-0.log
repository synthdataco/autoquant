{"type":"tool_use","timestamp":"2026-10-21T23:37:15.267Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_215720","parameters":{"description":"Compare Iteration 2 (with nanosecond start_us bug) vs fixed microsecond start_us and MAD-calibrated 336-slot seasonality on 2026-08-16 to 2026-09-05.","dir_path":"/workspace","command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\nfit_start = pd.Timestamp('2026-05-18', tz='UTC')\nfit_end = pd.Timestamp('2026-08-15', tz='UTC')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\ndef build_seas_sharp(p):\n    # Use 5-min step MAD & clipped RMS on pre-validation training data\n    c5 = p['close'].ffill().dropna().iloc[::5]\n    r5 = np.diff(np.log(c5.to_numpy(dtype=float)))\n    t_us = c5.index[1:].as_unit('us').asi8\n    slots = m._slots_from_utc_us(t_us)\n    counts = np.maximum(np.bincount(slots, minlength=336), 1).astype(float)\n    mad_5m = np.sqrt(np.pi / 2.0) * (np.bincount(slots, weights=np.abs(r5), minlength=336) / counts)\n    cap5 = np.percentile(r5**2, 98.5)\n    rms_5m = np.sqrt(np.bincount(slots, weights=np.minimum(r5**2, cap5), minlength=336) / counts)\n    # 60% MAD + 40% RMS directly targets CRPS scale in every slot!\n    raw_sig = 0.60 * mad_5m + 0.40 * rms_5m\n    raw_sig = np.maximum(raw_sig, 0.04 * np.mean(raw_sig))\n    grid = (raw_sig ** 2).reshape(7, 48)\n    # Pool Mon-Fri intraday 48 slots (without over-smoothing!)\n    wk_intraday = np.mean(grid[:5, :], axis=0)\n    dow_scale = 0.5 * (np.mean(grid[:5, :42], axis=1) / np.maximum(np.mean(wk_intraday[:42]), 1e-6)) + 0.5\n    model = np.zeros((7, 48))\n    for d in range(5):\n        model[d, :] = wk_intraday * dow_scale[d]\n    # Fri 21:00..24:00 (slots 42..47)\n    model[4, 42:] = 0.5 * grid[4, 42:] + 0.5 * np.mean(grid[4, 42:])\n    # Sat (5) and Sun 00:00..21:00 (6, :42)\n    for d, sl in [(5, slice(0, 48)), (6, slice(0, 42))]:\n        seg = grid[d, sl]\n        sm = np.convolve(np.pad(seg, 1, mode='edge'), [0.25, 0.5, 0.25], mode='valid')\n        model[d, sl] = 0.5 * sm + 0.5 * np.mean(seg)\n    # Sun 21:00..24:00 (slots 42..47)\n    model[6, 42:] = 0.8 * grid[6, 42:] + 0.2 * wk_intraday[42:]\n    out = 0.85 * model.reshape(336) + 0.15 * (raw_sig ** 2)\n    lt_sig_1m = float(np.sqrt(np.mean(out) / 5.0))\n    out /= np.mean(out)\n    return np.sqrt(out), lt_sig_1m\n\nprint(f'{\\\"Asset\\\":<8} {\\\"Bug_It2\\\":>9} {\\\"Fix_c92\\\":>9} {\\\"Fix_c96\\\":>9} {\\\"Sharp_c92\\\":>10} {\\\"Sharp_c96\\\":>10} {\\\"Sharp_c100\\\":>11}')\nfor asset in COM_EQU_24H.asset_list + CRYPTO_24H.asset_list:\n    p_fit = load_minute_prices(root, asset, fit_start, fit_end)\n    s_sh, lt_sh = build_seas_sharp(p_fit)\n    s2_it2 = m._S2_336[asset]\n    lt_it2 = m.LONG_TERM_SIGMA_1M[asset]\n    s2_sh = s_sh ** 2\n    \n    p_tune = load_minute_prices(root, asset, tune_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=2))\n    store = RealizedPathStore(asset, 86400, 300)\n    prompts = []\n    for f in sorted(store.root.glob('date=*.parquet')):\n        d_str = f.stem.split('=')[1]\n        if '2026-08-16' <= d_str <= '2026-09-05':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::6], df_p['prices'].iloc[::6]):\n                prompts.append((ts, np.asarray(arr, dtype=float)))\n    comp = CRYPTO_24H if asset in CRYPTO_24H.asset_list else COM_EQU_24H\n    c_it2, sig_p, sig_s = m._distribution_params(asset, 86400)\n    \n    rng = np.random.default_rng(42)\n    eps = rng.standard_normal((100, 288))\n    eta = rng.standard_normal((100, 288))\n    eps = eps * np.exp(sig_s * eta - 0.5 * sig_s**2)\n    q_z = m._stratified_normal_quantiles(100)\n    eps = eps * np.exp(sig_p * q_z - 0.5 * sig_p**2)[:, None]\n    z = np.vstack([eps, -eps])\n    z /= np.std(z, axis=0, keepdims=True)\n    \n    res = {k: [] for k in ['bug', 'fix92', 'fix96', 'sh92', 'sh96', 'sh100']}\n    for ts, real in prompts:\n        ctx = p_tune.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        rets = np.diff(np.log(vals[valid_pos]))\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n        \n        def run_step(s2_tab, lt_v, start_u):\n            grid_s2 = s2_tab[m._slots_from_utc_us(grid_us)]\n            cs = np.concatenate(([0.0], np.cumsum(grid_s2)))\n            ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n            rate = (rets ** 2) / ds2\n            r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n            ew = [np.sqrt(max(np.dot(np.exp(-lam * age_bar), r2) / max(np.dot(np.exp(-lam * age_grid), grid_s2[g_sl]), 1e-6), 1e-12)) for lam in m.EWMA_LAMBDAS]\n            le = np.log(ew)\n            sh = float(np.exp(np.dot(m.WEIGHTS_SHORT, le)))\n            lg = float(np.exp(0.9 * np.dot(m.WEIGHTS_LONG, le) + 0.1 * np.log(lt_v)))\n            fwd_us = start_u + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n            fwd_s2 = s2_tab[m._slots_from_utc_us(fwd_us)].reshape(288, 5).sum(axis=1)\n            return (lg * ((sh / lg) ** decay)) * np.sqrt(np.maximum(fwd_s2, 1e-4))\n            \n        stp_bug = c_it2 * run_step(s2_it2, lt_it2, int(ts.value))\n        stp_fix = run_step(s2_it2, lt_it2, int(ts.value // 1000))\n        stp_sh = run_step(s2_sh, lt_sh, int(ts.value // 1000))\n        \n        for k, stp in [\n            ('bug', stp_bug),\n            ('fix92', 0.92 * stp_fix),\n            ('fix96', 0.96 * stp_fix),\n            ('sh92', 0.92 * stp_sh),\n            ('sh96', 0.96 * stp_sh),\n            ('sh100', 1.00 * stp_sh),\n        ]:\n            shocks = np.zeros((200, 289))\n            shocks[:, 1:] = z * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n            res[k].append(sc)\n    print(f'{asset:<8} {np.mean(res[\\\"bug\\\"]):9.1f} {np.mean(res[\\\"fix92\\\"]):9.1f} {np.mean(res[\\\"fix96\\\"]):9.1f} {np.mean(res[\\\"sh92\\\"]):10.1f} {np.mean(res[\\\"sh96\\\"]):10.1f} {np.mean(res[\\\"sh100\\\"]):11.1f}')\n\""}}
