{"type":"tool_use","timestamp":"2026-10-22T00:51:02.285Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_164889","parameters":{"description":"Fit optimal 1H log-volatility weights on 2026-06-25 to 2026-08-15 and compare L2 vs L2+L1+Parkinson-HL log-MSE.","dir_path":"/workspace","command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import minimize\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\n\nroot = Path('/workspace/market_data')\nfit_start = pd.Timestamp('2026-06-25', tz='UTC')\nfit_end = pd.Timestamp('2026-08-15', tz='UTC')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\n# Fit OLS / L1 weights in log-space on 2026-06-25..2026-08-15 to predict realized 1h deseasonalized volatility!\nfor asset in CRYPTO_1H.asset_list:\n    s2_b = m._S2_BACK_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    p = load_minute_prices(root, asset, fit_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=1))\n    times = pd.date_range(fit_start, fit_end, freq='2h', tz='UTC')\n    X_l2, X_l1, X_hl, y_1h = [], [], [], []\n    for ts in times:\n        ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        real = p['close'].loc[ts : ts + pd.Timedelta(seconds=3600)].to_numpy(dtype=float)\n        if len(real) != 61 or not np.isfinite(real).all():\n            continue\n        r1_real = np.diff(np.log(real))\n        fwd_slots = m._slots_from_utc_us(int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 61, dtype=np.int64) * 60_000_000)\n        fwd_s2 = s2_b[fwd_slots]\n        # Realized CRPS-optimal 1m deseasonalized sigma over this hour:\n        # Use 60% MAD + 40% RMS\n        z_real = r1_real / np.sqrt(np.maximum(fwd_s2, 1e-4))\n        sig_real = 0.60 * (1.253314 * np.mean(np.abs(z_real))) + 0.40 * np.sqrt(np.mean(z_real**2))\n        if sig_real <= 1e-6:\n            continue\n            \n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        grid_us = m._index_to_utc_us(ctx.index)\n        rets = np.diff(np.log(vals[valid_pos]))\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        grid_s2 = s2_b[m._slots_from_utc_us(grid_us)]\n        cs = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n        r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n        s2_g = grid_s2[g_sl]\n        \n        hi = ctx['high'].to_numpy(dtype=np.float64)[g_sl]\n        lo = ctx['low'].to_numpy(dtype=np.float64)[g_sl]\n        ok_hl = np.isfinite(hi) & np.isfinite(lo) & (lo > 0) & (hi >= lo)\n        hl_r2 = np.zeros_like(hi)\n        hl_r2[ok_hl] = (np.log(hi[ok_hl] / lo[ok_hl]) ** 2) / (4.0 * np.log(2.0))\n        hl_rate = hl_r2 / np.maximum(s2_g, 1e-4)\n        hl_r2 = np.minimum(hl_rate, np.percentile(hl_rate[hl_rate > 0], 98.5)) * s2_g\n        \n        ew_l2, ew_l1, ew_hl = [], [], []\n        for lam in m.EWMA_LAMBDAS_6:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n            ew_hl.append(np.sqrt(max(float(np.dot(wg[ok_hl], hl_r2[ok_hl])) / den, 1e-12)))\n        X_l2.append(np.log(ew_l2))\n        X_l1.append(np.log(ew_l1))\n        X_hl.append(np.log(ew_hl))\n        y_1h.append(np.log(sig_real))\n    X_l2, X_l1, X_hl, y_1h = map(np.array, (X_l2, X_l1, X_hl, y_1h))\n    # Fit non-negative weights on [5m, 15m, 60m, 240m, 1440m, 10080m] for X_hyb = 0.50*X_l2 + 0.25*X_l1 + 0.25*X_hl\n    X_hyb = 0.50 * X_l2 + 0.25 * X_l1 + 0.25 * X_hl\n    def loss(params):\n        w = params[:6]\n        b = params[6]\n        return np.mean((X_hyb @ w + b - y_1h)**2)\n    res = minimize(loss, [0.1, 0.2, 0.25, 0.2, 0.15, 0.1, 0.0], bounds=[(0, 1)]*6 + [(-1, 1)])\n    w_opt = res.x[:6] / np.sum(res.x[:6])\n    mse_l2 = np.mean((X_l2 @ w_opt + np.mean(y_1h - X_l2 @ w_opt) - y_1h)**2)\n    mse_hyb = np.mean((X_hyb @ w_opt + np.mean(y_1h - X_hyb @ w_opt) - y_1h)**2)\n    print(f'{asset:<6} w_opt={np.round(w_opt, 3)} | LogMSE_L2={mse_l2:.4f} -> LogMSE_L2+L1+HL={mse_hyb:.4f}')\n\""}}
