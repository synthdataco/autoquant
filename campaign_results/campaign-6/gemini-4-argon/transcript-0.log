{"type":"tool_use","timestamp":"2026-10-21T22:19:19.152Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_211603","parameters":{"command":"uv run python -c \"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\nstart_dt = pd.Timestamp('2026-06-22', tz='UTC')\nend_dt = pd.Timestamp('2026-09-07', tz='UTC')\nall_assets = CRYPTO_24H.asset_list + COM_EQU_24H.asset_list\n\nfor asset in ['BTC', 'XAU', 'NVDAX', 'AAPLX', 'WTIOIL', 'SPCX', 'SP500']:\n    p = load_minute_prices(root, asset, start_dt, end_dt)\n    # Method 1: calendar-time denominator on dropna closes\n    cd = p['close'].dropna()\n    r = np.diff(np.log(cd.to_numpy(dtype=float))) * 10000.0\n    t_idx = cd.index[1:]\n    dt = np.diff(cd.index.view('int64')) / (60 * 1_000_000)\n    rate = (r**2) / np.maximum(dt, 1.0)\n    cap = np.percentile(rate[rate > 0], 99.5)\n    r2_c = np.minimum(rate, cap) * dt\n    slot_c = t_idx.dayofweek * 48 + t_idx.hour * 2 + (t_idx.minute // 30)\n    \n    # Total calendar minutes per slot in p.index\n    full_slot = p.index.dayofweek * 48 + p.index.hour * 2 + (p.index.minute // 30)\n    cal_mins = np.bincount(full_slot, minlength=336).astype(float)\n    var_m1 = np.bincount(slot_c, weights=r2_c, minlength=336) / np.maximum(cal_mins, 1.0)\n    var_m1 /= np.mean(var_m1)\n    \n    # Method 2: RealizedPathStore 5-min returns (robust MAD^2 and clipped L2)\n    store = RealizedPathStore(asset, 86400, 300)\n    r5_all, s5_all = [], []\n    for f in sorted(store.root.glob('date=*.parquet')):\n        d_str = f.stem.split('=')[1]\n        if '2026-06-22' <= d_str <= '2026-09-06':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True), df_p['prices']):\n                arr = np.asarray(arr, dtype=float)\n                r5 = np.diff(arr) / arr[:-1] * 10000.0\n                idx5 = pd.date_range(ts + pd.Timedelta(minutes=5), periods=len(r5), freq='5min')\n                sl5 = idx5.dayofweek * 48 + idx5.hour * 2 + (idx5.minute // 30)\n                ok = np.isfinite(r5)\n                r5_all.append(r5[ok])\n                s5_all.append(sl5[ok])\n    r5_cat = np.concatenate(r5_all)\n    s5_cat = np.concatenate(s5_all)\n    cap5 = np.percentile(r5_cat**2, 99.5)\n    var_m2 = np.bincount(s5_cat, weights=np.minimum(r5_cat**2, cap5), minlength=336) / np.maximum(np.bincount(s5_cat, minlength=336), 1)\n    var_m2 /= np.mean(var_m2)\n    \n    mad_m2 = (np.bincount(s5_cat, weights=np.abs(r5_cat), minlength=336) / np.maximum(np.bincount(s5_cat, minlength=336), 1))**2\n    mad_m2 /= np.mean(mad_m2)\n    \n    corr_12 = np.corrcoef(np.sqrt(var_m1), np.sqrt(var_m2))[0, 1]\n    corr_mad = np.corrcoef(np.sqrt(var_m2), np.sqrt(mad_m2))[0, 1]\n    print(f'{asset:<8} corr(M1_cal, M2_realized)={corr_12:.4f} corr(L2, MAD)={corr_mad:.4f} M1_min/max={np.sqrt(var_m1).min():.2f}/{np.sqrt(var_m1).max():.2f} M2_min/max={np.sqrt(var_m2).min():.2f}/{np.sqrt(var_m2).max():.2f} MAD_min/max={np.sqrt(mad_m2).min():.2f}/{np.sqrt(mad_m2).max():.2f}')\n\"","dir_path":"/workspace","description":"Compare 336-slot weekly seasonality profiles between calendar-normalized dropna returns and RealizedPathStore 5-minute returns."}}
