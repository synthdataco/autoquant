{"type":"tool_use","timestamp":"2026-10-21T22:20:19.528Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_161014","parameters":{"dir_path":"/workspace","command":"uv run python -c \"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices\n\nroot = Path('/workspace/market_data')\nt1_start, t1_end = pd.Timestamp('2026-05-18', tz='UTC'), pd.Timestamp('2026-07-15', tz='UTC')\nt2_start, t2_end = pd.Timestamp('2026-07-16', tz='UTC'), pd.Timestamp('2026-09-07', tz='UTC')\nall_assets = CRYPTO_24H.asset_list + COM_EQU_24H.asset_list\n\ndef raw_336(p):\n    cd = p['close'].dropna()\n    r = np.diff(np.log(cd.to_numpy(dtype=float))) * 10000.0\n    t_idx = cd.index[1:]\n    dt = np.diff(cd.index.view('int64')) / (60 * 1_000_000)\n    rate = (r**2) / np.maximum(dt, 1.0)\n    cap = np.percentile(rate[rate > 0], 99.0)\n    r2_c = np.minimum(rate, cap) * dt\n    slot_c = t_idx.dayofweek * 48 + t_idx.hour * 2 + (t_idx.minute // 30)\n    full_slot = p.index.dayofweek * 48 + p.index.hour * 2 + (p.index.minute // 30)\n    cal_mins = np.bincount(full_slot, minlength=336).astype(float)\n    v = np.bincount(slot_c, weights=r2_c, minlength=336) / np.maximum(cal_mins, 1.0)\n    v = np.maximum(v, 1e-4 * np.mean(v))\n    return np.sqrt(v / np.mean(v))\n\ndef structured_336(p):\n    raw = raw_336(p)**2  # shape (336,) = (7, 48)\n    grid = raw.reshape(7, 48)\n    # Weekday active intraday profile: Mon-Fri (rows 0..4), slots 0..41 (00:00..21:00 UTC)\n    wk_intraday = np.mean(grid[:5, :], axis=0)  # 48 slots pooled across Mon-Fri\n    # Day of week scale for Mon-Fri (over 00:00..21:00 UTC)\n    dow_scale = np.mean(grid[:5, :42], axis=1) / np.maximum(np.mean(wk_intraday[:42]), 1e-6)\n    model = np.zeros((7, 48))\n    for d in range(5):\n        model[d, :] = wk_intraday * dow_scale[d]\n    # Fri 21:00..24:00 (slots 42..47): blend toward weekend level\n    model[4, 42:] = 0.5 * grid[4, 42:] + 0.5 * np.mean(grid[4, 42:])\n    # Saturday (row 5) and Sunday before 21:00 (row 6, slots 0..41):\n    # Smooth weekend profile with 3-slot rolling average + shrinkage to day mean\n    for d, sl in [(5, slice(0, 48)), (6, slice(0, 42))]:\n        seg = grid[d, sl]\n        sm = np.convolve(np.pad(seg, 1, mode='edge'), [0.25, 0.5, 0.25], mode='valid')\n        model[d, sl] = 0.5 * sm + 0.5 * np.mean(seg)\n    # Sunday 21:00..24:00 (slots 42..47, Globex / futures open):\n    model[6, 42:] = 0.7 * grid[6, 42:] + 0.3 * wk_intraday[42:]\n    # Final empirical-Bayes blend: 75% structured + 25% raw\n    out = 0.75 * model.reshape(336) + 0.25 * raw\n    out /= np.mean(out)\n    return np.sqrt(out)\n\nprint(f'{\\\"Asset\\\":<8} {\\\"Corr(Raw1,Raw2)\\\":>16} {\\\"Corr(Str1,Raw2)\\\":>16} {\\\"MSE_log(Raw1,Raw2)\\\":>19} {\\\"MSE_log(Str1,Raw2)\\\":>19}')\nfor asset in all_assets:\n    p1 = load_minute_prices(root, asset, t1_start, t1_end)\n    p2 = load_minute_prices(root, asset, t2_start, t2_end)\n    r1, r2 = raw_336(p1), raw_336(p2)\n    s1 = structured_336(p1)\n    c_raw = np.corrcoef(r1, r2)[0, 1]\n    c_str = np.corrcoef(s1, r2)[0, 1]\n    mse_raw = np.mean((np.log(np.maximum(r1, 0.05)) - np.log(np.maximum(r2, 0.05)))**2)\n    mse_str = np.mean((np.log(np.maximum(s1, 0.05)) - np.log(np.maximum(r2, 0.05)))**2)\n    print(f'{asset:<8} {c_raw:16.4f} {c_str:16.4f} {mse_raw:19.4f} {mse_str:19.4f}')\n\"","description":"Test out-of-sample stability of structured vs raw 336-slot seasonality profiles across two disjoint pre-validation windows."}}
