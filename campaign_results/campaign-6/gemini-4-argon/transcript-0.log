{"type":"tool_use","timestamp":"2026-10-21T23:04:21.247Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_364718","parameters":{"description":"Compare Iteration 1 against V2 (5m-MAD log-space seasonality + Bayesian EWMA shrinkage + CRPS scale calibration) on 2026-08-16 to 2026-09-06.","dir_path":"/workspace","command":"uv run python -c \"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\nfit_start = pd.Timestamp('2026-05-18', tz='UTC')\nfit_end = pd.Timestamp('2026-08-15', tz='UTC')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\ndef slots_from_utc_us(ts_us):\n    total_mins = ts_us // 60_000_000\n    min_of_week = (total_mins + 3 * 1440) % 10080\n    return (min_of_week // 30).astype(np.int64)\n\ndef build_seas_iter1(p):\n    cd = p['close'].dropna()\n    r = np.diff(np.log(cd.to_numpy(dtype=float)))\n    t_idx = cd.index[1:]\n    dt = np.diff(cd.index.view('int64')) / (60 * 1_000_000)\n    rate = (r**2) / np.maximum(dt, 1.0)\n    cap = np.percentile(rate[rate > 0], 98.0)\n    r2_c = np.minimum(rate, cap) * dt\n    slot_c = t_idx.dayofweek * 48 + t_idx.hour * 2 + (t_idx.minute // 30)\n    full_slot = p.index.dayofweek * 48 + p.index.hour * 2 + (p.index.minute // 30)\n    cal_mins = np.bincount(full_slot, minlength=336).astype(float)\n    raw = np.bincount(slot_c, weights=r2_c, minlength=336) / np.maximum(cal_mins, 1.0)\n    lt_var_1m = float(np.sum(r2_c) / np.sum(cal_mins))\n    raw = np.maximum(raw, 1e-4 * np.mean(raw))\n    raw /= np.mean(raw)\n    grid = raw.reshape(7, 48)\n    wk_intraday = np.mean(grid[:5, :], axis=0)\n    dow_scale = 0.6 * (np.mean(grid[:5, :42], axis=1) / np.maximum(np.mean(wk_intraday[:42]), 1e-6)) + 0.4\n    model = np.zeros((7, 48))\n    for d in range(5):\n        model[d, :] = wk_intraday * dow_scale[d]\n    model[4, 42:] = 0.3 * grid[4, 42:] + 0.7 * np.mean(grid[4, 42:])\n    for d, sl in [(5, slice(0, 48)), (6, slice(0, 42))]:\n        seg = grid[d, sl]\n        sm = np.convolve(np.pad(seg, 1, mode='edge'), [0.25, 0.5, 0.25], mode='valid')\n        model[d, sl] = 0.4 * sm + 0.6 * np.mean(seg)\n    model[6, 42:] = 0.7 * grid[6, 42:] + 0.3 * wk_intraday[42:]\n    out = 0.85 * model.reshape(336) + 0.15 * raw\n    out /= np.mean(out)\n    return np.sqrt(out), np.sqrt(lt_var_1m)\n\ndef build_seas_5m_mad(p):\n    c5 = p['close'].ffill().dropna().iloc[::5]\n    r5 = np.diff(np.log(c5.to_numpy(dtype=float)))\n    t_us = c5.index[1:].as_unit('us').asi8\n    slots = slots_from_utc_us(t_us)\n    counts = np.maximum(np.bincount(slots, minlength=336), 1).astype(float)\n    mad_5m = np.sqrt(np.pi / 2.0) * (np.bincount(slots, weights=np.abs(r5), minlength=336) / counts)\n    cap5 = np.percentile(r5**2, 98.0)\n    rms_5m = np.sqrt(np.bincount(slots, weights=np.minimum(r5**2, cap5), minlength=336) / counts)\n    raw_sig = 0.75 * mad_5m + 0.25 * rms_5m\n    raw_sig = np.maximum(raw_sig, 0.03 * np.mean(raw_sig))\n    log_grid = np.log(raw_sig).reshape(7, 48)\n    wk_intraday_log = np.mean(log_grid[:5, :], axis=0)\n    dow_offset = 0.6 * (np.mean(log_grid[:5, :42], axis=1) - np.mean(wk_intraday_log[:42]))\n    model_log = np.zeros((7, 48))\n    for d in range(5):\n        model_log[d, :] = wk_intraday_log + dow_offset[d]\n    model_log[4, 42:] = 0.5 * log_grid[4, 42:] + 0.5 * np.mean(log_grid[4, 42:])\n    for d, sl in [(5, slice(0, 48)), (6, slice(0, 42))]:\n        seg = log_grid[d, sl]\n        sm = np.convolve(np.pad(seg, 1, mode='edge'), [0.25, 0.5, 0.25], mode='valid')\n        model_log[d, sl] = 0.5 * sm + 0.5 * np.mean(seg)\n    model_log[6, 42:] = 0.75 * log_grid[6, 42:] + 0.25 * wk_intraday_log[42:]\n    out_sig = np.exp(0.80 * model_log.reshape(336) + 0.20 * log_grid.reshape(336))\n    norm = np.sqrt(np.mean(out_sig ** 2))\n    s336 = out_sig / norm\n    lt_sig_1m = float(norm / np.sqrt(5.0))\n    return s336, lt_sig_1m\n\nrng = np.random.default_rng(42)\nz_half = rng.standard_normal((100, 288))\nz = np.vstack([z_half, -z_half])\nz /= np.std(z, axis=0, keepdims=True)\n\nfor asset in COM_EQU_24H.asset_list + CRYPTO_24H.asset_list:\n    p_fit = load_minute_prices(root, asset, fit_start, fit_end)\n    s_it1, lt_it1 = build_seas_iter1(p_fit)\n    s_mad, lt_mad = build_seas_5m_mad(p_fit)\n    \n    p_tune = load_minute_prices(root, asset, tune_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=2))\n    store = RealizedPathStore(asset, 86400, 300)\n    prompts = []\n    for f in sorted(store.root.glob('date=*.parquet')):\n        d_str = f.stem.split('=')[1]\n        if '2026-08-16' <= d_str <= '2026-09-05':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::6], df_p['prices'].iloc[::6]):\n                prompts.append((ts, np.asarray(arr, dtype=float)))\n    comp = CRYPTO_24H if asset in CRYPTO_24H.asset_list else COM_EQU_24H\n    c_cal = 0.87 if asset in CRYPTO_24H.asset_list else (0.76 if asset in ['AAPLX', 'SPCX', 'NVDAX'] else 0.82)\n    \n    sc_it1_list, sc_v2_list = [], []\n    for ts, real in prompts:\n        ctx = p_tune.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = ctx.index.as_unit('us').asi8\n        rets = np.diff(np.log(vals[valid_pos]))\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar_min = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        start_us = int(ts.as_unit('us').value)\n        fwd_us = start_us + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n        fwd_slots = slots_from_utc_us(fwd_us)\n        decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n        \n        # 1) Iter 1\n        s2_1 = s_it1 ** 2\n        grid_s2_1 = s2_1[slots_from_utc_us(grid_us)]\n        cs1 = np.concatenate(([0.0], np.cumsum(grid_s2_1)))\n        ds2_1 = np.maximum(cs1[valid_pos[1:]] - cs1[valid_pos[:-1]], 1e-4)\n        rate1 = (rets ** 2) / ds2_1\n        r2_1 = np.minimum(rate1, np.percentile(rate1[rate1 > 0], 98.5)) * ds2_1\n        ew1 = []\n        for hl in (15.0, 60.0, 240.0, 1440.0, 10080.0):\n            lam = 0.6931471805599453 / hl\n            num = float(np.dot(np.exp(-lam * age_bar_min), r2_1))\n            den = float(np.dot(np.exp(-lam * age_grid_min), grid_s2_1[g_slice]))\n            ew1.append(np.sqrt(max(num / max(den, 1e-6), 1e-12)))\n        le1 = np.log(ew1)\n        sh1 = float(np.exp(np.dot([0.25, 0.30, 0.20, 0.15, 0.10], le1)))\n        lg1 = float(np.exp(0.9 * np.dot([0.0, 0.05, 0.20, 0.35, 0.40], le1) + 0.1 * np.log(lt_it1)))\n        step1 = (lg1 * ((sh1 / lg1) ** decay)) * np.sqrt(np.maximum(s2_1[fwd_slots].reshape(288, 5).sum(axis=1), 1e-4))\n        shocks1 = np.zeros((200, 289)); shocks1[:, 1:] = z * step1[None, :]\n        sc1, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks1, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n        sc_it1_list.append(sc1)\n        \n        # 2) V2: s_mad + Bayesian shrinkage tau0 + c_cal\n        s2_2 = s_mad ** 2\n        # Floor s2 in deseasonalization at 0.10 so quiet slots don't explode rate_ds\n        s2_deseas = np.maximum(s2_2, 0.10)\n        grid_s2_2 = s2_deseas[slots_from_utc_us(grid_us)]\n        cs2 = np.concatenate(([0.0], np.cumsum(grid_s2_2)))\n        ds2_2 = np.maximum(cs2[valid_pos[1:] + 1] - cs2[valid_pos[:-1] + 1], 1e-4)\n        rate2 = (rets ** 2) / ds2_2\n        r2_2 = np.minimum(rate2, np.percentile(rate2[rate2 > 0], 98.0)) * ds2_2\n        # Compute 7d and 24h first to act as Bayesian anchor for fast EWMAs\n        ew2 = [0.0] * 5\n        hls = (15.0, 60.0, 240.0, 1440.0, 10080.0)\n        tau0s = (15.0, 20.0, 20.0, 10.0, 0.0)\n        for idx_h in (4, 3, 2, 1, 0):\n            hl = hls[idx_h]\n            tau0 = tau0s[idx_h]\n            anchor_var = (lt_mad ** 2) if idx_h == 4 else (ew2[min(idx_h + 1, 4)] ** 2)\n            lam = 0.6931471805599453 / hl\n            num = float(np.dot(np.exp(-lam * age_bar_min), r2_2)) + tau0 * anchor_var\n            den = float(np.dot(np.exp(-lam * age_grid_min), grid_s2_2[g_slice])) + tau0\n            ew2[idx_h] = np.sqrt(max(num / max(den, 1e-6), 1e-12))\n        le2 = np.log(ew2)\n        sh2 = float(np.exp(np.dot([0.25, 0.30, 0.20, 0.15, 0.10], le2)))\n        lg2 = float(np.exp(0.85 * np.dot([0.0, 0.05, 0.20, 0.35, 0.40], le2) + 0.15 * np.log(lt_mad)))\n        step2 = c_cal * (lg2 * ((sh2 / lg2) ** decay)) * np.sqrt(np.maximum(s2_2[fwd_slots].reshape(288, 5).sum(axis=1), 1e-4))\n        shocks2 = np.zeros((200, 289)); shocks2[:, 1:] = z * step2[None, :]\n        sc2, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks2, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n        sc_v2_list.append(sc2)\n    print(f'{asset:<8} Iter1_CRPS={np.mean(sc_it1_list):8.2f} -> V2_CRPS={np.mean(sc_v2_list):8.2f} (diff={np.mean(sc_v2_list)-np.mean(sc_it1_list):+7.2f})')\n\""}}
