p.exp(-lam * age_bar), r2) / max(np.dot(np.exp(-lam * age_grid), grid_s2[g_sl]), 1e-6), 1e-12)) for lam in m.EWMA_LAMBDAS]\n        le = np.log(ew)\n        sh = float(np.exp(np.dot(m.WEIGHTS_SHORT, le)))\n        lg = float(np.exp(0.9 * np.dot(m.WEIGHTS_LONG, le) + 0.1 * np.log(lt_v)))\n        decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n        fwd_fix = s2[m._slots_from_utc_us(int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000)].reshape(288, 5).sum(axis=1)\n        stp_fix = (lg * ((sh / lg) ** decay)) * np.sqrt(np.maximum(fwd_fix, 1e-4))\n        for c in c_grid:\n            shocks = np.zeros((200, 289))\n            shocks[:, 1:] = z24 * (c * stp_fix)[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n            res[c].append(sc)\n    print(f'{asset:<8} ' + ' '.join(f'c={c:.2f}:{np.mean(res[c]):7.1f}' for c in c_grid))\n\""}}
