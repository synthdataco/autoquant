{"type":"tool_use","timestamp":"2026-10-22T00:58:14.944Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_229285","parameters":{"command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\nfit_start = pd.Timestamp('2026-05-18', tz='UTC')\nfit_end = pd.Timestamp('2026-08-15', tz='UTC')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\ndef make_z(n_sims, n_inc, sig_p, sig_s):\n    rng = np.random.default_rng(42)\n    half = n_sims // 2\n    eps = rng.standard_normal((half, n_inc)) * np.exp(sig_s * rng.standard_normal((half, n_inc)) - 0.5 * sig_s**2)\n    eps = eps * np.exp(sig_p * m._stratified_normal_quantiles(half) - 0.5 * sig_p**2)[:, None]\n    z = np.vstack([eps, -eps])\n    return z / np.std(z, axis=0, keepdims=True)\n\nprint('=== 1. CRYPTO_1H: Testing 60-Minute Within-Hour Sawtooth Modulation (2026-08-16..2026-09-06) ===')\nz1h = make_z(200, 60, 0.30, 0.20)\nfor asset in CRYPTO_1H.asset_list:\n    p = load_minute_prices(root, asset, fit_start, tune_end + pd.Timedelta(days=1))\n    # Fit 60-min profile on fit_start..fit_end\n    cd_fit = p['close'].loc[fit_start:fit_end].dropna()\n    r1_fit = np.abs(np.diff(np.log(cd_fit.to_numpy(dtype=float))))\n    moh = cd_fit.index[1:].minute\n    m60 = np.array([np.mean(r1_fit[moh == k]) for k in range(60)])\n    # Normalize each half-hour (0..29 and 30..59) so mean(m60^2) = 1.0 within each half-hour!\n    m60_2 = m60 ** 2\n    m60_2[:30] /= np.mean(m60_2[:30])\n    m60_2[30:] /= np.mean(m60_2[30:])\n    \n    s2_b = m._S2_BACK_336[asset]\n    times = pd.date_range(tune_start, tune_end, freq='2h', inclusive='left')\n    res_base, res_m60 = [], []\n    for ts in times:\n        ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        real = p['close'].loc[ts : ts + pd.Timedelta(seconds=3600)].to_numpy(dtype=float)\n        if len(real) != 61 or not np.isfinite(real).all():\n            continue\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        rets = np.diff(np.log(vals[valid_pos]))\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        grid_s2 = s2_b[m._slots_from_utc_us(grid_us)]\n        cs = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n        r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n        s2_g = grid_s2[g_sl]\n        ew_l2, ew_l1 = [], []\n        for lam in m.EWMA_LAMBDAS_6:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n        le = 0.70 * np.log(ew_l2) + 0.30 * np.log(ew_l1)\n        s0 = float(np.exp(np.dot(m.WEIGHTS_1H_START, le)))\n        s1 = float(np.exp(np.dot(m.WEIGHTS_1H_END, le)))\n        dec30 = np.exp(-(np.arange(60) + 0.5) / 30.0)\n        base_t = 1.05 * (s1 * ((s0 / s1) ** dec30))\n        \n        fwd_us = int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 61, dtype=np.int64) * 60_000_000\n        fwd_slots = m._slots_from_utc_us(fwd_us)\n        fwd_moh = ((fwd_us // 60_000_000) % 60).astype(np.int64)\n        \n        stp_base = base_t * np.sqrt(np.maximum(s2_b[fwd_slots], 1e-4))\n        stp_m60 = base_t * np.sqrt(np.maximum(s2_b[fwd_slots] * m60_2[fwd_moh], 1e-4))\n        \n        for lst, stp in [(res_base, stp_base), (res_m60, stp_m60)]:\n            shocks = np.zeros((200, 61))\n            shocks[:, 1:] = z1h * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 60, CRYPTO_1H.scoring_intervals, CRYPTO_1H.vol_scoring_blocks)\n            lst.append(sc)\n    print(f'{asset:<6} Iter4_Base={np.mean(res_base):8.2f} -> +MinOfHour60={np.mean(res_m60):8.2f} (diff={np.mean(res_m60)-np.mean(res_base):+6.2f})')\n\nprint('\\n=== 2. 24H: Testing 288-Slot 5-Minute Weekday Sub-Half-Hour Modulation (2026-08-16..2026-09-06) ===')\nfor asset in COM_EQU_24H.asset_list + CRYPTO_24H.asset_list:\n    p = load_minute_prices(root, asset, fit_start, tune_end + pd.Timedelta(days=2))\n    # Fit 288-slot weekday 5m sub-modulation on fit_start..fit_end\n    c5_fit = p['close'].loc[fit_start:fit_end].ffill().dropna().iloc[::5]\n    r5_fit = np.abs(np.diff(np.log(c5_fit.to_numpy(dtype=float))))\n    idx5 = c5_fit.index[1:]\n    wk = idx5.dayofweek < 5\n    r5_w, idx_w = r5_fit[wk], idx5[wk]\n    slot288 = idx_w.hour * 12 + (idx_w.minute // 5)\n    sub288 = np.array([np.mean(r5_w[slot288 == k]) if np.any(slot288 == k) else 1.0 for k in range(288)])\n    sub288_2 = (sub288 ** 2).reshape(48, 6)\n    sub288_2 /= np.maximum(np.mean(sub288_2, axis=1, keepdims=True), 1e-8)\n    # Smooth slightly: 75% empirical + 25% flat 1.0\n    sub288_2 = (0.75 * sub288_2 + 0.25 * 1.0).reshape(288)\n    \n    _, sig_p, sig_s = m._distribution_params(asset, 86400)\n    z24 = make_z(200, 288, sig_p, sig_s)\n    s2_b = m._S2_BACK_336[asset]\n    s2_f = m._S2_FWD_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    store = RealizedPathStore(asset, 86400, 300)\n    prompts = []\n    for f in sorted(store.root.glob('date=*.parquet')):\n        d_str = f.stem.split('=')[1]\n        if '2026-08-16' <= d_str <= '2026-09-05':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::6], df_p['prices'].iloc[::6]):\n                prompts.append((ts, np.asarray(arr, dtype=float)))\n    comp = CRYPTO_24H if asset in CRYPTO_24H.asset_list else COM_EQU_24H\n    res_base, res_sub = [], []\n    for ts, real in prompts:\n        ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        rets = np.diff(np.log(vals[valid_pos]))\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        grid_s2 = s2_b[m._slots_from_utc_us(grid_us)]\n        cs = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n        r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n        s2_g = grid_s2[g_sl]\n        ew_l2, ew_l1 = [], []\n        for lam in m.EWMA_LAMBDAS_6:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n        log_l2 = np.log(ew_l2)\n        log_l1 = np.log(ew_l1)\n        log_ew = (0.80 * log_l2 + 0.20 * (log_l1 + 0.20)) if asset in m.CRYPTO_ASSETS else log_l2\n        sh = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, log_ew)))\n        lg = float(np.exp(0.9 * np.dot(m.WEIGHTS_24H_LONG, log_ew) + 0.1 * np.log(lt_v)))\n        decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n        base_t = 0.96 * (lg * ((sh / lg) ** decay))\n        \n        fwd_us = int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n        fwd_slots = m._slots_from_utc_us(fwd_us)\n        total_mins = fwd_us // 60_000_000\n        min_of_week = (total_mins + 3 * 1440) % 10080\n        is_wk = (min_of_week // 1440) < 5\n        slot5 = ((min_of_week % 1440) // 5).astype(np.int64)\n        mod5 = np.where(is_wk, sub288_2[slot5], 1.0)\n        \n        stp_base = base_t * np.sqrt(np.maximum(s2_f[fwd_slots].reshape(288, 5).sum(axis=1), 1e-4))\n        stp_sub = base_t * np.sqrt(np.maximum((s2_f[fwd_slots] * mod5).reshape(288, 5).sum(axis=1), 1e-4))\n        for lst, stp in [(res_base, stp_base), (res_sub, stp_sub)]:\n            shocks = np.zeros((200, 289))\n            shocks[:, 1:] = z24 * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n            lst.append(sc)\n    print(f'{asset:<8} Iter4_Base={np.mean(res_base):8.2f} -> +Sub288={np.mean(res_sub):8.2f} (diff={np.mean(res_sub)-np.mean(res_base):+6.2f})')\n\"","dir_path":"/workspace","description":"Evaluate 60-minute within-hour sawtooth modulation on CRYPTO_1H and 288-slot 5m weekday sub-modulation on 24H across 2026-08-16 to 2026-09-06."}}
