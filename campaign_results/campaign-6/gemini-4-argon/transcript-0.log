{"type":"tool_use","timestamp":"2026-10-22T00:47:22.199Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_259653","parameters":{"dir_path":"/workspace","command":"uv run python -c \"\nimport sys, os, tempfile, shutil\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nfrom datetime import datetime, timezone\nimport numpy as np\nimport pandas as pd\nimport predict as pr\n\nend = datetime.fromisoformat('2026-09-30').replace(tzinfo=timezone.utc)\ndays = 7\n\nfor asset, tl, ti in [('BTC', 3600, 60), ('ETH', 3600, 60), ('AAPLX', 86400, 300), ('SPCX', 86400, 300), ('TSLAX', 86400, 300)]:\n    times = pr.prompt_times(asset, end, days, tl, ti)\n    out_dir = Path(tempfile.mkdtemp(prefix=f'diag2-{asset}-', dir=pr.PREDICTIONS_ROOT))\n    try:\n        pr.generate(asset, times, out_dir, ti, tl, 400)\n        pr._bo.calculate_smoothed_scores = lambda *a, **kw: pd.DataFrame(columns=['miner_uid', 'new_smoothed_score', 'updated_at'])\n        pr._bo._trim_warmup = lambda df, *a, **kw: df\n        res = pr.backtest(\n            miner_name='campaign', asset=asset, time_length=tl, time_increment=ti,\n            n_backtest_days=days, predictions_dir=out_dir, eval_end=end, latest_formula=True\n        )\n        df = res.prompt_df[res.prompt_df['crps'] > 0]\n        n_tot = df['scored_time'].nunique()\n        counts = df.groupby('miner_uid')['crps'].count()\n        full_uids = counts[counts >= 0.90 * n_tot].index\n        miner_means = df[df['miner_uid'].isin(full_uids)].groupby('miner_uid')['crps'].mean().sort_values()\n        top1_uid = miner_means.index[0]\n        top3_uid = miner_means.index[min(2, len(miner_means)-1)]\n        ours = df[df['miner_id'] == 999].set_index('scored_time')['crps']\n        top1 = df[df['miner_uid'] == top1_uid].set_index('scored_time')['crps']\n        common = ours.index.intersection(top1.index)\n        diff = ours.loc[common] - top1.loc[common]\n        print(f'=== {asset} (tl={tl}) 2026-09-23..2026-09-30: Ours={ours.mean():.2f} | #1(uid={top1_uid})={miner_means.iloc[0]:.2f} | #3={miner_means.iloc[min(2,len(miner_means)-1)]:.2f} | #5={miner_means.iloc[min(4,len(miner_means)-1)]:.2f} | Med={miner_means.median():.2f} ===')\n        # Group by quartiles of top1 CRPS (proxy for realized move size)\n        q_bins = pd.qcut(top1.loc[common], 4, labels=['Q1_Calm', 'Q2_Low', 'Q3_Med', 'Q4_HighVol'])\n        for q, grp in diff.groupby(q_bins, observed=False):\n            print(f'  {q:<12}: mean_diff(Ours - #1) = {grp.mean():+7.2f} (win_rate={(grp < 0).mean()*100:4.1f}%)')\n    finally:\n        shutil.rmtree(out_dir, ignore_errors=True)\n\"","description":"Compare Iteration 4 against top individual miners on 2026-09-23 to 2026-09-30 across realized volatility quartiles."}}
