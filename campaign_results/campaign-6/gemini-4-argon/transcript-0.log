{"type":"tool_use","timestamp":"2026-10-21T22:21:23.441Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_227146","parameters":{"command":"uv run python -c \"\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices\n\nroot = Path('/workspace/market_data')\nt1_start, t1_end = pd.Timestamp('2026-05-18', tz='UTC'), pd.Timestamp('2026-07-15', tz='UTC')\nt2_start, t2_end = pd.Timestamp('2026-07-16', tz='UTC'), pd.Timestamp('2026-09-07', tz='UTC')\nall_assets = CRYPTO_24H.asset_list + COM_EQU_24H.asset_list\n\ndef raw_336(p, pct=98.0):\n    cd = p['close'].dropna()\n    r = np.diff(np.log(cd.to_numpy(dtype=float))) * 10000.0\n    t_idx = cd.index[1:]\n    dt = np.diff(cd.index.view('int64')) / (60 * 1_000_000)\n    rate = (r**2) / np.maximum(dt, 1.0)\n    cap = np.percentile(rate[rate > 0], pct)\n    r2_c = np.minimum(rate, cap) * dt\n    slot_c = t_idx.dayofweek * 48 + t_idx.hour * 2 + (t_idx.minute // 30)\n    full_slot = p.index.dayofweek * 48 + p.index.hour * 2 + (p.index.minute // 30)\n    cal_mins = np.bincount(full_slot, minlength=336).astype(float)\n    v = np.bincount(slot_c, weights=r2_c, minlength=336) / np.maximum(cal_mins, 1.0)\n    v = np.maximum(v, 1e-4 * np.mean(v))\n    return np.sqrt(v / np.mean(v))\n\ndef structured_336(p):\n    raw = raw_336(p, pct=98.0)**2\n    grid = raw.reshape(7, 48)\n    wk_intraday = np.mean(grid[:5, :], axis=0)\n    dow_scale = np.mean(grid[:5, :42], axis=1) / np.maximum(np.mean(wk_intraday[:42]), 1e-6)\n    # shrink dow_scale slightly toward 1.0\n    dow_scale = 0.6 * dow_scale + 0.4 * 1.0\n    model = np.zeros((7, 48))\n    for d in range(5):\n        model[d, :] = wk_intraday * dow_scale[d]\n    model[4, 42:] = 0.3 * grid[4, 42:] + 0.7 * np.mean(grid[4, 42:])\n    for d, sl in [(5, slice(0, 48)), (6, slice(0, 42))]:\n        seg = grid[d, sl]\n        sm = np.convolve(np.pad(seg, 1, mode='edge'), [0.25, 0.5, 0.25], mode='valid')\n        model[d, sl] = 0.4 * sm + 0.6 * np.mean(seg)\n    model[6, 42:] = 0.7 * grid[6, 42:] + 0.3 * wk_intraday[42:]\n    out = 0.85 * model.reshape(336) + 0.15 * raw\n    out /= np.mean(out)\n    return np.sqrt(out)\n\np1_map = {a: load_minute_prices(root, a, t1_start, t1_end) for a in all_assets}\np2_map = {a: load_minute_prices(root, a, t2_start, t2_end) for a in all_assets}\ns1_map = {a: structured_336(p1_map[a]) for a in all_assets}\nr2_map = {a: raw_336(p2_map[a], pct=99.0) for a in all_assets}\n\ncrypto_group = np.sqrt(np.mean([s1_map[a]**2 for a in CRYPTO_24H.asset_list], axis=0))\neq_group = np.sqrt(np.mean([s1_map[a]**2 for a in ['NVDAX', 'GOOGLX', 'TSLAX', 'AAPLX', 'SPCX']], axis=0))\n\nfor a in all_assets:\n    s1 = s1_map[a]\n    if a in CRYPTO_24H.asset_list:\n        s1_h = np.sqrt(0.7 * s1**2 + 0.3 * crypto_group**2)\n    elif a in ['NVDAX', 'GOOGLX', 'TSLAX', 'AAPLX', 'SPCX']:\n        s1_h = np.sqrt(0.75 * s1**2 + 0.25 * eq_group**2)\n    else:\n        s1_h = s1\n    s1_h /= np.sqrt(np.mean(s1_h**2))\n    r2 = r2_map[a]\n    mse_s = np.mean((np.log(np.maximum(s1, 0.05)) - np.log(np.maximum(r2, 0.05)))**2)\n    mse_h = np.mean((np.log(np.maximum(s1_h, 0.05)) - np.log(np.maximum(r2, 0.05)))**2)\n    print(f'{a:<8} MSE_struct={mse_s:.4f} MSE_hier={mse_h:.4f} corr_hier={np.corrcoef(s1_h, r2)[0,1]:.4f}')\n\"","description":"Compare hierarchical group-shrunk seasonality profiles against individual structured profiles on disjoint pre-validation windows.","dir_path":"/workspace"}}
