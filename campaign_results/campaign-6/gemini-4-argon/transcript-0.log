{"type":"tool_use","timestamp":"2026-10-22T01:29:05.297Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_255211","parameters":{"description":"Compare NaN rates, predicted step sigma, realized MAD, and realized RMS across Train, Window A, and Window B for AAPLX, SPCX, TSLAX, WTIOIL, and SP500.","command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\nfor asset in ['AAPLX', 'SPCX', 'TSLAX', 'WTIOIL', 'SP500']:\n    p = load_minute_prices(root, asset, pd.Timestamp('2026-07-01', tz='UTC'), pd.Timestamp('2026-10-10', tz='UTC'))\n    store = RealizedPathStore(asset, 86400, 300)\n    for label, d0, d1 in [('Train (Jul-Aug)', '2026-07-15', '2026-09-05'), ('WinA (Sep15-25)', '2026-09-15', '2026-09-24'), ('WinB (Oct01-10)', '2026-10-01', '2026-10-09')]:\n        p_sub = p.loc[d0:d1]\n        nan_pct = p_sub['close'].isna().mean() * 100\n        # Compare our predicted 24h mean step sigma vs realized 5m MAD*1.253 and realized 5m RMS\n        preds, mads, rmss = [], [], []\n        s2_b = m._S2_BACK_336[asset]\n        s2_f = m._S2_FWD_336[asset]\n        lt_v = m.LONG_TERM_SIGMA_1M[asset]\n        for f in sorted(store.root.glob('date=*.parquet')):\n            ds = f.stem.split('=')[1]\n            if d0 <= ds <= d1:\n                df_p = pd.read_parquet(f)\n                for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::6], df_p['prices'].iloc[::6]):\n                    real = np.asarray(arr, dtype=float)\n                    r5 = np.diff(np.log(real)) * 10000.0\n                    ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n                    vals = ctx['close'].to_numpy(dtype=np.float64)\n                    valid_pos = np.flatnonzero(np.isfinite(vals))\n                    grid_us = m._index_to_utc_us(ctx.index)\n                    gs2 = s2_b[m._slots_from_utc_us(grid_us)] * m._subslot_modulation(grid_us, asset, False) * m._event_variance_multiplier(grid_us, asset)\n                    cs = np.concatenate(([0.0], np.cumsum(gs2)))\n                    rets = np.diff(np.log(vals[valid_pos]))\n                    ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n                    rate = (rets ** 2) / ds2\n                    r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n                    t_end_us = int(grid_us[-1])\n                    valid_us = grid_us[valid_pos]\n                    t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n                    age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n                    g_sl = slice(int(valid_pos[0]), len(grid_us))\n                    age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n                    s2_g = gs2[g_sl]\n                    ew_l2 = [np.sqrt(max(np.dot(np.exp(-lam * age_bar), r2) / max(np.dot(np.exp(-lam * age_grid), s2_g), 1e-6), 1e-12)) for lam in m.EWMA_LAMBDAS_6]\n                    log_ew = np.log(ew_l2)\n                    sh = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, log_ew)))\n                    lg = float(np.exp(0.9 * np.dot(m.WEIGHTS_24H_LONG, log_ew) + 0.1 * np.log(lt_v)))\n                    decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n                    base_t = 0.96 * (lg * ((sh / lg) ** decay))\n                    fwd_us = int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n                    fwd_slots = m._slots_from_utc_us(fwd_us)\n                    fs2 = (s2_f[fwd_slots] * m._subslot_modulation(fwd_us, asset, False) * m._event_variance_multiplier(fwd_us, asset)).reshape(288, 5).sum(axis=1)\n                    stp = base_t * np.sqrt(np.maximum(fs2, 1e-4)) * 10000.0\n                    preds.append(np.mean(stp))\n                    mads.append(1.253314 * np.mean(np.abs(r5[np.isfinite(r5)])))\n                    rmss.append(np.sqrt(np.mean(r5[np.isfinite(r5)]**2)))\n        print(f'{asset:<7} {label:<16}: NaN={nan_pct:4.1f}%  mean_pred={np.mean(preds):6.2f}  real_MAD={np.mean(mads):6.2f} (pred/MAD={np.mean(preds)/np.mean(mads):.3f})  real_RMS={np.mean(rmss):6.2f} (pred/RMS={np.mean(preds)/np.mean(rmss):.3f})')\n\"","dir_path":"/workspace"}}
