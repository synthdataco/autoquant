{"type":"tool_use","timestamp":"2026-10-22T01:26:52.535Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_358760","parameters":{"dir_path":"/workspace","description":"Evaluate gap-invariant 85th-percentile variance, OHLC Parkinson range, leverage effect, and responsive long weights on 24H (2026-08-16 to 2026-09-05).","command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\nfit_start = pd.Timestamp('2026-06-25', tz='UTC')\nfit_end = pd.Timestamp('2026-08-15', tz='UTC')\ntune_start = pd.Timestamp('2026-08-16', tz='UTC')\ntune_end = pd.Timestamp('2026-09-06', tz='UTC')\n\ndef make_z(n_sims, n_inc, sig_p, sig_s):\n    rng = np.random.default_rng(42)\n    half = n_sims // 2\n    eps = rng.standard_normal((half, n_inc)) * np.exp(sig_s * rng.standard_normal((half, n_inc)) - 0.5 * sig_s**2)\n    eps = eps * np.exp(sig_p * m._stratified_normal_quantiles(half) - 0.5 * sig_p**2)[:, None]\n    z = np.vstack([eps, -eps])\n    return z / np.std(z, axis=0, keepdims=True)\n\nprint('=== 1. Testing Gap-Invariant Robust 85th-Pct Variance + OHLC Parkinson Range + Leverage on 24H (2026-08-16..2026-09-05) ===')\nfor asset in COM_EQU_24H.asset_list + CRYPTO_24H.asset_list:\n    _, sig_p, sig_s = m._distribution_params(asset, 86400)\n    z24 = make_z(200, 288, sig_p, sig_s)\n    s2_b = m._S2_BACK_336[asset]\n    s2_f = m._S2_FWD_336[asset]\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    p = load_minute_prices(root, asset, tune_start - pd.Timedelta(days=8), tune_end + pd.Timedelta(days=2))\n    store = RealizedPathStore(asset, 86400, 300)\n    prompts = []\n    for f in sorted(store.root.glob('date=*.parquet')):\n        d_str = f.stem.split('=')[1]\n        if '2026-08-16' <= d_str <= '2026-09-05':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::6], df_p['prices'].iloc[::6]):\n                prompts.append((ts, np.asarray(arr, dtype=float)))\n    comp = CRYPTO_24H if asset in m.CRYPTO_ASSETS else COM_EQU_24H\n    res = {k: [] for k in ['it5', 'rob85', 'ohlc', 'lev', 'fast_lg', 'comb']}\n    for ts, real in prompts:\n        ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        gs2 = s2_b[m._slots_from_utc_us(grid_us)] * m._subslot_modulation(grid_us, asset, False) * m._event_variance_multiplier(grid_us, asset)\n        cs = np.concatenate(([0.0], np.cumsum(gs2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        pos_r = rate[rate > 0]\n        r2_985 = np.minimum(rate, np.percentile(pos_r, 98.5)) * ds2\n        # Gap-invariant 85th percentile clipped variance (rescaled by 1.38 so mean matches 98.5th on Gaussian/typical)\n        r2_85 = np.minimum(rate, np.percentile(pos_r, 85.0)) * ds2 * 1.42\n        r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n        \n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        s2_g = gs2[g_sl]\n        \n        # OHLC Parkinson range\n        hi = ctx['high'].to_numpy(dtype=np.float64)[g_sl]\n        lo = ctx['low'].to_numpy(dtype=np.float64)[g_sl]\n        ok_hl = np.isfinite(hi) & np.isfinite(lo) & (lo > 0) & (hi >= lo)\n        hl_r2 = np.zeros_like(hi)\n        hl_r2[ok_hl] = (np.log(hi[ok_hl] / lo[ok_hl]) ** 2) / (4.0 * np.log(2.0))\n        hl_rate = hl_r2 / np.maximum(s2_g, 1e-4)\n        if np.any(hl_rate > 0):\n            hl_r2 = np.minimum(hl_rate, np.percentile(hl_rate[hl_rate > 0], 98.5)) * s2_g\n            \n        ew_985, ew_85, ew_l1, ew_hl = [], [], [], []\n        for lam in m.EWMA_LAMBDAS_6:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_985.append(np.sqrt(max(float(np.dot(wb, r2_985)) / den, 1e-12)))\n            ew_85.append(np.sqrt(max(float(np.dot(wb, r2_85)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n            ew_hl.append(np.sqrt(max(float(np.dot(wg[ok_hl], hl_r2[ok_hl])) / max(float(np.dot(wg[ok_hl], s2_g[ok_hl])), 1e-6), 1e-12)))\n            \n        le_985 = np.log(ew_985)\n        le_85 = np.log(ew_85)\n        le_l1 = np.log(ew_l1)\n        le_hl = np.log(ew_hl) - np.log(ew_hl[5]) + le_985[5]\n        \n        fwd_us = int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n        fwd_slots = m._slots_from_utc_us(fwd_us)\n        fs2 = (s2_f[fwd_slots] * m._subslot_modulation(fwd_us, asset, False) * m._event_variance_multiplier(fwd_us, asset)).reshape(288, 5).sum(axis=1)\n        seas_step = np.sqrt(np.maximum(fs2, 1e-4))\n        decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n        \n        # 1) Iter 5\n        le_it5 = (0.80 * le_985 + 0.20 * (le_l1 + 0.20)) if asset in m.CRYPTO_ASSETS else le_985\n        sh5 = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, le_it5)))\n        lg5 = float(np.exp(0.9 * np.dot(m.WEIGHTS_24H_LONG, le_it5) + 0.1 * np.log(lt_v)))\n        base_it5 = 0.96 * (lg5 * ((sh5 / lg5) ** decay))\n        \n        # 2) Rob85 blend (75% le_985 + 25% le_85)\n        le_rob = 0.75 * le_985 + 0.25 * le_85\n        sh_r = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, le_rob)))\n        lg_r = float(np.exp(0.9 * np.dot(m.WEIGHTS_24H_LONG, le_rob) + 0.1 * np.log(lt_v)))\n        base_rob = 0.96 * (lg_r * ((sh_r / lg_r) ** decay))\n        \n        # 3) OHLC Parkinson range blend (80% le_it5 + 20% le_hl)\n        le_oh = 0.80 * le_it5 + 0.20 * le_hl\n        sh_o = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, le_oh)))\n        lg_o = float(np.exp(0.9 * np.dot(m.WEIGHTS_24H_LONG, le_oh) + 0.1 * np.log(lt_v)))\n        base_ohlc = 0.96 * (lg_o * ((sh_o / lg_o) ** decay))\n        \n        # 4) Leverage effect: recent 6h return normalized by 6h expected std\n        m_6h = age_bar <= 360.0\n        ret_6h = float(np.sum(rets[m_6h])) if np.any(m_6h) else 0.0\n        z_6h = np.clip(ret_6h / max(ew_985[3] * np.sqrt(360.0), 1e-4), -4.0, 4.0)\n        lev_mult = 1.0 - 0.025 * z_6h  # negative return -> higher vol\n        base_lev = base_it5 * lev_mult\n        \n        # 5) Responsive long weights (less 7d & prior drag on equities: [0, 0, 0.10, 0.25, 0.40, 0.25] and 0.03 prior)\n        w_lg_fast = np.array([0.00, 0.00, 0.10, 0.25, 0.40, 0.25])\n        lg_f = float(np.exp(0.97 * np.dot(w_lg_fast, le_it5) + 0.03 * np.log(lt_v)))\n        base_flg = 0.96 * (lg_f * ((sh5 / lg_f) ** decay))\n        \n        # 6) Combined (Rob85 + OHLC + fast_lg)\n        le_cb = 0.65 * le_985 + 0.20 * le_85 + 0.15 * le_hl\n        sh_c = float(np.exp(np.dot(m.WEIGHTS_24H_SHORT, le_cb)))\n        lg_c = float(np.exp(0.97 * np.dot(w_lg_fast, le_cb) + 0.03 * np.log(lt_v)))\n        base_cb = 0.96 * (lg_c * ((sh_c / lg_c) ** decay))\n        \n        for k, bs in [('it5', base_it5), ('rob85', base_rob), ('ohlc', base_ohlc), ('lev', base_lev), ('fast_lg', base_flg), ('comb', base_cb)]:\n            stp = bs * seas_step\n            shocks = np.zeros((200, 289))\n            shocks[:, 1:] = z24 * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n            res[k].append(sc)\n    print(f'{asset:<8} ' + ' '.join(f'{k}:{np.mean(res[k]):7.1f}' for k in res))\n\""}}
