{"type":"tool_use","timestamp":"2026-10-22T01:41:44.794Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_300099","parameters":{"command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\n\ndef compute_5m_mad_ewma(valid_pos, rets, grid_us, gs2, lams):\n    start_idx = int(valid_pos[0])\n    n_active = len(grid_us) - start_idx\n    n_blocks = n_active // 5\n    trim_start = len(grid_us) - n_blocks * 5\n    ret_pos = valid_pos[1:]\n    in_range = ret_pos >= trim_start\n    b_idx = np.clip(((ret_pos[in_range] - trim_start) // 5).astype(np.int64), 0, n_blocks - 1)\n    r5_blk = np.bincount(b_idx, weights=rets[in_range], minlength=n_blocks)\n    s2_blk = np.maximum(gs2[trim_start:].reshape(n_blocks, 5).sum(axis=1), 1e-4)\n    rate5 = (r5_blk ** 2) / s2_blk\n    pos5 = rate5[rate5 > 0]\n    cap5 = float(np.percentile(pos5, 98.5)) if pos5.size > 10 else 1.0\n    r5_abs_win = np.minimum(np.abs(r5_blk), np.sqrt(cap5 * s2_blk))\n    mad_num_blk = 1.2533141373155001 * r5_abs_win * np.sqrt(s2_blk)\n    age_blk_min = (np.arange(n_blocks - 1, -1, -1, dtype=np.float64) + 0.5) * 5.0\n    ew_mad5 = np.empty(len(lams), dtype=np.float64)\n    for i, lam in enumerate(lams):\n        w = np.exp(-lam * age_blk_min)\n        ew_mad5[i] = max(float(np.dot(w, mad_num_blk)) / max(float(np.dot(w, s2_blk)), 1e-6), 1e-6)\n    return ew_mad5\n\ndef compute_ohlc_ewma(ctx, g_sl, age_grid, s2_g, lams, le_l2_anchor):\n    if not isinstance(ctx, pd.DataFrame) or 'high' not in ctx.columns or 'low' not in ctx.columns:\n        return None\n    hi = ctx['high'].to_numpy(dtype=np.float64)[g_sl]\n    lo = ctx['low'].to_numpy(dtype=np.float64)[g_sl]\n    ok = np.isfinite(hi) & np.isfinite(lo) & (lo > 0) & (hi >= lo)\n    if np.sum(ok) < 20:\n        return None\n    hl_r2 = np.zeros_like(hi)\n    hl_r2[ok] = (np.log(hi[ok] / lo[ok]) ** 2) / 2.772588722239781\n    hl_rate = hl_r2 / np.maximum(s2_g, 1e-4)\n    pos_hl = hl_rate[hl_rate > 0]\n    if pos_hl.size > 10:\n        hl_r2 = np.minimum(hl_rate, float(np.percentile(pos_hl, 98.5))) * s2_g\n    ew_hl = np.empty(len(lams), dtype=np.float64)\n    age_ok = age_grid[ok]\n    s2_ok = s2_g[ok]\n    hl_ok = hl_r2[ok]\n    for i, lam in enumerate(lams):\n        w = np.exp(-lam * age_ok)\n        ew_hl[i] = np.sqrt(max(float(np.dot(w, hl_ok)) / max(float(np.dot(w, s2_ok)), 1e-6), 1e-12))\n    le_hl = np.log(np.maximum(ew_hl, 1e-6))\n    return le_hl - le_hl[5] + le_l2_anchor\n\ndef make_z(n_sims, n_inc, sig_p, sig_s):\n    rng = np.random.default_rng(42)\n    half = n_sims // 2\n    eps = rng.standard_normal((half, n_inc)) * np.exp(sig_s * rng.standard_normal((half, n_inc)) - 0.5 * sig_s**2)\n    eps = eps * np.exp(sig_p * m._stratified_normal_quantiles(half) - 0.5 * sig_p**2)[:, None]\n    z = np.vstack([eps, -eps])\n    return z / np.std(z, axis=0, keepdims=True)\n\nprint('=== 1. CRYPTO_1H WITH OHLC PARKINSON RANGE + 5M MAD (2026-07-15..2026-09-05) ===')\nz1h = make_z(200, 60, 0.30, 0.20)\nfor asset in CRYPTO_1H.asset_list:\n    s2_b = m._S2_BACK_336[asset]\n    p = load_minute_prices(root, asset, pd.Timestamp('2026-07-05', tz='UTC'), pd.Timestamp('2026-09-07', tz='UTC'))\n    times = pd.date_range('2026-07-15', '2026-09-05', freq='4h', tz='UTC')\n    res_it5, res_new = [], []\n    for ts in times:\n        ctx = p.loc[ts - pd.Timedelta(days=7) : context_end(ts, 3600)]\n        real = p['close'].loc[ts : ts + pd.Timedelta(seconds=3600)].to_numpy(dtype=float)\n        if len(real) != 61 or not np.isfinite(real).all():\n            continue\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        gs2 = s2_b[m._slots_from_utc_us(grid_us)] * m._subslot_modulation(grid_us, asset, True) * m._event_variance_multiplier(grid_us, asset)\n        cs = np.concatenate(([0.0], np.cumsum(gs2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n        rate = (rets ** 2) / ds2\n        r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n        r1_sc = 1.253314 * np.abs(rets) * np.sqrt(ds2)\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        s2_g = gs2[g_sl]\n        ew_l2, ew_l1 = [], []\n        for lam in m.EWMA_LAMBDAS_6:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_l2.append(np.sqrt(max(float(np.dot(wb, r2)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n        log_l2 = np.log(ew_l2)\n        log_l1 = np.log(ew_l1)\n        le_hl = compute_ohlc_ewma(ctx, g_sl, age_grid, s2_g, m.EWMA_LAMBDAS_6, log_l2[5])\n        ew_mad5 = compute_5m_mad_ewma(valid_pos, rets, grid_us, gs2, m.EWMA_LAMBDAS_6)\n        log_mad5 = np.log(ew_mad5)\n        \n        fwd_us = int(round(ts.timestamp() * 1_000_000)) + np.arange(1, 61, dtype=np.int64) * 60_000_000\n        fwd_slots = m._slots_from_utc_us(fwd_us)\n        fs2 = s2_b[fwd_slots] * m._subslot_modulation(fwd_us, asset, True) * m._event_variance_multiplier(fwd_us, asset)\n        seas = np.sqrt(np.maximum(fs2, 1e-4))\n        dec30 = np.exp(-(np.arange(60) + 0.5) / 30.0)\n        \n        le5 = 0.70 * log_l2 + 0.30 * log_l1\n        s0_5 = float(np.exp(np.dot(m.WEIGHTS_1H_START, le5)))\n        s1_5 = float(np.exp(np.dot(m.WEIGHTS_1H_END, le5)))\n        b5 = 1.05 * (s1_5 * ((s0_5 / s1_5) ** dec30))\n        \n        le_n = 0.45 * log_l2 + 0.20 * log_l1 + 0.20 * log_mad5 + 0.15 * le_hl\n        s0_n = float(np.exp(np.dot(m.WEIGHTS_1H_START, le_n)))\n        s1_n = float(np.exp(np.dot(m.WEIGHTS_1H_END, le_n)))\n        bn = 1.045 * (s1_n * ((s0_n / s1_n) ** dec30))\n        \n        for lst, bs in [(res_it5, b5), (res_new, bn)]:\n            stp = bs * seas\n            shocks = np.zeros((200, 61))\n            shocks[:, 1:] = z1h * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 60, CRYPTO_1H.scoring_intervals, CRYPTO_1H.vol_scoring_blocks)\n            lst.append(sc)\n    print(f'{asset:<6} Iter5={np.mean(res_it5):8.2f} -> New={np.mean(res_new):8.2f} (diff={np.mean(res_new)-np.mean(res_it5):+6.2f})')\n\"","dir_path":"/workspace","description":"Test combining OHLC Parkinson range and 5-minute block MAD on CRYPTO_1H across 2026-07-15 to 2026-09-05."}}
