{"type":"tool_use","timestamp":"2026-10-22T00:23:29.246Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_223315","parameters":{"command":"uv run python -c \"\nimport sys\nsys.path.insert(0, '/workspace/agent')\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom scipy.optimize import minimize_scalar\nimport modeling as m\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\n\nroot = Path('/workspace/market_data')\n\ndef get_session_idx(slots):\n    dow = slots // 48\n    hh = slots % 48\n    sess = np.zeros_like(slots)\n    wk = dow < 5\n    sess[wk & (hh < 24)] = 0\n    sess[wk & (hh >= 24) & (hh < 27)] = 1\n    sess[wk & (hh >= 27) & (hh < 30)] = 2\n    sess[wk & (hh >= 30) & (hh < 39)] = 3\n    sess[wk & (hh >= 39) & (hh < 41)] = 4\n    sess[(dow < 4) & (hh >= 41)] = 5\n    sess[(dow == 4) & (hh == 41)] = 5\n    sess[(dow == 4) & (hh >= 42)] = 6\n    sess[dow == 5] = 7\n    sess[(dow == 6) & (hh < 42)] = 8\n    sess[(dow == 6) & (hh >= 42)] = 9\n    return sess\n\ndef fit_c_crps(z_res, z_template_1d):\n    z_res = z_res[np.isfinite(z_res)]\n    if len(z_res) < 30:\n        return 1.0\n    if len(z_res) > 2000:\n        z_res = z_res[::len(z_res)//2000]\n    x = np.sort(z_template_1d)\n    M = len(x)\n    weights = (2 * np.arange(1, M + 1) - M - 1)\n    half_spread = float(np.sum(weights * x) / (M * M))\n    def obj(c):\n        return float(np.mean(np.abs(c * x[:, None] - z_res[None, :]))) - c * half_spread\n    res = minimize_scalar(obj, bounds=(0.25, 2.5), method='bounded')\n    return float(res.x)\n\ndef make_z(n_sims, n_inc, sig_p, sig_s):\n    rng = np.random.default_rng(42)\n    half = n_sims // 2\n    eps = rng.standard_normal((half, n_inc))\n    eta = rng.standard_normal((half, n_inc))\n    eps = eps * np.exp(sig_s * eta - 0.5 * sig_s**2)\n    q_z = m._stratified_normal_quantiles(half)\n    eps = eps * np.exp(sig_p * q_z - 0.5 * sig_p**2)[:, None]\n    z = np.vstack([eps, -eps])\n    z /= np.std(z, axis=0, keepdims=True)\n    return z\n\nprint(f'{\\\"Asset\\\":<8} {\\\"Iter3\\\":>8} {\\\"+L1_hyb\\\":>8} {\\\"+SepSeas\\\":>9} {\\\"+Both\\\":>8}')\nfor asset in COM_EQU_24H.asset_list + CRYPTO_24H.asset_list:\n    s2_back = m._S2_336[asset]\n    s_back = np.sqrt(s2_back)\n    lt_v = m.LONG_TERM_SIGMA_1M[asset]\n    _, sig_p, sig_s = m._distribution_params(asset, 86400)\n    z24 = make_z(200, 288, sig_p, sig_s)\n    z_1d = z24[:, 0]\n    \n    p_all = load_minute_prices(root, asset, pd.Timestamp('2026-06-18', tz='UTC'), pd.Timestamp('2026-09-07', tz='UTC'))\n    store = RealizedPathStore(asset, 86400, 300)\n    \n    z_by_sess = {k: [] for k in range(10)}\n    tune_prompts = []\n    for f in sorted(store.root.glob('date=*.parquet')):\n        d_str = f.stem.split('=')[1]\n        if '2026-06-25' <= d_str <= '2026-08-15':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::4], df_p['prices'].iloc[::4]):\n                real = np.asarray(arr, dtype=float)\n                r5 = np.diff(np.log(real))\n                ctx = p_all.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n                vals = ctx['close'].to_numpy(dtype=np.float64)\n                valid_pos = np.flatnonzero(np.isfinite(vals))\n                grid_us = m._index_to_utc_us(ctx.index)\n                grid_s2 = s2_back[m._slots_from_utc_us(grid_us)]\n                cs = np.concatenate(([0.0], np.cumsum(grid_s2)))\n                rets = np.diff(np.log(vals[valid_pos]))\n                ds2 = np.maximum(cs[valid_pos[1:] + 1] - cs[valid_pos[:-1] + 1], 1e-4)\n                rate = (rets ** 2) / ds2\n                r2 = np.minimum(rate, np.percentile(rate[rate > 0], 98.5)) * ds2\n                t_end_us = int(grid_us[-1])\n                valid_us = grid_us[valid_pos]\n                t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n                age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n                g_sl = slice(int(valid_pos[0]), len(grid_us))\n                age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n                ew = [np.sqrt(max(np.dot(np.exp(-lam * age_bar), r2) / max(np.dot(np.exp(-lam * age_grid), grid_s2[g_sl]), 1e-6), 1e-12)) for lam in m.EWMA_LAMBDAS]\n                le = np.log(ew)\n                sh = float(np.exp(np.dot(m.WEIGHTS_SHORT, le)))\n                lg = float(np.exp(0.9 * np.dot(m.WEIGHTS_LONG, le) + 0.1 * np.log(lt_v)))\n                start_us = int(round(ts.timestamp() * 1_000_000))\n                fwd_us = start_us + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n                fwd_slots = m._slots_from_utc_us(fwd_us)\n                fwd_s2 = s2_back[fwd_slots].reshape(288, 5).sum(axis=1)\n                decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n                pred_l2 = 0.96 * (lg * ((sh / lg) ** decay)) * np.sqrt(np.maximum(fwd_s2, 1e-4))\n                sess = get_session_idx(fwd_slots[4::5])\n                z_step = r5 / pred_l2\n                for k in range(10):\n                    z_by_sess[k].append(z_step[sess == k])\n        elif '2026-08-16' <= d_str <= '2026-09-05':\n            df_p = pd.read_parquet(f)\n            for ts, arr in zip(pd.to_datetime(df_p['start_time'], utc=True)[::6], df_p['prices'].iloc[::6]):\n                tune_prompts.append((ts, np.asarray(arr, dtype=float)))\n                \n    c_sess = np.array([fit_c_crps(np.concatenate(z_by_sess[k]), z_1d) for k in range(10)])\n    slot_sess = get_session_idx(np.arange(336))\n    alpha = 0.90 if asset in COM_EQU_24H.asset_list else (0.0 if asset == 'XRP' else 0.45)\n    c_336 = c_sess[slot_sess] ** alpha\n    s2_fwd = (s_back * c_336) ** 2\n    \n    comp = CRYPTO_24H if asset in CRYPTO_24H.asset_list else COM_EQU_24H\n    res = {k: [] for k in ['it3', 'l1', 'sep', 'both']}\n    for ts, real in tune_prompts:\n        ctx = p_all.loc[ts - pd.Timedelta(days=7) : context_end(ts, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        last = float(vals[valid_pos[-1]])\n        grid_us = m._index_to_utc_us(ctx.index)\n        rets = np.diff(np.log(vals[valid_pos]))\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n        g_sl = slice(int(valid_pos[0]), len(grid_us))\n        age_grid = np.maximum((t_end_us - grid_us[g_sl]) / 60_000_000.0, 0.0)\n        start_us = int(round(ts.timestamp() * 1_000_000))\n        fwd_us = start_us + np.arange(1, 288 * 5 + 1, dtype=np.int64) * 60_000_000\n        fwd_slots = m._slots_from_utc_us(fwd_us)\n        decay = np.exp(-((np.arange(288) + 0.5) * 5.0) / 360.0)\n        \n        gs2_b = s2_back[m._slots_from_utc_us(grid_us)]\n        csb = np.concatenate(([0.0], np.cumsum(gs2_b)))\n        ds2_b = np.maximum(csb[valid_pos[1:] + 1] - csb[valid_pos[:-1] + 1], 1e-4)\n        rateb = (rets ** 2) / ds2_b\n        r2_b = np.minimum(rateb, np.percentile(rateb[rateb > 0], 98.5)) * ds2_b\n        r1_sc = np.sqrt(np.pi / 2.0) * np.abs(rets) * np.sqrt(ds2_b)\n        s2_g = gs2_b[g_sl]\n        \n        ew_l2, ew_l1 = [], []\n        for lam in m.EWMA_LAMBDAS:\n            wb = np.exp(-lam * age_bar)\n            wg = np.exp(-lam * age_grid)\n            den = max(float(np.dot(wg, s2_g)), 1e-6)\n            ew_l2.append(np.sqrt(max(float(np.dot(wb, r2_b)) / den, 1e-12)))\n            ew_l1.append(max(float(np.dot(wb, r1_sc)) / den, 1e-6))\n        le_l2 = np.log(ew_l2)\n        le_l1 = np.log(ew_l1)\n        \n        sh_l2 = float(np.exp(np.dot(m.WEIGHTS_SHORT, le_l2)))\n        lg_l2 = float(np.exp(0.9 * np.dot(m.WEIGHTS_LONG, le_l2) + 0.1 * np.log(lt_v)))\n        base_l2 = 0.96 * (lg_l2 * ((sh_l2 / lg_l2) ** decay))\n        \n        le_hyb = 0.75 * le_l2 + 0.25 * le_l1\n        sh_h = float(np.exp(np.dot(m.WEIGHTS_SHORT, le_hyb)))\n        lg_h = float(np.exp(0.9 * np.dot(m.WEIGHTS_LONG, le_hyb) + 0.1 * np.log(lt_v)))\n        base_h = 1.01 * (lg_h * ((sh_h / lg_h) ** decay))\n        \n        seas_old = np.sqrt(np.maximum(s2_back[fwd_slots].reshape(288, 5).sum(axis=1), 1e-4))\n        seas_new = np.sqrt(np.maximum(s2_fwd[fwd_slots].reshape(288, 5).sum(axis=1), 1e-4))\n        \n        for k, bs, ss in [('it3', base_l2, seas_old), ('l1', base_h, seas_old), ('sep', base_l2, seas_new), ('both', base_h, seas_new)]:\n            stp = bs * ss\n            shocks = np.zeros((200, 289))\n            shocks[:, 1:] = z24 * stp[None, :]\n            sc, _ = calculate_total_score_for_miner(last * np.exp(np.cumsum(shocks, axis=1)), real, 300, comp.scoring_intervals, comp.vol_scoring_blocks)\n            res[k].append(sc)\n    print(f'{asset:<8} {np.mean(res[\\\"it3\\\"]):8.1f} {np.mean(res[\\\"l1\\\"]):8.1f} {np.mean(res[\\\"sep\\\"]):9.1f} {np.mean(res[\\\"both\\\"]):8.1f}')\n\"","dir_path":"/workspace","description":"Compare Iteration 3 against online L1 hybrid, separated session seasonality, and both combined across all 13 24H assets on 2026-08-16 to 2026-09-05."}}
