RPS_gain=-0.028\n  Wk_20_24  : du*=-0.089 (H1:-0.085, H2:-0.092) | avg_CRPS_gain=-0.186\n  Sat       : du*=+0.038 (H1:-0.144, H2:+0.102) | avg_CRPS_gain=-0.038\n  Sun       : du*=+0.002 (H1:+0.029, H2:-0.008) | avg_CRPS_gain=-0.000\n=== HYPE (n=738) ===\n  Wk_00_08  : du*=-0.031 (H1:-0.024, H2:-0.038) | avg_CRPS_gain=-0.057\n  Wk_08_13  : du*=+0.042 (H1:-0.035, H2:+0.117) | avg_CRPS_gain=-0.074\n  Wk_13_16  : du*=+0.050 (H1:+0.077, H2:+0.027) | avg_CRPS_gain=-0.054\n  Wk_16_20  : du*=-0.008 (H1:-0.032, H2:+0.013) | avg_CRPS_gain=-0.002\n  Wk_20_24  : du*=-0.038 (H1:-0.074, H2:-0.006) | avg_CRPS_gain=-0.043\n  Sat       : du*=-0.103 (H1:-0.106, H2:-0.101) | avg_CRPS_gain=-0.418\n  Sun       : du*=-0.008 (H1:-0.042, H2:+0.014) | avg_CRPS_gain=-0.002"}
{"type":"tool_use","timestamp":"2026-10-22T05:01:31.445Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_514996","parameters":{"description":"Analyze CRYPTO_24H and COM_EQU_24H session residuals across Pre-Half 1 and Pre-Half 2","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\ndef _eval_24h_prompt(args):\n    asset, t0_iso, intervals, real, ctx = args\n    out = mod.simulate(asset, t0_iso, 300, 86400, 250, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]; log_p = np.log(paths / p0)\n    du = 0.08\n    c0, _ = calculate_total_score_for_miner(paths, real, 300, intervals, {})\n    if c0 < 0: return None\n    cp, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(du)*log_p), real, 300, intervals, {})\n    cm, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(-du)*log_p), real, 300, intervals, {})\n    t0 = pd.Timestamp(t0_iso)\n    return {'t0': t0, 'dow': t0.dayofweek, 'hour': t0.hour, 'c0': c0, 'g': (cp - cm)/(2*du), 'h': max((cp - 2*c0 + cm)/(du*du), 1.0)}\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [CRYPTO_24H, COM_EQU_24H]:\n        print(f'================ {comp.label} ================', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, 86400, 300)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='1D')\n            all_p = []\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::3]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)):\n                        all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [\n                (asset, t0.isoformat(), comp.scoring_intervals, rp, prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, 86400)])\n                for t0, rp in all_p\n            ]\n            df = pd.DataFrame([r for r in ex.map(_eval_24h_prompt, tasks) if r is not None])\n            print(f'=== {asset} (n={len(df)}) ===', flush=True)\n            for name, cond in [\n                ('Wk_00_12', (df['dow']<4) & (df['hour']<12)),\n                ('Wk_12_24', (df['dow']<4) & (df['hour']>=12)),\n                ('Fri_00_12', (df['dow']==4) & (df['hour']<12)),\n                ('Fri_12_24', (df['dow']==4) & (df['hour']>=12)),\n                ('Sat', df['dow']==5),\n                ('Sun_00_12', (df['dow']==6) & (df['hour']<12)),\n                ('Sun_12_24', (df['dow']==6) & (df['hour']>=12)),\n            ]:\n                s1 = df[cond & (df['t0'] < '2026-08-15')]\n                s2 = df[cond & (df['t0'] >= '2026-08-15')]\n                s_all = df[cond]\n                u1 = -s1['g'].sum()/s1['h'].sum() if len(s1) else 0\n                u2 = -s2['g'].sum()/s2['h'].sum() if len(s2) else 0\n                ua = -s_all['g'].sum()/s_all['h'].sum() if len(s_all) else 0\n                gain = 0.5 * (s_all['g'].sum()**2) / s_all['h'].sum() / len(df)\n                print(f'  {name:<10}: du*={ua:+.3f} (H1:{u1:+.3f}, H2:{u2:+.3f}) | avg_CRPS_gain={-gain:+.3f}', flush=True)\n\""}}
