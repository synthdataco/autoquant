{"type":"tool_use","timestamp":"2026-10-22T08:23:07.906Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_401279","parameters":{"description":"Test orthogonal horizon bridge parameter eta_H across Pre-Half 1 and Pre-Half 2 for all 18 pairs","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\nETAS = [0.85, 0.90, 0.94, 1.00, 1.06, 1.12]\n\ndef _test_eta(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx = args\n    out = mod.simulate(asset, t0_iso, ti, tl, 250, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]\n    dlog = np.diff(np.log(paths / p0), axis=1)\n    sig2 = np.var(dlog, axis=0)\n    w_proj = sig2 / max(np.sum(sig2), 1e-12)\n    tot_ret = np.sum(dlog, axis=1, keepdims=True)\n    \n    res = {'t0': pd.Timestamp(t0_iso)}\n    c_base, _ = calculate_total_score_for_miner(paths, real, ti, intervals, vol_blocks)\n    if c_base < 0: return None\n    res[1.00] = 0.0\n    for eta in ETAS:\n        if eta == 1.00: continue\n        dlog_eta = dlog + (eta - 1.0) * tot_ret * w_proj[None, :]\n        p_eta = p0 * np.exp(np.hstack([np.zeros((paths.shape[0], 1)), np.cumsum(dlog_eta, axis=1)]))\n        sc, _ = calculate_total_score_for_miner(p_eta, real, ti, intervals, vol_blocks)\n        res[eta] = sc - c_base\n    return res\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [CRYPTO_1H, CRYPTO_24H, COM_EQU_24H]:\n        print(f'================ {comp.label} Orthogonal Horizon Bridge Eta Test ================', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n            all_p = []\n            p_stride = 24 if comp.time_length <= 3600 else 4\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::p_stride]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)):\n                        all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [\n                (asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, comp.vol_scoring_blocks, rp,\n                 prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)])\n                for t0, rp in all_p\n            ]\n            df = pd.DataFrame([r for r in ex.map(_test_eta, tasks) if r is not None])\n            h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n            s_out = ' | '.join(f'{e:.2f}:{df[e].mean():+.2f}({df.loc[h1,e].mean():+.2f}/{df.loc[h2,e].mean():+.2f})' for e in ETAS if e != 1.00)\n            print(f'  {asset:<7} | {s_out}', flush=True)\n\""}}
