e_ds[rate_ds > 0]\n        if pos_rates.size > 10:\n            cap_ds = float(np.percentile(pos_rates, 98.5))\n            r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        else:\n            r2_win = rets ** 2\n\n        r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar_min = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        s2_grid_active = grid_s2[g_slice]\n\n        ewma_l2 = np.empty(len(EWMA_LAMBDAS_6), dtype=np.float64)\n        ewma_l1 = np.empty(len(EWMA_LAMBDAS_6), dtype=np.float64)\n        for i, lam in enumerate(EWMA_LAMBDAS_6):\n            w_bar = np.exp(-lam * age_bar_min)\n            w_grid = np.exp(-lam * age_grid_min)\n            den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n            ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n            ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n\n        log_l2 = np.log(np.maximum(ewma_l2, 1e-6))\n        log_l1 = np.log(np.maximum(ewma_l1, 1e-6))\n        log_mad5 = _compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n        if log_mad5 is None:\n            log_mad5 = log_l2\n        log_hl = _compute_ohlc_log_ewma(context_prices, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n        if log_hl is None:\n            log_hl = log_l2\n\n        if is_1h:\n            log_ewma = 0.45 * log_l2 + 0.20 * log_l1 + 0.20 * log_mad5 + 0.15 * log_hl\n            sigma_short = float(np.exp(np.dot(WEIGHTS_1H_START, log_ewma)))\n            sigma_long = float(np.exp(np.dot(WEIGHTS_1H_END, log_ewma)))\n        else:\n            if asset in CRYPTO_ASSETS:\n                log_ewma = 0.80 * log_l2 + 0.20 * (log_l1 + 0.20)\n            else:\n                log_ewma = 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n            w_long = WEIGHTS_24H_LONG\n            p_w = 0.10\n            sigma_short = float(np.exp(np.dot(WEIGHTS_24H_SHORT, log_ewma)))\n            sigma_long_ctx = float(np.exp(np.dot(w_long, log_ewma)))\n            sigma_long = float(\n                np.exp((1.0 - p_w) * np.log(sigma_long_ctx) + p_w * np.log(lt_sigma))\n            )\n    else:\n        sigma_short = lt_sigma\n        sigma_long = lt_sigma\n\n    c_scale, sig_path_vv, sig_step_vv = _distribution_params(asset, time_length)\n\n    start_us = _timestamp_to_utc_us(start_time)\n    fwd_min_offsets = np.arange(1, n_inc * step_mins + 1, dtype=np.int64)\n    fwd_us = start_us + fwd_min_offsets * 60_000_000\n    fwd_slots = _slots_from_utc_us(fwd_us)\n    fwd_s2_min = (\n        s2_fwd[fwd_slots]\n        * _subslot_modulation(fwd_us, asset, is_1h)\n        * _event_variance_multiplier(fwd_us, asset)\n    )\n    fwd_s2 = fwd_s2_min.reshape(n_inc, step_mins).sum(axis=1)\n    step_seas_sqrt = np.sqrt(np.maximum(fwd_s2, 1e-4))\n\n    mid_lead_mins = (np.arange(n_inc, dtype=np.float64) + 0.5) * step_mins\n    rev_tau = REVERSION_TAU_1H if is_1h else REVERSION_TAU_24H\n    decay = np.exp(-mid_lead_mins / rev_tau)\n    sigma_base_t = sigma_long * ((sigma_short / max(sigma_long, 1e-8)) ** decay)\n\n    per_step_sigma = (c_scale * sigma_base_t) * step_seas_sqrt\n\n    half = num_simulations // 2\n    if half > 0:\n        eps = rng.standard_normal((half, n_inc))\n        if sig_step_vv > 0.0:\n            eta = rng.standard_normal((half, n_inc))\n            eps = eps * np.exp(sig_step_vv * eta - 0.5 * sig_step_vv * sig_step_vv)\n        if sig_path_vv > 0.0:\n            q_z = _stratified_normal_quantiles(half)\n            m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv * sig_path_vv)[:, None]\n            eps = eps * m_half\n        if num_simulations % 2 == 1:\n            z_extra = rng.standard_normal((1, n_inc))\n            z = np.vstack([eps, -eps, z_extra])\n        else:\n            z = np.vstack([eps, -eps])\n        col_std = np.std(z, axis=0, keepdims=True)\n        z = z / np.where(col_std > 1e-8, col_std, 1.0)\n    else:\n        z = rng.standard_normal((num_simulations, n_inc))\n\n    shocks = np.empty((num_simulations, steps), dtype=np.float64)\n    shocks[:, 0] = 0.0\n    shocks[:, 1:] = z * per_step_sigma[None, :]\n    paths = last * np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *[p.tolist() for p in paths])","new_string":"    le_hl = np.log(np.maximum(ew_hl, 1e-6))\n    return le_hl - le_hl[5] + anchor_log_sigma\n\n\ndef _apply_secant_shocks(\n    shocks_inc: np.ndarray,\n    eta_tot: float,\n    eta_blk: float = 1.0,\n    n_blks: int = 8,\n) -> np.ndarray:\n    out = shocks_inc\n    if eta_blk != 1.0 and out.shape[1] >= n_blks:\n        b_len = out.shape[1] // n_blks\n        out = out.copy()\n        for b in range(n_blks):\n            sl = slice(b * b_len, (b + 1) * b_len)\n            sub = out[:, sl]\n            s2 = np.var(sub, axis=0)\n            w = s2 / max(float(np.sum(s2)), 1e-12)\n            b_sum = np.sum(sub, axis=1, keepdims=True)\n            out[:, sl] = sub + (eta_blk - 1.0) * b_sum * w[None, :]\n    if eta_tot != 1.0:\n        s2 = np.var(out, axis=0)\n        w = s2 / max(float(np.sum(s2)), 1e-12)\n        t_sum = np.sum(out, axis=1, keepdims=True)\n        out = out + (eta_tot - 1.0) * t_sum * w[None, :]\n    return out\n\n\ndef simulate(\n    asset: str,\n    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    rng = _make_rng(asset, start_time, time_length)\n    steps = time_length // time_increment + 1\n    n_inc = steps - 1\n    step_mins = max(time_increment // 60, 1)\n    is_1h = time_length <= 3600\n\n    if isinstance(context_prices, pd.DataFrame):\n        close_series = context_prices[\"close\"]\n        full_idx = context_prices.index\n    else:\n        close_series = context_prices\n        full_idx = close_series.index\n\n    vals = close_series.to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    if valid_pos.size == 0:\n        last = 1.0\n    else:\n        last = float(vals[valid_pos[-1]])\n\n    s2_back = _S2_BACK_336.get(asset, _DEFAULT_S2_336)\n    if is_1h:\n        s2_f_raw = _S2_FWD_336.get(asset, s2_back)\n        s2_f_norm = s2_f_raw / np.mean(s2_f_raw)\n        s2_btc_raw = _S2_FWD_336.get(\"BTC\", s2_back)\n        s2_btc_norm = s2_btc_raw / np.mean(s2_btc_raw)\n        s2_fwd = 0.35 * s2_back + 0.45 * s2_f_norm + 0.20 * s2_btc_norm\n    else:\n        s2_fwd = _S2_FWD_336.get(asset, s2_back)\n        if asset in CRYPTO_ASSETS:\n            s2_fwd = s2_fwd.copy()\n            s2_fwd[232:320] *= 0.85\n    lt_sigma = LONG_TERM_SIGMA_1M.get(asset, 5e-4)\n\n    start_us = _timestamp_to_utc_us(start_time)\n    fwd_min_offsets = np.arange(1, n_inc * step_mins + 1, dtype=np.int64)\n    fwd_us = start_us + fwd_min_offsets * 60_000_000\n    fwd_slots = _slots_from_utc_us(fwd_us)\n    fwd_s2_min = (\n        s2_fwd[fwd_slots]\n        * _subslot_modulation(fwd_us, asset, is_1h)\n        * _event_variance_multiplier(fwd_us, asset)\n    )\n    fwd_s2 = fwd_s2_min.reshape(n_inc, step_mins).sum(axis=1)\n    step_seas_sqrt = np.sqrt(np.maximum(fwd_s2, 1e-4))\n    s2_fwd_mean = float(np.mean(fwd_s2_min))\n\n    brk_mult = 1.0\n    if valid_pos.size > 10:\n        grid_us = _index_to_utc_us(full_idx)\n        grid_slots = _slots_from_utc_us(grid_us)\n        grid_s2 = (\n            s2_back[grid_slots]\n            * _subslot_modulation(grid_us, asset, is_1h)\n            * _event_variance_multiplier(grid_us, asset)\n        )\n        grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n\n        valid_vals = vals[valid_pos]\n        rets = np.diff(np.log(valid_vals))\n        finite = np.isfinite(rets)\n        if not np.all(finite):\n            rets = np.where(finite, rets, 0.0)\n\n        ds2 = grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1]\n        ds2 = np.maximum(ds2, 1e-4)\n\n        rate_ds = (rets ** 2) / ds2\n        pos_rates = rate_ds[rate_ds > 0]\n        if pos_rates.size > 10:\n            cap_ds = float(np.percentile(pos_rates, 98.5))\n            r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        else:\n            r2_win = rets ** 2\n\n        r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        t_mid_us = 0.5 * (valid_us[1:] + valid_us[:-1])\n        age_bar_min = np.maximum((t_end_us - t_mid_us) / 60_000_000.0, 0.0)\n\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        s2_grid_active = grid_s2[g_slice]\n\n        ewma_l2 = np.empty(len(EWMA_LAMBDAS_6), dtype=np.float64)\n        ewma_l1 = np.empty(len(EWMA_LAMBDAS_6), dtype=np.float64)\n        s2_bar_k = np.empty(len(EWMA_LAMBDAS_6), dtype=np.float64)\n        for i, lam in enumerate(EWMA_LAMBDAS_6):\n            w_bar = np.exp(-lam * age_bar_min)\n            w_grid = np.exp(-lam * age_grid_min)\n            den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n            s2_bar_k[i] = den / max(float(np.sum(w_grid)), 1e-6)\n            ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n            ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n\n        log_l2 = np.log(np.maximum(ewma_l2, 1e-6))\n        log_l1 = np.log(np.maximum(ewma_l1, 1e-6))\n        log_mad5 = _compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n        if log_mad5 is None:\n            log_mad5 = log_l2\n        log_hl = _compute_ohlc_log_ewma(context_prices, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n        if log_hl is None:\n            log_hl = log_l2\n\n        if is_1h:\n            log_ewma = 0.45 * log_l2 + 0.20 * log_l1 + 0.20 * log_mad5 + 0.15 * log_hl\n            sigma_short = float(np.exp(np.dot(WEIGHTS_1H_START, log_ewma)))\n            sigma_long = float(np.exp(np.dot(WEIGHTS_1H_END, log_ewma)))\n        else:\n            if asset in CRYPTO_ASSETS:\n                log_ewma = 0.55 * log_l2 + 0.20 * (log_l1 + 0.08) + 0.15 * (log_mad5 + 0.06) + 0.10 * log_hl\n                if len(vals) >= 1440:\n                    idx_24h = int(np.searchsorted(valid_pos, max(0, len(vals) - 1440)))\n                    ret_24h = abs(float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_24h]]))) / max(\n                        np.sqrt(np.sum(grid_s2[-1440:])) * ewma_l2[4], 1e-6\n                    )\n                    idx_4h = int(np.searchsorted(valid_pos, max(0, len(vals) - 240)))\n                    ret_4h = abs(float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_4h]]))) / max(\n                        np.sqrt(np.sum(grid_s2[-240:])) * ewma_l2[3], 1e-6\n                    )\n                    brk_mult = float(\n                        np.exp(0.035 * np.clip(ret_24h - 0.80, -0.4, 2.2) + 0.020 * np.clip(ret_4h - 0.80, -0.4, 2.2))\n                    )\n            else:\n                if asset == \"XAU\":\n                    log_ewma = 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n                else:\n                    log_ewma = 0.55 * log_l2 + 0.15 * (log_l1 + 0.05) + 0.22 * (log_mad5 + 0.05) + 0.08 * log_hl\n                if asset in {\"XAU\", \"WTIOIL\", \"GOOGLX\", \"TSLAX\"}:\n                    alpha_k = np.minimum(s2_bar_k / max(s2_fwd_mean, 0.1), 1.0)\n                    diff_k = log_ewma - log_ewma[5]\n                    log_ewma = np.where(diff_k < 0.0, log_ewma[5] + (0.5 + 0.5 * alpha_k) * diff_k, log_ewma)\n            w_long = WEIGHTS_24H_LONG\n            p_w = 0.10\n            sigma_short = float(np.exp(np.dot(WEIGHTS_24H_SHORT, log_ewma)))\n            sigma_long_ctx = float(np.exp(np.dot(w_long, log_ewma)))\n            sigma_long = float(\n                np.exp((1.0 - p_w) * np.log(sigma_long_ctx) + p_w * np.log(lt_sigma))\n            )\n    else:\n        sigma_short = lt_sigma\n        sigma_long = lt_sigma\n\n    c_scale, sig_path_vv, sig_step_vv = _distribution_params(asset, time_length)\n\n    mid_lead_mins = (np.arange(n_inc, dtype=np.float64) + 0.5) * step_mins\n    rev_tau = REVERSION_TAU_1H if is_1h else REVERSION_TAU_24H\n    decay = np.exp(-mid_lead_mins / rev_tau)\n    sigma_base_t = sigma_long * ((sigma_short / max(sigma_long, 1e-8)) ** decay)\n\n    per_step_sigma = (c_scale * brk_mult * sigma_base_t) * step_seas_sqrt\n\n    half = num_simulations // 2\n    if half > 0:\n        eps = rng.standard_normal((half, n_inc))\n        if sig_step_vv > 0.0:\n            eta = rng.standard_normal((half, n_inc))\n            eps = eps * np.exp(sig_step_vv * eta - 0.5 * sig_step_vv * sig_step_vv)\n        if sig_path_vv > 0.0:\n            q_z = _stratified_normal_quantiles(half)\n            m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv * sig_path_vv)[:, None]\n            eps = eps * m_half\n        if num_simulations % 2 == 1:\n            z_extra = rng.standard_normal((1, n_inc))\n            z = np.vstack([eps, -eps, z_extra])\n        else:\n            z = np.vstack([eps, -eps])\n        col_std = np.std(z, axis=0, keepdims=True)\n        z = z / np.where(col_std > 1e-8, col_std, 1.0)\n    else:\n        z = rng.standard_normal((num_simulations, n_inc))\n\n    shocks_inc = z * per_step_sigma[None, :]\n    if is_1h:\n        if asset != \"ETH\":\n            shocks_inc = _apply_secant_shocks(shocks_inc, eta_tot=1.0, eta_blk=0.95, n_blks=4)\n    elif asset in CRYPTO_ASSETS:\n        if asset != \"HYPE\":\n            shocks_inc = _apply_secant_shocks(shocks_inc, eta_tot=0.96, eta_blk=0.96, n_blks=8)\n    else:\n        eta_equ = 1.05 if asset == \"SPCX\" else 1.09\n        shocks_inc = _apply_secant_shocks(shocks_inc, eta_tot=eta_equ, eta_blk=1.0, n_blks=8)\n\n    shocks = np.empty((num_simulations, steps), dtype=np.float64)\n    shocks[:, 0] = 0.0\n    shocks[:, 1:] = shocks_inc\n    paths = last * np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *[p.tolist() for p in paths])","file_path":"/workspace/agent/modeling.py","instruction":"Update simulate() in agent/modeling.py to Iteration 8: add _apply_secant_shocks for orthogonal horizon secant projection, use normalized forward seasonality for CRYPTO_1H and weekend slot calibration for CRYPTO_24H, use the multi-estimator L2/L1/MAD5/OHLC blend for 24h, add multi-hour directional breakout modulation for CRYPTO_24H, and add activity-weighted off-hours damping for COM_EQU_24H."}}
