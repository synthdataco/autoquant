{"type":"tool_use","timestamp":"2026-10-22T03:49:04.129Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_412192","parameters":{"command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nfrom modeling import simulate\n\ndef compare_vs_top(comp, comp_slug, asset, t_start='2026-09-09', t_end='2026-09-15'):\n    df = pd.read_parquet(f'market_data/offline_data/miner_scores_{asset}_{comp_slug}.parquet')\n    df['scored_time'] = pd.to_datetime(df['scored_time'], utc=True)\n    df['start_time'] = df['scored_time'] - pd.Timedelta(seconds=comp.time_length)\n    w = df[(df['scored_time'] >= t_start) & (df['scored_time'] < t_end) & (df['crps'] > 0)]\n    n_p = w['scored_time'].nunique()\n    counts = w.groupby('miner_uid')['scored_time'].nunique()\n    full_uids = counts[counts >= n_p * 0.95].index\n    w_full = w[w['miner_uid'].isin(full_uids)]\n    top_uid = w_full.groupby('miner_uid')['crps'].mean().idxmin()\n    top_s = w_full[w_full['miner_uid'] == top_uid].set_index('start_time')['crps']\n    \n    store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n    times = sorted(top_s.index)[::(6 if comp.time_length==3600 else 1)]\n    prices = load_minute_prices(Path('market_data'), asset, times[0] - pd.Timedelta(days=8), times[-1] + pd.Timedelta(days=2))\n    \n    diffs = []\n    for t0 in times:\n        rp_ser = store.get(t0)\n        if rp_ser is None: continue\n        real = rp_ser.to_numpy(dtype=np.float64)\n        ctx = prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)]\n        out = simulate(asset, t0.isoformat(), comp.time_increment, comp.time_length, 500, ctx)\n        paths = np.asarray(out[2:], dtype=np.float64)\n        # Note: for 1h before 2026-09-22, field was scored without vol_scoring_blocks!\n        vb = {} if (comp.time_length == 3600 and t0 < pd.Timestamp('2026-09-22', tz='UTC')) else comp.vol_scoring_blocks\n        sc, _ = calculate_total_score_for_miner(paths, real, comp.time_increment, comp.scoring_intervals, vb)\n        p0 = paths[:, :1]; log_p = np.log(paths / p0)\n        sc_09, _ = calculate_total_score_for_miner(p0 * np.exp(0.90 * log_p), real, comp.time_increment, comp.scoring_intervals, vb)\n        sc_11, _ = calculate_total_score_for_miner(p0 * np.exp(1.10 * log_p), real, comp.time_increment, comp.scoring_intervals, vb)\n        g = (sc_11 - sc_09) / 0.20\n        r_real = np.diff(np.log(real))\n        real_vol = np.std(r_real)\n        pred_vol = np.std( np.diff(log_p, axis=1) )\n        diffs.append({\n            't0': t0, 'ours': sc, 'top': float(top_s.loc[t0]), 'diff': sc - float(top_s.loc[t0]),\n            'g': g, 'log_vol_err': np.log(pred_vol / max(real_vol, 1e-8)),\n            'hour': t0.hour, 'dow': t0.dayofweek\n        })\n    dfd = pd.DataFrame(diffs)\n    print(f'=== {comp_slug} | {asset} (top_uid={top_uid}, n={len(dfd)}) ===')\n    print(f'  Ours={dfd[\\\"ours\\\"].mean():.2f}, Top={dfd[\\\"top\\\"].mean():.2f}, Ours-Top={dfd[\\\"diff\\\"].mean():+.2f} (win_rate={(dfd[\\\"diff\\\"]<0).mean()*100:.1f}%)')\n    over = dfd[dfd['log_vol_err'] > 0]\n    under = dfd[dfd['log_vol_err'] <= 0]\n    print(f'  When pred_vol > real_vol (n={len(over):3d}): Ours-Top = {over[\\\"diff\\\"].mean():+.2f} | When pred_vol <= real_vol (n={len(under):3d}): Ours-Top = {under[\\\"diff\\\"].mean():+.2f}')\n    wk = dfd[dfd['dow'] < 5]; we = dfd[dfd['dow'] >= 5]\n    print(f'  Weekday (n={len(wk):3d}): Ours-Top = {wk[\\\"diff\\\"].mean():+.2f} | Weekend (n={len(we):3d}): Ours-Top = {we[\\\"diff\\\"].mean():+.2f}')\n\nfor a in ['BTC', 'SOL', 'XRP']:\n    compare_vs_top(CRYPTO_1H, 'crypto-1h', a)\n    compare_vs_top(CRYPTO_24H, 'crypto-24h', a)\nfor a in ['XAU', 'NVDAX', 'TSLAX', 'AAPLX', 'WTIOIL', 'SPCX', 'SP500']:\n    compare_vs_top(COM_EQU_24H, 'com-equ-24h', a)\n\"","description":"Compare our model vs the #1 miner on 2026-09-09..2026-09-15 and break down differences by vol error and weekday/weekend"}}
