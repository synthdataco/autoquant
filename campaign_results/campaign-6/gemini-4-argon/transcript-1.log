{"type":"tool_use","timestamp":"2026-10-22T02:49:33.919Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_275174","parameters":{"description":"Measure variance ratio across 1m, 5m, 30m, 3h horizons for all 13 assets on pre-validation data","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices\n\nfor asset in ['BTC', 'ETH', 'SOL', 'XRP', 'HYPE', 'XAU', 'NVDAX', 'GOOGLX', 'TSLAX', 'AAPLX', 'WTIOIL', 'SPCX', 'SP500']:\n    mp = load_minute_prices(Path('market_data'), asset, pd.Timestamp('2026-06-23', tz='UTC'), pd.Timestamp('2026-09-08', tz='UTC'))\n    c = mp['close']\n    v_pos = np.flatnonzero(np.isfinite(c.to_numpy()))\n    vals = c.to_numpy()[v_pos]\n    r1 = np.diff(np.log(vals))\n    dt1 = np.diff(v_pos)\n    var1_rate = np.sum(r1[dt1==1]**2) / max(np.sum(dt1==1), 1)\n    # 5m subsampled on non-NaN pairs vs realized store\n    c5 = c.iloc[::5]\n    v5 = np.flatnonzero(np.isfinite(c5.to_numpy()))\n    r5 = np.diff(np.log(c5.to_numpy()[v5]))\n    dt5 = np.diff(v5)\n    var5_rate = np.sum(r5[dt5==1]**2) / (5.0 * max(np.sum(dt5==1), 1))\n    \n    c30 = c.iloc[::30]\n    v30 = np.flatnonzero(np.isfinite(c30.to_numpy()))\n    r30 = np.diff(np.log(c30.to_numpy()[v30]))\n    dt30 = np.diff(v30)\n    var30_rate = np.sum(r30[dt30==1]**2) / (30.0 * max(np.sum(dt30==1), 1))\n\n    c180 = c.iloc[::180]\n    v180 = np.flatnonzero(np.isfinite(c180.to_numpy()))\n    r180 = np.diff(np.log(c180.to_numpy()[v180]))\n    dt180 = np.diff(v180)\n    var180_rate = np.sum(r180[dt180==1]**2) / (180.0 * max(np.sum(dt180==1), 1))\n\n    print(f'{asset:<7} | sqrt(VR_5m/1m)={np.sqrt(var5_rate/var1_rate):.3f} | sqrt(VR_30m/5m)={np.sqrt(var30_rate/var5_rate):.3f} | sqrt(VR_3h/5m)={np.sqrt(var180_rate/var5_rate):.3f}')\n\""}}
