comp.time_increment, comp.scoring_intervals, comp.vol_scoring_blocks)\n        if score < 0:\n            continue\n        n_valid += 1\n        for d in details:\n            k = d['Interval']\n            int_totals[k] = int_totals.get(k, 0.0) + d['CRPS'] * d.get('Weight', 1.0)\n        p0 = paths[:, :1]\n        log_p = np.log(paths / p0)\n        for s in scale_sweeps:\n            spaths = p0 * np.exp(s * log_p)\n            _, sdetails = calculate_total_score_for_miner(spaths, real, comp.time_increment, comp.scoring_intervals, comp.vol_scoring_blocks)\n            for d in sdetails:\n                k = d['Interval']\n                scale_sweeps[s][k] = scale_sweeps[s].get(k, 0.0) + d['CRPS'] * d.get('Weight', 1.0)\n    print(f'=== {comp.label} | {asset} ({n_valid} prompts, {eval_start_str}..{eval_end_str}) ===')\n    for k, v in int_totals.items():\n        best_s = min(scale_sweeps, key=lambda s: scale_sweeps[s][k])\n        best_v = scale_sweeps[best_s][k] / n_valid\n        print(f'  {k:<14}: {v/n_valid:8.3f} | best_scale={best_s:.2f} -> {best_v:8.3f} (diff={best_v - v/n_valid:+.3f})')\n\nanalyze_comp(CRYPTO_1H, 'BTC', '2026-09-09', '2026-09-15', step_stride=6)\nanalyze_comp(CRYPTO_1H, 'SOL', '2026-09-09', '2026-09-15', step_stride=6)\nanalyze_comp(CRYPTO_24H, 'BTC', '2026-09-09', '2026-09-15', step_stride=1)\nanalyze_comp(COM_EQU_24H, 'NVDAX', '2026-09-09', '2026-09-15', step_stride=1)\nanalyze_comp(COM_EQU_24H, 'AAPLX', '2026-09-09', '2026-09-15', step_stride=1)\nanalyze_comp(COM_EQU_24H, 'SPCX', '2026-09-09', '2026-09-15', step_stride=1)\n\"","description":"Run interval-by-interval CRPS decomposition on 2026-09-09..2026-09-15"}}
