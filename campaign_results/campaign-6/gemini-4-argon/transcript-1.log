{"type":"tool_use","timestamp":"2026-10-22T05:56:00.857Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_327186","parameters":{"command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\ndef _collect_prompt(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx = args\n    out = mod.simulate(asset, t0_iso, ti, tl, 250, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]; log_p = np.log(paths / p0)\n    c0, _ = calculate_total_score_for_miner(paths, real, ti, intervals, vol_blocks)\n    if c0 < 0: return None\n    du = 0.08\n    cp, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(du)*log_p), real, ti, intervals, vol_blocks)\n    cm, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(-du)*log_p), real, ti, intervals, vol_blocks)\n    g = (cp - cm) / (2.0 * du)\n    h = max((cp - 2.0 * c0 + cm) / (du * du), 1.0)\n    \n    is_1h = tl <= 3600\n    vals = ctx['close'].to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    grid_us = mod._index_to_utc_us(ctx.index)\n    s2_back = mod._S2_BACK_336[asset]\n    s2_fwd = s2_back if is_1h else mod._S2_FWD_336.get(asset, s2_back)\n    grid_s2 = s2_back[mod._slots_from_utc_us(grid_us)] * mod._subslot_modulation(grid_us, asset, is_1h) * mod._event_variance_multiplier(grid_us, asset)\n    grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n    rets = np.diff(np.log(vals[valid_pos]))\n    ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n    rate_ds = (rets ** 2) / ds2\n    pos_rates = rate_ds[rate_ds > 0]\n    cap_ds = float(np.percentile(pos_rates, 98.5)) if pos_rates.size > 10 else 1.0\n    r2_win = np.minimum(rate_ds, cap_ds) * ds2\n    r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n    t_end_us = int(grid_us[-1])\n    valid_us = grid_us[valid_pos]\n    age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n    g_slice = slice(int(valid_pos[0]), len(grid_us))\n    age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n    s2_grid_active = grid_s2[g_slice]\n    ewma_l2 = np.empty(6); ewma_l1 = np.empty(6); s2_bar_k = np.empty(6)\n    for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n        w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min)\n        den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n        s2_bar_k[i] = den / max(float(np.sum(w_grid)), 1e-6)\n        ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n        ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n    log_l2 = np.log(ewma_l2); log_l1 = np.log(ewma_l1)\n    log_mad5 = mod._compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n    log_hl = mod._compute_ohlc_log_ewma(ctx, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n    if is_1h:\n        log_ewma = 0.45 * log_l2 + 0.20 * log_l1 + 0.20 * log_mad5 + 0.15 * log_hl\n    else:\n        if asset in mod.CRYPTO_ASSETS:\n            log_ewma = 0.80 * log_l2 + 0.20 * (log_l1 + 0.20)\n        else:\n            log_ewma = 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n    t0 = pd.Timestamp(t0_iso)\n    return {\n        't0': t0, 'dow': t0.dayofweek, 'hour': t0.hour, 'c0': c0, 'g': g, 'h': h,\n        'log_ewma': log_ewma, 'log_l2': log_l2, 'log_l1': log_l1, 'log_mad5': log_mad5,\n        's2_bar_k': s2_bar_k,\n    }\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [CRYPTO_1H, CRYPTO_24H, COM_EQU_24H]:\n        print(f'================ {comp.label} Cross-Validated Session & EWMA Test ================', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='1D')\n            all_p = []\n            p_stride = 18 if comp.time_length <= 3600 else 3\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::p_stride]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)):\n                        all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [\n                (asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, comp.vol_scoring_blocks, rp,\n                 prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)])\n                for t0, rp in all_p\n            ]\n            df = pd.DataFrame([r for r in ex.map(_collect_prompt, tasks) if r is not None])\n            # Define 7 session buckets\n            if comp.time_length <= 3600:\n                sess = np.where(df['dow']==5, 'Sat',\n                       np.where(df['dow']==6, 'Sun',\n                       np.where(df['hour']<8, 'Wk_00_08',\n                       np.where(df['hour']<13, 'Wk_08_13',\n                       np.where(df['hour']<16, 'Wk_13_16',\n                       np.where(df['hour']<20, 'Wk_16_20', 'Wk_20_24'))))))\n            else:\n                sess = np.where(df['dow']==5, 'Sat',\n                       np.where((df['dow']==6) & (df['hour']<12), 'Sun_AM',\n                       np.where((df['dow']==6) & (df['hour']>=12), 'Sun_PM',\n                       np.where((df['dow']==4) & (df['hour']>=12), 'Fri_PM',\n                       np.where((df['dow']==4) & (df['hour']<12), 'Fri_AM',\n                       np.where(df['hour']<12, 'Wk_AM', 'Wk_PM'))))))\n            df['sess'] = sess\n            h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n            # Fit session du with shrinkage 0.6 on H1 -> eval on H2, and fit on H2 -> eval on H1\n            du_cv = np.zeros(len(df))\n            for s_val in np.unique(sess):\n                m1 = h1 & (df['sess'] == s_val)\n                m2 = h2 & (df['sess'] == s_val)\n                u1 = -0.6 * df.loc[m1, 'g'].sum() / max(df.loc[m1, 'h'].sum(), 1.0)\n                u2 = -0.6 * df.loc[m2, 'g'].sum() / max(df.loc[m2, 'h'].sum(), 1.0)\n                du_cv[m2] = u1\n                du_cv[m1] = u2\n            dcrps_cv = df['g'] * du_cv + 0.5 * df['h'] * (du_cv ** 2)\n            print(f'  {asset:<7} | CV_session dCRPS: All={dcrps_cv.mean():+.3f} (H1_oos={dcrps_cv[h1].mean():+.3f}, H2_oos={dcrps_cv[h2].mean():+.3f})', flush=True)\n\"","description":"Run out-of-sample cross-validation (H1 <-> H2) of 7-session forward scale calibration across all 18 asset-competition pairs"}}
