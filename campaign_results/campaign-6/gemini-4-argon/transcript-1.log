{"type":"tool_use","timestamp":"2026-10-22T03:02:41.455Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_244812","parameters":{"description":"Run parallel scale and interval diagnostic across all 18 asset-competition pairs on pre-validation data","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nfrom modeling import simulate\n\nSCALES = [0.80, 0.85, 0.90, 0.95, 1.00, 1.05, 1.10, 1.15]\n\ndef _eval_one(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx = args\n    out = simulate(asset, t0_iso, ti, tl, 250, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]\n    log_p = np.log(paths / p0)\n    pred_vol = float(np.std(log_p[:, -1]))\n    s_scores = {}\n    int_scores = {}\n    for s in SCALES:\n        spaths = p0 * np.exp(s * log_p)\n        sc, det = calculate_total_score_for_miner(spaths, real, ti, intervals, vol_blocks)\n        s_scores[s] = sc\n        int_scores[s] = {d['Interval']: d['CRPS'] * d.get('Weight', 1.0) for d in det}\n    return pred_vol, s_scores, int_scores\n\ndef diag_asset(executor, comp, asset, d_start='2026-07-25', d_end='2026-09-12', day_stride=3, prompt_stride=6):\n    store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n    days = pd.date_range(d_start, d_end, freq=f'{day_stride}D')\n    all_prompts = []\n    for d in days:\n        entries = store._load_day(d.date())\n        for t0 in sorted(entries)[::prompt_stride]:\n            real = np.asarray(entries[t0], dtype=np.float64)\n            if not np.all(np.isnan(real)):\n                all_prompts.append((t0, real))\n    if not all_prompts:\n        return\n    t_min = all_prompts[0][0] - pd.Timedelta(days=8)\n    t_max = all_prompts[-1][0] + pd.Timedelta(days=1)\n    prices = load_minute_prices(Path('market_data'), asset, t_min, t_max)\n    tasks = [\n        (asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, comp.vol_scoring_blocks, real,\n         prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)])\n        for t0, real in all_prompts\n    ]\n    res = list(executor.map(_eval_one, tasks))\n    n = len(res)\n    tot_by_s = {s: sum(r[1][s] for r in res) for s in SCALES}\n    int_keys = [k for k in res[0][2][1.0] if k not in ('Overall', 'Vol')]\n    int_by_s = {s: {k: sum(r[2][s][k] for r in res) for k in int_keys} for s in SCALES}\n    best_s = min(SCALES, key=lambda s: tot_by_s[s])\n    med_vol = np.median([r[0] for r in res])\n    low_rec = [r[1] for r in res if r[0] <= med_vol]\n    high_rec = [r[1] for r in res if r[0] > med_vol]\n    best_s_low = min(SCALES, key=lambda s: sum(r[s] for r in low_rec))\n    best_s_high = min(SCALES, key=lambda s: sum(r[s] for r in high_rec))\n    int_str = ' | '.join(f\\\"{k}:{min(SCALES, key=lambda s: int_by_s[s][k]):.2f}\\\" for k in int_keys)\n    print(f'{comp.label[:10]:<10} {asset:<7} (n={n:3d}) | CRPS(1.0)={tot_by_s[1.0]/n:8.2f} -> best_s={best_s:.2f} ({(tot_by_s[best_s]-tot_by_s[1.0])/n:+6.2f}) | low_vol_s={best_s_low:.2f}, high_vol_s={best_s_high:.2f} | {int_str}', flush=True)\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for a in CRYPTO_24H.asset_list:\n        diag_asset(ex, CRYPTO_24H, a, day_stride=3, prompt_stride=6)\n    for a in COM_EQU_24H.asset_list:\n        diag_asset(ex, COM_EQU_24H, a, day_stride=3, prompt_stride=6)\n    for a in CRYPTO_1H.asset_list:\n        diag_asset(ex, CRYPTO_1H, a, day_stride=3, prompt_stride=36)\n\""}}
