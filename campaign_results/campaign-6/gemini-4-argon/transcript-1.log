{"type":"tool_use","timestamp":"2026-10-22T09:56:41.642Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_60204","parameters":{"command":"uv run python -c \"\nimport numpy as np, pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys; sys.path.insert(0, 'agent'); import modeling as mod\n\ndef _test_asym_pw(args):\n    asset, t0_iso, intervals, real, ctx = args\n    out = mod.simulate(asset, t0_iso, 300, 86400, 250, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]; log_p = np.log(paths / p0)\n    c0, _ = calculate_total_score_for_miner(paths, real, 300, intervals, {})\n    if c0 < 0: return None\n    du = 0.08\n    cp, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(du)*log_p), real, 300, intervals, {})\n    cm, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(-du)*log_p), real, 300, intervals, {})\n    g = (cp - cm) / (2.0 * du); h = max((cp - 2.0 * c0 + cm) / (du * du), 1.0)\n    \n    vals = ctx['close'].to_numpy(dtype=np.float64); valid_pos = np.flatnonzero(np.isfinite(vals))\n    grid_us = mod._index_to_utc_us(ctx.index); s2_back = mod._S2_BACK_336[asset]\n    grid_s2 = s2_back[mod._slots_from_utc_us(grid_us)] * mod._subslot_modulation(grid_us, asset, False) * mod._event_variance_multiplier(grid_us, asset)\n    grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n    rets = np.diff(np.log(vals[valid_pos]))\n    ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n    rate_ds = (rets ** 2) / ds2; cap_ds = float(np.percentile(rate_ds[rate_ds > 0], 98.5))\n    r2_win = np.minimum(rate_ds, cap_ds) * ds2; r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n    t_end_us = int(grid_us[-1]); valid_us = grid_us[valid_pos]\n    age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n    g_slice = slice(int(valid_pos[0]), len(grid_us)); age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0); s2_grid_active = grid_s2[g_slice]\n    ewma_l2 = np.empty(6); ewma_l1 = np.empty(6)\n    for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n        w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min); den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n        ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12)); ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n    log_l2 = np.log(ewma_l2); log_l1 = np.log(ewma_l1)\n    log_mad5 = mod._compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n    le = 0.80 * log_l2 + 0.20 * (log_l1 + 0.20) if asset in mod.CRYPTO_ASSETS else 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n    sig_l_ctx = float(np.exp(np.dot(mod.WEIGHTS_24H_LONG, le)))\n    lt_sigma = mod.LONG_TERM_SIGMA_1M[asset]\n    du_asym = 0.75 * 0.10 * min(np.log(sig_l_ctx / lt_sigma), 0.0)\n    return {'t0': pd.Timestamp(t0_iso), 'dcrps': g * du_asym + 0.5 * h * (du_asym ** 2)}\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [CRYPTO_24H, COM_EQU_24H]:\n        print(f'=== {comp.label} Asymmetric Prior Reversion Test ===', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, 86400, 300)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n            all_p = []\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::4]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)): all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [(asset, t0.isoformat(), comp.scoring_intervals, rp, prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, 86400)]) for t0, rp in all_p]\n            df = pd.DataFrame([r for r in ex.map(_test_asym_pw, tasks) if r is not None])\n            h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n            print(f'  {asset:<7} | All={df[\\\"dcrps\\\"].mean():+.3f} (H1={df.loc[h1,\\\"dcrps\\\"].mean():+.3f}, H2={df.loc[h2,\\\"dcrps\\\"].mean():+.3f})', flush=True)\n\"","description":"Test asymmetric prior mean-reversion (only when sigma_long_ctx > lt_sigma) across Pre-Half 1 and Pre-Half 2"}}
{"type":"tool_result","timestamp":"2026-10-22T10:05:45.810Z","tool_id":"run_shell_command__call_60204","status":"success","output":"=== Crypto 24h Asymmetric Prior Reversion Test ===\n  BTC     | All=+0.360 (H1=-0.383, H2=+1.104)\n  ETH     | All=+0.237 (H1=-0.866, H2=+1.340)\n  SOL     | All=+0.005 (H1=-1.691, H2=+1.701)\n  XRP     | All=+0.875 (H1=-0.654, H2=+2.403)\n  HYPE    | All=+2.448 (H1=+0.434, H2=+4.463)\n=== Commodities/Equities 24h Asymmetric Prior Reversion Test ===\n  XAU     | All=+0.226 (H1=+0.153, H2=+0.299)\n  NVDAX   | All=+0.217 (H1=-0.214, H2=+0.649)\n  GOOGLX  | All=-0.010 (H1=-0.021, H2=+0.001)\n  TSLAX   | All=+0.544 (H1=+0.818, H2=+0.270)\n  AAPLX   | All=+0.029 (H1=-0.094, H2=+0.151)\n  WTIOIL  | All=-0.058 (H1=-0.008, H2=-0.109)\n  SPCX    | All=+0.059 (H1=+3.425, H2=-3.307)\n  SP500   | All=+0.127 (H1=-0.204, H2=+0.369)"}
