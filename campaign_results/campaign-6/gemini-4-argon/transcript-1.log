{"type":"tool_use","timestamp":"2026-10-22T09:28:47.562Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_749252","parameters":{"command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\n# Let's test strictly mean-neutral CRYPTO_24H components on Pre-Validation (H1 and H2)!\ndef sim_c24_neutral(asset, start_time, time_increment=300, time_length=86_400, num_simulations=300, context_prices=None):\n    rng = mod._make_rng(asset, start_time, time_length)\n    steps = time_length // time_increment + 1\n    n_inc = steps - 1\n    step_mins = max(time_increment // 60, 1)\n\n    close_series = context_prices['close'] if isinstance(context_prices, pd.DataFrame) else context_prices\n    full_idx = context_prices.index\n    vals = close_series.to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    last = float(vals[valid_pos[-1]]) if valid_pos.size else 1.0\n\n    s2_back = mod._S2_BACK_336.get(asset, mod._DEFAULT_S2_336)\n    s2_fwd_orig = mod._S2_FWD_336.get(asset, s2_back)\n    s2_fwd = s2_fwd_orig.copy()\n    orig_mean = float(np.mean(s2_fwd))\n    s2_fwd[232:320] *= 0.90\n    s2_fwd *= orig_mean / float(np.mean(s2_fwd))\n    lt_sigma = mod.LONG_TERM_SIGMA_1M.get(asset, 5e-4)\n\n    start_us = mod._timestamp_to_utc_us(start_time)\n    fwd_us = start_us + np.arange(1, n_inc * step_mins + 1, dtype=np.int64) * 60_000_000\n    fwd_slots = mod._slots_from_utc_us(fwd_us)\n    fwd_s2_min = s2_fwd[fwd_slots] * mod._subslot_modulation(fwd_us, asset, False) * mod._event_variance_multiplier(fwd_us, asset)\n    fwd_s2 = fwd_s2_min.reshape(n_inc, step_mins).sum(axis=1)\n    step_seas_sqrt = np.sqrt(np.maximum(fwd_s2, 1e-4))\n\n    brk_mult = 1.0\n    if valid_pos.size > 10:\n        grid_us = mod._index_to_utc_us(full_idx)\n        grid_s2 = s2_back[mod._slots_from_utc_us(grid_us)] * mod._subslot_modulation(grid_us, asset, False) * mod._event_variance_multiplier(grid_us, asset)\n        grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n        rate_ds = (rets ** 2) / ds2\n        cap_ds = float(np.percentile(rate_ds[rate_ds > 0], 98.5))\n        r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n        t_end_us = int(grid_us[-1]); valid_us = grid_us[valid_pos]\n        age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        s2_grid_active = grid_s2[g_slice]\n        ewma_l2 = np.empty(6); ewma_l1 = np.empty(6)\n        for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n            w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min)\n            den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n            ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n            ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n        log_l2 = np.log(np.maximum(ewma_l2, 1e-6))\n        log_l1 = np.log(np.maximum(ewma_l1, 1e-6))\n        log_mad5 = mod._compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n        if log_mad5 is None: log_mad5 = log_l2\n        log_hl = mod._compute_ohlc_log_ewma(context_prices, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n        if log_hl is None: log_hl = log_l2\n\n        # Mean-neutral multi-estimator blend (matches mean of 0.80*log_l2 + 0.20*(log_l1 + 0.20) within 0.002)\n        log_ewma = 0.60 * log_l2 + 0.15 * (log_l1 + 0.15) + 0.15 * (log_mad5 + 0.14) + 0.10 * log_hl\n        if len(vals) >= 1440:\n            idx_24h = int(np.searchsorted(valid_pos, max(0, len(vals) - 1440)))\n            ret_24h = abs(float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_24h]]))) / max(np.sqrt(np.sum(grid_s2[-1440:])) * ewma_l2[4], 1e-6)\n            idx_4h = int(np.searchsorted(valid_pos, max(0, len(vals) - 240)))\n            ret_4h = abs(float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_4h]]))) / max(np.sqrt(np.sum(grid_s2[-240:])) * ewma_l2[3], 1e-6)\n            brk_mult = float(np.exp(0.025 * np.clip(ret_24h - 0.85, -0.35, 1.8) + 0.015 * np.clip(ret_4h - 0.85, -0.35, 1.8)))\n        sigma_short = float(np.exp(np.dot(mod.WEIGHTS_24H_SHORT, log_ewma)))\n        sigma_long_ctx = float(np.exp(np.dot(mod.WEIGHTS_24H_LONG, log_ewma)))\n        sigma_long = float(np.exp(0.90 * np.log(sigma_long_ctx) + 0.10 * np.log(lt_sigma)))\n    else:\n        sigma_short = lt_sigma; sigma_long = lt_sigma\n\n    c_scale, sig_path_vv, sig_step_vv = mod._distribution_params(asset, time_length)\n    mid_lead_mins = (np.arange(n_inc, dtype=np.float64) + 0.5) * step_mins\n    decay = np.exp(-mid_lead_mins / mod.REVERSION_TAU_24H)\n    sigma_base_t = sigma_long * ((sigma_short / max(sigma_long, 1e-8)) ** decay)\n    per_step_sigma = (c_scale * brk_mult * sigma_base_t) * step_seas_sqrt\n\n    half = num_simulations // 2\n    eps = rng.standard_normal((half, n_inc))\n    eta = rng.standard_normal((half, n_inc))\n    eps = eps * np.exp(sig_step_vv * eta - 0.5 * sig_step_vv * sig_step_vv)\n    q_z = mod._stratified_normal_quantiles(half)\n    m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv * sig_path_vv)[:, None]\n    eps = eps * m_half\n    z = np.vstack([eps, -eps])\n    col_std = np.std(z, axis=0, keepdims=True)\n    z = z / np.where(col_std > 1e-8, col_std, 1.0)\n    shocks_inc = z * per_step_sigma[None, :]\n    if asset != 'HYPE':\n        shocks_inc = mod._apply_secant_shocks(shocks_inc, eta_tot=0.98, eta_blk=0.97, n_blks=8)\n    shocks = np.empty((num_simulations, steps), dtype=np.float64)\n    shocks[:, 0] = 0.0; shocks[:, 1:] = shocks_inc\n    return last * np.exp(np.cumsum(shocks, axis=1))\n\n# Also let's compare against Iter 6 on Pre-Validation (H1 and H2)!\ndef sim_iter6_c24(asset, start_time, time_increment=300, time_length=86_400, num_simulations=300, context_prices=None):\n    rng = mod._make_rng(asset, start_time, time_length)\n    steps = time_length // time_increment + 1; n_inc = steps - 1; step_mins = max(time_increment // 60, 1)\n    close_series = context_prices['close'] if isinstance(context_prices, pd.DataFrame) else context_prices\n    full_idx = context_prices.index; vals = close_series.to_numpy(dtype=np.float64); valid_pos = np.flatnonzero(np.isfinite(vals))\n    last = float(vals[valid_pos[-1]]) if valid_pos.size else 1.0\n    s2_back = mod._S2_BACK_336[asset]; s2_fwd = mod._S2_FWD_336[asset]; lt_sigma = mod.LONG_TERM_SIGMA_1M[asset]\n    grid_us = mod._index_to_utc_us(full_idx)\n    grid_s2 = s2_back[mod._slots_from_utc_us(grid_us)] * mod._subslot_modulation(grid_us, asset, False) * mod._event_variance_multiplier(grid_us, asset)\n    grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n    rets = np.diff(np.log(vals[valid_pos]))\n    ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n    rate_ds = (rets ** 2) / ds2; cap_ds = float(np.percentile(rate_ds[rate_ds > 0], 98.5))\n    r2_win = np.minimum(rate_ds, cap_ds) * ds2; r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n    t_end_us = int(grid_us[-1]); valid_us = grid_us[valid_pos]\n    age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n    g_slice = slice(int(valid_pos[0]), len(grid_us)); age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0); s2_grid_active = grid_s2[g_slice]\n    ewma_l2 = np.empty(6); ewma_l1 = np.empty(6)\n    for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n        w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min); den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n        ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12)); ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n    log_ewma = 0.80 * np.log(ewma_l2) + 0.20 * (np.log(ewma_l1) + 0.20)\n    sigma_short = float(np.exp(np.dot(mod.WEIGHTS_24H_SHORT, log_ewma)))\n    sigma_long = float(np.exp(0.90 * np.dot(mod.WEIGHTS_24H_LONG, log_ewma) + 0.10 * np.log(lt_sigma)))\n    c_scale, sig_path_vv, sig_step_vv = mod._distribution_params(asset, time_length)\n    start_us = mod._timestamp_to_utc_us(start_time); fwd_us = start_us + np.arange(1, n_inc * step_mins + 1, dtype=np.int64) * 60_000_000\n    fwd_s2_min = s2_fwd[mod._slots_from_utc_us(fwd_us)] * mod._subslot_modulation(fwd_us, asset, False) * mod._event_variance_multiplier(fwd_us, asset)\n    step_seas_sqrt = np.sqrt(np.maximum(fwd_s2_min.reshape(n_inc, step_mins).sum(axis=1), 1e-4))\n    decay = np.exp(-(np.arange(n_inc, dtype=np.float64) + 0.5) * step_mins / mod.REVERSION_TAU_24H)\n    per_step_sigma = c_scale * sigma_long * ((sigma_short / max(sigma_long, 1e-8)) ** decay) * step_seas_sqrt\n    half = num_simulations // 2\n    eps = rng.standard_normal((half, n_inc)) * np.exp(sig_step_vv * rng.standard_normal((half, n_inc)) - 0.5 * sig_step_vv**2)\n    eps = eps * np.exp(sig_path_vv * mod._stratified_normal_quantiles(half) - 0.5 * sig_path_vv**2)[:, None]\n    z = np.vstack([eps, -eps]); z = z / np.std(z, axis=0, keepdims=True)\n    shocks = np.empty((num_simulations, steps), dtype=np.float64); shocks[:, 0] = 0.0; shocks[:, 1:] = z * per_step_sigma[None, :]\n    return last * np.exp(np.cumsum(shocks, axis=1))\n\ndef _cmp(args):\n    asset, t0_iso, intervals, real, ctx = args\n    p6 = sim_iter6_c24(asset, t0_iso, 300, 86400, 300, ctx)\n    pn = sim_c24_neutral(asset, t0_iso, 300, 86400, 300, ctx)\n    c6, _ = calculate_total_score_for_miner(p6, real, 300, intervals, {})\n    cn, _ = calculate_total_score_for_miner(pn, real, 300, intervals, {})\n    return {'t0': pd.Timestamp(t0_iso), 'diff': cn - c6}\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for asset in CRYPTO_24H.asset_list:\n        store = RealizedPathStore(asset, 86400, 300)\n        days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n        all_p = []\n        for d in days:\n            entries = store._load_day(d.date())\n            for t0 in sorted(entries)[::4]:\n                rp = np.asarray(entries[t0], dtype=np.float64)\n                if not np.all(np.isnan(rp)): all_p.append((t0, rp))\n        prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n        tasks = [(asset, t0.isoformat(), CRYPTO_24H.scoring_intervals, rp, prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, 86400)]) for t0, rp in all_p]\n        df = pd.DataFrame(list(ex.map(_cmp, tasks)))\n        h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n        print(f'  {asset:<6} | All={df[\\\"diff\\\"].mean():+.3f} (H1={df.loc[h1,\\\"diff\\\"].mean():+.3f}, H2={df.loc[h2,\\\"diff\\\"].mean():+.3f})', flush=True)\n\"","description":"Test mean-neutral CRYPTO_24H improvements across Pre-Half 1 and Pre-Half 2"}}
