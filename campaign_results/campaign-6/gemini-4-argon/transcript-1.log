0.39(-0.60/-0.21) | blk95_tot96:-0.42(-0.69/-0.18) | blk93:-0.38(-0.60/-0.19)"}
{"type":"tool_use","timestamp":"2026-10-22T08:43:55.247Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_7231","parameters":{"command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\ndef apply_secant_shocks(shocks_inc: np.ndarray, eta_tot: float, eta_blk: float = 1.0, n_blks: int = 8) -> np.ndarray:\n    out = shocks_inc\n    if eta_blk != 1.0 and out.shape[1] >= n_blks:\n        b_len = out.shape[1] // n_blks\n        out = out.copy()\n        for b in range(n_blks):\n            sl = slice(b * b_len, (b + 1) * b_len)\n            sub = out[:, sl]\n            s2 = np.var(sub, axis=0)\n            w = s2 / max(float(np.sum(s2)), 1e-12)\n            b_sum = np.sum(sub, axis=1, keepdims=True)\n            out[:, sl] = sub + (eta_blk - 1.0) * b_sum * w[None, :]\n    if eta_tot != 1.0:\n        s2 = np.var(out, axis=0)\n        w = s2 / max(float(np.sum(s2)), 1e-12)\n        t_sum = np.sum(out, axis=1, keepdims=True)\n        out = out + (eta_tot - 1.0) * t_sum * w[None, :]\n    return out\n\ndef sim_iter8(asset, start_time, time_increment=300, time_length=86_400, num_simulations=1000, context_prices=None):\n    rng = mod._make_rng(asset, start_time, time_length)\n    steps = time_length // time_increment + 1\n    n_inc = steps - 1\n    step_mins = max(time_increment // 60, 1)\n    is_1h = time_length <= 3600\n\n    close_series = context_prices['close'] if isinstance(context_prices, pd.DataFrame) else context_prices\n    full_idx = context_prices.index\n    vals = close_series.to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    last = float(vals[valid_pos[-1]]) if valid_pos.size else 1.0\n\n    s2_back = mod._S2_BACK_336.get(asset, mod._DEFAULT_S2_336)\n    if is_1h:\n        s2_f_raw = mod._S2_FWD_336.get(asset, s2_back)\n        s2_f_norm = s2_f_raw / np.mean(s2_f_raw)\n        s2_btc_norm = mod._S2_FWD_336['BTC'] / np.mean(mod._S2_FWD_336['BTC'])\n        s2_fwd = 0.35 * s2_back + 0.45 * s2_f_norm + 0.20 * s2_btc_norm\n    else:\n        s2_fwd = mod._S2_FWD_336.get(asset, s2_back)\n        if asset in mod.CRYPTO_ASSETS:\n            s2_fwd = s2_fwd.copy()\n            s2_fwd[232:320] *= 0.85\n    lt_sigma = mod.LONG_TERM_SIGMA_1M.get(asset, 5e-4)\n\n    start_us = mod._timestamp_to_utc_us(start_time)\n    fwd_min_offsets = np.arange(1, n_inc * step_mins + 1, dtype=np.int64)\n    fwd_us = start_us + fwd_min_offsets * 60_000_000\n    fwd_slots = mod._slots_from_utc_us(fwd_us)\n    fwd_s2_min = (\n        s2_fwd[fwd_slots]\n        * mod._subslot_modulation(fwd_us, asset, is_1h)\n        * mod._event_variance_multiplier(fwd_us, asset)\n    )\n    fwd_s2 = fwd_s2_min.reshape(n_inc, step_mins).sum(axis=1)\n    step_seas_sqrt = np.sqrt(np.maximum(fwd_s2, 1e-4))\n    s2_fwd_mean = float(np.mean(fwd_s2_min))\n\n    brk_mult = 1.0\n    if valid_pos.size > 10:\n        grid_us = mod._index_to_utc_us(full_idx)\n        grid_slots = mod._slots_from_utc_us(grid_us)\n        grid_s2 = (\n            s2_back[grid_slots]\n            * mod._subslot_modulation(grid_us, asset, is_1h)\n            * mod._event_variance_multiplier(grid_us, asset)\n        )\n        grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        valid_vals = vals[valid_pos]\n        rets = np.diff(np.log(valid_vals))\n        finite = np.isfinite(rets)\n        if not np.all(finite):\n            rets = np.where(finite, rets, 0.0)\n        ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n        rate_ds = (rets ** 2) / ds2\n        pos_rates = rate_ds[rate_ds > 0]\n        cap_ds = float(np.percentile(pos_rates, 98.5)) if pos_rates.size > 10 else 1.0\n        r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        s2_grid_active = grid_s2[g_slice]\n\n        ewma_l2 = np.empty(6); ewma_l1 = np.empty(6); s2_bar_k = np.empty(6)\n        for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n            w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min)\n            den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n            s2_bar_k[i] = den / max(float(np.sum(w_grid)), 1e-6)\n            ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n            ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n\n        log_l2 = np.log(np.maximum(ewma_l2, 1e-6))\n        log_l1 = np.log(np.maximum(ewma_l1, 1e-6))\n        log_mad5 = mod._compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n        if log_mad5 is None: log_mad5 = log_l2\n        log_hl = mod._compute_ohlc_log_ewma(context_prices, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n        if log_hl is None: log_hl = log_l2\n\n        if is_1h:\n            log_ewma = 0.45 * log_l2 + 0.20 * log_l1 + 0.20 * log_mad5 + 0.15 * log_hl\n            sigma_short = float(np.exp(np.dot(mod.WEIGHTS_1H_START, log_ewma)))\n            sigma_long = float(np.exp(np.dot(mod.WEIGHTS_1H_END, log_ewma)))\n        else:\n            if asset in mod.CRYPTO_ASSETS:\n                log_ewma = 0.55 * log_l2 + 0.20 * (log_l1 + 0.08) + 0.15 * (log_mad5 + 0.06) + 0.10 * log_hl\n                if len(vals) >= 1440:\n                    idx_24h = int(np.searchsorted(valid_pos, max(0, len(vals) - 1440)))\n                    ret_24h = abs(float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_24h]]))) / max(np.sqrt(np.sum(grid_s2[-1440:])) * ewma_l2[4], 1e-6)\n                    idx_4h = int(np.searchsorted(valid_pos, max(0, len(vals) - 240)))\n                    ret_4h = abs(float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_4h]]))) / max(np.sqrt(np.sum(grid_s2[-240:])) * ewma_l2[3], 1e-6)\n                    brk_mult = float(np.exp(0.035 * np.clip(ret_24h - 0.80, -0.4, 2.2) + 0.020 * np.clip(ret_4h - 0.80, -0.4, 2.2)))\n            else:\n                if asset == 'XAU':\n                    log_ewma = 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n                else:\n                    log_ewma = 0.55 * log_l2 + 0.15 * (log_l1 + 0.05) + 0.22 * (log_mad5 + 0.05) + 0.08 * log_hl\n                if asset in {'XAU', 'WTIOIL', 'GOOGLX', 'TSLAX', 'SPCX'}:\n                    alpha_k = np.minimum(s2_bar_k / max(s2_fwd_mean, 0.1), 1.0)\n                    diff_k = log_ewma - log_ewma[5]\n                    log_ewma = np.where(diff_k < 0.0, log_ewma[5] + (0.5 + 0.5 * alpha_k) * diff_k, log_ewma)\n            sigma_short = float(np.exp(np.dot(mod.WEIGHTS_24H_SHORT, log_ewma)))\n            sigma_long_ctx = float(np.exp(np.dot(mod.WEIGHTS_24H_LONG, log_ewma)))\n            sigma_long = float(np.exp(0.90 * np.log(sigma_long_ctx) + 0.10 * np.log(lt_sigma)))\n    else:\n        sigma_short = lt_sigma\n        sigma_long = lt_sigma\n\n    c_scale, sig_path_vv, sig_step_vv = mod._distribution_params(asset, time_length)\n    mid_lead_mins = (np.arange(n_inc, dtype=np.float64) + 0.5) * step_mins\n    rev_tau = mod.REVERSION_TAU_1H if is_1h else mod.REVERSION_TAU_24H\n    decay = np.exp(-mid_lead_mins / rev_tau)\n    sigma_base_t = sigma_long * ((sigma_short / max(sigma_long, 1e-8)) ** decay)\n    per_step_sigma = (c_scale * brk_mult * sigma_base_t) * step_seas_sqrt\n\n    half = num_simulations // 2\n    eps = rng.standard_normal((half, n_inc))\n    eta = rng.standard_normal((half, n_inc))\n    eps = eps * np.exp(sig_step_vv * eta - 0.5 * sig_step_vv * sig_step_vv)\n    q_z = mod._stratified_normal_quantiles(half)\n    m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv * sig_path_vv)[:, None]\n    eps = eps * m_half\n    z = np.vstack([eps, -eps]) if num_simulations % 2 == 0 else np.vstack([eps, -eps, rng.standard_normal((1, n_inc))])\n    col_std = np.std(z, axis=0, keepdims=True)\n    z = z / np.where(col_std > 1e-8, col_std, 1.0)\n    shocks_inc = z * per_step_sigma[None, :]\n\n    if is_1h:\n        if asset != 'ETH':\n            shocks_inc = apply_secant_shocks(shocks_inc, eta_tot=1.0, eta_blk=0.95, n_blks=4)\n    elif asset in mod.CRYPTO_ASSETS:\n        if asset != 'HYPE':\n            shocks_inc = apply_secant_shocks(shocks_inc, eta_tot=0.96, eta_blk=0.96, n_blks=8)\n    else:\n        shocks_inc = apply_secant_shocks(shocks_inc, eta_tot=1.09, eta_blk=1.0, n_blks=8)\n\n    shocks = np.empty((num_simulations, steps), dtype=np.float64)\n    shocks[:, 0] = 0.0\n    shocks[:, 1:] = shocks_inc\n    return last * np.exp(np.cumsum(shocks, axis=1))\n\ndef _cmp_one(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx = args\n    p_cur = np.asarray(mod.simulate(asset, t0_iso, ti, tl, 300, ctx)[2:], dtype=np.float64)\n    p_new = sim_iter8(asset, t0_iso, ti, tl, 300, ctx)\n    c_cur, _ = calculate_total_score_for_miner(p_cur, real, ti, intervals, vol_blocks)\n    c_new, _ = calculate_total_score_for_miner(p_new, real, ti, intervals, vol_blocks)\n    return {'t0': pd.Timestamp(t0_iso), 'cur': c_cur, 'new': c_new, 'diff': c_new - c_cur}\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [CRYPTO_24H, COM_EQU_24H, CRYPTO_1H]:\n        print(f'================ {comp.label} Iter 8 vs Iter 6 Pre-Validation (2026-07-16..2026-09-13) ================', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n            all_p = []\n            p_stride = 24 if comp.time_length <= 3600 else 4\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::p_stride]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)):\n                        all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [\n                (asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, comp.vol_scoring_blocks, rp,\n                 prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)])\n                for t0, rp in all_p\n            ]\n            df = pd.DataFrame(list(ex.map(_cmp_one, tasks)))\n            df = df[df['cur'] > 0]\n            h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n            print(f'  {asset:<7} | All={df[\\\"diff\\\"].mean():+.3f} (H1={df.loc[h1,\\\"diff\\\"].mean():+.3f}, H2={df.loc[h2,\\\"diff\\\"].mean():+.3f})', flush=True)\n\"","description":"Verify combined Iteration 8 candidate against Iteration 6 across all 18 pairs on Pre-Half 1 and Pre-Half 2"}}
