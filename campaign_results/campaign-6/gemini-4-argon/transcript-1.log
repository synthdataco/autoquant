{"type":"tool_use","timestamp":"2026-10-22T04:41:48.260Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_284682","parameters":{"command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nfrom modeling import (\n    _S2_BACK_336, _S2_FWD_336, _index_to_utc_us, _slots_from_utc_us, _subslot_modulation,\n    _event_variance_multiplier, EWMA_LAMBDAS_6, WEIGHTS_24H_SHORT, WEIGHTS_24H_LONG\n)\n\ndef block_ewmas(valid_pos, rets, grid_us, gs2, blk_min=5):\n    start_idx = int(valid_pos[0])\n    n_active = len(grid_us) - start_idx\n    n_blocks = n_active // blk_min\n    trim_start = len(grid_us) - n_blocks * blk_min\n    ret_pos = valid_pos[1:]\n    in_range = ret_pos >= trim_start\n    b_idx = np.clip(((ret_pos[in_range] - trim_start) // blk_min).astype(np.int64), 0, n_blocks - 1)\n    r_blk = np.bincount(b_idx, weights=rets[in_range], minlength=n_blocks)\n    s2_blk = np.maximum(gs2[trim_start:].reshape(n_blocks, blk_min).sum(axis=1), 1e-4)\n    rate_b = (r_blk ** 2) / s2_blk\n    pos_b = rate_b[rate_b > 0]\n    cap_b = float(np.percentile(pos_b, 98.5)) if pos_b.size > 10 else 1.0\n    r2_win_b = np.minimum(rate_b, cap_b) * s2_blk\n    r1_win_b = 1.2533141373155001 * np.minimum(np.abs(r_blk), np.sqrt(cap_b * s2_blk)) * np.sqrt(s2_blk)\n    age_blk_min = (np.arange(n_blocks - 1, -1, -1, dtype=np.float64) + 0.5) * blk_min\n    ew_rms = np.empty(6); ew_mad = np.empty(6)\n    for i, lam in enumerate(EWMA_LAMBDAS_6):\n        w = np.exp(-lam * age_blk_min)\n        den = max(float(np.dot(w, s2_blk)), 1e-6)\n        ew_rms[i] = np.sqrt(max(float(np.dot(w, r2_win_b)) / den, 1e-12))\n        ew_mad[i] = max(float(np.dot(w, r1_win_b)) / den, 1e-6)\n    return np.log(ew_rms), np.log(ew_mad)\n\nfor asset in ['BTC', 'ETH', 'SOL', 'XRP', 'HYPE', 'XAU', 'NVDAX', 'GOOGLX', 'TSLAX', 'AAPLX', 'WTIOIL', 'SPCX', 'SP500']:\n    store = RealizedPathStore(asset, 86400, 300)\n    days = pd.date_range('2026-07-23', '2026-09-12', freq='2D')\n    prompts = []\n    for d in days:\n        entries = store._load_day(d.date())\n        for t0 in sorted(entries)[::4]:\n            rp = np.asarray(entries[t0], dtype=np.float64)\n            if not np.all(np.isnan(rp)):\n                prompts.append((t0, rp))\n    prices = load_minute_prices(Path('market_data'), asset, prompts[0][0] - pd.Timedelta(days=8), prompts[-1][0] + pd.Timedelta(days=2))\n    s2_back = _S2_BACK_336[asset]; s2_fwd = _S2_FWD_336[asset]\n    \n    e_l2, e_l1, e_rms5, e_mad5, e_rms30, e_blend = [], [], [], [], [], []\n    for t0, rp in prompts:\n        ctx = prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        grid_us = _index_to_utc_us(ctx.index)\n        grid_s2 = s2_back[_slots_from_utc_us(grid_us)] * _subslot_modulation(grid_us, asset, False) * _event_variance_multiplier(grid_us, asset)\n        grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n        rate_ds = (rets ** 2) / ds2\n        cap_ds = float(np.percentile(rate_ds[rate_ds > 0], 98.5))\n        r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        s2_grid_active = grid_s2[g_slice]\n        ewma_l2 = np.empty(6); ewma_l1 = np.empty(6)\n        for i, lam in enumerate(EWMA_LAMBDAS_6):\n            w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min)\n            den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n            ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n            ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n        log_l2 = np.log(ewma_l2); log_l1 = np.log(ewma_l1)\n        log_rms5, log_mad5 = block_ewmas(valid_pos, rets, grid_us, grid_s2, 5)\n        log_rms30, log_mad30 = block_ewmas(valid_pos, rets, grid_us, grid_s2, 30)\n        \n        # Forward realized deseasonalized scale\n        start_us = int(round(t0.timestamp() * 1_000_000))\n        fwd_us = start_us + np.arange(1, 1441, dtype=np.int64) * 60_000_000\n        fwd_s2_min = s2_fwd[_slots_from_utc_us(fwd_us)] * _subslot_modulation(fwd_us, asset, False) * _event_variance_multiplier(fwd_us, asset)\n        fwd_s2 = fwd_s2_min.reshape(288, 5).sum(axis=1)\n        r_fwd = np.diff(np.log(rp))\n        sig_fwd = 0.5 * np.sqrt(np.sum(r_fwd**2) / np.sum(fwd_s2)) + 0.5 * (1.253314 * np.sum(np.abs(r_fwd)) / np.sum(np.sqrt(fwd_s2)))\n        if sig_fwd <= 1e-6: continue\n        y = np.log(sig_fwd)\n        \n        w_comb = 0.25 * WEIGHTS_24H_SHORT + 0.75 * WEIGHTS_24H_LONG\n        e_l2.append(y - np.dot(w_comb, log_l2))\n        e_l1.append(y - np.dot(w_comb, log_l1))\n        e_rms5.append(y - np.dot(w_comb, log_rms5))\n        e_mad5.append(y - np.dot(w_comb, log_mad5))\n        e_rms30.append(y - np.dot(w_comb, log_rms30))\n        e_blend.append(y - np.dot(w_comb, 0.35*log_l2 + 0.25*log_rms5 + 0.25*log_mad5 + 0.15*log_rms30))\n    print(f'{asset:<7} | demeaned_RMSE: l2={np.std(e_l2):.4f} | l1={np.std(e_l1):.4f} | rms5={np.std(e_rms5):.4f} | mad5={np.std(e_mad5):.4f} | rms30={np.std(e_rms30):.4f} | blend={np.std(e_blend):.4f}')\n\"","description":"Compare demeaned log-volatility RMSE of 1m L2, 1m L1, 5m RMS, 5m MAD, 30m RMS, and multi-horizon blend across all 13 assets"}}
