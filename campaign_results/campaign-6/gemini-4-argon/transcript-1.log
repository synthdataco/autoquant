{"type":"tool_use","timestamp":"2026-10-22T07:50:49.690Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_469566","parameters":{"description":"Test slower 24h/7d EWMA weights and 5m/30m block RMS estimators across Pre-Half 1 and Pre-Half 2 for COM_EQU_24H and CRYPTO_24H","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\ndef _compute_blk_ewmas(valid_pos, rets, grid_us, gs2, blk_min):\n    start_idx = int(valid_pos[0])\n    n_active = len(grid_us) - start_idx\n    n_blocks = n_active // blk_min\n    trim_start = len(grid_us) - n_blocks * blk_min\n    ret_pos = valid_pos[1:]\n    in_range = ret_pos >= trim_start\n    b_idx = np.clip(((ret_pos[in_range] - trim_start) // blk_min).astype(np.int64), 0, n_blocks - 1)\n    r_blk = np.bincount(b_idx, weights=rets[in_range], minlength=n_blocks)\n    s2_blk = np.maximum(gs2[trim_start:].reshape(n_blocks, blk_min).sum(axis=1), 1e-4)\n    rate_b = (r_blk ** 2) / s2_blk\n    pos_b = rate_b[rate_b > 0]\n    cap_b = float(np.percentile(pos_b, 98.5)) if pos_b.size > 10 else 1.0\n    r2_win_b = np.minimum(rate_b, cap_b) * s2_blk\n    r1_win_b = 1.2533141373155001 * np.minimum(np.abs(r_blk), np.sqrt(cap_b * s2_blk)) * np.sqrt(s2_blk)\n    age_blk_min = (np.arange(n_blocks - 1, -1, -1, dtype=np.float64) + 0.5) * blk_min\n    ew_rms = np.empty(6); ew_mad = np.empty(6)\n    for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n        w = np.exp(-lam * age_blk_min)\n        den = max(float(np.dot(w, s2_blk)), 1e-6)\n        ew_rms[i] = np.sqrt(max(float(np.dot(w, r2_win_b)) / den, 1e-12))\n        ew_mad[i] = max(float(np.dot(w, r1_win_b)) / den, 1e-6)\n    return np.log(np.maximum(ew_rms, 1e-6)), np.log(np.maximum(ew_mad, 1e-6))\n\ndef _eval_equ(args):\n    asset, t0_iso, ti, tl, intervals, real, ctx = args\n    out = mod.simulate(asset, t0_iso, ti, tl, 250, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]; log_p = np.log(paths / p0)\n    c0, _ = calculate_total_score_for_miner(paths, real, ti, intervals, {})\n    if c0 < 0: return None\n    du = 0.08\n    cp, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(du)*log_p), real, ti, intervals, {})\n    cm, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(-du)*log_p), real, ti, intervals, {})\n    g = (cp - cm) / (2.0 * du)\n    h = max((cp - 2.0 * c0 + cm) / (du * du), 1.0)\n    \n    vals = ctx['close'].to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    grid_us = mod._index_to_utc_us(ctx.index)\n    s2_back = mod._S2_BACK_336[asset]\n    grid_s2 = s2_back[mod._slots_from_utc_us(grid_us)] * mod._subslot_modulation(grid_us, asset, False) * mod._event_variance_multiplier(grid_us, asset)\n    grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n    rets = np.diff(np.log(vals[valid_pos]))\n    ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n    rate_ds = (rets ** 2) / ds2\n    pos_rates = rate_ds[rate_ds > 0]\n    cap_ds = float(np.percentile(pos_rates, 98.5)) if pos_rates.size > 10 else 1.0\n    r2_win = np.minimum(rate_ds, cap_ds) * ds2\n    r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n    t_end_us = int(grid_us[-1])\n    valid_us = grid_us[valid_pos]\n    age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n    g_slice = slice(int(valid_pos[0]), len(grid_us))\n    age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n    s2_grid_active = grid_s2[g_slice]\n    ewma_l2 = np.empty(6); ewma_l1 = np.empty(6)\n    for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n        w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min)\n        den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n        ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n        ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n    log_l2 = np.log(ewma_l2); log_l1 = np.log(ewma_l1)\n    log_rms5, log_mad5 = _compute_blk_ewmas(valid_pos, rets, grid_us, grid_s2, 5)\n    log_rms30, log_mad30 = _compute_blk_ewmas(valid_pos, rets, grid_us, grid_s2, 30)\n    log_hl = mod._compute_ohlc_log_ewma(ctx, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n    if log_hl is None: log_hl = log_l2\n    \n    if asset in mod.CRYPTO_ASSETS:\n        le_cur = 0.80 * log_l2 + 0.20 * (log_l1 + 0.20)\n    else:\n        le_cur = 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n    w_cur = 0.245 * mod.WEIGHTS_24H_SHORT + 0.755 * mod.WEIGHTS_24H_LONG\n    base_u = float(np.dot(w_cur, le_cur))\n    \n    # Test 1: Slowing down weights for COM_EQU_24H (more weight on 24h & 7d, less on 15m/1h/4h) + Jensen correction\n    w_slow_s = np.array([0.00, 0.10, 0.20, 0.25, 0.25, 0.20])\n    w_slow_l = np.array([0.00, 0.00, 0.00, 0.10, 0.45, 0.45])\n    w_slow = 0.245 * w_slow_s + 0.755 * w_slow_l\n    du_slow = float(np.dot(w_slow, le_cur)) - base_u\n    \n    # Test 2: Including log_rms5 and log_rms30\n    le_5_30 = 0.35 * log_l2 + 0.25 * log_rms5 + 0.20 * (log_mad5 + 0.05) + 0.10 * (log_l1 + 0.05) + 0.10 * log_rms30\n    du_5_30 = float(np.dot(w_cur, le_5_30)) - base_u\n    \n    # Test 3: Both slow weights + le_5_30\n    du_both = float(np.dot(w_slow, le_5_30)) - base_u\n    \n    return {'t0': pd.Timestamp(t0_iso), 'g': g, 'h': h, 'du_slow': du_slow, 'du_5_30': du_5_30, 'du_both': du_both}\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [COM_EQU_24H, CRYPTO_24H]:\n        print(f'================ {comp.label} ================', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n            all_p = []\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::4]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)):\n                        all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [\n                (asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, rp,\n                 prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)])\n                for t0, rp in all_p\n            ]\n            df = pd.DataFrame([r for r in ex.map(_eval_equ, tasks) if r is not None])\n            h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n            parts = []\n            for k in ['du_slow', 'du_5_30', 'du_both']:\n                da = (df['g']*df[k] + 0.5*df['h']*(df[k]**2)).mean()\n                d1 = (df.loc[h1,'g']*df.loc[h1,k] + 0.5*df.loc[h1,'h']*(df.loc[h1,k]**2)).mean()\n                d2 = (df.loc[h2,'g']*df.loc[h2,k] + 0.5*df.loc[h2,'h']*(df.loc[h2,k]**2)).mean()\n                parts.append(f'{k[3:]}:{da:+.2f}({d1:+.2f}/{d2:+.2f})')\n            print(f'  {asset:<7} | ' + ' | '.join(parts), flush=True)\n\""}}
