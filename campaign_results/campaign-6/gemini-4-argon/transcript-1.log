{"type":"tool_use","timestamp":"2026-10-22T07:04:17.777Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_388378","parameters":{"description":"Test 4 structural candidates (pw0, ds2 denominator, breakout feature, robust EWMA blend) across H1 and H2 for all 18 pairs","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\n# Let's test specific clean changes on Pre-Half 1 and Pre-Half 2 across all 18 asset-competition pairs!\ndef _eval_ablation(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx = args\n    out = mod.simulate(asset, t0_iso, ti, tl, 250, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]; log_p = np.log(paths / p0)\n    c0, _ = calculate_total_score_for_miner(paths, real, ti, intervals, vol_blocks)\n    if c0 < 0: return None\n    du = 0.08\n    cp, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(du)*log_p), real, ti, intervals, vol_blocks)\n    cm, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(-du)*log_p), real, ti, intervals, vol_blocks)\n    g = (cp - cm) / (2.0 * du)\n    h = max((cp - 2.0 * c0 + cm) / (du * du), 1.0)\n    \n    is_1h = tl <= 3600\n    vals = ctx['close'].to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    grid_us = mod._index_to_utc_us(ctx.index)\n    s2_back = mod._S2_BACK_336[asset]\n    s2_fwd = s2_back if is_1h else mod._S2_FWD_336.get(asset, s2_back)\n    grid_s2 = s2_back[mod._slots_from_utc_us(grid_us)] * mod._subslot_modulation(grid_us, asset, is_1h) * mod._event_variance_multiplier(grid_us, asset)\n    grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n    rets = np.diff(np.log(vals[valid_pos]))\n    ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n    rate_ds = (rets ** 2) / ds2\n    pos_rates = rate_ds[rate_ds > 0]\n    cap_ds = float(np.percentile(pos_rates, 98.5)) if pos_rates.size > 10 else 1.0\n    r2_win = np.minimum(rate_ds, cap_ds) * ds2\n    r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n    t_end_us = int(grid_us[-1])\n    valid_us = grid_us[valid_pos]\n    age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n    g_slice = slice(int(valid_pos[0]), len(grid_us))\n    age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n    s2_grid_active = grid_s2[g_slice]\n    ewma_l2 = np.empty(6); ewma_l1 = np.empty(6); ewma_ds2 = np.empty(6)\n    for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n        w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min)\n        den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n        den_ds2 = max(float(np.dot(w_bar, ds2)), 1e-6)\n        ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n        ewma_ds2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den_ds2, 1e-12))\n        ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n    log_l2 = np.log(ewma_l2); log_ds2 = np.log(ewma_ds2); log_l1 = np.log(ewma_l1)\n    log_mad5 = mod._compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n    log_hl = mod._compute_ohlc_log_ewma(ctx, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n    if log_hl is None: log_hl = log_l2\n    \n    # Current log_ewma\n    if is_1h:\n        le_cur = 0.45 * log_l2 + 0.20 * log_l1 + 0.20 * log_mad5 + 0.15 * log_hl\n        sig_s_cur = float(np.exp(np.dot(mod.WEIGHTS_1H_START, le_cur)))\n        sig_l_cur = float(np.exp(np.dot(mod.WEIGHTS_1H_END, le_cur)))\n    else:\n        if asset in mod.CRYPTO_ASSETS:\n            le_cur = 0.80 * log_l2 + 0.20 * (log_l1 + 0.20)\n        else:\n            le_cur = 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n        sig_s_cur = float(np.exp(np.dot(mod.WEIGHTS_24H_SHORT, le_cur)))\n        sig_l_ctx = float(np.exp(np.dot(mod.WEIGHTS_24H_LONG, le_cur)))\n        sig_l_cur = float(np.exp(0.90 * np.log(sig_l_ctx) + 0.10 * np.log(mod.LONG_TERM_SIGMA_1M[asset])))\n    \n    # Candidate 1: pw=0.0 (no stale lt_sigma pull when context is full)\n    du_pw0 = 0.0 if is_1h else 0.75 * (np.log(sig_l_ctx) - np.log(sig_l_cur))\n    \n    # Candidate 2: using den_ds2 instead of den_grid (eliminates trailing NaN downward bias)\n    du_ds2 = float(np.dot(0.5*mod.WEIGHTS_1H_START + 0.5*mod.WEIGHTS_1H_END if is_1h else 0.25*mod.WEIGHTS_24H_SHORT + 0.75*mod.WEIGHTS_24H_LONG, log_ds2 - log_l2))\n    \n    # Candidate 3: 24h directional breakout (excess |ret_24h| above 1.0 std)\n    idx_24h = np.searchsorted(valid_pos, max(0, len(vals) - 1440))\n    ret_24h = float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_24h]])) / max(np.sqrt(np.sum(grid_s2[-1440:])) * ewma_l2[4], 1e-6)\n    idx_4h = np.searchsorted(valid_pos, max(0, len(vals) - 240))\n    ret_4h = float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_4h]])) / max(np.sqrt(np.sum(grid_s2[-240:])) * ewma_l2[3], 1e-6)\n    du_brk = 0.04 * (np.clip(abs(ret_24h) - 0.8, -0.5, 2.5) + 0.5 * np.clip(abs(ret_4h) - 0.8, -0.5, 2.5))\n    \n    # Candidate 4: higher weight on log_mad5 + log_l1 + log_hl in 24h\n    le_rob = 0.50 * log_l2 + 0.20 * (log_l1 + 0.06) + 0.20 * (log_mad5 + 0.06) + 0.10 * log_hl\n    du_rob = 0.0 if is_1h else float(np.dot(0.25*mod.WEIGHTS_24H_SHORT + 0.75*mod.WEIGHTS_24H_LONG, le_rob - le_cur))\n    \n    return {\n        't0': pd.Timestamp(t0_iso), 'c0': c0, 'g': g, 'h': h,\n        'du_pw0': du_pw0, 'du_ds2': du_ds2, 'du_brk': du_brk, 'du_rob': du_rob\n    }\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [CRYPTO_24H, COM_EQU_24H, CRYPTO_1H]:\n        print(f'================ {comp.label} ================', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n            all_p = []\n            p_stride = 24 if comp.time_length <= 3600 else 4\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::p_stride]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)):\n                        all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [\n                (asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, comp.vol_scoring_blocks, rp,\n                 prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)])\n                for t0, rp in all_p\n            ]\n            df = pd.DataFrame([r for r in ex.map(_eval_ablation, tasks) if r is not None])\n            h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n            parts = []\n            for k in ['du_pw0', 'du_ds2', 'du_brk', 'du_rob']:\n                d_all = (df['g']*df[k] + 0.5*df['h']*(df[k]**2)).mean()\n                d_1 = (df.loc[h1,'g']*df.loc[h1,k] + 0.5*df.loc[h1,'h']*(df.loc[h1,k]**2)).mean()\n                d_2 = (df.loc[h2,'g']*df.loc[h2,k] + 0.5*df.loc[h2,'h']*(df.loc[h2,k]**2)).mean()\n                if abs(d_all) > 0.01:\n                    parts.append(f'{k[3:]}:{d_all:+.2f}({d_1:+.2f}/{d_2:+.2f})')\n            print(f'  {asset:<7} | ' + ' | '.join(parts), flush=True)\n\""}}
