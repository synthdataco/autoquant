{"type":"tool_use","timestamp":"2026-10-22T08:34:03.033Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_18603","parameters":{"description":"Compare total-horizon secant vs block+total secant projection across Pre-Half 1 and Pre-Half 2 for all 18 pairs","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\ndef apply_secant(dlog, eta_tot, eta_blk=1.0, n_blks=8):\n    out = dlog.copy()\n    if eta_blk != 1.0:\n        b_len = out.shape[1] // n_blks\n        for b in range(n_blks):\n            sl = slice(b * b_len, (b + 1) * b_len)\n            sub = out[:, sl]\n            s2 = np.var(sub, axis=0)\n            w = s2 / max(np.sum(s2), 1e-12)\n            b_sum = np.sum(sub, axis=1, keepdims=True)\n            out[:, sl] = sub + (eta_blk - 1.0) * b_sum * w[None, :]\n    if eta_tot != 1.0:\n        s2 = np.var(out, axis=0)\n        w = s2 / max(np.sum(s2), 1e-12)\n        t_sum = np.sum(out, axis=1, keepdims=True)\n        out = out + (eta_tot - 1.0) * t_sum * w[None, :]\n    return out\n\ndef _test_sec(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx = args\n    out = mod.simulate(asset, t0_iso, ti, tl, 250, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]\n    dlog = np.diff(np.log(paths / p0), axis=1)\n    c_base, _ = calculate_total_score_for_miner(paths, real, ti, intervals, vol_blocks)\n    if c_base < 0: return None\n    is_1h = tl <= 3600\n    res = {'t0': pd.Timestamp(t0_iso)}\n    if is_1h:\n        cfgs = [('tot93', 0.93, 1.0, 4), ('blk95_tot96', 0.96, 0.95, 4), ('blk93', 1.0, 0.93, 4)]\n    elif asset in mod.CRYPTO_ASSETS:\n        cfgs = [('tot92', 0.92, 1.0, 8), ('blk95_tot95', 0.95, 0.95, 8), ('blk93', 1.0, 0.93, 8)]\n    else:\n        cfgs = [('tot109', 1.09, 1.0, 8), ('blk104_tot106', 1.06, 1.04, 8), ('blk107', 1.0, 1.07, 8)]\n    for name, et, eb, nb in cfgs:\n        dl = apply_secant(dlog, et, eb, nb)\n        p_new = p0 * np.exp(np.hstack([np.zeros((paths.shape[0], 1)), np.cumsum(dl, axis=1)]))\n        sc, _ = calculate_total_score_for_miner(p_new, real, ti, intervals, vol_blocks)\n        res[name] = sc - c_base\n    return res\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [COM_EQU_24H, CRYPTO_24H, CRYPTO_1H]:\n        print(f'================ {comp.label} ================', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n            all_p = []\n            p_stride = 24 if comp.time_length <= 3600 else 4\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::p_stride]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)):\n                        all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [\n                (asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, comp.vol_scoring_blocks, rp,\n                 prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)])\n                for t0, rp in all_p\n            ]\n            df = pd.DataFrame([r for r in ex.map(_test_sec, tasks) if r is not None])\n            h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n            cols = [c for c in df.columns if c != 't0']\n            s_out = ' | '.join(f'{c}:{df[c].mean():+.2f}({df.loc[h1,c].mean():+.2f}/{df.loc[h2,c].mean():+.2f})' for c in cols)\n            print(f'  {asset:<7} | {s_out}', flush=True)\n\""}}
