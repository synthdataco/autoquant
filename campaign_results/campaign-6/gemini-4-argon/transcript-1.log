{"type":"tool_use","timestamp":"2026-10-22T02:40:40.162Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_225871","parameters":{"command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom datetime import datetime, timezone\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.backtester.loading import get_miner_scores\nimport sys\nsys.path.insert(0, 'agent')\nfrom modeling import simulate\n\ndef analyze_comp(comp, asset, eval_start_str, eval_end_str, step_stride=4):\n    start_dt = datetime.fromisoformat(eval_start_str).replace(tzinfo=timezone.utc)\n    end_dt = datetime.fromisoformat(eval_end_str).replace(tzinfo=timezone.utc)\n    scores = get_miner_scores(start_dt, end_dt, asset, comp.time_length, comp.time_increment)\n    times = sorted(pd.to_datetime(scores['start_time'], utc=True).unique())[::step_stride]\n    prices = load_minute_prices('market_data', asset, times[0] - pd.Timedelta(days=8), end_dt + pd.Timedelta(days=1))\n    \n    int_totals = {}\n    scale_sweeps = {s: {} for s in [0.75, 0.80, 0.85, 0.90, 0.95, 1.0, 1.05, 1.10, 1.15]}\n    n_valid = 0\n    for t in times:\n        ctx = prices.loc[t - pd.Timedelta(days=7) : context_end(t, comp.time_length)]\n        out = simulate(asset, t.isoformat(), comp.time_increment, comp.time_length, 500, ctx)\n        paths = np.asarray(out[2:], dtype=np.float64)\n        step_td = pd.Timedelta(seconds=comp.time_increment)\n        n_steps = comp.time_length // comp.time_increment + 1\n        idx = pd.date_range(t, periods=n_steps, freq=step_td)\n        real = prices['close'].reindex(idx).to_numpy(dtype=np.float64)\n        if np.all(np.isnan(real)):\n            continue\n        score, details = calculate_total_score_for_miner(paths, real, comp.time_increment, comp.scoring_intervals, comp.vol_scoring_blocks)\n        if score < 0:\n            continue\n        n_valid += 1\n        for d in details:\n            k = d['Interval']\n            int_totals[k] = int_totals.get(k, 0.0) + d['CRPS'] * d.get('Weight', 1.0)\n        p0 = paths[:, :1]\n        log_p = np.log(paths / p0)\n        for s in scale_sweeps:\n            spaths = p0 * np.exp(s * log_p)\n            _, sdetails = calculate_total_score_for_miner(spaths, real, comp.time_increment, comp.scoring_intervals, comp.vol_scoring_blocks)\n            for d in sdetails:\n                k = d['Interval']\n                scale_sweeps[s][k] = scale_sweeps[s].get(k, 0.0) + d['CRPS'] * d.get('Weight', 1.0)\n    print(f'=== {comp.label} | {asset} ({n_valid} prompts, {eval_start_str}..{eval_end_str}) ===')\n    for k, v in int_totals.items():\n        best_s = min(scale_sweeps, key=lambda s: scale_sweeps[s][k])\n        best_v = scale_sweeps[best_s][k] / n_valid\n        print(f'  {k:<14}: {v/n_valid:8.3f} | best_scale={best_s:.2f} -> {best_v:8.3f} (diff={best_v - v/n_valid:+.3f})')\n\nanalyze_comp(CRYPTO_1H, 'BTC', '2026-09-09', '2026-09-15', step_stride=6)\nanalyze_comp(CRYPTO_1H, 'SOL', '2026-09-09', '2026-09-15', step_stride=6)\nanalyze_comp(CRYPTO_24H, 'BTC', '2026-09-09', '2026-09-15', step_stride=1)\nanalyze_comp(COM_EQU_24H, 'NVDAX', '2026-09-09', '2026-09-15', step_stride=1)\nanalyze_comp(COM_EQU_24H, 'AAPLX', '2026-09-09', '2026-09-15', step_stride=1)\nanalyze_comp(COM_EQU_24H, 'SPCX', '2026-09-09', '2026-09-15', step_stride=1)\n\"","description":"Decompose CRPS by interval on 2026-09-09..2026-09-15 across competitions"}}
