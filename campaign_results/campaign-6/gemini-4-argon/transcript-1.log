{"type":"tool_use","timestamp":"2026-10-22T03:09:57.917Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_317749","parameters":{"command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nfrom modeling import (\n    _S2_BACK_336, _S2_FWD_336, _index_to_utc_us, _slots_from_utc_us, _subslot_modulation,\n    _event_variance_multiplier, EWMA_LAMBDAS_6, _compute_5m_mad_ewma, _compute_ohlc_log_ewma,\n    WEIGHTS_24H_SHORT, WEIGHTS_24H_LONG, LONG_TERM_SIGMA_1M\n)\n\nfor asset in ['BTC', 'SOL', 'XRP', 'NVDAX', 'AAPLX', 'SPCX', 'WTIOIL', 'SP500']:\n    store = RealizedPathStore(asset, 86400, 300)\n    days = pd.date_range('2026-07-24', '2026-09-12', freq='2D')\n    prompts = []\n    for d in days:\n        entries = store._load_day(d.date())\n        for t0 in sorted(entries)[::4]:\n            rp = np.asarray(entries[t0], dtype=np.float64)\n            if not np.all(np.isnan(rp)):\n                prompts.append((t0, rp))\n    prices = load_minute_prices(Path('market_data'), asset, prompts[0][0] - pd.Timedelta(days=8), prompts[-1][0] + pd.Timedelta(days=2))\n    s2_back = _S2_BACK_336[asset]\n    s2_fwd = _S2_FWD_336[asset]\n    \n    X_rows = []\n    y_vals = []\n    pred_cur = []\n    for t0, rp in prompts:\n        ctx = prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64)\n        valid_pos = np.flatnonzero(np.isfinite(vals))\n        grid_us = _index_to_utc_us(ctx.index)\n        grid_slots = _slots_from_utc_us(grid_us)\n        grid_s2 = s2_back[grid_slots] * _subslot_modulation(grid_us, asset, False) * _event_variance_multiplier(grid_us, asset)\n        grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n        rate_ds = (rets ** 2) / ds2\n        cap_ds = float(np.percentile(rate_ds[rate_ds > 0], 98.5))\n        r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n        t_end_us = int(grid_us[-1])\n        valid_us = grid_us[valid_pos]\n        age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n        g_slice = slice(int(valid_pos[0]), len(grid_us))\n        age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n        s2_grid_active = grid_s2[g_slice]\n        ewma_l2 = np.empty(6)\n        ewma_l1 = np.empty(6)\n        for i, lam in enumerate(EWMA_LAMBDAS_6):\n            w_bar = np.exp(-lam * age_bar_min)\n            w_grid = np.exp(-lam * age_grid_min)\n            den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n            ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n            ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n        log_l2 = np.log(ewma_l2)\n        log_l1 = np.log(ewma_l1)\n        log_mad5 = _compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n        \n        # Forward realized deseasonalized 5m MAD and RMS\n        start_us = int(round(t0.timestamp() * 1_000_000))\n        fwd_us = start_us + np.arange(1, 1441, dtype=np.int64) * 60_000_000\n        fwd_s2_min = s2_fwd[_slots_from_utc_us(fwd_us)] * _subslot_modulation(fwd_us, asset, False) * _event_variance_multiplier(fwd_us, asset)\n        fwd_s2 = fwd_s2_min.reshape(288, 5).sum(axis=1)\n        r_fwd = np.diff(np.log(rp))\n        # Deseasonalized forward scale (blend of MAD and RMS, which tracks CRPS-optimal scale)\n        sig_fwd_rms = np.sqrt(np.sum(r_fwd**2) / np.sum(fwd_s2))\n        sig_fwd_mad = 1.253314 * np.sum(np.abs(r_fwd)) / np.sum(np.sqrt(fwd_s2))\n        sig_fwd_opt = 0.5 * sig_fwd_rms + 0.5 * sig_fwd_mad\n        if sig_fwd_opt <= 1e-6: continue\n        \n        if asset in {'BTC', 'SOL', 'XRP'}:\n            log_ewma = 0.80 * log_l2 + 0.20 * (log_l1 + 0.20)\n        else:\n            log_ewma = 0.82 * log_l2 + 0.18 * (log_mad5 + 0.05)\n        sig_s = np.exp(np.dot(WEIGHTS_24H_SHORT, log_ewma))\n        sig_l = np.exp(0.9 * np.dot(WEIGHTS_24H_LONG, log_ewma) + 0.1 * np.log(LONG_TERM_SIGMA_1M[asset]))\n        sig_pred = 0.25 * sig_s + 0.75 * sig_l\n        \n        X_rows.append(np.concatenate([log_l2, log_l1, log_mad5]))\n        y_vals.append(np.log(sig_fwd_opt))\n        pred_cur.append(np.log(sig_pred))\n    y_vals = np.array(y_vals)\n    pred_cur = np.array(pred_cur)\n    # Regress y_vals on pred_cur: y = a + b * pred_cur\n    b, a = np.polyfit(pred_cur, y_vals, 1)\n    corr = np.corrcoef(pred_cur, y_vals)[0, 1]\n    print(f'{asset:<7} | slope(y vs pred_cur)={b:.3f} | corr={corr:.3f} | std(pred)={np.std(pred_cur):.3f} vs std(y)={np.std(y_vals):.3f}')\n\"","description":"Check calibration slope and correlation of predicted log-volatility vs realized optimal log-volatility on pre-validation data"}}
