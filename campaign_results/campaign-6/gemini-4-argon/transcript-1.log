{"type":"tool_use","timestamp":"2026-10-22T03:27:26.343Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_489213","parameters":{"command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nfrom modeling import (\n    simulate, _S2_BACK_336, _index_to_utc_us, _slots_from_utc_us, _subslot_modulation,\n    _event_variance_multiplier, EWMA_LAMBDAS_6, _compute_5m_mad_ewma, _compute_ohlc_log_ewma,\n    LONG_TERM_SIGMA_1M, WEIGHTS_24H_SHORT, WEIGHTS_24H_LONG, WEIGHTS_1H_START, WEIGHTS_1H_END\n)\n\ndef _grad_hess_prompt(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx = args\n    out = simulate(asset, t0_iso, ti, tl, 250, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]\n    log_p = np.log(paths / p0)\n    \n    du = 0.08\n    c0, det0 = calculate_total_score_for_miner(paths, real, ti, intervals, vol_blocks)\n    if c0 < 0:\n        return None\n    cp, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(du) * log_p), real, ti, intervals, vol_blocks)\n    cm, _ = calculate_total_score_for_miner(p0 * np.exp(np.exp(-du) * log_p), real, ti, intervals, vol_blocks)\n    g = (cp - cm) / (2.0 * du)\n    h = max((cp - 2.0 * c0 + cm) / (du * du), 1.0)\n    \n    # Context features\n    vals = ctx['close'].to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(vals))\n    grid_us = _index_to_utc_us(ctx.index)\n    is_1h = tl <= 3600\n    s2_back = _S2_BACK_336[asset]\n    grid_s2 = s2_back[_slots_from_utc_us(grid_us)] * _subslot_modulation(grid_us, asset, is_1h) * _event_variance_multiplier(grid_us, asset)\n    grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n    rets = np.diff(np.log(vals[valid_pos]))\n    ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n    rate_ds = (rets ** 2) / ds2\n    pos_rates = rate_ds[rate_ds > 0]\n    cap_ds = float(np.percentile(pos_rates, 98.5)) if pos_rates.size > 10 else 1.0\n    r2_win = np.minimum(rate_ds, cap_ds) * ds2\n    r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n    t_end_us = int(grid_us[-1])\n    valid_us = grid_us[valid_pos]\n    age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n    g_slice = slice(int(valid_pos[0]), len(grid_us))\n    age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0)\n    s2_grid_active = grid_s2[g_slice]\n    ewma_l2 = np.empty(6)\n    ewma_l1 = np.empty(6)\n    for i, lam in enumerate(EWMA_LAMBDAS_6):\n        w_bar = np.exp(-lam * age_bar_min)\n        w_grid = np.exp(-lam * age_grid_min)\n        den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n        ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n        ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n    log_l2 = np.log(ewma_l2)\n    log_l1 = np.log(ewma_l1)\n    log_mad5 = _compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n    log_hl = _compute_ohlc_log_ewma(ctx, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n    \n    lt_log = np.log(LONG_TERM_SIGMA_1M[asset])\n    nan_24h = float(np.mean(~np.isfinite(vals[-1440:])))\n    nan_7d = float(np.mean(~np.isfinite(vals)))\n    idx_24h = np.searchsorted(valid_pos, max(0, len(vals) - 1440))\n    ret_24h = float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_24h]])) / max(np.sqrt(np.sum(grid_s2[-1440:])) * ewma_l2[5], 1e-6)\n    idx_1h = np.searchsorted(valid_pos, max(0, len(vals) - 60))\n    ret_1h = float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_1h]])) / max(np.sqrt(np.sum(grid_s2[-60:])) * ewma_l2[2], 1e-6)\n    \n    return {\n        't0': pd.Timestamp(t0_iso), 'c0': c0, 'g': g, 'h': h,\n        'lvl_7d': log_l2[5] - lt_log,\n        'slope_24h_7d': log_l2[4] - log_l2[5],\n        'slope_4h_24h': log_l2[3] - log_l2[4],\n        'slope_1h_4h': log_l2[2] - log_l2[3],\n        'slope_15m_1h': log_l2[1] - log_l2[2],\n        'l1_vs_l2': log_l1[4] - log_l2[4],\n        'mad5_vs_l2': log_mad5[4] - log_l2[4],\n        'hl_vs_l2': (log_hl[2] - log_l2[2]) if log_hl is not None else 0.0,\n        'nan_diff': nan_24h - nan_7d,\n        'ret_24h': ret_24h,\n        'abs_ret_24h': abs(ret_24h) - 0.8,\n        'ret_1h': ret_1h,\n        'abs_ret_1h': abs(ret_1h) - 0.8,\n    }\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [CRYPTO_24H, COM_EQU_24H, CRYPTO_1H]:\n        print(f'================ {comp.label} ================', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='1D')\n            all_p = []\n            p_stride = 36 if comp.time_length <= 3600 else 6\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::p_stride]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)):\n                        all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [\n                (asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, comp.vol_scoring_blocks, rp,\n                 prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)])\n                for t0, rp in all_p\n            ]\n            df = pd.DataFrame([r for r in ex.map(_grad_hess_prompt, tasks) if r is not None])\n            h1 = df[df['t0'] < '2026-08-15']\n            h2 = df[df['t0'] >= '2026-08-15']\n            # Newton step du* = - sum(g) / sum(h)\n            u_all = -df['g'].sum() / df['h'].sum()\n            u_h1 = -h1['g'].sum() / h1['h'].sum() if len(h1) else 0.0\n            u_h2 = -h2['g'].sum() / h2['h'].sum() if len(h2) else 0.0\n            gain_u = 0.5 * (df['g'].sum()**2) / df['h'].sum() / len(df)\n            \n            # Feature Newton slopes theta_f = - sum(g * f) / sum(h * f^2)\n            feats = ['lvl_7d', 'slope_24h_7d', 'slope_4h_24h', 'slope_1h_4h', 'mad5_vs_l2', 'l1_vs_l2', 'ret_24h', 'abs_ret_24h']\n            f_strs = []\n            for f in feats:\n                x1 = h1[f] - df[f].mean()\n                x2 = h2[f] - df[f].mean()\n                x = df[f] - df[f].mean()\n                th1 = -np.sum(h1['g'] * x1) / max(np.sum(h1['h'] * (x1**2)), 1.0)\n                th2 = -np.sum(h2['g'] * x2) / max(np.sum(h2['h'] * (x2**2)), 1.0)\n                th = -np.sum(df['g'] * x) / max(np.sum(df['h'] * (x**2)), 1.0)\n                gain = 0.5 * (np.sum(df['g'] * x)**2) / max(np.sum(df['h'] * (x**2)), 1.0) / len(df)\n                if gain > 0.3 and th1 * th2 > 0:\n                    f_strs.append(f'{f}:{th:+.2f}({th1:+.2f}/{th2:+.2f},-{gain:.1f})')\n            print(f'  {asset:<7} (n={len(df):3d}) | du*={u_all:+.3f} (H1:{u_h1:+.3f}, H2:{u_h2:+.3f}, -{gain_u:.2f} CRPS) | ' + ', '.join(f_strs), flush=True)\n\"","description":"Compute exact CRPS gradient and Hessian on Pre-Half 1 (07-16..08-14) and Pre-Half 2 (08-15..09-13) across all 18 pairs"}}
