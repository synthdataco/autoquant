{"type":"tool_use","timestamp":"2026-10-22T10:08:13.974Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_776456","parameters":{"command":"uv run python -c \"\nimport numpy as np, pandas as pd\nfrom pathlib import Path\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys; sys.path.insert(0, 'agent'); import modeling as mod\n\ndef compute_tr5_ewma(ctx, grid_s2, anchor_log_sigma):\n    if not isinstance(ctx, pd.DataFrame) or 'high' not in ctx.columns or 'low' not in ctx.columns:\n        return None, None\n    c = ctx['close'].to_numpy(dtype=np.float64)\n    h = ctx['high'].to_numpy(dtype=np.float64)\n    l = ctx['low'].to_numpy(dtype=np.float64)\n    valid_pos = np.flatnonzero(np.isfinite(c))\n    if valid_pos.size < 20: return None, None\n    start_idx = int(valid_pos[0])\n    n_active = len(c) - start_idx\n    n_blocks = n_active // 5\n    if n_blocks < 10: return None, None\n    trim_start = len(c) - n_blocks * 5\n    # Forward-fill close so every minute has the last traded price C_{t-1}\n    c_ff = pd.Series(c).ffill().bfill().to_numpy(dtype=np.float64)\n    c_prev_blk = c_ff[trim_start - 1 : len(c) - 1 : 5] if trim_start > 0 else np.concatenate(([c_ff[0]], c_ff[4:len(c)-1:5]))\n    h_blk = h[trim_start:].reshape(n_blocks, 5)\n    l_blk = l[trim_start:].reshape(n_blocks, 5)\n    c_blk = c_ff[trim_start:].reshape(n_blocks, 5)\n    # Replace NaN high/low with forward-filled close\n    h_blk = np.where(np.isfinite(h_blk) & (h_blk > 0), h_blk, c_blk)\n    l_blk = np.where(np.isfinite(l_blk) & (l_blk > 0), l_blk, c_blk)\n    H5 = np.maximum(c_prev_blk, np.max(h_blk, axis=1))\n    L5 = np.minimum(c_prev_blk, np.min(l_blk, axis=1))\n    L5 = np.maximum(L5, 1e-8)\n    H5 = np.maximum(H5, L5)\n    rng5 = np.log(H5 / L5)\n    \n    s2_blk = np.maximum(grid_s2[trim_start:].reshape(n_blocks, 5).sum(axis=1), 1e-4)\n    r2_tr = (rng5 ** 2) / 2.772588722239781\n    rate_tr = r2_tr / s2_blk\n    pos_tr = rate_tr[rate_tr > 0]\n    cap_tr = float(np.percentile(pos_tr, 98.5)) if pos_tr.size > 10 else 1.0\n    r2_tr_win = np.minimum(rate_tr, cap_tr) * s2_blk\n    r1_tr_win = 0.6266570686577501 * np.minimum(rng5, np.sqrt(cap_tr * 2.772588722239781 * s2_blk)) * np.sqrt(s2_blk)\n    \n    age_blk_min = (np.arange(n_blocks - 1, -1, -1, dtype=np.float64) + 0.5) * 5.0\n    ew_tr_l2 = np.empty(6); ew_tr_l1 = np.empty(6)\n    for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n        w = np.exp(-lam * age_blk_min)\n        den = max(float(np.dot(w, s2_blk)), 1e-6)\n        ew_tr_l2[i] = np.sqrt(max(float(np.dot(w, r2_tr_win)) / den, 1e-12))\n        ew_tr_l1[i] = max(float(np.dot(w, r1_tr_win)) / den, 1e-6)\n    le_tr2 = np.log(np.maximum(ew_tr_l2, 1e-6))\n    le_tr1 = np.log(np.maximum(ew_tr_l1, 1e-6))\n    return le_tr2 - le_tr2[5] + anchor_log_sigma, le_tr1 - le_tr1[5] + anchor_log_sigma\n\nfor asset in ['BTC', 'ETH', 'SOL', 'XRP', 'HYPE', 'XAU', 'NVDAX', 'GOOGLX', 'TSLAX', 'AAPLX', 'WTIOIL', 'SPCX', 'SP500']:\n    store = RealizedPathStore(asset, 86400, 300)\n    days = pd.date_range('2026-07-23', '2026-09-12', freq='2D')\n    prompts = []\n    for d in days:\n        entries = store._load_day(d.date())\n        for t0 in sorted(entries)[::4]:\n            rp = np.asarray(entries[t0], dtype=np.float64)\n            if not np.all(np.isnan(rp)): prompts.append((t0, rp))\n    prices = load_minute_prices(Path('market_data'), asset, prompts[0][0] - pd.Timedelta(days=8), prompts[-1][0] + pd.Timedelta(days=2))\n    s2_back = mod._S2_BACK_336[asset]; s2_fwd = mod._S2_FWD_336[asset]\n    \n    e_l2, e_hl1m, e_tr5_l2, e_tr5_l1, e_comb = [], [], [], [], []\n    for t0, rp in prompts:\n        ctx = prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, 86400)]\n        vals = ctx['close'].to_numpy(dtype=np.float64); valid_pos = np.flatnonzero(np.isfinite(vals))\n        grid_us = mod._index_to_utc_us(ctx.index)\n        grid_s2 = s2_back[mod._slots_from_utc_us(grid_us)] * mod._subslot_modulation(grid_us, asset, False) * mod._event_variance_multiplier(grid_us, asset)\n        grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n        rets = np.diff(np.log(vals[valid_pos]))\n        ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n        rate_ds = (rets ** 2) / ds2; cap_ds = float(np.percentile(rate_ds[rate_ds > 0], 98.5))\n        r2_win = np.minimum(rate_ds, cap_ds) * ds2\n        t_end_us = int(grid_us[-1]); valid_us = grid_us[valid_pos]\n        age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n        g_slice = slice(int(valid_pos[0]), len(grid_us)); age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0); s2_grid_active = grid_s2[g_slice]\n        ewma_l2 = np.empty(6)\n        for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n            w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min); den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n            ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12))\n        log_l2 = np.log(ewma_l2)\n        log_hl1 = mod._compute_ohlc_log_ewma(ctx, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n        log_tr2, log_tr1 = compute_tr5_ewma(ctx, grid_s2, float(log_l2[5]))\n        \n        start_us = int(round(t0.timestamp() * 1_000_000))\n        fwd_us = start_us + np.arange(1, 1441, dtype=np.int64) * 60_000_000\n        fwd_s2 = (s2_fwd[mod._slots_from_utc_us(fwd_us)] * mod._subslot_modulation(fwd_us, asset, False) * mod._event_variance_multiplier(fwd_us, asset)).reshape(288, 5).sum(axis=1)\n        r_fwd = np.diff(np.log(rp))\n        sig_fwd = 0.5 * np.sqrt(np.sum(r_fwd**2) / np.sum(fwd_s2)) + 0.5 * (1.253314 * np.sum(np.abs(r_fwd)) / np.sum(np.sqrt(fwd_s2)))\n        if sig_fwd <= 1e-6: continue\n        y = np.log(sig_fwd)\n        w = 0.25 * mod.WEIGHTS_24H_SHORT + 0.75 * mod.WEIGHTS_24H_LONG\n        e_l2.append(y - np.dot(w, log_l2))\n        e_hl1m.append(y - np.dot(w, log_hl1))\n        e_tr5_l2.append(y - np.dot(w, log_tr2))\n        e_tr5_l1.append(y - np.dot(w, log_tr1))\n        e_comb.append(y - np.dot(w, 0.65*log_l2 + 0.35*log_tr1))\n    print(f'{asset:<7} | RMSE: l2={np.std(e_l2):.4f} | hl1m={np.std(e_hl1m):.4f} | tr5_l2={np.std(e_tr5_l2):.4f} | tr5_l1={np.std(e_tr5_l1):.4f} | 65l2+35tr5_l1={np.std(e_comb):.4f}')\n\"","description":"Test Feller 5-minute True-Range (L1 and L2) volatility estimators against 1m L2 and 1m Parkinson across all 13 assets"}}
