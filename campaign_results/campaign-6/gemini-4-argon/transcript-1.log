VDAX', 'GOOGLX', 'TSLAX', 'AAPLX', 'WTIOIL', 'SPCX', 'SP500']),\n        ('crypto-1h', ['BTC', 'ETH', 'SOL', 'XRP', 'HYPE']),\n    ]:\n        print(f'--- {comp_name} ---')\n        for a in assets:\n            df = pd.read_parquet(f'market_data/offline_data/miner_scores_{a}_{comp_name}.parquet')\n            df['scored_time'] = pd.to_datetime(df['scored_time'], utc=True)\n            w = df[(df['scored_time'] > t0) & (df['scored_time'] <= t1) & (df['crps'] > 0)]\n            n_prompts = w['scored_time'].nunique()\n            counts = w.groupby('miner_uid')['scored_time'].nunique()\n            full_miners = counts[counts >= n_prompts * 0.95].index\n            w_full = w[w['miner_uid'].isin(full_miners)]\n            miner_means = w_full.groupby('miner_uid')['crps'].mean().sort_values()\n            our_val = ours_map[(comp_name, a)]\n            rank = int((miner_means < our_val).sum()) + 1\n            print(f'  {a:<8} Ours={our_val:8.3f} (Rank {rank:2d}/{len(miner_means):3d}) | #1_miner={miner_means.iloc[0]:8.3f} (diff={our_val - miner_means.iloc[0]:+7.3f}) | #3_miner={miner_means.iloc[min(2, len(miner_means)-1)]:8.3f} | median={miner_means.median():8.3f}')\n\""}}
