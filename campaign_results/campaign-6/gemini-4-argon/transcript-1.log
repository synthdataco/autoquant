{"type":"tool_use","timestamp":"2026-10-22T11:26:55.242Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_193284","parameters":{"description":"Test 2D-stratified terminal horizon quantile matching across all 18 pairs on Pre-Half 1 and Pre-Half 2","command":"uv run python -c \"\nimport numpy as np, pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys; sys.path.insert(0, 'agent'); import modeling as mod\n\ndef apply_2d_strat_secant(shocks_inc: np.ndarray, m_half: np.ndarray, per_step_sigma: np.ndarray, eta_tot: float, eta_blk: float = 1.0, n_blks: int = 8) -> np.ndarray:\n    half = m_half.shape[0]\n    if shocks_inc.shape[0] < 2 * half or half < 10:\n        return mod._apply_secant_shocks(shocks_inc, eta_tot, eta_blk, n_blks)\n    pos = shocks_inc[:half].copy()\n    n_strata = 5\n    s_len = half // n_strata\n    q_s = mod._stratified_normal_quantiles(s_len)\n    \n    if eta_blk != 1.0 and pos.shape[1] >= n_blks:\n        b_len = pos.shape[1] // n_blks\n        for b in range(n_blks):\n            sl_b = slice(b * b_len, (b + 1) * b_len)\n            sig2_b = per_step_sigma[sl_b] ** 2\n            tot_sig2_b = max(float(np.sum(sig2_b)), 1e-12)\n            w_b = sig2_b / tot_sig2_b\n            b_sum = np.sum(pos[:, sl_b], axis=1, keepdims=True)\n            pos[:, sl_b] = pos[:, sl_b] + (eta_blk - 1.0) * b_sum * w_b[None, :]\n            \n    # Now 2D-stratify the total horizon sum within each of the 5 m_half strata!\n    sig2_tot = per_step_sigma ** 2\n    tot_sig2 = max(float(np.sum(sig2_tot)), 1e-12)\n    w_tot = sig2_tot / tot_sig2\n    theo_m_std = float(np.sqrt(np.mean(m_half ** 2)))\n    base_tot_std = np.sqrt(tot_sig2) * eta_tot / max(theo_m_std, 1e-8)\n    for s_i in range(n_strata):\n        sl = slice(s_i * s_len, (s_i + 1) * s_len)\n        r_sum = np.sum(pos[sl], axis=1)\n        order = np.argsort(r_sum)\n        # Target sum for each row in stratum is q_s[rank] * m_half[row] * base_tot_std\n        m_sorted = m_half[sl, 0][order]\n        target_sum = np.empty_like(r_sum)\n        target_sum[order] = q_s * m_sorted * base_tot_std\n        pos[sl] = pos[sl] + (target_sum - r_sum)[:, None] * w_tot[None, :]\n        \n    out = shocks_inc.copy()\n    out[:half] = pos\n    out[half:2*half] = -pos\n    return out\n\ndef _test_2d(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx = args\n    N = 500; half = N // 2\n    out_cur = mod.simulate(asset, t0_iso, ti, tl, N, ctx)\n    paths_cur = np.asarray(out_cur[2:], dtype=np.float64)\n    c_cur, _ = calculate_total_score_for_miner(paths_cur, real, ti, intervals, vol_blocks)\n    if c_cur < 0: return None\n    \n    p0 = paths_cur[0, 0]\n    dlog_cur = np.diff(np.log(paths_cur), axis=1)\n    per_step_sigma = np.std(dlog_cur, axis=0)\n    is_1h = tl <= 3600\n    n_inc = len(per_step_sigma)\n    _, sig_path_vv, sig_step_vv = mod._distribution_params(asset, tl)\n    q_z = mod._stratified_normal_quantiles(half)\n    m_half = np.exp(sig_path_vv * q_z - 0.5 * sig_path_vv**2)[:, None]\n    \n    rng = mod._make_rng(asset, t0_iso, tl)\n    eps = rng.standard_normal((half, n_inc)) * np.exp(sig_step_vv * rng.standard_normal((half, n_inc)) - 0.5 * sig_step_vv**2)\n    eps = eps * m_half\n    z = np.vstack([eps, -eps])\n    z = z / np.maximum(np.std(z, axis=0, keepdims=True), 1e-8)\n    shocks_inc = z * per_step_sigma[None, :]\n    \n    if is_1h:\n        eb = 0.95 if asset != 'ETH' else 1.0\n        shocks_inc = apply_2d_strat_secant(shocks_inc, m_half, per_step_sigma, eta_tot=1.0, eta_blk=eb, n_blks=4)\n    elif asset in mod.CRYPTO_ASSETS:\n        shocks_inc = apply_2d_strat_secant(shocks_inc, m_half, per_step_sigma, eta_tot=1.0, eta_blk=1.0, n_blks=8)\n    else:\n        eta_equ = 1.05 if asset == 'SPCX' else 1.09\n        shocks_inc = apply_2d_strat_secant(shocks_inc, m_half, per_step_sigma, eta_tot=eta_equ, eta_blk=1.0, n_blks=8)\n        \n    shocks = np.empty((N, n_inc + 1), dtype=np.float64); shocks[:, 0] = 0.0; shocks[:, 1:] = shocks_inc\n    p_new = p0 * np.exp(np.cumsum(shocks, axis=1))\n    c_new, _ = calculate_total_score_for_miner(p_new, real, ti, intervals, vol_blocks)\n    return {'t0': pd.Timestamp(t0_iso), 'diff': c_new - c_cur}\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [CRYPTO_24H, COM_EQU_24H, CRYPTO_1H]:\n        print(f'=== {comp.label} 2D-Stratified Horizon Quantile Test ===', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n            all_p = []\n            p_stride = 24 if comp.time_length <= 3600 else 4\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::p_stride]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)): all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [(asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, comp.vol_scoring_blocks, rp, prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)]) for t0, rp in all_p]\n            df = pd.DataFrame([r for r in ex.map(_test_2d, tasks) if r is not None])\n            h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n            print(f'  {asset:<7} | All={df[\\\"diff\\\"].mean():+.3f} (H1={df.loc[h1,\\\"diff\\\"].mean():+.3f}, H2={df.loc[h2,\\\"diff\\\"].mean():+.3f})', flush=True)\n\""}}
