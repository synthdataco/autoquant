{"type":"tool_use","timestamp":"2026-10-22T04:42:39.548Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_302464","parameters":{"command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom scipy.optimize import minimize_scalar\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nfrom modeling import simulate\n\nfor comp, slug, asset in [(CRYPTO_24H, 'crypto-24h', 'XRP'), (COM_EQU_24H, 'com-equ-24h', 'SPCX'), (COM_EQU_24H, 'com-equ-24h', 'AAPLX')]:\n    df = pd.read_parquet(f'market_data/offline_data/miner_scores_{asset}_{slug}.parquet')\n    df['scored_time'] = pd.to_datetime(df['scored_time'], utc=True)\n    df['start_time'] = df['scored_time'] - pd.Timedelta(seconds=comp.time_length)\n    w = df[(df['scored_time'] >= '2026-09-09') & (df['scored_time'] < '2026-09-15') & (df['crps'] > 0)]\n    n_p = w['scored_time'].nunique()\n    counts = w.groupby('miner_uid')['scored_time'].nunique()\n    w_full = w[w['miner_uid'].isin(counts[counts >= n_p * 0.95].index)]\n    top_uid = w_full.groupby('miner_uid')['crps'].mean().idxmin()\n    med_s = w_full.groupby('start_time')['crps'].median()\n    top_s = w_full[w_full['miner_uid'] == top_uid].set_index('start_time')['crps']\n    \n    store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n    times = sorted(top_s.index)\n    prices = load_minute_prices(Path('market_data'), asset, times[0] - pd.Timedelta(days=8), times[-1] + pd.Timedelta(days=2))\n    rows = []\n    for t0 in times[::2]:\n        rp_ser = store.get(t0)\n        if rp_ser is None: continue\n        real = rp_ser.to_numpy(dtype=np.float64)\n        ctx = prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)]\n        out = simulate(asset, t0.isoformat(), comp.time_increment, comp.time_length, 300, ctx)\n        paths = np.asarray(out[2:], dtype=np.float64)\n        c_cur, _ = calculate_total_score_for_miner(paths, real, comp.time_increment, comp.scoring_intervals, {})\n        p0 = paths[:, :1]; log_p = np.log(paths / p0)\n        res = minimize_scalar(\n            lambda ls: calculate_total_score_for_miner(p0 * np.exp(np.exp(ls) * log_p), real, comp.time_increment, comp.scoring_intervals, {})[0],\n            bounds=(-0.6, 0.6), method='bounded', options={'xatol': 0.02}\n        )\n        r_tot = (real[-1] / real[0] - 1.0) * 1e4\n        rows.append({\n            't0': t0, 'dow': t0.strftime('%a'), 'ours': c_cur, 'top': float(top_s.loc[t0]),\n            'med': float(med_s.loc[t0]), 'oracle_s': float(res.fun), 's_opt': float(np.exp(res.x)),\n            'diff_top': c_cur - float(top_s.loc[t0]), 'diff_med': c_cur - float(med_s.loc[t0]),\n            'r_24h_bp': r_tot\n        })\n    dfr = pd.DataFrame(rows)\n    print(f'=== {asset} (top_uid={top_uid}) | Mean Ours={dfr[\\\"ours\\\"].mean():.1f}, Top={dfr[\\\"top\\\"].mean():.1f}, Med={dfr[\\\"med\\\"].mean():.1f}, OracleS={dfr[\\\"oracle_s\\\"].mean():.1f} ===')\n    print('Worst 5 prompts vs Top:')\n    for _, r in dfr.sort_values('diff_top', ascending=False).head(5).iterrows():\n        print(f'  {r[\\\"t0\\\"]} ({r[\\\"dow\\\"]}) | Ours={r[\\\"ours\\\"]:7.1f} | Top={r[\\\"top\\\"]:7.1f} | Med={r[\\\"med\\\"]:7.1f} | OracleS={r[\\\"oracle_s\\\"]:7.1f} (s*={r[\\\"s_opt\\\"]:.2f}) | r_24h={r[\\\"r_24h_bp\\\"]:+6.0f}bp')\n    print('Best 5 prompts vs Top:')\n    for _, r in dfr.sort_values('diff_top', ascending=True).head(5).iterrows():\n        print(f'  {r[\\\"t0\\\"]} ({r[\\\"dow\\\"]}) | Ours={r[\\\"ours\\\"]:7.1f} | Top={r[\\\"top\\\"]:7.1f} | Med={r[\\\"med\\\"]:7.1f} | OracleS={r[\\\"oracle_s\\\"]:7.1f} (s*={r[\\\"s_opt\\\"]:.2f}) | r_24h={r[\\\"r_24h_bp\\\"]:+6.0f}bp')\n\"","description":"Inspect worst and best prompts vs top miner and median miner on 2026-09-09..2026-09-15 for XRP, SPCX, AAPLX"}}
