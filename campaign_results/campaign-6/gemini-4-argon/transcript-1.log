asset, 86400, 300)\n        days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n        all_p = []\n        for d in days:\n            entries = store._load_day(d.date())\n            for t0 in sorted(entries)[::4]:\n                rp = np.asarray(entries[t0], dtype=np.float64)\n                if not np.all(np.isnan(rp)): all_p.append((t0, rp))\n        prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n        tasks = [(asset, t0.isoformat(), COM_EQU_24H.scoring_intervals, rp, prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, 86400)]) for t0, rp in all_p]\n        df = pd.DataFrame([r for r in ex.map(_test_more_eta, tasks) if r is not None])\n        h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n        print(f'  {asset:<7} | d1(tot1.04,blk1.02): All={df[\\\"d1\\\"].mean():+.3f} (H1={df.loc[h1,\\\"d1\\\"].mean():+.3f}, H2={df.loc[h2,\\\"d1\\\"].mean():+.3f}) | d2(tot1.05): All={df[\\\"d2\\\"].mean():+.3f} (H1={df.loc[h1,\\\"d2\\\"].mean():+.3f}, H2={df.loc[h2,\\\"d2\\\"].mean():+.3f})', flush=True)\n\""}}
