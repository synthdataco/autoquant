{"type":"tool_use","timestamp":"2026-10-22T07:43:06.101Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_594108","parameters":{"description":"Test weekend forward slot scaling and WEEKDAY_SUB288_S2 damping across Pre-Half 1 and Pre-Half 2 for CRYPTO_24H and COM_EQU_24H","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\n# Test weekend slot scaling (slots 240..335 in _S2_FWD_336) and WEEKDAY_SUB288_S2 smoothing on H1 and H2!\ndef _test_we_sub(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx = args\n    out_cur = mod.simulate(asset, t0_iso, ti, tl, 300, ctx)\n    paths_cur = np.asarray(out_cur[2:], dtype=np.float64)\n    c_cur, _ = calculate_total_score_for_miner(paths_cur, real, ti, intervals, vol_blocks)\n    if c_cur < 0: return None\n    \n    is_1h = tl <= 3600\n    n_inc = tl // ti\n    step_mins = max(ti // 60, 1)\n    start_us = mod._timestamp_to_utc_us(t0_iso)\n    fwd_us = start_us + np.arange(1, n_inc * step_mins + 1, dtype=np.int64) * 60_000_000\n    fwd_slots = mod._slots_from_utc_us(fwd_us)\n    \n    s2_back = mod._S2_BACK_336[asset]\n    s2_fwd_cur = s2_back if is_1h else mod._S2_FWD_336.get(asset, s2_back)\n    sub_cur = mod._subslot_modulation(fwd_us, asset, is_1h)\n    ev_mult = mod._event_variance_multiplier(fwd_us, asset)\n    fwd_s2_cur = (s2_fwd_cur[fwd_slots] * sub_cur * ev_mult).reshape(n_inc, step_mins).sum(axis=1)\n    \n    # Variant A: scale weekend slots (240..335, plus Fri 20:00..24:00 slots 232..239) by 0.82 in variance (0.905 in std)\n    s2_fwd_we = s2_fwd_cur.copy()\n    s2_fwd_we[232:320] *= 0.82\n    fwd_s2_we = (s2_fwd_we[fwd_slots] * sub_cur * ev_mult).reshape(n_inc, step_mins).sum(axis=1)\n    \n    # Variant B: damp WEEKDAY_SUB288_S2 by 0.5 toward 1.0 outside 13:30-14:30 and 19:30-20:30\n    sub_smooth = 0.5 + 0.5 * sub_cur\n    fwd_s2_sub = (s2_fwd_cur[fwd_slots] * sub_smooth * ev_mult).reshape(n_inc, step_mins).sum(axis=1)\n    \n    p0 = paths_cur[:, :1]\n    dlog_cur = np.diff(np.log(paths_cur / p0), axis=1)\n    \n    ratio_we = np.sqrt(np.maximum(fwd_s2_we, 1e-4) / np.maximum(fwd_s2_cur, 1e-4))\n    p_we = p0 * np.exp(np.hstack([np.zeros((paths_cur.shape[0], 1)), np.cumsum(dlog_cur * ratio_we[None, :], axis=1)]))\n    c_we, _ = calculate_total_score_for_miner(p_we, real, ti, intervals, vol_blocks)\n    \n    ratio_sub = np.sqrt(np.maximum(fwd_s2_sub, 1e-4) / np.maximum(fwd_s2_cur, 1e-4))\n    p_sub = p0 * np.exp(np.hstack([np.zeros((paths_cur.shape[0], 1)), np.cumsum(dlog_cur * ratio_sub[None, :], axis=1)]))\n    c_sub, _ = calculate_total_score_for_miner(p_sub, real, ti, intervals, vol_blocks)\n    \n    return {'t0': pd.Timestamp(t0_iso), 'd_we': c_we - c_cur, 'd_sub': c_sub - c_cur}\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp in [CRYPTO_24H, COM_EQU_24H]:\n        print(f'================ {comp.label} ================', flush=True)\n        for asset in comp.asset_list:\n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            days = pd.date_range('2026-07-16', '2026-09-13', freq='2D')\n            all_p = []\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::4]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)):\n                        all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [\n                (asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, comp.vol_scoring_blocks, rp,\n                 prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)])\n                for t0, rp in all_p\n            ]\n            df = pd.DataFrame([r for r in ex.map(_test_we_sub, tasks) if r is not None])\n            h1 = df['t0'] < '2026-08-15'; h2 = ~h1\n            print(f'  {asset:<7} | d_we: All={df[\\\"d_we\\\"].mean():+.3f} (H1={df.loc[h1,\\\"d_we\\\"].mean():+.3f}, H2={df.loc[h2,\\\"d_we\\\"].mean():+.3f}) | d_sub: All={df[\\\"d_sub\\\"].mean():+.3f} (H1={df.loc[h1,\\\"d_sub\\\"].mean():+.3f}, H2={df.loc[h2,\\\"d_sub\\\"].mean():+.3f})', flush=True)\n\""}}
