{"type":"tool_use","timestamp":"2026-10-22T09:39:44.783Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_492919","parameters":{"description":"Decompose the 4 CRYPTO_24H sub-components across Pre-Validation, Window A, and Window B","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom synth.validator.competition_config import CRYPTO_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nimport modeling as mod\n\n# Let's check on Pre-Validation (07-16..09-13) AND 09-09..09-15 which of the 4 CRYPTO_24H sub-components has the highest Sharpe of CRPS improvement!\ndef _eval_sub(args):\n    asset, t0_iso, real, ctx = args\n    rng = mod._make_rng(asset, t0_iso, 86400)\n    steps = 289; n_inc = 288; step_mins = 5\n    vals = ctx['close'].to_numpy(dtype=np.float64); valid_pos = np.flatnonzero(np.isfinite(vals))\n    last = float(vals[valid_pos[-1]])\n    s2_back = mod._S2_BACK_336[asset]; s2_fwd = mod._S2_FWD_336[asset]; lt_sigma = mod.LONG_TERM_SIGMA_1M[asset]\n    grid_us = mod._index_to_utc_us(ctx.index)\n    grid_s2 = s2_back[mod._slots_from_utc_us(grid_us)] * mod._subslot_modulation(grid_us, asset, False) * mod._event_variance_multiplier(grid_us, asset)\n    grid_s2_cumsum = np.concatenate(([0.0], np.cumsum(grid_s2)))\n    rets = np.diff(np.log(vals[valid_pos]))\n    ds2 = np.maximum(grid_s2_cumsum[valid_pos[1:] + 1] - grid_s2_cumsum[valid_pos[:-1] + 1], 1e-4)\n    rate_ds = (rets ** 2) / ds2; cap_ds = float(np.percentile(rate_ds[rate_ds > 0], 98.5))\n    r2_win = np.minimum(rate_ds, cap_ds) * ds2; r1_scaled = 1.2533141373155001 * np.abs(rets) * np.sqrt(ds2)\n    t_end_us = int(grid_us[-1]); valid_us = grid_us[valid_pos]\n    age_bar_min = np.maximum((t_end_us - 0.5 * (valid_us[1:] + valid_us[:-1])) / 60_000_000.0, 0.0)\n    g_slice = slice(int(valid_pos[0]), len(grid_us)); age_grid_min = np.maximum((t_end_us - grid_us[g_slice]) / 60_000_000.0, 0.0); s2_grid_active = grid_s2[g_slice]\n    ewma_l2 = np.empty(6); ewma_l1 = np.empty(6)\n    for i, lam in enumerate(mod.EWMA_LAMBDAS_6):\n        w_bar = np.exp(-lam * age_bar_min); w_grid = np.exp(-lam * age_grid_min); den = max(float(np.dot(w_grid, s2_grid_active)), 1e-6)\n        ewma_l2[i] = np.sqrt(max(float(np.dot(w_bar, r2_win)) / den, 1e-12)); ewma_l1[i] = max(float(np.dot(w_bar, r1_scaled)) / den, 1e-6)\n    log_l2 = np.log(ewma_l2); log_l1 = np.log(ewma_l1)\n    log_mad5 = mod._compute_5m_mad_ewma(valid_pos, rets, grid_us, grid_s2)\n    log_hl = mod._compute_ohlc_log_ewma(ctx, g_slice, age_grid_min, s2_grid_active, float(log_l2[5]))\n    \n    le_old = 0.80 * log_l2 + 0.20 * (log_l1 + 0.20)\n    le_new = 0.60 * log_l2 + 0.15 * (log_l1 + 0.15) + 0.15 * (log_mad5 + 0.14) + 0.10 * log_hl\n    \n    c_scale, sig_path_vv, sig_step_vv = mod._distribution_params(asset, 86400)\n    start_us = mod._timestamp_to_utc_us(t0_iso); fwd_us = start_us + np.arange(1, n_inc * step_mins + 1, dtype=np.int64) * 60_000_000\n    fwd_slots = mod._slots_from_utc_us(fwd_us)\n    sub_mod = mod._subslot_modulation(fwd_us, asset, False) * mod._event_variance_multiplier(fwd_us, asset)\n    step_seas_old = np.sqrt(np.maximum((s2_fwd[fwd_slots] * sub_mod).reshape(n_inc, step_mins).sum(axis=1), 1e-4))\n    \n    s2_fwd_we = s2_fwd.copy(); orig_m = float(np.mean(s2_fwd_we)); s2_fwd_we[232:320] *= 0.90; s2_fwd_we *= orig_m / float(np.mean(s2_fwd_we))\n    step_seas_we = np.sqrt(np.maximum((s2_fwd_we[fwd_slots] * sub_mod).reshape(n_inc, step_mins).sum(axis=1), 1e-4))\n    \n    decay = np.exp(-(np.arange(n_inc, dtype=np.float64) + 0.5) * step_mins / mod.REVERSION_TAU_24H)\n    \n    def get_base_t(le):\n        ss = float(np.exp(np.dot(mod.WEIGHTS_24H_SHORT, le)))\n        sl = float(np.exp(0.90 * np.dot(mod.WEIGHTS_24H_LONG, le) + 0.10 * np.log(lt_sigma)))\n        return c_scale * sl * ((ss / max(sl, 1e-8)) ** decay)\n    \n    bt_old = get_base_t(le_old)\n    bt_new = get_base_t(le_new)\n    \n    idx_24h = int(np.searchsorted(valid_pos, max(0, len(vals) - 1440)))\n    ret_24h = abs(float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_24h]]))) / max(np.sqrt(np.sum(grid_s2[-1440:])) * ewma_l2[4], 1e-6)\n    idx_4h = int(np.searchsorted(valid_pos, max(0, len(vals) - 240)))\n    ret_4h = abs(float(np.log(vals[valid_pos[-1]] / vals[valid_pos[idx_4h]]))) / max(np.sqrt(np.sum(grid_s2[-240:])) * ewma_l2[3], 1e-6)\n    brk_mult = float(np.exp(0.025 * np.clip(ret_24h - 0.85, -0.35, 1.8) + 0.015 * np.clip(ret_4h - 0.85, -0.35, 1.8)))\n    \n    half = 150\n    eps = rng.standard_normal((half, n_inc)) * np.exp(sig_step_vv * rng.standard_normal((half, n_inc)) - 0.5 * sig_step_vv**2)\n    eps = eps * np.exp(sig_path_vv * mod._stratified_normal_quantiles(half) - 0.5 * sig_path_vv**2)[:, None]\n    z = np.vstack([eps, -eps]); z = z / np.std(z, axis=0, keepdims=True)\n    \n    def score_shocks(sh_inc):\n        sh = np.empty((300, 289), dtype=np.float64); sh[:, 0] = 0.0; sh[:, 1:] = sh_inc\n        return calculate_total_score_for_miner(last * np.exp(np.cumsum(sh, axis=1)), real, 300, CRYPTO_24H.scoring_intervals, {})[0]\n    \n    sh_base = z * (bt_old * step_seas_old)[None, :]\n    c_base = score_shocks(sh_base)\n    c_le = score_shocks(z * (bt_new * step_seas_old)[None, :]) - c_base\n    c_we = score_shocks(z * (bt_old * step_seas_we)[None, :]) - c_base\n    c_brk = score_shocks(z * (brk_mult * bt_old * step_seas_old)[None, :]) - c_base\n    c_sec = score_shocks(mod._apply_secant_shocks(sh_base, 0.98, 0.97, 8)) - c_base\n    return {'le': c_le, 'we': c_we, 'brk': c_brk, 'sec': c_sec}\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for w_name, d0, d1 in [('Pre-Val (07-16..09-13)', '2026-07-16', '2026-09-13'), ('Win A (09-15..09-25)', '2026-09-15', '2026-09-24'), ('Win B (10-01..10-11)', '2026-10-01', '2026-10-10')]:\n        print(f'=== {w_name} ===', flush=True)\n        for asset in CRYPTO_24H.asset_list:\n            store = RealizedPathStore(asset, 86400, 300)\n            days = pd.date_range(d0, d1, freq='1D' if 'Win' in w_name else '3D')\n            all_p = []\n            for d in days:\n                entries = store._load_day(d.date())\n                for t0 in sorted(entries)[::4]:\n                    rp = np.asarray(entries[t0], dtype=np.float64)\n                    if not np.all(np.isnan(rp)): all_p.append((t0, rp))\n            prices = load_minute_prices(Path('market_data'), asset, all_p[0][0] - pd.Timedelta(days=8), all_p[-1][0] + pd.Timedelta(days=1))\n            tasks = [(asset, t0.isoformat(), rp, prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, 86400)]) for t0, rp in all_p]\n            df = pd.DataFrame(list(ex.map(_eval_sub, tasks)))\n            print(f'  {asset:<6} | le:{df[\\\"le\\\"].mean():+.2f} | we:{df[\\\"we\\\"].mean():+.2f} | brk:{df[\\\"brk\\\"].mean():+.2f} | sec:{df[\\\"sec\\\"].mean():+.2f}', flush=True)\n\""}}
