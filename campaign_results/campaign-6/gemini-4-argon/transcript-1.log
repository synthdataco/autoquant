{"type":"tool_use","timestamp":"2026-10-22T03:55:39.850Z","tool_name":"run_shell_command","tool_id":"run_shell_command__call_211983","parameters":{"description":"Decompose our model vs Top miner vs Oracle per-prompt scale and horizon tilt on 2026-09-09..2026-09-15","command":"uv run python -c \"\nimport numpy as np\nimport pandas as pd\nfrom pathlib import Path\nfrom concurrent.futures import ProcessPoolExecutor\nfrom scipy.optimize import minimize_scalar\nfrom synth.validator.competition_config import CRYPTO_1H, CRYPTO_24H, COM_EQU_24H\nfrom synth.validator.crps_calculation import calculate_total_score_for_miner\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_end\nfrom synth_lib.preparation.realized_path_store import RealizedPathStore\nimport sys\nsys.path.insert(0, 'agent')\nfrom modeling import simulate\n\ndef _decomp_one(args):\n    asset, t0_iso, ti, tl, intervals, vol_blocks, real, ctx, top_crps = args\n    out = simulate(asset, t0_iso, ti, tl, 400, ctx)\n    paths = np.asarray(out[2:], dtype=np.float64)\n    p0 = paths[:, :1]\n    log_p = np.log(paths / p0)\n    \n    c_cur, det_cur = calculate_total_score_for_miner(paths, real, ti, intervals, vol_blocks)\n    # 1. Best global scale for this prompt (1 DOF per prompt oracle)\n    res = minimize_scalar(\n        lambda ls: calculate_total_score_for_miner(p0 * np.exp(np.exp(ls) * log_p), real, ti, intervals, vol_blocks)[0],\n        bounds=(-0.6, 0.6), method='bounded', options={'xatol': 0.015}\n    )\n    c_oracle_s = float(res.fun)\n    s_opt = float(np.exp(res.x))\n    \n    # 2. What if the path shape has gentler/steeper horizon decay (tilt along the horizon)?\n    n_inc = log_p.shape[1] - 1\n    dlog = np.diff(log_p, axis=1)\n    u_grid = np.linspace(-1.0, 1.0, n_inc)[None, :]\n    c_tilts = {}\n    for alpha in [-0.25, -0.12, 0.0, 0.12, 0.25]:\n        w_t = np.exp(alpha * u_grid)\n        w_t = w_t / np.sqrt(np.mean(w_t**2))\n        lp_tilt = np.hstack([np.zeros((log_p.shape[0], 1)), np.cumsum(dlog * w_t, axis=1)])\n        c_tilts[alpha] = calculate_total_score_for_miner(p0 * np.exp(lp_tilt), real, ti, intervals, vol_blocks)[0]\n    \n    return {\n        't0': pd.Timestamp(t0_iso), 'cur': c_cur, 'top': top_crps, 'oracle_s': c_oracle_s, 's_opt': s_opt,\n        'tilt_m25': c_tilts[-0.25], 'tilt_m12': c_tilts[-0.12], 'tilt_p12': c_tilts[0.12], 'tilt_p25': c_tilts[0.25],\n    }\n\nwith ProcessPoolExecutor(max_workers=12) as ex:\n    for comp, slug in [(CRYPTO_24H, 'crypto-24h'), (COM_EQU_24H, 'com-equ-24h'), (CRYPTO_1H, 'crypto-1h')]:\n        print(f'================ {slug} (2026-09-09..2026-09-15) ================', flush=True)\n        for asset in comp.asset_list:\n            df = pd.read_parquet(f'market_data/offline_data/miner_scores_{asset}_{slug}.parquet')\n            df['scored_time'] = pd.to_datetime(df['scored_time'], utc=True)\n            df['start_time'] = df['scored_time'] - pd.Timedelta(seconds=comp.time_length)\n            w = df[(df['scored_time'] >= '2026-09-09') & (df['scored_time'] < '2026-09-15') & (df['crps'] > 0)]\n            n_p = w['scored_time'].nunique()\n            counts = w.groupby('miner_uid')['scored_time'].nunique()\n            w_full = w[w['miner_uid'].isin(counts[counts >= n_p * 0.95].index)]\n            top_uid = w_full.groupby('miner_uid')['crps'].mean().idxmin()\n            top_s = w_full[w_full['miner_uid'] == top_uid].set_index('start_time')['crps']\n            \n            store = RealizedPathStore(asset, comp.time_length, comp.time_increment)\n            times = sorted(top_s.index)[::(6 if comp.time_length==3600 else 1)]\n            prices = load_minute_prices(Path('market_data'), asset, times[0] - pd.Timedelta(days=8), times[-1] + pd.Timedelta(days=2))\n            vb = {} if comp.time_length == 3600 else comp.vol_scoring_blocks\n            tasks = []\n            for t0 in times:\n                rp_ser = store.get(t0)\n                if rp_ser is None: continue\n                tasks.append((\n                    asset, t0.isoformat(), comp.time_increment, comp.time_length, comp.scoring_intervals, vb,\n                    rp_ser.to_numpy(dtype=np.float64),\n                    prices.loc[t0 - pd.Timedelta(days=7) : context_end(t0, comp.time_length)],\n                    float(top_s.loc[t0])\n                ))\n            res = list(ex.map(_decomp_one, tasks))\n            dfr = pd.DataFrame(res)\n            print(f'  {asset:<7} | Ours={dfr[\\\"cur\\\"].mean():7.2f} | Top(uid={top_uid:3d})={dfr[\\\"top\\\"].mean():7.2f} (diff={dfr[\\\"cur\\\"].mean()-dfr[\\\"top\\\"].mean():+6.2f}) | OracleScale={dfr[\\\"oracle_s\\\"].mean():7.2f} (room={dfr[\\\"oracle_s\\\"].mean()-dfr[\\\"cur\\\"].mean():+6.2f}) | med(s_opt)={dfr[\\\"s_opt\\\"].median():.3f} | tilts(-25,-12,+12,+25): {dfr[\\\"tilt_m25\\\"].mean()-dfr[\\\"cur\\\"].mean():+.2f}, {dfr[\\\"tilt_m12\\\"].mean()-dfr[\\\"cur\\\"].mean():+.2f}, {dfr[\\\"tilt_p12\\\"].mean()-dfr[\\\"cur\\\"].mean():+.2f}, {dfr[\\\"tilt_p25\\\"].mean()-dfr[\\\"cur\\\"].mean():+.2f}', flush=True)\n\""}}
