{"type":"tool_use","timestamp":"2026-09-09T16:01:17.768Z","tool_name":"write_file","tool_id":"write_file__call_1701488","parameters":{"file_path":"agent/modeling.py","content":"\"\"\"Advanced price-simulation model supporting EWMA volatility and fat-tailed shock distributions.\n\nControllable via environment variables for systematic hyperparameter tuning.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport numpy as np\nimport pandas as pd\n\n\ndef simulate(\n    asset: str,\n    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    steps = time_length // time_increment + 1\n    closes = context_prices[\"close\"].dropna()\n    \n    # 1. Apply lookback window if specified\n    window_minutes = os.environ.get(\"VOL_WINDOW_MINUTES\", None)\n    if window_minutes is not None:\n        closes = closes.iloc[-int(window_minutes):]\n        \n    last = float(closes.iloc[-1])\n    rets = np.diff(np.log(np.asarray(closes, dtype=float)))\n    rets = rets[np.isfinite(rets)]\n    \n    if rets.size > 10:\n        # 2. Compute 1-minute volatility using EWMA or simple standard deviation\n        halflife_minutes = os.environ.get(\"VOL_HALFLIFE_MINUTES\", None)\n        if halflife_minutes is not None:\n            rets_series = pd.Series(rets)\n            vol_1m = float(rets_series.ewm(halflife=float(halflife_minutes)).std().iloc[-1])\n            # If the calculation results in NaN/extreme, fallback to standard std\n            if not np.isfinite(vol_1m) or vol_1m <= 0:\n                vol_1m = float(np.std(rets))\n        else:\n            vol_1m = float(np.std(rets))\n            \n        # Scale 1-minute volatility to the target step size\n        per_step_sigma = vol_1m * (time_increment / 60.0) ** 0.5\n    else:\n        per_step_sigma = 1e-3\n        \n    # Apply a volatility floor to prevent degenerate distributions\n    per_step_sigma = max(per_step_sigma, 1e-6)\n    \n    rng = np.random.default_rng()\n    \n    # 3. Sample shocks from either Normal or Student's t-distribution\n    distribution = os.environ.get(\"SHOCK_DISTRIBUTION\", \"normal\").lower()\n    if distribution == \"student_t\":\n        df_t = float(os.environ.get(\"STUDENT_T_DF\", 5.0))\n        # Standardize Student's t variance to 1\n        scale = ((df_t - 2.0) / df_t) ** 0.5 if df_t > 2.0 else 1.0\n        shocks = rng.standard_t(df=df_t, size=(num_simulations, steps)) * (scale * per_step_sigma)\n    elif distribution == \"laplace\":\n        # Standardize Laplace variance to 1 (Laplace scale b = 1/sqrt(2) for variance 1)\n        scale = 1.0 / (2.0 ** 0.5)\n        shocks = rng.laplace(0.0, scale, size=(num_simulations, steps)) * per_step_sigma\n    else:\n        shocks = rng.normal(0.0, per_step_sigma, size=(num_simulations, steps))\n        \n    shocks[:, 0] = 0.0\n    paths = last * np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *[p.tolist() for p in paths])\n"}}
