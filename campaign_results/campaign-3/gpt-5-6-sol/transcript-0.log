{"type":"item.completed","item":{"id":"item_18","type":"command_execution","command":"/bin/bash -c \"printf '%s\\\\n' '--- BUDGET ---'; cat agent/BUDGET.md; printf '%s\\\\n' '--- CRPS 1-240 ---'; nl -ba .venv/lib/python3.12/site-packages/synth/validator/crps_calculation.py | sed -n '1,240p'; printf '%s\\\\n' '--- MOVING AVERAGE 1-260 ---'; nl -ba .venv/lib/python3.12/site-packages/synth/validator/moving_average.py | sed -n '1,300p'; printf '%s\\\\n' '--- ORCHESTRATION DEFS ---'; rg -n '\"'^def |''^class '\"' .venv/lib/python3.12/site-packages/synth_lib/backtester/orchestration.py; printf '%s\\\\n' '--- ORCH 300-650 ---'; nl -ba .venv/lib/python3.12/site-packages/synth_lib/backtester/orchestration.py | sed -n '300,650p'; printf '%s\\\\n' '--- TYPES ---'; rg -n '\"'^class |@dataclass|summary:'\"' .venv/lib/python3.12/site-packages/synth_lib/backtester -g '*.py'\"","aggregated_output":"--- BUDGET ---\n# BUDGET — maintained by the harness (read-only for you)\n\n- Credits: 0.03 / 100.00 USD (0%)\n- Time   : 0.0 h elapsed, 18.0 h remaining (0%)\n- Phase  : normal\n--- CRPS 1-240 ---\n     1\timport numpy as np\n     2\tfrom properscoring import crps_ensemble\n     3\t\n     4\t\n     5\tdef get_interval_steps(scoring_interval: int, time_increment: int) -> int:\n     6\t    \"\"\"\n     7\t    Calculate the number of steps in the given scoring interval based on the time increment.\n     8\t    \"\"\"\n     9\t    return int(scoring_interval / time_increment)\n    10\t\n    11\t\n    12\tdef calculate_crps_for_miner(\n    13\t    simulation_runs: np.ndarray,\n    14\t    real_price_path: np.ndarray,\n    15\t    time_increment: int,\n    16\t    scoring_intervals: dict[str, int],\n    17\t) -> tuple[float, list[dict]]:\n    18\t    \"\"\"\n    19\t    Calculate the total CRPS score for a miner's simulations over specified intervals,\n    20\t    Return the sum of the scores.\n    21\t\n    22\t    Parameters:\n    23\t        simulation_runs (numpy.ndarray): Simulated price paths.\n    24\t        real_price_path (numpy.ndarray): The real price path.\n    25\t        time_increment (int): Time increment in seconds.\n    26\t        scoring_intervals (dict): Dictionary of scoring intervals with their names and durations in seconds.\n    27\t\n    28\t    Returns:\n    29\t        float: Sum of total CRPS scores over the intervals.\n    30\t    \"\"\"\n    31\t    # Initialize lists to store detailed CRPS data\n    32\t    detailed_crps_data: list[dict] = []\n    33\t    sum_all_scores = 0.0\n    34\t    gap_total_crps = 0.0\n    35\t\n    36\t    for interval_name, interval_seconds in scoring_intervals.items():\n    37\t        interval_steps = get_interval_steps(interval_seconds, time_increment)\n    38\t        absolute_price = interval_name.endswith(\"_abs\")\n    39\t        is_gap = interval_name.endswith(\"_gaps\")\n    40\t\n    41\t        # If we are considering absolute prices, adjust the interval steps for potential gaps:\n    42\t        # if only the initial price is present, then decrease the interval step\n    43\t        if absolute_price:\n    44\t            while (\n    45\t                real_price_path[::interval_steps].shape[0] == 1\n    46\t                and interval_steps > 1\n    47\t            ):\n    48\t                interval_steps -= 1\n    49\t\n    50\t        # Make sure there are no zero prices in the simulation runs because it will cause a division by zero error\n    51\t        if np.any(simulation_runs == 0):\n    52\t            return -1.0, [\n    53\t                {\"error\": \"Zero price encountered in simulation runs\"}\n    54\t            ]\n    55\t\n    56\t        # Calculate price changes over intervals\n    57\t        simulated_changes = calculate_price_changes_over_intervals(\n    58\t            simulation_runs,\n    59\t            interval_steps,\n    60\t            absolute_price,\n    61\t            is_gap,\n    62\t        )\n    63\t        real_changes = calculate_price_changes_over_intervals(\n    64\t            real_price_path.reshape(1, -1),\n    65\t            interval_steps,\n    66\t            absolute_price,\n    67\t            is_gap,\n    68\t        )\n    69\t        data_blocks = label_observed_blocks(real_changes[0])\n    70\t\n    71\t        # Not enough observed data -> continue\n    72\t        if len(data_blocks) == 0:\n    73\t            continue\n    74\t\n    75\t        # Calculate CRPS over intervals\n    76\t        crps_values = sum_crps_over_blocks(\n    77\t            simulated_changes,\n    78\t            real_changes,\n    79\t            data_blocks,\n    80\t            absolute_price,\n    81\t            real_price_path,\n    82\t        )\n    83\t\n    84\t        # Total CRPS for this interval\n    85\t        total_crps_interval = float(crps_values)\n    86\t        sum_all_scores += total_crps_interval\n    87\t        if is_gap:\n    88\t            # Individual *_gaps intervals are folded into the single \"Gaps\"\n    89\t            # Total appended below\n    90\t            gap_total_crps += total_crps_interval\n    91\t            continue\n    92\t\n    93\t        detailed_crps_data.append(\n    94\t            {\n    95\t                \"Interval\": interval_name,\n    96\t                \"Increment\": \"Total\",\n    97\t                \"CRPS\": total_crps_interval,\n    98\t            }\n    99\t        )\n   100\t\n   101\t    if gap_total_crps > 0:\n   102\t        detailed_crps_data.append(\n   103\t            {\"Interval\": \"Gaps\", \"Increment\": \"Total\", \"CRPS\": gap_total_crps}\n   104\t        )\n   105\t\n   106\t    detailed_crps_data.append(\n   107\t        {\"Interval\": \"Overall\", \"Increment\": \"Total\", \"CRPS\": sum_all_scores}\n   108\t    )\n   109\t\n   110\t    return sum_all_scores, detailed_crps_data\n   111\t\n   112\t\n   113\tdef sum_crps_over_blocks(\n   114\t    simulated_changes: np.ndarray,\n   115\t    real_changes: np.ndarray,\n   116\t    data_blocks: np.ndarray,\n   117\t    absolute_price: bool,\n   118\t    real_price_path: np.ndarray,\n   119\t) -> float:\n   120\t    \"\"\"\n   121\t    Sum the CRPS over the observed (non-missing) blocks of a single interval.\n   122\t    \"\"\"\n   123\t    crps_values = 0.0\n   124\t    for block in np.unique(data_blocks):\n   125\t        # skip missing value blocks\n   126\t        if block == -1:\n   127\t            continue\n   128\t\n   129\t        mask = data_blocks == block\n   130\t        simulated_changes_block = simulated_changes[:, mask]\n   131\t        real_changes_block = real_changes[0, mask]  # 1D array now\n   132\t        num_intervals = simulated_changes_block.shape[1]\n   133\t\n   134\t        # Calculate all CRPS values at once\n   135\t        crps_values_block = np.array(\n   136\t            [\n   137\t                crps_ensemble(\n   138\t                    real_changes_block[t], simulated_changes_block[:, t]\n   139\t                )\n   140\t                for t in range(num_intervals)\n   141\t            ]\n   142\t        )\n   143\t\n   144\t        if absolute_price:\n   145\t            crps_values_block = (\n   146\t                crps_values_block / real_price_path[-1] * 10_000\n   147\t            )\n   148\t\n   149\t        crps_values += float(crps_values_block.sum())\n   150\t\n   151\t    return float(crps_values)\n   152\t\n   153\t\n   154\tdef label_observed_blocks(arr: np.ndarray) -> np.ndarray:\n   155\t    \"\"\"\n   156\t    Groups blocks of consecutive observed data together.\n   157\t    Example input/output:\n   158\t    [1.0, 2.0, np.nan, 4.0, np.nan, np.nan, 7.0, 8.0] -> [0, 0, -1, 1, -1, -1, 2, 2]\n   159\t    \"\"\"\n   160\t    not_nan = ~np.isnan(arr)\n   161\t    block_start = not_nan & np.concatenate(([True], ~not_nan[:-1]))\n   162\t    group_numbers = np.cumsum(block_start) - 1\n   163\t    group_labels = np.where(not_nan, group_numbers, -1)\n   164\t    return group_labels\n   165\t\n   166\t\n   167\tdef calculate_price_changes_over_intervals(\n   168\t    price_paths: np.ndarray,\n   169\t    interval_steps: int,\n   170\t    absolute_price=False,\n   171\t    is_gap=False,\n   172\t) -> np.ndarray:\n   173\t    \"\"\"\n   174\t    Calculate price changes over specified intervals.\n   175\t\n   176\t    Parameters:\n   177\t        price_paths (numpy.ndarray): Array of simulated price paths.\n   178\t        interval_steps (int): Number of steps that make up the interval.\n   179\t        absolute_price (bool): If True, absolute price values (rather than price changes) are returned.\n   180\t\n   181\t    Returns:\n   182\t        numpy.ndarray: Array of price changes over intervals.\n   183\t    \"\"\"\n   184\t    # Get the prices at the interval points\n   185\t    # [1, 2, 3, 4, 5, 6, 7] -> [1, 3, 5, 7] if interval_steps is 2\n   186\t    interval_prices = price_paths[:, ::interval_steps]\n   187\t    if is_gap:\n   188\t        # [1, 2, 3, 4, 5, 6, 7] -> [1, 3] if interval_steps is 2\n   189\t        interval_prices = interval_prices[:, :2]\n   190\t\n   191\t    # Calculate price changes over intervals\n   192\t    if absolute_price:\n   193\t        return interval_prices[:, 1:]\n   194\t\n   195\t    return (\n   196\t        np.diff(interval_prices, axis=1) / interval_prices[:, :-1]\n   197\t    ) * 10_000\n--- MOVING AVERAGE 1-260 ---\n     1\tfrom datetime import datetime\n     2\timport typing\n     3\t\n     4\t\n     5\timport numpy as np\n     6\timport pandas as pd\n     7\tfrom pandas import DataFrame\n     8\timport bittensor as bt\n     9\t\n    10\t\n    11\tfrom synth.utils.logging import print_execution_time\n    12\tfrom synth.validator.miner_data_handler import MinerDataHandler\n    13\tfrom synth.validator.competition_config import CompetitionConfig\n    14\tfrom synth.validator.competition_config import SMOOTHED_SCORE_COEFFICIENT\n    15\tfrom synth.validator.reward import compute_softmax\n    16\t\n    17\t# Per-asset weighting coefficients for score normalization across assets.\n    18\t# Higher coefficient = asset scores contribute more to the smoothed score.\n    19\tASSET_COEFFICIENTS = {\n    20\t    \"BTC\": 1.0,\n    21\t    \"ETH\": 0.7064366394033871,\n    22\t    \"XAU\": 1.7370922597118699,\n    23\t    \"SOL\": 0.6310037175639559,\n    24\t    \"SPYX\": 3.437935601155441,\n    25\t    \"SP500\": 3.437935601155441,\n    26\t    \"NVDAX\": 1.6028217601617174,\n    27\t    \"TSLAX\": 1.6068755936957768,\n    28\t    \"AAPLX\": 2.0916380815843123,\n    29\t    \"GOOGLX\": 1.6827392777257926,\n    30\t    \"XRP\": 0.5658394110809131,\n    31\t    \"HYPE\": 0.4784547133706857,\n    32\t    \"WTIOIL\": 0.8475062847978935,\n    33\t    \"SPCX\": 0.4329342627683478,\n    34\t}\n    35\t\n    36\t\n    37\t@print_execution_time\n    38\tdef prepare_df_for_moving_average(df):\n    39\t    \"\"\"Prepare miner scores for moving average computation.\n    40\t\n    41\t    For miners that joined after the earliest scored_time in the window,\n    42\t    backfills missing earlier timestamps with the worst score (percentile95 - lowest_score)\n    43\t    so they are not unfairly advantaged by having fewer data points.\n    44\t\n    45\t    Miners present from the start keep only their real scores (no backfill).\n    46\t    \"\"\"\n    47\t    df = df.copy()\n    48\t    df[\"scored_time\"] = pd.to_datetime(df[\"scored_time\"])\n    49\t\n    50\t    global_min = df[\"scored_time\"].min()\n    51\t    all_times = sorted(df[\"scored_time\"].unique())\n    52\t\n    53\t    # Build worst-score and asset mappings per scored_time (used for backfilling new miners)\n    54\t    global_worst_score_mapping = {}\n    55\t    global_score_asset_mapping = {}\n    56\t    for t in all_times:\n    57\t        sample = df.loc[df[\"scored_time\"] == t].iloc[0]\n    58\t        p95 = sample.get(\"percentile95\")\n    59\t        low = sample.get(\"lowest_score\")\n    60\t        if p95 is None or low is None:\n    61\t            continue\n    62\t        global_worst_score_mapping[t] = p95 - low\n    63\t        global_score_asset_mapping[t] = sample[\"asset\"]\n    64\t\n    65\t    # Identify new miners (first appearance after the window start)\n    66\t    miner_first = df.groupby(\"miner_id\")[\"scored_time\"].min()\n    67\t    new_miner_ids = miner_first[miner_first > global_min].index\n    68\t\n    69\t    if len(new_miner_ids) == 0:\n    70\t        # No new miners - just return the real data (common fast path)\n    71\t        out = df[\n    72\t            [\"scored_time\", \"miner_id\", \"prompt_score_v3\", \"asset\"]\n    73\t        ].copy()\n    74\t        out[\"miner_id\"] = out[\"miner_id\"].astype(int)\n    75\t        out = out.sort_values([\"scored_time\", \"miner_id\"]).reset_index(\n    76\t            drop=True\n    77\t        )\n    78\t        return out\n    79\t\n    80\t    # Build backfill rows only for new miners at times before they joined\n    81\t    backfill_rows = []\n    82\t    backfill_times = [t for t in all_times if t in global_worst_score_mapping]\n    83\t    for mid in new_miner_ids:\n    84\t        first_time = miner_first[mid]\n    85\t        for t in backfill_times:\n    86\t            if t >= first_time:\n    87\t                continue\n    88\t            backfill_rows.append(\n    89\t                {\n    90\t                    \"scored_time\": t,\n    91\t                    \"miner_id\": mid,\n    92\t                    \"prompt_score_v3\": global_worst_score_mapping[t],\n    93\t                    \"asset\": global_score_asset_mapping[t],\n    94\t                }\n    95\t            )\n    96\t\n    97\t    # Combine real data with backfill rows\n    98\t    out = df[[\"scored_time\", \"miner_id\", \"prompt_score_v3\", \"asset\"]].copy()\n    99\t    if backfill_rows:\n   100\t        backfill_df = pd.DataFrame(backfill_rows)\n   101\t        backfill_df[\"scored_time\"] = pd.to_datetime(backfill_df[\"scored_time\"])\n   102\t        out = pd.concat([out, backfill_df], ignore_index=True)\n   103\t\n   104\t    out[\"miner_id\"] = out[\"miner_id\"].astype(int)\n   105\t    out = out.sort_values([\"scored_time\", \"miner_id\"]).reset_index(drop=True)\n   106\t    return out\n   107\t\n   108\t\n   109\t@print_execution_time\n   110\tdef compute_smoothed_score(\n   111\t    miner_data_handler: MinerDataHandler,\n   112\t    input_df: DataFrame,\n   113\t    scored_time: datetime,\n   114\t    comp: CompetitionConfig,\n   115\t) -> typing.Optional[list[dict]]:\n   116\t    \"\"\"Compute smoothed scores and reward weights for all miners.\n   117\t\n   118\t    1. Filters scores to the scoring window (scored_time cutoff)\n   119\t    2. Applies per-asset coefficient weighting (vectorized)\n   120\t    3. Sums weighted scores per miner\n   121\t    4. Assigns inf to miners with no valid scores\n   122\t    5. Computes softmax reward weights\n   123\t    \"\"\"\n   124\t    if input_df.empty:\n   125\t        return None\n   126\t\n   127\t    # Filter to scoring window and drop NaN scores\n   128\t    df = input_df.loc[\n   129\t        pd.to_datetime(input_df[\"scored_time\"]) <= scored_time\n   130\t    ].copy()\n   131\t    df = df.dropna(subset=[\"prompt_score_v3\"])\n   132\t\n   133\t    if df.empty:\n   134\t        return None\n   135\t\n   136\t    # Apply per-asset coefficients vectorized (single pass, no per-miner loop).\n   137\t    # Normalization is per-miner: each miner's scores are divided by the sum of\n   138\t    # coefficients for that miner's assets.\n   139\t    coefs = df[\"asset\"].map(ASSET_COEFFICIENTS).fillna(1.0)\n   140\t    df[\"weighted_score\"] = df[\"prompt_score_v3\"] * coefs\n   141\t    miner_coef_sums = coefs.groupby(df[\"miner_id\"]).sum()\n   142\t    df[\"weighted_score\"] /= df[\"miner_id\"].map(miner_coef_sums)\n   143\t\n   144\t    # Sum per miner in one groupby\n   145\t    rolling_avgs = df.groupby(\"miner_id\")[\"weighted_score\"].sum()\n   146\t\n   147\t    # Miners present in input but with all NaN scores get inf (worst possible)\n   148\t    all_miner_ids = input_df[\"miner_id\"].unique()\n   149\t    missing_miners = set(all_miner_ids) - set(rolling_avgs.index)\n   150\t    for miner_id in missing_miners:\n   151\t        bt.logging.warning(\n   152\t            f\"Miner ID {miner_id} has no valid scores in the window. Assigning infinite rolling average.\"\n   153\t        )\n   154\t        rolling_avgs.loc[miner_id] = float(\"inf\")\n   155\t\n   156\t    rolling_avg_data = [\n   157\t        {\"miner_id\": int(mid), \"rolling_avg\": float(val)}\n   158\t        for mid, val in rolling_avgs.items()\n   159\t    ]\n   160\t\n   161\t    # Resolve miner_id -> miner_uid\n   162\t    moving_averages_data = miner_data_handler.populate_miner_uid_in_miner_data(\n   163\t        rolling_avg_data\n   164\t    )\n   165\t\n   166\t    if moving_averages_data is None:\n   167\t        return None\n   168\t\n   169\t    # Filter out miners with no UID (deregistered)\n   170\t    filtered_moving_averages_data = [\n   171\t        item for item in moving_averages_data if item[\"miner_uid\"] is not None\n   172\t    ]\n   173\t\n   174\t    # Softmax: negative beta means lower score = higher reward\n   175\t    rolling_avg_list = [\n   176\t        r[\"rolling_avg\"] for r in filtered_moving_averages_data\n   177\t    ]\n   178\t    reward_weight_list = compute_softmax(\n   179\t        np.array(rolling_avg_list), comp.softmax_beta\n   180\t    )\n   181\t\n   182\t    rewards = []\n   183\t    for item, reward_weight in zip(\n   184\t        filtered_moving_averages_data, reward_weight_list\n   185\t    ):\n   186\t        if float(reward_weight) > 0:\n   187\t            rewards.append(\n   188\t                {\n   189\t                    \"miner_id\": item[\"miner_id\"],\n   190\t                    \"miner_uid\": item[\"miner_uid\"],\n   191\t                    \"smoothed_score\": item[\"rolling_avg\"],\n   192\t                    \"reward_weight\": float(reward_weight)\n   193\t                    * SMOOTHED_SCORE_COEFFICIENT,\n   194\t                    \"updated_at\": scored_time.isoformat(),\n   195\t                    \"prompt_name\": comp.label,\n   196\t                }\n   197\t            )\n   198\t\n   199\t    return rewards\n   200\t\n   201\t\n   202\tdef print_rewards_df(moving_averages_data: list[dict], label: str = \"\"):\n   203\t    bt.logging.info(f\"Scored responses moving averages {label}\")\n   204\t    df = pd.DataFrame.from_dict(moving_averages_data)\n   205\t    bt.logging.info(df.to_string())\n   206\t\n   207\t\n   208\t@print_execution_time\n   209\tdef combine_moving_averages(\n   210\t    moving_averages_data: dict[str, list[dict]],\n   211\t) -> list[dict]:\n   212\t    \"\"\"Combine reward weights from competitions.\n   213\t\n   214\t    Same miner appearing in multiple competitions gets their weights summed.\n   215\t    \"\"\"\n   216\t    map_miner_reward: dict[int, dict] = {}\n   217\t\n   218\t    for moving_averages in list(moving_averages_data.values()):\n   219\t        for reward in moving_averages:\n   220\t            miner_id = reward[\"miner_id\"]\n   221\t            if miner_id in map_miner_reward:\n   222\t                map_miner_reward[miner_id][\"reward_weight\"] += reward[\n   223\t                    \"reward_weight\"\n   224\t                ]\n   225\t            else:\n   226\t                map_miner_reward[miner_id] = reward\n   227\t\n   228\t    return list(map_miner_reward.values())\n--- ORCHESTRATION DEFS ---\n65:def backtest(\n455:def run_backtest(\n--- ORCH 300-650 ---\n   300\t    # Step 7: concatenate LLM miner scores\n   301\t    if not scores_extensions:\n   302\t        raise RuntimeError(\n   303\t            \"No prediction files matched any scored prompt. \"\n   304\t            \"Check that prediction filenames align with the scored time range.\"\n   305\t        )\n   306\t    new_scores = pd.concat(scores_extensions, ignore_index=True)\n   307\t    print(\n   308\t        f\"{log_prefix} scored {len(new_scores)} prompts in {perf_counter()-t_score:.1f}s\",\n   309\t        flush=True,\n   310\t    )\n   311\t\n   312\t    # Step 8: trim to valid range\n   313\t    new_scores = new_scores.sort_values(\"scored_time\")\n   314\t    valid_scores = new_scores.loc[new_scores[\"crps\"] != -1]\n   315\t    if valid_scores.empty:\n   316\t        raise RuntimeError(\n   317\t            \"All matched predictions resulted in crps=-1 (scoring failures). \"\n   318\t            \"No valid backtest results to report.\"\n   319\t        )\n   320\t    end_backtest_time = valid_scores[\"scored_time\"].max()\n   321\t    new_scores = new_scores.loc[new_scores[\"scored_time\"] <= end_backtest_time]\n   322\t    asset_scores = asset_scores.loc[asset_scores[\"scored_time\"] <= end_backtest_time]\n   323\t\n   324\t    # Optional: simulate the miner registering on a specific date by dropping our\n   325\t    # CRPS rows before that date. synth.validator.prepare_df_for_moving_average\n   326\t    # then sees our miner's first scored_time > global_min and applies the same\n   327\t    # worst-score backfill it gives real late-joining miners — making rank\n   328\t    # comparisons symmetric instead of giving us an unfair \"from-the-start\" boost.\n   329\t    if simulate_registration is not None:\n   330\t        sim_reg = pd.Timestamp(simulate_registration)\n   331\t        new_scores = new_scores.loc[new_scores[\"scored_time\"] >= sim_reg]\n   332\t        if new_scores.empty:\n   333\t            raise RuntimeError(\n   334\t                f\"simulate_registration={sim_reg} drops all of our miner's CRPS rows; \"\n   335\t                f\"no valid backtest results.\"\n   336\t            )\n   337\t    if simulate_deregistration is not None:\n   338\t        sim_dereg = pd.Timestamp(simulate_deregistration)\n   339\t        new_scores = new_scores.loc[new_scores[\"scored_time\"] <= sim_dereg]\n   340\t        if new_scores.empty:\n   341\t            raise RuntimeError(\n   342\t                f\"simulate_deregistration={sim_dereg} drops all of our miner's CRPS rows; \"\n   343\t                f\"no valid backtest results.\"\n   344\t            )\n   345\t\n   346\t    # Step 9: merge LLM scores with all miner scores\n   347\t    all_scores = pd.concat([asset_scores, new_scores], ignore_index=True)\n   348\t    all_scores = all_scores.sort_values([\"scored_time\", \"miner_uid\"])\n   349\t\n   350\t    if rewards_history[\"updated_at\"].max() < all_scores[\"scored_time\"].max():\n   351\t        max_scored_time = all_scores.loc[\n   352\t            all_scores[\"scored_time\"] <= rewards_history[\"updated_at\"].max(),\n   353\t            \"scored_time\",\n   354\t        ].max()\n   355\t        all_scores = all_scores.loc[all_scores[\"scored_time\"] <= max_scored_time].copy()\n   356\t    elif rewards_history[\"updated_at\"].max() > all_scores[\"scored_time\"].max():\n   357\t        max_upd_at = rewards_history.loc[\n   358\t            rewards_history[\"updated_at\"] >= all_scores[\"scored_time\"].max(),\n   359\t            \"updated_at\",\n   360\t        ].min()\n   361\t        rewards_history = rewards_history.loc[\n   362\t            rewards_history[\"updated_at\"] <= max_upd_at\n   363\t        ].copy()\n   364\t\n   365\t    # Step 12: apply prompt score calculation across all scores. We also persist\n   366\t    # percentile90 and lowest_score per group because prepare_df_for_moving_average\n   367\t    # uses them to compute the worst-score backfill for new miners (silently\n   368\t    # skips backfill when those columns are absent).\n   369\t    _stats = all_scores.groupby(\n   370\t        [\"scored_time\", \"asset\", \"time_length\", \"time_increment\"], group_keys=False\n   371\t    )[\"crps\"].apply(_compute_prompt_score_stats_for_group)\n   372\t    all_scores[\"new_prompt_scores\"] = _stats[\"new_prompt_scores\"]\n   373\t    all_scores[\"percentile90\"] = _stats[\"percentile90\"]\n   374\t    all_scores[\"lowest_score\"] = _stats[\"lowest_score\"]\n   375\t\n   376\t    # Step 13: build rewards history entries for LLM miner\n   377\t    new_miner_rewards_list = []\n   378\t    for prompt_name_item in rewards_history[\"prompt_name\"].unique():\n   379\t        new_miner_rewards_prompt = pd.DataFrame(\n   380\t            {\n   381\t                \"updated_at\": rewards_history.loc[\n   382\t                    rewards_history[\"prompt_name\"] == prompt_name_item, \"updated_at\"\n   383\t                ]\n   384\t                .sort_values()\n   385\t                .unique(),\n   386\t                \"miner_uid\": miner_id,\n   387\t                \"prompt_name\": prompt_name_item,\n   388\t            }\n   389\t        )\n   390\t        new_miner_rewards_list.append(new_miner_rewards_prompt)\n   391\t    new_miner_rewards = pd.concat(\n   392\t        new_miner_rewards_list, ignore_index=True\n   393\t    ).sort_values(\"updated_at\")\n   394\t\n   395\t    # Step 14: merge LLM miner rewards into full rewards history\n   396\t    rewards_history = pd.concat(\n   397\t        [\n   398\t            rewards_history,\n   399\t            new_miner_rewards,\n   400\t        ]\n   401\t    ).sort_values([\"updated_at\", \"prompt_name\", \"miner_uid\"])\n   402\t\n   403\t    # Step 15: recalculate smoothed scores including LLM miner\n   404\t    n_rounds = rewards_history[\"updated_at\"].nunique()\n   405\t    t_smooth = perf_counter()\n   406\t    print(\n   407\t        f\"{log_prefix} computing smoothed scores over {n_rounds} reward rounds...\",\n   408\t        flush=True,\n   409\t    )\n   410\t    recalculated_smoothed_scores = calculate_smoothed_scores(\n   411\t        all_scores,\n   412\t        rewards_history,\n   413\t        cutoff_days=competition.window_days,\n   414\t        scores_column=\"new_prompt_scores\",\n   415\t        competition=competition,\n   416\t    )\n   417\t    print(\n   418\t        f\"{log_prefix} smoothed scores done in {perf_counter()-t_smooth:.1f}s \"\n   419\t        f\"(total backtest: {perf_counter()-t_start:.1f}s)\",\n   420\t        flush=True,\n   421\t    )\n   422\t\n   423\t    # Trim the first `competition.window_days` of smoothed_scores when no\n   424\t    # simulate_registration is set. In that case the backfill artifact applies to\n   425\t    # real late-joining miners and inflates our rank — we want to hide it.\n   426\t    # When simulate_registration IS set, the backfill applies to OUR miner and\n   427\t    # the warmup ramp-up is the whole point of the simulation — don't trim it.\n   428\t    if simulate_registration is None:\n   429\t        recalculated_smoothed_scores = _trim_warmup(\n   430\t            recalculated_smoothed_scores,\n   431\t            all_scores,\n   432\t            warmup_days=competition.window_days,\n   433\t        )\n   434\t\n   435\t    miner_smoothed = recalculated_smoothed_scores.loc[\n   436\t        recalculated_smoothed_scores[\"miner_uid\"] == miner_id, \"new_smoothed_score\"\n   437\t    ]\n   438\t    summary: dict[str, Any] = {\n   439\t        \"miner_name\": miner_name,\n   440\t        \"miner_id\": miner_id,\n   441\t        \"num_prompts\": int((new_scores[\"crps\"] != -1).sum()),\n   442\t        \"mean_crps\": float(new_scores.loc[new_scores[\"crps\"] != -1, \"crps\"].mean()),\n   443\t        \"final_smoothed_score\": (\n   444\t            float(miner_smoothed.iloc[-1]) if not miner_smoothed.empty else None\n   445\t        ),\n   446\t    }\n   447\t\n   448\t    return BacktestResult(\n   449\t        miner_name=miner_name,\n   450\t        prompt_df=all_scores,\n   451\t        smoothed_scores=recalculated_smoothed_scores,\n   452\t        summary=summary,\n   453\t    )\n   454\t\n   455\tdef run_backtest(\n   456\t    miner_name: str,\n   457\t    competition: CompetitionConfig,\n   458\t    n_backtest_days: int,\n   459\t    predictions_dir: Path | None = None,\n   460\t    miner_id: int = 999,\n   461\t    scoring_executor: ProcessPoolExecutor | None = None,\n   462\t    eval_end: datetime | None = None,\n   463\t    simulate_registration: datetime | None = None,\n   464\t    simulate_deregistration: datetime | None = None,\n   465\t) -> tuple[list[BacktestResult], pd.DataFrame]:\n   466\t    \"\"\"Run the full backtest for all assets in a prompt config.\n   467\t\n   468\t    For each asset: runs backtest, prints rank summary, saves per-asset rank chart.\n   469\t    After all assets: saves total rank evolution chart + estimated earnings chart\n   470\t    when ≥2 assets succeed.\n   471\t\n   472\t    Returns (results, combined) where:\n   473\t      - results: list of successful BacktestResult (one per asset)\n   474\t      - combined: per-profile combined smoothed-scores DataFrame (empty when <2 assets)\n   475\t    \"\"\"\n   476\t    _maybe_warn_hf_crps_formula_change(\n   477\t        competition=competition,\n   478\t        n_backtest_days=n_backtest_days,\n   479\t        eval_end=eval_end,\n   480\t        simulate_registration=simulate_registration,\n   481\t        simulate_deregistration=simulate_deregistration,\n   482\t    )\n   483\t    _maybe_warn_competition_split(\n   484\t        competition=competition,\n   485\t        n_backtest_days=n_backtest_days,\n   486\t        eval_end=eval_end,\n   487\t        simulate_registration=simulate_registration,\n   488\t        simulate_deregistration=simulate_deregistration,\n   489\t    )\n   490\t\n   491\t    assets = competition.asset_list\n   492\t    max_workers = min(len(assets), 6)\n   493\t    print(f\"  Dispatching {len(assets)} assets to {max_workers} backtest workers...\")\n   494\t\n   495\t    # Phase 1: run backtest() for each asset in parallel (I/O-bound: API calls + disk)\n   496\t    asset_results: dict[str, BacktestResult] = {}\n   497\t    with ThreadPoolExecutor(max_workers=max_workers) as executor:\n   498\t        futures = {\n   499\t            executor.submit(\n   500\t                backtest,\n   501\t                miner_name=miner_name,\n   502\t                asset=asset,\n   503\t                time_length=competition.time_length,\n   504\t                time_increment=competition.time_increment,\n   505\t                n_backtest_days=n_backtest_days,\n   506\t                miner_id=miner_id,\n   507\t                predictions_dir=predictions_dir,\n   508\t                scoring_intervals=competition.scoring_intervals,\n   509\t                competition=competition,\n   510\t                scoring_executor=scoring_executor,\n   511\t                eval_end=eval_end,\n   512\t                simulate_registration=simulate_registration,\n   513\t                simulate_deregistration=simulate_deregistration,\n   514\t            ): asset\n   515\t            for asset in assets\n   516\t        }\n   517\t        for future in as_completed(futures):\n   518\t            asset = futures[future]\n   519\t            try:\n   520\t                asset_results[asset] = future.result()\n   521\t            except NoScoresAvailable as e:\n   522\t                # Not a failure — the validator isn't prompting this asset here.\n   523\t                print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n   524\t                print(f\"  SKIPPED: {e}\")\n   525\t            except Exception as e:\n   526\t                print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n   527\t                print(f\"  FAILED: {e}\")\n   528\t\n   529\t    # Phase 2: print summaries + plot charts sequentially (matplotlib is not thread-safe)\n   530\t    results: list[BacktestResult] = []\n   531\t    for asset in assets:\n   532\t        if asset not in asset_results:\n   533\t            continue\n   534\t        result = asset_results[asset]\n   535\t        results.append(result)\n   536\t        summary = result.summary\n   537\t\n   538\t        print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n   539\t        ss = result.smoothed_scores.copy()\n   540\t        if not ss.empty:\n   541\t            last_ts = ss[\"updated_at\"].max()\n   542\t            last_slice = ss.loc[ss[\"updated_at\"] == last_ts]\n   543\t            total_miners = len(last_slice)\n   544\t            miner_rw = last_slice.loc[last_slice[\"miner_uid\"] == miner_id]\n   545\t            if not miner_rw.empty:\n   546\t                rank = int(\n   547\t                    last_slice[\"reward_weight\"]\n   548\t                    .rank(ascending=False, method=\"min\")\n   549\t                    .loc[miner_rw.index[0]]\n   550\t                )\n   551\t                rw = float(miner_rw[\"reward_weight\"].iloc[0])\n   552\t                sm = float(summary.get(\"final_smoothed_score\", 0) or 0)\n   553\t                print(\n   554\t                    f\"  rank: {rank}/{total_miners}  reward_weight: {rw:.6f}  smoothed_score: {sm:.2f}\"\n   555\t                )\n   556\t            else:\n   557\t                print(f\"  Miner {miner_id} not found in final smoothed scores.\")\n   558\t        else:\n   559\t            print(f\"  No smoothed scores computed.\")\n   560\t\n   561\t        print(\n   562\t            f\"  Prompts scored: {summary['num_prompts']}  Mean CRPS: {summary['mean_crps']:.6f}\"\n   563\t        )\n   564\t\n   565\t        try:\n   566\t            chart_path = plot_rank_evolution(result)\n   567\t            print(f\"  Rank chart saved to: {chart_path}\")\n   568\t        except (RuntimeError, Exception) as e:\n   569\t            print(f\"  Chart generation failed: {e}\")\n   570\t\n   571\t        try:\n   572\t            crps_chart = plot_crps_over_time(result)\n   573\t            print(f\"  CRPS chart saved to: {crps_chart}\")\n   574\t        except (RuntimeError, Exception) as e:\n   575\t            print(f\"  CRPS chart generation failed: {e}\")\n   576\t\n   577\t        for plot_fn, chart_name in [\n   578\t            (plot_crps_by_hour, \"CRPS-by-hour\"),\n   579\t            (plot_crps_by_day, \"CRPS-by-day\"),\n   580\t            (plot_crps_ratio_distribution, \"CRPS-ratio-dist\"),\n   581\t            (plot_weekly_percentile, \"Weekly-percentile\"),\n   582\t        ]:\n   583\t            try:\n   584\t                path = plot_fn(result)\n   585\t                print(f\"  {chart_name} chart saved to: {path}\")\n   586\t            except (RuntimeError, Exception) as e:\n   587\t                print(f\"  {chart_name} chart generation failed: {e}\")\n   588\t\n   589\t    # Cross-asset charts: compute combined smoothed scores once, share across both charts.\n   590\t    combined = pd.DataFrame(columns=_COMBINED_EMPTY_COLS)\n   591\t    if len(results) >= 2:\n   592\t        try:\n   593\t            combined = compute_combined_smoothed_scores(\n   594\t                results,\n   595\t                competition,\n   596\t                simulate_registration=simulate_registration,\n   597\t            )\n   598\t        except Exception as e:\n   599\t            print(f\"  Combined smoothed scores failed: {e}\")\n   600\t\n   601\t        if not combined.empty:\n   602\t            try:\n   603\t                total_chart = plot_total_rank_evolution(\n   604\t                    results,\n   605\t                    combined=combined,\n   606\t                    profile_label=slug_for(competition),\n   607\t                )\n   608\t                print(f\"  Total rank chart saved to: {total_chart}\")\n   609\t            except Exception as e:\n   610\t                print(f\"  Total rank chart failed: {e}\")\n   611\t\n   612\t            try:\n   613\t                earnings_chart = plot_estimated_earnings(\n   614\t                    results,\n   615\t                    competition=competition,\n   616\t                    combined=combined,\n   617\t                )\n   618\t                print(f\"  Earnings chart saved to: {earnings_chart}\")\n   619\t            except Exception as e:\n   620\t                print(f\"  Earnings chart failed: {e}\")\n   621\t\n   622\t    return results, combined\n--- TYPES ---\n.venv/lib/python3.12/site-packages/synth_lib/backtester/result.py:11:class NoScoresAvailable(RuntimeError):\n.venv/lib/python3.12/site-packages/synth_lib/backtester/result.py:18:@dataclass\n.venv/lib/python3.12/site-packages/synth_lib/backtester/result.py:19:class BacktestResult:\n.venv/lib/python3.12/site-packages/synth_lib/backtester/result.py:23:    summary: dict[str, Any]\n.venv/lib/python3.12/site-packages/synth_lib/backtester/miner_data_handler.py:11:class _BacktestMinerDataHandler(MinerDataHandler):\n.venv/lib/python3.12/site-packages/synth_lib/backtester/orchestration.py:438:    summary: dict[str, Any] = {\n","exit_code":0,"status":"completed"}}
