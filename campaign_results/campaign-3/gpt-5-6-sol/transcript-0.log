           print(f\"  Total rank chart saved to: {total_chart}\")\n   609\t            except Exception as e:\n   610\t                print(f\"  Total rank chart failed: {e}\")\n   611\t\n   612\t            try:\n   613\t                earnings_chart = plot_estimated_earnings(\n   614\t                    results,\n   615\t                    competition=competition,\n   616\t                    combined=combined,\n   617\t                )\n   618\t                print(f\"  Earnings chart saved to: {earnings_chart}\")\n   619\t            except Exception as e:\n   620\t                print(f\"  Earnings chart failed: {e}\")\n   621\t\n   622\t    return results, combined\n--- RESULT ---\n\"\"\"Backtest result type and the skip signal for assets with no scores.\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom typing import Any\n\nimport pandas as pd\n\n\nclass NoScoresAvailable(RuntimeError):\n    \"\"\"An asset has no scored prompts in the window — a skip, not a failure.\n\n    Distinct type so run_backtest can tell it apart from a genuine break.\n    \"\"\"\n\n\n@dataclass\nclass BacktestResult:\n    miner_name: str\n    prompt_df: pd.DataFrame\n    smoothed_scores: pd.DataFrame\n    summary: dict[str, Any]\n--- COMBINED ---\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-112-            result_rows.append(\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-113-                {\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-114-                    \"updated_at\": pd.Timestamp(r[\"updated_at\"]),\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-115-                    \"miner_uid\": r[\"miner_uid\"],\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-116-                    \"new_smoothed_score\": r[\"smoothed_score\"],\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-117-                    \"reward_weight\":