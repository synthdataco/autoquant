{"type":"item.started","item":{"id":"item_40","type":"command_execution","command":"/bin/bash -c \"uv run python - <<'PY'\nfrom pathlib import Path\nimport numpy as np, pandas as pd\nROOT=Path('market_data/prices')\ndef load(asset,start,end):\n    frames=[]\n    for day in pd.date_range(pd.Timestamp(start).floor('D'),pd.Timestamp(end).floor('D'),freq='D',tz='UTC'):\n        p=ROOT/asset/'1m'/f'date={day.date()}.parquet'\n        if p.exists(): frames.append(pd.read_parquet(p,columns=['timestamp','close']))\n    df=pd.concat(frames).sort_values('timestamp').drop_duplicates('timestamp').set_index('timestamp')\n    return df.loc[pd.Timestamp(start):pd.Timestamp(end),'close'].astype(float)\nfor asset in ['BTC','ETH','SOL','XRP','HYPE']:\n  close=load(asset,'2026-07-25','2026-08-29')\n  logp=np.log(close)\n  r=logp.diff().where(close.notna() & close.shift().notna())\n  print('\\\\n',asset)\n  for a,b in [('2026-08-05','2026-08-07'),('2026-08-26','2026-08-28')]:\n    vals={k:[] for k in ['7d','hl60','hl360','hl1440','blend']}\n    for t in pd.date_range(a,pd.Timestamp(b,tz='UTC')-pd.Timedelta(hours=1),freq='1h',tz='UTC'):\n      hist=r.loc[:t].iloc[-10080:].dropna()\n      future=r.loc[t+pd.Timedelta(minutes=1):t+pd.Timedelta(hours=24)].dropna()\n      if len(hist)<1000 or len(future)<100: continue\n      realized=np.sqrt(np.mean(future.values**2))\n      estimates={\n       '7d':np.std(hist.values),\n       'hl60':np.sqrt((hist.pow(2).ewm(halflife=60,adjust=False).mean()).iloc[-1]),\n       'hl360':np.sqrt((hist.pow(2).ewm(halflife=360,adjust=False).mean()).iloc[-1]),\n       'hl1440':np.sqrt((hist.pow(2).ewm(halflife=1440,adjust=False).mean()).iloc[-1]),\n      }\n      estimates['blend']=np.sqrt(.2*estimates['hl60']**2+.5*estimates['hl360']**2+.3*estimates['hl1440']**2)\n      for k,v in estimates.items(): vals[k].append(realized/v)\n    print(a, {k:(round(float(np.median(v)),3),round(float(np.mean(v)),3)) for k,v in vals.items()})\nPY\nprintf '%s\\\\n' '--- FIELD CRPS ---'\nuv run python - <<'PY'\nimport pandas as pd\nfrom pathlib import Path\nfor fmt in ['crypto-24h','crypto-1h']:\n df=pd.read_parquet(Path('market_data/offline_data')/f'miner_scores_BTC_{fmt}.parquet')\n for a,b in [('2026-08-05','2026-08-07'),('2026-08-26','2026-08-29')]:\n  x=df[(df.start_time>=a)&(df.start_time<b)]\n  g=x.groupby('start_time').crps\n  print(fmt,a,'rows',len(x),'prompt mean min/median/p10',g.min().mean(),g.median().mean(),g.quantile(.1).mean())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
