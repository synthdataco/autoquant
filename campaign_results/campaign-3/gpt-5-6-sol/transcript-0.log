.DataFrame()\n   128\t    if df.empty:\n   129\t        return df\n   130\t    df[\"scored_time\"] = pd.to_datetime(df[\"scored_time\"], utc=True)\n   131\t    df = df.drop_duplicates(subset=[\"miner_uid\", \"scored_time\", \"asset\", \"time_length\"])\n   132\t    df[\"time_increment\"] = time_increment\n   133\t    # API does not return start_time. Approximate as scored_time - time_length.\n   134\t    # The real start_time is a few minutes earlier (scoring delay), but this is\n   135\t    # close enough — _find_prediction_file does closest-match on the filename.\n   136\t    df[\"start_time\"] = df[\"scored_time\"] - pd.Timedelta(seconds=time_length)\n   137\t    return df\n   138\t\n   139\t\n   140\tdef get_rewards_history(\n   141\t    start_time: datetime,\n   142\t    end_time: datetime,\n   143\t    prompt_name: str | None = None,\n   144\t) -> pd.DataFrame:\n   145\t    \"\"\"GET https://api.synthdata.co/rewards/scores.\n   120\t    if simulate_registration is not None:\n   121\t        window_start = pd.Timestamp(simulate_registration).to_pydatetime() - timedelta(\n   122\t            days=competition.window_days\n   123\t        )\n   124\t    else:\n   125\t        window_start = anchor - timedelta(days=n_backtest_days)\n   126\t    query_start = max(\n   127\t        pred_start - timedelta(minutes=PREDICTION_MATCH_TOLERANCE_MINUTES),\n   128\t        window_start,\n   129\t    )\n   130\t    query_end = pred_end + timedelta(seconds=time_length) + timedelta(hours=1)\n   131\t\n   132\t    # Step 2: fetch existing miner scores\n   133\t    asset_backtest = asset\n   134\t    time_length_backtest = time_length\n   135\t    prompt_label = slug_for(competition)\n   136\t    log_prefix = f\"  [{prompt_label}/{asset_backtest}]\"\n   137\t    t_start = perf_counter()\n   138\t\n   139\t    print(\n   140\t        f\"{log_prefix} fetching scored prompts ({query_start.date()} → {min(query_end, anchor).date()})...\",\n   141\t        flush=True,\n   142\t    )\n 