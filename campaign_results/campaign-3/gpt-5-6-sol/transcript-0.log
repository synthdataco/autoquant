ner_id,\n   258\t        \"scored_time\": scored_time,\n   259\t        \"crps\": float(total_crps),\n   260\t        \"asset\": asset_val,\n   261\t        \"start_time\": start_time,\n   262\t        \"time_increment\": time_incr,\n   263\t        \"time_length\": time_len,\n   264\t        \"miner_id\": miner_id,\n   265\t    }\n   266\t\n   267\t\n   268\tdef _trim_warmup(\n   269\t    smoothed_scores: pd.DataFrame,\n   270\t    scored: pd.DataFrame,\n   271\t    warmup_days: int = _LEGACY_FALLBACK_WINDOW_DAYS,\n   272\t    warmup_anchor: datetime | None = None,\n   273\t) -> pd.DataFrame:\n   274\t    \"\"\"Drop smoothed_scores rows whose `updated_at` is in the first `warmup_days`\n   275\t    after `warmup_anchor` (or after `scored[\"scored_time\"].min()` if no anchor).\n   276\t\n   277\t    During that window the moving average is dominated by synth's new-miner\n   278\t    worst-score backfill, so ranks are not directly comparable.\n   279\t    No-op if trimming would leave the frame empty (short-window backtests / tests).\n   280\t    \"\"\"\n   281\t    if smoothed_scores.empty or scored.empty:\n   282\t        return smoothed_scores\n   283\t    anchor = (\n   284\t        pd.Timestamp(warmup_anchor)\n   285\t        if warmup_anchor is not None\n   286\t        else pd.Timestamp(scored[\"scored_time\"].min())\n   287\t    )\n   288\t    warmup_end = anchor + pd.Timedelta(days=warmup_days)\n   289\t    trimmed = smoothed_scores.loc[smoothed_scores[\"updated_at\"] >= warmup_end]\n   290\t    if trimmed.empty:\n   267\tdef load_prediction(path: Path) -> dict:\n   268\t    \"\"\"\n   269\t\n   270\t    Handles:\n   271\t      - ArtifactManager format: {\"simulation_input\": {...}, \"prediction\": [meta, meta, path, ...]}\n   272\t      - Notebook flat format:   {\"start_timestamp\": int, \"paths\": [...], ...}\n   273\t\n   274\t    Always returns dict with keys: paths, num_simulations, num_steps, asset,\n   275\t    time_increment, time_length.\n   276\t    \"\"\"\n   277\t    raw = json.loads(path.read_text())\n   278\t    if \"simulation_input\" in raw:\n   279\t        sim = raw[\"simulation_input\"]\n   280\t        return {\n   281\t            \"start_timestamp\": int(\n   282\t                datetime.fromisoformat(sim[\"start_time\"]).timestamp()\n   283\t            ),\n   284\t            \"asset\": sim[\"asset\"],\n   285\t            \"time_increment\": sim[\"time_increment\"],\n   286\t            \"time_length\": sim[\"time_length\"],\n   287\t            \"num_simulations\": sim[\"num_simulations\"],\n   288\t            \"num_steps\": sim[\"time_length\"] // sim[\"time_increment\"],\n   289\t            \"paths\": raw[\"prediction\"][2:],  # skip two metadata entries\n   290\t        }\n   291\t    return raw\n   292\t\n   293\t\n   294\tdef _price_store(asset: str) -> MinutePriceStore:\n   295\t    \"\"\"Return a MinutePriceStore configured for the asset's upstream provider.\n   296\t\n   297\t    Provider routing (Binance / Hyperliquid / Pyth) mirrors the validator via\n   298\t    build_price_client.\n   299\t    \"\"\"\n   300\t    return MinutePriceStore(asset, client=build_price_client(asset))\n   301\t\n   302\t\n   303\tdef download_price_data(\n   304\t    start_time: datetime,\n   305\t    end_time: datetime,\n   306\t    asset: str,\n   307\t    freq: str = \"1min\",\n   308\t) -> pd.DataFrame:\n   309\t    \"\"\"Returns DataFrame with DatetimeIndex (UTC) and a 'close' column at freq resolution.\n   310\t\n   311\t    Uses MinutePriceStore for routing (Pyth vs Hyperliquid) and on-demand\n   312\t    ingestion. Reads parquets directly for NaN-tolerance — futures assets like\n   313\t    WTIOIL have legitimate market-closure gaps, and downstream scoring already\n   314\t    filters NaN per-prompt.\n   315\t    \"\"\"\n   316\t    store = _price_store(asset)\n   317\t    frames: list[pd.DataFrame] = []\n   318\t    cursor = start_time.date()\n   319\t    missing: list = []\n   320\t    while cursor <= end_time.date():\n   321\t        path = store.day_path(cursor)\n   322\t        if path.exists():\n   323\t            frames.append(pd.read_parquet(path))\n   324\t        else:\n   325\t            missing.append(cursor)\n   326\t        cursor += timedelta(days=1)\n   327\t\n   328\t    if missing:\n   329\t        store.ingest_range(missing[0], missing[-1], verbose=False)\n   330\t        for day in missing:\n   331\t            frames.append(pd.read_parquet(store.day_path(day)))\n   332\t\n   333\t    frame = pd.concat(frames, ignore_index=True)\n   334\t    frame[\"timestamp\"] = pd.to_datetime(frame[\"timestamp\"], utc=True)\n   335\t    frame = (\n   336\t        frame.sort_values(\"timestamp\")\n   337\t        .drop_duplicates(\"timestamp\")\n   338\t        .set_index(\"timestamp\")\n   339\t    )\n   340\t    return frame[[\"close\"]].loc[start_time:end_time].resample(freq).last()\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py-106-\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py-107-def _parse_prediction_filename_time(path: Path) -> datetime | None:\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py-108-    \"\"\"Extract start_time from a prediction filename like 2026-03-23_00:01:00Z_BTC_86400.json.\"\"\"\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py-109-    parts = path.stem.split(\"_\")\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py-110-    if len(parts) < 4:\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py-111-        return None\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py-112-    time_str = f\"{parts[0]}_{parts[1]}\"\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py-113-    return datetime.strptime(time_str, \"%Y-%m-%d_%H:%M:%SZ\").replace(tzinfo=UTC)\n.venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py-114-\n.venv/lib/python3.12/s