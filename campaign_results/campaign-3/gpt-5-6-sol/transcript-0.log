d_at\",\n   216\t            ].min()\n   217\t            rewards_history = rewards_history.loc[\n   218\t                rewards_history[\"updated_at\"] <= max_upd_at\n   219\t            ].copy()\n   220\t\n   221\t    # Step 5: download asset price data\n   222\t    asset_prices: dict[str, pd.DataFrame] = {}\n   223\t    for asset_ in asset_scores[\"asset\"].unique():\n   224\t        st_ = asset_scores[\"start_time\"].min() - pd.Timedelta(hours=2)\n   225\t        en_ = asset_scores[\"start_time\"].max() + pd.Timedelta(hours=26)\n   226\t        asset_prices[asset_] = download_price_data(st_, en_, asset_, freq=\"1min\")\n   227\t\n   228\t    # Step 6: score LLM miner predictions\n   229\t    start_times = asset_scores[\"start_time\"].sort_values().unique()\n   230\t    t_score = perf_counter()\n   231\t    print(\n   232\t        f\"{log_prefix} scoring {len(start_times)} prompts against local predictions...\",\n   233\t        flush=True,\n   234\t    )\n   235\t\n   236\t    # Pre-build work items: resolve file paths and slice prices upfront\n   237\t    prompts: list[dict[str, Any]] = []\n   238\t\n   239\t    for start_time in start_times:\n   240\t        scores_subset = asset_scores.loc[\n   241\t            asset_scores[\"start_time\"] == start_time\n   242\t        ].copy()\n   243\t\n   244\t        for _, asset_val, scored_time, time_len, time_incr in (\n   245\t            scores_subset[[\"asset\", \"scored_time\", \"time_length\", \"time_increment\"]]\n   246\t            .drop_duplicates()\n   247\t            .itertuples()\n   248\t        ):\n   249\t            file_path = _find_prediction_file(\n   250\t                prediction_files, start_time, asset_val, time_len\n   251\t            )\n   252\t\n   253\t            # Pre-slice real prices in the main process (avoids pickling DataFrames)\n   254\t            real_prices: list[float] = []\n   255\t            if file_path is not None:\n   256\t                real_prices = _slice_real_prices(\n   257\t                    asset_prices[asset_val], start_time, time_len, time_incr\n   258\t                )\n   259\t\n   260\t            prompts.append(\n   261\t                {\n   262\t                    \"file_path\": file_path,\n   263\t                    \"start_time\": start_time,\n   264\t                    \"asset\": asset_val,\n   265\t                    \"scored_time\": scored_time,\n   266\t                    \"time_length\": time_len,\n   267\t                    \"time_increment\": time_incr,\n   268\t                    \"real_prices\": real_prices,\n   269\t                }\n   270\t            )\n   271\t\n   272\t    _fill_gaps_from_realized_paths(prompts, log_prefix)\n   273\t\n   274\t    work_items = [\n   275\t        (\n   276\t            prompt[\"file_path\"],\n   277\t            prompt[\"start_time\"],\n   278\t            prompt[\"asset\"],\n   279\t            prompt[\"scored_time\"],\n   280\t            prompt[\"time_length\"],\n   281\t            prompt[\"time_increment\"],\n   282\t            prompt[\"real_prices\"],\n   283\t            scoring_intervals,\n   284\t            miner_id,\n   285\t        )\n   286\t        for prompt in prompts\n   287\t    ]\n   288\t\n   289\t    # Dispatch scoring — parallel if executor provided, else sequential\n   290\t    if scoring_executor is not None:\n   291\t        futures = [\n   292\t            scoring_executor.submit(_score_single_prompt, *item) for item in work_items\n   293\t        ]\n   294\t        raw_results = [f.result() for f in futures]\n   295\t    else:\n   296\t        raw_results = [_score_single_prompt(*item) for item in work_items]\n   297\t\n   298\t    scores_extensions = [pd.DataFrame(r, index=[0]) for r in raw_results]\n   299\t\n   300\t    # Step 7: concatenate LLM miner scores\n   301\t    if not scores_extensions:\n   302\t        raise RuntimeError(\n   303\t            \"No prediction files matched any scored prompt. \"\n   304\t            \"Check that prediction filenames align with the scored time range.\"\n   305\t        )\n   306\t    new_scores = pd.concat(scores_extensions, ignore_index=True)\n   307\t    print(\n   308\t        f\"{log_prefix} scored {len(new_scores)} prompts in {perf_counter()-t_score:.1f}s\",\n   309\t        flush=True,\n   310\t    )\n   311\t\n   312\t    # Step 8: trim to valid range\n   313\t    new_scores = new_scores.sort_values(\"scored_time\")\n   314\t    valid_scores = new_scores.loc[new_scores[\"crps\"] != -1]\n   315\t    if valid_scores.empty:\n   316\t        raise RuntimeError(\n   317\t            \"All matched predictions resulted in crps=-1 (scoring failures). \"\n   318\t            \"No valid backtest results to report.\"\n   319\t        )\n   320\t    end_backtest_time = valid_scores[\"scored_time\"].max()\n   321\t    new_scores = new_scores.loc[new_scores[\"scored_time\"] <= end_backtest_time]\n   322\t    asset_scores = asset_scores.loc[asset_scores[\"scored_time\"] <= end_backtest_time]\n   323\t\n   324\t    # Optional: simulate the miner registering on a specific date by dropping our\n   325\t    # CRPS rows before that date. synth.validator.prepare_df_for_moving_average\n   326\t    # then sees our miner's first scored_time > global_min and applies the same\n   327\t    # worst-score backfill it gives real late-joining miners — making rank\n   328\t    # comparisons symmetric instead of giving us an unfair \"from-the-start\" boost.\n   329\t    if simulate_registration is not None:\n   330\t        sim_reg = pd.Timestamp(simulate_registration)\n--- SCORE SINGLE ---\n     1\t\"\"\"CRPS scoring and the validator's smoothed-score / reward-weight replay.\"\"\"\n     2\t\n     3\tfrom __future__ import annotations\n     4\t\n     5\tfrom datetime import datetime, timedelta\n     6\tfrom pathlib import Path\n     7\tfrom typing import Any\n     8\t\n     9\timport numpy as np\n    10\timport pandas as pd\n    11\t\n    12\tfrom synth.validator.competition_config import (\n    13\t    ALL_COMPETITIONS,\n    14\t    CRYPTO_24H,\n    15\t    SMOOTHED_SCORE_COEFFICIENT,\n    16\t    CompetitionConfig,\n    17\t)\n    18\tfrom synth.validator.crps_calculation import calculate_crps_for_miner\n    19\tfrom synth.validator.moving_average import (\n    20\t    compute_smoothed_score,\n    21\t    prepare_df_for_moving_average,\n    22\t)\n    23\tfrom synth.validator.reward import compute_prompt_scores\n    24\t\n    25\tfrom synth_lib.backtester.config import (\n    26\t    _COMBINED_EMPTY_COLS,\n    27\t    _LEGACY_FALLBACK_WINDOW_DAYS,\n    28\t    UTC,\n    29\t    competition_for,\n    30\t    slug_for,\n    31\t)\n    32\tfrom synth_lib.backtester.loading import load_prediction\n    33\tfrom synth_lib.backtester.miner_data_handler import _BACKTEST_MDH\n    34\tfrom synth_lib.backtester.result import BacktestResult\n    35\t\n    36\t\n    37\t\n    38\tdef _compute_prompt_scores_for_group(crps: pd.Series) -> pd.Series:\n    39\t    \"\"\"Wrapper around synth's compute_prompt_scores for use in groupby.apply.\"\"\"\n    40\t    result = compute_prompt_scores(crps.values)\n    41\t    if result[0] is None:\n    42\t        return pd.Series(0.0, index=crps.index)\n    43\t    return pd.Series(result[0], index=crps.index)\n    44\t\n    45\t\n    46\tdef _compute_prompt_score_stats_for_group(crps: pd.Series) -> pd.DataFrame:\n    47\t    \"\"\"Like _compute_prompt_scores_for_group but also returns percentile90 and\n    48\t    lowest_score so synth.prepare_df_for_moving_average can apply its worst-score\n    49\t    backfill rule to new miners.\n    50\t    \"\"\"\n    51\t    capped, p90, low = compute_prompt_scores(crps.values)\n    52\t    n = len(crps)\n    53\t    if capped is None:\n    54\t        return pd.DataFrame(\n    55\t            {\n    56\t                \"new_prompt_scores\": [0.0] * n,\n    57\t                \"percentile90\": [0.0] * n,\n    58\t                \"lowest_score\": [0.0] * n,\n    59\t            },\n    60\t            index=crps.index,\n    61\t        )\n    62\t    return pd.DataFrame(\n    63\t        {\n    64\t            \"new_prompt_scores\": capped,\n    65\t            \"percentile90\": [float(p90)] * n,\n    66\t            \"lowest_score\": [float(low)] * n,\n    67\t        },\n    68\t        index=crps.index,\n    69\t    )\n    70\t\n    71\tdef calculate_smoothed_scores(\n    72\t    all_scores: pd.DataFrame,\n    73\t    rewards_history: pd.DataFrame,\n    74\t    cutoff_days: int = 10,\n    75\t    scores_column: str = \"new_prompt_scores\",\n    76\t    competition: CompetitionConfig = CRYPTO_24H,\n    77\t) -> pd.DataFrame:\n    78\t    \"\"\"Compute smoothed scores and reward weights using synth's compute_smoothed_score.\n    79\t\n    80\t    Delegates to synth.validator.moving_average.compute_smoothed_score for each\n    81\t    rewards_history timestamp, using a fake MinerDataHandler (miner_uid == miner_id).\n    82\t\n    83\t    Returns DataFrame with columns: updated_at, miner_uid, new_smoothed_score, reward_weight.\n    84\t    \"\"\"\n    85\t    # Adapt column names to what synth expects: miner_id, prompt_score_v3\n    86\t    input_df = all_scores.copy()\n    87\t    # Use miner_uid as miner_id for synth; drop any existing miner_id to avoid duplication\n    88\t    if \"miner_id\" in input_df.columns:\n    89\t        input_df = input_df.drop(columns=[\"miner_id\"])\n    90\t    input_df = input_df.rename(\n    91\t        columns={\"miner_uid\": \"miner_id\", scores_column: \"prompt_score_v3\"}\n    92\t    )\n    93\t    input_df[\"scored_time\"] = pd.to_datetime(input_df[\"scored_time\"])\n    94\t\n    95\t    # Prepare the df (backfill new miners, etc.)\n    96\t    prepared = prepare_df_for_moving_average(input_df)\n    97\t\n    98\t    result_rows = []\n    99\t    for updated_at in rewards_history[\"updated_at\"].sort_values().unique():\n   100\t        cutoff = updated_at - pd.Timedelta(days=cutoff_days)\n   101\t        window_df = prepared.loc[\n   102\t            (prepared[\"scored_time\"] >= cutoff)\n   103\t            & (prepared[\"scored_time\"] <= updated_at)\n   104\t        ]\n   105\t        rewards = compute_smoothed_score(\n   106\t            _BACKTEST_MDH, window_df, updated_at, competition\n   107\t        )\n   108\t        if rewards is None:\n   109\t            continue\n   110\t\n   111\t        for r in rewards:\n   112\t            result_rows.append(\n   113\t                {\n   114\t                    \"updated_at\": pd.Timestamp(r[\"updated_at\"]),\n   115\t                    \"miner_uid\": r[\"miner_uid\"],\n   116\t                    \"new_smoothed_score\": r[\"smoothed_score\"],\n   117\t                    \"reward_weight\": r[\"reward_weight\"],\n   118\t                }\n   119\t            )\n   120\t\n   121\t    return pd.DataFrame(result_rows)\n   122\t\n   123\t\n   124\tdef compute_combined_smoothed_scores(\n   125\t    results: list[BacktestResult],\n","exit_code":0,"status":"completed"}}
