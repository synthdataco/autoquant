{"type":"item.started","item":{"id":"item_110","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nfrom datetime import datetime,timezone\nfrom pathlib import Path\nfrom synth.validator.competition_config import CRYPTO_24H,COM_EQU_24H,CRYPTO_1H\nfrom synth_lib.backtester.orchestration import run_backtest\nfor comp,days,end in [(CRYPTO_24H,10,datetime(2026,8,29,tzinfo=timezone.utc)),(COM_EQU_24H,10,datetime(2026,8,29,tzinfo=timezone.utc)),(CRYPTO_1H,5,datetime(2026,8,28,tzinfo=timezone.utc))]:\n _,c=run_backtest('campaign',comp,days,predictions_dir=Path('miner_outputs/campaign/predictions'),eval_end=end)\n t=c.updated_at.max(); s=c[c.updated_at==t].copy(); s['rank']=s.reward_weight.rank(ascending=False,method='min')\n print('FULL_PROFILE_FINAL',comp.label,s[s.miner_uid==999].to_dict('records'))\n print('FULL_PROFILE_TOP',comp.label,s.sort_values('reward_weight',ascending=False).head(1).to_dict('records'))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
