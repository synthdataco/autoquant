{"type":"item.started","item":{"id":"item_153","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nfrom dataclasses import replace\nfrom datetime import datetime, timezone\nfrom pathlib import Path\nfrom synth_lib.backtester.orchestration import ALL_COMPETITIONS, run_backtest\nc = next(c for c in ALL_COMPETITIONS if c.label == 'Commodities/Equities 24h')\nc = replace(c, asset_list=[a for a in c.asset_list if a \"'!= '\"'SPYX'])\nresults, combined = run_backtest('campaign', c, 10, Path('miner_outputs/campaign/predictions'), eval_end=datetime(2026,8,29,tzinfo=timezone.utc))\nlast = combined[combined.updated_at == combined.updated_at.max()]\nrow = last[last.miner_uid == 999].iloc[0]\nrank = int((last.reward_weight > row.reward_weight).sum()+1)\nprint(f'FINAL competition=com-equ-24h rank={rank}/{len(last)} reward={row.reward_weight:.12g} leader={last.reward_weight.max():.12g} score={row.new_smoothed_score:.12g}')\nprint('MEANS', {r.asset: r.summary['mean_crps'] for r in results})\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
