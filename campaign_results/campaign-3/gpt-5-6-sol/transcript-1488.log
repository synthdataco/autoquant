{"type":"item.started","item":{"id":"item_92","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nfrom pathlib import Path\nimport pandas as pd, numpy as np\nassets=['BTC','ETH','SOL','XRP','HYPE','XAU','NVDAX','GOOGLX','TSLAX','AAPLX','WTIOIL','SPCX','SP500']\nrows=[]; med={}\nfor a in assets:\n fs=sorted(Path('market_data/prices',a,'1m').glob('date=*.parquet'))\n vals=[]\n for f in fs:\n  d=f.stem.split('=')[1]; x=pd.read_parquet(f,columns=['close']).close.to_numpy(float)\n  r=np.log(x[5:])-np.log(x[:-5]); rv=np.nanmean(r*r)\n  if np.isfinite(rv) and rv>0: vals.append((pd.Timestamp(d),rv))\n s=pd.Series(dict(vals)).sort_index(); train=s[s.index<=pd.Timestamp('2026-07-26')]; med[a]=float(np.median(train))\n for i in range(7,len(s)):\n  dt=s.index[i]\n  if not all((s.index[i]-s.index[i-j]).days==j for j in range(1,8)): continue\n  base=med[a]; past=s.iloc[i-7:i]\n  rows.append((a,dt,np.log(s.iloc[i]/base),np.log(past.iloc[-1]/base),np.log(past.iloc[-3:].mean()/base),np.log(past.mean()/base)))\ndf=pd.DataFrame(rows,columns=['a','date','y','d','w','m'])\ntr=df[df.date<=pd.Timestamp('2026-07-26')]; va=df[(df.date>=pd.Timestamp('2026-07-27')) & (df.date<=pd.Timestamp('2026-08-29'))]\nX=np.c_[np.ones(len(tr)),tr[['d','w','m']]]; y=tr.y.to_numpy(); lam=np.diag([0,1,1,1]); b=np.linalg.solve(X.T@X+lam,X.T@y)\nfor name,z in [('train',tr),('valid',va)]:\n pred=np.c_[np.ones(len(z)),z[['d','w','m']]]@b\n for method,p in [('har',pred),('last',z.d),('week',z.m)]: print(name,method,'rmse',np.sqrt(np.mean((z.y-p)**2)))\nprint('coef',b.tolist()); print('medians',med); print('n',len(tr),len(va))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
