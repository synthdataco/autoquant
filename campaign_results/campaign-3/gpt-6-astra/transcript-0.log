{"type":"item.completed","item":{"id":"item_316","type":"command_execution","command":"/bin/bash -c \"sed -n '110,370p' agent/research.py; cat agent/periodic.py; sed -n '1,130p' agent/temporal.py\"","aggregated_output":"    raw_log = np.log(raw.where(raw > 0))\n    raw_age = (pd.Timestamp(start_time) - raw.index).total_seconds().to_numpy() / 60\n    for lag in [5, 15, 30, 180]:\n        changes = raw_log.diff(lag).to_numpy() / np.sqrt(lag)\n        valid_changes = np.isfinite(changes)\n        output[f\"av{lag}\"] = {}\n        for half_life in [30, 60, 180, 360, 720, 1440, 2880, 10080]:\n            weights = np.exp(-np.log(2) * raw_age[valid_changes] / half_life)\n            output[f\"av{lag}\"][half_life] = float(np.average(np.abs(changes[valid_changes]), weights=weights) * np.sqrt(np.pi / 2))\n    output[\"returns\"] = normalized\n    clock = pd.DataFrame({'absolute':np.abs(normalized),'hour':close.index[1:][valid].hour,\n                          'day':close.index[1:][valid].date})\n    daily_mean = clock.groupby('day').absolute.transform('mean').clip(lower=1e-9)\n    clock['relative'] = clock.absolute / daily_mean\n    profile = clock.groupby('hour').relative.mean().reindex(range(24),fill_value=1).to_numpy()\n    profile = (.25*np.roll(profile,1) + .5*profile + .25*np.roll(profile,-1))\n    profile = np.clip(profile,.25,3)\n    output['cycle'] = profile / profile.mean()\n    sampled = raw_log.iloc[::-max(1,increment//60)].iloc[::-1].diff()\n    output['step_returns']=sampled.replace([np.inf,-np.inf],np.nan).dropna().to_numpy()\n    differences=np.round(np.abs(np.diff(close.to_numpy())),max(0,10-int(np.floor(np.log10(output['last'])))))\n    positive_differences=differences[differences>0]\n    output['tick']=float(positive_differences.min()) if len(positive_differences) else 0.\n    digits = min(8,max(0,12-int(np.floor(np.log10(output['last'])))))\n    factor = 10.**digits\n    output['gcd_tick'] = 0.\n    if len(close)>1 and close.max()*factor<np.iinfo(np.int64).max/4:\n        integer_prices = np.rint(close.to_numpy()*factor).astype(np.int64)\n        output['gcd_tick'] = float(np.gcd.reduce(np.abs(np.diff(integer_prices)))/factor)\n    pairs = pd.concat([sampled,sampled.shift(1)],axis=1).dropna()\n    output['correlation'] = float(pairs.corr().iloc[0,1]) if len(pairs)>20 and (pairs.std()>0).all() else 0.\n    output['auxiliary'],output['auxiliary_usable']=auxiliary_features(context,start_time,max(output['av'][360],1e-8),output['av'])\n    return output\n\n\ndef generate_variant(feature, asset, start_time, increment, length, count, variant):\n    parts = variant.split(\":\")\n    stacked_mode = parts[0] in ['stacked','refresh','refresh_old']\n    refresh_strength = float(parts[1]) if parts[0] in ['refresh','refresh_old'] else None\n    refresh_kind = 'refit_recent60' if parts[0]=='refresh_old' else 'refresh'\n    offset = int(parts[1]) if parts[0]=='resample' else int(parts[2]) if parts[0]=='sampler' and len(parts)>2 else 0\n    draw_seed = (seed_for(asset,start_time)+offset) % (2**64)\n    rng = np.random.default_rng(draw_seed)\n    steps = length // increment\n    lead_strength=.5 if stacked_mode or parts[0] in ['location','periodic','uncertainty','clock','sharp','adaptive','calibration','calibration600','ticked'] else float(parts[2]) if parts[0] in ['combined','combined_exact'] else float(parts[1]) if parts[0]=='lead' else None\n    sampler='sobol' if stacked_mode or parts[0]=='ticked' else parts[5] if parts[0]=='sharp' and len(parts)>5 else parts[3] if parts[0] in ['combined','combined_exact'] and len(parts)>3 else parts[1] if parts[0]=='sampler' else None\n    fiveminute_strength=float(parts[1]) if parts[0]=='fiveminute' else None\n    temporal_strength=1. if stacked_mode or parts[0]=='ticked' else float(parts[2]) if parts[0]=='sharp' else float(parts[1]) if parts[0] in ['temporal','temporal_exact','combined','combined_exact'] else None\n    temporal_kind='temporal_exact' if stacked_mode or parts[0] in ['temporal_exact','combined_exact','sharp','ticked'] else 'temporal'\n    ensemble_strength=float(parts[1]) if parts[0]=='ensemble' else None\n    location_strength=float(parts[1]) if parts[0]=='location' else None\n    periodic_strength=float(parts[1]) if parts[0]=='periodic' else None\n    uncertainty_parameters=parts[1:] if parts[0]=='uncertainty' else None\n    clock_parameters=(['48','.75','.25'] if asset in CRYPTO else ['96','1','.25']) if stacked_mode else [parts[1],parts[3],'0.25'] if parts[0]=='sharp' else parts[1:] if parts[0]=='clock' else None\n    joint_normalize=bool(int(parts[4])) if parts[0]=='sharp' else False\n    adaptive_strength=float(parts[1]) if parts[0]=='adaptive' else None\n    calibration_strength=float(parts[1]) if parts[0] in ['calibration','calibration600'] else None\n    calibration_kind=parts[0] if calibration_strength is not None else 'calibration'\n    weighted_strength=float(parts[1]) if parts[0]=='weighted' else None\n    tuned_mode=parts[0] in ['tuned','resample'] or lead_strength is not None or sampler is not None or fiveminute_strength is not None or temporal_strength is not None or ensemble_strength is not None\n    tick_kind=parts[1] if parts[0]=='ticked' else 'min'\n    atom_mode='quantize' if parts[0]=='ticked' else parts[0] if parts[0] in ['symboot','hurdle','quantize'] else None\n    atom_parameter=1. if parts[0]=='ticked' else float(parts[1]) if atom_mode else 0.\n    auxiliary_strength=float(parts[1]) if parts[0]=='aux' else None\n    range_parameters = parts[1:] if parts[0] == 'range' else None\n    correlation_parameter = parts[1] if parts[0] == 'corr' else None\n    prior_strength = float(parts[1]) if parts[0] == 'prior' else 0.\n    refit_parameters = parts[1:] if parts[0] == 'refit' else None\n    if parts[0] == 'quick':\n        parts = ['av',parts[1],'1','5']\n    shape_parameters = parts[1:] if parts[0] == \"shape\" else None\n    cycle_strength = float(parts[1]) if parts[0] == \"cycle\" else 0.\n    if prior_strength:\n        cycle_strength = .75\n        parts = ['hybrid','1']\n    if refit_parameters:\n        cycle_strength = .75\n        parts = ['auto','0','1','5'] if length == 3600 else ['ml','refit_'+refit_parameters[0],refit_parameters[1]]\n    if correlation_parameter is not None:\n        cycle_strength = .75\n        parts = ['hybrid','1']\n    if range_parameters:\n        cycle_strength = .75\n        parts = ['hybrid','1']\n    if auxiliary_strength is not None:\n        cycle_strength=.75\n        parts=['auto','0','1','5']\n    if atom_mode:\n        cycle_strength=.75\n        parts=['hybrid','1']\n    if tuned_mode or weighted_strength is not None:\n        cycle_strength=.75\n        parts=['auto','0','1','5']\n    if shape_parameters:\n        cycle_strength = .75\n        parts = [\"hybrid\", \"1\"]\n    if parts[0] == \"cycle\":\n        parts = [\"hybrid\", \"1\"]\n    if parts[0] == \"hybrid\":\n        strength = 1.0 if asset in CRYPTO else float(parts[1])\n        parts = [\"auto\", \"0\", \"1\", \"5\"] if length == 3600 else [\"ml\", \"neural\", str(strength)]\n    schedule = None\n    learned_scale = 1.0\n    if tuned_mode or weighted_strength is not None:\n        incumbent=learned_multiplier(feature,asset,length,'neural')**(.5 if length==3600 else 1.)\n        learned_scale=incumbent\n        if refresh_strength is not None and pd.Timestamp(start_time)>=pd.Timestamp('2026-08-07',tz='UTC'):\n            refreshed = learned_multiplier(feature,asset,length,refresh_kind)**(.5 if length==3600 else 1.)\n            learned_scale *= (refreshed/incumbent)**refresh_strength\n        if calibration_strength is not None:\n            learned_scale *= learned_multiplier(feature,asset,length,calibration_kind)**calibration_strength\n        if adaptive_strength is not None:\n            from adaptive import adaptive_ratio\n\n            corrections = feature.setdefault('adaptive',{})\n            if length not in corrections:\n                corrections[length] = adaptive_ratio(feature['context'],start_time,asset,length)\n            learned_scale *= corrections[length]**adaptive_strength\n        if periodic_strength is not None:\n            from periodic import periodic_multiplier\n\n            learned_scale *= periodic_multiplier((CRYPTO+EQUITY).index(asset),start_time,length)**periodic_strength\n        if ensemble_strength is not None:\n            ensemble=learned_multiplier(feature,asset,length,'ensemble')**(.5 if length==3600 else 1.)\n            learned_scale=incumbent**(1-ensemble_strength)*ensemble**ensemble_strength\n        if temporal_strength is not None:\n            from temporal import context_sequence, temporal_residual\n            from train_vol import feature_vector\n\n            if 'temporal' not in feature:\n                feature['temporal'] = context_sequence(feature['context'],start_time,max(feature['av'][360],1e-8))\n            residual = temporal_residual(feature['temporal'],feature_vector(feature,asset),temporal_kind)\n            learned_scale *= np.exp(temporal_strength*residual[0 if length==3600 else 1])\n        if fiveminute_strength is not None and length>3600:\n            learned_scale=incumbent**(1-fiveminute_strength)*learned_multiplier(feature,asset,length,'fiveminute')**fiveminute_strength\n        if weighted_strength is not None:\n            learned_scale=incumbent**(1-weighted_strength)*learned_multiplier(feature,asset,length,'weighted')**weighted_strength\n    if auxiliary_strength is not None:\n        incumbent=1. if length==3600 else learned_multiplier(feature,asset,length,'neural')\n        learned_scale=incumbent\n        if feature['auxiliary_usable']:\n            learned_scale=incumbent**(1-auxiliary_strength)*learned_multiplier(feature,asset,length,'aux')**auxiliary_strength\n    innovation = parts[0] if parts[0] in [\"iid\", \"sv\", \"boot\"] else None\n    innovation_parameters = parts[1:]\n    if innovation:\n        parts = [\"auto\", \"0\", \"1\"]\n    if parts[0] == \"ml\":\n        learned_scale = learned_multiplier(feature, asset, length, parts[1]) ** float(parts[2])\n        parts = [\"auto\", \"0\", \"1\", \"5\"]\n    if parts[0] == \"revert\":\n        slow_half_life, decay_minutes = int(parts[1]), float(parts[2])\n        initial = feature[\"av\"][30 if length == 3600 else 60]\n        target = feature[\"av\"][slow_half_life]\n        weight = np.exp(-np.arange(1, steps + 1) * increment / 60 / decay_minutes)\n        schedule = np.exp(weight * np.log(initial) + (1 - weight) * np.log(target))\n        parts = [\"auto\", \"0\", \"1\", \"5\"]\n    if parts[0].startswith(\"auto\"):\n        parts[0] = \"av\" + parts[0][4:]\n        parts[1] = \"60\" if length == 3600 else \"360\"\n    if parts[0] == \"starter\":\n        sigma = feature[\"starter\"]\n    else:\n        sigma = feature[parts[0]][int(parts[1])]\n    multiplier = float(parts[2]) if len(parts) > 2 else 1.0\n    sigma *= multiplier * learned_scale * np.sqrt(increment / 60)\n    if range_parameters:\n        half_life = 60 if length==3600 else 360\n        ratio = feature['range'][half_life]*float(range_parameters[1])/max(feature['av'][half_life],1e-8)\n        sigma *= ratio**float(range_parameters[0])\n    if schedule is not None:\n        sigma = schedule * np.sqrt(increment / 60)\n    flat_sigma = sigma\n    if cycle_strength and length > 3600:\n        future_times = pd.Timestamp(start_time) + pd.to_timedelta(np.arange(1,steps+1)*increment,unit='s')\n        profile = feature['cycle']\n        clock_indices = future_times.hour\n        if clock_parameters:\n            from clock_profile import estimate_profile\n\n            bins,cycle_strength,floor = int(clock_parameters[0]),float(clock_parameters[1]),float(clock_parameters[2])\n            profiles = feature.setdefault('clock_profiles',{})\n            if (bins,floor) not in profiles:\n                profiles[(bins,floor)] = estimate_profile(feature['context'],start_time,bins,floor)\n            profile = profiles[(bins,floor)]\n            clock_indices = (future_times.hour*60+future_times.minute)*bins//1440\n        if prior_strength:\n            with np.load(AGENT_DIR/'clock_profiles.npz') as archive:\n                profile = (1-prior_strength)*profile + prior_strength*archive[asset]\n        sigma *= 1 + cycle_strength*(profile[clock_indices]-1)\n    if lead_strength is not None and length > 3600:\n        from train_vol import feature_vector\n\n        weights = learned_weights('lead')\n        values = np.clip((feature_vector(feature,asset)-weights['center'])/weights['spread'],-8,8)\n        for layer in [0,2]:\n            values = weights[f'{layer}.weight'] @ values + weights[f'{layer}.bias']\n            values = values / (1+np.exp(-values))\n        bucket_scale = np.exp(np.clip(weights['4.weight'] @ values + weights['4.bias'],-2,2))\n        minutes = np.arange(1,steps+1)*increment/60\n        centers = (weights['edges'][:-1]+weights['edges'][1:])/2\n        shape = np.interp(minutes,centers,bucket_scale)\n        shape = np.clip(shape/shape.mean(),.4,2.5)**lead_strength\n        sigma *= shape/shape.mean()\n    if joint_normalize and length>3600 and np.mean(sigma)>0:\n        sigma *= flat_sigma/np.mean(sigma)\n    shocks = rng.standard_normal(((count + 1) // 2, steps))\n    shocks = np.concatenate([shocks, -shocks], axis=0)[:count]\n    if correlation_parameter is not None:\n        correlation = np.clip(.5*feature['correlation'],-.25,.25) if correlation_parameter=='auto' else float(correlation_parameter)\n        orthogonal = np.sqrt(1-correlation**2)\n        for step in range(1,steps):\n            shocks[:,step] = correlation*shocks[:,step-1] + orthogonal*shocks[:,step]\n    if atom_mode=='symboot':\n        absolute_returns=np.abs(feature['step_returns'])\n        if len(absolute_returns) and absolute_returns.mean()>0:\n            magnitudes=rng.choice(absolute_returns,size=((count+1)//2,steps))\n            magnitudes=np.concatenate([magnitudes,magnitudes],axis=0)[:count]\n            shocks=np.sign(shocks)*magnitudes/absolute_returns.mean()*np.sqrt(2/np.pi)*atom_parameter\n    if atom_mode=='hurdle':\n        probability=float(np.clip(np.mean(feature['step_returns']==0)*atom_parameter,0,.8))\n        shocks *= (rng.random(shocks.shape)>=probability)/(1-probability)\n    if innovation == \"iid\":\n        degrees = float(innovation_parameters[0])\n        shocks *= np.sqrt((degrees - 2) / rng.chisquare(degrees, size=shocks.shape))\n    elif innovation == \"sv\":\n        spread, persistence = map(float, innovation_parameters)\n        correlation = np.exp(-increment / 60 / persistence)\n        state = rng.standard_normal(count) * spread\n        for step in range(steps):\n            state = correlation * state + np.sqrt(1-correlation**2) * spread * rng.standard_normal(count)\n            shocks[:,step] *= np.exp(state-spread**2)\n    elif innovation == \"boot\":\n        empirical = feature['returns']\n        sampled = rng.choice(empirical, size=shocks.shape)\n        sampled = sampled - np.mean(empirical)\n        shocks = sampled / max(np.std(empirical), 1e-9)\n    if len(parts) > 3:\n        degrees = float(shape_parameters[0]) if shape_parameters else float(parts[3])\n        if shape_parameters:\n            mean_absolute = np.sqrt(2/np.pi) if degrees >= 100 else np.exp(np.log(2)+.5*np.log(degrees-2)+math.lgamma((degrees+1)/2)-np.log(degrees-1)-.5*np.log(np.pi)-math.lgamma(degrees/2))\n            shocks *= float(shape_parameters[1]) * np.sqrt(2/np.pi) / mean_absolute\n        if 2 < degrees < 100 and atom_mode!='symboot':\n            mixing = np.sqrt((degrees - 2) / rng.chisquare(degrees, size=(count, 1)))\n            shocks *= mixing\n            if uncertainty_parameters:\n                weights = learned_weights('uncertainty')\n                head,category = int(length>3600),int(asset not in CRYPTO)\n                quantiles = weights['pooled'][head,category]\n                if uncertainty_parameters[0]=='conditional':\n                    state = np.digitize(np.log(feature['av'][60]/feature['av'][360]),[-.2,.2])\n                    quantiles = weights['conditional'][head,category,state]\n                replacement = rng.choice(quantiles,size=(count,1))\n                selected = rng.random((count,1))<float(uncertainty_parameters[1])\n                shocks *= np.where(selected,replacement,mixing)/mixing\n    if sampler:\n        from sampling import mixture_shocks\n\n        shocks = mixture_shocks(count, steps, draw_seed, sampler)\n    log_paths = np.concatenate([np.zeros((count, 1)), np.cumsum(shocks * sigma, axis=1)], axis=1)\n    if location_strength is not None:\n        from location import location_curve\n\"\"\"Smooth positive scale corrections, without market-session assumptions.\"\"\"\n\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\n\ndef periodic_design(timestamps, asset_indices, asset_count=13):\n    timestamps = pd.DatetimeIndex(timestamps)\n    day = (timestamps.hour + timestamps.minute / 60 + timestamps.second / 3600) / 24\n    week = (timestamps.dayofweek + day) / 7\n    harmonic = np.column_stack([function(2*np.pi*frequency*phase)\n                               for phase in [day,week] for frequency in [1,2] for function in [np.sin,np.cos]])\n    indicator = np.eye(asset_count)[asset_indices]\n    interactions = (harmonic[:, :, None] * indicator[:, None, :]).reshape(len(timestamps), -1)\n    return np.column_stack([harmonic,interactions])\n\n\n@lru_cache(maxsize=1)\ndef periodic_weights():\n    return dict(np.load(Path(__file__).with_name('periodic_weights.npz')))\n\n\ndef periodic_multiplier(asset_index, timestamp, length):\n    design = periodic_design(pd.DatetimeIndex([timestamp]),np.array([asset_index]))\n    output = design @ periodic_weights()['coefficients']\n    return float(np.exp(np.clip(output[0,0 if length==3600 else 1],-.5,.5)))\n\"\"\"Observed-return temporal features and NumPy convolutional inference.\"\"\"\n\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\n\ndef hourly_observations(close, origin='start_day'):\n    close = pd.to_numeric(close, errors='coerce')\n    close = close.loc[np.isfinite(close) & (close > 0)].sort_index()\n    close = close.loc[~close.index.duplicated(keep='last')]\n    gaps = np.diff(close.index.as_unit('ns').asi8) / 60e9\n    changes = np.diff(np.log(close.to_numpy())) / np.sqrt(gaps)\n    observed = pd.DataFrame({'absolute': np.abs(changes), 'square': changes**2, 'signed': changes}, index=close.index[1:])\n    grouped = observed.resample('1h', origin=origin, closed='right', label='right')\n    means = grouped.mean()\n    means['coverage'] = grouped['absolute'].count() / 60\n    return means\n\n\ndef normalize_sequence(hourly, timestamp, reference):\n    grid = pd.date_range(end=pd.Timestamp(timestamp).floor('min'), periods=168, freq='1h')\n    rows = hourly.reindex(grid)\n    absolute = rows.absolute.to_numpy() * np.sqrt(np.pi / 2)\n    root_square = np.sqrt(rows.square.to_numpy())\n    values = np.stack([np.log(np.maximum(absolute, 1e-9) / reference),\n                       np.log(np.maximum(root_square, 1e-9) / reference),\n                       rows.signed.to_numpy() / reference,\n                       rows.coverage.to_numpy()])\n    return np.clip(np.nan_to_num(values, nan=0., posinf=5., neginf=-5.), -5, 5).astype(np.float32)\n\n\ndef context_sequence(context, timestamp, reference):\n    close = context.close.loc[(context.index > timestamp - pd.Timedelta(days=7)) & (context.index <= timestamp)]\n    hourly = hourly_observations(close, pd.Timestamp(timestamp).floor('min'))\n    return normalize_sequence(hourly, timestamp, reference)\n\n\n@lru_cache(maxsize=2)\ndef temporal_weights(kind='temporal'):\n    return dict(np.load(Path(__file__).with_name(f'{kind}_weights.npz')))\n\n\ndef temporal_residual(sequence, static, kind='temporal'):\n    weights = temporal_weights(kind)\n    values = sequence\n    for layer in [0, 2, 4]:\n        padded = np.pad(values, ((0, 0), (2, 2)))\n        windows = np.lib.stride_tricks.sliding_window_view(padded, 5, axis=1)[:, ::2]\n        values = np.einsum('ock,ctk->ot', weights[f'encoder.{layer}.weight'], windows) + weights[f'encoder.{layer}.bias'][:, None]\n        values = values / (1 + np.exp(-values))\n    static = np.clip((static - weights['center']) / weights['spread'], -8, 8)\n    values = np.r_[values.reshape(-1), static]\n    values = weights['head.0.weight'] @ values + weights['head.0.bias']\n    values = values / (1 + np.exp(-values))\n    return np.clip(weights['head.2.weight'] @ values + weights['head.2.bias'], -.8, .8)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_317","type":"command_execution","command":"/bin/bash -c \"cat agent/train_lead.py; cat agent/train_temporal.py; sed -n '1,100p' agent/train_periodic.py; sed -n '1,110p' agent/modeling.py; sed -n '375,490p' agent/research.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_317","type":"command_execution","command":"/bin/bash -c \"cat agent/train_lead.py; cat agent/train_temporal.py; sed -n '1,100p' agent/train_periodic.py; sed -n '1,110p' agent/modeling.py; sed -n '375,490p' agent/research.py\"","aggregated_output":"\"\"\"Learn future volatility shape from causally split snapshot labels.\"\"\"\n\nimport json\nfrom concurrent.futures import ProcessPoolExecutor\n\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom torch import nn\n\nfrom predict import AGENT_DIR, ensure_workspace_cwd, load_context\nfrom train_vol import ASSETS\n\nEDGES = np.array([0, 60, 180, 360, 720, 1440])\n\n\ndef make_asset(asset):\n    data = np.load(AGENT_DIR / 'results' / 'volatility_training.npz')\n    mask = np.argmax(data['inputs'][:, -len(ASSETS):], axis=1) == ASSETS.index(asset)\n    inputs = data['inputs'][mask]\n    timestamps = pd.to_datetime(data['timestamps'][mask], utc=True)\n    prices = load_context(asset, timestamps.min() - pd.Timedelta(minutes=10), pd.Timestamp('2026-07-26', tz='UTC'))\n    observed = prices.close.dropna()\n    gaps = np.diff(observed.index.as_unit('ns').asi8) / 60e9\n    normalized = pd.Series(np.abs(np.diff(np.log(observed.to_numpy()))) / np.sqrt(gaps), index=observed.index[1:]).reindex(prices.index)\n    labels = []\n    for begin, end in zip(EDGES[:-1], EDGES[1:]):\n        width = int(end - begin)\n        future = normalized.shift(-int(begin + 1)).iloc[::-1].rolling(width, min_periods=max(10, width // 10)).mean().iloc[::-1]\n        labels.append(future.reindex(timestamps).to_numpy() * np.sqrt(np.pi / 2))\n    targets = np.stack(labels, axis=1) / np.exp(inputs[:, 16:17])\n    valid = np.isfinite(targets).all(axis=1) & (targets > 0).all(axis=1)\n    print(asset, int(valid.sum()), flush=True)\n    return inputs[valid], targets[valid], timestamps.as_unit('ns').asi8[valid]\n\n\ndef main():\n    ensure_workspace_cwd()\n    print((AGENT_DIR / 'BUDGET.md').read_text(), flush=True)\n    dataset = AGENT_DIR / 'results' / 'lead_training.npz'\n    if not dataset.exists():\n        with ProcessPoolExecutor(max_workers=4) as executor:\n            batches = list(executor.map(make_asset, ASSETS))\n        np.savez(dataset, inputs=np.concatenate([batch[0] for batch in batches]),\n                 targets=np.concatenate([batch[1] for batch in batches]),\n                 timestamps=np.concatenate([batch[2] for batch in batches]))\n    data = np.load(dataset)\n    inputs, targets, timestamps = data['inputs'], np.clip(data['targets'], .02, 20), data['timestamps']\n    previous = dict(np.load(AGENT_DIR / 'volatility_weights.npz'))\n    training = timestamps < pd.Timestamp('2026-07-01', tz='UTC').value\n    torch.set_num_threads(4)\n    torch.manual_seed(73)\n    device = 'cuda' if torch.cuda.is_available() else 'cpu'\n    if device == 'cuda':\n        torch.cuda.set_per_process_memory_fraction(.35)\n    standardized = np.clip((inputs - previous['center']) / previous['spread'], -8, 8)\n    values = torch.tensor(standardized, dtype=torch.float32, device=device)\n    labels = torch.tensor(targets, dtype=torch.float32, device=device)\n    weights = torch.tensor(np.diff(EDGES) / EDGES[-1], dtype=torch.float32, device=device)\n    network = nn.Sequential(nn.Linear(30, 48), nn.SiLU(), nn.Linear(48, 32), nn.SiLU(), nn.Linear(32, 5)).to(device)\n    with torch.no_grad():\n        for layer in [0, 2]:\n            network[layer].weight.copy_(torch.tensor(previous[f'{layer}.weight'], device=device))\n            network[layer].bias.copy_(torch.tensor(previous[f'{layer}.bias'], device=device))\n        network[4].weight.copy_(torch.tensor(np.repeat(previous['4.weight'][1:2], 5, axis=0), device=device))\n        network[4].bias.copy_(torch.tensor(np.repeat(previous['4.bias'][1], 5), device=device))\n    optimizer = torch.optim.AdamW(network.parameters(), lr=.0005, weight_decay=.04)\n    indices = torch.tensor(np.flatnonzero(training), device=device)\n    validation = torch.tensor(np.flatnonzero(~training), device=device)\n\n    def loss_for(selected, regularize=False):\n        logs = network(values[selected]).clamp(-2, 2)\n        loss = ((labels[selected] * torch.exp(-logs) + logs) * weights).sum(axis=1).mean()\n        if regularize:\n            loss = loss + .02 * logs.square().mean() + .02 * torch.diff(logs, dim=1).square().mean()\n        return loss\n\n    initial = float(loss_for(validation).detach().cpu())\n    best, best_epoch = initial, -1\n    best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n    for epoch in range(180):\n        for batch in indices[torch.randperm(len(indices), device=device)].split(1024):\n            optimizer.zero_grad()\n            loss_for(batch, True).backward()\n            optimizer.step()\n        with torch.no_grad():\n            loss = float(loss_for(validation).cpu())\n        if loss < best:\n            best, best_epoch = loss, epoch\n            best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n        if epoch % 30 == 0:\n            print(epoch, loss, best, flush=True)\n    np.savez(AGENT_DIR / 'lead_weights.npz', center=previous['center'], spread=previous['spread'], edges=EDGES, **best_state)\n    metrics = {'initial_validation_loss': initial, 'best_validation_loss': best, 'best_epoch': best_epoch,\n               'training_rows': int(training.sum()), 'validation_rows': int((~training).sum()),\n               'target_cutoff': '2026-07-26', 'validation_start': '2026-07-01', 'edges_minutes': EDGES.tolist()}\n    (AGENT_DIR / 'lead_weights.json').write_text(json.dumps(metrics, indent=2))\n    print(metrics, flush=True)\n\n\nif __name__ == '__main__':\n    main()\n\"\"\"Fit a small sequence residual over the frozen static forecaster.\"\"\"\n\nimport argparse\nimport json\nfrom concurrent.futures import ProcessPoolExecutor\n\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom torch import nn\n\nfrom predict import AGENT_DIR, ensure_workspace_cwd, load_context\nfrom temporal import context_sequence, hourly_observations, normalize_sequence\nfrom train_vol import ASSETS\n\n\ndef make_asset(task):\n    asset, exact = task\n    data = np.load(AGENT_DIR / 'results' / 'volatility_training.npz')\n    indices = np.flatnonzero(np.argmax(data['inputs'][:, -len(ASSETS):], axis=1) == ASSETS.index(asset))\n    timestamps = pd.to_datetime(data['timestamps'][indices], utc=True)\n    prices = load_context(asset, timestamps.min() - pd.Timedelta(days=7), timestamps.max())\n    if exact:\n        sequences = [context_sequence(prices.loc[timestamp-pd.Timedelta(days=7):timestamp], timestamp, np.exp(data['inputs'][index, 16]))\n                     for timestamp, index in zip(timestamps, indices)]\n    else:\n        hourly = hourly_observations(prices.close)\n        sequences = [normalize_sequence(hourly, timestamp, np.exp(data['inputs'][index, 16]))\n                     for timestamp, index in zip(timestamps, indices)]\n    print(asset, len(sequences), flush=True)\n    return indices, np.stack(sequences)\n\n\nclass TemporalNetwork(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.encoder = nn.Sequential(nn.Conv1d(4, 8, 5, stride=2, padding=2), nn.SiLU(),\n                                     nn.Conv1d(8, 16, 5, stride=2, padding=2), nn.SiLU(),\n                                     nn.Conv1d(16, 16, 5, stride=2, padding=2), nn.SiLU())\n        self.head = nn.Sequential(nn.Linear(16 * 21 + 30, 48), nn.SiLU(), nn.Linear(48, 2))\n        nn.init.zeros_(self.head[-1].weight)\n        nn.init.zeros_(self.head[-1].bias)\n\n    def forward(self, sequence, static):\n        encoded = self.encoder(sequence).flatten(1)\n        return self.head(torch.cat([encoded, static], dim=1)).clamp(-.8, .8)\n\n\ndef main():\n    ensure_workspace_cwd()\n    print((AGENT_DIR / 'BUDGET.md').read_text(), flush=True)\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--exact-context', action='store_true')\n    args = parser.parse_args()\n    name = 'temporal_exact' if args.exact_context else 'temporal'\n    path = AGENT_DIR / 'results' / f'{name}_training.npz'\n    if not path.exists():\n        with ProcessPoolExecutor(max_workers=2) as executor:\n            batches = list(executor.map(make_asset, [(asset,args.exact_context) for asset in ASSETS]))\n        np.savez(path, indices=np.concatenate([batch[0] for batch in batches]), sequences=np.concatenate([batch[1] for batch in batches]))\n    data = np.load(AGENT_DIR / 'results' / 'volatility_training.npz')\n    temporal = np.load(path)\n    selected = temporal['indices']\n    previous = dict(np.load(AGENT_DIR / 'volatility_weights.npz'))\n    static = np.clip((data['inputs'][selected] - previous['center']) / previous['spread'], -8, 8)\n    baseline = static.copy()\n    for layer in [0, 2]:\n        baseline = baseline @ previous[f'{layer}.weight'].T + previous[f'{layer}.bias']\n        baseline = baseline / (1 + np.exp(-baseline))\n    baseline = np.clip(baseline @ previous['4.weight'].T + previous['4.bias'], -2, 2)\n    training = data['timestamps'][selected] < pd.Timestamp('2026-07-01', tz='UTC').value\n    torch.set_num_threads(3)\n    torch.manual_seed(73)\n    device = 'cuda' if torch.cuda.is_available() else 'cpu'\n    if device == 'cuda':\n        torch.cuda.set_per_process_memory_fraction(.35)\n    static = torch.tensor(static, dtype=torch.float32, device=device)\n    sequences = torch.tensor(temporal['sequences'], dtype=torch.float32, device=device)\n    baseline = torch.tensor(baseline, dtype=torch.float32, device=device)\n    targets = torch.tensor(np.clip(data['targets'][selected], .02, 20), dtype=torch.float32, device=device)\n    indices = torch.tensor(np.flatnonzero(training), device=device)\n    validation = torch.tensor(np.flatnonzero(~training), device=device)\n    network = TemporalNetwork().to(device)\n    optimizer = torch.optim.AdamW(network.parameters(), lr=.0003, weight_decay=.08)\n\n    def loss_for(batch, penalty=0.):\n        residual = network(sequences[batch], static[batch])\n        output = (baseline[batch] + residual).clamp(-2, 2)\n        return (targets[batch] * torch.exp(-output) + output + penalty * residual.square()).mean()\n\n    initial = float(loss_for(validation).detach().cpu())\n    best, best_epoch = initial, -1\n    best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n    for epoch in range(100):\n        for batch in indices[torch.randperm(len(indices), device=device)].split(512):\n            optimizer.zero_grad()\n            loss_for(batch, .12).backward()\n            optimizer.step()\n        with torch.no_grad():\n            loss = float(loss_for(validation).cpu())\n        if loss < best:\n            best, best_epoch = loss, epoch\n            best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n        if epoch % 10 == 0:\n            print(epoch, loss, best, flush=True)\n    np.savez(AGENT_DIR / f'{name}_weights.npz', center=previous['center'], spread=previous['spread'], **best_state)\n    metrics = {'initial_validation_loss': initial, 'best_validation_loss': best, 'best_epoch': best_epoch,\n               'target_cutoff': '2026-07-26', 'validation_start': '2026-07-01',\n               'training_rows': int(training.sum()), 'validation_rows': int((~training).sum()), 'exact_context': args.exact_context}\n    (AGENT_DIR / f'{name}_weights.json').write_text(json.dumps(metrics, indent=2))\n    print(metrics, flush=True)\n\n\nif __name__ == '__main__':\n    main()\nsed: can't read agent/train_periodic.py: No such file or directory\n\"\"\"Offline probabilistic paths with robust, horizon-specific volatility forecasts.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.special import ndtri\nfrom scipy.stats import chi2, qmc\n\nASSETS = (\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\", \"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\")\nHALF_LIVES = (30, 60, 180, 360, 720, 1440, 2880, 10080)\nCOMMODITY_EQUITY_BLEND = 1.0\nCYCLE_STRENGTH = 0.75\nLEAD_STRENGTH = 0.5\nWEIGHTS_AVAILABLE_FROM = pd.Timestamp('2026-07-26',tz='UTC')\n\n\n@lru_cache(maxsize=3)\ndef _weights(kind='volatility'):\n    with np.load(Path(__file__).with_name(f\"{kind}_weights.npz\"), allow_pickle=False) as archive:\n        return {name: archive[name] for name in archive.files}\n\n\ndef _features(closes, timestamp):\n    minutes = (closes.index - timestamp).total_seconds().to_numpy() / 60\n    gaps = np.diff(minutes)\n    returns = np.diff(np.log(closes.to_numpy(dtype=float)))\n    valid = (gaps > 0) & np.isfinite(returns)\n    normalized = returns[valid] / np.sqrt(gaps[valid])\n    age = -minutes[1:][valid]\n    absolute, root_square = {}, {}\n    for half_life in HALF_LIVES:\n        if not normalized.size:\n            absolute[half_life] = root_square[half_life] = 1e-8\n            continue\n        weights = np.exp(-np.log(2) * age / half_life)\n        absolute[half_life] = max(float(np.average(np.abs(normalized), weights=weights) * np.sqrt(np.pi / 2)), 1e-8)\n        root_square[half_life] = max(float(np.sqrt(np.average(normalized ** 2, weights=weights))), 1e-8)\n    return absolute, root_square\n\n\ndef _feature_values(absolute, root_square, asset):\n    reference = absolute[360]\n    values = [np.log(max(estimator[half_life], 1e-9) / reference)\n              for estimator in (absolute, root_square) for half_life in HALF_LIVES]\n    values += [np.log(reference), *[float(asset == name) for name in ASSETS]]\n    return np.asarray(values,dtype=np.float32)\n\n\ndef _network_output(values, weights):\n    inputs = np.clip((values - weights[\"center\"]) / weights[\"spread\"], -8, 8)\n    for layer in (0, 2):\n        inputs = weights[f\"{layer}.weight\"] @ inputs + weights[f\"{layer}.bias\"]\n        inputs = inputs / (1 + np.exp(-inputs))\n    return weights[\"4.weight\"] @ inputs + weights[\"4.bias\"]\n\n\ndef _learned_multiplier(absolute, root_square, asset, hourly):\n    output = _network_output(_feature_values(absolute,root_square,asset),_weights())\n    strength = .5 if hourly else 1.0 if asset in ASSETS[:5] else COMMODITY_EQUITY_BLEND\n    return float(np.exp(np.clip(output[0 if hourly else 1], -2, 2))) ** strength\n\n\ndef _lead_profile(absolute, root_square, asset, steps, increment):\n    if steps == 0:\n        return np.ones(0)\n    weights = _weights('lead')\n    buckets = np.exp(np.clip(_network_output(_feature_values(absolute,root_square,asset),weights),-2,2))\n    centers = (weights['edges'][:-1]+weights['edges'][1:])/2\n    shape = np.interp(np.arange(1,steps+1)*increment/60,centers,buckets)\n    shape = np.clip(shape/shape.mean(),.4,2.5)**LEAD_STRENGTH\n    return shape/shape.mean()\n\n\ndef _temporal_adjustment(closes, timestamp, absolute, root_square, asset):\n    weights = _weights('temporal_exact')\n    reference = absolute[360]\n    gaps = np.diff(closes.index.as_unit('ns').asi8)/60e9\n    changes = np.diff(np.log(closes.to_numpy()))/np.sqrt(gaps)\n    observed = pd.DataFrame({'absolute':np.abs(changes),'square':changes**2,'signed':changes},index=closes.index[1:])\n    grouped = observed.resample('1h',origin=timestamp.floor('min'),closed='right',label='right')\n    rows = grouped.mean()\n    rows['coverage'] = grouped['absolute'].count()/60\n    rows = rows.reindex(pd.date_range(end=timestamp.floor('min'),periods=168,freq='1h'))\n    values = np.stack([np.log(np.maximum(rows.absolute.to_numpy()*np.sqrt(np.pi/2),1e-9)/reference),\n                       np.log(np.maximum(np.sqrt(rows.square.to_numpy()),1e-9)/reference),\n                       rows.signed.to_numpy()/reference,rows.coverage.to_numpy()])\n    values = np.clip(np.nan_to_num(values,nan=0.,posinf=5.,neginf=-5.),-5,5).astype(np.float32)\n    for layer in [0,2,4]:\n        padded = np.pad(values,((0,0),(2,2)))\n        windows = np.lib.stride_tricks.sliding_window_view(padded,5,axis=1)[:,::2]\n        values = np.einsum('ock,ctk->ot',weights[f'encoder.{layer}.weight'],windows)+weights[f'encoder.{layer}.bias'][:,None]\n        values = values/(1+np.exp(-values))\n    static = np.clip((_feature_values(absolute,root_square,asset)-weights['center'])/weights['spread'],-8,8)\n    values = np.r_[values.reshape(-1),static]\n    values = weights['head.0.weight'] @ values+weights['head.0.bias']\n    values = values/(1+np.exp(-values))\n    return np.clip(weights['head.2.weight'] @ values+weights['head.2.bias'],-.8,.8)\n\n\ndef _sobol_shocks(count, steps, seed):\n    pairs = (count+1)//2\n    engine = qmc.Sobol(steps+1,scramble=True,seed=int(seed%(2**32)))\n    uniforms = engine.random_base2(int(np.ceil(np.log2(max(1,pairs)))))[:pairs]\n    scales = np.sqrt(3/chi2.ppf(np.clip(uniforms[:,:1],1e-12,1-1e-12),5))\n    shocks = ndtri(np.clip(uniforms[:,1:],1e-12,1-1e-12))*scales\n    paths=feature[\"last\"] * np.exp(log_paths)\n    tick = feature['gcd_tick'] if tick_kind=='gcd' else feature['tick']\n    if atom_mode=='quantize' and 0<tick<feature['last']*.01:\n        tick *= atom_parameter\n        paths=np.maximum(tick,feature['last']+np.rint((paths-feature['last'])/tick)*tick)\n        paths[:,0]=feature['last']\n    return paths\n\n\ndef evaluate_asset(task):\n    asset, length, window, variants, count, stride = task\n    ensure_workspace_cwd()\n    begin, end = [pd.Timestamp(value, tz=\"UTC\") for value in WINDOWS[window]]\n    increment = 60 if length == 3600 else 300\n    field = get_miner_scores(begin, end, asset, length, increment)\n    times = pd.DatetimeIndex(field.start_time.unique()).sort_values()[::stride]\n    prices = load_context(asset, times.min() - pd.Timedelta(days=7), min(end, times.max() + pd.Timedelta(seconds=length)))\n    prompts = []\n    for timestamp in times:\n        prompts.append({\"asset\": asset, \"start_time\": timestamp, \"time_length\": length, \"time_increment\": increment,\n                        \"real_prices\": _slice_real_prices(prices[[\"close\"]], timestamp, length, increment)})\n    _fill_gaps_from_realized_paths(prompts, asset)\n    rows = []\n    for prompt in prompts:\n        timestamp = prompt[\"start_time\"]\n        context = prices.loc[(prices.index > timestamp - pd.Timedelta(days=7)) & (prices.index <= timestamp)]\n        feature = features(context, timestamp, increment)\n        for variant in variants:\n            started = perf_counter()\n            paths = generate_variant(feature, asset, timestamp, increment, length, count, variant)\n            elapsed = perf_counter() - started\n            score, detail = score_paths(paths, prompt[\"real_prices\"], increment, asset, length)\n            row = {\"asset\": asset, \"length\": length, \"window\": window, \"time\": timestamp,\n                   \"variant\": variant, \"crps\": score, \"latency\": elapsed, \"paths\": count}\n            row.update({item[\"Interval\"]: item[\"CRPS\"] for item in detail})\n            rows.append(row)\n    print(f\"{window} {asset} {length}: {len(prompts)} prompts, {len(variants)} variants\", flush=True)\n    return rows\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--name\", required=True)\n    parser.add_argument(\"--variants\", default=\"starter,rv:360,rv:1440,av:360,av:1440\")\n    parser.add_argument(\"--variants-equity\")\n    parser.add_argument(\"--windows\", default=\"dev1,dev2\")\n    parser.add_argument(\"--assets\", default=\",\".join(CRYPTO + EQUITY))\n    parser.add_argument(\"--paths\", type=int, default=256)\n    parser.add_argument(\"--stride-low\", type=int, default=4)\n    parser.add_argument(\"--stride-high\", type=int, default=24)\n    parser.add_argument(\"--workers\", type=int, default=10)\n    parser.add_argument(\"--format\", choices=['all','low','high'],default='all')\n    args = parser.parse_args()\n    print((AGENT_DIR / \"BUDGET.md\").read_text(), flush=True)\n    variants = args.variants.split(\",\")\n    tasks = [(asset, length, window, args.variants_equity.split(',') if asset in EQUITY and args.variants_equity else variants,\n              args.paths, args.stride_high if length == 3600 else args.stride_low)\n             for window in args.windows.split(\",\") for asset in args.assets.split(\",\")\n             for length in ([86400, 3600] if asset in CRYPTO else [86400])\n             if args.format=='all' or (args.format=='low' and length==86400) or (args.format=='high' and length==3600)]\n    with ProcessPoolExecutor(max_workers=args.workers) as executor:\n        results = list(executor.map(evaluate_asset, tasks))\n    result = pd.DataFrame([row for batch in results for row in batch])\n    target = AGENT_DIR / \"results\" / f\"{args.name}.parquet\"\n    target.parent.mkdir(parents=True, exist_ok=True)\n    result.to_parquet(target)\n    print(result.groupby([\"window\", \"length\", \"asset\", \"variant\"]).crps.mean().to_string(), flush=True)\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_318","type":"command_execution","command":"/bin/bash -c \"cat agent/sampling.py; sed -n '1,190p' agent/train_temporal.py; cat agent/temporal_exact_weights.json; cat agent/train_periodic.py; sed -n '1,45p' agent/report.md\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_318","type":"command_execution","command":"/bin/bash -c \"cat agent/sampling.py; sed -n '1,190p' agent/train_temporal.py; cat agent/temporal_exact_weights.json; cat agent/train_periodic.py; sed -n '1,45p' agent/report.md\"","aggregated_output":"\"\"\"Deterministic finite-fan samplers for the same scale-mixture process.\"\"\"\n\nfrom collections import deque\n\nimport numpy as np\nfrom scipy.special import ndtri\nfrom scipy.stats import chi2, qmc\n\n\ndef bridge_increments(normals):\n    count, steps = normals.shape\n    paths = np.zeros((count, steps + 1))\n    if steps == 0:\n        return normals.copy()\n    paths[:, steps] = np.sqrt(steps) * normals[:, 0]\n    intervals = deque([(0, steps)])\n    coordinate = 1\n    while intervals:\n        left, right = intervals.popleft()\n        middle = (left + right) // 2\n        if middle == left:\n            continue\n        span = right - left\n        paths[:, middle] = ((right - middle) * paths[:, left] + (middle - left) * paths[:, right]) / span\n        paths[:, middle] += np.sqrt((middle - left) * (right - middle) / span) * normals[:, coordinate]\n        coordinate += 1\n        intervals.extend([(left, middle), (middle, right)])\n    return np.diff(paths, axis=1)\n\n\ndef mixture_shocks(count, steps, seed, mode):\n    rng = np.random.default_rng(seed)\n    pairs = (count + 1) // 2\n    if mode in ['sobol', 'bridge']:\n        engine = qmc.Sobol(steps + 1, scramble=True, seed=int(seed % (2**32)))\n        uniforms = engine.random_base2(int(np.ceil(np.log2(max(1, pairs)))))[:pairs]\n        scales = np.sqrt(3 / chi2.ppf(np.clip(uniforms[:, :1], 1e-12, 1 - 1e-12), 5))\n        normals = ndtri(np.clip(uniforms[:, 1:], 1e-12, 1 - 1e-12))\n        if mode == 'bridge':\n            normals = bridge_increments(normals)\n    else:\n        normals = rng.standard_normal((pairs, steps))\n        if mode == 'paired':\n            scales = np.sqrt(3 / rng.chisquare(5, size=(pairs, 1)))\n        elif mode == 'stratified':\n            quantiles = (np.arange(pairs) + .5) / pairs\n            scales = np.sqrt(3 / chi2.ppf(rng.permutation(quantiles)[:, None], 5))\n        else:\n            raise ValueError(f'Unknown sampler {mode}')\n    shocks = normals * scales\n    return np.concatenate([shocks, -shocks], axis=0)[:count]\n\"\"\"Fit a small sequence residual over the frozen static forecaster.\"\"\"\n\nimport argparse\nimport json\nfrom concurrent.futures import ProcessPoolExecutor\n\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom torch import nn\n\nfrom predict import AGENT_DIR, ensure_workspace_cwd, load_context\nfrom temporal import context_sequence, hourly_observations, normalize_sequence\nfrom train_vol import ASSETS\n\n\ndef make_asset(task):\n    asset, exact = task\n    data = np.load(AGENT_DIR / 'results' / 'volatility_training.npz')\n    indices = np.flatnonzero(np.argmax(data['inputs'][:, -len(ASSETS):], axis=1) == ASSETS.index(asset))\n    timestamps = pd.to_datetime(data['timestamps'][indices], utc=True)\n    prices = load_context(asset, timestamps.min() - pd.Timedelta(days=7), timestamps.max())\n    if exact:\n        sequences = [context_sequence(prices.loc[timestamp-pd.Timedelta(days=7):timestamp], timestamp, np.exp(data['inputs'][index, 16]))\n                     for timestamp, index in zip(timestamps, indices)]\n    else:\n        hourly = hourly_observations(prices.close)\n        sequences = [normalize_sequence(hourly, timestamp, np.exp(data['inputs'][index, 16]))\n                     for timestamp, index in zip(timestamps, indices)]\n    print(asset, len(sequences), flush=True)\n    return indices, np.stack(sequences)\n\n\nclass TemporalNetwork(nn.Module):\n    def __init__(self):\n        super().__init__()\n        self.encoder = nn.Sequential(nn.Conv1d(4, 8, 5, stride=2, padding=2), nn.SiLU(),\n                                     nn.Conv1d(8, 16, 5, stride=2, padding=2), nn.SiLU(),\n                                     nn.Conv1d(16, 16, 5, stride=2, padding=2), nn.SiLU())\n        self.head = nn.Sequential(nn.Linear(16 * 21 + 30, 48), nn.SiLU(), nn.Linear(48, 2))\n        nn.init.zeros_(self.head[-1].weight)\n        nn.init.zeros_(self.head[-1].bias)\n\n    def forward(self, sequence, static):\n        encoded = self.encoder(sequence).flatten(1)\n        return self.head(torch.cat([encoded, static], dim=1)).clamp(-.8, .8)\n\n\ndef main():\n    ensure_workspace_cwd()\n    print((AGENT_DIR / 'BUDGET.md').read_text(), flush=True)\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--exact-context', action='store_true')\n    args = parser.parse_args()\n    name = 'temporal_exact' if args.exact_context else 'temporal'\n    path = AGENT_DIR / 'results' / f'{name}_training.npz'\n    if not path.exists():\n        with ProcessPoolExecutor(max_workers=2) as executor:\n            batches = list(executor.map(make_asset, [(asset,args.exact_context) for asset in ASSETS]))\n        np.savez(path, indices=np.concatenate([batch[0] for batch in batches]), sequences=np.concatenate([batch[1] for batch in batches]))\n    data = np.load(AGENT_DIR / 'results' / 'volatility_training.npz')\n    temporal = np.load(path)\n    selected = temporal['indices']\n    previous = dict(np.load(AGENT_DIR / 'volatility_weights.npz'))\n    static = np.clip((data['inputs'][selected] - previous['center']) / previous['spread'], -8, 8)\n    baseline = static.copy()\n    for layer in [0, 2]:\n        baseline = baseline @ previous[f'{layer}.weight'].T + previous[f'{layer}.bias']\n        baseline = baseline / (1 + np.exp(-baseline))\n    baseline = np.clip(baseline @ previous['4.weight'].T + previous['4.bias'], -2, 2)\n    training = data['timestamps'][selected] < pd.Timestamp('2026-07-01', tz='UTC').value\n    torch.set_num_threads(3)\n    torch.manual_seed(73)\n    device = 'cuda' if torch.cuda.is_available() else 'cpu'\n    if device == 'cuda':\n        torch.cuda.set_per_process_memory_fraction(.35)\n    static = torch.tensor(static, dtype=torch.float32, device=device)\n    sequences = torch.tensor(temporal['sequences'], dtype=torch.float32, device=device)\n    baseline = torch.tensor(baseline, dtype=torch.float32, device=device)\n    targets = torch.tensor(np.clip(data['targets'][selected], .02, 20), dtype=torch.float32, device=device)\n    indices = torch.tensor(np.flatnonzero(training), device=device)\n    validation = torch.tensor(np.flatnonzero(~training), device=device)\n    network = TemporalNetwork().to(device)\n    optimizer = torch.optim.AdamW(network.parameters(), lr=.0003, weight_decay=.08)\n\n    def loss_for(batch, penalty=0.):\n        residual = network(sequences[batch], static[batch])\n        output = (baseline[batch] + residual).clamp(-2, 2)\n        return (targets[batch] * torch.exp(-output) + output + penalty * residual.square()).mean()\n\n    initial = float(loss_for(validation).detach().cpu())\n    best, best_epoch = initial, -1\n    best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n    for epoch in range(100):\n        for batch in indices[torch.randperm(len(indices), device=device)].split(512):\n            optimizer.zero_grad()\n            loss_for(batch, .12).backward()\n            optimizer.step()\n        with torch.no_grad():\n            loss = float(loss_for(validation).cpu())\n        if loss < best:\n            best, best_epoch = loss, epoch\n            best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n        if epoch % 10 == 0:\n            print(epoch, loss, best, flush=True)\n    np.savez(AGENT_DIR / f'{name}_weights.npz', center=previous['center'], spread=previous['spread'], **best_state)\n    metrics = {'initial_validation_loss': initial, 'best_validation_loss': best, 'best_epoch': best_epoch,\n               'target_cutoff': '2026-07-26', 'validation_start': '2026-07-01',\n               'training_rows': int(training.sum()), 'validation_rows': int((~training).sum()), 'exact_context': args.exact_context}\n    (AGENT_DIR / f'{name}_weights.json').write_text(json.dumps(metrics, indent=2))\n    print(metrics, flush=True)\n\n\nif __name__ == '__main__':\n    main()\n{\n  \"initial_validation_loss\": 1.0193010568618774,\n  \"best_validation_loss\": 1.0067391395568848,\n  \"best_epoch\": 24,\n  \"target_cutoff\": \"2026-07-26\",\n  \"validation_start\": \"2026-07-01\",\n  \"training_rows\": 23457,\n  \"validation_rows\": 2508,\n  \"exact_context\": true\n}cat: agent/train_periodic.py: No such file or directory\n# Better volatility forecasts are not the same as better miner rewards\n\n**Status: interim research report. The campaign is active; no champion has been nominated.**\n\n## Context\n\nSynth SN50 asks a miner for a fan of future prices, not a single price target. This campaign covers all three competitions: five crypto assets at one-minute resolution for one hour, the same assets at five-minute resolution for one day, and eight live commodity/equity assets at five-minute resolution for one day. SPYX is retired and is not modeled or evaluated.\n\nEvery served prompt must contain the requested number of paths—1000 in the validator—and include the observed starting price. The daily and hourly shapes are therefore 1000 by 289 and 1000 by 61. Prices come only from the frozen snapshot, whose research cutoff is August 29, 2026. Nothing from the subsequent evaluation period is used.\n\nThe distinction between CRPS and emissions matters. The validator converts per-prompt CRPS into relative prompt scores, applies asset coefficients, smooths scores, and uses a softmax. An arithmetic average of CRPS across assets is not the campaign objective. The campaign's Score is 100 times the mean of the three capped reward ratios to each competition's best field miner.\n\nIn the pinned code, valid prompt scores are specifically **raw CRPS minus the prompt minimum**. There is no percentile-range division or capping of valid scores; the 95th percentile fills missed responses only. This distinction is important when designing a training loss. Per-prompt division by a realized baseline score is not equivalent to the validator's rule.\n\nThe implementation is anchored to synth-lib commit `782a44fe7585a4e7b0388e22b99c57f13d56f5ee` and its pinned synth-subnet dependency `0d014cbcec376b28e887403b84025ebf1a89f60e`. The source-of-truth functions are `calculate_crps_for_miner`, `compute_prompt_scores`, and `compute_smoothed_score`; scoring and ranking are invoked through `agent/predict.py` and `synth_lib.backtester`, never through a substitute scoring formula.\n\n## Approach\n\n### Start with trustworthy evaluation\n\nThe starter's context loader was strict and rejected legitimate NaNs. It now reads existing parquet partitions directly, preserves missing observations, checks coverage before evaluation, and uses exact archived prompt timestamps. It never repairs missing market prices by interpolation. The current model drops invalid closes and scales returns spanning gaps by the square root of elapsed minutes.\n\nThe offline field bundle begins around July 27, considerably later than the price history. Development therefore uses **scored times July 28–August 7 and August 8–18**, with August 18–28 reserved for final validation. A daily prompt starts one day before its scored time; the model's fitting cutoff precedes the first development prediction, not merely its score date.\n\nThe two development windows genuinely differ in volatility. Average daily realized RMS for BTC is approximately 1.50% versus 0.96%; for ETH, 2.06% versus 1.28%; for SP500, 0.71% versus 0.44%; and for AAPLX, 2.12% versus 0.96%. These are more-volatile and calmer periods, not claims about bull and bear markets.\n\n### The provisional model\n\nThe current incumbent uses a robust exponentially weighted absolute-return scale. Its half-life is one hour for hourly forecasts and six hours for daily forecasts. A constant latent volatility multiplier per path gives a Student-like, five-degree-of-freedom log-return mixture. There is no directional log-drift forecast.\n\nBoth formats additionally use a small pooled neural volatility model, at full strength daily and half strength hourly. Its 30 inputs summarize eight absolute-return and eight RMS scales, their ratios, the absolute volatility level, and asset identity. A 48/32-unit network predicts a multiplicative volatility correction. Training uses 23,457 contexts before July 1, with 2,508 July 1–25 contexts for chronological model selection. All labels end before July 26. Serving uses exported NumPy weights, not a GPU or a network call.\n\nA positive, smoothed hourly volatility profile is estimated from the supplied past seven days and shrunk 25% toward a flat curve. This is **not a market-session model**: there are no opening/closing times, exchange calendars, weekend switches, or zero-volatility hours. The empirical finding is simply that continuous trading does not imply constant variance throughout a day.\n\nA second small network predicts volatility in five future daily buckets: minutes 0–60, 60–180, 180–360, 360–720 and 720–1440. Its output is normalized to unit mean and applied at half strength. Each clock/lead component has unit mean, but their product generally does not: a small diagnostic finds joint means between 0.9992 and 1.0252. Thus the combined model changes both timing and, modestly, average scale. This actual implementation passes full official reward replay in both development windows; explicit joint normalization is a separate ongoing test.\n\nTimestamp-derived random seeds and shared draws make comparisons reproducible. Representative 1000-path serving checks take a few hundredths of a second, preserve arbitrary positive path counts, tolerate NaN-contaminated contexts, and are invariant to injected rows after the prediction time. Learned weights are not applied before their availability date.\n\nHourly forecasts now additionally use a small temporal convolutional residual over 168 past hourly bins of absolute returns, RMS returns, signed returns and observed coverage. This residual is trained against the frozen static model and exported to NumPy. Direct scrambled Sobol draws replace ordinary draws while preserving the intended five-degree Student scale-mixture family and exactly honoring 1000 paths. Full official reward replay supports both changes together. The implementation is self-contained and does not import Torch at serving time.\n\n## Experiments\n\nThe journal contains preregistered hypotheses, changes, numerical results, and keep/discard decisions. Important findings so far:\n\n| Experiment | Finding |\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_319","type":"command_execution","command":"/bin/bash -c \"apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: /workspace/agent/report.md\n@@\n-A positive, smoothed hourly volatility profile is estimated from the supplied past seven days and shrunk 25% toward a flat curve. This is **not a market-session model**: there are no opening/closing times, exchange calendars, weekend switches, or zero-volatility hours. The empirical finding is simply that continuous trading does not imply constant variance throughout a day.\n+A positive, smoothed daily-clock volatility profile is estimated from the supplied past seven days. Crypto uses 30-minute bins at 0.75 strength; commodities/equities use 15-minute bins at full strength, with shrinkage toward a flat curve. This is **not a market-session model**: there are no opening/closing times, exchange calendars, weekend switches, or zero-volatility hours. The empirical finding is simply that continuous trading does not imply constant variance throughout a day.\n@@\n-Hourly forecasts now additionally use a small temporal convolutional residual over 168 past hourly bins of absolute returns, RMS returns, signed returns and observed coverage. This residual is trained against the frozen static model and exported to NumPy. Direct scrambled Sobol draws replace ordinary draws while preserving the intended five-degree Student scale-mixture family and exactly honoring 1000 paths. Full official reward replay supports both changes together. The implementation is self-contained and does not import Torch at serving time.\n+Both formats now additionally use a small temporal convolutional residual over 168 past hourly bins of absolute returns, RMS returns, signed returns and observed coverage. This residual is trained against the frozen static model and exported to NumPy. Direct scrambled Sobol draws replace ordinary draws while preserving the intended five-degree Student scale-mixture family and exactly honoring 1000 paths. Full official reward replay supports both changes together. The implementation is self-contained and does not import Torch at serving time.\n@@\n-Dense hourly reward replays confirm that small mean-CRPS differences can produce large changes in emissions. The auxiliary OHLCV network and most empirical/discrete-return variants do not pass the consistency gate. Correcting the score-curve objective to raw, asset-weighted CRPS also fails to produce a consistent fitted gain; it remains a methodological correction, not a successful model improvement. Five-minute supervised targets, conditional directional ridge forecasts, forecast-error scale mixtures and context-only moment recalibration are rejected. A finer score-response grid resolves a coarse-surrogate optimization issue, but its development gains still do not transfer consistently. The exact-context temporal residual and Sobol sampler are promoted hourly; finer daily clock profiles remain under full reward confirmation.\n+Dense hourly reward replays confirm that small mean-CRPS differences can produce large changes in emissions. The auxiliary OHLCV network and most empirical/discrete-return variants do not pass the consistency gate. Correcting the score-curve objective to raw, asset-weighted CRPS also fails to produce a consistent fitted gain; it remains a methodological correction, not a successful model improvement. Five-minute supervised targets, conditional directional ridge forecasts, forecast-error scale mixtures and context-only moment recalibration are rejected. A finer score-response grid resolves a coarse-surrogate optimization issue, but its development gains still do not transfer consistently, including the bounded 600-epoch extension. The exact-context temporal residual and Sobol sampler are promoted on both formats; finer daily clock profiles also pass full reward confirmation.\n@@\n-Full official reward replay supports the current hourly-plus-lead-shaped incumbent:\n+Full official reward replay supports the current temporal/Sobol incumbent:\n@@\n-| dev1 | COM_EQU_24H | 239 / 257 | 174 / 257 | 0.000785 |\n+| dev1 | COM_EQU_24H | 239 / 257 | 129 / 257 | 0.014075 |\n@@\n-| dev1 | CRYPTO_24H | 236 / 257 | 97 / 257 | 0.151344 |\n-| dev2 | COM_EQU_24H | 248 / 257 | 230 / 257 | 0.000442 |\n+| dev1 | CRYPTO_24H | 236 / 257 | 62 / 257 | 0.218222 |\n+| dev2 | COM_EQU_24H | 248 / 257 | 216 / 257 | 0.009365 |\n@@\n-| dev2 | CRYPTO_24H | 257 / 257 | 227 / 257 | 0.058647 |\n+| dev2 | CRYPTO_24H | 257 / 257 | 163 / 257 | 0.126951 |\n@@\n-These correspond to development Score estimates **34.052** and **31.044**, versus 0.32375 and 0.42456 for the starter. It is substantial progress, but not cumulative field leadership. The hourly final-round ranks are 60 and 1, distinct from cumulative ranks 25 and 14. Commodity/equity emissions remain particularly weak. Each row uses all official reward rounds for its selected candidate; hourly has 1,624/1,847 post-warmup rounds, daily crypto 1,015/1,044, and COM_EQU 1,499/1,474. Production and research paths match to relative tolerance 1e-12 on representative assets and both formats. The reserved final validation remains untouched.\n+These correspond to development Score estimates **36.724** and **33.618**, versus 0.32375 and 0.42456 for the starter. It is substantial progress, but not cumulative field leadership. The hourly final-round ranks are 60 and 1, distinct from cumulative ranks 25 and 14. Commodity/equity emissions remain particularly weak. Each row uses all official reward rounds for its selected candidate; hourly has 1,624/1,847 post-warmup rounds, daily crypto 1,015/1,044, and COM_EQU 1,499/1,474. Production and research paths match to relative tolerance 1e-12 on representative assets and both formats. The reserved final validation remains untouched.\n*** Update File: /workspace/agent/journal.md\n@@\n # Research journal — campaign-3\n+\n+### Resumption audit and completed calibration extension\n+\n+The promoted daily stack passes production/research agreement at rtol=1e-12 for BTC, HYPE, SP500 and GOOGLX in both formats, including 17/1000 paths, NaNs and future-row invariance. Representative latency is 0.028–0.046 seconds hourly and 0.075–0.083 daily. The 600-epoch calibration extension again fails transfer: half-strength CRPS ratios dev1/dev2 are COM_EQU 0.998685/1.001499, hourly 0.999887/0.999928 and daily crypto 0.999719/1.002424. Full strength worsens every dev2 competition. Final rejection; no more epoch extensions.\n+\n+### Iterations 32–33 first results\n+\n+At every hourly prompt and 1000 paths, lattice projection improves asset-mean relative CRPS to 0.999492/0.999145. Minimum-difference and GCD candidates have identical aggregate scores; the safer GCD candidate proceeds to full official reward confirmation. The refreshed static model improves dev2 daily CRPS slightly over the old-data control: full strength gives COM_EQU 0.998713 versus 0.999199 and crypto 0.999012 versus 0.999491, relative to the stack. Hourly regresses to 1.000468. Continue only daily refresh confirmation; these small one-window gains do not yet justify promotion.\n*** End Patch\nPATCH\ngit add .gitignore agent/modeling.py agent/research.py agent/report.md agent/journal.md agent/refresh_vol.py agent/refresh_weights.npz agent/refresh_weights.json agent/results/daily_half_sobol_template_step1_ranks.json agent/results/daily_refinements_dense_template_step1_ranks.json agent/results/refresh_screen.parquet agent/results/ticked_hourly_dense.parquet && git -c user.name='Campaign Research Agent' -c user.email='campaign-agent@localhost' commit -m 'Promote confirmed daily temporal Sobol stack and audit refresh candidates'\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
