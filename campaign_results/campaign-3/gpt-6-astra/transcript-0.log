/ reference)\n+              for estimator in (absolute, root_square) for half_life in HALF_LIVES]\n+    values += [np.log(reference), *[float(asset == name) for name in ASSETS]]\n+    weights = _weights()\n+    inputs = np.clip((np.asarray(values, dtype=np.float32) - weights[\\\"center\\\"]) / weights[\\\"spread\\\"], -8, 8)\n+    for layer in (0, 2):\n+        inputs = weights[f\\\"{layer}.weight\\\"] @ inputs + weights[f\\\"{layer}.bias\\\"]\n+        inputs = inputs / (1 + np.exp(-inputs))\n+    output = weights[\\\"4.weight\\\"] @ inputs + weights[\\\"4.bias\\\"]\n+    strength = 1.0 if asset in ASSETS[:5] else COMMODITY_EQUITY_BLEND\n+    return float(np.exp(np.clip(output[1], -2, 2) * strength))\n+\n+\n+def simulate(\n+    asset: str,\n+    start_time,\n+    time_increment: int = 300,\n+    time_length: int = 86_400,\n+    num_simulations: int = 1000,\n+    context_prices=None,\n+):\n+    if time_increment <= 0 or time_length < 0 or num_simulations < 1:\n+        raise ValueError(\\\"Positive increment/path count and nonnegative horizon are required\\\")\n+    timestamp = pd.to_datetime(start_time, unit=\\\"s\\\", utc=True) if isinstance(start_time, (int, float)) else pd.Timestamp(start_time)\n+    timestamp = timestamp.tz_localize(\\\"UTC\\\") if timestamp.tzinfo is None else timestamp.tz_convert(\\\"UTC\\\")\n+    if context_prices is None or \\\"close\\\" not in context_prices:\n+        raise ValueError(\\\"A context frame containing close prices is required\\\")\n+    closes = pd.to_numeric(context_prices[\\\"close\\\"], errors=\\\"coerce\\\").copy()\n+    closes.index = pd.to_datetime(closes.index, utc=True)\n+    closes = closes.loc[(closes.index > timestamp - pd.Timedelta(days=7)) & (closes.index <= timestamp)]\n+    closes = closes.loc[np.isfinite(closes) & (closes > 0)].sort_index()\n+    closes = closes.loc[~closes.index.duplicated(keep=\\\"last\\\")]\n+    if closes.empty:\n+        raise ValueError(\\\"No finite positive close exists in the seven-day context\\\")\n+    last = float(closes.iloc[-1])\n+    absolute, root_square = _features(closes, timestamp)\n+    hourly = time_length <= 3600\n+    sigma = absolute[60 if hourly else 360]\n+    if not hourly:\n+        sigma *= _daily_multiplier(absolute, root_square, asset)\n+    sigma *= np.sqrt(time_increment / 60)\n+    seed = int.from_bytes(hashlib.blake2s(f\\\"{asset}:{timestamp}\\\".encode(), digest_size=8).digest(), \\\"little\\\")\n+    rng = np.random.default_rng(seed)\n+    steps = time_length // time_increment\n+    shocks = rng.standard_normal(((num_simulations + 1) // 2, steps))\n+    shocks = np.concatenate([shocks, -shocks], axis=0)[:num_simulations]\n+    shocks *= np.sqrt(3 / rng.chisquare(5, size=(num_simulations, 1)))\n+    log_paths = np.concatenate([np.zeros((num_simulations, 1)), np.cumsum(shocks * sigma, axis=1)], axis=1)\n+    paths = last * np.exp(np.clip(log_paths, -40, 40))\n+    return (start_time, time_increment, *paths.tolist())\n*** End Patch\nPATCH\nuv run python - <<'PY'\nimport sys,time\nsys.path.insert(0,'agent')\nimport numpy as np,pandas as pd\nfrom modeling import simulate\nfrom predict import load_context\nfrom research import features,generate_variant\nfor asset,length,increment in [('BTC',86400,300),('BTC',3600,60),('AAPLX',86400,300),('SP500',86400,300)]:\n timestamp=pd.Timestamp('2026-08-01 12:00',tz='UTC')\n context=load_context(asset,timestamp-pd.Timedelta(days=7)+pd.Timedelta(minutes=1),timestamp)\n started=time.perf_counter()\n output=simulate(asset,timestamp,increment,length,1000,context)\n elapsed=time.perf_counter()-started\n paths=np.asarray(output[2:])\n reference=generate_variant(features(context,timestamp,increment),asset,timestamp,increment,length,1000,'hybrid:0.5')\n assert paths.shape==(1000,length//increment+1)\n assert np.isfinite(paths).all() and (paths>0).all()\n assert np.allclose(paths,reference,rtol=1e-12,atol=1e-12)\n assert (paths[:,0]==context.close.dropna().iloc[-1]).all()\n contaminated=pd.concat([context,pd.DataFrame({'close':[1e9]},index=[timestamp+pd.Timedelta(minutes=1)])])\n assert np.array_equal(paths,np.asarray(simulate(asset,timestamp,increment,length,1000,contaminated)[2:]))\n print(asset,length,'latency',elapsed,'exact candidate agreement; future-row invariance',flush=True)\n context.iloc[::3,:]=np.nan\n sparse=simulate(asset,timestamp,increment,length,17,context)\n assert np.asarray(sparse[2:]).shape==(17,length//increment+1)\n assert np.isfinite(np.asarray(sparse[2:])).all()\nprint('Contract checks passed')\nPY\"","aggregated_output":"BTC 86400 latency 0.061564673989778385 exact candidate agreement; future-row invariance\nBTC 3600 latency 0.033293490996584296 exact candidate agreement; future-row invariance\nTraceback (most recent call last):\n  File \"<stdin>\", line 17, in <module>\nAssertionError\n","exit_code":1,"status":"failed"}}
