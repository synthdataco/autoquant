{"type":"item.started","item":{"id":"item_359","type":"command_execution","command":"/bin/bash -c \"uv run python - <<'PY'\nimport sys\nsys.path.insert(0,'agent')\nimport modeling\nimport numpy as np,pandas as pd\nfrom predict import load_context\nfrom research import features,generate_variant,learned_multiplier\nfrom temporal import temporal_residual,context_sequence\nfrom train_vol import feature_vector\nstamp=pd.Timestamp('2026-08-10 12:00',tz='UTC');context=load_context('BTC',stamp-pd.Timedelta(days=7),stamp)\nf=features(context,stamp,60);close=context.close.loc[context.index>stamp-pd.Timedelta(days=7)].dropna()\nab,rv=modeling._features(close,stamp)\nprint('av',ab[60],f['av'][60]);print('neural',modeling._learned_multiplier(ab,rv,'BTC',True),learned_multiplier(f,'BTC',3600,'neural')**.5)\nprint('temporal',modeling._temporal_adjustment(close,stamp,ab,rv,'BTC'),temporal_residual(context_sequence(context,stamp,f['av'][360]),feature_vector(f,'BTC'),'temporal_exact'))\nmodeling._quote_tick=lambda *args:0\nactual=np.asarray(modeling.simulate('BTC',stamp,60,3600,1000,context)[2:]);expected=generate_variant(f,'BTC',stamp,60,3600,1000,'stacked')\nprint('continuous max',np.max(np.abs(actual-expected)),np.max(np.abs(actual/expected-1)))\nprint('sampling',np.max(np.abs(modeling._sobol_shocks(1000,60,1)-__import__('sampling').mixture_shocks(1000,60,1,'sobol'))))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
