s as pd\n\nfrom predict import AGENT_DIR, load_context, store_root\nfrom research import CRYPTO, EQUITY, features\n\nASSETS = CRYPTO + EQUITY\nHALF_LIVES = [30, 60, 180, 360, 720, 1440, 2880, 10080]\n\n\ndef feature_vector(feature, asset):\n    reference = max(feature['av'][360], 1e-8)\n    values = [np.log(max(feature[estimator][half_life], 1e-9) / reference)\n              for estimator in ['av', 'rv'] for half_life in HALF_LIVES]\n    values += [np.log(reference), *[float(asset == name) for name in ASSETS]]\n    return np.asarray(values, dtype=np.float32)\n\n\ndef make_asset(asset):\n    first = sorted(store_root(asset).glob('date=*.parquet'))[0].stem.removeprefix('date=')\n    start = pd.Timestamp(first, tz='UTC')\n    end = pd.Timestamp('2026-07-26', tz='UTC')\n    prices = load_context(asset, start, end)\n    observed = prices.close.dropna()\n    returns = np.diff(np.log(observed.to_numpy(dtype=float)))\n    gaps = np.diff(observed.index.as_unit('ns').asi8) / 60e9\n    if np.any(gaps < 1):\n        raise ValueError('Minute-grid timestamps have invalid elapsed-time units')\n    normalized = pd.Series(np.abs(returns) / np.sqrt(gaps), index=observed.index[1:]).reindex(prices.index)\n    targets = {}\n    for horizon in [60, 1440]:\n        targets[horizon] = normalized.shift(-1).iloc[::-1].rolling(horizon, min_periods=max(10, horizon//10)).mean().iloc[::-1] * np.sqrt(np.pi / 2)\n    rows, labels, stamps = [], [], []\n    for timestamp in pd.date_range(start + pd.Timedelta(days=7), end - pd.Timedelta(days=1), freq='3h'):\n        context = prices.loc[(prices.index > timestamp - pd.Timedelta(days=7)) & (prices.index <= timestamp)]\n        if context.close.notna().sum() < 50:\n            continue\n        target = [targets[horizon].loc[timestamp] for horizon in [60,1440]]\n        if not np.isfinite(target).all() or min(target) <= 0:\n            continue\n        feature = features(context, timestamp, 60)\n        row = feature_vector(feature, asset)\n        label = np.asarray(target) / [max(feature['av'][60], 1e-8), max(feature['av'][360], 1e-8)]\n        if not np.isfinite(row).all() or not np.isfinite(label).all():\n            continue\n        rows.append(row)\n        labels.append(label)\n        stamps.append(timestamp.value)\n    print(asset, len(rows), flush=True)\n    return np.asarray(rows), np.asarray(labels), np.asarray(stamps)\n\n            learned_scale=incumbent**(1-auxiliary_strength)*learned_multiplier(feature,asset,length,'aux')**auxiliary_strength\n    innovation = parts[0] if parts[0] in [\"iid\", \"sv\", \"boot\"] else None\n    innovation_parameters = parts[1:]\n    if innovation:\n        parts = [\"auto\", \"0\", \"1\"]\n    if parts[0] == \"ml\":\n        learned_scale = learned_multiplier(feature, asset, length, parts[1]) ** float(parts[2])\n        parts = [\"auto\", \"0\", \"1\", \"5\"]\n    if parts[0] == \"revert\":\n        slow_half_life, decay_minutes = int(parts[1]), float(parts[2])\n        initial = feature[\"av\"][30 if length == 3600 else 60]\n        target = feature[\"av\"][slow_half_life]\n        weight = np.exp(-np.arange(1, steps + 1) * increment / 60 / decay_minutes)\n        schedule = np.exp(weight * np.log(initial) + (1 - weight) * np.log(target))\n        parts = [\"auto\", \"0\", \"1\", \"5\"]\n    if parts[0].startswith(\"auto\"):\n        parts[0] = \"av\" + parts[0][4:]\n        parts[1] = \"60\" if length == 3600 else \"360\"\n    if parts[0] == \"starter\":\n        sigma = feature[\"starter\"]\n    else:\n        sigma = feature[parts[0]][int(parts[1])]\n    multiplier = float(parts[2]) if len(parts) > 2 else 1.0\n    sigma *= multiplier * learned_scale * np.sqrt(increment / 60)\n    if range_parameters:\n        half_life = 60 if length==3600 else 360\n        ratio = feature['range'][half_life]*float(range_parameters[1])/max(feature['av'][half_life],1e-8)\n        sigma *= ratio**float(range_parameters[0])\n    if schedule is not None:\n        sigma = schedule * np.sqrt(increment / 60)\n    if cycle_strength and length > 3600:\n        future_times = pd.Timestamp(start_time) + pd.to_timedelta(np.arange(1,steps+1)*increment,unit='s')\n        profile = feature['cycle']\n        if prior_strength:\n            with np.load(AGENT_DIR/'clock_profiles.npz') as archive:\n                profile = (1-prior_strength)*profile + prior_strength*archive[asset]\n        sigma *= 1 + cycle_strength*(profile[future_times.hour]-1)\n    shocks = rng.standard_normal(((count + 1) // 2, steps))\n    shocks = np.concatenate([shocks, -shocks], axis=0)[:count]\n    if correlation_parameter is not None:\n        correlation = np.clip(.5*feature['correlation'],-.25,.25) if correlation_parameter=='auto' else float(correlation_parameter)\n        orthogonal = np.sqrt(1-correlation**2)\n        for step in range(1,steps):\n            shocks[:,step] = correlation*shocks[:,step-1] + orthogonal*shocks[:,step]\n    if atom_mode=='symboot':\n        absolute_returns=np.abs(feature['step_returns'])\n        if len(absolute_returns) and absolute_returns.mean()>0:\n            magnitudes=rng.choice(absolute_returns,size=((count+1)//2,steps))\n            magnitudes=np.concatenate([magnitudes,magnitudes],axis=0)[:count]\n            shocks=np.sign(shocks)*magnitudes/absolute_returns.mean()*np.sqrt(2/np.pi)*atom_parameter\n    if atom_mode=='hurdle':\n        probability=float(np.clip(np.mean(feature['step_returns']==0)*atom_parameter,0,.8))\n        shocks *= (rng.random(shocks.shape)>=probability)/(1-probability)\n    if innovation == \"iid\":\n        degrees = float(innovation_parameters[0])\n        shocks *= np.sqrt((degrees - 2) / rng.chisquare(degrees, size=shocks.shape))\n    elif innovation == \"sv\":\n        spread, persistence = map(float, innovation_parameters)\n        correlation = np.exp(-increment / 60 / persistence)\n        state = rng.standard_normal(count) * spread\n        for step in range(steps):\n            state = correlation * state + np.sqrt(1-correlation**2) * spread * rng.standard_normal(count)\n            shocks[:,step] *= np.exp(state-spread**2)\n    elif innovation == \"boot\":\n        empirical = feature['returns']\n        sampled = rng.choice(empirical, size=shocks.shape)\n        sampled = sampled - np.mean(empirical)\n        shocks = sampled / max(np.std(empirical), 1e-9)\n    if len(parts) > 3:\n        degrees = float(shape_parameters[0]) if shape_parameters else float(parts[3])\n        if shape_parameters:\n    args = parser.parse_args()\n    print((AGENT_DIR / \"BUDGET.md\").read_text(), flush=True)\n    variants = args.variants.split(\",\")\n    tasks = [(asset, length, window, variants, args.paths, args.stride_high if length == 3600 else args.stride_low)\n             for window in args.windows.split(\",\") for asset in args.assets.split(\",\")\n             for length in ([86400, 3600] if asset in CRYPTO else [86400])\n             if args.format=='all' or (args.format=='low' and length==86400) or (args.format=='high' and length==3600)]\n    with ProcessPoolExecutor(max_workers=args.workers) as executor:\n        results = list(executor.map(evaluate_asset, tasks))\n    result = pd.DataFrame([row for batch in results for row in batch])\n    target = AGENT_DIR / \"results\" / f\"{args.name}.parquet\"\n    target.parent.mkdir(parents=True, exist_ok=True)\n    result.to_parquet(target)\n    print(result.groupby([\"window\", \"length\", \"asset\", \"variant\"]).crps.mean().to_string(), flush=True)\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"Self-evaluation via the official synth-lib backtester.\n\nUsage: uv run agent/predict.py --asset BTC --days 3 --eval-end 2026-07-15\nGenerates predictions from agent/modeling.py over a grid of past prompts (covered by the\nsnapshot), writes them in the standard format, then scores them with backtest() (validator\nCRPS + rank vs the real field via the Synth API).\n\n--num-simulations defaults to 1000, matching the validator's real serving size\n(PromptConfig.num_simulations). Lowering it (e.g. for a quick local iteration loop) speeds up\ngeneration at the cost of a slightly pessimistic CRPS: empirical CRPS is biased upward for\nfewer sampled paths, and the real field's CRPS was computed at 1000.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport sys\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nimport pandas as pd\n\nfrom synth_lib.backtester.orchestration import backtest\nfrom synth_lib.backtester.loading import get_miner_scores\nfrom synth_lib.backtester.config import competition_for\nfrom synth_lib.backtester.scoring import calculate_crps_for_miner\nfrom synth_lib.backtester.scoring import _compute_prompt_score_stats_for_group\nfrom synth_lib.backtester.scoring import compute_combined_smoothed_scores, _trim_warmup\nfrom synth_lib.backtester.result import BacktestResult\nfrom synth_lib.preparation.config import OHLCV_COLUMNS, STORE_SUBDIR\nfrom synth_lib.preparation.market_data import MinutePriceStore\n\n# All paths are resolved from the location of THIS file, never from the cwd: the\n# script therefore works whether launched from the workspace root (`uv run agent/predict.py`)\n# or from agent/. The price snapshot is mounted at the workspace root, not inside agent/.\nAGENT_DIR = Path(__file__).resolve().parent\nWORKSPACE = AGENT_DIR.parent\nsys.path.insert(0, str(AGENT_DIR))\n\nfrom modeling import simulate  # noqa: E402  (import after adding AGENT_DIR to sys.path)\n\nCONTEXT_MINUTES = 7 * 24 * 60\nPREDICTIONS_DIR = WORKSPACE / \"miner_outputs\" / \"campaign\" / \"predictions\"\nCUTOFF = pd.Timestamp(\"2026-08-29\", tz=\"UTC\")\n_COMBINED_CONTEXT = None\n\n\ndef _initialize_combined(results, competition):\n    global _COMBINED_CONTEXT\n    _COMBINED_CONTEXT = (results, competition)\n\n\ndef _combined_chunk(timestamps):\n    results, competition = _COMBINED_CONTEXT\n    selected = [BacktestResult(result.miner_name,result.prompt_df,\n                               pd.DataFrame({'updated_at':timestamps if index==0 else []}),result.summary)\n                for index,result in enumerate(results)]\n    return compute_combined_smoothed_scores(selected,competition)\n\n\ndef parallel_combined(results, competition, workers=4):\n    import numpy as np\n\n    timestamps = sorted({pd.Timestamp(timestamp) for result in results\n                         for timestamp in result.smoothed_scores['updated_at'].unique()})\n    if workers <= 1 or len(timestamps) < 8:\n        return compute_combined_smoothed_scores(results,competition)\n    chunks = [chunk.tolist() for chunk in np.array_split(np.array(timestamps,dtype=object),workers) if len(chunk)]\n    with ProcessPoolExecutor(max_workers=workers,initializer=_initialize_combined,initargs=(results,competition)) as executor:\n        frames = list(executor.map(_combined_chunk,chunks))\n    combined = pd.concat(frames,ignore_index=True).sort_values(['updated_at','miner_uid'])\n    scored_times = pd.concat([result.prompt_df[['scored_time']] for result in results],ignore_index=True)\n    return _trim_warmup(combined,scored_times,warmup_days=competition.window_days).reset_index(drop=True)\n\n\ndef score_paths(paths, realized, time_increment, asset, time_length):\n    import numpy as np\n\n    competition = competition_for(asset, time_length)\n    return calculate_crps_for_miner(\n        np.asarray(paths, dtype=float), np.asarray(realized, dtype=float),\n        time_increment, competition.scoring_intervals,\n","exit_code":0,"status":"completed"}}
