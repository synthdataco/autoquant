{"type":"item.started","item":{"id":"item_257","type":"command_execution","command":"/bin/bash -c \"uv run python - <<'PY'\nimport sys\nsys.path.insert(0,'agent')\nimport pandas as pd\nfrom pathlib import Path\nfrom research import CRYPTO,EQUITY\nfrom synth.validator.moving_average import ASSET_COEFFICIENTS\nscores=pd.read_parquet('agent/results/lead_dense.parquet')\nrows=[]\nfor window in ['dev1','dev2']:\n    folder=Path('agent/results/neural_cycle_full')/window\n    for competition,assets in [('com-equ-24h',EQUITY),('crypto-24h',CRYPTO)]:\n        combined=pd.read_parquet(folder/f'{competition}_combined.parquet')\n        totals=combined.loc[combined.miner_uid.ne(999)].groupby('miner_uid').reward_weight.sum()\n        best=totals.idxmax()\n        for asset in assets:\n            field=pd.read_parquet(folder/f'{asset}_86400_prompts.parquet')\n            reference=field.loc[field.miner_uid.eq(best)&field.crps.ge(0),['start_time','crps']]\n            candidate=scores.loc[scores.window.eq(window)&scores.asset.eq(asset)&scores.variant.eq('lead:0.5'),['time','crps']]\n            paired=candidate.merge(reference,left_on='time',right_on='start_time',suffixes=('_agent','_field'))\n            rows.append({'window':window,'competition':competition,'asset':asset,'overlap':len(paired),'ratio':paired.crps_agent.mean()/paired.crps_field.mean(),'weighted_gap':(paired.crps_agent-paired.crps_field).mean()*ASSET_COEFFICIENTS[asset]})\nprint(pd.DataFrame(rows).sort_values(['window','competition','weighted_gap'],ascending=[True,True,False]).to_string(index=False))\nframe=pd.read_parquet('agent/results/uncertainty_screen.parquet')\nmeans=frame.groupby(['window','length','asset','variant']).crps.mean().unstack()\nratios=means.div(means['lead:0.5'],axis=0)\nratios['competition']=['crypto-1h' if idx[1]==3600 else 'crypto-24h' if idx[2] in CRYPTO else 'com-equ-24h' for idx in ratios.index]\nprint(ratios.groupby(['window','competition']).mean().to_string())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
