 = {}\n        for (asset,length),group in window_frame.groupby(['asset','length']):\n            increment = 60 if length == 3600 else 300\n            field = get_miner_scores(begin,end,asset,int(length),increment)\n            fields[(asset,length)] = field.loc[field.start_time.isin(group.time.unique())]\n        for variant,variant_frame in window_frame.groupby('variant'):\n            groups = {}\n            for (asset,length),rows in variant_frame.groupby(['asset','length']):\n                config = competition_for(asset,int(length))\n                candidate = rows[['time','crps']].rename(columns={'time':'start_time'}).copy()\n                candidate['scored_time'] = candidate.start_time + pd.Timedelta(seconds=int(length))\n                candidate['miner_uid'] = 999\n                candidate['asset'] = asset\n                candidate['time_length'] = int(length)\n                candidate['time_increment'] = config.time_increment\n                scored = replay_prompt_scores(fields[(asset,length)],candidate)\n                rounds = pd.DataFrame({'updated_at':[end-pd.Timedelta(seconds=1)]})\n                if args.template:\n                    source = AGENT_DIR/'results'/args.template/window/f'{asset}_{length}_smoothed.parquet'\n                    rounds = pd.read_parquet(source,columns=['updated_at']).drop_duplicates().sort_values('updated_at').iloc[::args.round_step]\n                result = BacktestResult(variant,scored,rounds,{})\n                groups.setdefault(slug_for(config),(config,[]))[1].append(result)\n            for slug,(config,results) in groups.items():\n                combined = parallel_combined(results,config,workers=args.workers)\n                summary = reward_summary(combined)\n                key = f'{window}/{variant}/{slug}'\n                summaries[key] = summary\n                print(key,summary,flush=True)\n    suffix = 'sampled_ranks' if not args.template else f'template_step{args.round_step}_ranks'\n    (AGENT_DIR/'results'/f'{args.experiment}_{suffix}.json').write_text(json.dumps(summaries,indent=2))\n\n\nif __name__=='__main__':\n    main()\n53:    if kind=='refresh':\n54:        filename='refresh_weights.npz'\n147:    stacked_mode = parts[0] in ['stacked','refresh','refresh_old']\n148:    refresh_strength = float(parts[1]) if parts[0] in ['refresh','refresh_old'] else None\n149:    refresh_kind = 'refit_recent60' if parts[0]=='refresh_old' else 'refresh'\n154:    lead_strength=.5 if stacked_mode or parts[0] in ['location','periodic','uncertainty','clock','sharp','adaptive','calibration','calibration600','ticked'] else float(parts[2]) if parts[0] in ['combined','combined_exact'] else float(parts[1]) if parts[0]=='lead' else None\n155:    sampler='sobol' if stacked_mode or parts[0]=='ticked' else parts[5] if parts[0]=='sharp' and len(parts)>5 else parts[3] if parts[0] in ['combined','combined_exact'] and len(parts)>3 else parts[1] if parts[0]=='sampler' else None\n157:    temporal_strength=1. if stacked_mode or parts[0]=='ticked' else float(parts[2]) if parts[0]=='sharp' else float(parts[1]) if parts[0] in ['temporal','temporal_exact','combined','combined_exact'] else None\n158:    temporal_kind='temporal_exact' if stacked_mode or parts[0] in ['temporal_exact','combined_exact','sharp','ticked'] else 'temporal'\n161:    periodic_strength=float(parts[1]) if parts[0]=='periodic' else None\n163:    clock_parameters=(['48','.75','.25'] if asset in CRYPTO else ['96','1','.25']) if stacked_mode else [parts[1],parts[3],'0.25'] if parts[0]=='sharp' else parts[1:] if parts[0]=='clock' else None\n169:    tuned_mode=parts[0] in ['tuned','resample'] or lead_strength is not None or sampler is not None or fiveminute_strength is not None or temporal_strength is not None or ensemble_strength is not None\n170:    tick_kind=parts[1] if parts[0]=='ticked' else 'min'\n171:    atom_mode='quantize' if parts[0]=='ticked' else parts[0] if parts[0] in ['symboot','hurdle','quantize'] else None\n172:    atom_parameter=1. if parts[0]=='ticked' else float(parts[1]) if atom_mode else 0.\n216:        if refresh_strength is not None and pd.Timestamp(start_time)>=pd.Timestamp('2026-08-07',tz='UTC'):\n217:            refreshed = learned_multiplier(feature,asset,length,refresh_kind)**(.5 if length==3600 else 1.)\n218:            learned_scale *= (refreshed/incumbent)**refresh_strength\n228:        if periodic_strength is not None:\n229:            from periodic import periodic_multiplier\n231:            learned_scale *= periodic_multiplier((CRYPTO+EQUITY).index(asset),start_time,length)**periodic_strength\n235:        if temporal_strength is not None:\n236:            from temporal import context_sequence, temporal_residual\n239:            if 'temporal' not in feature:\n240:                feature['temporal'] = context_sequence(feature['context'],start_time,max(feature['av'][360],1e-8))\n241:            residual = temporal_residual(feature['temporal'],feature_vector(feature,asset),temporal_kind)\n242:            learned_scale *= np.exp(temporal_strength*residual[0 if length==3600 else 1])\n","exit_code":0,"status":"completed"}}
