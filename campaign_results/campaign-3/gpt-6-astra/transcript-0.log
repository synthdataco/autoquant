says this pretrained volatility representation adds no validated benefit with the tested small calibration.\n*** End Patch\nPATCH\nuv run python - <<'PY'\nimport sys,time\nsys.path.insert(0,'agent')\nimport numpy as np,pandas as pd\nfrom predict import load_context\nfrom modeling import simulate\nfrom research import features,generate_variant\nstamp=pd.Timestamp('2026-08-10 12:00',tz='UTC')\nfor asset in ['BTC','ETH','SOL','XRP','HYPE','SP500']:\n context=load_context(asset,stamp-pd.Timedelta(days=7),stamp)\n for length,increment in [(3600,60),(86400,300)]:\n  feature=features(context,stamp,increment)\n  variant='ticked:gcd' if length==3600 else 'stacked'\n  expected=generate_variant(feature,asset,stamp,increment,length,1000,variant)\n  started=time.perf_counter(); actual=np.asarray(simulate(asset,stamp,increment,length,1000,context)[2:]);latency=time.perf_counter()-started\n  np.testing.assert_allclose(actual,expected,rtol=1e-12,atol=0)\n  assert actual.shape==(1000,length//increment+1) and np.isfinite(actual).all() and (actual>0).all()\n  altered=context.copy();altered.iloc[::13]=np.nan\n  altered.loc[stamp+pd.Timedelta(minutes=1)]=1e20\n  forecast=np.asarray(simulate(asset,stamp,increment,length,17,altered)[2:])\n  assert forecast.shape==(17,length//increment+1) and np.isfinite(forecast).all() and (forecast>0).all()\n  np.testing.assert_array_equal(forecast,np.asarray(simulate(asset,stamp,increment,length,17,altered.loc[:stamp])[2:]))\n  print(asset,length,'match, contract',round(latency,4),flush=True)\nPY\"","aggregated_output":"Traceback (most recent call last):\n  File \"<stdin>\", line 15, in <module>\n  File \"/workspace/.venv/lib/python3.12/site-packages/numpy/testing/_private/utils.py\", line 1711, in assert_allclose\n    assert_array_compare(compare, actual, desired, err_msg=str(err_msg),\n  File \"/workspace/.venv/lib/python3.12/site-packages/numpy/testing/_private/utils.py\", line 919, in assert_array_compare\n    raise AssertionError(msg)\nAssertionErr