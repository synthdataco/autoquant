 136, 'final_rank': 188, 'miners': 257, 'reward_ratio': 0.40590585280285213, 'reward_rounds': 235, 'first_round': '2026-08-02 00:04:00+00:00', 'last_round': '2026-08-06 23:50:00+00:00'}\ndev2/auto:0:0.97:5/crypto-1h {'reward_rank': 202, 'final_rank': 186, 'miners': 257, 'reward_ratio': 0.38822357331384827, 'reward_rounds': 224, 'first_round': '2026-08-13 00:06:00+00:00', 'last_round': '2026-08-17 23:57:00+00:00'}\ndev2/auto:0:1.03:5/crypto-1h {'reward_rank': 197, 'final_rank': 180, 'miners': 257, 'reward_ratio': 0.4980121748362562, 'reward_rounds': 224, 'first_round': '2026-08-13 00:06:00+00:00', 'last_round': '2026-08-17 23:57:00+00:00'}\ncrypto-1h {'reward_rank': 136, 'final_rank': 192, 'miners': 257, 'reward_ratio': 0.36839393813931304, 'reward_rounds': 1624, 'first_round': '2026-08-02 00:04:00+00:00', 'last_round': '2026-08-06 23:59:00+00:00', 'assets': 5}\ncrypto-24h {'reward_rank': 118, 'final_rank': 165, 'miners': 257, 'reward_ratio': 0.13562590060910898, 'reward_rounds': 1015, 'first_round': '2026-07-28 00:13:00+00:00', 'last_round': '2026-08-06 23:59:00+00:00', 'assets': 5}\n{'com-equ-24h': {'reward_rank': 174, 'final_rank': 170, 'miners': 257, 'reward_ratio': 0.0004981394331382088, 'reward_rounds': 1499, 'first_round': '2026-07-28 00:13:00+00:00', 'last_round': '2026-08-06 23:50:00+00:00', 'assets': 8}, 'crypto-1h': {'reward_rank': 136, 'final_rank': 192, 'miners': 257, 'reward_ratio': 0.36839393813931304, 'reward_rounds': 1624, 'first_round': '2026-08-02 00:04:00+00:00', 'last_round': '2026-08-06 23:59:00+00:00', 'assets': 5}, 'crypto-24h': {'reward_rank': 118, 'final_rank': 165, 'miners': 257, 'reward_ratio': 0.13562590060910898, 'reward_rounds': 1015, 'first_round': '2026-07-28 00:13:00+00:00', 'last_round': '2026-08-06 23:59:00+00:00', 'assets': 5}, 'score_estimate': 16.81726593938534}\ncom-equ-24h {'reward_rank': 231, 'final_rank': 223, 'miners': 257, 'reward_ratio': 0.00015595615408062132, 'reward_rounds': 1474, 'first_round': '2026-08-08 00:03:00+00