amps = pd.to_datetime(data['timestamps'][mask], utc=True)\n+    prices = load_context(asset, timestamps.min() - pd.Timedelta(minutes=10), pd.Timestamp('2026-07-26', tz='UTC'))\n+    observed = prices.close.dropna()\n+    gaps = np.diff(observed.index.as_unit('ns').asi8) / 60e9\n+    normalized = pd.Series(np.abs(np.diff(np.log(observed.to_numpy()))) / np.sqrt(gaps), index=observed.index[1:]).reindex(prices.index)\n+    labels = []\n+    for begin, end in zip(EDGES[:-1], EDGES[1:]):\n+        width = int(end - begin)\n+        future = normalized.shift(-int(begin + 1)).iloc[::-1].rolling(width, min_periods=max(10, width // 10)).mean().iloc[::-1]\n+        labels.append(future.reindex(timestamps).to_numpy() * np.sqrt(np.pi / 2))\n+    targets = np.stack(labels, axis=1) / np.exp(inputs[:, 16:17])\n+    valid = np.isfinite(targets).all(axis=1) & (targets > 0).all(axis=1)\n+    print(asset, int(valid.sum()), flush=True)\n+    return inputs[valid], targets[valid], timestamps.as_unit('ns').asi8[valid]\n+\n+\n+def main():\n+    ensure_workspace_cwd()\n+    print((AGENT_DIR / 'BUDGET.md').read_text(), flush=True)\n+    dataset = AGENT_DIR / 'results' / 'lead_training.npz'\n+    if not dataset.exists():\n+        with ProcessPoolExecutor(max_workers=4) as executor:\n+            batches = list(executor.map(make_asset, ASSETS))\n+        np.savez(dataset, inputs=np.concatenate([batch[0] for batch in batches]),\n+                 targets=np.concatenate([batch[1] for batch in batches]),\n+                 timestamps=np.concatenate([batch[2] for batch in batches]))\n+    data = np.load(dataset)\n+    inputs, targets, timestamps = data['inputs'], np.clip(data['targets'], .02, 20), data['timestamps']\n+    previous = dict(np.load(AGENT_DIR / 'volatility_weights.npz'))\n+    training = timestamps < pd.Timestamp('2026-07-01', tz='UTC').value\n+    torch.set_num_threads(4)\n+    torch.manual_seed(73)\n+    device = 'cuda' if torch.cuda.is_available() else 'cpu'\n+    if device == 'cuda':\n+        torch.cuda.set_per_process_memory_fraction(.35)\n+    standardized = np.clip((inputs - previous['center']) / previous['spread'], -8, 8)\n+    values = torch.tensor(standardized, dtype=torch.float32, device=device)\n+    labels = torch.tensor(targets, dtype=torch.float32, device=device)\n+    weights = torch.tensor(np.diff(EDGES) / EDGES[-1], dtype=torch.float32, device=device)\n+    network = nn.Sequential(nn.Linear(30, 48), nn.SiLU(), nn.Linear(48, 32), nn.SiLU(), nn.Linear(32, 5)).to(device)\n+    with torch.no_grad():\n+        for layer in [0, 2]:\n+            network[layer].weight.copy_(torch.tensor(previous[f'{layer}.weight'], device=device))\n+            network[layer].bias.copy_(torch.tensor(previous[f'{layer}.bias'], device=device))\n+        network[4].weight.copy_(torch.tensor(np.repeat(previous['4.weight'][1:2], 5, axis=0), device=device))\n+        network[4].bias.copy_(torch.tensor(np.repeat(previous['4.bias'][1], 5), device=device))\n+    optimizer = torch.optim.AdamW(network.parameters(), lr=.0005, weight_decay=.04)\n+    indices = torch.tensor(np.flatnonzero(training), device=device)\n+    validation = torch.tensor(np.flatnonzero(~training), device=device)\n+\n+    def loss_for(selected, regularize=False):\n+        logs = network(values[selected]).clamp(-2, 2)\n+        loss = ((labels[selected] * torch.exp(-logs) + logs) * weights).sum(axis=1).mean()\n+        if regularize:\n+            loss = loss + .02 * logs.square().mean() + .02 * torch.diff(logs, dim=1).square().mean()\n+        return loss\n+\n+    initial = float(loss_for(validation).detach().cpu())\n+    best, best_epoch = initial, -1\n+    best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n+    for epoch in range(180):\n+        for batch in indices[torch.randperm(len(indices), device=device)].split(1024):\n+            optimizer.zero_grad()\n+            loss_for(batch, True).backward()\n+            optimizer.step()\n+        with torch.no_grad():\n+            loss = float(loss_for(validation).cpu())\n+        if loss < best:\n+            best, best_epoch = loss, epoch\n+            best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n+        if epoch % 30 == 0:\n+            print(epoch, loss, best, flush=True)\n+    np.savez(AGENT_DIR / 'lead_weights.npz', center=previous['center'], spread=previous['spread'], edges=EDGES, **best_state)\n+    metrics = {'initial_validation_loss': initial, 'best_validation_loss': best, 'best_epoch': best_epoch,\n+               'training_rows': int(training.sum()), 'validation_rows': int((~training).sum()),\n+               'target_cutoff': '2026-07-26', 'validation_start': '2026-07-01', 'edges_minutes': EDGES.tolist()}\n+    (AGENT_DIR / 'lead_weights.json').write_text(json.dumps(metrics, indent=2))\n+    print(metrics, flush=True)\n+\n+\n+if __name__ == '__main__':\n+    main()\n*** Update File: /workspace/.gitignore\n@@\n agent/results/auxiliary_training.npz\n+agent/results/lead_training.npz\n*** End Patch\nPATCH\nuv run agent/train_lead.py > agent/train_lead.log 2>&1\"","aggregated_output":"","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_174","type":"command_execution","command":"/bin/bash -c \"cat agent/report.md; tail -15 agent/train_lead.log; cat agent/BUDGET.md; sed -n '1,150p' .venv/lib/python3.12/site-packages/synth/validator/moving_average.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_174","type":"command_execution","command":"/bin/bash -c \"cat agent/report.md; tail -15 agent/train_lead.log; cat agent/BUDGET.md; sed -n '1,150p' .venv/lib/python3.12/site-packages/synth/validator/moving_average.py\"","aggregated_output":"# Better volatility forecasts are not the same as better miner rewards\n\n**Status: interim research report. The campaign is active; no champion has been nominated.**\n\n## Context\n\nSynth SN50 asks a miner for a fan of future prices, not a single price target. This campaign covers all three competitions: five crypto assets at one-minute resolution for one hour, the same assets at five-minute resolution for one day, and eight live commodity/equity assets at five-minute resolution for one day. SPYX is retired and is not modeled or evaluated.\n\nEvery served prompt must contain the requested number of paths—1000 in the validator—and include the observed starting price. The daily and hourly shapes are therefore 1000 by 289 and 1000 by 61. Prices come only from the frozen snapshot, whose research cutoff is August 29, 2026. Nothing from the subsequent evaluation period is used.\n\nThe distinction between CRPS and emissions matters. The validator converts per-prompt CRPS into relative prompt scores, applies asset coefficients, smooths scores, and uses a softmax. An arithmetic average of CRPS across assets is not the campaign objective. The campaign's Score is 100 times the mean of the three capped reward ratios to each competition's best field miner.\n\nIn the pinned code, valid prompt scores are specifically **raw CRPS minus the prompt minimum**. There is no percentile-range division or capping of valid scores; the 95th percentile fills missed responses only. This distinction is important when designing a training loss. Per-prompt division by a realized baseline score is not equivalent to the validator's rule.\n\nThe implementation is anchored to synth-lib commit `782a44fe7585a4e7b0388e22b99c57f13d56f5ee` and its pinned synth-subnet dependency `0d014cbcec376b28e887403b84025ebf1a89f60e`. The source-of-truth functions are `calculate_crps_for_miner`, `compute_prompt_scores`, and `compute_smoothed_score`; scoring and ranking are invoked through `agent/predict.py` and `synth_lib.backtester`, never through a substitute scoring formula.\n\n## Approach\n\n### Start with trustworthy evaluation\n\nThe starter's context loader was strict and rejected legitimate NaNs. It now reads existing parquet partitions directly, preserves missing observations, checks coverage before evaluation, and uses exact archived prompt timestamps. It never repairs missing market prices by interpolation. The current model drops invalid closes and scales returns spanning gaps by the square root of elapsed minutes.\n\nThe offline field bundle begins around July 27, considerably later than the price history. Development therefore uses **scored times July 28–August 7 and August 8–18**, with August 18–28 reserved for final validation. A daily prompt starts one day before its scored time; the model's fitting cutoff precedes the first development prediction, not merely its score date.\n\nThe two development windows genuinely differ in volatility. Average daily realized RMS for BTC is approximately 1.50% versus 0.96%; for ETH, 2.06% versus 1.28%; for SP500, 0.71% versus 0.44%; and for AAPLX, 2.12% versus 0.96%. These are more-volatile and calmer periods, not claims about bull and bear markets.\n\n### The provisional model\n\nThe current incumbent uses a robust exponentially weighted absolute-return scale. Its half-life is one hour for hourly forecasts and six hours for daily forecasts. A constant latent volatility multiplier per path gives a Student-like, five-degree-of-freedom log-return mixture. There is no directional log-drift forecast.\n\nDaily forecasts additionally use a small pooled neural volatility model. Its 30 inputs summarize eight absolute-return and eight RMS scales, their ratios, the absolute volatility level, and asset identity. A 48/32-unit network predicts a multiplicative volatility correction. Training uses 23,457 contexts before July 1, with 2,508 July 1–25 contexts for chronological model selection. All labels end before July 26. Serving uses exported NumPy weights, not a GPU or a network call.\n\nA positive, smoothed hourly volatility profile is estimated from the supplied past seven days and shrunk 25% toward a flat curve. This is **not a market-session model**: there are no opening/closing times, exchange calendars, weekend switches, or zero-volatility hours. The empirical finding is simply that continuous trading does not imply constant variance throughout a day.\n\nTimestamp-derived random seeds and shared draws make comparisons reproducible. Representative 1000-path serving checks take a few hundredths of a second, preserve arbitrary positive path counts, tolerate NaN-contaminated contexts, and are invariant to injected rows after the prediction time. Learned weights are not applied before their availability date.\n\n## Experiments\n\nThe journal contains preregistered hypotheses, changes, numerical results, and keep/discard decisions. Important findings so far:\n\n| Experiment | Finding |\n|---|---|\n| Recent RMS versus absolute-return volatility | Robust recent scale wins consistently; the seven-day starter adapts too slowly. |\n| One-hour versus six-hour memory | Hourly and daily formats need different memories. A short daily memory overreacts. |\n| Gaussian versus Student path mixtures | A modest heavy-tailed mixture improves calibration; extreme dispersion does not. |\n| Five-/15-/30-minute calibration returns | No universal improvement over the minute-based robust estimator. |\n| Hand-designed volatility reversion | Small, inconsistent gains; not retained. |\n| Pooled neural forecasting | Material daily gains, but the full hourly correction does not improve mean CRPS. |\n| IID tails, stochastic volatility, empirical bootstrap | The tested more complicated dynamics do not beat the simple mixture consistently. |\n| Official-score-curve fine-tuning | 95,750 official training scores produce only a tiny interpolation-loss gain that does not transfer consistently. |\n| Positive local periodic profile | Improves both daily competitions across both development regimes. |\n| Moment-matched tail grids | No consistent material improvement over the incumbent mixture. |\n| Historical profile prior and alternative short memories | Added complexity has negligible or mixed gains. |\n| Recency-weighted neural refitting | Small, consistent CRPS gains; retained for reward-based confirmation, not automatically adopted. |\n| Serial return correlation | Estimated correlation is essentially a null result; fixed correlations overfit regimes. |\n| Direct high/low range substitution | Does not transfer consistently; a fixed diffusion-based range calibration is inadequate. |\n\nTwo ongoing investigations deserve attention. First, dense hourly reward replays suggest that small mean-CRPS differences can produce large changes in emissions. Second, the snapshot contains nonmissing, internally coherent OHLCV data despite its close-only description. An auxiliary-feature model and discrete-return models are being tested; neither is yet accepted.\n\nAn implementation failure is included rather than hidden: the first training-label build treated microsecond timestamps as nanoseconds, inflating scale ratios by the square root of 1000. Target-distribution checks caught it before any learned candidate was scored. Those artifacts were discarded, timestamp units were made explicit, and training was rebuilt.\n\n## Results\n\nFull 1000-path starter replays produce Score estimates **0.32375** and **0.42456** on the two development windows.\n\nThe full incumbent replay has completed the first window:\n\n| Competition | Starter reward rank | Incumbent reward rank | Incumbent reward / best field reward |\n|---|---:|---:|---:|\n| COM_EQU_24H | 239 / 257 | 174 / 257 | 0.000498 |\n| CRYPTO_1H | 216 / 257 | 136 / 257 | 0.368394 |\n| CRYPTO_24H | 236 / 257 | 118 / 257 | 0.135626 |\n\nThis corresponds to a Score estimate of **16.8173**, versus 0.32375 for the starter. It is substantial progress, but not field leadership. Commodity/equity emissions remain particularly weak. The second incumbent replay, hourly finalist selection, and the reserved final validation are not yet complete; their results must not be inferred from this table.\n\nThese are historical reward estimates, not the campaign's eventual post-cutoff Score. Sampled terminal-rank diagnostics and reward-round-thinned screens are explicitly labeled and are not substituted for full final replay.\n\n## Limitations\n\n- The effective validation sample consists of market days and regimes, not thousands of independent prompt observations. Overlapping horizons create dependence.\n- Many hypotheses are screened on the same development windows. The reserved final window remains necessary, and small grid gains may be selection noise.\n- The pinned configuration uses ten-day daily and five-day hourly smoothing windows. Default backtester warmup trimming therefore gives different effective reward intervals; reports must state those intervals rather than repeat the campaign prose's 24-hour description.\n- The official backtester may replace NaN-holed realized paths with cached validator truth. This behavior is preserved, not silently altered.\n- A context with no finite positive close cannot supply the required starting price; the model raises a clear error instead of inventing one.\n- The frozen-data interface does not provide contemporaneous cross-asset information or external news. Additional information used by live miners may not be reproducible here.\n- A bounded historical score-only API probe returned out-of-request timestamps and was rejected before any score analysis or storage. Evaluation remains strictly offline, with a fail-closed environment check.\n\n## What we would do with more budget\n\nThe campaign still has budget and is continuing. Priorities are to finish emission-sensitive hourly selection, evaluate optional candle/activity information and discrete return distributions, investigate whether a learned lead-time volatility profile adds value, and consider strictly chronological field-aware calibration. Any additional fitted checkpoint must be available before the predictions it evaluates. Final nomination requires a frozen model, a full 1000-path field replay, interface checks, and committed artifacts—not an attractive development-only CRPS table.\nGOOGLX 1829\nNVDAX 1968\nHYPE 2809\nSPCX 497\nTSLAX 1962\nWTIOIL 1397\nAAPLX 1514\nSP500 977\n0 1.011484980583191 1.011484980583191\n30 0.9997715950012207 0.9992018342018127\n60 0.9986875057220459 0.9983533024787903\n90 0.9985689520835876 0.9983533024787903\n120 0.998803436756134 0.9980275630950928\n150 0.9981963634490967 0.997591495513916\n{'initial_validation_loss': 1.013794183731079, 'best_validation_loss': 0.9973704814910889, 'best_epoch': 168, 'training_rows': 23337, 'validation_rows': 2508, 'target_cutoff': '2026-07-26', 'validation_start': '2026-07-01', 'edges_minutes': [0, 60, 180, 360, 720, 1440]}\n# BUDGET — maintained by the harness (read-only for you)\n\n- Credits: 22.65 / 100.00 USD (23%)\n- Time   : 1.5 h elapsed, 16.5 h remaining (8%)\n- Phase  : normal\nfrom datetime import datetime\nimport typing\n\n\nimport numpy as np\nimport pandas as pd\nfrom pandas import DataFrame\nimport bittensor as bt\n\n\nfrom synth.utils.logging import print_execution_time\nfrom synth.validator.miner_data_handler import MinerDataHandler\nfrom synth.validator.competition_config import CompetitionConfig\nfrom synth.validator.competition_config import SMOOTHED_SCORE_COEFFICIENT\nfrom synth.validator.reward import compute_softmax\n\n# Per-asset weighting coefficients for score normalization across assets.\n# Higher coefficient = asset scores contribute more to the smoothed score.\nASSET_COEFFICIENTS = {\n    \"BTC\": 1.0,\n    \"ETH\": 0.7064366394033871,\n    \"XAU\": 1.7370922597118699,\n    \"SOL\": 0.6310037175639559,\n    \"SPYX\": 3.437935601155441,\n    \"SP500\": 3.437935601155441,\n    \"NVDAX\": 1.6028217601617174,\n    \"TSLAX\": 1.6068755936957768,\n    \"AAPLX\": 2.0916380815843123,\n    \"GOOGLX\": 1.6827392777257926,\n    \"XRP\": 0.5658394110809131,\n    \"HYPE\": 0.4784547133706857,\n    \"WTIOIL\": 0.8475062847978935,\n    \"SPCX\": 0.4329342627683478,\n}\n\n\n@print_execution_time\ndef prepare_df_for_moving_average(df):\n    \"\"\"Prepare miner scores for moving average computation.\n\n    For miners that joined after the earliest scored_time in the window,\n    backfills missing earlier timestamps with the worst score (percentile95 - lowest_score)\n    so they are not unfairly advantaged by having fewer data points.\n\n    Miners present from the start keep only their real scores (no backfill).\n    \"\"\"\n    df = df.copy()\n    df[\"scored_time\"] = pd.to_datetime(df[\"scored_time\"])\n\n    global_min = df[\"scored_time\"].min()\n    all_times = sorted(df[\"scored_time\"].unique())\n\n    # Build worst-score and asset mappings per scored_time (used for backfilling new miners)\n    global_worst_score_mapping = {}\n    global_score_asset_mapping = {}\n    for t in all_times:\n        sample = df.loc[df[\"scored_time\"] == t].iloc[0]\n        p95 = sample.get(\"percentile95\")\n        low = sample.get(\"lowest_score\")\n        if p95 is None or low is None:\n            continue\n        global_worst_score_mapping[t] = p95 - low\n        global_score_asset_mapping[t] = sample[\"asset\"]\n\n    # Identify new miners (first appearance after the window start)\n    miner_first = df.groupby(\"miner_id\")[\"scored_time\"].min()\n    new_miner_ids = miner_first[miner_first > global_min].index\n\n    if len(new_miner_ids) == 0:\n        # No new miners - just return the real data (common fast path)\n        out = df[\n            [\"scored_time\", \"miner_id\", \"prompt_score_v3\", \"asset\"]\n        ].copy()\n        out[\"miner_id\"] = out[\"miner_id\"].astype(int)\n        out = out.sort_values([\"scored_time\", \"miner_id\"]).reset_index(\n            drop=True\n        )\n        return out\n\n    # Build backfill rows only for new miners at times before they joined\n    backfill_rows = []\n    backfill_times = [t for t in all_times if t in global_worst_score_mapping]\n    for mid in new_miner_ids:\n        first_time = miner_first[mid]\n        for t in backfill_times:\n            if t >= first_time:\n                continue\n            backfill_rows.append(\n                {\n                    \"scored_time\": t,\n                    \"miner_id\": mid,\n                    \"prompt_score_v3\": global_worst_score_mapping[t],\n                    \"asset\": global_score_asset_mapping[t],\n                }\n            )\n\n    # Combine real data with backfill rows\n    out = df[[\"scored_time\", \"miner_id\", \"prompt_score_v3\", \"asset\"]].copy()\n    if backfill_rows:\n        backfill_df = pd.DataFrame(backfill_rows)\n        backfill_df[\"scored_time\"] = pd.to_datetime(backfill_df[\"scored_time\"])\n        out = pd.concat([out, backfill_df], ignore_index=True)\n\n    out[\"miner_id\"] = out[\"miner_id\"].astype(int)\n    out = out.sort_values([\"scored_time\", \"miner_id\"]).reset_index(drop=True)\n    return out\n\n\n@print_execution_time\ndef compute_smoothed_score(\n    miner_data_handler: MinerDataHandler,\n    input_df: DataFrame,\n    scored_time: datetime,\n    comp: CompetitionConfig,\n) -> typing.Optional[list[dict]]:\n    \"\"\"Compute smoothed scores and reward weights for all miners.\n\n    1. Filters scores to the scoring window (scored_time cutoff)\n    2. Applies per-asset coefficient weighting (vectorized)\n    3. Sums weighted scores per miner\n    4. Assigns inf to miners with no valid scores\n    5. Computes softmax reward weights\n    \"\"\"\n    if input_df.empty:\n        return None\n\n    # Filter to scoring window and drop NaN scores\n    df = input_df.loc[\n        pd.to_datetime(input_df[\"scored_time\"]) <= scored_time\n    ].copy()\n    df = df.dropna(subset=[\"prompt_score_v3\"])\n\n    if df.empty:\n        return None\n\n    # Apply per-asset coefficients vectorized (single pass, no per-miner loop).\n    # Normalization is per-miner: each miner's scores are divided by the sum of\n    # coefficients for that miner's assets.\n    coefs = df[\"asset\"].map(ASSET_COEFFICIENTS).fillna(1.0)\n    df[\"weighted_score\"] = df[\"prompt_score_v3\"] * coefs\n    miner_coef_sums = coefs.groupby(df[\"miner_id\"]).sum()\n    df[\"weighted_score\"] /= df[\"miner_id\"].map(miner_coef_sums)\n\n    # Sum per miner in one groupby\n    rolling_avgs = df.groupby(\"miner_id\")[\"weighted_score\"].sum()\n\n    # Miners present in input but with all NaN scores get inf (worst possible)\n    all_miner_ids = input_df[\"miner_id\"].unique()\n    missing_miners = set(all_miner_ids) - set(rolling_avgs.index)\n    for miner_id in missing_miners:\n","exit_code":0,"status":"completed"}}
