{"type":"item.started","item":{"id":"item_342","type":"command_execution","command":"/bin/bash -c \"uv run python - <<'PY'\nimport pandas as pd\nfrom synth.validator.moving_average import ASSET_COEFFICIENTS\nfor name, baseline in [('stack_interactions','stacked'),('refresh_daily_dense','stacked')]:\n frame=pd.read_parquet(f'agent/results/{name}.parquet')\n frame['competition']=['CRYPTO_1H' if length==3600 else ('CRYPTO_24H' if asset in ['BTC','ETH','SOL','XRP','HYPE'] else 'COM_EQU_24H') for length,asset in zip(frame.length,frame.asset)]\n means=frame.groupby(['window','competition','asset','variant']).crps.mean().unstack('variant')\n print(name,'MEAN ASSET RELATIVE CRPS')\n print(means.div(means[baseline],axis=0).groupby(['window','competition']).mean().to_string())\n weighted=means.mul(means.index.get_level_values('asset').map(ASSET_COEFFICIENTS).fillna(1),axis=0).groupby(['window','competition']).sum()\n print('COEFFICIENT-WEIGHTED RAW SCORE RATIO (not reward)')\n print(weighted.div(weighted[baseline],axis=0).to_string())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
