k': 227, 'final_rank': 229, 'miners': 257, 'reward_ratio': 0.0586466832312788, 'reward_rounds': 1044, 'first_round': '2026-08-08 00:23:00+00:00', 'last_round': '2026-08-17 23:31:00+00:00'}\n# BUDGET — maintained by the harness (read-only for you)\n\n- Credits: 27.07 / 100.00 USD (27%)\n- Time   : 1.7 h elapsed, 16.3 h remaining (10%)\n- Phase  : normal\n\n","exit_code":0,"status":"completed"}}
