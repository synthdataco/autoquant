{"type":"item.started","item":{"id":"item_262","type":"command_execution","command":"/bin/bash -c \"uv run python - <<'PY'\nimport pandas as pd\nfor experiment,baseline in [('clock_resolution_screen','lead:0.5'),('temporal_exact_hourly_dense','tuned')]:\n    frame=pd.read_parquet(f'agent/results/{experiment}.parquet')\n    means=frame.groupby(['window','length','asset','variant']).crps.mean().unstack()\n    ratios=means.div(means[baseline],axis=0)\n    ratios['competition']=['crypto-1h' if idx[1]==3600 else 'crypto-24h' if idx[2] in ['BTC','ETH','SOL','XRP','HYPE'] else 'com-equ-24h' for idx in ratios.index]\n    print(experiment,ratios.groupby(['window','competition']).mean().to_string(),sep='\\\\n')\nPY\nuv run agent/rank_screen.py temporal_exact_hourly_dense --template starter_full --round-step 12 --workers 4 --variants temporal_exact:1,combined_exact:1:0.5:sobol > agent/temporal_exact_hourly_ranks.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
