{"type":"item.started","item":{"id":"item_167","type":"command_execution","command":"/bin/bash -c \"cat agent/BUDGET.md; sed -n '1,220p' .venv/lib/python3.12/site-packages/synth/validator/crps_calculation.py; cat agent/train_vol.py\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_167","type":"command_execution","command":"/bin/bash -c \"cat agent/BUDGET.md; sed -n '1,220p' .venv/lib/python3.12/site-packages/synth/validator/crps_calculation.py; cat agent/train_vol.py\"","aggregated_output":"# BUDGET — maintained by the harness (read-only for you)\n\n- Credits: 22.48 / 100.00 USD (22%)\n- Time   : 1.5 h elapsed, 16.5 h remaining (8%)\n- Phase  : normal\nimport numpy as np\nfrom properscoring import crps_ensemble\n\n\ndef get_interval_steps(scoring_interval: int, time_increment: int) -> int:\n    \"\"\"\n    Calculate the number of steps in the given scoring interval based on the time increment.\n    \"\"\"\n    return int(scoring_interval / time_increment)\n\n\ndef calculate_crps_for_miner(\n    simulation_runs: np.ndarray,\n    real_price_path: np.ndarray,\n    time_increment: int,\n    scoring_intervals: dict[str, int],\n) -> tuple[float, list[dict]]:\n    \"\"\"\n    Calculate the total CRPS score for a miner's simulations over specified intervals,\n    Return the sum of the scores.\n\n    Parameters:\n        simulation_runs (numpy.ndarray): Simulated price paths.\n        real_price_path (numpy.ndarray): The real price path.\n        time_increment (int): Time increment in seconds.\n        scoring_intervals (dict): Dictionary of scoring intervals with their names and durations in seconds.\n\n    Returns:\n        float: Sum of total CRPS scores over the intervals.\n    \"\"\"\n    # Initialize lists to store detailed CRPS data\n    detailed_crps_data: list[dict] = []\n    sum_all_scores = 0.0\n    gap_total_crps = 0.0\n\n    for interval_name, interval_seconds in scoring_intervals.items():\n        interval_steps = get_interval_steps(interval_seconds, time_increment)\n        absolute_price = interval_name.endswith(\"_abs\")\n        is_gap = interval_name.endswith(\"_gaps\")\n\n        # If we are considering absolute prices, adjust the interval steps for potential gaps:\n        # if only the initial price is present, then decrease the interval step\n        if absolute_price:\n            while (\n                real_price_path[::interval_steps].shape[0] == 1\n                and interval_steps > 1\n            ):\n                interval_steps -= 1\n\n        # Make sure there are no zero prices in the simulation runs because it will cause a division by zero error\n        if np.any(simulation_runs == 0):\n            return -1.0, [\n                {\"error\": \"Zero price encountered in simulation runs\"}\n            ]\n\n        # Calculate price changes over intervals\n        simulated_changes = calculate_price_changes_over_intervals(\n            simulation_runs,\n            interval_steps,\n            absolute_price,\n            is_gap,\n        )\n        real_changes = calculate_price_changes_over_intervals(\n            real_price_path.reshape(1, -1),\n            interval_steps,\n            absolute_price,\n            is_gap,\n        )\n        data_blocks = label_observed_blocks(real_changes[0])\n\n        # Not enough observed data -> continue\n        if len(data_blocks) == 0:\n            continue\n\n        # Calculate CRPS over intervals\n        crps_values = sum_crps_over_blocks(\n            simulated_changes,\n            real_changes,\n            data_blocks,\n            absolute_price,\n            real_price_path,\n        )\n\n        # Total CRPS for this interval\n        total_crps_interval = float(crps_values)\n        sum_all_scores += total_crps_interval\n        if is_gap:\n            # Individual *_gaps intervals are folded into the single \"Gaps\"\n            # Total appended below\n            gap_total_crps += total_crps_interval\n            continue\n\n        detailed_crps_data.append(\n            {\n                \"Interval\": interval_name,\n                \"Increment\": \"Total\",\n                \"CRPS\": total_crps_interval,\n            }\n        )\n\n    if gap_total_crps > 0:\n        detailed_crps_data.append(\n            {\"Interval\": \"Gaps\", \"Increment\": \"Total\", \"CRPS\": gap_total_crps}\n        )\n\n    detailed_crps_data.append(\n        {\"Interval\": \"Overall\", \"Increment\": \"Total\", \"CRPS\": sum_all_scores}\n    )\n\n    return sum_all_scores, detailed_crps_data\n\n\ndef sum_crps_over_blocks(\n    simulated_changes: np.ndarray,\n    real_changes: np.ndarray,\n    data_blocks: np.ndarray,\n    absolute_price: bool,\n    real_price_path: np.ndarray,\n) -> float:\n    \"\"\"\n    Sum the CRPS over the observed (non-missing) blocks of a single interval.\n    \"\"\"\n    crps_values = 0.0\n    for block in np.unique(data_blocks):\n        # skip missing value blocks\n        if block == -1:\n            continue\n\n        mask = data_blocks == block\n        simulated_changes_block = simulated_changes[:, mask]\n        real_changes_block = real_changes[0, mask]  # 1D array now\n        num_intervals = simulated_changes_block.shape[1]\n\n        # Calculate all CRPS values at once\n        crps_values_block = np.array(\n            [\n                crps_ensemble(\n                    real_changes_block[t], simulated_changes_block[:, t]\n                )\n                for t in range(num_intervals)\n            ]\n        )\n\n        if absolute_price:\n            crps_values_block = (\n                crps_values_block / real_price_path[-1] * 10_000\n            )\n\n        crps_values += float(crps_values_block.sum())\n\n    return float(crps_values)\n\n\ndef label_observed_blocks(arr: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Groups blocks of consecutive observed data together.\n    Example input/output:\n    [1.0, 2.0, np.nan, 4.0, np.nan, np.nan, 7.0, 8.0] -> [0, 0, -1, 1, -1, -1, 2, 2]\n    \"\"\"\n    not_nan = ~np.isnan(arr)\n    block_start = not_nan & np.concatenate(([True], ~not_nan[:-1]))\n    group_numbers = np.cumsum(block_start) - 1\n    group_labels = np.where(not_nan, group_numbers, -1)\n    return group_labels\n\n\ndef calculate_price_changes_over_intervals(\n    price_paths: np.ndarray,\n    interval_steps: int,\n    absolute_price=False,\n    is_gap=False,\n) -> np.ndarray:\n    \"\"\"\n    Calculate price changes over specified intervals.\n\n    Parameters:\n        price_paths (numpy.ndarray): Array of simulated price paths.\n        interval_steps (int): Number of steps that make up the interval.\n        absolute_price (bool): If True, absolute price values (rather than price changes) are returned.\n\n    Returns:\n        numpy.ndarray: Array of price changes over intervals.\n    \"\"\"\n    # Get the prices at the interval points\n    # [1, 2, 3, 4, 5, 6, 7] -> [1, 3, 5, 7] if interval_steps is 2\n    interval_prices = price_paths[:, ::interval_steps]\n    if is_gap:\n        # [1, 2, 3, 4, 5, 6, 7] -> [1, 3] if interval_steps is 2\n        interval_prices = interval_prices[:, :2]\n\n    # Calculate price changes over intervals\n    if absolute_price:\n        return interval_prices[:, 1:]\n\n    return (\n        np.diff(interval_prices, axis=1) / interval_prices[:, :-1]\n    ) * 10_000\n\"\"\"Chronologically trained pooled volatility forecasters, without price downloads.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nfrom concurrent.futures import ProcessPoolExecutor\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\nfrom predict import AGENT_DIR, load_context, store_root\nfrom research import CRYPTO, EQUITY, features\n\nASSETS = CRYPTO + EQUITY\nHALF_LIVES = [30, 60, 180, 360, 720, 1440, 2880, 10080]\n\n\ndef feature_vector(feature, asset):\n    reference = max(feature['av'][360], 1e-8)\n    values = [np.log(max(feature[estimator][half_life], 1e-9) / reference)\n              for estimator in ['av', 'rv'] for half_life in HALF_LIVES]\n    values += [np.log(reference), *[float(asset == name) for name in ASSETS]]\n    return np.asarray(values, dtype=np.float32)\n\n\ndef make_asset(asset):\n    first = sorted(store_root(asset).glob('date=*.parquet'))[0].stem.removeprefix('date=')\n    start = pd.Timestamp(first, tz='UTC')\n    end = pd.Timestamp('2026-07-26', tz='UTC')\n    prices = load_context(asset, start, end)\n    observed = prices.close.dropna()\n    returns = np.diff(np.log(observed.to_numpy(dtype=float)))\n    gaps = np.diff(observed.index.as_unit('ns').asi8) / 60e9\n    if np.any(gaps < 1):\n        raise ValueError('Minute-grid timestamps have invalid elapsed-time units')\n    normalized = pd.Series(np.abs(returns) / np.sqrt(gaps), index=observed.index[1:]).reindex(prices.index)\n    targets = {}\n    for horizon in [60, 1440]:\n        targets[horizon] = normalized.shift(-1).iloc[::-1].rolling(horizon, min_periods=max(10, horizon//10)).mean().iloc[::-1] * np.sqrt(np.pi / 2)\n    rows, labels, stamps = [], [], []\n    for timestamp in pd.date_range(start + pd.Timedelta(days=7), end - pd.Timedelta(days=1), freq='3h'):\n        context = prices.loc[(prices.index > timestamp - pd.Timedelta(days=7)) & (prices.index <= timestamp)]\n        if context.close.notna().sum() < 50:\n            continue\n        target = [targets[horizon].loc[timestamp] for horizon in [60,1440]]\n        if not np.isfinite(target).all() or min(target) <= 0:\n            continue\n        feature = features(context, timestamp, 60)\n        row = feature_vector(feature, asset)\n        label = np.asarray(target) / [max(feature['av'][60], 1e-8), max(feature['av'][360], 1e-8)]\n        if not np.isfinite(row).all() or not np.isfinite(label).all():\n            continue\n        rows.append(row)\n        labels.append(label)\n        stamps.append(timestamp.value)\n    print(asset, len(rows), flush=True)\n    return np.asarray(rows), np.asarray(labels), np.asarray(stamps)\n\n\ndef train(dataset, output):\n    import torch\n    from torch import nn\n\n    torch.set_num_threads(4)\n    torch.manual_seed(20260909)\n    device = 'cuda' if torch.cuda.is_available() else 'cpu'\n    if device == 'cuda':\n        torch.cuda.set_per_process_memory_fraction(0.35)\n    data = np.load(dataset)\n    inputs, targets, timestamps = data['inputs'], np.clip(data['targets'], .02, 20), data['timestamps']\n    training = timestamps < pd.Timestamp('2026-07-01', tz='UTC').value\n    validation = ~training\n    center = inputs[training].mean(axis=0)\n    spread = np.maximum(inputs[training].std(axis=0), 0.1)\n    standardized = np.clip((inputs-center)/spread, -8, 8)\n    design = np.column_stack([np.ones(len(inputs)), standardized])\n    penalty = np.eye(design.shape[1]) * 100\n    penalty[0,0] = 1\n    ridge = np.linalg.solve(design[training].T @ design[training] + penalty,\n                            design[training].T @ (targets[training]-1))\n    prediction = np.clip(1 + design @ ridge, 0.2, 4)\n    metric = lambda pred, mask: np.mean(targets[mask]/pred[mask] + np.log(pred[mask]), axis=0).tolist()\n    metrics = {'training_rows': int(training.sum()), 'validation_rows': int(validation.sum()),\n               'baseline_validation_loss': metric(np.ones_like(prediction), validation),\n               'ridge_validation_loss': metric(prediction, validation), 'device': device,\n               'fitting_targets_end_before': '2026-07-26', 'validation_start': '2026-07-01'}\n    inputs_tensor = torch.tensor(standardized, dtype=torch.float32, device=device)\n    target_tensor = torch.tensor(targets, dtype=torch.float32, device=device)\n    network = nn.Sequential(nn.Linear(inputs.shape[1],48),nn.SiLU(),nn.Linear(48,32),nn.SiLU(),nn.Linear(32,2)).to(device)\n    nn.init.zeros_(network[-1].weight)\n    nn.init.zeros_(network[-1].bias)\n    optimizer = torch.optim.AdamW(network.parameters(), lr=.002, weight_decay=.02)\n    indices = torch.tensor(np.flatnonzero(training), device=device)\n    valid_indices = torch.tensor(np.flatnonzero(validation), device=device)\n    best_loss, best_state, best_epoch = np.inf, None, None\n    for epoch in range(150):\n        order = indices[torch.randperm(len(indices), device=device)]\n        for batch in order.split(1024):\n            output_log = network(inputs_tensor[batch]).clamp(-2,2)\n            loss = (target_tensor[batch] * torch.exp(-output_log) + output_log + .03 * output_log.square()).mean()\n            optimizer.zero_grad()\n            loss.backward()\n            optimizer.step()\n        with torch.no_grad():\n            logs = network(inputs_tensor[valid_indices]).clamp(-2,2)\n            loss = (target_tensor[valid_indices] * torch.exp(-logs) + logs).mean().item()\n            if loss < best_loss:\n                best_loss, best_epoch = loss, epoch\n                best_state = {key: value.detach().cpu().numpy().copy() for key,value in network.state_dict().items()}\n        if epoch % 25 == 0:\n            print('epoch',epoch,'validation_loss',loss,'best',best_loss,flush=True)\n    metrics.update({'neural_validation_loss':best_loss,'neural_best_epoch':best_epoch})\n    np.savez(output,center=center,spread=spread,ridge=ridge,**best_state)\n    output.with_suffix('.json').write_text(json.dumps(metrics,indent=2))\n    print(metrics,flush=True)\n\n\ndef main():\n    parser=argparse.ArgumentParser()\n    parser.add_argument('--workers',type=int,default=6)\n    args=parser.parse_args()\n    print((AGENT_DIR/'BUDGET.md').read_text(),flush=True)\n    dataset=AGENT_DIR/'results'/'volatility_training.npz'\n    if not dataset.exists():\n        with ProcessPoolExecutor(max_workers=args.workers) as executor:\n            rows=list(executor.map(make_asset,ASSETS))\n        np.savez(dataset,inputs=np.concatenate([row[0] for row in rows]),targets=np.concatenate([row[1] for row in rows]),timestamps=np.concatenate([row[2] for row in rows]))\n    output=AGENT_DIR/'volatility_weights.npz'\n    train(dataset,output)\n\n\nif __name__=='__main__':\n    main()\n","exit_code":0,"status":"completed"}}
