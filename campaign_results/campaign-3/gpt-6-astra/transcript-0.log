{"type":"item.completed","item":{"id":"item_360","type":"command_execution","command":"/bin/bash -c \"sed -n '1,62p' agent/modeling.py; sed -n '60,112p' agent/research.py; tail -n 6 agent/fit_tree.log; tail -n 3 agent/daily_lattice_periodic_dense.log\"","aggregated_output":"\"\"\"Offline probabilistic paths with robust, horizon-specific volatility forecasts.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.special import ndtri\nfrom scipy.stats import chi2, qmc\n\nASSETS = (\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\", \"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\")\nHALF_LIVES = (30, 60, 180, 360, 720, 1440, 2880, 10080)\nCOMMODITY_EQUITY_BLEND = 1.0\nCYCLE_STRENGTH = 0.75\nLEAD_STRENGTH = 0.5\nWEIGHTS_AVAILABLE_FROM = pd.Timestamp('2026-07-26',tz='UTC')\n\n\n@lru_cache(maxsize=3)\ndef _weights(kind='volatility'):\n    with np.load(Path(__file__).with_name(f\"{kind}_weights.npz\"), allow_pickle=False) as archive:\n        return {name: archive[name] for name in archive.files}\n\n\ndef _features(closes, timestamp):\n    minutes = (closes.index - timestamp).total_seconds().to_numpy() / 60\n    gaps = np.diff(minutes)\n    returns = np.diff(np.log(closes.to_numpy(dtype=float)))\n    valid = (gaps > 0) & np.isfinite(returns)\n    normalized = returns[valid] / np.sqrt(gaps[valid])\n    age = -minutes[1:][valid]\n    absolute, root_square = {}, {}\n    for half_life in HALF_LIVES:\n        if not normalized.size:\n            absolute[half_life] = root_square[half_life] = 1e-8\n            continue\n        weights = np.exp(-np.log(2) * age / half_life)\n        absolute[half_life] = max(float(np.average(np.abs(normalized), weights=weights) * np.sqrt(np.pi / 2)), 1e-8)\n        root_square[half_life] = max(float(np.sqrt(np.average(normalized ** 2, weights=weights))), 1e-8)\n    return absolute, root_square\n\n\ndef _feature_values(absolute, root_square, asset):\n    reference = absolute[360]\n    values = [np.log(max(estimator[half_life], 1e-9) / reference)\n              for estimator in (absolute, root_square) for half_life in HALF_LIVES]\n    values += [np.log(reference), *[float(asset == name) for name in ASSETS]]\n    return np.asarray(values,dtype=np.float32)\n\n\ndef _network_output(values, weights):\n    inputs = np.clip((values - weights[\"center\"]) / weights[\"spread\"], -8, 8)\n    for layer in (0, 2):\n        inputs = weights[f\"{layer}.weight\"] @ inputs + weights[f\"{layer}.bias\"]\n        inputs = inputs / (1 + np.exp(-inputs))\n    return weights[\"4.weight\"] @ inputs + weights[\"4.bias\"]\n\n\ndef _learned_multiplier(absolute, root_square, asset, hourly):\n\n    weights = learned_weights(kind)\n    vector=feature_vector(feature,asset)\n    if kind=='aux':\n        vector=np.r_[vector,feature['auxiliary']]\n    inputs = np.clip((vector - weights['center']) / weights['spread'], -8, 8)\n    head = 0 if length == 3600 else 1\n    if kind=='ensemble':\n        for layer in [0,2]:\n            inputs = np.einsum('noi,ni->no',weights[f'{layer}.weight'],inputs)+weights[f'{layer}.bias']\n            inputs = inputs/(1+np.exp(-inputs))\n        output = np.einsum('noi,ni->no',weights['4.weight'],inputs)+weights['4.bias']\n        return float(np.exp(np.clip(output[:,head],-2,2).mean()))\n    if kind == 'ridge':\n        return float(np.clip(1 + np.r_[1, inputs] @ weights['ridge'][:,head], 0.2, 4))\n    for layer in [0, 2]:\n        inputs = weights[f'{layer}.weight'] @ inputs + weights[f'{layer}.bias']\n        inputs = inputs / (1 + np.exp(-inputs))\n    output = weights['4.weight'] @ inputs + weights['4.bias']\n    limits = weights['limits'] if kind.startswith('calibration') else [-2,2]\n    return float(np.exp(np.clip(output[head], *limits)))\n\n\ndef features(context, start_time, increment):\n    close = pd.to_numeric(context[\"close\"], errors=\"coerce\")\n    close = close.loc[np.isfinite(close) & (close > 0)]\n    log_prices = np.log(close.to_numpy())\n    minutes = (close.index - pd.Timestamp(start_time)).total_seconds().to_numpy() / 60\n    gaps = np.diff(minutes)\n    returns = np.diff(log_prices)\n    valid = (gaps > 0) & np.isfinite(returns)\n    returns, gaps, age = returns[valid], gaps[valid], -minutes[1:][valid]\n    normalized = returns / np.sqrt(gaps)\n    output = {\"last\": float(close.iloc[-1]), \"starter\": float(np.std(returns)), \"rv\": {}, \"av\": {}, \"range\": {}, 'context': context}\n    log_ranges, range_age = np.array([]), np.array([])\n    if {'high','low'}.issubset(context.columns):\n        high = pd.to_numeric(context['high'],errors='coerce').to_numpy(dtype=float)\n        low = pd.to_numeric(context['low'],errors='coerce').to_numpy(dtype=float)\n        range_valid = np.isfinite(high) & np.isfinite(low) & (low>0) & (high>=low)\n        log_ranges = np.log(high[range_valid]/low[range_valid])\n        range_age = (pd.Timestamp(start_time)-context.index[range_valid]).total_seconds().to_numpy()/60\n    for half_life in [15, 30, 60, 120, 180, 360, 720, 1440, 2880, 10080]:\n        weights = np.exp(-np.log(2) * age / half_life)\n        output[\"rv\"][half_life] = float(np.sqrt(np.average(normalized ** 2, weights=weights)))\n        output[\"av\"][half_life] = float(np.average(np.abs(normalized), weights=weights) * np.sqrt(np.pi / 2))\n        output['range'][half_life] = output['av'][half_life]\n        if len(log_ranges)>20 and np.any(log_ranges>0):\n            range_weights = np.exp(-np.log(2)*range_age/half_life)\n            output['range'][half_life] = float(np.average(log_ranges,weights=range_weights)*np.sqrt(np.pi/8))\n    raw = pd.to_numeric(context[\"close\"], errors=\"coerce\")\n    raw_log = np.log(raw.where(raw > 0))\n    raw_age = (pd.Timestamp(start_time) - raw.index).total_seconds().to_numpy() / 60\n    for lag in [5, 15, 30, 180]:\ntemporal 100 1.005001603886337\ntemporal 200 1.0046099297148599\npretrained 50 1.0054184128883006\npretrained 100 1.0049969559187715\npretrained 200 1.0045438181557376\n{'initial_validation_loss': 1.0079036779569983, 'best_validation_loss': 1.0045438181557376, 'kind': 'pretrained', 'stages': 200, 'diagnostics': {'static/50': 1.0063354324835452, 'static/100': 1.006454686013903, 'static/200': 1.0066805183881822, 'temporal/50': 1.00538319901704, 'temporal/100': 1.005001603886337, 'temporal/200': 1.0046099297148599, 'pretrained/50': 1.0054184128883006, 'pretrained/100': 1.0049969559187715, 'pretrained/200': 1.0045438181557376}, 'label_cutoff': '2026-07-26', 'training_rows': 23457, 'validation_rows': 2508}\ndev1 WTIOIL 86400: 240 prompts, 4 variants\ndev1 AAPLX 86400: 240 prompts, 4 variants\ndev1 SPCX 86400: 240 prompts, 4 variants\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_361","type":"command_execution","command":"/bin/bash -c \"uv run python - <<'PY'\nimport sys,time\nsys.path.insert(0,'agent')\nimport numpy as np,pandas as pd\nfrom predict import load_context\nfrom modeling import simulate\nfrom research import features,generate_variant\nstamp=pd.Timestamp('2026-08-10 12:00',tz='UTC')\nfor asset in ['BTC','ETH','SOL','XRP','HYPE','SP500']:\n context=load_context(asset,stamp-pd.Timedelta(days=7),stamp)\n context=context.loc[context.index>stamp-pd.Timedelta(days=7)]\n for length,increment in [(3600,60),(86400,300)]:\n  expected=generate_variant(features(context,stamp,increment),asset,stamp,increment,length,1000,'ticked:gcd' if length==3600 else 'stacked')\n  started=time.perf_counter();actual=np.asarray(simulate(asset,stamp,increment,length,1000,context)[2:]);latency=time.perf_counter()-started\n  np.testing.assert_allclose(actual,expected,rtol=1e-12,atol=0)\n  assert actual.shape==(1000,length//increment+1) and np.isfinite(actual).all() and (actual>0).all()\n  altered=context.copy();altered.iloc[::13]=np.nan;altered.loc[stamp+pd.Timedelta(minutes=1)]=1e20\n  forecast=np.asarray(simulate(asset,stamp,increment,length,17,altered)[2:])\n  assert forecast.shape==(17,length//increment+1) and np.isfinite(forecast).all() and (forecast>0).all()\n  np.testing.assert_array_equal(forecast,np.asarray(simulate(asset,stamp,increment,length,17,altered.loc[:stamp])[2:]))\n  print(asset,length,'match and contract',round(latency,4),flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_361","type":"command_execution","command":"/bin/bash -c \"uv run python - <<'PY'\nimport sys,time\nsys.path.insert(0,'agent')\nimport numpy as np,pandas as pd\nfrom predict import load_context\nfrom modeling import simulate\nfrom research import features,generate_variant\nstamp=pd.Timestamp('2026-08-10 12:00',tz='UTC')\nfor asset in ['BTC','ETH','SOL','XRP','HYPE','SP500']:\n context=load_context(asset,stamp-pd.Timedelta(days=7),stamp)\n context=context.loc[context.index>stamp-pd.Timedelta(days=7)]\n for length,increment in [(3600,60),(86400,300)]:\n  expected=generate_variant(features(context,stamp,increment),asset,stamp,increment,length,1000,'ticked:gcd' if length==3600 else 'stacked')\n  started=time.perf_counter();actual=np.asarray(simulate(asset,stamp,increment,length,1000,context)[2:]);latency=time.perf_counter()-started\n  np.testing.assert_allclose(actual,expected,rtol=1e-12,atol=0)\n  assert actual.shape==(1000,length//increment+1) and np.isfinite(actual).all() and (actual>0).all()\n  altered=context.copy();altered.iloc[::13]=np.nan;altered.loc[stamp+pd.Timedelta(minutes=1)]=1e20\n  forecast=np.asarray(simulate(asset,stamp,increment,length,17,altered)[2:])\n  assert forecast.shape==(17,length//increment+1) and np.isfinite(forecast).all() and (forecast>0).all()\n  np.testing.assert_array_equal(forecast,np.asarray(simulate(asset,stamp,increment,length,17,altered.loc[:stamp])[2:]))\n  print(asset,length,'match and contract',round(latency,4),flush=True)\nPY\"","aggregated_output":"BTC 3600 match and contract 0.0332\nBTC 86400 match and contract 0.0868\nETH 3600 match and contract 0.0295\nETH 86400 match and contract 0.0787\nSOL 3600 match and contract 0.0291\nSOL 86400 match and contract 0.0761\nXRP 3600 match and contract 0.0299\nXRP 86400 match and contract 0.0815\nHYPE 3600 match and contract 0.0293\nHYPE 86400 match and contract 0.0819\nSP500 3600 match and contract 0.0284\nSP500 86400 match and contract 0.0824\n","exit_code":0,"status":"completed"}}
