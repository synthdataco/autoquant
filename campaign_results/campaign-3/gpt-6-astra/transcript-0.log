ded for logging\n413-    if \"crps_data\" in df.columns:\n414-        df = df.drop(columns=[\"crps_data\"])\n415-    if \"real_prices\" in df.columns:\n416-        df = df.drop(columns=[\"real_prices\"])\n417-    bt.logging.info(df.to_string())\ndev2/ml:curve:0.5/crypto-1h {'reward_rank': 139, 'final_rank': 70, 'miners': 257, 'reward_ratio': 0.6773575588048241, 'reward_rounds': 224, 'first_round': '2026-08-13 00:06:00+00:00', 'last_round': '2026-08-17 23:57:00+00:00'}\ndev2/ml:neural:0.5/crypto-1h {'reward_rank': 136, 'final_rank': 37, 'miners': 257, 'reward_ratio': 0.7085835185992151, 'reward_rounds': 224, 'first_round': '2026-08-13 00:06:00+00:00', 'last_round': '2026-08-17 23:57:00+00:00'}\ndev2/ml:ridge:0.5/crypto-1h {'reward_rank': 152, 'final_rank': 114, 'miners': 257, 'reward_ratio': 0.640854307256058, 'reward_rounds': 224, 'first_round': '2026-08-13 00:06:00+00:00', 'last_round': '2026-08-17 23:57:00+00:00'}\ndev2/quick:30/crypto-1h {'reward_rank': 197, 'final_rank': 186, 'miners': 257, 'reward_ratio': 0.463645757566178, 'reward_rounds': 224, 'first_round': '2026-08-13 00:06:00+00:00', 'last_round': '2026-08-17 23:57:00+00:00'}\ndev2/revert:360:60/crypto-1h {'reward_rank': 177, 'final_rank': 181, 'miners': 257, 'reward_ratio': 0.5327753055359905, 'reward_rounds': 224, 'first_round': '2026-08-13 00:06:00+00:00', 'last_round': '2026-08-17 23:57:00+00:00'}\ndev2/shape:3:1/crypto-1h {'reward_rank': 197, 'final_rank': 180, 'miners': 257, 'reward_ratio': 0.48606058353143433, 'reward_rounds': 224, 'first_round': '2026-08-13 00:06:00+00:00', 'last_round': '2026-08-17 23:57:00+00:00'}\n# BUDGET — maintained by the harness (read-only for you)\n\n- Credits: 20.80 / 100.00 USD (21%)\n- Time   : 1.4 h elapsed, 16.6 h remaining (8%)\n- Phase  : normal\n","exit_code":0,"status":"completed"}}
