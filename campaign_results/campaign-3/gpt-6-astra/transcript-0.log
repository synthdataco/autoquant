{"type":"item.completed","item":{"id":"item_164","type":"command_execution","command":"/bin/bash -c \"sed -n '45,150p' agent/field_eval.py; sed -n '260,450p' agent/research.py; cat agent/fit_weighted_score.py\"","aggregated_output":"    (output / f\"{label}_summary.json\").write_text(json.dumps(result.summary, indent=2))\n    shutil.rmtree(predictions)\n    return str(output), label\n\n\ndef reward_summary(frame):\n    totals = frame.groupby(\"miner_uid\").reward_weight.sum()\n    latest = frame.loc[frame.updated_at.eq(frame.updated_at.max())].set_index(\"miner_uid\")\n    return {\"reward_rank\": int(totals.rank(ascending=False, method=\"min\").loc[999]),\n            \"final_rank\": int(latest.new_smoothed_score.rank(method=\"min\").loc[999]),\n            \"miners\": int(len(totals)), \"reward_ratio\": float(totals.loc[999] / totals.drop(999).max()),\n            \"reward_rounds\": int(frame.updated_at.nunique()),\n            \"first_round\": str(frame.updated_at.min()), \"last_round\": str(frame.updated_at.max())}\n\n\ndef aggregate(name, window):\n    output = AGENT_DIR / \"results\" / name / window\n    competition_groups = {}\n    for path in sorted(output.glob('*_summary.json')):\n        label = path.name.removesuffix('_summary.json')\n        asset, length = label.rsplit('_', 1)\n        config = competition_for(asset, int(length))\n        result = BacktestResult(name, pd.read_parquet(output / f'{label}_prompts.parquet'),\n                                pd.read_parquet(output / f'{label}_smoothed.parquet'), json.loads(path.read_text()))\n        competition_groups.setdefault(slug_for(config), (config, []))[1].append(result)\n    summaries = {}\n    for label, (config, results) in competition_groups.items():\n        combined_path = output / f'{label}_combined.parquet'\n        combined = pd.read_parquet(combined_path) if combined_path.exists() else parallel_combined(results, config)\n        combined.to_parquet(combined_path)\n        summaries[label] = reward_summary(combined)\n        summaries[label]['assets'] = len(results)\n        print(label, summaries[label], flush=True)\n    summaries['score_estimate'] = 100 * sum(min(1, value['reward_ratio']) for value in summaries.values()) / 3\n    (output / 'competition_metrics.json').write_text(json.dumps(summaries, indent=2))\n    return summaries\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--name', required=True)\n    parser.add_argument('--variant', default='model')\n    parser.add_argument('--windows', default='dev1,dev2')\n    parser.add_argument('--assets', default=','.join(CRYPTO + EQUITY))\n    parser.add_argument('--workers', type=int, default=6)\n    parser.add_argument('--aggregate-only', action='store_true')\n    args = parser.parse_args()\n    print((AGENT_DIR / 'BUDGET.md').read_text(), flush=True)\n    if not args.aggregate_only:\n        tasks = [(asset, length, window, args.variant, args.name)\n                 for window in args.windows.split(',') for asset in args.assets.split(',')\n                 for length in ([86400, 3600] if asset in CRYPTO else [86400])]\n        with ProcessPoolExecutor(max_workers=args.workers) as executor:\n            list(executor.map(evaluate, tasks))\n    for window in args.windows.split(','):\n        print(aggregate(args.name, window), flush=True)\n\n\nif __name__ == '__main__':\n    main()\ndef evaluate_asset(task):\n    asset, length, window, variants, count, stride = task\n    ensure_workspace_cwd()\n    begin, end = [pd.Timestamp(value, tz=\"UTC\") for value in WINDOWS[window]]\n    increment = 60 if length == 3600 else 300\n    field = get_miner_scores(begin, end, asset, length, increment)\n    times = pd.DatetimeIndex(field.start_time.unique()).sort_values()[::stride]\n    prices = load_context(asset, times.min() - pd.Timedelta(days=7), min(end, times.max() + pd.Timedelta(seconds=length)))\n    prompts = []\n    for timestamp in times:\n        prompts.append({\"asset\": asset, \"start_time\": timestamp, \"time_length\": length, \"time_increment\": increment,\n                        \"real_prices\": _slice_real_prices(prices[[\"close\"]], timestamp, length, increment)})\n    _fill_gaps_from_realized_paths(prompts, asset)\n    rows = []\n    for prompt in prompts:\n        timestamp = prompt[\"start_time\"]\n        context = prices.loc[(prices.index > timestamp - pd.Timedelta(days=7)) & (prices.index <= timestamp)]\n        feature = features(context, timestamp, increment)\n        for variant in variants:\n            started = perf_counter()\n            paths = generate_variant(feature, asset, timestamp, increment, length, count, variant)\n            elapsed = perf_counter() - started\n            score, detail = score_paths(paths, prompt[\"real_prices\"], increment, asset, length)\n            row = {\"asset\": asset, \"length\": length, \"window\": window, \"time\": timestamp,\n                   \"variant\": variant, \"crps\": score, \"latency\": elapsed, \"paths\": count}\n            row.update({item[\"Interval\"]: item[\"CRPS\"] for item in detail})\n            rows.append(row)\n    print(f\"{window} {asset} {length}: {len(prompts)} prompts, {len(variants)} variants\", flush=True)\n    return rows\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--name\", required=True)\n    parser.add_argument(\"--variants\", default=\"starter,rv:360,rv:1440,av:360,av:1440\")\n    parser.add_argument(\"--windows\", default=\"dev1,dev2\")\n    parser.add_argument(\"--assets\", default=\",\".join(CRYPTO + EQUITY))\n    parser.add_argument(\"--paths\", type=int, default=256)\n    parser.add_argument(\"--stride-low\", type=int, default=4)\n    parser.add_argument(\"--stride-high\", type=int, default=24)\n    parser.add_argument(\"--workers\", type=int, default=10)\n    parser.add_argument(\"--format\", choices=['all','low','high'],default='all')\n    args = parser.parse_args()\n    print((AGENT_DIR / \"BUDGET.md\").read_text(), flush=True)\n    variants = args.variants.split(\",\")\n    tasks = [(asset, length, window, variants, args.paths, args.stride_high if length == 3600 else args.stride_low)\n             for window in args.windows.split(\",\") for asset in args.assets.split(\",\")\n             for length in ([86400, 3600] if asset in CRYPTO else [86400])\n             if args.format=='all' or (args.format=='low' and length==86400) or (args.format=='high' and length==3600)]\n    with ProcessPoolExecutor(max_workers=args.workers) as executor:\n        results = list(executor.map(evaluate_asset, tasks))\n    result = pd.DataFrame([row for batch in results for row in batch])\n    target = AGENT_DIR / \"results\" / f\"{args.name}.parquet\"\n    target.parent.mkdir(parents=True, exist_ok=True)\n    result.to_parquet(target)\n    print(result.groupby([\"window\", \"length\", \"asset\", \"variant\"]).crps.mean().to_string(), flush=True)\n\n\nif __name__ == \"__main__\":\n    main()\n\"\"\"Fine-tune on raw official CRPS with validator asset weighting.\"\"\"\n\nimport json\n\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom torch import nn\n\nfrom predict import AGENT_DIR\nfrom research import CRYPTO,EQUITY\nfrom synth.validator.moving_average import ASSET_COEFFICIENTS\n\nprint((AGENT_DIR/'BUDGET.md').read_text(),flush=True)\ntorch.set_num_threads(4)\ntorch.manual_seed(73)\ndevice='cuda' if torch.cuda.is_available() else 'cpu'\nif device=='cuda':\n    torch.cuda.set_per_process_memory_fraction(.35)\ndata=np.load(AGENT_DIR/'results'/'volatility_training.npz')\ncurve_data=np.load(AGENT_DIR/'results'/'training_score_curves.npz')\nindices,curves=curve_data['indices'],curve_data['curves']\ninputs=data['inputs'][indices]\ntimestamps=data['timestamps'][indices]\nprevious=dict(np.load(AGENT_DIR/'volatility_weights.npz'))\nassets=np.asarray(CRYPTO+EQUITY)[np.argmax(inputs[:,-13:],axis=1)]\nvalid=np.isfinite(curves).all(axis=2)&(curves[:,:,4]>0)\ntraining=timestamps<pd.Timestamp('2026-07-01',tz='UTC').value\nvalidation=~training\ngroups=[(0,np.isin(assets,CRYPTO)),(1,np.isin(assets,CRYPTO)),(1,np.isin(assets,EQUITY))]\n\n\ndef asset_weights(mask):\n    weights=np.zeros(valid.shape)\n    for head,group in groups:\n        for asset in CRYPTO+EQUITY:\n            selected=mask&group&(assets==asset)&valid[:,head]\n            if selected.any():\n                weights[selected,head]=ASSET_COEFFICIENTS[asset]/selected.sum()\n        total=weights[group,head].sum()\n        if total:\n            weights[group,head]/=total\n    return weights\n\n\ntrain_weights=asset_weights(training)\nvalidation_weights=asset_weights(validation)\nnormalized=np.nan_to_num(curves,nan=0.,posinf=0.,neginf=0.)\nscales=[]\nfor head,group in groups:\n    scale=float(np.sum(normalized[group,head,4]*train_weights[group,head]))\n    normalized[group,head,:]/=max(scale,1e-6)\n    scales.append(scale)\nvalues=np.clip((inputs-previous['center'])/previous['spread'],-8,8)\ninput_tensor=torch.tensor(values,dtype=torch.float32,device=device)\ncurve_tensor=torch.tensor(normalized,dtype=torch.float32,device=device)\ntrain_weight_tensor=torch.tensor(train_weights,dtype=torch.float32,device=device)\nvalidation_weight_tensor=torch.tensor(validation_weights,dtype=torch.float32,device=device)\ngrid=torch.tensor(np.log([.4,.55,.7,.85,1.,1.2,1.45,1.8,2.3,3.0]),dtype=torch.float32,device=device)\nnetwork=nn.Sequential(nn.Linear(30,48),nn.SiLU(),nn.Linear(48,32),nn.SiLU(),nn.Linear(32,2)).to(device)\nnetwork.load_state_dict({key:torch.tensor(previous[key],device=device) for key in network.state_dict()})\n\n\ndef objective(weights,penalty=0.):\n    logits=network(input_tensor).clamp(float(grid[0].cpu()),float(grid[-1].cpu()))\n    upper=torch.searchsorted(grid,logits.contiguous()).clamp(1,len(grid)-1)\n    lower=upper-1\n    fraction=(logits-grid[lower])/(grid[upper]-grid[lower])\n    low=torch.gather(curve_tensor,2,lower.unsqueeze(-1)).squeeze(-1)\n    high=torch.gather(curve_tensor,2,upper.unsqueeze(-1)).squeeze(-1)\n    loss=low*(1-fraction)+high*fraction+penalty*logits.square()\n    return (loss*weights).sum()/weights.sum()\n\n\noptimizer=torch.optim.AdamW(network.parameters(),lr=.0003,weight_decay=.05)\ninitial=float(objective(validation_weight_tensor).detach().cpu())\nbest,best_epoch=initial,-1\nbest_state={key:value.detach().cpu().numpy().copy() for key,value in network.state_dict().items()}\nfor epoch in range(300):\n    optimizer.zero_grad()\n    loss=objective(train_weight_tensor,.003)\n    loss.backward()\n    optimizer.step()\n    with torch.no_grad():\n        validation_loss=float(objective(validation_weight_tensor).cpu())\n    if validation_loss<best:\n        best,best_epoch=validation_loss,epoch\n        best_state={key:value.detach().cpu().numpy().copy() for key,value in network.state_dict().items()}\n    if epoch%50==0:\n        print('epoch',epoch,'validation',validation_loss,'best',best,flush=True)\nnp.savez(AGENT_DIR/'weighted_score_weights.npz',center=previous['center'],spread=previous['spread'],**best_state)\nmetrics={'initial_weighted_validation_loss':initial,'best_weighted_validation_loss':best,'best_epoch':best_epoch,\n         'constant_competition_scales':scales,'target_cutoff':'2026-07-26','validation_start':'2026-07-01',\n         'objective':'Raw official CRPS, asset-coefficient and asset-frequency weighting; constant group scaling only',\n         'paths_per_training_curve':128}\n(AGENT_DIR/'weighted_score_weights.json').write_text(json.dumps(metrics,indent=2))\nprint(metrics,flush=True)\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_165","type":"command_execution","command":"/bin/bash -c \"apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: /workspace/agent/rank_screen.py\n@@\n     parser.add_argument('--workers',type=int,default=4)\n+    parser.add_argument('--variants')\n@@\n     frame = pd.read_parquet(AGENT_DIR/'results'/f'{args.experiment}.parquet')\n+    if args.variants:\n+        frame = frame.loc[frame.variant.isin(args.variants.split(','))]\n*** End Patch\nPATCH\nuv run agent/rank_screen.py hourly_emission_screen --template starter_full --round-step 1 --workers 6 --variants cycle:0.75,ml:neural:0.5 > agent/hourly_confirmation.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
