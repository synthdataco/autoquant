{"type":"item.started","item":{"id":"item_263","type":"command_execution","command":"/bin/bash -c \"OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run python - <<'PY'\nimport hashlib,json,sys\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nsys.path.insert(0,'agent')\nfrom predict import load_context\nfrom modeling import simulate,ASSETS\nfrom research import features,generate_variant\nstamp=pd.Timestamp('2026-08-12 15:23',tz='UTC')\nchecks=[]\nfor asset in ASSETS:\n    raw=load_context(asset,stamp-pd.Timedelta(days=7),stamp)\n    context=raw.loc[raw.index>stamp-pd.Timedelta(days=7)]\n    for length,increment in [(86400,300)]+([(3600,60)] if asset in ASSETS[:5] else []):\n        variant='stackcenter:1' if length==86400 and asset in ASSETS[:5] else 'stackrank:multiscale:1' if length==86400 else 'stackrank:prefix:1'\n        feature=features(context,stamp,increment)\n        for count in [17,1000]:\n            actual=np.asarray(simulate(asset,int(stamp.timestamp()),increment,length,count,raw)[2:])\n            expected=generate_variant(feature,asset,stamp,increment,length,count,variant)\n            np.testing.assert_allclose(actual,expected,rtol=1e-12,atol=0)\n            assert actual.shape==(count,length//increment+1)\n            assert np.isfinite(actual).all() and (actual>0).all()\n            assert np.all(actual[:,0]==feature['last'])\n            checks.append({'asset':asset,'length':length,'count':count})\nroot=Path('agent')\nweights={}\nfor kind in ['volatility','temporal_exact','lead','lead_temporal','tree_student','periodic','lead_finetune']:\n    path=root/f'{kind}_weights.npz'\n    with np.load(path,allow_pickle=False) as archive:\n        assert all(not archive[name].dtype.hasobject for name in archive.files)\n    weights[path.name]={'bytes':path.stat().st_size,'sha256':hashlib.sha256(path.read_bytes()).hexdigest()}\n(root/'results'/'final_contract_audit.json').write_text(json.dumps({'status':'passed','comparisons':checks,'weights':weights,'model_sha256':hashlib.sha256((root/'modeling.py').read_bytes()).hexdigest(),'context_time':str(stamp)},indent=2))\nprint('Passed all 18 asset/format combinations at 17 and 1000 paths; seven numerical weight archives verified')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
