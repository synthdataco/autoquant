{"type":"item.started","item":{"id":"item_233","type":"command_execution","command":"/bin/bash -c \"apply_patch <<'PATCH'\n*** Begin Patch\n*** Update File: /workspace/agent/modeling.py\n@@\n-from scipy.stats import chi2, qmc\n+from scipy.stats import chi2, qmc, t\n@@\n-def _volatility_profile(closes, bins=24):\n+@lru_cache(maxsize=8)\n+def _student_quantiles(count):\n+    probabilities = (np.arange(count)+.5)/count\n+    return np.sqrt(3/5)*t.ppf(probabilities,5)\n+\n+\n+def _stratified_marginals(values, scales=1.):\n+    if values.shape[1]==0:\n+        return values.copy()\n+    order = np.argsort(values,axis=0,kind='stable')\n+    output = np.empty_like(values)\n+    np.put_along_axis(output,order,_student_quantiles(len(values))[:,None],axis=0)\n+    return output*np.broadcast_to(scales,(values.shape[1],))\n+\n+\n+def _multiscale_stratification(increments, scales):\n+    steps = increments.shape[1]\n+    adjusted = increments.copy()\n+    variances = np.broadcast_to(scales,(steps,))**2\n+    for sweep in range(2):\n+        for width in [1,6,36,288]:\n+            blocks = steps//width\n+            if blocks==0:\n+                continue\n+            used = blocks*width\n+            block_values = adjusted[:,:used].reshape(len(adjusted),blocks,width)\n+            block_variances = variances[:used].reshape(blocks,width)\n+            totals = block_values.sum(axis=2)\n+            total_variance = block_variances.sum(axis=1)\n+            targets = _stratified_marginals(totals,np.sqrt(total_variance))\n+            allocation = np.divide(block_variances,total_variance[:,None],\n+                                   out=np.zeros_like(block_variances),where=total_variance[:,None]>0)\n+            block_values += (targets-totals)[:,:,None]*allocation[None]\n+    return adjusted\n+\n+\n+def _volatility_profile(closes, bins=24):\n@@\n-    log_paths = np.concatenate([np.zeros((num_simulations, 1)), np.cumsum(shocks * sigma, axis=1)], axis=1)\n+    increments = shocks*sigma\n+    if timestamp>=WEIGHTS_AVAILABLE_FROM and not hourly:\n+        increments = _multiscale_stratification(increments,sigma)\n+    log_paths = np.concatenate([np.zeros((num_simulations, 1)), np.cumsum(increments, axis=1)], axis=1)\n+    if timestamp>=WEIGHTS_AVAILABLE_FROM and hourly:\n+        cumulative_scale = np.sqrt(np.cumsum(np.broadcast_to(sigma,(steps,))**2))\n+        log_paths[:,1:] = _stratified_marginals(log_paths[:,1:],cumulative_scale)\n*** End Patch\nPATCH\nOMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run python - <<'PY'\nimport sys,json,time\nimport numpy as np\nimport pandas as pd\nsys.path.insert(0,'agent')\nfrom predict import load_context\nfrom modeling import simulate\nfrom research import features,generate_variant\nchecks=[]\nfor asset in ['BTC','HYPE','SP500','AAPLX']:\n    stamp=pd.Timestamp('2026-08-10 12:17',tz='UTC')\n    raw=load_context(asset,stamp-pd.Timedelta(days=7),stamp)\n    context=raw.loc[raw.index>stamp-pd.Timedelta(days=7)]\n    for length,increment,variant in [(86400,300,'stackrank:multiscale:1'),(3600,60,'stackrank:prefix:1')]:\n        for count in [1,17,1000]:\n            started=time.perf_counter()\n            result=simulate(asset,stamp,increment,length,count,raw)\n            elapsed=time.perf_counter()-started\n            paths=np.asarray(result[2:])\n            expected=generate_variant(features(context,stamp,increment),asset,stamp,increment,length,count,variant)\n            np.testing.assert_allclose(paths,expected,rtol=1e-12,atol=0)\n            assert paths.shape==(count,length//increment+1)\n            assert np.isfinite(paths).all() and (paths>0).all()\n            assert (paths[:,0]==context.close.dropna().iloc[-1]).all()\n            checks.append({'asset':asset,'length':length,'count':count,'seconds':elapsed})\n        base=simulate(asset,stamp,increment,length,17,context)[2:]\n        changed=context.copy()\n        changed.loc[:,changed.columns\"'!='\"'close']=np.nan\n        future=pd.DataFrame(1e20,index=[stamp+pd.Timedelta(minutes=1)],columns=changed.columns)\n        changed=pd.concat([changed,future]).iloc[::-1]\n        np.testing.assert_array_equal(base,simulate(asset,stamp,increment,length,17,changed)[2:])\n        np.testing.assert_array_equal(base,simulate(asset,stamp,increment,length,17,context.dropna(subset=['close']))[2:])\nfor stamp in [pd.Timestamp('2026-07-20',tz='UTC'),pd.Timestamp('2026-08-10',tz='UTC')]:\n    for observations in [1,20,10080]:\n        context=pd.DataFrame({'close':100.},index=pd.date_range(end=stamp,periods=observations,freq='min'))\n        for length,increment in [(0,60),(3600,60),(86400,300)]:\n            paths=np.asarray(simulate('BTC',stamp,increment,length,17,context)[2:])\n            assert paths.shape==(17,length//increment+1)\n            assert np.isfinite(paths).all() and (paths>0).all() and (paths[:,0]==100).all()\nwith open('agent/results/stratified_contract_audit.json','w') as output:\n    json.dump({'status':'passed','comparisons':checks,'edge_cases':['NaNs','future rows','unsorted rows','constant/single close','zero horizon','pre-weight fallback']},output,indent=2)\nprint('Passed 24 exact serving comparisons plus all context and fallback cases',flush=True)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
