{"type":"item.completed","item":{"id":"item_219","type":"command_execution","command":"/bin/bash -c \"cat agent/fit_activity.py; cat agent/activity.py; sed -n '1,120p' agent/auxiliary.py; cat agent/BUDGET.md; tail -4 agent/multiscale_dense.log\"","aggregated_output":"\"\"\"Chronological quote-activity ablation around the numerical daily stack.\"\"\"\n\nimport json\nfrom concurrent.futures import ProcessPoolExecutor\n\nimport numpy as np\nimport pandas as pd\nfrom sklearn.ensemble import HistGradientBoostingRegressor\nfrom threadpoolctl import threadpool_limits\n\nfrom activity import activity_features\nfrom predict import AGENT_DIR, ensure_workspace_cwd, load_context\nfrom temporal import temporal_embedding, temporal_weights\nfrom tree_vol import tree_design, tree_residual_batch\nfrom train_vol import ASSETS\n\n\ndef make_asset(asset):\n    data = np.load(AGENT_DIR/'results'/'volatility_training.npz')\n    selected = np.load(AGENT_DIR/'results'/'temporal_exact_training.npz')['indices']\n    positions = np.flatnonzero(data['inputs'][selected, -13:].argmax(axis=1) == ASSETS.index(asset))\n    indices = selected[positions]\n    timestamps = pd.to_datetime(data['timestamps'][indices], utc=True)\n    prices = load_context(asset, timestamps.min()-pd.Timedelta(days=7), timestamps.max())\n    values = [activity_features(prices.loc[timestamp-pd.Timedelta(days=7):timestamp], timestamp, np.exp(data['inputs'][index, 16]))\n              for index, timestamp in zip(indices, timestamps)]\n    print(asset, len(values), 'activity contexts', flush=True)\n    return positions, np.stack(values)\n\n\ndef main():\n    ensure_workspace_cwd()\n    print((AGENT_DIR/'BUDGET.md').read_text(), flush=True)\n    threadpool_limits(2)\n    data = np.load(AGENT_DIR/'results'/'volatility_training.npz')\n    sequences = np.load(AGENT_DIR/'results'/'temporal_exact_training.npz')\n    selected = sequences['indices']\n    inputs = data['inputs'][selected]\n    cache = AGENT_DIR/'results'/'activity_training.npz'\n    if not cache.exists():\n        with ProcessPoolExecutor(max_workers=2) as executor:\n            batches = list(executor.map(make_asset, ASSETS))\n        positions = np.concatenate([batch[0] for batch in batches])\n        activity = np.concatenate([batch[1] for batch in batches])[np.argsort(positions)]\n        np.savez(cache, indices=selected, activity=activity)\n    stored = np.load(cache)\n    if not np.array_equal(stored['indices'], selected):\n        raise ValueError('Activity cache alignment mismatch')\n    previous = dict(np.load(AGENT_DIR/'volatility_weights.npz'))\n    hidden = np.clip((inputs-previous['center'])/previous['spread'], -8, 8)\n    for layer in [0, 2]:\n        hidden = hidden @ previous[f'{layer}.weight'].T+previous[f'{layer}.bias']\n        hidden = hidden/(1+np.exp(-hidden))\n    baseline = np.clip(hidden @ previous['4.weight'].T+previous['4.bias'], -2, 2)\n    baseline[:, 0] *= .5\n    embedded = np.stack([temporal_embedding(sequence, values, 'temporal_exact')\n                         for sequence, values in zip(sequences['sequences'], inputs)])\n    temporal = temporal_weights('temporal_exact')\n    baseline += np.clip(embedded @ temporal['head.2.weight'].T+temporal['head.2.bias'], -.8, .8)\n    timestamps = pd.to_datetime(data['timestamps'][selected], utc=True)\n    control = tree_design(inputs, sequences['sequences'], timestamps, baseline)['temporal']\n    control = np.column_stack([control, embedded])\n    baseline += tree_residual_batch(control, 'tree_student')\n    designs = {'control':control, 'activity':np.column_stack([control, stored['activity']])}\n    targets = np.clip(data['targets'][selected, 1], .02, 20)\n    ratios = targets/np.exp(baseline[:, 1])\n    training = timestamps < pd.Timestamp('2026-07-01', tz='UTC')\n    initial = best = float(np.mean(ratios[~training]+baseline[~training, 1]))\n    best_kind, best_stage = None, 0\n    exported = {'base':np.zeros(2), 'stages':np.array(0)}\n    diagnostics = {}\n    for kind, design in designs.items():\n        model = HistGradientBoostingRegressor(loss='poisson', max_iter=200, learning_rate=.03,\n                                             max_leaf_nodes=7, min_samples_leaf=150, l2_regularization=10.,\n                                             early_stopping=False, random_state=95)\n        model.fit(design[training], ratios[training])\n        for stage, prediction in enumerate(model.staged_predict(design[~training]), 1):\n            if stage not in [50, 100, 200]:\n                continue\n            correction = np.clip(np.log(prediction), -.5, .5)\n            loss = float(np.mean(ratios[~training]*np.exp(-correction)+baseline[~training, 1]+correction))\n            diagnostics[f'{kind}/{stage}'] = loss\n            print(kind, stage, loss, flush=True)\n            if loss < best:\n                best, best_kind, best_stage = loss, kind, stage\n                exported = {'base':np.array([0., model._baseline_prediction.item()]), 'stages':np.array(stage)}\n                for number in range(stage):\n                    nodes = model._predictors[number][0].nodes\n                    exported[f'1_{number}'] = nodes\n                    zero = nodes.copy()\n                    zero['value'] = 0.\n                    exported[f'0_{number}'] = zero\n    control_best = min([initial]+[loss for key, loss in diagnostics.items() if key.startswith('control/')])\n    np.savez(AGENT_DIR/'activity_weights.npz', **exported)\n    metrics = {'initial_validation_loss':initial, 'best_validation_loss':best, 'kind':best_kind, 'stages':best_stage,\n               'best_control_loss':control_best, 'passes_activity_gate':bool(best_kind == 'activity' and best < control_best-.0001),\n               'diagnostics':diagnostics, 'target_cutoff':'2026-07-26', 'validation_start':'2026-07-01',\n               'training_rows':int(training.sum()), 'validation_rows':int((~training).sum())}\n    (AGENT_DIR/'activity_weights.json').write_text(json.dumps(metrics, indent=2))\n    print(metrics, flush=True)\n\n\nif __name__ == '__main__':\n    main()\n\"\"\"Past-only quote activity features from the scored close series.\"\"\"\n\nimport numpy as np\nimport pandas as pd\n\n\ndef activity_features(context, timestamp, reference):\n    close = pd.to_numeric(context.close, errors='coerce')\n    close = close.loc[(close.index > timestamp-pd.Timedelta(days=7)) & (close.index <= timestamp)]\n    close = close.loc[np.isfinite(close) & (close > 0)].sort_index()\n    close = close.loc[~close.index.duplicated(keep='last')]\n    age = (timestamp-close.index).total_seconds().to_numpy()/60\n    gaps = np.diff(close.index.as_unit('ns').asi8)/60e9\n    normalized = np.diff(np.log(close.to_numpy()))/np.sqrt(gaps)\n    values = []\n    for width in [60, 360, 1440, 10080]:\n        selected = age[1:] < width\n        returns = normalized[selected]\n        intervals = gaps[selected]\n        if len(returns) < 2:\n            values.extend([0.]*8)\n            continue\n        absolute = np.abs(returns)\n        mean_absolute = max(float(absolute.mean()), 1e-10)\n        signs = np.sign(returns)\n        sign_correlation = float(np.corrcoef(signs[:-1], signs[1:])[0, 1]) if signs[:-1].std() > 0 and signs[1:].std() > 0 else 0.\n        values.extend([float(np.mean(returns == 0)), float(np.sum(age < width)/width),\n                       float(np.log1p(intervals.mean())), float(np.mean(intervals > 1)),\n                       float(np.log(mean_absolute/max(reference, 1e-8))), sign_correlation,\n                       float(np.quantile(absolute, .95)/mean_absolute), float(np.mean(signs))])\n    last = float(close.iloc[-1])\n    factor = 10.**min(8, max(0, 12-int(np.floor(np.log10(last)))) )\n    tick = 0.\n    if len(close) > 1 and close.max()*factor < np.iinfo(np.int64).max/4:\n        integer_prices = np.rint(close.to_numpy()*factor).astype(np.int64)\n        tick = float(np.gcd.reduce(np.abs(np.diff(integer_prices)))/factor)\n    values.extend([np.log1p(tick/(last*max(reference, 1e-8))), np.log1p(age[-1])])\n    return np.clip(np.nan_to_num(np.asarray(values), nan=0., posinf=8., neginf=-8.), -8, 8)\n\"\"\"NaN-tolerant, scale-normalized features from optional candle information.\"\"\"\n\nimport numpy as np\nimport pandas as pd\n\nHALF_LIVES = (30,60,180,360,720,1440,2880,10080)\n\n\ndef auxiliary_features(context,timestamp,reference,absolute):\n    age=(pd.Timestamp(timestamp)-context.index).total_seconds().to_numpy()/60\n    valid_count=max(int(context.close.notna().sum()),1)\n    vector=[]\n    usable=False\n    if {'high','low'}.issubset(context.columns):\n        high=pd.to_numeric(context.high,errors='coerce').to_numpy(dtype=float)\n        low=pd.to_numeric(context.low,errors='coerce').to_numpy(dtype=float)\n        valid=np.isfinite(high)&np.isfinite(low)&(low>0)&(high>=low)\n        ranges=np.log(high[valid]/low[valid])\n        usable=bool((ranges>0).sum()>20 and valid.sum()/valid_count>.5)\n    else:\n        valid=np.zeros(len(context),dtype=bool)\n        ranges=np.array([])\n    for half_life in HALF_LIVES:\n        scale=absolute[half_life]\n        if usable:\n            weights=np.exp(-np.log(2)*age[valid]/half_life)\n            scale=float(np.average(ranges,weights=weights)*np.sqrt(np.pi/8))\n        vector.append(np.log(max(scale,1e-9)/max(reference,1e-8)))\n    vector.append(min(1.,valid.sum()/valid_count))\n    for column in ['volume','trade_count']:\n        values=pd.to_numeric(context[column],errors='coerce').to_numpy(dtype=float) if column in context else np.full(len(context),np.nan)\n        valid_values=np.isfinite(values)&(values>=0)\n        if valid_values.sum()>20 and np.any(values[valid_values]>0):\n            means=[]\n            for half_life in [60,360,1440,10080]:\n                weights=np.exp(-np.log(2)*age[valid_values]/half_life)\n                means.append(float(np.average(values[valid_values],weights=weights)))\n            vector.extend(np.log((np.asarray(means[:3])+1e-8)/(means[-1]+1e-8)))\n            vector.extend([np.log1p(means[-1]),min(1.,valid_values.sum()/valid_count)])\n        else:\n            vector.extend([0.]*5)\n    return np.asarray(vector,dtype=np.float32),usable\n# BUDGET — maintained by the harness (read-only for you)\n\n- Credits: 76.66 / 100.00 USD (77%)\n- Time   : 1.9 h elapsed, 16.1 h remaining (10%)\n- Phase  : normal\n                   TSLAX   stackrank:multiscale:1    2493.036681\n                   WTIOIL  stackrank:multiscale:1    3974.744703\n                   XAU     stackrank:multiscale:1    1438.180489\n                   XRP     stackrank:multiscale:1    2369.504438\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_220","type":"command_execution","command":"/bin/bash -c \"OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run python - <<'PY'\nimport pandas as pd,json\nfrom pathlib import Path\nroot=Path('agent/results')\nframe=pd.read_parquet(root/'multiscale_dense.parquet')\ncontrol=pd.concat([pd.read_parquet(root/'rank_daily_dense.parquet').query(\\\"window=='dev1'\\\"),pd.read_parquet(root/'rank_warm_dev2.parquet').query('length==86400')],ignore_index=True)\nmerged=frame.merge(control,on=['window','asset','length','time'],suffixes=['_new','_control'],validate='one_to_one')\nscored=merged.time+pd.to_timedelta(merged.length,unit='s')\nselected=merged.loc[merged.window.eq('dev1') | (scored>=pd.Timestamp('2026-08-08',tz='UTC'))].copy()\nselected['competition']=selected.asset.isin(['BTC','ETH','SOL','XRP','HYPE']).map({True:'crypto',False:'com_equ'})\nmeans=selected.groupby(['window','competition','asset'])[['crps_new','crps_control']].mean()\nratios=(means.crps_new/means.crps_control).groupby(['window','competition']).mean()\nprint(ratios.to_string())\nassert (ratios<.99999).all()\nframe.loc[frame.window.eq('dev1')].to_parquet(root/'multiscale_dev1.parquet')\nframe.loc[frame.window.eq('warm_dev2')].to_parquet(root/'multiscale_warm_dev2.parquet')\nwith open(root/'multiscale_dense_ratios.json','w') as output:\n    json.dump({str(key):float(value) for key,value in ratios.items()},output,indent=2)\nPY\nOMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run agent/rank_screen.py multiscale_dev1 --template starter_full --round-step 1 --workers 4 > agent/multiscale_dev1_rewards.log 2>&1\nOMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run agent/rank_screen.py multiscale_warm_dev2 --template incumbent_warm_dev2 --template-window dev2 --score-start 2026-08-08 --round-step 1 --workers 4 > agent/multiscale_warm_rewards.log 2>&1\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
