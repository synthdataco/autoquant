{"type":"item.completed","item":{"id":"item_156","type":"command_execution","command":"/bin/bash -c \"sed -n '452,481p' agent/research.py; sed -n '204,231p' agent/research.py; rg -n 'context_sequence' agent/temporal.py; sed -n '16,48p' agent/temporal.py; sed -n '314,347p' agent/research.py; tail -4 agent/rank_dev1_rewards.log\"","aggregated_output":"def evaluate_asset(task):\n    asset, length, window, variants, count, stride = task\n    ensure_workspace_cwd()\n    begin, end = [pd.Timestamp(value, tz=\"UTC\") for value in WINDOWS[window]]\n    increment = 60 if length == 3600 else 300\n    field = get_miner_scores(begin, end, asset, length, increment)\n    times = pd.DatetimeIndex(field.start_time.unique()).sort_values()[::stride]\n    prices = load_context(asset, times.min() - pd.Timedelta(days=7), min(end, times.max() + pd.Timedelta(seconds=length)))\n    prompts = []\n    for timestamp in times:\n        prompts.append({\"asset\": asset, \"start_time\": timestamp, \"time_length\": length, \"time_increment\": increment,\n                        \"real_prices\": _slice_real_prices(prices[[\"close\"]], timestamp, length, increment)})\n    _fill_gaps_from_realized_paths(prompts, asset)\n    rows = []\n    for prompt in prompts:\n        timestamp = prompt[\"start_time\"]\n        context = prices.loc[(prices.index > timestamp - pd.Timedelta(days=7)) & (prices.index <= timestamp)]\n        feature = features(context, timestamp, increment)\n        for variant in variants:\n            started = perf_counter()\n            paths = generate_variant(feature, asset, timestamp, increment, length, count, variant)\n            elapsed = perf_counter() - started\n            score, detail = score_paths(paths, prompt[\"real_prices\"], increment, asset, length)\n            row = {\"asset\": asset, \"length\": length, \"window\": window, \"time\": timestamp,\n                   \"variant\": variant, \"crps\": score, \"latency\": elapsed, \"paths\": count}\n            row.update({item[\"Interval\"]: item[\"CRPS\"] for item in detail})\n            rows.append(row)\n    print(f\"{window} {asset} {length}: {len(prompts)} prompts, {len(variants)} variants\", flush=True)\n    return rows\n\n        parts = ['hybrid','1']\n    if range_parameters:\n        cycle_strength = .75\n        parts = ['hybrid','1']\n    if auxiliary_strength is not None:\n        cycle_strength=.75\n        parts=['auto','0','1','5']\n    if atom_mode:\n        cycle_strength=.75\n        parts=['hybrid','1']\n    if tuned_mode or weighted_strength is not None:\n        cycle_strength=.75\n        parts=['auto','0','1','5']\n    if shape_parameters:\n        cycle_strength = .75\n        parts = [\"hybrid\", \"1\"]\n    if parts[0] == \"cycle\":\n        parts = [\"hybrid\", \"1\"]\n    if parts[0] == \"hybrid\":\n        strength = 1.0 if asset in CRYPTO else float(parts[1])\n        parts = [\"auto\", \"0\", \"1\", \"5\"] if length == 3600 else [\"ml\", \"neural\", str(strength)]\n    schedule = None\n    learned_scale = 1.0\n    if tuned_mode or weighted_strength is not None:\n        incumbent=learned_multiplier(feature,asset,length,'neural')**(.5 if length==3600 else 1.)\n        learned_scale=incumbent\n        if refresh_strength is not None and pd.Timestamp(start_time)>=pd.Timestamp('2026-08-07',tz='UTC'):\n            refreshed = learned_multiplier(feature,asset,length,refresh_kind)**(.5 if length==3600 else 1.)\n35:def context_sequence(context, timestamp, reference):\n    observed = pd.DataFrame({'absolute': np.abs(changes), 'square': changes**2, 'signed': changes}, index=close.index[1:])\n    grouped = observed.resample('1h', origin=origin, closed='right', label='right')\n    means = grouped.mean()\n    means['coverage'] = grouped['absolute'].count() / 60\n    return means\n\n\ndef normalize_sequence(hourly, timestamp, reference):\n    grid = pd.date_range(end=pd.Timestamp(timestamp).floor('min'), periods=168, freq='1h')\n    rows = hourly.reindex(grid)\n    absolute = rows.absolute.to_numpy() * np.sqrt(np.pi / 2)\n    root_square = np.sqrt(rows.square.to_numpy())\n    values = np.stack([np.log(np.maximum(absolute, 1e-9) / reference),\n                       np.log(np.maximum(root_square, 1e-9) / reference),\n                       rows.signed.to_numpy() / reference,\n                       rows.coverage.to_numpy()])\n    return np.clip(np.nan_to_num(values, nan=0., posinf=5., neginf=-5.), -5, 5).astype(np.float32)\n\n\ndef context_sequence(context, timestamp, reference):\n    close = context.close.loc[(context.index > timestamp - pd.Timedelta(days=7)) & (context.index <= timestamp)]\n    hourly = hourly_observations(close, pd.Timestamp(timestamp).floor('min'))\n    return normalize_sequence(hourly, timestamp, reference)\n\n\n@lru_cache(maxsize=4)\ndef temporal_weights(kind='temporal'):\n    return dict(np.load(Path(__file__).with_name(f'{kind}_weights.npz')))\n\n\ndef temporal_embedding(sequence, static, kind='temporal'):\n    weights = temporal_weights(kind)\n    values = sequence\n        sigma = feature[\"starter\"]\n    else:\n        sigma = feature[parts[0]][int(parts[1])]\n    multiplier = float(parts[2]) if len(parts) > 2 else 1.0\n    sigma *= multiplier * learned_scale * np.sqrt(increment / 60)\n    if range_parameters:\n        half_life = 60 if length==3600 else 360\n        ratio = feature['range'][half_life]*float(range_parameters[1])/max(feature['av'][half_life],1e-8)\n        sigma *= ratio**float(range_parameters[0])\n    if schedule is not None:\n        sigma = schedule * np.sqrt(increment / 60)\n    flat_sigma = sigma\n    if cycle_strength and length > 3600:\n        future_times = pd.Timestamp(start_time) + pd.to_timedelta(np.arange(1,steps+1)*increment,unit='s')\n        profile = feature['cycle']\n        clock_indices = future_times.hour\n        if clock_parameters:\n            from clock_profile import estimate_profile\n\n            bins,cycle_strength,floor = int(clock_parameters[0]),float(clock_parameters[1]),float(clock_parameters[2])\n            profiles = feature.setdefault('clock_profiles',{})\n            if (bins,floor) not in profiles:\n                profiles[(bins,floor)] = estimate_profile(feature['context'],start_time,bins,floor)\n            profile = profiles[(bins,floor)]\n            clock_indices = (future_times.hour*60+future_times.minute)*bins//1440\n        if prior_strength:\n            with np.load(AGENT_DIR/'clock_profiles.npz') as archive:\n                profile = (1-prior_strength)*profile + prior_strength*archive[asset]\n        sigma *= 1 + cycle_strength*(profile[clock_indices]-1)\n    if lead_strength is not None and length > 3600:\n        from train_vol import feature_vector\n\n        weights = learned_weights('lead')\n        values = np.clip((feature_vector(feature,asset)-weights['center'])/weights['spread'],-8,8)\ndev1/stratified/com-equ-24h {'reward_rank': 111, 'final_rank': 107, 'miners': 257, 'reward_ratio': 0.05988411218101849, 'reward_rounds': 1499, 'first_round': '2026-07-28 00:13:00+00:00', 'last_round': '2026-08-06 23:50:00+00:00'}\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_157","type":"command_execution","command":"/bin/bash -c \"OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run python - <<'PY'\nimport sys,json,time\nimport numpy as np\nimport pandas as pd\nsys.path.insert(0,'agent')\nimport modeling\nfrom predict import load_context\nfrom research import features,generate_variant\nstamp=pd.Timestamp('2026-08-10 12:17',tz='UTC')\nchecks=[]\nfor asset in ['BTC','HYPE','SP500','AAPLX']:\n    raw=load_context(asset,stamp-pd.Timedelta(days=7),stamp)\n    context=raw.loc[raw.index>stamp-pd.Timedelta(days=7)]\n    for increment,length in [(60,3600),(300,86400)]:\n        for count in [1,17,1000]:\n            started=time.perf_counter()\n            result=modeling.simulate(asset,stamp,increment,length,count,raw)\n            paths=np.asarray(result[2:])\n            assert result[:2]==(stamp,increment)\n            assert paths.shape==(count,length//increment+1)\n            assert np.isfinite(paths).all() and (paths>0).all()\n            assert np.all(paths[:,0]==context.close.dropna().iloc[-1])\n            reference=generate_variant(features(context,stamp,increment),asset,stamp,increment,length,count,'stackrank:increments:0')\n            np.testing.assert_allclose(paths,reference,rtol=1e-12,atol=0)\n            checks.append({'asset':asset,'increment':increment,'count':count,'seconds':time.perf_counter()-started})\n        original=np.asarray(modeling.simulate(asset,stamp,increment,length,17,context)[2:])\n        cleaned=context.dropna(subset=['close'])\n        np.testing.assert_array_equal(modeling.simulate(asset,stamp,increment,length,17,cleaned)[2:],original)\n        changed=context.copy()\n        changed.loc[:,changed.columns\"'!='\"'close']=np.nan\n        future=pd.DataFrame(1e20,index=[stamp+pd.Timedelta(minutes=1)],columns=context.columns)\n        changed=pd.concat([changed,future]).iloc[::-1]\n        np.testing.assert_array_equal(modeling.simulate(asset,stamp,increment,length,17,changed)[2:],original)\nfor stamp in [pd.Timestamp('2026-07-20',tz='UTC'),pd.Timestamp('2026-08-10',tz='UTC')]:\n    for observations in [1,20,10080]:\n        context=pd.DataFrame({'close':100.},index=pd.date_range(end=stamp,periods=observations,freq='min'))\n        for length,increment in [(0,60),(3600,60),(86400,300)]:\n            paths=np.asarray(modeling.simulate('BTC',stamp,increment,length,17,context)[2:])\n            assert paths.shape==(17,length//increment+1)\n            assert np.isfinite(paths).all() and (paths>0).all() and (paths[:,0]==100).all()\nprint('Passed 24 serving/research comparisons and context/fallback edge cases')\nwith open('agent/results/incumbent_contract_audit.json','w') as output:\n    json.dump({'status':'passed','comparisons':checks,'edge_cases':['NaN auxiliary columns','raw vs dropped NaNs','future rows excluded','unsorted rows','1/17/1000 paths','constant history','single close','zero horizon','pre-weight fallback'],'audit_correction':'Reference features must use the same open-left seven-day context as both serving and actual evaluation.'},output,indent=2)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
