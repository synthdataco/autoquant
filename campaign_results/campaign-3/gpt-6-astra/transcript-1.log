{"type":"item.started","item":{"id":"item_181","type":"command_execution","command":"/bin/bash -c \"OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run python - <<'PY'\nimport pandas as pd,json\nframe=pd.read_parquet('agent/results/rank_warm_compare.parquet')\nframe['scored_time']=frame.time+pd.to_timedelta(frame.length,unit='s')\nframe=frame.loc[frame.scored_time>=pd.Timestamp('2026-08-08',tz='UTC')]\nframe['day']=frame.scored_time.dt.floor('d')\nframe['competition']=frame.apply(lambda row:'crypto-1h' if row.length==3600 else 'crypto-24h' if row.asset in ['BTC','ETH','SOL','XRP','HYPE'] else 'com-equ-24h',axis=1)\nresult={}\nfor competition,group in frame.groupby('competition'):\n    daily=group.groupby(['asset','day','variant']).crps.mean().unstack('variant')\n    ratio=(daily.stratified/daily.incumbent).groupby('day').mean()\n    assets=group.groupby(['asset','variant']).crps.mean().unstack('variant')\n    result[competition]={'asset_mean_ratio':float((assets.stratified/assets.incumbent).mean()),'days_improved':int((ratio<1).sum()),'days':len(ratio),'daily_ratios':{str(day):float(value) for day,value in ratio.items()},'asset_ratios':(assets.stratified/assets.incumbent).to_dict()}\nprint(json.dumps(result,indent=2))\nwith open('agent/results/stratified_warm_crps_stability.json','w') as output:\n    json.dump(result,output,indent=2)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
