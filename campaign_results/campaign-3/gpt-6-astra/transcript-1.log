{"type":"item.started","item":{"id":"item_245","type":"command_execution","command":"/bin/bash -c \"OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run python - <<'PY'\nimport pandas as pd,json\nfor name,variants in [('weekly_lead_dense',['stackweekly:0','stackweekly:1']),('fan_center_screen',['stackcenter:0','stackcenter:1'])]:\n    frame=pd.read_parquet('agent/results/'+name+'.parquet')\n    frame['competition']=frame.apply(lambda row:'hourly' if row.length==3600 else 'crypto' if row.asset in ['BTC','ETH','SOL','XRP','HYPE'] else 'com_equ',axis=1)\n    means=frame.groupby(['window','competition','asset','variant']).crps.mean().unstack('variant')\n    ratios=(means[variants[1]]/means[variants[0]]).groupby(['window','competition']).mean()\n    print(name,ratios.to_string(),sep='\\\\n')\n    with open('agent/results/'+name+'_ratios.json','w') as output:\n        json.dump({str(key):float(value) for key,value in ratios.items()},output,indent=2)\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_245","type":"command_execution","command":"/bin/bash -c \"OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run python - <<'PY'\nimport pandas as pd,json\nfor name,variants in [('weekly_lead_dense',['stackweekly:0','stackweekly:1']),('fan_center_screen',['stackcenter:0','stackcenter:1'])]:\n    frame=pd.read_parquet('agent/results/'+name+'.parquet')\n    frame['competition']=frame.apply(lambda row:'hourly' if row.length==3600 else 'crypto' if row.asset in ['BTC','ETH','SOL','XRP','HYPE'] else 'com_equ',axis=1)\n    means=frame.groupby(['window','competition','asset','variant']).crps.mean().unstack('variant')\n    ratios=(means[variants[1]]/means[variants[0]]).groupby(['window','competition']).mean()\n    print(name,ratios.to_string(),sep='\\\\n')\n    with open('agent/results/'+name+'_ratios.json','w') as output:\n        json.dump({str(key):float(value) for key,value in ratios.items()},output,indent=2)\nPY\"","aggregated_output":"weekly_lead_dense\nwindow  competition\ndev1    com_equ        0.999970\n        crypto         0.999998\ndev2    com_equ        0.999884\n        crypto         0.999903\nfan_center_screen\nwindow  competition\ndev1    com_equ        1.000039\n        crypto         0.999947\n        hourly         0.999939\ndev2    com_equ        1.000047\n        crypto         0.999956\n        hourly         1.000037\n","exit_code":0,"status":"completed"}}
