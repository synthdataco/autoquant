{"type":"item.started","item":{"id":"item_132","type":"command_execution","command":"/bin/bash -c \"uv run python - <<'PY'\nimport pandas as pd\nhourly=pd.read_parquet('agent/results/ticked_hourly_dense.parquet')\nprint('Hourly baseline variants:',hourly.variant.unique().tolist())\nfor name in ['rank_daily_dense','rank_hourly_dense']:\n    candidate=pd.read_parquet('agent/results/'+name+'.parquet')\n    if name=='rank_daily_dense':\n        crypto=pd.read_parquet('agent/results/daily_challenger.parquet')\n        crypto=crypto.loc[crypto.asset.isin(['BTC','ETH','SOL','XRP','HYPE'])]\n        equity=pd.read_parquet('agent/results/lead_finetune_equity.parquet')\n        baseline=pd.concat([crypto,equity],ignore_index=True)\n    else:\n        baseline=hourly.loc[hourly.variant.eq('ticked:gcd')]\n    matched=candidate.merge(baseline,on=['window','asset','length','time'],suffixes=('_new','_old'),validate='one_to_one')\n    means=matched.groupby(['window','asset'])[['crps_new','crps_old']].mean()\n    means['ratio']=means.crps_new/means.crps_old\n    crypto=means.index.get_level_values('asset').isin(['BTC','ETH','SOL','XRP','HYPE'])\n    print(name,len(matched),means.groupby([means.index.get_level_values('window'),crypto]).ratio.mean().to_dict())\nPY\ncat agent/BUDGET.md; tail -4 agent/incumbent_warm_dev2.log\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
