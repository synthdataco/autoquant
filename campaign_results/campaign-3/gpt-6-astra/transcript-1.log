weights,'model_sha256':hashlib.sha256((root/'modeling.py').read_bytes()).hexdigest(),'context_time':str(stamp)},indent=2))\nprint('Passed all 18 asset/format combinations at 17 and 1000 paths; seven numerical weight archives verified')\nPY\"","aggregated_output":"Passed all 18 asset/format combinations at 17 and 1000 paths; seven numerical weight archives verified\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_264","type":"command_execution","command":"/bin/bash -c \"OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 uv run python - <<'PY'\nimport json,pandas as pd\nfrom pathlib import Path\nroot=Path('agent/results')\nmetrics=json.loads((root/'sampler_promoted_metrics.json').read_text())\nfor window,filename in [('dev1','fan_center_dev1_template_step1_ranks.json'),('warm_dev2','fan_center_warm_dev2_template_step1_ranks_from_2026-08-08.json')]:\n    centered=json.loads((root/filename).read_text())\n    metrics[window]['crypto-24h']=centered[f'{window}/stackcenter:1/crypto-24h']\n    metrics[window]['score_estimate']=100*sum(min(1,values['reward_ratio']) for key,values in metrics[window].items() if key\"'!='\"'score_estimate')/3\n    print(window,metrics[window]['score_estimate'])\n(root/'frozen_development_metrics.json').write_text(json.dumps(metrics,indent=2))\nframe=pd.read_parquet(root/'weekly_joint_dense.parquet')\nbase=pd.read_parquet(root/'multiscale_dense.parquet')\npaired=frame.merge(base,on=['window','asset','length','time'],suffixes=['_new','_base'],validate='one_to_one')\nscored=paired.time+pd.to_timedelta(paired.length,unit='s')\npaired=paired.loc[paired.window.eq('dev1') | (scored>=pd.Timestamp('2026-08-08',tz='UTC'))]\nmeans=paired.groupby(['window','asset'])[['crps_new','crps_base']].mean()\nratios=(means.crps_new/means.crps_base).groupby('window').mean()\nprint('Completed weekly interaction CRPS:',ratios.to_dict())\n(root/'weekly_joint_dense_ratios.json').write_text(json.dumps(ratios.to_dict(),indent=2))\nPY\ncat agent/BUDGET.md; ps -eo pid,etime,args | rg 'research.py|fit_micro_score.py|rank_screen.py' | cut -c1-170\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
