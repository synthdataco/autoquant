{"type":"item.completed","item":{"id":"item_190","type":"command_execution","command":"/bin/bash -c \"cat agent/fit_lead_temporal.py; sed -n '1,210p' agent/fit_lead_finetune.py; sed -n '1,140p' agent/train_lead.py\"","aggregated_output":"\"\"\"Chronological selection of frozen-encoder lead-shape corrections.\"\"\"\n\nimport json\n\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom scipy.optimize import minimize\n\nfrom predict import AGENT_DIR, ensure_workspace_cwd\nfrom temporal import temporal_embedding\n\n\ndef main():\n    ensure_workspace_cwd()\n    print((AGENT_DIR/'BUDGET.md').read_text(), flush=True)\n    torch.set_num_threads(2)\n    data = np.load(AGENT_DIR/'results'/'volatility_training.npz')\n    sequences = np.load(AGENT_DIR/'results'/'temporal_exact_training.npz')\n    leads = np.load(AGENT_DIR/'results'/'lead_training.npz')\n    selected = sequences['indices']\n    inputs = data['inputs'][selected]\n    keys = pd.MultiIndex.from_arrays([data['timestamps'][selected], inputs[:, -13:].argmax(axis=1)])\n    lead_keys = pd.MultiIndex.from_arrays([leads['timestamps'], leads['inputs'][:, -13:].argmax(axis=1)])\n    positions = lead_keys.get_indexer(keys)\n    valid = positions >= 0\n    inputs = inputs[valid]\n    timestamps = data['timestamps'][selected][valid]\n    targets = np.clip(leads['targets'][positions[valid]], .02, 20)\n    weights = dict(np.load(AGENT_DIR/'lead_weights.npz'))\n    static = np.clip((inputs-weights['center'])/weights['spread'], -8, 8)\n    hidden = static.copy()\n    for layer in [0, 2]:\n        hidden = hidden @ weights[f'{layer}.weight'].T + weights[f'{layer}.bias']\n        hidden = hidden/(1+np.exp(-hidden))\n    baseline = np.clip(hidden @ weights['4.weight'].T + weights['4.bias'], -2, 2)\n    embedded = np.stack([temporal_embedding(sequence, values, 'temporal_exact')\n                         for sequence, values in zip(sequences['sequences'][valid], inputs)])\n    design = np.column_stack([embedded, static])\n    training = timestamps < pd.Timestamp('2026-07-01', tz='UTC').value\n    center = design[training].mean(axis=0)\n    spread = np.maximum(design[training].std(axis=0), .1)\n    design = np.column_stack([np.ones(len(design)), np.clip((design-center)/spread, -8, 8)])\n    duration = np.diff(weights['edges'])/weights['edges'][-1]\n    training_design = torch.tensor(design[training], dtype=torch.float64)\n    training_baseline = torch.tensor(baseline[training], dtype=torch.float64)\n    training_targets = torch.tensor(targets[training], dtype=torch.float64)\n    durations = torch.tensor(duration, dtype=torch.float64)\n\n    def validation(coefficients):\n        correction = np.clip(design[~training] @ coefficients, -.5, .5)\n        raw = baseline[~training]+correction\n        normalization = np.log((np.exp(raw)*duration).sum(axis=1)/(np.exp(baseline[~training])*duration).sum(axis=1))\n        prediction = raw-normalization[:, None]\n        return float(np.mean(((targets[~training]*np.exp(-prediction)+prediction)*duration).sum(axis=1)))\n\n    best_coefficients = np.zeros((design.shape[1], 5))\n    initial = best = validation(best_coefficients)\n    best_penalty = None\n    diagnostics = {}\n    for penalty in [.01, .1, 1.]:\n        def objective(flattened):\n            coefficients = torch.tensor(flattened.reshape(design.shape[1], 5), requires_grad=True)\n            correction = (training_design @ coefficients).clamp(-.5, .5)\n            raw = training_baseline+correction\n            normalization = torch.log((raw.exp()*durations).sum(axis=1)/(training_baseline.exp()*durations).sum(axis=1))\n            prediction = raw-normalization[:, None]\n            loss = ((training_targets*torch.exp(-prediction)+prediction)*durations).sum(axis=1).mean()\n            loss = loss + penalty*coefficients.square().sum()\n            loss.backward()\n            return float(loss.detach()), coefficients.grad.numpy().ravel()\n\n        fit = minimize(objective, best_coefficients.ravel()*0, method='L-BFGS-B', jac=True,\n                       options={'maxiter':150, 'ftol':1e-10})\n        coefficients = fit.x.reshape(design.shape[1], 5)\n        loss = validation(coefficients)\n        diagnostics[str(penalty)] = {'loss':loss, 'success':bool(fit.success), 'iterations':int(fit.nit)}\n        print(penalty, diagnostics[str(penalty)], flush=True)\n        if loss < best:\n            best, best_penalty, best_coefficients = loss, penalty, coefficients\n    np.savez(AGENT_DIR/'lead_temporal_weights.npz', coefficients=best_coefficients,\n             center=center, spread=spread, static_center=weights['center'], static_spread=weights['spread'], duration=duration)\n    metrics = {'initial_validation_loss':initial, 'best_validation_loss':best, 'penalty':best_penalty,\n               'diagnostics':diagnostics, 'target_cutoff':'2026-07-26', 'validation_start':'2026-07-01',\n               'training_rows':int(training.sum()), 'validation_rows':int((~training).sum())}\n    (AGENT_DIR/'lead_temporal_weights.json').write_text(json.dumps(metrics, indent=2))\n    print(metrics, flush=True)\n\n\nif __name__ == '__main__':\n    main()\n\"\"\"Fit a mean-preserving nonlinear temporal lead correction.\"\"\"\n\nimport json\n\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom torch import nn\n\nfrom predict import AGENT_DIR, ensure_workspace_cwd\nfrom temporal import temporal_embedding\nfrom train_temporal import TemporalNetwork\n\n\ndef main():\n    ensure_workspace_cwd()\n    print((AGENT_DIR/'BUDGET.md').read_text(), flush=True)\n    torch.set_num_threads(2)\n    torch.manual_seed(73)\n    device = 'cuda' if torch.cuda.is_available() else 'cpu'\n    if device == 'cuda':\n        torch.cuda.set_per_process_memory_fraction(.35)\n    data = np.load(AGENT_DIR/'results'/'volatility_training.npz')\n    sequences = np.load(AGENT_DIR/'results'/'temporal_exact_training.npz')\n    leads = np.load(AGENT_DIR/'results'/'lead_training.npz')\n    selected = sequences['indices']\n    inputs = data['inputs'][selected]\n    keys = pd.MultiIndex.from_arrays([data['timestamps'][selected], inputs[:, -13:].argmax(axis=1)])\n    lead_keys = pd.MultiIndex.from_arrays([leads['timestamps'], leads['inputs'][:, -13:].argmax(axis=1)])\n    positions = lead_keys.get_indexer(keys)\n    valid = positions >= 0\n    inputs = inputs[valid]\n    targets = np.clip(leads['targets'][positions[valid]], .02, 20)\n    weights = dict(np.load(AGENT_DIR/'lead_weights.npz'))\n    static = np.clip((inputs-weights['center'])/weights['spread'], -8, 8)\n    hidden = static.copy()\n    for layer in [0, 2]:\n        hidden = hidden @ weights[f'{layer}.weight'].T+weights[f'{layer}.bias']\n        hidden = hidden/(1+np.exp(-hidden))\n    baseline = np.clip(hidden @ weights['4.weight'].T+weights['4.bias'], -2, 2)\n    embedded = np.stack([temporal_embedding(sequence, values, 'temporal_exact')\n                         for sequence, values in zip(sequences['sequences'][valid], inputs)])\n    linear = dict(np.load(AGENT_DIR/'lead_temporal_weights.npz'))\n    design = np.column_stack([embedded, static])\n    design = np.column_stack([np.ones(len(design)), np.clip((design-linear['center'])/linear['spread'], -8, 8)])\n    raw = baseline+np.clip(design @ linear['coefficients'], -.5, .5)\n    duration = np.diff(weights['edges'])/weights['edges'][-1]\n    baseline = raw-np.log((np.exp(raw)*duration).sum(axis=1)/(np.exp(baseline)*duration).sum(axis=1))[:, None]\n    training = data['timestamps'][selected][valid] < pd.Timestamp('2026-07-01', tz='UTC').value\n    network = TemporalNetwork()\n    network.head[2] = nn.Linear(48, 5)\n    previous = dict(np.load(AGENT_DIR/'temporal_exact_weights.npz'))\n    network.load_state_dict({key:torch.tensor(previous[key]) for key in network.state_dict() if not key.startswith('head.2')}, strict=False)\n    nn.init.zeros_(network.head[2].weight)\n    nn.init.zeros_(network.head[2].bias)\n    network = network.to(device)\n    sequence_tensor = torch.tensor(sequences['sequences'][valid], dtype=torch.float32, device=device)\n    static_tensor = torch.tensor(static, dtype=torch.float32, device=device)\n    labels = torch.tensor(targets, dtype=torch.float32, device=device)\n    baseline_tensor = torch.tensor(baseline, dtype=torch.float32, device=device)\n    duration_tensor = torch.tensor(duration, dtype=torch.float32, device=device)\n    indices = torch.tensor(np.flatnonzero(training), device=device)\n    validation = torch.tensor(np.flatnonzero(~training), device=device)\n    optimizer = torch.optim.AdamW(network.parameters(), lr=.0002, weight_decay=.1)\n\n    def loss_for(batch, regularize=False):\n        correction = network(sequence_tensor[batch], static_tensor[batch]).clamp(-.5, .5)\n        raw = baseline_tensor[batch]+correction\n        normalization = torch.log((raw.exp()*duration_tensor).sum(axis=1)/(baseline_tensor[batch].exp()*duration_tensor).sum(axis=1))\n        prediction = raw-normalization[:, None]\n        loss = ((labels[batch]*torch.exp(-prediction)+prediction)*duration_tensor).sum(axis=1).mean()\n        if regularize:\n            loss = loss+.05*correction.square().mean()+.02*torch.diff(correction, dim=1).square().mean()\n        return loss\n\n    initial = best = float(loss_for(validation).detach().cpu())\n    best_epoch = -1\n    best_state = {key:value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n    for epoch in range(120):\n        for batch in indices[torch.randperm(len(indices), device=device)].split(512):\n            optimizer.zero_grad()\n            loss_for(batch, True).backward()\n            optimizer.step()\n        with torch.no_grad():\n            loss = float(loss_for(validation).cpu())\n        if loss < best:\n            best, best_epoch = loss, epoch\n            best_state = {key:value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n        if epoch % 20 == 0:\n            print(epoch, loss, best, flush=True)\n    np.savez(AGENT_DIR/'lead_finetune_weights.npz', center=weights['center'], spread=weights['spread'], duration=duration, **best_state)\n    metrics = {'initial_validation_loss':initial, 'best_validation_loss':best, 'best_epoch':best_epoch,\n               'training_rows':int(training.sum()), 'validation_rows':int((~training).sum()),\n               'target_cutoff':'2026-07-26', 'validation_start':'2026-07-01', 'seed':73, 'epochs':120}\n    (AGENT_DIR/'lead_finetune_weights.json').write_text(json.dumps(metrics, indent=2))\n    print(metrics, flush=True)\n\n\nif __name__ == '__main__':\n    main()\n\"\"\"Learn future volatility shape from causally split snapshot labels.\"\"\"\n\nimport json\nfrom concurrent.futures import ProcessPoolExecutor\n\nimport numpy as np\nimport pandas as pd\nimport torch\nfrom torch import nn\n\nfrom predict import AGENT_DIR, ensure_workspace_cwd, load_context\nfrom train_vol import ASSETS\n\nEDGES = np.array([0, 60, 180, 360, 720, 1440])\n\n\ndef make_asset(asset):\n    data = np.load(AGENT_DIR / 'results' / 'volatility_training.npz')\n    mask = np.argmax(data['inputs'][:, -len(ASSETS):], axis=1) == ASSETS.index(asset)\n    inputs = data['inputs'][mask]\n    timestamps = pd.to_datetime(data['timestamps'][mask], utc=True)\n    prices = load_context(asset, timestamps.min() - pd.Timedelta(minutes=10), pd.Timestamp('2026-07-26', tz='UTC'))\n    observed = prices.close.dropna()\n    gaps = np.diff(observed.index.as_unit('ns').asi8) / 60e9\n    normalized = pd.Series(np.abs(np.diff(np.log(observed.to_numpy()))) / np.sqrt(gaps), index=observed.index[1:]).reindex(prices.index)\n    labels = []\n    for begin, end in zip(EDGES[:-1], EDGES[1:]):\n        width = int(end - begin)\n        future = normalized.shift(-int(begin + 1)).iloc[::-1].rolling(width, min_periods=max(10, width // 10)).mean().iloc[::-1]\n        labels.append(future.reindex(timestamps).to_numpy() * np.sqrt(np.pi / 2))\n    targets = np.stack(labels, axis=1) / np.exp(inputs[:, 16:17])\n    valid = np.isfinite(targets).all(axis=1) & (targets > 0).all(axis=1)\n    print(asset, int(valid.sum()), flush=True)\n    return inputs[valid], targets[valid], timestamps.as_unit('ns').asi8[valid]\n\n\ndef main():\n    ensure_workspace_cwd()\n    print((AGENT_DIR / 'BUDGET.md').read_text(), flush=True)\n    dataset = AGENT_DIR / 'results' / 'lead_training.npz'\n    if not dataset.exists():\n        with ProcessPoolExecutor(max_workers=4) as executor:\n            batches = list(executor.map(make_asset, ASSETS))\n        np.savez(dataset, inputs=np.concatenate([batch[0] for batch in batches]),\n                 targets=np.concatenate([batch[1] for batch in batches]),\n                 timestamps=np.concatenate([batch[2] for batch in batches]))\n    data = np.load(dataset)\n    inputs, targets, timestamps = data['inputs'], np.clip(data['targets'], .02, 20), data['timestamps']\n    previous = dict(np.load(AGENT_DIR / 'volatility_weights.npz'))\n    training = timestamps < pd.Timestamp('2026-07-01', tz='UTC').value\n    torch.set_num_threads(4)\n    torch.manual_seed(73)\n    device = 'cuda' if torch.cuda.is_available() else 'cpu'\n    if device == 'cuda':\n        torch.cuda.set_per_process_memory_fraction(.35)\n    standardized = np.clip((inputs - previous['center']) / previous['spread'], -8, 8)\n    values = torch.tensor(standardized, dtype=torch.float32, device=device)\n    labels = torch.tensor(targets, dtype=torch.float32, device=device)\n    weights = torch.tensor(np.diff(EDGES) / EDGES[-1], dtype=torch.float32, device=device)\n    network = nn.Sequential(nn.Linear(30, 48), nn.SiLU(), nn.Linear(48, 32), nn.SiLU(), nn.Linear(32, 5)).to(device)\n    with torch.no_grad():\n        for layer in [0, 2]:\n            network[layer].weight.copy_(torch.tensor(previous[f'{layer}.weight'], device=device))\n            network[layer].bias.copy_(torch.tensor(previous[f'{layer}.bias'], device=device))\n        network[4].weight.copy_(torch.tensor(np.repeat(previous['4.weight'][1:2], 5, axis=0), device=device))\n        network[4].bias.copy_(torch.tensor(np.repeat(previous['4.bias'][1], 5), device=device))\n    optimizer = torch.optim.AdamW(network.parameters(), lr=.0005, weight_decay=.04)\n    indices = torch.tensor(np.flatnonzero(training), device=device)\n    validation = torch.tensor(np.flatnonzero(~training), device=device)\n\n    def loss_for(selected, regularize=False):\n        logs = network(values[selected]).clamp(-2, 2)\n        loss = ((labels[selected] * torch.exp(-logs) + logs) * weights).sum(axis=1).mean()\n        if regularize:\n            loss = loss + .02 * logs.square().mean() + .02 * torch.diff(logs, dim=1).square().mean()\n        return loss\n\n    initial = float(loss_for(validation).detach().cpu())\n    best, best_epoch = initial, -1\n    best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n    for epoch in range(180):\n        for batch in indices[torch.randperm(len(indices), device=device)].split(1024):\n            optimizer.zero_grad()\n            loss_for(batch, True).backward()\n            optimizer.step()\n        with torch.no_grad():\n            loss = float(loss_for(validation).cpu())\n        if loss < best:\n            best, best_epoch = loss, epoch\n            best_state = {key: value.detach().cpu().numpy().copy() for key, value in network.state_dict().items()}\n        if epoch % 30 == 0:\n            print(epoch, loss, best, flush=True)\n    np.savez(AGENT_DIR / 'lead_weights.npz', center=previous['center'], spread=previous['spread'], edges=EDGES, **best_state)\n    metrics = {'initial_validation_loss': initial, 'best_validation_loss': best, 'best_epoch': best_epoch,\n               'training_rows': int(training.sum()), 'validation_rows': int((~training).sum()),\n               'target_cutoff': '2026-07-26', 'validation_start': '2026-07-01', 'edges_minutes': EDGES.tolist()}\n    (AGENT_DIR / 'lead_weights.json').write_text(json.dumps(metrics, indent=2))\n    print(metrics, flush=True)\n\n\nif __name__ == '__main__':\n    main()\n","exit_code":0,"status":"completed"}}
