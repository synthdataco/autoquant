{"type":"item.started","item":{"id":"item_167","type":"command_execution","command":"/bin/bash -c \"uv run python - <<'PY'\nimport sys\nimport numpy as np\nsys.path.insert(0,'agent')\nfrom sampling import mixture_shocks,multiscale_stratification,student_quantiles\nfor count in [1,17,1000]:\n    scale=np.linspace(.5,1.5,288)\n    shocks=mixture_shocks(count,288,73,'sobol')\n    adjusted=multiscale_stratification(shocks*scale,scale)\n    np.testing.assert_allclose(np.sort(adjusted.sum(axis=1)),student_quantiles(count)*np.linalg.norm(scale),rtol=1e-12,atol=1e-12)\n    assert np.isfinite(adjusted).all()\nprint('Multiscale projection finite and exact at terminal marginal for 1/17/1000 paths')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
