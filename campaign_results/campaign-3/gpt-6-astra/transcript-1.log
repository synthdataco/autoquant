{"type":"item.completed","item":{"id":"item_149","type":"command_execution","command":"/bin/bash -c \"sed -n '199,260p' agent/modeling.py; sed -n '1,33p' agent/modeling.py; sed -n '1,55p' agent/research.py; rg --files agent | rg 'test|audit|check'; sed -n '1,160p' agent/field_eval.py; tail -4 agent/rank_dev1_rewards.log\"","aggregated_output":"    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    if time_increment <= 0 or time_length < 0 or num_simulations < 1:\n        raise ValueError(\"Positive increment/path count and nonnegative horizon are required\")\n    timestamp = pd.to_datetime(start_time, unit=\"s\", utc=True) if isinstance(start_time, (int, float)) else pd.Timestamp(start_time)\n    timestamp = timestamp.tz_localize(\"UTC\") if timestamp.tzinfo is None else timestamp.tz_convert(\"UTC\")\n    if context_prices is None or \"close\" not in context_prices:\n        raise ValueError(\"A context frame containing close prices is required\")\n    closes = pd.to_numeric(context_prices[\"close\"], errors=\"coerce\").copy()\n    closes.index = pd.to_datetime(closes.index, utc=True)\n    closes = closes.loc[(closes.index > timestamp - pd.Timedelta(days=7)) & (closes.index <= timestamp)]\n    closes = closes.loc[np.isfinite(closes) & (closes > 0)].sort_index()\n    closes = closes.loc[~closes.index.duplicated(keep=\"last\")]\n    if closes.empty:\n        raise ValueError(\"No finite positive close exists in the seven-day context\")\n    last = float(closes.iloc[-1])\n    absolute, root_square = _features(closes, timestamp)\n    hourly = time_length <= 3600\n    sigma = absolute[60 if hourly else 360]\n    learned_scale = 1.0\n    if timestamp >= WEIGHTS_AVAILABLE_FROM:\n        learned_scale = _learned_multiplier(absolute, root_square, asset, hourly)\n        if not hourly and asset not in ASSETS[:5]:\n            learned_scale *= _periodic_multiplier(asset,timestamp)\n        embedding, sequence = _temporal_embedding(closes,timestamp,absolute,root_square,asset)\n        residual = _temporal_adjustment(embedding)\n        learned_scale *= np.exp(residual[0 if hourly else 1])\n        if not hourly:\n            learned_scale *= _student_multiplier(sequence,embedding,absolute,root_square,asset,timestamp,residual)\n    sigma *= learned_scale*np.sqrt(time_increment / 60)\n    seed = int.from_bytes(hashlib.blake2s(f\"{asset}:{timestamp}\".encode(), digest_size=8).digest(), \"little\")\n    rng = np.random.default_rng(seed)\n    steps = time_length // time_increment\n    if not hourly:\n        bins = (48 if asset in ASSETS[:5] else 96) if timestamp>=WEIGHTS_AVAILABLE_FROM else 24\n        cycle_strength = 1.0 if asset not in ASSETS[:5] and timestamp>=WEIGHTS_AVAILABLE_FROM else CYCLE_STRENGTH\n        profile = _volatility_profile(closes,bins)\n        future_times = timestamp + pd.to_timedelta(np.arange(1,steps+1)*time_increment,unit='s')\n        clock_indices = (future_times.hour*60+future_times.minute)*bins//1440\n        sigma *= 1 + cycle_strength*(profile[clock_indices]-1)\n        if timestamp >= WEIGHTS_AVAILABLE_FROM:\n            sigma *= _lead_profile(absolute,root_square,asset,steps,time_increment,embedding,sequence)\n    if timestamp >= WEIGHTS_AVAILABLE_FROM:\n        shocks = _sobol_shocks(num_simulations,steps,seed)\n    else:\n        shocks = rng.standard_normal(((num_simulations + 1) // 2, steps))\n        shocks = np.concatenate([shocks, -shocks], axis=0)[:num_simulations]\n        shocks *= np.sqrt(3 / rng.chisquare(5, size=(num_simulations, 1)))\n    log_paths = np.concatenate([np.zeros((num_simulations, 1)), np.cumsum(shocks * sigma, axis=1)], axis=1)\n    paths = last * np.exp(np.clip(log_paths, -40, 40))\n    tick = _quote_tick(closes,last)\n    if 0<tick<last*.01:\n        paths = np.maximum(tick,last+np.rint((paths-last)/tick)*tick)\n        paths[:,0] = last\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"Offline probabilistic paths with robust, horizon-specific volatility forecasts.\"\"\"\n\nfrom __future__ import annotations\n\nimport hashlib\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\nfrom scipy.special import ndtri\nfrom scipy.stats import chi2, qmc\n\nASSETS = (\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\", \"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\")\nHALF_LIVES = (30, 60, 180, 360, 720, 1440, 2880, 10080)\nCOMMODITY_EQUITY_BLEND = 1.0\nCYCLE_STRENGTH = 0.75\nLEAD_STRENGTH = 0.5\nWEIGHTS_AVAILABLE_FROM = pd.Timestamp('2026-07-26',tz='UTC')\n\n\n@lru_cache(maxsize=8)\ndef _weights(kind='volatility'):\n    with np.load(Path(__file__).with_name(f\"{kind}_weights.npz\"), allow_pickle=False) as archive:\n        return {name: archive[name] for name in archive.files}\n\n\ndef _features(closes, timestamp):\n    minutes = (closes.index - timestamp).total_seconds().to_numpy() / 60\n    gaps = np.diff(minutes)\n    returns = np.diff(np.log(closes.to_numpy(dtype=float)))\n    valid = (gaps > 0) & np.isfinite(returns)\n    normalized = returns[valid] / np.sqrt(gaps[valid])\n\"\"\"Frozen-data experiments using only the official scorer exposed by predict.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport hashlib\nimport json\nimport math\nfrom functools import lru_cache\nfrom concurrent.futures import ProcessPoolExecutor, as_completed\nfrom pathlib import Path\nfrom time import perf_counter\n\nimport numpy as np\nimport pandas as pd\n\nfrom predict import AGENT_DIR, CUTOFF, ensure_workspace_cwd, load_context, score_paths\nfrom auxiliary import auxiliary_features\nfrom synth_lib.backtester.config import slug_for, competition_for\nfrom synth_lib.backtester.loading import get_miner_scores\nfrom synth_lib.backtester.preparation import _slice_real_prices, _fill_gaps_from_realized_paths\n\nCRYPTO = [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"]\nEQUITY = [\"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\"]\nWINDOWS = {\"dev1\": (\"2026-07-28\", \"2026-08-07\"), \"dev2\": (\"2026-08-08\", \"2026-08-18\"), \"final\": (\"2026-08-18\", \"2026-08-28\"), \"warm_dev2\": (\"2026-07-29\", \"2026-08-18\")}\n\n\ndef seed_for(asset, start_time):\n    return int.from_bytes(hashlib.blake2s(f\"{asset}:{start_time}\".encode(), digest_size=8).digest(), \"little\")\n\n\n@lru_cache(maxsize=8)\ndef learned_weights(kind='neural'):\n    filename = 'score_weights.npz' if kind == 'curve' else 'volatility_weights.npz'\n    if kind.startswith('refit_'):\n        filename = f'{kind}_weights.npz'\n    if kind=='aux':\n        filename='aux_weights.npz'\n    if kind=='weighted':\n        filename='weighted_score_weights.npz'\n    if kind=='lead':\n        filename='lead_weights.npz'\n    if kind=='fiveminute':\n        filename='fiveminute_weights.npz'\n    if kind=='ensemble':\n        filename='ensemble_weights.npz'\n    if kind=='uncertainty':\n        filename='uncertainty_weights.npz'\n    if kind=='calibration':\n        filename='shape_score_fine_weights.npz'\n    if kind=='calibration600':\n        filename='shape_score_fine_600_weights.npz'\n    if kind=='refresh':\n        filename='refresh_weights.npz'\n    return dict(np.load(AGENT_DIR / filename))\n\"\"\"Full-path official backtests and cross-asset validator reward aggregation.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport shutil\nfrom concurrent.futures import ProcessPoolExecutor\nfrom functools import partial\n\nimport pandas as pd\n\nfrom predict import AGENT_DIR, WORKSPACE, backtest, ensure_workspace_cwd, generate, parallel_combined\nfrom research import CRYPTO, EQUITY, WINDOWS, features, generate_variant\nfrom synth_lib.backtester.config import competition_for, slug_for\nfrom synth_lib.backtester.result import BacktestResult\nfrom synth_lib.backtester.scoring import compute_combined_smoothed_scores\n\n\ndef variant_simulate(asset, start_time, time_increment, time_length, num_simulations, context_prices, variant):\n    feature = features(context_prices, start_time, time_increment)\n    paths = generate_variant(feature, asset, pd.Timestamp(start_time), time_increment, time_length, num_simulations, variant)\n    return (start_time, time_increment, *paths.tolist())\n\n\ndef evaluate(task):\n    asset, length, window, variant, name, warmup_days = task\n    ensure_workspace_cwd()\n    begin, end = [pd.Timestamp(value, tz=\"UTC\").to_pydatetime() for value in WINDOWS[window]]\n    begin -= pd.Timedelta(days=warmup_days)\n    increment = 60 if length == 3600 else 300\n    label = f\"{asset}_{length}\"\n    output = AGENT_DIR / \"results\" / name / window\n    output.mkdir(parents=True, exist_ok=True)\n    if (output / f\"{label}_summary.json\").exists():\n        return str(output), label\n    predictions = WORKSPACE / \"miner_outputs\" / name / window / label / \"predictions\"\n    kwargs = {} if variant == \"model\" else {\"simulator\": partial(variant_simulate, variant=variant)}\n    total = generate(asset, begin, end, time_increment=increment, time_length=length,\n                     num_simulations=1000, predictions_dir=predictions, **kwargs)\n    print(f\"Generated {total} {label} {window}\", flush=True)\n    result = backtest(miner_name=name, asset=asset, time_length=length, time_increment=increment,\n                      n_backtest_days=(end-begin).days, predictions_dir=predictions, eval_end=end)\n    result.prompt_df.to_parquet(output / f\"{label}_prompts.parquet\")\n    result.smoothed_scores.to_parquet(output / f\"{label}_smoothed.parquet\")\n    (output / f\"{label}_summary.json\").write_text(json.dumps(result.summary, indent=2))\n    shutil.rmtree(predictions)\n    return str(output), label\n\n\ndef reward_summary(frame):\n    totals = frame.groupby(\"miner_uid\").reward_weight.sum()\n    latest = frame.loc[frame.updated_at.eq(frame.updated_at.max())].set_index(\"miner_uid\")\n    return {\"reward_rank\": int(totals.rank(ascending=False, method=\"min\").loc[999]),\n            \"final_rank\": int(latest.new_smoothed_score.rank(method=\"min\").loc[999]),\n            \"miners\": int(len(totals)), \"reward_ratio\": float(totals.loc[999] / totals.drop(999).max()),\n            \"reward_rounds\": int(frame.updated_at.nunique()),\n            \"first_round\": str(frame.updated_at.min()), \"last_round\": str(frame.updated_at.max())}\n\n\ndef aggregate(name, window, score_start=None):\n    output = AGENT_DIR / \"results\" / name / window\n    competition_groups = {}\n    for path in sorted(output.glob('*_summary.json')):\n        label = path.name.removesuffix('_summary.json')\n        asset, length = label.rsplit('_', 1)\n        config = competition_for(asset, int(length))\n        result = BacktestResult(name, pd.read_parquet(output / f'{label}_prompts.parquet'),\n                                pd.read_parquet(output / f'{label}_smoothed.parquet'), json.loads(path.read_text()))\n        competition_groups.setdefault(slug_for(config), (config, []))[1].append(result)\n    summaries = {}\n    for label, (config, results) in competition_groups.items():\n        combined_path = output / f'{label}_combined.parquet'\n        combined = pd.read_parquet(combined_path) if combined_path.exists() else parallel_combined(results, config)\n        combined.to_parquet(combined_path)\n        selected = combined if score_start is None else combined.loc[combined.updated_at >= pd.Timestamp(score_start,tz='UTC')]\n        summaries[label] = reward_summary(selected)\n        summaries[label]['assets'] = len(results)\n        print(label, summaries[label], flush=True)\n    summaries['score_estimate'] = 100 * sum(min(1, value['reward_ratio']) for value in summaries.values()) / 3\n    (output / 'competition_metrics.json').write_text(json.dumps(summaries, indent=2))\n    return summaries\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--name', required=True)\n    parser.add_argument('--variant', default='model')\n    parser.add_argument('--windows', default='dev1,dev2')\n    parser.add_argument('--assets', default=','.join(CRYPTO + EQUITY))\n    parser.add_argument('--workers', type=int, default=6)\n    parser.add_argument('--aggregate-only', action='store_true')\n    parser.add_argument('--warmup-days', type=int, default=0)\n    parser.add_argument('--score-start')\n    args = parser.parse_args()\n    print((AGENT_DIR / 'BUDGET.md').read_text(), flush=True)\n    if not args.aggregate_only:\n        tasks = [(asset, length, window, args.variant, args.name, args.warmup_days)\n                 for window in args.windows.split(',') for asset in args.assets.split(',')\n                 for length in ([86400, 3600] if asset in CRYPTO else [86400])]\n        with ProcessPoolExecutor(max_workers=args.workers) as executor:\n            list(executor.map(evaluate, tasks))\n    for window in args.windows.split(','):\n        print(aggregate(args.name, window, args.score_start), flush=True)\n\n\nif __name__ == '__main__':\n    main()\ndev1/stratified/com-equ-24h {'reward_rank': 111, 'final_rank': 107, 'miners': 257, 'reward_ratio': 0.05988411218101849, 'reward_rounds': 1499, 'first_round': '2026-07-28 00:13:00+00:00', 'last_round': '2026-08-06 23:50:00+00:00'}\n","exit_code":0,"status":"completed"}}
