arts)>2 else None\n166:    clock_parameters=(['48','.75','.25'] if asset in CRYPTO else ['96','1','.25']) if stacked_mode else [parts[1],parts[3],'0.25'] if parts[0]=='sharp' else parts[1:] if parts[0]=='clock' else None\n173:    tick_kind=parts[1] if parts[0] in ['ticked','stacktick'] else 'min'\n174:    atom_mode='quantize' if parts[0] in ['ticked','stacktick'] else parts[0] if parts[0] in ['symboot','hurdle','quantize'] else None\n175:    atom_parameter=1. if parts[0] in ['ticked','stacktick'] else float(parts[1]) if atom_mode else 0.\n250:            if tree_strength is not None:\n252:                from tree_vol import tree_design, tree_residual\n258:                design = tree_design(feature_vector(feature,asset)[None],feature['temporal'][None],\n260:                learned_scale *= np.exp(tree_strength*tree_residual(design)[0 if length==3600 else 1])\n402:def evaluate_asset(task):\n433:def main():\n435:    parser.add_argument(\"--name\", required=True)\n436:    parser.add_argument(\"--variants\", default=\"starter,rv:360,rv:1440,av:360,av:1440\")\n437:    parser.add_argument(\"--variants-equity\")\n438:    parser.add_argument(\"--windows\", default=\"dev1,dev2\")\n439:    parser.add_argument(\"--assets\", default=\",\".join(CRYPTO + EQUITY))\n440:    parser.add_argument(\"--paths\", type=int, default=256)\n441:    parser.add_argument(\"--stride-low\", type=int, default=4)\n442:    parser.add_argument(\"--stride-high\", type=int, default=24)\n443:    parser.add_argument(\"--workers\", type=int, default=10)\n444:    parser.add_argument(\"--format\", choices=['all','low','high'],default='all')\n\"\"\"Self-evaluation via the official synth-lib backtester.\n\nUsage: uv run agent/predict.py --asset BTC --days 3 --eval-end 2026-07-15\nGenerates predictions from agent/modeling.py over a grid of past prompts (covered by the\nsnapshot), writes them in the standard format, then scores them with backtest() (validator\nCRPS + rank vs the real field via the Synth API).\n\n--num-simulations defaults to 1000, matching the validator's real serving size\n(PromptConfig.num_simulations). Lowering it (e.g. for a quick local iteration loop) speeds up\ngeneration at the cost of a slightly pessimistic CRPS: empirical CRPS is biased upward for\nfewer sampled paths, and the real field's CRPS was computed at 1000.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nimport sys\nfrom concurrent.futures import ProcessPoolExecutor\nfrom datetime import datetime, timedelta, timezone\nfrom pathlib import Path\n\nimport pandas as pd\n\nfrom synth_lib.backtester.orchestration import backtest\nfrom synth_lib.backtester.loading import get_miner_scores\nfrom synth_lib.backtester.config import competition_for\nfrom synth_lib.backtester.scoring import calculate_crps_for_miner\nfrom synth_lib.backtester.scoring import _compute_prompt_score_stats_for_group\nfrom synth_lib.backtester.scoring import compute_combined_smoothed_scores, _trim_warmup\nfrom synth_lib.backtester.result import BacktestResult\nfrom synth_lib.preparation.config import OHLCV_COLUMNS, STORE_SUBDIR\nfrom synth_lib.preparation.market_data import MinutePriceStore\n\n# All paths are resolved from the location of THIS file, never from the cwd: the\n# script therefore works whether launched from the workspace root (`uv run agent/predict.py`)\n# or from agent/. The price snapshot is mounted at the workspace root, not inside agent/.\nAGENT_DIR = Path(__file__).resolve().parent\nWORKSPACE = AGENT_DIR.parent\nsys.path.insert(0, str(AGENT_DIR))\n\nfrom modeling import simulate  # noqa: E402  (import after adding AGENT_DIR to sys.path)\n\nCONTEXT_MINUTES = 7 * 24 * 60\nPREDICTIONS_DIR = WORKSPACE / \"miner_outputs\" / \"campaign\" / \"predictions\"\nCUTOFF = pd.Timestamp(\"2026-08-29\", tz=\"UTC\")\n_COMBINED_CONTEXT = None\n\n\ndef _initialize_combined(results, competition):\n    global _COMBINED_CONTEXT\n    _COMBINED_CONTEXT = (results, competition)\n\n\ndef _combined_chunk(timestamps):\n    results, competition = _COMBINED_CONTEXT\n    selected = [BacktestResult(result.miner_name,result.prompt_df,\n                               pd.DataFrame({'updated_at':timestamps if index==0 else []}),result.summary)\n                for index,result in enumerate(results)]\n    return compute_combined_smoothed_scores(selected,competition)\n\n\ndef parallel_combined(results, competition, workers=4):\n    import numpy as np\n\n    timestamps = sorted({pd.Timestamp(timestamp) for result in results\n                         for timestamp in result.smoothed_scores['updated_at'].unique()})\n    if workers <= 1 or len(timestamps) < 8:\n        return compute_combined_smoothed_scores(results,competition)\n    chunks = [chunk.tolist() for chunk in np.array_split(np.array(timestamps,dtype=object),workers) if len(chunk)]\n    with ProcessPoolExecutor(max_workers=workers,initializer=_initialize_combined,initargs=(results,competition)) as executor:\n        frames = list(executor.map(_combined_chunk,chunks))\n    combined = pd.concat(frames,ignore_index=True).sort_values(['updated_at','miner_uid'])\n    scored_times = pd.concat([result.prompt_df[['scored_time']] for result in results],ignore_index=True)\n    return _trim_warmup(combined,scored_times,warmup_days=competition.window_days).reset_index(drop=True)\n\n\ndef score_paths(paths, realized, time_increment, asset, time_length):\n    import numpy as np\n\n    competition = competition_for(asset, time_length)\n    return calculate_crps_for_miner(\n        np.asarray(paths, dtype=float), np.asarray(realized, dtype=float),\n        time_increment, competition.scoring_intervals,\n    )\n\n\ndef replay_prompt_scores(field, candidate):\n    combined = pd.concat([field, candidate], ignore_index=True).sort_values([\"scored_time\", \"miner_uid\"])\n    stats = combined.groupby([\"scored_time\", \"asset\", \"time_length\", \"time_increment\"], group_keys=False)[\"crps\"].apply(_compute_prompt_score_stats_for_group)\n    for column in [\"new_prompt_scores\", \"percentile90\", \"lowest_score\"]:\n        combined[column] = stats[column]\n    return combined\n\n6:CRPS + rank vs the real field via the Synth API).\n51:def _initialize_combined(results, competition):\n56:def _combined_chunk(timestamps):\n64:def parallel_combined(results, competition, workers=4):\n79:def score_paths(paths, realized, time_increment, asset, time_length):\n89:def replay_prompt_scores(field, candidate):\n97:def load_context(asset, start, end):\n107:def ensure_workspace_cwd() -> None:\n120:def store_root(asset: str) -> Path:\n130:def check_snapshot_coverage(asset: str, start: datetime, end: datetime) -> None:\n153:def generate(\n198:def main() -> None:\n200:    ap.add_argument(\"--asset\", default=\"BTC\")\n201:    ap.add_argument(\"--days\", type=int, default=3)\n202:    ap.add_argument(\"--eval-end\", required=True, help=\"YYYY-MM-DD, must be <= data_cutoff\")\n203:    ap.add_argument(\"--run-name\", default=\"campaign\")\n204:    ap.add_argument(\"--time-increment\", type=int, default=300, help=\"seconds between points (60 for CRYPTO_1H)\")\n205:    ap.add_argument(\"--time-length\", type=int, default=86_400, help=\"horizon in seconds (3600 for CRYPTO_1H)\")\n206:    ap.add_argument(\n[project]\nname = \"campaign-workspace\"\nversion = \"0.1.0\"\nrequires-python = \">=3.12,<3.14\"\ndependencies = [\n    \"synth-lib\",\n    \"numpy>=2.2\",\n    \"pandas>=2.3\",\n    \"torch>=2.0\",\n    \"chronos-forecasting==1.5.3\",\n    \"scikit-learn==1.7.2\",\n]\n\n[tool.uv.sources]\nsynth-lib = { git = \"https://github.com/synthdataco/synth-lib\", rev = \"782a44fe7585a4e7b0388e22b99c57f13d56f5ee\" }\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"sed -n '402,490p' agent/research.py; ls agent/*rank*py agent/*field*py agent/*test*py 2>/dev/null; sed -n '1,130p' agent/tree_vol.py; sed -n '1,95p' agent/chronos_vol.py; ls agent/results | tail -20\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_12","type":"command_execution","command":"/bin/bash -c \"sed -n '402,490p' agent/research.py; ls agent/*rank*py agent/*field*py agent/*test*py 2>/dev/null; sed -n '1,130p' agent/tree_vol.py; sed -n '1,95p' agent/chronos_vol.py; ls agent/results | tail -20\"","aggregated_output":"def evaluate_asset(task):\n    asset, length, window, variants, count, stride = task\n    ensure_workspace_cwd()\n    begin, end = [pd.Timestamp(value, tz=\"UTC\") for value in WINDOWS[window]]\n    increment = 60 if length == 3600 else 300\n    field = get_miner_scores(begin, end, asset, length, increment)\n    times = pd.DatetimeIndex(field.start_time.unique()).sort_values()[::stride]\n    prices = load_context(asset, times.min() - pd.Timedelta(days=7), min(end, times.max() + pd.Timedelta(seconds=length)))\n    prompts = []\n    for timestamp in times:\n        prompts.append({\"asset\": asset, \"start_time\": timestamp, \"time_length\": length, \"time_increment\": increment,\n                        \"real_prices\": _slice_real_prices(prices[[\"close\"]], timestamp, length, increment)})\n    _fill_gaps_from_realized_paths(prompts, asset)\n    rows = []\n    for prompt in prompts:\n        timestamp = prompt[\"start_time\"]\n        context = prices.loc[(prices.index > timestamp - pd.Timedelta(days=7)) & (prices.index <= timestamp)]\n        feature = features(context, timestamp, increment)\n        for variant in variants:\n            started = perf_counter()\n            paths = generate_variant(feature, asset, timestamp, increment, length, count, variant)\n            elapsed = perf_counter() - started\n            score, detail = score_paths(paths, prompt[\"real_prices\"], increment, asset, length)\n            row = {\"asset\": asset, \"length\": length, \"window\": window, \"time\": timestamp,\n                   \"variant\": variant, \"crps\": score, \"latency\": elapsed, \"paths\": count}\n            row.update({item[\"Interval\"]: item[\"CRPS\"] for item in detail})\n            rows.append(row)\n    print(f\"{window} {asset} {length}: {len(prompts)} prompts, {len(variants)} variants\", flush=True)\n    return rows\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument(\"--name\", required=True)\n    parser.add_argument(\"--variants\", default=\"starter,rv:360,rv:1440,av:360,av:1440\")\n    parser.add_argument(\"--variants-equity\")\n    parser.add_argument(\"--windows\", default=\"dev1,dev2\")\n    parser.add_argument(\"--assets\", default=\",\".join(CRYPTO + EQUITY))\n    parser.add_argument(\"--paths\", type=int, default=256)\n    parser.add_argument(\"--stride-low\", type=int, default=4)\n    parser.add_argument(\"--stride-high\", type=int, default=24)\n    parser.add_argument(\"--workers\", type=int, default=10)\n    parser.add_argument(\"--format\", choices=['all','low','high'],default='all')\n    args = parser.parse_args()\n    print((AGENT_DIR / \"BUDGET.md\").read_text(), flush=True)\n    variants = args.variants.split(\",\")\n    tasks = [(asset, length, window, args.variants_equity.split(',') if asset in EQUITY and args.variants_equity else variants,\n              args.paths, args.stride_high if length == 3600 else args.stride_low)\n             for window in args.windows.split(\",\") for asset in args.assets.split(\",\")\n             for length in ([86400, 3600] if asset in CRYPTO else [86400])\n             if args.format=='all' or (args.format=='low' and length==86400) or (args.format=='high' and length==3600)]\n    with ProcessPoolExecutor(max_workers=args.workers) as executor:\n        results = list(executor.map(evaluate_asset, tasks))\n    result = pd.DataFrame([row for batch in results for row in batch])\n    target = AGENT_DIR / \"results\" / f\"{args.name}.parquet\"\n    target.parent.mkdir(parents=True, exist_ok=True)\n    result.to_parquet(target)\n    print(result.groupby([\"window\", \"length\", \"asset\", \"variant\"]).crps.mean().to_string(), flush=True)\n\n\nif __name__ == \"__main__\":\n    main()\nagent/field_eval.py\nagent/rank_screen.py\n\"\"\"NumPy inference for small exported histogram-boosted residuals.\"\"\"\n\nfrom functools import lru_cache\nfrom pathlib import Path\n\nimport numpy as np\nimport pandas as pd\n\n\ndef tree_design(static, sequences, timestamps, baseline, forecasts=None):\n    summaries = np.concatenate([sequences[:, :, -width:].mean(axis=2)\n                                for width in [1, 3, 6, 12, 24, 48, 96, 168]], axis=1)\n    timestamps = pd.DatetimeIndex(timestamps)\n    day = (timestamps.hour + timestamps.minute / 60) / 24\n    week = (timestamps.dayofweek + day) / 7\n    clock = np.column_stack([function(2*np.pi*frequency*phase)\n                             for phase in [day, week] for frequency in [1, 2]\n                             for function in [np.sin, np.cos]])\n    designs = {'static': np.column_stack([static, baseline])}\n    designs['temporal'] = np.column_stack([designs['static'], summaries, clock])\n    if forecasts is not None:\n        designs['pretrained'] = np.column_stack([designs['temporal'], forecasts.reshape(len(static), -1)])\n    return designs\n\n\n@lru_cache(maxsize=1)\ndef tree_weights():\n    return dict(np.load(Path(__file__).with_name('tree_weights.npz')))\n\n\ndef tree_residual(design):\n    weights = tree_weights()\n    output = weights['base'].copy()\n    for head in range(2):\n        for stage in range(int(weights['stages'])):\n            nodes = weights[f'{head}_{stage}']\n            index = 0\n            while not nodes[index]['is_leaf']:\n                node = nodes[index]\n                value = design[int(node['feature_idx'])]\n                left = bool(node['missing_go_to_left']) if np.isnan(value) else value <= node['num_threshold']\n                index = int(node['left'] if left else node['right'])\n            output[head] += nodes[index]['value']\n    return np.clip(output, -.5, .5)\n\"\"\"Frozen pretrained volatility features and bounded calibration.\"\"\"\n\nfrom functools import lru_cache\nimport os\nfrom pathlib import Path\n\nimport numpy as np\n\nMODEL_REVISION = '0e96a1377adca89eebae3bbde4f859dc3b9f4b46'\n\n\n@lru_cache(maxsize=1)\ndef pipeline():\n    import torch\n    from chronos import ChronosBoltPipeline\n\n    root = Path(__file__).resolve().parents[1]\n    local = Path(__file__).with_name('chronos_bolt_small')\n    if not local.exists():\n        local = root / '.hf_cache' / 'hub' / 'models--amazon--chronos-bolt-small' / 'snapshots' / MODEL_REVISION\n    torch.set_num_threads(2)\n    device = os.environ.get('CHRONOS_DEVICE', 'cuda' if torch.cuda.is_available() else 'cpu')\n    if device == 'cuda':\n        torch.cuda.set_per_process_memory_fraction(.35)\n        from torch._native.registry import deregister_op_overrides\n\n        deregister_op_overrides(disable_dsl_names='triton')\n    return ChronosBoltPipeline.from_pretrained(str(local), device_map=device, torch_dtype=torch.float32, local_files_only=True)\n\n\ndef forecast_features(sequences):\n    import torch\n\n    observed = sequences[:, 0].copy()\n    observed[sequences[:, 3] <= 0] = np.nan\n    predicted = pipeline().predict(torch.tensor(observed), prediction_length=24).numpy()\n    predicted = np.clip(predicted, -5, 5)\n    means = np.exp(predicted).mean(axis=1)\n    medians = np.exp(predicted[:, 4])\n    spread = predicted[:, 7] - predicted[:, 1]\n    return np.stack([np.column_stack([np.log(medians[:, :width].mean(axis=1)),\n                                      np.log(means[:, :width].mean(axis=1)),\n                                      spread[:, :width].mean(axis=1)]) for width in [1, 24]], axis=1)\n\n\ndef calibration_design(forecasts, baseline, hourly_reference_ratio):\n    relative = forecasts.copy()\n    relative[:, 0, :2] -= hourly_reference_ratio[:, None]\n    relative[:, :, :2] -= baseline[:, :, None]\n    return np.concatenate([np.ones((*relative.shape[:2], 1)), np.clip(relative, -5, 5)], axis=2)\ntemporal_daily_dense.parquet\ntemporal_daily_dense_template_step12_ranks.json\ntemporal_ensemble_screen.parquet\ntemporal_exact_daily_dense.parquet\ntemporal_exact_daily_dense_template_step12_ranks.json\ntemporal_exact_hourly_dense.parquet\ntemporal_exact_hourly_dense_template_step12_ranks.json\ntemporal_exact_hourly_dense_template_step1_ranks.json\ntemporal_exact_training.npz\ntemporal_screen.parquet\ntemporal_screen_sampled_ranks.json\ntemporal_training.npz\nticked_hourly_dense.parquet\nticked_hourly_dense_template_step1_ranks.json\ntraining_score_curves.npz\nuncertainty_screen.parquet\nvolatility_screen.parquet\nvolatility_training.npz\nweighted_score_screen.parquet\nweighted_score_screen_sampled_ranks.json\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"sed -n '1,110p' agent/rank_screen.py; sed -n '1,125p' agent/field_eval.py; sed -n '1,90p' agent/journal.md; cat agent/results/stack_interactions.parquet 2>/dev/null | head -c 0\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_13","type":"command_execution","command":"/bin/bash -c \"sed -n '1,110p' agent/rank_screen.py; sed -n '1,125p' agent/field_eval.py; sed -n '1,90p' agent/journal.md; cat agent/results/stack_interactions.parquet 2>/dev/null | head -c 0\"","aggregated_output":"\"\"\"Official reward replay from scored candidates, with optional round thinning.\"\"\"\n\nimport argparse\nimport json\n\nimport pandas as pd\n\nfrom predict import AGENT_DIR, replay_prompt_scores, parallel_combined, ensure_workspace_cwd\nfrom research import WINDOWS\nfrom field_eval import reward_summary\nfrom synth_lib.backtester.config import competition_for, slug_for\nfrom synth_lib.backtester.loading import get_miner_scores\nfrom synth_lib.backtester.result import BacktestResult\nfrom synth_lib.backtester.scoring import compute_combined_smoothed_scores\n\n\ndef main():\n    ensure_workspace_cwd()\n    parser = argparse.ArgumentParser()\n    parser.add_argument('experiment')\n    parser.add_argument('--template')\n    parser.add_argument('--round-step',type=int,default=1)\n    parser.add_argument('--workers',type=int,default=4)\n    parser.add_argument('--variants')\n    args = parser.parse_args()\n    frame = pd.read_parquet(AGENT_DIR/'results'/f'{args.experiment}.parquet')\n    if args.variants:\n        frame = frame.loc[frame.variant.isin(args.variants.split(','))]\n    summaries = {}\n    for window, window_frame in frame.groupby('window'):\n        begin,end = [pd.Timestamp(value,tz='UTC') for value in WINDOWS[window]]\n        fields = {}\n        for (asset,length),group in window_frame.groupby(['asset','length']):\n            increment = 60 if length == 3600 else 300\n            field = get_miner_scores(begin,end,asset,int(length),increment)\n            fields[(asset,length)] = field.loc[field.start_time.isin(group.time.unique())]\n        for variant,variant_frame in window_frame.groupby('variant'):\n            groups = {}\n            for (asset,length),rows in variant_frame.groupby(['asset','length']):\n                config = competition_for(asset,int(length))\n                candidate = rows[['time','crps']].rename(columns={'time':'start_time'}).copy()\n                candidate['scored_time'] = candidate.start_time + pd.Timedelta(seconds=int(length))\n                candidate['miner_uid'] = 999\n                candidate['asset'] = asset\n                candidate['time_length'] = int(length)\n                candidate['time_increment'] = config.time_increment\n                scored = replay_prompt_scores(fields[(asset,length)],candidate)\n                rounds = pd.DataFrame({'updated_at':[end-pd.Timedelta(seconds=1)]})\n                if args.template:\n                    source = AGENT_DIR/'results'/args.template/window/f'{asset}_{length}_smoothed.parquet'\n                    rounds = pd.read_parquet(source,columns=['updated_at']).drop_duplicates().sort_values('updated_at').iloc[::args.round_step]\n                result = BacktestResult(variant,scored,rounds,{})\n                groups.setdefault(slug_for(config),(config,[]))[1].append(result)\n            for slug,(config,results) in groups.items():\n                combined = parallel_combined(results,config,workers=args.workers)\n                summary = reward_summary(combined)\n                key = f'{window}/{variant}/{slug}'\n                summaries[key] = summary\n                print(key,summary,flush=True)\n    suffix = 'sampled_ranks' if not args.template else f'template_step{args.round_step}_ranks'\n    (AGENT_DIR/'results'/f'{args.experiment}_{suffix}.json').write_text(json.dumps(summaries,indent=2))\n\n\nif __name__=='__main__':\n    main()\n\"\"\"Full-path official backtests and cross-asset validator reward aggregation.\"\"\"\n\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport shutil\nfrom concurrent.futures import ProcessPoolExecutor\nfrom functools import partial\n\nimport pandas as pd\n\nfrom predict import AGENT_DIR, WORKSPACE, backtest, ensure_workspace_cwd, generate, parallel_combined\nfrom research import CRYPTO, EQUITY, WINDOWS, features, generate_variant\nfrom synth_lib.backtester.config import competition_for, slug_for\nfrom synth_lib.backtester.result import BacktestResult\nfrom synth_lib.backtester.scoring import compute_combined_smoothed_scores\n\n\ndef variant_simulate(asset, start_time, time_increment, time_length, num_simulations, context_prices, variant):\n    feature = features(context_prices, start_time, time_increment)\n    paths = generate_variant(feature, asset, pd.Timestamp(start_time), time_increment, time_length, num_simulations, variant)\n    return (start_time, time_increment, *paths.tolist())\n\n\ndef evaluate(task):\n    asset, length, window, variant, name, warmup_days = task\n    ensure_workspace_cwd()\n    begin, end = [pd.Timestamp(value, tz=\"UTC\").to_pydatetime() for value in WINDOWS[window]]\n    begin -= pd.Timedelta(days=warmup_days)\n    increment = 60 if length == 3600 else 300\n    label = f\"{asset}_{length}\"\n    output = AGENT_DIR / \"results\" / name / window\n    output.mkdir(parents=True, exist_ok=True)\n    if (output / f\"{label}_summary.json\").exists():\n        return str(output), label\n    predictions = WORKSPACE / \"miner_outputs\" / name / window / label / \"predictions\"\n    kwargs = {} if variant == \"model\" else {\"simulator\": partial(variant_simulate, variant=variant)}\n    total = generate(asset, begin, end, time_increment=increment, time_length=length,\n                     num_simulations=1000, predictions_dir=predictions, **kwargs)\n    print(f\"Generated {total} {label} {window}\", flush=True)\n    result = backtest(miner_name=name, asset=asset, time_length=length, time_increment=increment,\n                      n_backtest_days=(end-begin).days, predictions_dir=predictions, eval_end=end)\n    result.prompt_df.to_parquet(output / f\"{label}_prompts.parquet\")\n    result.smoothed_scores.to_parquet(output / f\"{label}_smoothed.parquet\")\n    (output / f\"{label}_summary.json\").write_text(json.dumps(result.summary, indent=2))\n    shutil.rmtree(predictions)\n    return str(output), label\n\n\ndef reward_summary(frame):\n    totals = frame.groupby(\"miner_uid\").reward_weight.sum()\n    latest = frame.loc[frame.updated_at.eq(frame.updated_at.max())].set_index(\"miner_uid\")\n    return {\"reward_rank\": int(totals.rank(ascending=False, method=\"min\").loc[999]),\n            \"final_rank\": int(latest.new_smoothed_score.rank(method=\"min\").loc[999]),\n            \"miners\": int(len(totals)), \"reward_ratio\": float(totals.loc[999] / totals.drop(999).max()),\n            \"reward_rounds\": int(frame.updated_at.nunique()),\n            \"first_round\": str(frame.updated_at.min()), \"last_round\": str(frame.updated_at.max())}\n\n\ndef aggregate(name, window, score_start=None):\n    output = AGENT_DIR / \"results\" / name / window\n    competition_groups = {}\n    for path in sorted(output.glob('*_summary.json')):\n        label = path.name.removesuffix('_summary.json')\n        asset, length = label.rsplit('_', 1)\n        config = competition_for(asset, int(length))\n        result = BacktestResult(name, pd.read_parquet(output / f'{label}_prompts.parquet'),\n                                pd.read_parquet(output / f'{label}_smoothed.parquet'), json.loads(path.read_text()))\n        competition_groups.setdefault(slug_for(config), (config, []))[1].append(result)\n    summaries = {}\n    for label, (config, results) in competition_groups.items():\n        combined_path = output / f'{label}_combined.parquet'\n        combined = pd.read_parquet(combined_path) if combined_path.exists() else parallel_combined(results, config)\n        combined.to_parquet(combined_path)\n        selected = combined if score_start is None else combined.loc[combined.updated_at >= pd.Timestamp(score_start,tz='UTC')]\n        summaries[label] = reward_summary(selected)\n        summaries[label]['assets'] = len(results)\n        print(label, summaries[label], flush=True)\n    summaries['score_estimate'] = 100 * sum(min(1, value['reward_ratio']) for value in summaries.values()) / 3\n    (output / 'competition_metrics.json').write_text(json.dumps(summaries, indent=2))\n    return summaries\n\n\ndef main():\n    parser = argparse.ArgumentParser()\n    parser.add_argument('--name', required=True)\n    parser.add_argument('--variant', default='model')\n    parser.add_argument('--windows', default='dev1,dev2')\n    parser.add_argument('--assets', default=','.join(CRYPTO + EQUITY))\n    parser.add_argument('--workers', type=int, default=6)\n    parser.add_argument('--aggregate-only', action='store_true')\n    parser.add_argument('--warmup-days', type=int, default=0)\n    parser.add_argument('--score-start')\n    args = parser.parse_args()\n    print((AGENT_DIR / 'BUDGET.md').read_text(), flush=True)\n    if not args.aggregate_only:\n        tasks = [(asset, length, window, args.variant, args.name, args.warmup_days)\n                 for window in args.windows.split(',') for asset in args.assets.split(',')\n                 for length in ([86400, 3600] if asset in CRYPTO else [86400])]\n        with ProcessPoolExecutor(max_workers=args.workers) as executor:\n            list(executor.map(evaluate, tasks))\n    for window in args.windows.split(','):\n        print(aggregate(args.name, window, args.score_start), flush=True)\n\n\nif __name__ == '__main__':\n    main()\n# Research journal — campaign-3\n\n### Iteration 37 pre-field selection\n\nShallow trees improve the chronological likelihood from 1.007904 to 1.006335 with static inputs, 1.004610 with temporal summaries/harmonics, and 1.004544 after adding pretrained summaries. The preregistered selector chooses the pretrained-feature model at 200 stages. Most of the improvement clearly comes from the non-pretrained temporal/clock summaries; the marginal pretrained gain is only 0.000066. The selected model now proceeds to half/full-strength official CRPS, without field-based tree hyperparameter selection.\n\n### Hourly projection serving audit correction\n\nThe first ad-hoc comparison accidentally supplied an inclusive seven-day-left-endpoint frame to the research feature helper, whereas production and all field evaluations use a strict left boundary. The extra old observation changes long-memory neural features and breaks exact path equality. Correct the audit frame, not the already-correct field results or serving filter. This is distinct from the earlier temporal-cache boundary mismatch.\n\n## Iteration 37 — regularized tree residuals (preregistered)\n\n- Hypothesis: shallow boosted trees may capture robust threshold interactions that the small neural forecasters miss, while a nonlinear calibration may recover information from the otherwise rejected pretrained features.\n- Change: fit Poisson-loss histogram boosting to future absolute-return scale divided by the frozen static/temporal forecast. Use seven-leaf trees, at least 150 rows per leaf, learning rate 0.03 and L2 penalty 10. Compare static-only, static plus temporal-window summaries/smooth clock harmonics, and the same features plus frozen Chronos summaries. The chronology and labels stay fixed. Select a common 0/50/100/200-stage checkpoint using only pre-field likelihood; zero stages means no correction. Bound corrections to +/-0.5 log units.\n- Result: pending pre-development selection, then half/full-strength official field screens only for a selected nonzero model.\n- Verdict: no field-based choice among individual tree hyperparameters or pretrained variants. Require consistent field gains before adoption.\n- Lesson: pending. Poisson regression is used to estimate a positive conditional mean scale, not because returns are Poisson counts.\n\n### Iteration 32 full reward confirmation and promotion\n\nAt every reward round and 1000 paths, GCD lattice projection raises hourly reward/best-field ratios from 0.869436/0.872234 to **0.950966/0.966341**. Cumulative ranks are 25/9 out of 257; final-round ranks are 55/1. Promote hourly projection only, while daily projection remains under confirmation. This is a roughly 0.05–0.09% asset-mean CRPS improvement with a much larger emissions effect, not evidence that CRPS and rewards are interchangeable.\n\n### Iteration 36 result\n\nFrozen Chronos-Bolt forecasts were generated for all 25,965 exact-context training/diagnostic rows. The existing stack's mean chronological likelihood is 1.007904. Neither intercept-only calibration (best tested 1.008133) nor pretrained-feature calibration (best tested 1.008303) improves it. Both selectors correctly retain zero coefficients. Reject before redundant field scoring. This bounded failure does not establish that all foundation models or fine-tuning would fail; it says this pretrained volatility representation adds no validated benefit with the tested small calibration.\n\n### Iterations 34–35 screen results\n\nThe modern-stack Student alternatives fail across regimes: df4 daily CRPS ratios are COM_EQU 1.002025/0.997312 and crypto 1.000855/0.998581; df3/df8 reverse gains even more strongly. Keep df5. Daily GCD projection gives small consistent gains (COM_EQU 0.999963/0.999905; crypto 0.999888/0.999812). Half periodic correction improves COM_EQU 0.999097/0.998738 but not crypto consistently (1.000638/0.999577); continue only commodities/equities, with a joint lattice check.\n\nTemporal seeds 41/109 improve their internal likelihood diagnostic to 1.006364/1.006247 (best epochs 27/31), versus original 1.006739. Nevertheless, the three-seed ensemble fails the official field screen: full replacement gives COM_EQU 0.999551/1.000542, hourly 1.000175/0.999423 and daily crypto 1.000089/1.000571. Reject the ensemble and do not cherry-pick either extra seed from field results. Better internal likelihood does not guarantee better field CRPS.\n\n### Chronos setup audit\n\nThe installed Torch attempts an eager Triton matrix kernel but the container has no C compiler. Disable only those optional Triton overrides for this research pipeline, retaining standard Torch CUDA kernels. Also explicitly convert the pretrained hourly forecast from the six-hour normalization used by temporal inputs to the one-hour reference used by hourly labels. No pretrained scores had been produced before these setup corrections.\n\n## Iteration 36 — pretrained volatility representation (preregistered)\n\n- Hypothesis: a generic pretrained temporal model may supply complementary volatility information not captured by the small supervised CNN.\n- Change: use Amazon Chronos-Bolt-small, pinned to its initial November 13, 2024 Hugging Face commit `0e96a1377adca89eebae3bbde4f859dc3b9f4b46`. Only model weights/configuration are downloaded, never prices. Feed the exact-context 168-hour log absolute-return sequence, preserving unobserved bins as NaN, and forecast 24 hourly values. Freeze pretrained weights. Fit bounded, regularized linear calibration over forecast median, quantile-mean and spread relative to the existing temporal/static baseline; compare against a same-data intercept-only control. Select only on the pre-development chronological diagnostic, with the established overlap caveat.\n- Result: pending. Dependency is pinned to chronos-forecasting 1.5.3, and serving would require local committed pretrained weights if selected.\n- Verdict: reject before field evaluation unless the extra representation improves likelihood over both the baseline and calibration-only control. Any retained candidate must then pass 1000-path official CRPS, reward and offline latency checks.\n- Lesson: pending. Generic pretrained uncertainty is not automatically a calibrated price distribution; it is used only as a candidate volatility feature.\n\n## Iteration 35 — exact-context temporal seed ensemble (preregistered)\n\n- Hypothesis: averaging independently initialized temporal residuals may reduce finite-training noise that survived the failed static-network ensemble.\n- Change: fit two extra seeds, 41 and 109, with exactly the current exact-context cache, 100-epoch limit, loss, regularization and chronological selector. Average log corrections with the original seed 73; test halfway and full replacement of the single temporal residual. No new labels, architecture, random path seed or clock parameters.\n- Result: pending pre-field diagnostics followed by official 1000-path development CRPS.\n- Verdict: require consistent gains and official reward confirmation. A worse ensemble is rejected rather than selectively choosing whichever extra seed looks best on field data.\n- Lesson: pending. Internal timestamp-split label overlap remains the documented likelihood-diagnostic limitation.\n\n## Iteration 34 — distribution and periodic interactions (preregistered)\n\n- Hypothesis: the stronger temporal/Sobol stack can change which finite-fan tail shape or discretization is calibrated, and a previously weak periodic residual may complement rather than duplicate the new temporal predictor.\n- Change: hold the stack fixed and separately test daily GCD quote projection; Sobol Student degrees 3, 4 and 8 at unchanged RMS; and the existing periodic residual at half/full strengths. Preserve draws, train cutoffs and all clock/lead settings. No new field dates or miner paths are examined.\n- Result: pending 1000-path official CRPS on both development windows; promising daily refresh also receives denser dev2 confirmation with its old-data control.\n- Verdict: demand consistent gains before reward replay. Do not combine successful individual modifications without checking their interaction.\n- Lesson: pending. This is a controlled interaction check, not permission for unbounded tail grids.\n\n### Resumption audit and completed calibration extension\n\nThe promoted daily stack passes production/research agreement at rtol=1e-12 for BTC, HYPE, SP500 and GOOGLX in both formats, including 17/1000 paths, NaNs and future-row invariance. Representative latency is 0.028–0.046 seconds hourly and 0.075–0.083 daily. The 600-epoch calibration extension again fails transfer: half-strength CRPS ratios dev1/dev2 are COM_EQU 0.998685/1.001499, hourly 0.999887/0.999928 and daily crypto 0.999719/1.002424. Full strength worsens every dev2 competition. Final rejection; no more epoch extensions.\n\n### Iterations 32–33 first results\n\nAt every hourly prompt and 1000 paths, lattice projection improves asset-mean relative CRPS to 0.999492/0.999145. Minimum-difference and GCD candidates have identical aggregate scores; the safer GCD candidate proceeds to full official reward confirmation. The refreshed static model improves dev2 daily CRPS slightly over the old-data control: full strength gives COM_EQU 0.998713 versus 0.999199 and crypto 0.999012 versus 0.999491, relative to the stack. Hourly regresses to 1.000468. Continue only daily refresh confirmation; these small one-window gains do not yet justify promotion.\n\n### Full daily refinement confirmation and promotion\n\nThe full-temporal/Sobol stack with a 30-minute, 0.75-strength crypto clock reaches daily-crypto reward ratios 0.218222/0.126951, ranks 62/163 out of 257. A 15-minute, full-strength COM_EQU clock reaches 0.014075/0.009365, ranks 129/216. Both improve the earlier lead-only daily model in both windows at 1000 paths and all reward rounds. The half-temporal crypto alternative gives 0.249621/0.099636: a marginally higher two-window mean, but a substantially weaker minimum-window result. Prefer the common full temporal strength for robustness and fewer competition-specific strength parameters; do not claim it maximizes the two-window arithmetic mean. Promote the full stack for both daily competitions. Together with the confirmed hourly model, development Score estimates are approximately 36.724 and 33.618.\n\n## Iteration 33 — chronological checkpoint refresh (preregistered)\n\n- Hypothesis: additional completed labels from late July/early August may improve calibration on newer venues more than context-only bias correction did.\n- Change: append snapshot-only training rows with every target ending before August 7, then repeat the already tested fixed 40-epoch, 60-day-recency fine-tune from the original static network. Compare against both the unchanged strong stack and the old-data 40-epoch fine-tune, at half/full strengths. Keep temporal weights and path construction fixed. Activate either fine-tune no earlier than August 7; consequently dev1 is unchanged by construction and only dev2 measures refresh effects. No final-window prices or labels enter this experiment.\n- Result: pending. This is a one-window causal refresh diagnostic, not two independent confirmations. A successful policy would require a separately frozen rolling-origin validation before final nomination.\n- Verdict: require improvement over the old-data control, not just over the unfine-tuned baseline; otherwise do not attribute any gain to fresher labels.\n- Lesson: pending.\n\n## Iteration 32 — price-lattice projection on the hourly finalist (preregistered)\n\n- Hypothesis: projecting continuous fans onto a price grid inferred from observed quotes may improve calibration at the scored price precision. The earlier quantization experiment used a weaker hourly model and did not receive final reward confirmation.\n- Change: preserve the exact-temporal/Sobol hourly forecast and compare two past-context grid estimators: minimum positive close difference, and a greatest-common-divisor lattice after controlled decimal conversion. Project only generated prices, never repair or round historical market data. Do not choose a new random seed or change volatility.\n- Result: pending dense 1000-path official CRPS and rewards in both development windows.\n- Verdict: require consistent gains and verify inferred-grid safety; otherwise retain continuous paths.\n- Lesson: pending. A minimum observed price change is not automatically the exchange tick size, so the estimators are explicit hypotheses.\n\n### Iteration 31 result\n\n","exit_code":0,"status":"completed"}}
