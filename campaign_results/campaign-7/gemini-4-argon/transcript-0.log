es[\"close\"].loc[start_time : start_time + pd.Timedelta(seconds=time_length) : step_minutes]\r\n    # Coerce: older object-dtype partitions read back as None, which np.isfinite rejects.\r\n    real_prices = pd.to_numeric(window, errors=\"coerce\").tolist()\r\n    expected_steps = (time_length // time_increment) + 1\r\n    if len(real_prices) != expected_steps:\r\n        raise ValueError(\r\n            f\"Price data length mismatch at {start_time}: got {len(real_prices)} prices, expected {expected_steps}\"\r\n        )\r\n    return real_prices\r\n\r\ndef context_slice(\r\n    frame: pd.DataFrame, start: pd.Timestamp, time_length: int, context_days: int, issuance_lead: int | None = None\r\n) -\u003e pd.DataFrame:\r\n    \"\"\"The context of the prompt at `start`: the bars from `context_days` before it to `context_end`.\"\"\"\r\n    return frame.loc[start - pd.Timedelta(days=context_days) : context_end(start, time_length, issuance_lead)]\r\n\r\n"}}}
