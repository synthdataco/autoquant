=14.3\nXAU     days= 308 minbucket5= 43 VR2=1.027 VR5=1.034 VR15=1.035 VR60=1.019 v5 max/min=636.6\nNVDAX   days= 348 minbucket5= 49 VR2=0.993 VR5=0.995 VR15=0.998 VR60=1.012 v5 max/min=406.6\nGOOGLX  days= 342 minbucket5= 48 VR2=0.984 VR5=0.978 VR15=0.988 VR60=0.987 v5 max/min=319.4\nTSLAX   days= 347 minbucket5= 49 VR2=1.003 VR5=1.025 VR15=1.052 VR60=1.091 v5 max/min=609.0\nAAPLX   days= 339 minbucket5= 48 VR2=0.981 VR5=0.945 VR15=0.904 VR60=0.892 v5 max/min=347.6\nWTIOIL  days= 293 minbucket5= 41 VR2=1.001 VR5=1.021 VR15=1.003 VR60=0.990 v5 max/min=232.2\nSPCX    days= 162 minbucket5= 23 VR2=1.021 VR5=1.012 VR15=1.012 VR60=0.988 v5 max/min=854.9\nSP500   days= 222 minbucket5= 31 VR2=1.021 VR5=1.053 VR15=1.067 VR60=1.044 v5 max/min=140.7","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false,"bashEditDiff":{"files":[{"filePath":"/workspace/agent/research/fit_profiles.py","hunks":[{"oldStart":1,"oldLines":0,"newStart":1,"newLines":82,"lines":["+\"\"\"Fit per-asset weekly volatility profiles keyed on New York local time (minute-of-week).","+","+For each asset, two shapes (mean 1 over the week):","+  v5[b]: variance of the 5-min return starting at minute-of-week b (the 24h prompts' step)","+  v1[b]: variance of the 1-min return starting at minute-of-week b (the 1h prompts' step)","+Each squared return is first divided by a centred 7-day rolling mean of squared returns, so the","+profile is a SHAPE and calm/volatile weeks weigh the same. Then circular kernel smoothing.","+Usage: fit_profiles.py --cutoff 2026-08-01 --out agent/research/profiles_2026-08-01.npz","+\"\"\"","+import argparse, sys","+import numpy as np, pandas as pd","+sys.path.insert(0, 'agent/research')","+from data import load_all, ALL_ASSETS","+","+W = 7 * 1440","+","+","+def minute_of_week_ny(idx):","+    ny = idx.tz_convert('America/New_York')","+    return (ny.day_of_week * 1440 + ny.hour * 60 + ny.minute).to_numpy()","+","+","+def smooth_circ(x, half):","+    if half <= 0:","+        return x","+    k = np.concatenate([np.arange(1, half + 2), np.arange(half, 0, -1)]).astype(float)","+    k /= k.sum()","+    xp = np.concatenate([x[-half:], x, x[:half]])","+    return np.convolve(xp, k, mode='valid')","+","+","+def shape(sq, mow, valid, clip_mult, smooth_half):","+    s = pd.Series(np.where(valid, sq, np.nan))","+    lvl = s.rolling(7 * 1440, center=True, min_periods=1440).mean().to_numpy()","+    z = s.to_numpy() / lvl","+    ok = np.isfinite(z)","+    z = np.minimum(z[ok], clip_mult)","+    b = mow[ok]","+    num = np.bincount(b, weights=z, minlength=W)","+    cnt = np.bincount(b, minlength=W)","+    prof = num / np.maximum(cnt, 1)","+    # fallback for empty buckets","+    prof[cnt == 0] = np.nanmean(prof[cnt > 0])","+    prof = smooth_circ(prof, smooth_half)","+    return prof / prof.mean(), cnt","+","+","+def main():","+    ap = argparse.ArgumentParser()","+    ap.add_argument('--cutoff', required=True, help='use data strictly before this day')","+    ap.add_argument('--out', required=True)","+    ap.add_argument('--skip-days', type=int, default=14, help='skip each market first N days (thin)')","+    ap.add_argument('--smooth5', type=int, default=4)","+    ap.add_argument('--smooth1', type=int, default=4)","+    ap.add_argument('--clip', type=float, default=30.0)","+    args = ap.parse_args()","+    out = {}","+    for a in ALL_ASSETS:","+        df = load_all(a, end=(pd.Timestamp(args.cutoff) - pd.Timedelta(minutes=1)).strftime('%Y-%m-%d %H:%M'))","+        df = df.iloc[args.skip_days * 1440:]","+        lp = np.log(df['close'].to_numpy())","+        mow = minute_of_week_ny(df.index)","+        r1 = np.full(len(lp), np.nan); r1[:-1] = lp[1:] - lp[:-1]","+        r5 = np.full(len(lp), np.nan); r5[:-5] = lp[5:] - lp[:-5]","+        v1, c1 = shape(r1 ** 2, mow, np.isfinite(r1), args.clip, args.smooth1)","+        v5, c5 = shape(r5 ** 2, mow, np.isfinite(r5), args.clip, args.smooth5)","+        out[f'{a}_v1'] = v1.astype(np.float32)","+        out[f'{a}_v5'] = v5.astype(np.float32)","+        # variance-ratio diagnostics: Var(k-min) / (k * Var(1-min)), robust-ish (clip extremes)","+        vr = {}","+        for k in (2, 5, 15, 60):","+            rk = lp[k:] - lp[:-k]","+            rk = rk[np.isfinite(rk)]","+            r1f = r1[np.isfinite(r1)]","+            vr[k] = np.mean(np.minimum(rk ** 2, np.quantile(rk ** 2, 0.9995))) / (k * np.mean(np.minimum(r1f ** 2, np.quantile(r1f ** 2, 0.9995))))","+        print(f\"{a:7s} days={len(df)//1440:4d} minbucket5={c5.min():3d} VR2={vr[2]:.3f} VR5={vr[5]:.3f} VR15={vr[15]:.3f} VR60={vr[60]:.3f}\"","+              f\" v5 max/min={v5.max()/v5.min():.1f}\", flush=True)","+    np.savez_compressed(args.out, **out)","+","+","+if __name__ == '__main__':","+    main()"]}],"created":true}],"moreFiles":1,"changedFiles":["/workspace/agent/research/fit_profiles.py","/workspace/agent/research/profiles_full.npz"]}},"tool_result_meta":[{"id":"toolu_01Q2FmkCwshDMkCkrA7HdYNR","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
