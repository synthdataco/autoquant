_length=3600, num_simulations=1000, context_prices=ctx)","+        sims = np.asarray(o[2:], dtype=np.float32).astype(float)","+        real = prices['close'].loc[t: t + pd.Timedelta(hours=1)].to_numpy(dtype=float)","+        if not np.all(np.isfinite(real)):","+            continue","+        rs = np.diff(sims, axis=1) / sims[:, :-1] * 1e4","+        rr = np.diff(real) / real[:-1] * 1e4","+        for b in (60, 15):","+            for j in range(0, 60, b):","+                vs = rs[:, j:j + b].std(axis=1, ddof=1); vr = rr[j:j + b].std(ddof=1)","+                lo, hi = np.mean(vs < vr), np.mean(vs <= vr)","+                out[b].append(lo + rng.random() * (hi - lo))","+for b in (60, 15):","+    h, _ = np.histogram(out[b], bins=10, range=(0, 1))","+    print(f\"vol block {b:2d} min n={len(out[b])} PIT% \" + ' '.join(f'{100 * x / len(out[b]):4.1f}' for x in h))"]}],"created":true}],"moreFiles":0,"changedFiles":["/workspace/agent/research/vol_pit.py"]}},"tool_result_meta":[{"id":"toolu_01QKCf4xbQVxawaXfgBMYdD8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
