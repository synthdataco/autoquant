{"type":"item.completed","item":{"id":"item_390","type":"command_execution","command":"/bin/bash -lc 'cat agent/modeling.py agent/calendar_complete_models.py agent/sampling_models.py agent/calendar_models.py agent/closure_models.py'","aggregated_output":"\"\"\"Current checkpoint: causal seasonal volatility with a learned scale.\n\nOnly artifacts trained before the context endpoint are selected. Current prices\ncome solely from the supplied context frame.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport numpy as np\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance\n\n# Days of minute history simulate() receives as context_prices: a plain int from 3 to 30.\nCONTEXT_DAYS = 7\n\n\ndef simulate(\n    asset: str,\n    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    seed = int(os.environ.get(\"SYNTH_BENCHMARK_SEED\", \"20261108\"))\n    rng = np.random.default_rng(seed)\n    last, stepvar = forecast_variance(asset, start_time, time_increment,\n                                     time_length, context_prices)\n    adjustment = scale_adjustment(asset, start_time, time_length,\n                                  context_prices, \"vol\", 1.0)\n    steps = time_length // time_increment + 1\n    shocks = rng.normal(size=(num_simulations, steps))\n    shocks[:, 0] = 0.0\n    shocks[:, 1:] *= np.sqrt(stepvar) * adjustment\n    paths = last * np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"All retained forward calendar effects over the unchanged Gaussian checkpoint.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport numpy as np\nfrom integrated_models import forecast_state\n\nCONTEXT_DAYS = 7\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    rng = np.random.default_rng(seed)\n    last, stepvar = forecast_state(asset, start_time, time_increment, time_length, context_prices,\n                                   robust_profile=False, events=True, curve=False, micro=False)\n    z = rng.normal(size=(num_simulations, len(stepvar)+1))\n    z[:, 0] = 0.\n    z[:, 1:] *= np.sqrt(stepvar)\n    paths = last*np.exp(np.cumsum(z, axis=1))\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"Seeded low-discrepancy and bridge sampling for the same predictive process.\"\"\"\nfrom __future__ import annotations\nfrom functools import lru_cache\nimport os\nimport numpy as np\nfrom scipy.special import ndtri\nfrom scipy.stats import qmc\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance\n\nCONTEXT_DAYS=7\nVARIANT=os.environ.get('SYNTH_RESEARCH_VARIANT','sobol_bridge')\n\n@lru_cache(maxsize=8)\ndef normal_coordinates(seed,n,dimensions,ranked):\n    engine=qmc.Sobol(d=dimensions,scramble=True,seed=seed)\n    u=engine.random_base2(int(np.ceil(np.log2(max(n,1)))))[:n]\n    if ranked and n>1:\n        order=np.argsort(u,axis=0)\n        ranks=np.empty_like(order)\n        np.put_along_axis(ranks,order,np.arange(n)[:,None],axis=0)\n        u=(ranks+.5)/n\n    z=ndtri(np.clip(u,1e-12,1-1e-12))\n    z.setflags(write=False)\n    return z\n\ndef brownian_bridge(z,stepvar):\n    n,steps=z.shape\n    t=np.r_[0.,np.cumsum(stepvar)]\n    values=np.zeros((n,steps+1))\n    values[:,-1]=np.sqrt(t[-1])*z[:,0]\n    queue=[(0,steps)]\n    k=1\n    while queue:\n        left,right=queue.pop(0)\n        if right-left<=1:\n            continue\n        mid=(left+right)//2\n        span=max(t[right]-t[left],1e-30)\n        a=(t[right]-t[mid])/span\n        b=(t[mid]-t[left])/span\n        variance=(t[mid]-t[left])*(t[right]-t[mid])/span\n        values[:,mid]=a*values[:,left]+b*values[:,right]+np.sqrt(max(variance,0.))*z[:,k]\n        k+=1\n        queue.extend([(left,mid),(mid,right)])\n    return values\n\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    last,stepvar=forecast_variance(asset,start_time,time_increment,time_length,context_prices)\n    adjustment=scale_adjustment(asset,start_time,time_length,context_prices,'vol',1.)\n    steps=time_length//time_increment\n    mixture='mix' in VARIANT\n    ranked='rank' in VARIANT\n    z=normal_coordinates(seed,num_simulations,steps+int(mixture),ranked)\n    if 'bridge' in VARIANT:\n        logpaths=brownian_bridge(z[:,:steps],stepvar)\n    else:\n        logpaths=np.column_stack([np.zeros(num_simulations),np.cumsum(z[:,:steps]*np.sqrt(stepvar),axis=1)])\n    if mixture:\n        eta=.4\n        logpaths*=np.exp(eta*z[:,-1]-.5*eta*eta)[:,None]\n    logpaths*=adjustment\n    paths=last*np.exp(logpaths)\n    return (start_time,time_increment,*paths.tolist())\n\"\"\"Scheduled-event effects over the causal learned volatility baseline.\"\"\"\nfrom __future__ import annotations\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance,get_profile,seasonal_values\nfrom vol_models import valid_returns,ewma\n\nCONTEXT_DAYS=7\nVARIANT=os.environ.get('SYNTH_RESEARCH_VARIANT','event_all')\n\n@lru_cache(maxsize=1)\ndef coefficients():\n    return json.loads((Path(__file__).resolve().parent/'artifacts/events.json').read_text())['fits']\n\n@lru_cache(maxsize=4)\ndef read_calendar(path,mtime):\n    return pd.read_parquet(path)\n\ndef calendar():\n    # Resolve the production calendar inside each simulate call. The cache key\n    # changes when the miner's daily calendar refresh replaces the file.\n    value=os.environ.get('SYNTH_BENCHMARK_CALENDAR')\n    if not value:\n        return None\n    path=Path(value)\n    try:\n        return read_calendar(str(path),path.stat().st_mtime_ns)\n    except (OSError,ValueError):\n        return None\n\ndef kind_of(names):\n    for kind in ['EARNINGS','EIA_PETROLEUM','CPI','NFP','FOMC','PPI','PCE','GDP','RETAIL_SALES']:\n        if kind in names:\n            return 'GDP_PCE' if kind in ('GDP','PCE') else kind\n    return None\n\ndef event_variance_factors(asset,index,horizon,asof,events,strength=1.,earnings=True,only_earnings=False):\n    idx=pd.DatetimeIndex(index)\n    factors=np.ones(len(idx))\n    if events is None or len(idx)==0:\n        return factors\n    fits=coefficients()\n    dates=[date for date in fits if date<=asof]\n    if not dates:\n        return factors\n    rows=[r for r in fits[max(dates)] if r['asset']==asset and r['time_length']==horizon and (earnings or r['event']!='EARNINGS') and (not only_earnings or r['event']=='EARNINGS')]\n    if not rows:\n        return factors\n    relevant=events[(events.time_utc>=idx[0]-pd.Timedelta(hours=8))&(events.time_utc<=idx[-1]+pd.Timedelta(minutes=30))]\n    relevant=relevant[(relevant.scope=='all')|relevant.scope.str.split(',').map(lambda x:asset in x)]\n    for t,group in relevant.groupby('time_utc'):\n        kind=kind_of(set(group.event))\n        for row in rows:\n            if row['event']!=kind:\n                continue\n            low=t+pd.Timedelta(minutes=row['lo'])\n            high=t+pd.Timedelta(minutes=row['hi'])\n            mask=(idx>=low)&(idx<high)\n            value=1.+strength*(row['amplitude']**2-1.)\n            factors[mask]=np.maximum(factors[mask],value)\n    return factors\n\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    rng=np.random.default_rng(seed)\n    events=calendar()\n    last,stepvar=forecast_variance(asset,start_time,time_increment,time_length,context_prices)\n    adjustment=scale_adjustment(asset,start_time,time_length,context_prices,'vol',1.)\n    asof=str(context_prices.index[-1].date())\n    strength=.5 if VARIANT=='event_half' else 1.\n    earnings=VARIANT!='event_macro'\n    future=pd.date_range(pd.Timestamp(start_time)+pd.Timedelta(minutes=1),periods=time_length//60,freq='1min')\n    table=get_profile(asset,asof,'America/New_York')\n    seasonal=seasonal_values(future,table,'America/New_York')\n    factors=event_variance_factors(asset,future,time_length,asof,events,strength,earnings)\n    k=time_increment//60\n    stepvar*=((seasonal*factors).reshape(-1,k).sum(axis=1)/seasonal.reshape(-1,k).sum(axis=1))\n    if VARIANT in ('event_clean','event_clean_half','event_clean_earnings'):\n        _,r,age=valid_returns(context_prices)\n        hseason=seasonal_values(context_prices.index[1:],table,'America/New_York')\n        normalized=r/np.sqrt(hseason)\n        hist=event_variance_factors(asset,context_prices.index[1:],time_length,asof,events,strength,earnings,VARIANT=='event_clean_earnings')\n        h1,h2=(60,720) if time_length<=3600 else (720,4320)\n        old=.75*ewma(normalized,age,h1)+.25*ewma(normalized,age,h2)\n        clean=.75*ewma(normalized/np.sqrt(hist),age,h1)+.25*ewma(normalized/np.sqrt(hist),age,h2)\n        ratio=np.clip(clean/max(old,1e-14),.15,1.)\n        stepvar*=np.sqrt(ratio) if VARIANT=='event_clean_half' else ratio\n    steps=time_length//time_increment+1\n    z=rng.normal(size=(num_simulations,steps))\n    z[:,0]=0\n    z[:,1:]*=np.sqrt(stepvar)*adjustment\n    paths=last*np.exp(np.cumsum(z,axis=1))\n    return (start_time,time_increment,*paths.tolist())\n\"\"\"Calendar-supplied holiday attenuation; trading itself never stops.\"\"\"\nfrom __future__ import annotations\n\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom calendar_models import calendar\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance, get_profile, seasonal_values\nfrom vol_models import valid_returns, ewma\n\nCONTEXT_DAYS = 7\nVARIANT = os.environ.get('SYNTH_RESEARCH_VARIANT', 'closure_full')\n\n\n@lru_cache(maxsize=1)\ndef fits():\n    return json.loads((Path(__file__).resolve().parent/'artifacts/closures.json').read_text())['fits']\n\n\ndef closure_factors(asset, index, asof, events, session_only=False):\n    idx = pd.DatetimeIndex(index)\n    factor = np.ones(len(idx))\n    if events is None or len(idx) == 0:\n        return factor\n    candidates = [d for d in fits() if d <= asof]\n    if not candidates:\n        return factor\n    rows = [r for r in fits()[max(candidates)] if r['asset'] == asset]\n    if not rows:\n        return factor\n    local = idx.tz_convert('America/New_York')\n    dates = np.asarray(local.date)\n    minutes = np.asarray(local.hour*60+local.minute)\n    selected = events[(events.time_utc >= idx[0]-pd.Timedelta(days=1)) &\n                      (events.time_utc <= idx[-1]+pd.Timedelta(days=1)) &\n                      events.event.str.startswith('NYSE')]\n    selected = selected[(selected.scope == 'all') | selected.scope.str.split(',').map(lambda names: asset in names)]\n    for event in selected.itertuples():\n        date = event.time_utc.tz_convert('America/New_York').date()\n        for row in rows:\n            if row['event'] != event.event:\n                continue\n            if session_only and (row['lo'] < 570 or row['hi'] > 960):\n                continue\n            mask = (dates == date) & (minutes >= row['lo']) & (minutes < row['hi'])\n            factor[mask] = np.minimum(factor[mask], row['amplitude']**2)\n    return factor\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    rng = np.random.default_rng(seed)\n    events = calendar()\n    last, stepvar = forecast_variance(asset, start_time, time_increment, time_length, context_prices)\n    adjustment = scale_adjustment(asset, start_time, time_length, context_prices, 'vol', 1.)\n    asof = str(context_prices.index[-1].date())\n    table = get_profile(asset, asof, 'America/New_York')\n    future = pd.date_range(pd.Timestamp(start_time)+pd.Timedelta(minutes=1), periods=time_length//60, freq='1min')\n    seasonal = seasonal_values(future, table, 'America/New_York')\n    factors = closure_factors(asset, future, asof, events, VARIANT == 'closure_session')\n    k = time_increment//60\n    stepvar *= (seasonal*factors).reshape(-1, k).sum(axis=1)/seasonal.reshape(-1, k).sum(axis=1)\n    if VARIANT == 'closure_clean':\n        _, r, age = valid_returns(context_prices)\n        hist = seasonal_values(context_prices.index[1:], table, 'America/New_York')\n        normal = r/np.sqrt(hist)\n        factors = closure_factors(asset, context_prices.index[1:], asof, events)\n        h1, h2 = (60, 720) if time_length <= 3600 else (720, 4320)\n        old = .75*ewma(normal, age, h1)+.25*ewma(normal, age, h2)\n        clean = .75*ewma(normal/np.sqrt(factors), age, h1)+.25*ewma(normal/np.sqrt(factors), age, h2)\n        stepvar *= np.clip(clean/max(old, 1e-14), 1., 3.)\n    shocks = rng.normal(size=(num_simulations, len(stepvar)+1))\n    shocks[:, 0] = 0.\n    shocks[:, 1:] *= np.sqrt(stepvar)*adjustment\n    paths = last*np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *paths.tolist())\n","exit_code":0,"status":"completed"}}
