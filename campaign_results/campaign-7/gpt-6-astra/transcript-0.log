{"type":"item.completed","item":{"id":"item_516","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport inspect\nfrom synth_lib.preparation.config import default_store_root\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices\nprint(inspect.getsource(default_store_root))\nprint(inspect.getsource(load_minute_prices))\nPY\"","aggregated_output":"def default_store_root(asset: str) -> Path:\n    \"\"\"Default MinutePriceStore root for `asset`: `market_data/prices/{asset}/1m`.\n\n    Falls back to the legacy `market_data/pyth/` tree when that is what exists on disk, so an\n    existing store keeps working without being moved. The choice is made at the market_data level,\n    not per asset, so a store never ends up split across both names.\n    \"\"\"\n    base = MARKET_DATA_DIR\n    if not (base / STORE_SUBDIR).exists() and (base / LEGACY_STORE_SUBDIR).exists():\n        return base / LEGACY_STORE_SUBDIR / asset / \"1m\"\n    return base / STORE_SUBDIR / asset / \"1m\"\n\ndef load_minute_prices(data_root: Path, asset: str, start: pd.Timestamp, end: pd.Timestamp) -> pd.DataFrame:\n    \"\"\"Minute OHLCV over [start, end] from daily partitions.\n\n    The days before the asset's first partition, before the market's first trade or the store's first\n    day, are NaN on every minute, as in a live context. A missing partition after it raises: a silent\n    hole here would shrink every context that spans it without anyone noticing.\"\"\"\n    root = store_root(data_root, asset)\n    stored = (date.fromisoformat(p.stem.removeprefix(\"date=\")) for p in root.glob(\"date=*.parquet\"))\n    first_day = min(stored, default=start.date())\n    frames = []\n    day = max(start.date(), first_day)\n    while day <= end.date():\n        path = root / f\"date={day.isoformat()}.parquet\"\n        if not path.exists():\n            raise FileNotFoundError(f\"missing partition {path}\")\n        try:\n            frames.append(pd.read_parquet(path, columns=[\"timestamp\", *OHLCV_COLUMNS]))\n        except ValueError as exc:  # pyarrow's ArrowInvalid, on a column the file lacks\n            raise ValueError(\n                f\"{path} predates the OHLCV columns. Re-ingest with --force-refresh: ingest_day \"\n                f\"skips settled partitions that already exist.\"\n            ) from exc\n        day += timedelta(days=1)\n    if not frames:\n        raise FileNotFoundError(\n            f\"no partition for {asset} from {start.date()} to {end.date()}: its first is {first_day}\"\n        )\n    frame = pd.concat(frames, ignore_index=True)\n    frame[\"timestamp\"] = pd.to_datetime(frame[\"timestamp\"], utc=True)\n    frame = frame.set_index(\"timestamp\").sort_index()\n    if start.date() < first_day:\n        head = pd.date_range(\n            pd.Timestamp(start.date(), tz=\"UTC\"), frame.index[0], freq=\"1min\", inclusive=\"left\", name=\"timestamp\"\n        )\n        frame = pd.concat([pd.DataFrame(np.nan, index=head, columns=OHLCV_COLUMNS), frame])\n    return frame.loc[start:end]\n\n","exit_code":0,"status":"completed"}}
