{"type":"item.completed","item":{"id":"item_779","type":"command_execution","command":"/bin/bash -lc 'cat agent/vol_models.py agent/separated_models.py agent/profile_models.py'","aggregated_output":"\"\"\"Causal volatility-estimation ablations, Gaussian paths held fixed.\"\"\"\nfrom __future__ import annotations\nimport os\nimport numpy as np\nimport pandas as pd\n\nCONTEXT_DAYS = 7\nVARIANT = os.environ.get(\"SYNTH_RESEARCH_VARIANT\", \"ewma_mix\")\n\n\ndef valid_returns(context):\n    p = np.asarray(context[\"close\"], dtype=float)\n    good = np.isfinite(p) & (p > 0)\n    last = float(p[np.flatnonzero(good)[-1]]) if good.any() else 1.0\n    logp = np.full(p.shape, np.nan)\n    np.log(p, out=logp, where=good)\n    r = np.diff(logp)\n    idx = pd.DatetimeIndex(context.index)\n    gaps = np.asarray((idx[1:] - idx[:-1]).total_seconds()) != 60\n    r[gaps] = np.nan\n    age = np.asarray((idx[-1] - idx[1:]).total_seconds()) / 60\n    return last, r, age\n\n\ndef ewma(r, age, half_life, absolute=False):\n    good = np.isfinite(r)\n    if not good.any():\n        return 1e-7\n    x = np.abs(r[good]) if absolute else r[good]**2\n    w = np.exp2(-age[good] / half_life)\n    if w.sum() < 1e-20:\n        w = np.ones_like(w)\n    value = float(np.sum(w*x)/np.sum(w))\n    return value*value*np.pi/2 if absolute else value\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get(\"SYNTH_BENCHMARK_SEED\", \"20261108\"))\n    rng = np.random.default_rng(seed)\n    last, r, age = valid_returns(context_prices)\n    short = time_length <= 3600\n    variants = {\"ewma6\": (360, 30), \"ewma24\": (1440, 120), \"ewma72\": (4320, 360)}\n    if VARIANT in variants:\n        hl = variants[VARIANT][int(short)]\n        var = ewma(r, age, hl)\n    else:\n        h1, h2 = (60, 720) if short else (720, 4320)\n        v1, v2 = ewma(r, age, h1), ewma(r, age, h2)\n        var = 0.75*v1 + 0.25*v2\n        if VARIANT in (\"abs_ewma\", \"blend_abs\"):\n            absolute = .75*ewma(r, age, h1, True) + .25*ewma(r, age, h2, True)\n            var = absolute if VARIANT == \"abs_ewma\" else .5*(var + absolute)\n    sigma = np.sqrt(max(var, 1e-14) * time_increment / 60)\n    steps = time_length // time_increment + 1\n    shocks = rng.normal(0.0, sigma, size=(num_simulations, steps))\n    shocks[:, 0] = 0.0\n    paths = last*np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"Separate a robust future seasonal shape from RMS historical normalization.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport numpy as np\nimport pandas as pd\n\nfrom ml_models import scale_adjustment\nfrom profile_models import table_for\nfrom seasonal_models import forecast_variance, get_profile, seasonal_values\n\nCONTEXT_DAYS = 7\nVARIANT = os.environ.get('SYNTH_RESEARCH_VARIANT', 'separate_future')\n\n\ndef separated_forecast(asset, start, step, horizon, context, variant='separate_future', future_profile='prof_abs5m'):\n    last, original = forecast_variance(asset, start, step, horizon, context)\n    adjustment = scale_adjustment(asset, start, horizon, context, 'vol', 1.)\n    asof = str(context.index[-1].date())\n    old = get_profile(asset, asof, 'America/New_York')\n    new = table_for(asset, asof, future_profile)\n    future = pd.date_range(pd.Timestamp(start)+pd.Timedelta(minutes=1), periods=horizon//60, freq='1min')\n    k = step//60\n    old_season = seasonal_values(future, old, 'America/New_York').reshape(-1, k).sum(axis=1)\n    new_season = seasonal_values(future, new, 'America/New_York').reshape(-1, k).sum(axis=1)\n    ratio = np.sqrt(new_season/old_season)\n    if variant == 'separate_half':\n        ratio = np.sqrt(ratio)\n    if variant == 'separate_units':\n        ratio /= ratio.mean()\n    else:\n        # Preserve the forecast's average absolute step scale, reallocating\n        # dispersion across clock times rather than inflating the state.\n        ratio *= np.sqrt(original).mean()/(np.sqrt(original)*ratio).mean()\n    return last, original*(adjustment*ratio)**2\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    rng = np.random.default_rng(seed)\n    last, stepvar = separated_forecast(asset, start_time, time_increment, time_length, context_prices, VARIANT)\n    z = rng.normal(size=(num_simulations, len(stepvar)+1))\n    z[:, 0] = 0.\n    z[:, 1:] *= np.sqrt(stepvar)\n    paths = last*np.exp(np.cumsum(z, axis=1))\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"Profile resolution, robustness and weekday pooling over a fixed ML correction.\"\"\"\nfrom __future__ import annotations\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom seasonal_models import seasonal_values\nfrom ml_models import scale_adjustment\nfrom vol_models import valid_returns,ewma\n\nCONTEXT_DAYS=7\nVARIANT=os.environ.get('SYNTH_RESEARCH_VARIANT','prof_abs')\n\n@lru_cache(maxsize=8)\ndef load_artifact(filename):\n    return json.loads((Path(__file__).resolve().parent/'artifacts'/filename).read_text())\n\n@lru_cache(maxsize=1024)\ndef table_for(asset,asof,variant):\n    filename={'prof_abs':'seasonality_abs.json','prof_5m':'seasonality_5m.json','prof_abs5m':'seasonality_abs5m.json',\n              'prof_abs5m60':'seasonality_abs5m60.json','prof_abs5m240':'seasonality_abs5m240.json'}.get(variant,'seasonality.json')\n    data=load_artifact(filename)\n    fits=data['assets'].get(asset,{})\n    dates=[d for d in fits if d<=asof]\n    if not dates:\n        return np.ones((7,data['bins']))\n    fit=fits[max(dates)]['clocks']['America/New_York']\n    raw=np.asarray(fit['raw'],dtype=float)\n    counts=np.asarray(fit['counts'],dtype=float)\n    individual={'prof_raw70':.7,'prof_raw100':1.}.get(variant,.35)\n    base=raw.copy()\n    groups=[slice(0,4)] if variant=='prof_week' else [slice(0,5),slice(5,7)]\n    for days in groups:\n        num=(raw[days]*counts[days]).sum(axis=0)\n        den=counts[days].sum(axis=0)\n        common=np.divide(num,den,out=np.ones_like(num),where=den>0)\n        base[days]=individual*raw[days]+(1-individual)*common\n    flat=base.ravel()\n    flat=.8*flat+.1*np.roll(flat,1)+.1*np.roll(flat,-1)\n    flat=np.clip(flat,.015,20)\n    return (flat/flat.mean()).reshape(raw.shape)\n\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    rng=np.random.default_rng(seed)\n    last,r,age=valid_returns(context_prices)\n    tab=table_for(asset,str(context_prices.index[-1].date()),VARIANT)\n    r=r/np.sqrt(seasonal_values(context_prices.index[1:],tab,'America/New_York'))\n    h1,h2=(60,720) if time_length<=3600 else (720,4320)\n    var=.75*ewma(r,age,h1)+.25*ewma(r,age,h2)\n    future=pd.date_range(pd.Timestamp(start_time)+pd.Timedelta(minutes=1),periods=time_length//60,freq='1min')\n    seasonal=seasonal_values(future,tab,'America/New_York')\n    stepvar=max(var,1e-14)*seasonal.reshape(-1,time_increment//60).sum(axis=1)\n    adjustment=scale_adjustment(asset,start_time,time_length,context_prices,'vol',1.)\n    z=rng.normal(size=(num_simulations,time_length//time_increment+1))\n    z[:,0]=0\n    z[:,1:]*=np.sqrt(stepvar)*adjustment\n    paths=last*np.exp(np.cumsum(z,axis=1))\n    return (start_time,time_increment,*paths.tolist())\n","exit_code":0,"status":"completed"}}
