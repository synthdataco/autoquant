{"type":"item.started","item":{"id":"item_45","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nfrom pathlib import Path\nimport pandas as pd\nrows=[]\nfor p in Path('agent/results/baseline_dev').glob('*.parquet'):\n d=pd.read_parquet(p); d['window']=p.stem.split('_')[-1]; rows.append(d)\nif rows:\n f=pd.concat(rows)\n print('Worst mean asset-day scores:')\n f['day']=pd.to_datetime(f.start_time).dt.strftime('%Y-%m-%d')\n print(f.groupby(['asset','time_length','day']).crps.agg(['mean','max','count']).sort_values('mean',ascending=False).head(16).to_string())\n print('Worst individual prompts:')\n print(f.sort_values('crps',ascending=False).head(10)[['asset','start_time','time_length','crps']].to_string(index=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
