RETAIL_SALES,5,15,9,0.8953530214115512,0.8108965532551403,0.954691922559268\nequity,86400,RETAIL_SALES,15,60,9,1.0712876948013161,0.9252753508473212,1.138469369541979\nequity,86400,RETAIL_SALES,60,180,9,1.2001601078647983,1.167159979951023,1.232992537038619\n","exit_code":0,"status":"completed"}}
