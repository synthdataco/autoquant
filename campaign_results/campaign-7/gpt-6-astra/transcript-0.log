{"type":"item.completed","item":{"id":"item_543","type":"command_execution","command":"/bin/bash -lc 'cat agent/fit_events.py agent/train_ml.py'","aggregated_output":"\"\"\"Causal event-kernel estimates and leave-one-event-out stability diagnostics.\"\"\"\nfrom __future__ import annotations\nfrom concurrent.futures import ProcessPoolExecutor\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom explore import load_asset\nfrom ml_features import one_features\nfrom ml_models import scale_adjustment\nfrom seasonal_models import get_profile,seasonal_values\nfrom synth_lib.benchmark.generate_predictions import context_slice\nfrom run_suite import ROOT,CRYPTO,OTHER\n\n# Kernels use only dates supplied by the calendar. Earnings have coarse session\n# anchors, so their windows are wider than a precisely timed macro release.\nMACRO_BINS=[(-5,0),(0,1),(1,5),(5,15),(15,60),(60,180)]\nEARNINGS_BINS=[(-30,0),(0,30),(30,120),(120,240),(240,480)]\n\n\ndef event_type(names):\n    names=set(names)\n    for kind in ['EARNINGS','EIA_PETROLEUM','CPI','NFP','FOMC','PPI','PCE','GDP','RETAIL_SALES']:\n        if kind in names:\n            return 'GDP_PCE' if kind in ('GDP','PCE') else kind\n    return None\n\n\ndef observe(asset):\n    os.chdir(ROOT)\n    frame=load_asset(asset)\n    r=np.log(frame.close).diff()\n    cal=pd.read_parquet(os.environ['SYNTH_BENCHMARK_CALENDAR'])\n    cal=cal[(cal.scope=='all')|cal.scope.str.split(',').map(lambda x:asset in x)]\n    cal=cal[(cal.time_utc<'2026-11-09')&(~cal.event.str.startswith('NYSE'))]\n    records=[]\n    for event_at,events in cal.groupby('time_utc'):\n        kind=event_type(events.event)\n        if kind is None or event_at<frame.index.min()+pd.Timedelta(days=14):\n            continue\n        bins=EARNINGS_BINS if kind=='EARNINGS' else MACRO_BINS\n        issue_start=event_at-pd.Timedelta(minutes=35)\n        for horizon in ([86400,3600] if asset in CRYPTO else [86400]):\n            context=context_slice(frame,issue_start,horizon,7)\n            _,base=one_features(asset,issue_start,horizon,context)\n            adjustment=scale_adjustment(asset,issue_start,horizon,context,'vol',1.)\n            table=get_profile(asset,str(context.index[-1].date()),'America/New_York')\n            for lo,hi in bins:\n                if event_at+pd.Timedelta(minutes=hi)>frame.index.max():\n                    continue\n                observed=r.loc[event_at+pd.Timedelta(minutes=lo):event_at+pd.Timedelta(minutes=hi-1)]\n                if observed.notna().sum()<max(1,.8*(hi-lo)):\n                    continue\n                season=seasonal_values(observed.index,table,'America/New_York')\n                standardized=np.asarray(observed)/(max(base*adjustment,1e-8)*np.sqrt(season))\n                amplitude=float(np.nanmean(np.abs(standardized))*np.sqrt(np.pi/2))\n                records.append({'asset':asset,'group':'crypto' if asset in CRYPTO else ('equity' if asset not in ['XAU','WTIOIL'] else asset),\n                                'time_length':horizon,'event':kind,'time':event_at,'end':event_at+pd.Timedelta(minutes=hi),\n                                'lo':lo,'hi':hi,'amplitude':amplitude,'observations':int(observed.notna().sum())})\n    return pd.DataFrame(records)\n\n\ndef robust_center(values):\n    # A winsorized mean of absolute returns is more stable than mean variance.\n    a=np.asarray(values,dtype=float)\n    if len(a)>=5:\n        a=np.minimum(a,np.quantile(a,.9)*1.5)\n    return float(np.mean(a)) if len(a) else 1.\n\n\ndef main():\n    os.chdir(ROOT)\n    out=ROOT/'agent/results/events'\n    out.mkdir(parents=True,exist_ok=True)\n    observation_file=out/'causal_event_observations.parquet'\n    if observation_file.exists():\n        data=pd.read_parquet(observation_file)\n    else:\n        with ProcessPoolExecutor(max_workers=2) as pool:\n            data=pd.concat(list(pool.map(observe,CRYPTO+OTHER)),ignore_index=True)\n        data.to_parquet(observation_file,index=False)\n    dates=['2026-03-01','2026-07-01','2026-08-01','2026-10-01','2026-11-01','2026-11-09']\n    fits={}\n    stability=[]\n    for date in dates:\n        train=data[(data.end<pd.Timestamp(date,tz='UTC'))&(data.time>=pd.Timestamp(date,tz='UTC')-pd.Timedelta(days=365))]\n        rows=[]\n        for (group,horizon,event,lo,hi),bucket in train.groupby(['group','time_length','event','lo','hi']):\n            # Assets share each macro surprise. Count dates, not asset rows.\n            per_event=bucket.groupby('time').amplitude.mean()\n            n=len(per_event)\n            if n<3:\n                continue\n            center=robust_center(per_event.to_numpy())\n            shrink=n/(n+4.)\n            group_amplitude=max(1.,1+shrink*(center-1))\n            for asset,sub in bucket.groupby('asset'):\n                na=len(sub)\n                individual=robust_center(sub.amplitude.to_numpy())\n                asset_weight=na/(na+12.)\n                amplitude=max(1.,asset_weight*individual+(1-asset_weight)*group_amplitude)\n                amplitude=min(amplitude,15. if lo<5 else 5.)\n                rows.append({'asset':asset,'time_length':int(horizon),'event':event,'lo':int(lo),'hi':int(hi),\n                             'amplitude':amplitude,'n_dates':n,'n_asset_dates':na})\n            if date=='2026-11-09':\n                jackknife=[robust_center(per_event.drop(t).to_numpy()) for t in per_event.index]\n                stability.append({'group':group,'time_length':horizon,'event':event,'lo':lo,'hi':hi,'n_dates':n,\n                                  'mean_absolute_scale_ratio':center,'loo_min':min(jackknife),'loo_max':max(jackknife)})\n        fits[date]=rows\n    artifact={'reference':'causal ml_vol Gaussian background','fits':fits}\n    dest=ROOT/'agent/artifacts/events.json'\n    dest.write_text(json.dumps(artifact,indent=2)+'\\n')\n    pd.DataFrame(stability).to_csv(out/'leave_one_event_out.csv',index=False)\n    print('Saved',len(data),'event observations;',sum(map(len,fits.values())),'causal event coefficients')\n    print(pd.DataFrame(stability).query('lo==0').round(3).to_string(index=False))\n\nif __name__=='__main__':\n    main()\n\"\"\"Chronological, purged volatility regressions. One bounded GPU job at a time.\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport xgboost as xgb\n\nfrom ml_features import NAMES, CORE_NAMES, TIME_NAMES, ASSETS\nfrom run_suite import ROOT\n\n\ndef main():\n    ap=argparse.ArgumentParser()\n    ap.add_argument('--device',default='cuda')\n    ap.add_argument('--dates',nargs='+',default=['2026-03-01','2026-07-01','2026-08-01','2026-10-01','2026-11-01','2026-11-09'])\n    ap.add_argument('--rounds',type=int,default=600)\n    ap.add_argument('--prefix',default='ml')\n    ap.add_argument('--output',default='ml')\n    ap.add_argument('--kinds',nargs='+',default=['vol','full'])\n    ap.add_argument('--lookback',type=int,default=240)\n    ap.add_argument('--min-child-weight',type=float,default=80)\n    ap.add_argument('--depth',type=int,default=3)\n    ap.add_argument('--validation-days',type=int,default=14)\n    ap.add_argument('--scale-weight',action='store_true')\n    args=ap.parse_args()\n    os.chdir(ROOT)\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    frames=[pd.read_parquet(p) for p in sorted((ROOT/'agent/cache').glob(args.prefix+'_*.parquet'))]\n    if len(frames)!=18:\n        raise RuntimeError(f'Expected 18 feature tables, found {len(frames)}; finish make_ml_data first')\n    data=pd.concat(frames,ignore_index=True).sort_values('start_time').reset_index(drop=True)\n    out=ROOT/'agent/artifacts'/args.output\n    out.mkdir(parents=True,exist_ok=True)\n    manifest={'features':NAMES,'fits':[],'target':'log forward absolute-return scale / causal seasonal EWMA scale', 'xgboost_version':xgb.__version__,'cache_prefix':args.prefix}\n    manifest['training_options']={'lookback_days':args.lookback,'min_child_weight':args.min_child_weight,'depth':args.depth,'validation_days':args.validation_days,'scale_weight':args.scale_weight}\n    features={'vol':CORE_NAMES+TIME_NAMES+['asset_'+a for a in ASSETS], 'full':NAMES}\n    for date in args.dates:\n        if 'LANDING ORDER' in (ROOT/'agent/BUDGET.md').read_text():\n            print('Landing order: stop fitting.',flush=True)\n            break\n        cutoff=pd.Timestamp(date,tz='UTC')\n        for horizon in [3600,86400]:\n            full=data[(data.time_length==horizon)&(data.label_end<cutoff)&(data.start_time>=cutoff-pd.Timedelta(days=args.lookback))].copy()\n            split=cutoff-pd.Timedelta(days=args.validation_days)\n            train=full[full.label_end<split]\n            valid=full[full.start_time>=split]\n            if len(train)<1000 or len(valid)<100:\n                continue\n            for kind,names in features.items():\n                if kind not in args.kinds:\n                    continue\n                def matrix(frame):\n                    x=frame[names].to_numpy(dtype=np.float32,copy=True)\n                    x[~np.isfinite(x)]=np.nan\n                    y=np.log(np.clip(frame.target_ratio.to_numpy(),.03,30))\n                    weights=None\n                    if args.scale_weight:\n                        reference=max(float(train.base_sigma.median()),1e-8)\n                        weights=np.clip(frame.base_sigma.to_numpy()/reference,.25,4.)\n                        weights/=weights.mean()\n                    return xgb.DMatrix(x,label=y,weight=weights,feature_names=names,nthread=2)\n                dtrain,dvalid=matrix(train),matrix(valid)\n                params={'objective':'reg:squarederror','tree_method':'hist','device':args.device,\n                        'max_depth':args.depth,'eta':.035,'min_child_weight':args.min_child_weight,'lambda':15.,'subsample':.85,\n                        'colsample_bytree':1.,'max_bin':128,'seed':seed,'nthread':2,'eval_metric':'rmse'}\n                probe=xgb.train(params,dtrain,num_boost_round=args.rounds,evals=[(dvalid,'past_validation')],early_stopping_rounds=60,verbose_eval=False)\n                rounds=int(probe.best_iteration)+1\n                model=xgb.train(params,matrix(full),num_boost_round=rounds,verbose_eval=False)\n                # CPU inference keeps GPU use confined to this fitting process.\n                model.set_param({'device':'cpu','nthread':1})\n                name=f'{kind}_{horizon}_{date}.ubj'\n                model.save_model(out/name)\n                item={'cutoff':date,'time_length':horizon,'kind':kind,'features':names,'file':name,\n                      'training_rows':len(full),'purged_training_rows':len(train),'validation_rows':len(valid),\n                      'rounds':rounds,'past_validation_log_rmse':float(probe.best_score),\n                      'importance':model.get_score(importance_type='gain')}\n                manifest['fits'].append(item)\n                (out/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\\n')\n                print(date,horizon,kind,'rows',len(full),'rounds',rounds,'past log RMSE',probe.best_score,flush=True)\n    print('Saved',len(manifest['fits']),'causal volatility models',flush=True)\n\nif __name__=='__main__':\n    main()\n","exit_code":0,"status":"completed"}}
