{"type":"item.completed","item":{"id":"item_200","type":"command_execution","command":"/bin/bash -lc 'cat agent/ml_features.py agent/make_ml_data.py agent/train_ml.py'","aggregated_output":"\"\"\"Identical causal feature definitions for volatility training and serving.\"\"\"\nfrom __future__ import annotations\nimport numpy as np\nimport pandas as pd\n\nfrom seasonal_models import get_profile, seasonal_values\nfrom vol_models import valid_returns, ewma\n\nASSETS=['BTC','ETH','SOL','XRP','HYPE','XAU','NVDAX','GOOGLX','TSLAX','AAPLX','WTIOIL','SPCX','SP500']\nHALVES=[15,60,240,720,1440,4320]\nCORE_NAMES=[f'{kind}_{h}' for kind in ('rms','abs') for h in HALVES]+['log_base']\nEXTRA_NAMES=[f'range_{h}' for h in (60,720,4320)]+['volume_60_1440','volume_240_4320','trades_60_1440','trades_240_4320','zero_60','zero_720']+[f'signed_{w}' for w in (30,120,360,1440)]\nTIME_NAMES=['hour_sin','hour_cos','week_sin','week_cos']\nNAMES=CORE_NAMES+EXTRA_NAMES+TIME_NAMES+['asset_'+a for a in ASSETS]\n\n\ndef finite_ewm(x, half, length):\n    \"\"\"Vectorized exactly truncated, NaN-aware exponential average.\"\"\"\n    x=np.asarray(x,dtype=float)\n    good=np.isfinite(x)\n    alpha=-np.expm1(-np.log(2)/half)\n    n=pd.Series(np.r_[0.,np.where(good,x,0.)]).ewm(alpha=alpha,adjust=False).mean().to_numpy(copy=True)[1:]\n    d=pd.Series(np.r_[0.,good.astype(float)]).ewm(alpha=alpha,adjust=False).mean().to_numpy(copy=True)[1:]\n    if len(x)>length:\n        tail=np.exp2(-length/half)\n        n[length:] -= tail*n[:-length].copy()\n        d[length:] -= tail*d[:-length].copy()\n    return np.divide(n,d,out=np.full_like(n,np.nan),where=d>1e-12)\n\n\ndef time_features(starts, asset):\n    idx=pd.DatetimeIndex(starts).tz_convert('America/New_York')\n    hour=np.asarray(idx.hour+idx.minute/60)\n    week=np.asarray(idx.day_of_week)+hour/24\n    time=np.column_stack([np.sin(hour*2*np.pi/24),np.cos(hour*2*np.pi/24),np.sin(week*2*np.pi/7),np.cos(week*2*np.pi/7)])\n    onehot=np.zeros((len(idx),len(ASSETS)))\n    if asset in ASSETS:\n        onehot[:,ASSETS.index(asset)]=1\n    return np.column_stack([time,onehot])\n\n\ndef _one_mean(x,age,half):\n    good=np.isfinite(x)\n    w=np.exp2(-age[good]/half)\n    return np.sum(w*x[good])/np.sum(w) if len(w) and w.sum()>1e-15 else np.nan\n\n\ndef one_features(asset,start_time,time_length,context):\n    last,r,age=valid_returns(context)\n    table=get_profile(asset,str(context.index[-1].date()),'America/New_York')\n    seas=seasonal_values(context.index,table,'America/New_York')\n    r=r/np.sqrt(seas[1:])\n    rms=np.array([ewma(r,age,h) for h in HALVES])\n    absolute=np.array([ewma(r,age,h,True) for h in HALVES])\n    base=np.sqrt(.75*rms[1]+.25*rms[3]) if time_length<=3600 else np.sqrt(.75*rms[3]+.25*rms[5])\n    base=max(base,1e-7)\n    core=np.r_[.5*np.log(np.maximum(rms,1e-14)/base**2),.5*np.log(np.maximum(absolute,1e-14)/base**2),np.log(base)]\n    high=np.asarray(context['high'],dtype=float)[1:]\n    low=np.asarray(context['low'],dtype=float)[1:]\n    ranges=(np.log(np.maximum(high,1e-12)/np.maximum(low,1e-12)))**2/(4*np.log(2))/seas[1:]\n    ranges[(high<=0)|(low<=0)]=np.nan\n    extras=[.5*np.log(max(_one_mean(ranges,age,h),1e-14)/base**2) for h in (60,720,4320)]\n    for col in ['volume','trade_count']:\n        x=np.asarray(context[col],dtype=float)[1:].copy()\n        x[~np.isfinite(r)]=np.nan\n        for fast,slow in [(60,1440),(240,4320)]:\n            a,b=_one_mean(x,age,fast),_one_mean(x,age,slow)\n            extras.append(np.log(max(a,1e-12)/max(b,1e-12)))\n    zeros=np.where(np.isfinite(r),(r==0).astype(float),np.nan)\n    extras += [_one_mean(zeros,age,h) for h in (60,720)]\n    for w in (30,120,360,1440):\n        mask=(age<w)&np.isfinite(r)\n        extras.append(np.sum(r[mask])/(base*np.sqrt(w)))\n    x=np.r_[core,extras,time_features([pd.Timestamp(start_time)],asset)[0]]\n    return x.astype(np.float32),base\n\n\ndef vector_features(frame,asset,table,time_length):\n    \"\"\"Every row is a possible context endpoint; future labels are separate.\"\"\"\n    p=np.asarray(frame.close,dtype=float)\n    r=np.diff(np.log(p),prepend=np.nan)\n    seas=seasonal_values(frame.index,table,'America/New_York')\n    r=r/np.sqrt(seas)\n    length=7*1440-(3 if time_length>3600 else 2)\n    rms=np.column_stack([finite_ewm(r*r,h,length) for h in HALVES])\n    av=np.column_stack([finite_ewm(np.abs(r),h,length)*np.sqrt(np.pi/2) for h in HALVES])\n    base=np.sqrt(.75*rms[:,1]+.25*rms[:,3]) if time_length<=3600 else np.sqrt(.75*rms[:,3]+.25*rms[:,5])\n    base=np.maximum(base,1e-7)\n    core=np.column_stack([.5*np.log(np.maximum(rms,1e-14)/base[:,None]**2),np.log(np.maximum(av,1e-7)/base[:,None]),np.log(base)])\n    high=np.asarray(frame.high,dtype=float)\n    low=np.asarray(frame.low,dtype=float)\n    ranges=np.log(np.maximum(high,1e-12)/np.maximum(low,1e-12))**2/(4*np.log(2))/seas\n    ranges[(high<=0)|(low<=0)]=np.nan\n    extras=[.5*np.log(np.maximum(finite_ewm(ranges,h,length),1e-14)/base**2) for h in (60,720,4320)]\n    for col in ['volume','trade_count']:\n        x=np.asarray(frame[col],dtype=float).copy()\n        x[~np.isfinite(r)]=np.nan\n        for fast,slow in [(60,1440),(240,4320)]:\n            a,b=finite_ewm(x,fast,length),finite_ewm(x,slow,length)\n            extras.append(np.log(np.maximum(a,1e-12)/np.maximum(b,1e-12)))\n    zeros=np.where(np.isfinite(r),(r==0).astype(float),np.nan)\n    extras += [finite_ewm(zeros,h,length) for h in (60,720)]\n    for w in (30,120,360,1440):\n        sums=pd.Series(r).rolling(w,min_periods=1).sum().to_numpy()\n        extras.append(sums/(base*np.sqrt(w)))\n    start=frame.index+pd.Timedelta(minutes=3 if time_length>3600 else 2)\n    out=np.column_stack([core,*extras,time_features(start,asset)])\n    return out.astype(np.float32),base,seas\n\"\"\"Causal feature/forward-label pairs for a volatility-only learning experiment.\"\"\"\nfrom __future__ import annotations\nfrom concurrent.futures import ProcessPoolExecutor\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom explore import load_asset\nfrom ml_features import ASSETS,NAMES,vector_features\nfrom seasonal_models import get_profile\nfrom run_suite import ROOT, CRYPTO\n\n\ndef future_mean(a,n):\n    return pd.Series(a).shift(-1).iloc[::-1].rolling(n,min_periods=max(2,int(.98*n))).mean().iloc[::-1].to_numpy()\n\n\ndef make_asset(asset):\n    os.chdir(ROOT)\n    frame=load_asset(asset)\n    frames={86400:[],3600:[]}\n    for month in pd.date_range(frame.index.min().floor('D').replace(day=1),pd.Timestamp('2026-11-01',tz='UTC'),freq='MS'):\n        stop=min(month+pd.offsets.MonthBegin(1),pd.Timestamp('2026-11-09',tz='UTC'))\n        chunk=frame.loc[(frame.index>=month-pd.Timedelta(days=7))&(frame.index<stop+pd.Timedelta(days=1))]\n        if len(chunk)<3*1440:\n            continue\n        table=get_profile(asset,month.strftime('%Y-%m-%d'),'America/New_York')\n        for horizon in ([86400,3600] if asset in CRYPTO else [86400]):\n            x,base,seas=vector_features(chunk,asset,table,horizon)\n            logp=np.log(np.asarray(chunk.close,dtype=float))\n            if horizon==3600:\n                raw=np.abs(np.diff(logp,prepend=np.nan))/np.sqrt(seas)\n                target=future_mean(raw,60)*np.sqrt(np.pi/2)\n                lead=2\n            else:\n                d=np.r_[np.full(5,np.nan),logp[5:]-logp[:-5]]\n                valid=pd.Series(np.isfinite(logp).astype(float)).rolling(6,min_periods=6).sum().to_numpy()==6\n                d[~valid]=np.nan\n                normal=pd.Series(seas).rolling(5,min_periods=5).sum().to_numpy()\n                raw=np.abs(d)/np.sqrt(normal)\n                target=np.full(len(chunk),np.nan)\n                # Each target uses the exact five-minute phase of its start.\n                phase=np.asarray(chunk.index.minute)%5\n                for k in range(5):\n                    select=np.flatnonzero(phase==k)\n                    target[select]=future_mean(raw[select],288)*np.sqrt(np.pi/2)\n                lead=3\n            valid_count=pd.Series(np.isfinite(logp).astype(float)).rolling(7*1440,min_periods=1).sum().to_numpy()\n            select=np.flatnonzero((chunk.index>=month)&(chunk.index<stop)&np.isin(chunk.index.minute,[7,37]))\n            select=select[(select>=lead)&(valid_count[np.maximum(select-lead,0)]>=2*1440)]\n            y=target[select]/base[select-lead]\n            valid=np.isfinite(y)&(y>0)&np.isfinite(base[select-lead])\n            select=select[valid]\n            out=pd.DataFrame(x[select-lead],columns=NAMES)\n            out['start_time']=chunk.index[select]\n            out['label_end']=chunk.index[select]+pd.Timedelta(seconds=horizon)\n            out['asset']=asset\n            out['time_length']=horizon\n            out['base_sigma']=base[select-lead]\n            out['target_ratio']=target[select]/base[select-lead]\n            frames[horizon].append(out)\n    count=0\n    for horizon,parts in frames.items():\n        if parts:\n            out=pd.concat(parts,ignore_index=True)\n            out=out[out.label_end<pd.Timestamp('2026-11-09',tz='UTC')]\n            out.to_parquet(ROOT/'agent/cache'/f'ml_{asset}_{horizon}.parquet',index=False)\n            count+=len(out)\n    return asset,count\n\n\ndef main():\n    (ROOT/'agent/cache').mkdir(parents=True,exist_ok=True)\n    with ProcessPoolExecutor(max_workers=2) as pool:\n        for a,n in pool.map(make_asset,ASSETS):\n            print(a,n,'training/validation rows',flush=True)\n\nif __name__=='__main__':\n    main()\n\"\"\"Chronological, purged volatility regressions. One bounded GPU job at a time.\"\"\"\nfrom __future__ import annotations\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nimport xgboost as xgb\n\nfrom ml_features import NAMES, CORE_NAMES, TIME_NAMES, ASSETS\nfrom run_suite import ROOT\n\n\ndef main():\n    ap=argparse.ArgumentParser()\n    ap.add_argument('--device',default='cuda')\n    ap.add_argument('--dates',nargs='+',default=['2026-03-01','2026-07-01','2026-08-01','2026-10-01','2026-11-01','2026-11-09'])\n    ap.add_argument('--rounds',type=int,default=600)\n    args=ap.parse_args()\n    os.chdir(ROOT)\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    frames=[pd.read_parquet(p) for p in sorted((ROOT/'agent/cache').glob('ml_*.parquet'))]\n    if len(frames)!=18:\n        raise RuntimeError(f'Expected 18 feature tables, found {len(frames)}; finish make_ml_data first')\n    data=pd.concat(frames,ignore_index=True).sort_values('start_time').reset_index(drop=True)\n    out=ROOT/'agent/artifacts/ml'\n    out.mkdir(parents=True,exist_ok=True)\n    manifest={'features':NAMES,'fits':[],'target':'log forward absolute-return scale / causal seasonal EWMA scale', 'xgboost_version':xgb.__version__}\n    features={'vol':CORE_NAMES+TIME_NAMES+['asset_'+a for a in ASSETS], 'full':NAMES}\n    for date in args.dates:\n        if 'LANDING ORDER' in (ROOT/'agent/BUDGET.md').read_text():\n            print('Landing order: stop fitting.',flush=True)\n            break\n        cutoff=pd.Timestamp(date,tz='UTC')\n        for horizon in [3600,86400]:\n            full=data[(data.time_length==horizon)&(data.label_end<cutoff)&(data.start_time>=cutoff-pd.Timedelta(days=240))].copy()\n            split=cutoff-pd.Timedelta(days=14)\n            train=full[full.label_end<split]\n            valid=full[full.start_time>=split]\n            if len(train)<1000 or len(valid)<100:\n                continue\n            for kind,names in features.items():\n                def matrix(frame):\n                    x=frame[names].to_numpy(dtype=np.float32,copy=True)\n                    x[~np.isfinite(x)]=np.nan\n                    y=np.log(np.clip(frame.target_ratio.to_numpy(),.03,30))\n                    return xgb.DMatrix(x,label=y,feature_names=names,nthread=2)\n                dtrain,dvalid=matrix(train),matrix(valid)\n                params={'objective':'reg:squarederror','tree_method':'hist','device':args.device,\n                        'max_depth':3,'eta':.035,'min_child_weight':80,'lambda':15.,'subsample':.85,\n                        'colsample_bytree':1.,'max_bin':128,'seed':seed,'nthread':2,'eval_metric':'rmse'}\n                probe=xgb.train(params,dtrain,num_boost_round=args.rounds,evals=[(dvalid,'past_validation')],early_stopping_rounds=60,verbose_eval=False)\n                rounds=int(probe.best_iteration)+1\n                model=xgb.train(params,matrix(full),num_boost_round=rounds,verbose_eval=False)\n                # CPU inference keeps GPU use confined to this fitting process.\n                model.set_param({'device':'cpu','nthread':1})\n                name=f'{kind}_{horizon}_{date}.ubj'\n                model.save_model(out/name)\n                item={'cutoff':date,'time_length':horizon,'kind':kind,'features':names,'file':name,\n                      'training_rows':len(full),'purged_training_rows':len(train),'validation_rows':len(valid),\n                      'rounds':rounds,'past_validation_log_rmse':float(probe.best_score),\n                      'importance':model.get_score(importance_type='gain')}\n                manifest['fits'].append(item)\n                (out/'manifest.json').write_text(json.dumps(manifest,indent=2)+'\\n')\n                print(date,horizon,kind,'rows',len(full),'rounds',rounds,'past log RMSE',probe.best_score,flush=True)\n    print('Saved',len(manifest['fits']),'causal volatility models',flush=True)\n\nif __name__=='__main__':\n    main()\n","exit_code":0,"status":"completed"}}
