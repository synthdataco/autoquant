{"type":"item.completed","item":{"id":"item_197","type":"command_execution","command":"/bin/bash -lc 'cat agent/calendar_models.py agent/fit_events.py'","aggregated_output":"\"\"\"Scheduled-event effects over the causal learned volatility baseline.\"\"\"\nfrom __future__ import annotations\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance,get_profile,seasonal_values\nfrom vol_models import valid_returns,ewma\n\nCONTEXT_DAYS=7\nVARIANT=os.environ.get('SYNTH_RESEARCH_VARIANT','event_all')\n\n@lru_cache(maxsize=1)\ndef coefficients():\n    return json.loads((Path(__file__).resolve().parent/'artifacts/events.json').read_text())['fits']\n\n@lru_cache(maxsize=4)\ndef read_calendar(path,mtime):\n    return pd.read_parquet(path)\n\ndef calendar():\n    # Resolve the production calendar inside each simulate call. The cache key\n    # changes when the miner's daily calendar refresh replaces the file.\n    value=os.environ.get('SYNTH_BENCHMARK_CALENDAR')\n    if not value:\n        return None\n    path=Path(value)\n    try:\n        return read_calendar(str(path),path.stat().st_mtime_ns)\n    except (OSError,ValueError):\n        return None\n\ndef kind_of(names):\n    for kind in ['EARNINGS','EIA_PETROLEUM','CPI','NFP','FOMC','PPI','PCE','GDP','RETAIL_SALES']:\n        if kind in names:\n            return 'GDP_PCE' if kind in ('GDP','PCE') else kind\n    return None\n\ndef event_variance_factors(asset,index,horizon,asof,events,strength=1.,earnings=True,only_earnings=False):\n    idx=pd.DatetimeIndex(index)\n    factors=np.ones(len(idx))\n    if events is None or len(idx)==0:\n        return factors\n    fits=coefficients()\n    dates=[date for date in fits if date<=asof]\n    if not dates:\n        return factors\n    rows=[r for r in fits[max(dates)] if r['asset']==asset and r['time_length']==horizon and (earnings or r['event']!='EARNINGS') and (not only_earnings or r['event']=='EARNINGS')]\n    if not rows:\n        return factors\n    relevant=events[(events.time_utc>=idx[0]-pd.Timedelta(hours=8))&(events.time_utc<=idx[-1]+pd.Timedelta(minutes=30))]\n    relevant=relevant[(relevant.scope=='all')|relevant.scope.str.split(',').map(lambda x:asset in x)]\n    for t,group in relevant.groupby('time_utc'):\n        kind=kind_of(set(group.event))\n        for row in rows:\n            if row['event']!=kind:\n                continue\n            low=t+pd.Timedelta(minutes=row['lo'])\n            high=t+pd.Timedelta(minutes=row['hi'])\n            mask=(idx>=low)&(idx<high)\n            value=1.+strength*(row['amplitude']**2-1.)\n            factors[mask]=np.maximum(factors[mask],value)\n    return factors\n\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    rng=np.random.default_rng(seed)\n    events=calendar()\n    last,stepvar=forecast_variance(asset,start_time,time_increment,time_length,context_prices)\n    adjustment=scale_adjustment(asset,start_time,time_length,context_prices,'vol',1.)\n    asof=str(context_prices.index[-1].date())\n    strength=.5 if VARIANT=='event_half' else 1.\n    earnings=VARIANT!='event_macro'\n    future=pd.date_range(pd.Timestamp(start_time)+pd.Timedelta(minutes=1),periods=time_length//60,freq='1min')\n    table=get_profile(asset,asof,'America/New_York')\n    seasonal=seasonal_values(future,table,'America/New_York')\n    factors=event_variance_factors(asset,future,time_length,asof,events,strength,earnings)\n    k=time_increment//60\n    stepvar*=((seasonal*factors).reshape(-1,k).sum(axis=1)/seasonal.reshape(-1,k).sum(axis=1))\n    if VARIANT in ('event_clean','event_clean_half','event_clean_earnings'):\n        _,r,age=valid_returns(context_prices)\n        hseason=seasonal_values(context_prices.index[1:],table,'America/New_York')\n        normalized=r/np.sqrt(hseason)\n        hist=event_variance_factors(asset,context_prices.index[1:],time_length,asof,events,strength,earnings,VARIANT=='event_clean_earnings')\n        h1,h2=(60,720) if time_length<=3600 else (720,4320)\n        old=.75*ewma(normalized,age,h1)+.25*ewma(normalized,age,h2)\n        clean=.75*ewma(normalized/np.sqrt(hist),age,h1)+.25*ewma(normalized/np.sqrt(hist),age,h2)\n        ratio=np.clip(clean/max(old,1e-14),.15,1.)\n        stepvar*=np.sqrt(ratio) if VARIANT=='event_clean_half' else ratio\n    steps=time_length//time_increment+1\n    z=rng.normal(size=(num_simulations,steps))\n    z[:,0]=0\n    z[:,1:]*=np.sqrt(stepvar)*adjustment\n    paths=last*np.exp(np.cumsum(z,axis=1))\n    return (start_time,time_increment,*paths.tolist())\n\"\"\"Causal event-kernel estimates and leave-one-event-out stability diagnostics.\"\"\"\nfrom __future__ import annotations\nfrom concurrent.futures import ProcessPoolExecutor\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom explore import load_asset\nfrom ml_features import one_features\nfrom ml_models import scale_adjustment\nfrom seasonal_models import get_profile,seasonal_values\nfrom synth_lib.benchmark.generate_predictions import context_slice\nfrom run_suite import ROOT,CRYPTO,OTHER\n\n# Kernels use only dates supplied by the calendar. Earnings have coarse session\n# anchors, so their windows are wider than a precisely timed macro release.\nMACRO_BINS=[(-5,0),(0,1),(1,5),(5,15),(15,60),(60,180)]\nEARNINGS_BINS=[(-30,0),(0,30),(30,120),(120,240),(240,480)]\n\n\ndef event_type(names):\n    names=set(names)\n    for kind in ['EARNINGS','EIA_PETROLEUM','CPI','NFP','FOMC','PPI','PCE','GDP','RETAIL_SALES']:\n        if kind in names:\n            return 'GDP_PCE' if kind in ('GDP','PCE') else kind\n    return None\n\n\ndef observe(asset):\n    os.chdir(ROOT)\n    frame=load_asset(asset)\n    r=np.log(frame.close).diff()\n    cal=pd.read_parquet(os.environ['SYNTH_BENCHMARK_CALENDAR'])\n    cal=cal[(cal.scope=='all')|cal.scope.str.split(',').map(lambda x:asset in x)]\n    cal=cal[(cal.time_utc<'2026-11-09')&(~cal.event.str.startswith('NYSE'))]\n    records=[]\n    for event_at,events in cal.groupby('time_utc'):\n        kind=event_type(events.event)\n        if kind is None or event_at<frame.index.min()+pd.Timedelta(days=14):\n            continue\n        bins=EARNINGS_BINS if kind=='EARNINGS' else MACRO_BINS\n        issue_start=event_at-pd.Timedelta(minutes=35)\n        for horizon in ([86400,3600] if asset in CRYPTO else [86400]):\n            context=context_slice(frame,issue_start,horizon,7)\n            _,base=one_features(asset,issue_start,horizon,context)\n            adjustment=scale_adjustment(asset,issue_start,horizon,context,'vol',1.)\n            table=get_profile(asset,str(context.index[-1].date()),'America/New_York')\n            for lo,hi in bins:\n                if event_at+pd.Timedelta(minutes=hi)>frame.index.max():\n                    continue\n                observed=r.loc[event_at+pd.Timedelta(minutes=lo):event_at+pd.Timedelta(minutes=hi-1)]\n                if observed.notna().sum()<max(1,.8*(hi-lo)):\n                    continue\n                season=seasonal_values(observed.index,table,'America/New_York')\n                standardized=np.asarray(observed)/(max(base*adjustment,1e-8)*np.sqrt(season))\n                amplitude=float(np.nanmean(np.abs(standardized))*np.sqrt(np.pi/2))\n                records.append({'asset':asset,'group':'crypto' if asset in CRYPTO else ('equity' if asset not in ['XAU','WTIOIL'] else asset),\n                                'time_length':horizon,'event':kind,'time':event_at,'end':event_at+pd.Timedelta(minutes=hi),\n                                'lo':lo,'hi':hi,'amplitude':amplitude,'observations':int(observed.notna().sum())})\n    return pd.DataFrame(records)\n\n\ndef robust_center(values):\n    # A winsorized mean of absolute returns is more stable than mean variance.\n    a=np.asarray(values,dtype=float)\n    if len(a)>=5:\n        a=np.minimum(a,np.quantile(a,.9)*1.5)\n    return float(np.mean(a)) if len(a) else 1.\n\n\ndef main():\n    os.chdir(ROOT)\n    out=ROOT/'agent/results/events'\n    out.mkdir(parents=True,exist_ok=True)\n    observation_file=out/'causal_event_observations.parquet'\n    if observation_file.exists():\n        data=pd.read_parquet(observation_file)\n    else:\n        with ProcessPoolExecutor(max_workers=2) as pool:\n            data=pd.concat(list(pool.map(observe,CRYPTO+OTHER)),ignore_index=True)\n        data.to_parquet(observation_file,index=False)\n    dates=['2026-03-01','2026-07-01','2026-08-01','2026-10-01','2026-11-01','2026-11-09']\n    fits={}\n    stability=[]\n    for date in dates:\n        train=data[(data.end<pd.Timestamp(date,tz='UTC'))&(data.time>=pd.Timestamp(date,tz='UTC')-pd.Timedelta(days=365))]\n        rows=[]\n        for (group,horizon,event,lo,hi),bucket in train.groupby(['group','time_length','event','lo','hi']):\n            # Assets share each macro surprise. Count dates, not asset rows.\n            per_event=bucket.groupby('time').amplitude.mean()\n            n=len(per_event)\n            if n<3:\n                continue\n            center=robust_center(per_event.to_numpy())\n            shrink=n/(n+4.)\n            group_amplitude=max(1.,1+shrink*(center-1))\n            for asset,sub in bucket.groupby('asset'):\n                na=len(sub)\n                individual=robust_center(sub.amplitude.to_numpy())\n                asset_weight=na/(na+12.)\n                amplitude=max(1.,asset_weight*individual+(1-asset_weight)*group_amplitude)\n                amplitude=min(amplitude,15. if lo<5 else 5.)\n                rows.append({'asset':asset,'time_length':int(horizon),'event':event,'lo':int(lo),'hi':int(hi),\n                             'amplitude':amplitude,'n_dates':n,'n_asset_dates':na})\n            if date=='2026-11-09':\n                jackknife=[robust_center(per_event.drop(t).to_numpy()) for t in per_event.index]\n                stability.append({'group':group,'time_length':horizon,'event':event,'lo':lo,'hi':hi,'n_dates':n,\n                                  'mean_absolute_scale_ratio':center,'loo_min':min(jackknife),'loo_max':max(jackknife)})\n        fits[date]=rows\n    artifact={'reference':'causal ml_vol Gaussian background','fits':fits}\n    dest=ROOT/'agent/artifacts/events.json'\n    dest.write_text(json.dumps(artifact,indent=2)+'\\n')\n    pd.DataFrame(stability).to_csv(out/'leave_one_event_out.csv',index=False)\n    print('Saved',len(data),'event observations;',sum(map(len,fits.values())),'causal event coefficients')\n    print(pd.DataFrame(stability).query('lo==0').round(3).to_string(index=False))\n\nif __name__=='__main__':\n    main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_198","type":"command_execution","command":"/bin/bash -lc 'cat .venv/lib/python3.12/site-packages/synth/validator/competition_config.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_198","type":"command_execution","command":"/bin/bash -lc 'cat .venv/lib/python3.12/site-packages/synth/validator/competition_config.py'","aggregated_output":"from dataclasses import dataclass\n\nSMOOTHED_SCORE_COEFFICIENT = 1 / 3\n\n# 1h score = price CRPS + VOL_CRPS_LAMBDA × the mean, over the block sizes,\n# of the mean per-block volatility CRPS — so each weight below must stay\n# VOL_CRPS_LAMBDA / (3 block sizes × the number of blocks of that size).\nVOL_CRPS_LAMBDA = 5.25\n\n\n@dataclass\nclass CompetitionConfig:\n    asset_list: list[str]\n    label: str\n    time_length: int\n    time_increment: int\n    scoring_intervals: dict[str, int]  # Define scoring intervals in seconds.\n    # Volatility CRPS blocks: name -> (block duration in seconds, weight).\n    # Empty means the competition scores on the price CRPS alone.\n    vol_scoring_blocks: dict[str, tuple[int, float]]\n    window_days: int\n    softmax_beta: float\n\n\nCOM_EQU_24H = CompetitionConfig(\n    asset_list=[\n        \"XAU\",\n        \"NVDAX\",\n        \"GOOGLX\",\n        \"TSLAX\",\n        \"AAPLX\",\n        \"WTIOIL\",\n        \"SPCX\",\n        \"SP500\",\n    ],\n    label=\"Commodities/Equities 24h\",\n    time_length=86400,\n    time_increment=300,\n    scoring_intervals={\n        \"5min\": 300,  # 5 minutes\n        \"30min\": 1800,  # 30 minutes\n        \"3hour\": 10800,  # 3 hours\n        \"24hour_abs\": 86400,  # 24 hours\n    },\n    vol_scoring_blocks={},\n    window_days=10,\n    softmax_beta=-0.15,\n)\n\nCRYPTO_24H = CompetitionConfig(\n    asset_list=[\n        \"BTC\",\n        \"ETH\",\n        \"SOL\",\n        \"XRP\",\n        \"HYPE\",\n    ],\n    label=\"Crypto 24h\",\n    time_length=86400,\n    time_increment=300,\n    scoring_intervals={\n        \"5min\": 300,  # 5 minutes\n        \"30min\": 1800,  # 30 minutes\n        \"3hour\": 10800,  # 3 hours\n        \"24hour_abs\": 86400,  # 24 hours\n    },\n    vol_scoring_blocks={},\n    window_days=10,\n    softmax_beta=-0.15,\n)\n\nCRYPTO_1H = CompetitionConfig(\n    asset_list=[\n        \"BTC\",\n        \"ETH\",\n        \"SOL\",\n        \"XRP\",\n        \"HYPE\",\n    ],\n    label=\"Crypto 1h\",\n    time_length=3600,\n    time_increment=60,\n    scoring_intervals={\n        \"1min\": 60,\n        \"2min\": 120,\n        \"5min\": 300,\n        \"15min\": 900,\n        \"30min\": 1800,\n        \"60min_abs\": 3600,\n        \"0_5min_gaps\": 300,\n        \"0_10min_gaps\": 600,\n        \"0_15min_gaps\": 900,\n        \"0_20min_gaps\": 1200,\n        \"0_25min_gaps\": 1500,\n        \"0_30min_gaps\": 1800,\n        \"0_35min_gaps\": 2100,\n        \"0_40min_gaps\": 2400,\n        \"0_45min_gaps\": 2700,\n        \"0_50min_gaps\": 3000,\n        \"0_55min_gaps\": 3300,\n        \"0_60min_gaps\": 3600,\n    },\n    vol_scoring_blocks={\n        \"vol_60min\": (3600, VOL_CRPS_LAMBDA / 3),  # 1 block\n        \"vol_15min\": (900, VOL_CRPS_LAMBDA / 12),  # 4 blocks\n        \"vol_5min\": (300, VOL_CRPS_LAMBDA / 36),  # 12 blocks\n    },\n    window_days=5,\n    softmax_beta=-0.3,\n)\n\n\n# Canonical list of competitions. Both the scoring cycle (neurons/validator.py)\n# and the moving-average update (forward.py) iterate this, so a competition\n# added/renamed/reordered here propagates to both — don't re-list elsewhere.\nALL_COMPETITIONS = [\n    COM_EQU_24H,\n    CRYPTO_24H,\n    CRYPTO_1H,\n]\n\n# VHFT (Synth Ultra) — the 10-second BTC-microprice competition. Scored OFF-subnet\n# and blended in via the external-ingestion path (vhft_score_provider +\n# compute_vhft_smoothed_score), NOT through the inline-CRPS path — so it is\n# deliberately kept OUT of ALL_COMPETITIONS. It reuses the same\n# SMOOTHED_SCORE_COEFFICIENT and softmax as the other three, so after set_weights\n# L1-normalizes, the four competitions split emissions equally (the coefficient\n# value cancels; a *shared* coefficient is what makes the split equal).\nVHFT_COMPETITION = CompetitionConfig(\n    asset_list=[\"BTC\"],\n    label=\"VHFT 10s\",\n    time_length=10,\n    time_increment=10,\n    scoring_intervals={\"10s\": 10},\n    vol_scoring_blocks={},\n    # window_days is nominal — the external scorer already windows the scores, so\n    # no per-window aggregation happens here.\n    window_days=1,\n    # softmax_beta is deliberately steeper than the other competitions': this\n    # field is tightly bunched, so a gentler beta leaves rewards nearly flat\n    # across it.\n    #\n    # Beta responds to the SPREAD between miners, not the absolute score level:\n    # the scorer subtracts each prompt's winner and softmax is invariant to that\n    # shared offset, so shifting every score changes nothing. A wider field\n    # therefore concentrates rewards harder at a fixed beta. Re-measure before\n    # changing this; do not reason from the score level.\n    #\n    # MUST stay negative (lower score = higher reward), same convention as the\n    # other competitions.\n    softmax_beta=-4.0,\n)\n\n# Plausible size of the VHFT participant field, enforced in\n# compute_vhft_smoothed_score — outside this range the blend is skipped for the\n# cycle rather than trusted.\n#\n# The VHFT block is a fixed SMOOTHED_SCORE_COEFFICIENT however many uids share\n# it, so each participant's cut scales as 1/N — at one participant that is the\n# entire block. A round that scores only a handful of miners, whether from a\n# degraded scorer or a field that has mostly dropped out, would otherwise hand\n# one miner an outsized share, so require a floor. The ceiling is the other end\n# of the same argument: a snapshot naming far more scored participants than the\n# competition has is a malfunctioning scorer, not sudden popularity.\nVHFT_MIN_PARTICIPANTS = 3\nVHFT_MAX_PARTICIPANTS = 64\n","exit_code":0,"status":"completed"}}
