{"type":"item.completed","item":{"id":"item_652","type":"command_execution","command":"/bin/bash -lc 'cat agent/fit_seasonality.py agent/explore.py'","aggregated_output":"\"\"\"Fit timestamped seasonal variance priors solely from earlier snapshot data.\n\nTraining uses locally normalized squared returns, not the evaluation metric.\nAll CRPS experiments remain in predict.py with the official backtester.\n\"\"\"\nfrom __future__ import annotations\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom explore import load_asset\nfrom run_suite import CRYPTO, OTHER, ROOT\n\nCLOCKS = ['UTC', 'America/New_York', 'Europe/London']\n\n\ndef fit_asset(asset, dates, lookback, bins, statistic='variance'):\n    frame = load_asset(asset)\n    close = np.asarray(frame.close, dtype=float)\n    logp = np.log(close)\n    returns = pd.Series(np.diff(logp, prepend=np.nan), index=frame.index)\n    r2 = returns.abs() if statistic == 'absolute' else returns**2\n    # Remove slow scale changes before pooling clock bins. Centering here is\n    # inside the training sample only; its final days are refitted for each cutoff.\n    fitted = {}\n    for date in dates:\n        end = pd.Timestamp(date, tz='UTC')\n        train = r2.loc[(r2.index < end) & (r2.index >= end-pd.Timedelta(days=lookback))]\n        if train.notna().sum() < 7*1440:\n            continue\n        daily = train.resample('1D').mean()\n        level = daily.rolling(15, center=True, min_periods=3).mean()\n        norm = train / level.reindex(train.index.floor('D')).to_numpy()\n        # One enormous print must not determine a clock bin for months.\n        norm = norm.clip(upper=10 if statistic == 'absolute' else 100)\n        good = np.isfinite(norm.to_numpy())\n        samples = norm.to_numpy()[good]\n        snapshot = {'training_days': int(daily.notna().sum()), 'clocks': {}}\n        for clock in CLOCKS:\n            idx = norm.index.tz_convert(clock)\n            dow = np.asarray(idx.day_of_week)\n            tod = np.asarray((idx.hour*60 + idx.minute)*bins//1440)\n            group = dow*bins+tod\n            sums = np.bincount(group[good], weights=samples, minlength=7*bins).reshape(7,bins)\n            counts = np.bincount(group[good], minlength=7*bins).reshape(7,bins)\n            mean = np.divide(sums,counts,out=np.ones_like(sums),where=counts>0)\n            if statistic == 'absolute':\n                mean = mean**2\n            snapshot['clocks'][clock] = {'raw': mean.round(7).tolist(), 'counts': counts.tolist()}\n        fitted[date] = snapshot\n    return asset, fitted\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument('--lookback', type=int, default=120)\n    ap.add_argument('--bins',type=int,default=96)\n    ap.add_argument('--statistic',choices=['variance','absolute'],default='variance')\n    ap.add_argument('--workers',type=int,default=4)\n    ap.add_argument('--assets',nargs='+',default=CRYPTO+OTHER)\n    ap.add_argument('--output',type=Path,default=Path('agent/artifacts/seasonality.json'))\n    args = ap.parse_args()\n    os.chdir(ROOT)\n    dates = list(pd.date_range('2025-09-01','2026-11-01',freq='MS').strftime('%Y-%m-%d'))+['2026-11-09']\n    with ThreadPoolExecutor(max_workers=args.workers) as pool:\n        results = list(pool.map(lambda a: fit_asset(a,dates,args.lookback,args.bins,args.statistic), args.assets))\n    payload={'bins':args.bins, 'lookback_days':args.lookback,'statistic':args.statistic,'cutoff':'2026-11-08','assets':dict(results)}\n    args.output.parent.mkdir(parents=True,exist_ok=True)\n    args.output.write_text(json.dumps(payload,separators=(',',':'))+'\\n')\n    print('Saved', args.output, 'bytes', args.output.stat().st_size)\n    for a, fits in results:\n        print(a, len(fits), 'as-of snapshots')\n\nif __name__ == '__main__':\n    main()\n\"\"\"Snapshot-only descriptive measurements; no substitute CRPS implementation.\"\"\"\nfrom __future__ import annotations\n\nfrom concurrent.futures import ThreadPoolExecutor\nimport json\nfrom pathlib import Path\nimport os\nimport numpy as np\nimport pandas as pd\n\nfrom synth_lib.preparation.config import default_store_root\nfrom run_suite import CRYPTO, OTHER, ROOT\n\n\ndef load_asset(asset):\n    files = sorted(default_store_root(asset).glob(\"date=*.parquet\"))\n    frames = [pd.read_parquet(p, columns=[\"timestamp\", \"close\", \"high\", \"low\", \"volume\", \"trade_count\"]) for p in files]\n    df = pd.concat(frames, ignore_index=True)\n    df[\"timestamp\"] = pd.to_datetime(df[\"timestamp\"], utc=True)\n    return df.set_index(\"timestamp\").sort_index()\n\n\ndef describe(asset):\n    df = load_asset(asset)\n    p = pd.to_numeric(df.close, errors=\"coerce\").to_numpy(dtype=float)\n    r = np.diff(np.log(p), prepend=np.nan)\n    # Retain missing minutes as missing; never difference across a dropped gap.\n    r2 = pd.Series(r*r, index=df.index)\n    daily = r2.resample(\"1D\").mean()\n    relative = r2 / r2.groupby(df.index.floor(\"D\")).transform(\"mean\")\n    rows = []\n    for clock in [\"UTC\", \"America/New_York\", \"Europe/London\"]:\n        idx = df.index.tz_convert(clock)\n        group = pd.DataFrame({\"r2\": r2.to_numpy(), \"rel\": relative.to_numpy(), \"dow\": idx.dayofweek, \"hour\": idx.hour}, index=df.index)\n        for era, start, end in [(\"early\", \"2025-08-01\", \"2026-03-08\"), (\"summer\", \"2026-04-01\", \"2026-10-25\"), (\"winter\", \"2026-11-01\", \"2026-11-09\")]:\n            sub = group.loc[(group.index >= start) & (group.index < end)]\n            for (dow, hour), g in sub.groupby([\"dow\", \"hour\"]):\n                rows.append({\"asset\": asset, \"clock\": clock, \"era\": era, \"dow\": int(dow), \"hour\": int(hour), \"variance\": g.r2.mean(), \"relative_daily_variance\": g.rel.mean(), \"n\": int(g.r2.notna().sum())})\n    rows = pd.DataFrame(rows)\n    daily_frame = pd.DataFrame({\"asset\": asset, \"daily_minute_variance\": daily, \"daily_vol_bps\": np.sqrt(daily*1440)*10000})\n    five = np.log(df.close).diff(5)\n    valid5 = df.close.notna().rolling(6).sum().eq(6)\n    five = five.where(valid5)\n    absret = np.abs(r[np.isfinite(r)])\n    q = np.quantile(absret, [0.5, .9, .99, .999])\n    ny = df.index.tz_convert('America/New_York')\n    recent = df.index >= '2026-07-01'\n    variances = r2.to_numpy()\n    weekday = float(np.nanmean(variances[recent & (ny.dayofweek < 5)]))\n    weekend = float(np.nanmean(variances[recent & (ny.dayofweek >= 5)]))\n    summary = {\"asset\": asset, \"n\": len(df), \"valid\": int(np.isfinite(p).sum()), \"sigma_min_bps\": float(np.nanstd(r)*10000), \"abs_q_bps\": (q*10000).tolist(), \"var5_vs_5var1\": float(np.nanmean(five**2)/(5*np.nanmean(r*r))), \"weekday_weekend_sigma_ratio\": float(np.sqrt(weekday/weekend)), \"daily_vol_bps_quantiles\": daily_frame.daily_vol_bps.quantile([.1,.5,.9]).tolist()}\n    return rows, daily_frame, summary\n\n\ndef main():\n    os.chdir(ROOT)\n    out = ROOT / \"agent/results/descriptive\"\n    out.mkdir(parents=True, exist_ok=True)\n    with ThreadPoolExecutor(max_workers=4) as pool:\n        results = list(pool.map(describe, CRYPTO + OTHER))\n    pd.concat([x[0] for x in results], ignore_index=True).to_parquet(out / 'seasonality.parquet', index=False)\n    pd.concat([x[1] for x in results]).to_parquet(out / 'daily.parquet')\n    (out / 'summary.json').write_text(json.dumps([x[2] for x in results], indent=2) + '\\n')\n    print(pd.DataFrame([x[2] for x in results]).to_string(index=False))\n\n\nif __name__ == '__main__':\n    main()\n","exit_code":0,"status":"completed"}}
