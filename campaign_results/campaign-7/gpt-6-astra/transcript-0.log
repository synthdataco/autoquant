{"type":"item.started","item":{"id":"item_660","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport os,sys,json,time\nsys.path.insert(0,'agent')\nimport numpy as np\nimport pandas as pd\nfrom zero_mass_models import simulate,probabilities\nfrom candidate_models import candidate_forecast\nfrom synth_lib.benchmark.generate_predictions import context_slice,load_minute_prices\nfrom synth_lib.preparation.config import MARKET_DATA_DIR\nstart=pd.Timestamp('2026-11-07 13:17',tz='UTC')\nrows=[]\nfor asset,horizon,step in [('BTC',3600,60),('XAU',86400,300),('AAPLX',86400,300)]:\n data=load_minute_prices(MARKET_DATA_DIR,asset,start-pd.Timedelta(days=7),start)\n context=context_slice(data,start,horizon,7)\n p=probabilities(asset,start,step,horizon,context)\n began=time.perf_counter()\n paths=np.asarray(simulate(asset,start.isoformat(),step,horizon,1000,context)[2:])\n seconds=time.perf_counter()-began\n assert paths.shape==(1000,horizon//step+1) and np.isfinite(paths).all() and (paths>0).all()\n assert np.all(paths[:,0]==context.close.dropna().iloc[-1])\n _,var=candidate_forecast(asset,start,step,horizon,context)\n increments=np.diff(np.log(paths),axis=1)\n row={'asset':asset,'time_length':horizon,'seconds':seconds,'predicted_zero_mean':float(p.mean()),'simulated_zero_mean':float((np.diff(paths,axis=1)==0).mean()),'mean_absolute_scale_ratio':float(np.abs(increments).mean()/(np.sqrt(var).mean()*np.sqrt(2/np.pi)))}\n rows.append(row)\n print(row)\nfrom pathlib import Path\nPath('agent/results/zero_mass_audit.json').write_text(json.dumps(rows,indent=2)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
