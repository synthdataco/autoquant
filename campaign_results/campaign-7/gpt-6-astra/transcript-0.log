{"type":"item.started","item":{"id":"item_426","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport sys,pandas as pd,numpy as np\nsys.path.insert(0,'agent')\nfrom compare import load\nfrom pathlib import Path\nrows=[]\nfor seed in [20261108,91117,641,3109]:\n    g=load(f'sobol_rank_bridge_precision_{seed}')\n    m=load(f'sobol_rank_bridge_mix_precision_{seed}')\n    keys=['asset','start_time','time_length','window']\n    f=g[keys+['crps']].merge(m[keys+['crps']],on=keys,suffixes=('_gaussian','_mixture'),validate='one_to_one')\n    for window,part in [('all',f),*f.groupby('window')]:\n        a,b=part.crps_gaussian.mean(),part.crps_mixture.mean()\n        rows.append({'seed':seed,'window':window,'gaussian':a,'mixture':b,'change_pct':100*(b/a-1)})\nr=pd.DataFrame(rows)\nr.to_csv('agent/results/sampling_precision.csv',index=False)\nprint(r.round(6).to_string(index=False))\nprint('Across seeds by window')\nprint(r.groupby('window')[['gaussian','mixture','change_pct']].agg(['mean','std']).round(6).to_string())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
