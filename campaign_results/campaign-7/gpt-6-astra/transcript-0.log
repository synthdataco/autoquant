{"type":"item.started","item":{"id":"item_535","type":"command_execution","command":"/bin/bash -lc 'cat agent/analyze_paired.py agent/compare.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_535","type":"command_execution","command":"/bin/bash -lc 'cat agent/analyze_paired.py agent/compare.py'","aggregated_output":"\"\"\"Summarize paired official scores with calendar-week uncertainty blocks.\n\nThis module never calculates CRPS. It only aggregates scores saved by predict.py.\n\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom compare import load\nfrom run_suite import ROOT\n\n\ndef join_scores(baseline_tags, candidate_tags, configs=None):\n    baseline = pd.concat([load(t) for t in baseline_tags], ignore_index=True)\n    candidate = pd.concat([load(t) for t in candidate_tags], ignore_index=True)\n    if configs:\n        baseline = baseline[baseline.config.isin(configs)]\n        candidate = candidate[candidate.config.isin(configs)]\n    keys = ['asset', 'time_length', 'start_time', 'window', 'config', 'scored_time']\n    details = sorted(set(baseline.columns).intersection(candidate.columns))\n    details = [c for c in details if c.startswith('detail_')]\n    score_cols = ['crps', *details]\n    joined = baseline[keys+score_cols].merge(candidate[keys+score_cols], on=keys,\n                                            suffixes=('_base', '_new'), validate='one_to_one')\n    if len(joined) != len(baseline) or len(joined) != len(candidate):\n        raise ValueError(f'Incomplete pairing: {len(baseline)}, {len(candidate)}, {len(joined)}')\n    if not np.isfinite(joined[['crps_base', 'crps_new']]).all().all():\n        raise ValueError('Nonfinite saved official score')\n    if (joined[['crps_base', 'crps_new']] < 0).any().any():\n        raise ValueError('Rejected saved official score')\n    joined['day'] = pd.to_datetime(joined.scored_time, utc=True).dt.floor('D')\n    joined['week'] = joined.day-pd.to_timedelta(joined.day.dt.day_of_week, unit='D')\n    joined['difference'] = joined.crps_new-joined.crps_base\n    return joined, details\n\n\ndef aggregate(frame, keys):\n    grouped = frame.groupby(keys, observed=True)\n    result = grouped[['crps_base', 'crps_new']].mean()\n    result['prompts'] = grouped.size()\n    result['change_pct'] = 100*(result.crps_new/result.crps_base-1)\n    return result\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument('--baseline', nargs='+', required=True)\n    ap.add_argument('--candidate', nargs='+', required=True)\n    ap.add_argument('--out', required=True)\n    ap.add_argument('--configs', nargs='+', choices=['crypto24', 'other24', 'crypto1'])\n    ap.add_argument('--replicates', type=int, default=4000)\n    args = ap.parse_args()\n    frame, details = join_scores(args.baseline, args.candidate, args.configs)\n    dest = ROOT/'agent/results'/args.out\n    dest.mkdir(parents=True, exist_ok=True)\n    for key in ['asset', 'day', 'week', 'window']:\n        aggregate(frame, ['config', key]).to_csv(dest/f'{key}.csv')\n    cells = aggregate(frame, ['config', 'window', 'asset'])\n    cells.to_csv(dest/'cells.csv')\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    rng = np.random.default_rng(seed)\n    summaries = {}\n    for config, f in frame.groupby('config'):\n        weekly = f.groupby('week')[['crps_base', 'crps_new']].sum()\n        picks = rng.integers(0, len(weekly), (args.replicates, len(weekly)))\n        sampled = weekly.to_numpy()[picks].sum(axis=1)\n        changes = 100*(sampled[:, 1]/sampled[:, 0]-1)\n        daily = f.groupby('day')[['crps_base', 'crps_new']].mean()\n        count_cells = cells.loc[config]\n        row = {\n            'prompts': len(f), 'scored_days': int(f.day.nunique()), 'calendar_weeks': len(weekly),\n            'baseline_crps': float(f.crps_base.mean()), 'candidate_crps': float(f.crps_new.mean()),\n            'change_pct': float(100*(f.crps_new.sum()/f.crps_base.sum()-1)),\n            'week_block_change_pct_ci95': np.quantile(changes, [.025, .975]).tolist(),\n            'equal_day_change_pct': float(100*(daily.crps_new.mean()/daily.crps_base.mean()-1)),\n            'cells_improved': int((count_cells.change_pct < 0).sum()), 'cells': len(count_cells),\n            'weeks_improved': int((weekly.crps_new < weekly.crps_base).sum()),\n        }\n        for name, start in [('post_cadence', '2026-10-30'), ('post_us_dst', '2026-11-01')]:\n            part = f[f.day >= pd.Timestamp(start, tz='UTC')]\n            if len(part):\n                row[name] = {'prompts': len(part), 'baseline_crps': float(part.crps_base.mean()),\n                             'candidate_crps': float(part.crps_new.mean()),\n                             'change_pct': float(100*(part.crps_new.sum()/part.crps_base.sum()-1))}\n        summaries[config] = row\n        print(config, json.dumps(row, sort_keys=True))\n    interval_rows = []\n    for config, f in frame.groupby('config'):\n        for name in details:\n            b, n = f[name+'_base'], f[name+'_new']\n            valid = b.notna() & n.notna()\n            if valid.any():\n                interval_rows.append({'config': config, 'interval': name.removeprefix('detail_'),\n                                      'baseline': float(b[valid].mean()), 'candidate': float(n[valid].mean()),\n                                      'difference': float((n[valid]-b[valid]).mean())})\n    if interval_rows:\n        pd.DataFrame(interval_rows).to_csv(dest/'intervals.csv', index=False)\n    extremes = pd.concat([part for _, f in frame.groupby('config')\n                          for part in [f.nlargest(12, 'difference'), f.nsmallest(12, 'difference')]],\n                         ignore_index=True)\n    extremes[['config', 'asset', 'start_time', 'scored_time', 'crps_base', 'crps_new', 'difference']].to_csv(dest/'extremes.csv', index=False)\n    result = {'baseline_tags': args.baseline, 'candidate_tags': args.candidate,\n              'configuration_filter': args.configs,\n              'uncertainty_method': 'Paired calendar-week cluster bootstrap, all assets and prompts retained within each sampled week. Exploratory intervals do not account for model selection.',\n              'replicates': args.replicates, 'seed': seed, 'configurations': summaries}\n    (dest/'summary.json').write_text(json.dumps(result, indent=2)+'\\n')\n\n\nif __name__ == '__main__':\n    main()\n\"\"\"Paired comparisons of saved official CRPS rows; does not compute CRPS.\"\"\"\nfrom __future__ import annotations\nimport argparse\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom run_suite import OTHER, ROOT\n\n\ndef load(tag):\n    root = ROOT / 'agent/results' / tag\n    frames=[]\n    for path in sorted(root.glob('*.parquet')):\n        f=pd.read_parquet(path)\n        if 'miner_id' in f:\n            f=f[f.miner_id==999]\n        f=f[f.crps>=0].copy()\n        f['window']=path.stem.split('_')[-1]\n        frames.append(f)\n    frame=pd.concat(frames,ignore_index=True)\n    frame['config']=np.where(frame.time_length==3600,'crypto1',np.where(frame.asset.isin(OTHER),'other24','crypto24'))\n    return frame\n\n\ndef compare(base, candidate):\n    keys=['asset','time_length','start_time','window','config']\n    paired=base[keys+['crps']].merge(candidate[keys+['crps']],on=keys,suffixes=('_base','_new'),validate='one_to_one')\n    cells=paired.groupby(['config','window','asset'])[['crps_base','crps_new']].mean()\n    cells['change_pct']=100*(cells.crps_new/cells.crps_base-1)\n    summary=paired.groupby(['config','window'])[['crps_base','crps_new']].mean()\n    summary['change_pct']=100*(summary.crps_new/summary.crps_base-1)\n    print(summary.round(4).to_string())\n    for config, f in paired.groupby('config'):\n        cell=cells.loc[config]\n        print(f'{config}: {f.crps_base.mean():.6f} -> {f.crps_new.mean():.6f} ({100*(f.crps_new.mean()/f.crps_base.mean()-1):+.3f}%), cells improved {int((cell.change_pct<0).sum())}/{len(cell)}, median cell {cell.change_pct.median():+.3f}%')\n    return cells\n\n\ndef main():\n    ap=argparse.ArgumentParser()\n    ap.add_argument('base')\n    ap.add_argument('candidates',nargs='+')\n    ap.add_argument('--cells',action='store_true')\n    args=ap.parse_args()\n    base=load(args.base)\n    for tag in args.candidates:\n        print('\\n'+tag)\n        cells=compare(base,load(tag))\n        if args.cells:\n            print(cells.round(4).to_string())\n        cells.to_csv(ROOT/'agent/results'/tag/f'comparison_vs_{args.base}.csv')\n\nif __name__=='__main__':\n    main()\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_536","type":"command_execution","command":"/bin/bash -lc 'cat agent/calendar_models.py agent/closure_models.py'","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_536","type":"command_execution","command":"/bin/bash -lc 'cat agent/calendar_models.py agent/closure_models.py'","aggregated_output":"\"\"\"Scheduled-event effects over the causal learned volatility baseline.\"\"\"\nfrom __future__ import annotations\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance,get_profile,seasonal_values\nfrom vol_models import valid_returns,ewma\n\nCONTEXT_DAYS=7\nVARIANT=os.environ.get('SYNTH_RESEARCH_VARIANT','event_all')\n\n@lru_cache(maxsize=1)\ndef coefficients():\n    return json.loads((Path(__file__).resolve().parent/'artifacts/events.json').read_text())['fits']\n\n@lru_cache(maxsize=4)\ndef read_calendar(path,mtime):\n    return pd.read_parquet(path)\n\ndef calendar():\n    # Resolve the production calendar inside each simulate call. The cache key\n    # changes when the miner's daily calendar refresh replaces the file.\n    value=os.environ.get('SYNTH_BENCHMARK_CALENDAR')\n    if not value:\n        return None\n    path=Path(value)\n    try:\n        return read_calendar(str(path),path.stat().st_mtime_ns)\n    except (OSError,ValueError):\n        return None\n\ndef kind_of(names):\n    for kind in ['EARNINGS','EIA_PETROLEUM','CPI','NFP','FOMC','PPI','PCE','GDP','RETAIL_SALES']:\n        if kind in names:\n            return 'GDP_PCE' if kind in ('GDP','PCE') else kind\n    return None\n\ndef event_variance_factors(asset,index,horizon,asof,events,strength=1.,earnings=True,only_earnings=False):\n    idx=pd.DatetimeIndex(index)\n    factors=np.ones(len(idx))\n    if events is None or len(idx)==0:\n        return factors\n    fits=coefficients()\n    dates=[date for date in fits if date<=asof]\n    if not dates:\n        return factors\n    rows=[r for r in fits[max(dates)] if r['asset']==asset and r['time_length']==horizon and (earnings or r['event']!='EARNINGS') and (not only_earnings or r['event']=='EARNINGS')]\n    if not rows:\n        return factors\n    relevant=events[(events.time_utc>=idx[0]-pd.Timedelta(hours=8))&(events.time_utc<=idx[-1]+pd.Timedelta(minutes=30))]\n    relevant=relevant[(relevant.scope=='all')|relevant.scope.str.split(',').map(lambda x:asset in x)]\n    for t,group in relevant.groupby('time_utc'):\n        kind=kind_of(set(group.event))\n        for row in rows:\n            if row['event']!=kind:\n                continue\n            low=t+pd.Timedelta(minutes=row['lo'])\n            high=t+pd.Timedelta(minutes=row['hi'])\n            mask=(idx>=low)&(idx<high)\n            value=1.+strength*(row['amplitude']**2-1.)\n            factors[mask]=np.maximum(factors[mask],value)\n    return factors\n\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    rng=np.random.default_rng(seed)\n    events=calendar()\n    last,stepvar=forecast_variance(asset,start_time,time_increment,time_length,context_prices)\n    adjustment=scale_adjustment(asset,start_time,time_length,context_prices,'vol',1.)\n    asof=str(context_prices.index[-1].date())\n    strength=.5 if VARIANT=='event_half' else 1.\n    earnings=VARIANT!='event_macro'\n    future=pd.date_range(pd.Timestamp(start_time)+pd.Timedelta(minutes=1),periods=time_length//60,freq='1min')\n    table=get_profile(asset,asof,'America/New_York')\n    seasonal=seasonal_values(future,table,'America/New_York')\n    factors=event_variance_factors(asset,future,time_length,asof,events,strength,earnings)\n    k=time_increment//60\n    stepvar*=((seasonal*factors).reshape(-1,k).sum(axis=1)/seasonal.reshape(-1,k).sum(axis=1))\n    if VARIANT in ('event_clean','event_clean_half','event_clean_earnings'):\n        _,r,age=valid_returns(context_prices)\n        hseason=seasonal_values(context_prices.index[1:],table,'America/New_York')\n        normalized=r/np.sqrt(hseason)\n        hist=event_variance_factors(asset,context_prices.index[1:],time_length,asof,events,strength,earnings,VARIANT=='event_clean_earnings')\n        h1,h2=(60,720) if time_length<=3600 else (720,4320)\n        old=.75*ewma(normalized,age,h1)+.25*ewma(normalized,age,h2)\n        clean=.75*ewma(normalized/np.sqrt(hist),age,h1)+.25*ewma(normalized/np.sqrt(hist),age,h2)\n        ratio=np.clip(clean/max(old,1e-14),.15,1.)\n        stepvar*=np.sqrt(ratio) if VARIANT=='event_clean_half' else ratio\n    steps=time_length//time_increment+1\n    z=rng.normal(size=(num_simulations,steps))\n    z[:,0]=0\n    z[:,1:]*=np.sqrt(stepvar)*adjustment\n    paths=last*np.exp(np.cumsum(z,axis=1))\n    return (start_time,time_increment,*paths.tolist())\n\"\"\"Calendar-supplied holiday attenuation; trading itself never stops.\"\"\"\nfrom __future__ import annotations\n\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom calendar_models import calendar\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance, get_profile, seasonal_values\nfrom vol_models import valid_returns, ewma\n\nCONTEXT_DAYS = 7\nVARIANT = os.environ.get('SYNTH_RESEARCH_VARIANT', 'closure_full')\n\n\n@lru_cache(maxsize=1)\ndef fits():\n    return json.loads((Path(__file__).resolve().parent/'artifacts/closures.json').read_text())['fits']\n\n\ndef closure_factors(asset, index, asof, events, session_only=False):\n    idx = pd.DatetimeIndex(index)\n    factor = np.ones(len(idx))\n    if events is None or len(idx) == 0:\n        return factor\n    candidates = [d for d in fits() if d <= asof]\n    if not candidates:\n        return factor\n    rows = [r for r in fits()[max(candidates)] if r['asset'] == asset]\n    if not rows:\n        return factor\n    local = idx.tz_convert('America/New_York')\n    dates = np.asarray(local.date)\n    minutes = np.asarray(local.hour*60+local.minute)\n    selected = events[(events.time_utc >= idx[0]-pd.Timedelta(days=1)) &\n                      (events.time_utc <= idx[-1]+pd.Timedelta(days=1)) &\n                      events.event.str.startswith('NYSE')]\n    selected = selected[(selected.scope == 'all') | selected.scope.str.split(',').map(lambda names: asset in names)]\n    for event in selected.itertuples():\n        date = event.time_utc.tz_convert('America/New_York').date()\n        for row in rows:\n            if row['event'] != event.event:\n                continue\n            if session_only and (row['lo'] < 570 or row['hi'] > 960):\n                continue\n            mask = (dates == date) & (minutes >= row['lo']) & (minutes < row['hi'])\n            factor[mask] = np.minimum(factor[mask], row['amplitude']**2)\n    return factor\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    rng = np.random.default_rng(seed)\n    events = calendar()\n    last, stepvar = forecast_variance(asset, start_time, time_increment, time_length, context_prices)\n    adjustment = scale_adjustment(asset, start_time, time_length, context_prices, 'vol', 1.)\n    asof = str(context_prices.index[-1].date())\n    table = get_profile(asset, asof, 'America/New_York')\n    future = pd.date_range(pd.Timestamp(start_time)+pd.Timedelta(minutes=1), periods=time_length//60, freq='1min')\n    seasonal = seasonal_values(future, table, 'America/New_York')\n    factors = closure_factors(asset, future, asof, events, VARIANT == 'closure_session')\n    k = time_increment//60\n    stepvar *= (seasonal*factors).reshape(-1, k).sum(axis=1)/seasonal.reshape(-1, k).sum(axis=1)\n    if VARIANT == 'closure_clean':\n        _, r, age = valid_returns(context_prices)\n        hist = seasonal_values(context_prices.index[1:], table, 'America/New_York')\n        normal = r/np.sqrt(hist)\n        factors = closure_factors(asset, context_prices.index[1:], asof, events)\n        h1, h2 = (60, 720) if time_length <= 3600 else (720, 4320)\n        old = .75*ewma(normal, age, h1)+.25*ewma(normal, age, h2)\n        clean = .75*ewma(normal/np.sqrt(factors), age, h1)+.25*ewma(normal/np.sqrt(factors), age, h2)\n        stepvar *= np.clip(clean/max(old, 1e-14), 1., 3.)\n    shocks = rng.normal(size=(num_simulations, len(stepvar)+1))\n    shocks[:, 0] = 0.\n    shocks[:, 1:] *= np.sqrt(stepvar)*adjustment\n    paths = last*np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *paths.tolist())\n","exit_code":0,"status":"completed"}}
