{"type":"item.started","item":{"id":"item_468","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport os,sys,json,time\nimport numpy as np,pandas as pd\nsys.path.insert(0,'agent')\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices,context_slice\nfrom run_suite import ROOT\nfrom antithetic_models import simulate,antithetic_logpaths\nfrom candidate_models import candidate_forecast\nfrom integrated_models import draw_logpaths\nstart=pd.Timestamp('2026-11-07 13:17',tz='UTC')\nf=load_minute_prices(ROOT/'market_data','BTC',start-pd.Timedelta(days=7),start)\nrows=[]\nfor horizon,step in [(3600,60),(86400,300)]:\n c=context_slice(f,start,horizon,7)\n before=c.copy(deep=True)\n for count in [1,3,999,1000,1001]:\n  os.environ['SYNTH_BENCHMARK_SEED']='71031'\n  began=time.perf_counter();a=simulate('BTC',start.isoformat(),step,horizon,count,c);elapsed=time.perf_counter()-began\n  b=simulate('BTC',start.isoformat(),step,horizon,count,c)\n  x,y=np.asarray(a[2:]),np.asarray(b[2:])\n  assert x.shape==(count,horizon//step+1)\n  assert np.array_equal(x,y) and np.isfinite(x).all() and (x>0).all()\n  assert np.all(x[:,0]==c.close.dropna().iloc[-1])\n  os.environ['SYNTH_BENCHMARK_SEED']='71032'\n  d=simulate('BTC',start.isoformat(),step,horizon,count,c)\n  assert not np.array_equal(x,np.asarray(d[2:]))\n  pd.testing.assert_frame_equal(c,before)\n  rows.append({'horizon':horizon,'paths':count,'seconds':elapsed,'passed':True})\n _,v=candidate_forecast('BTC',start,step,horizon,c,shape=True,events=True)\n old=draw_logpaths(20261108,1000,v,step,mixture=.4)\n new=antithetic_logpaths(20261108,1000,v,.4)\n print(horizon,'maximum absolute log center in bps:',np.max(np.abs(old.mean(axis=0)))*1e4,'->',np.max(np.abs(new.mean(axis=0)))*1e4)\nPath=None\nfrom pathlib import Path\nPath('agent/results/antithetic_audit.json').write_text(json.dumps({'cases':rows,'seed_repeatable':True,'seed_changes_fan':True,'input_unchanged':True},indent=2)+'\\\\n')\nprint('Passed',len(rows),'cases; maximum seconds',max(r['seconds'] for r in rows))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
