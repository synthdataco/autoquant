{"type":"item.started","item":{"id":"item_365","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport sys,json\nfrom pathlib import Path\nimport numpy as np,pandas as pd\nsys.path.insert(0,'agent')\nfrom explore import load_asset\nfrom neural_features import one_sequences\nfrom synth_lib.benchmark.generate_predictions import context_slice\nresults=[]\nfor asset,h in [('BTC',3600),('BTC',86400),('AAPLX',86400)]:\n    start=pd.Timestamp('2026-10-07 15:07',tz='UTC')\n    frame=load_asset(asset)\n    context=context_slice(frame,start,h,7)\n    seq,numeric=one_sequences(asset,start,h,context)\n    with np.load(f'agent/cache/sequence_{asset}_{h}.npz') as stored:\n        index=np.flatnonzero(stored['start_ns']==start.value)[0]\n        differences=[float(np.max(np.abs(seq[j][0]-stored[f'seq{j}'][index]))) for j in range(3)]\n        numeric_difference=float(np.max(np.abs(numeric[0]-stored['numeric'][index])))\n    row={'asset':asset,'horizon':h,'sequence_max_differences':differences,'numeric_max_difference':numeric_difference}\n    print(row,flush=True)\n    assert max(differences)<2e-5\n    assert numeric_difference==0.\n    results.append(row)\nPath('agent/results/neural_feature_parity.json').write_text(json.dumps(results,indent=2)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
