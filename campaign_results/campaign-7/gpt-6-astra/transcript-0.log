{"type":"item.completed","item":{"id":"item_598","type":"command_execution","command":"/bin/bash -lc 'cat agent/direction_models.py agent/measure_dependence.py agent/empirical_models.py'","aggregated_output":"\"\"\"Small conditional drift; all forecasts still depend on the given asset only.\"\"\"\nfrom __future__ import annotations\n\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport xgboost as xgb\n\nfrom ml_features import NAMES, one_features\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance\n\nCONTEXT_DAYS = 7\nVARIANT = os.environ.get('SYNTH_RESEARCH_VARIANT', 'direction_half')\nART = Path(__file__).resolve().parent/'artifacts/direction'\n\n\n@lru_cache(maxsize=1)\ndef manifest():\n    return json.loads((ART/'manifest.json').read_text())\n\n\n@lru_cache(maxsize=16)\ndef model(filename):\n    booster = xgb.Booster(params={'device': 'cpu', 'nthread': 1})\n    booster.load_model(ART/filename)\n    booster.set_param({'device': 'cpu', 'nthread': 1})\n    return booster\n\n\ndef mean_forecast(asset, start, horizon, context):\n    asof = str(context.index[-1].date())\n    fits = [f for f in manifest()['fits'] if f['cutoff'] <= asof and f['time_length'] == horizon]\n    if not fits:\n        return 0.\n    fit = max(fits, key=lambda f: f['cutoff'])\n    x, _ = one_features(asset, start, horizon, context)\n    x = x[[NAMES.index(n) for n in manifest()['features']]].reshape(1, -1)\n    x[~np.isfinite(x)] = np.nan\n    return float(model(fit['file']).inplace_predict(x)[0])\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    rng = np.random.default_rng(seed)\n    last, stepvar = forecast_variance(asset, start_time, time_increment, time_length, context_prices)\n    adjustment = scale_adjustment(asset, start_time, time_length, context_prices, 'vol', 1.)\n    mean = mean_forecast(asset, start_time, time_length, context_prices)\n    strength = .5 if VARIANT == 'direction_half' else 1.\n    endpoint = strength*np.clip(mean, -.3*adjustment, .3*adjustment)*np.sqrt(stepvar.sum())\n    curve = np.r_[0., np.cumsum(stepvar)/stepvar.sum()]\n    z = rng.normal(size=(num_simulations, len(stepvar)+1))\n    z[:, 0] = 0.\n    z[:, 1:] *= np.sqrt(stepvar)*adjustment\n    paths = last*np.exp(np.cumsum(z, axis=1)+endpoint*curve)\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"Descriptive horizon scaling and return dependence, without computing CRPS.\"\"\"\nfrom concurrent.futures import ProcessPoolExecutor\nimport os\nimport numpy as np\nimport pandas as pd\nfrom explore import load_asset\nfrom run_suite import ROOT,CRYPTO,OTHER\n\n\ndef measure(asset):\n    frame=load_asset(asset)\n    p=np.log(frame.close)\n    r=p.diff()\n    output=[]\n    for horizon in [1,5,30,60,180,1440]:\n        changes=p.diff(horizon)\n        rv=(r*r).rolling(horizon,min_periods=horizon).sum()\n        ratio=changes/np.sqrt(rv.where(rv>0))\n        data=pd.DataFrame({'r2':changes**2,'rv':rv,'abs_ratio':ratio.abs(),'ratio':ratio})\n        data=data.where(np.isfinite(data)).dropna()\n        for month,group in data.groupby(data.index.strftime('%Y-%m')):\n            output.append({'asset':asset,'month':month,'horizon':horizon,'n':len(group),\n                           'variance_ratio':group.r2.sum()/group.rv.sum(),\n                           'absolute_efficiency':group.abs_ratio.mean()*np.sqrt(np.pi/2),\n                           'q95_abs_ratio':group.abs_ratio.quantile(.95)})\n    return pd.DataFrame(output)\n\n\nif __name__=='__main__':\n    os.chdir(ROOT)\n    with ProcessPoolExecutor(max_workers=2) as pool:\n        data=pd.concat(list(pool.map(measure,CRYPTO+OTHER)),ignore_index=True)\n    data.to_csv(ROOT/'agent/results/descriptive/dependence.csv',index=False)\n    view=data[data.month>='2026-06'].groupby(['asset','horizon'])[['variance_ratio','absolute_efficiency']].median()\n    print(view.round(4).to_string())\n\"\"\"Symmetric, context-derived innovation laws with a learned forecast scale.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport numpy as np\nimport pandas as pd\nfrom scipy.special import ndtr\n\nfrom ml_features import finite_ewm\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance, get_profile, seasonal_values\n\nCONTEXT_DAYS = 7\nVARIANT = os.environ.get('SYNTH_RESEARCH_VARIANT', 'empirical_standard')\n\n\ndef empirical_quantiles(asset, start, step, context, uniforms, standardize=True):\n    # A regular index makes absent rows explicit NaNs. No prices are filled.\n    index = pd.date_range(context.index[0], context.index[-1], freq='1min')\n    frame = context.reindex(index)\n    p = np.asarray(frame.close, dtype=float)\n    good = np.isfinite(p) & (p > 0)\n    logp = np.full(len(p), np.nan)\n    np.log(p, out=logp, where=good)\n    k = step//60\n    r = np.r_[np.full(k, np.nan), logp[k:]-logp[:-k]]\n    complete = pd.Series(good.astype(float)).rolling(k+1, min_periods=k+1).sum().to_numpy() == k+1\n    r[~complete] = np.nan\n    table = get_profile(asset, str(context.index[-1].date()), 'America/New_York')\n    season = seasonal_values(index, table, 'America/New_York')\n    r /= np.sqrt(pd.Series(season).rolling(k, min_periods=k).sum().to_numpy())\n    phase = pd.Timestamp(start).minute % k\n    select = np.flatnonzero(np.asarray(index.minute) % k == phase)\n    values = r[select]\n    if standardize:\n        prior = np.sqrt(finite_ewm(values*values, 720/k, len(values)))\n        prior = np.r_[np.nan, prior[:-1]]\n        values = values/np.maximum(prior, 1e-7)\n        values = np.clip(values, -15., 15.)\n    ages = np.asarray((index[-1]-index[select]).total_seconds())/60\n    use = np.isfinite(values)\n    values, ages = values[use], ages[use]\n    if len(values) < 60:\n        return None\n    weights = np.exp2(-ages/4320)\n    # Symmetry keeps the conditional center at zero and preserves the atom\n    # from real flat candles. This is a distribution, not a price-gap repair.\n    values = np.r_[values, -values]\n    weights = np.tile(weights, 2)\n    mean_abs = np.sum(weights*np.abs(values))/weights.sum()\n    if mean_abs < 1e-12:\n        return None\n    values *= np.sqrt(2/np.pi)/mean_abs\n    order = np.argsort(values)\n    values, weights = values[order], weights[order]\n    coordinates = (np.cumsum(weights)-.5*weights)/weights.sum()\n    return np.interp(uniforms, coordinates, values)\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    rng = np.random.default_rng(seed)\n    last, stepvar = forecast_variance(asset, start_time, time_increment, time_length, context_prices)\n    adjustment = scale_adjustment(asset, start_time, time_length, context_prices, 'vol', 1.)\n    normal = rng.normal(size=(num_simulations, len(stepvar)+1))\n    z = empirical_quantiles(asset, start_time, time_increment, context_prices,\n                            ndtr(normal), standardize=VARIANT != 'empirical_raw')\n    if z is None:\n        z = normal\n    if VARIANT == 'empirical_mix':\n        eta = .4\n        z *= np.exp(eta*rng.normal(size=num_simulations)-.5*eta*eta)[:, None]\n    z[:, 0] = 0.\n    z[:, 1:] *= np.sqrt(stepvar)*adjustment\n    paths = last*np.exp(np.cumsum(z, axis=1))\n    return (start_time, time_increment, *paths.tolist())\n","exit_code":0,"status":"completed"}}
