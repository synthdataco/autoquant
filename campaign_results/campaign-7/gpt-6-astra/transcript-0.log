{"type":"item.completed","item":{"id":"item_416","type":"command_execution","command":"/bin/bash -lc 'cat agent/combined_models.py agent/ml_models.py && tail -8 agent/results/neural_raw_dev.log'","aggregated_output":"\"\"\"Mean-absolute-scale preserving distribution ablations over learned forecasts.\"\"\"\nfrom __future__ import annotations\nfrom math import gamma,pi,sqrt\nimport os\nimport numpy as np\nfrom scipy.special import ndtri\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance\n\nCONTEXT_DAYS=7\nVARIANT=os.environ.get('SYNTH_RESEARCH_VARIANT','combo_mix40')\n\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    rng=np.random.default_rng(seed)\n    last,stepvar=forecast_variance(asset,start_time,time_increment,time_length,context_prices)\n    adjustment=scale_adjustment(asset,start_time,time_length,context_prices,'vol',1.)\n    steps=time_length//time_increment+1\n    if VARIANT in ('combo_t3','combo_t5','combo_t8'):\n        df=int(VARIANT[7:])\n        t_abs=2*sqrt(df)*gamma((df+1)/2)/((df-1)*sqrt(pi)*gamma(df/2))\n        z=rng.standard_t(df,size=(num_simulations,steps))*sqrt(2/pi)/t_abs\n    elif VARIANT=='combo_antithetic':\n        raw=rng.normal(size=((num_simulations+1)//2,steps))\n        z=np.concatenate([raw,-raw],axis=0)[:num_simulations]\n    elif 'lhs' in VARIANT:\n        quantiles=ndtri((np.arange(num_simulations)+.5)/num_simulations)\n        z=rng.permuted(np.broadcast_to(quantiles[:,None],(num_simulations,steps)),axis=0)\n    else:\n        z=rng.normal(size=(num_simulations,steps))\n    if 'mix' in VARIANT:\n        eta=int(VARIANT.split('mix')[1].split('_')[0])/100\n        factors=rng.permutation(quantiles) if 'lhs' in VARIANT else rng.normal(size=num_simulations)\n        z*=np.exp(eta*factors-.5*eta*eta)[:,None]\n    z[:,0]=0\n    z[:,1:]*=np.sqrt(stepvar)*adjustment\n    paths=last*np.exp(np.cumsum(z,axis=1))\n    return (start_time,time_increment,*paths.tolist())\n\"\"\"Learned scale adjustment; seasonal Gaussian paths otherwise unchanged.\"\"\"\nfrom __future__ import annotations\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport xgboost as xgb\nfrom ml_features import NAMES, one_features\nfrom seasonal_models import forecast_variance\n\nCONTEXT_DAYS=7\nVARIANT=os.environ.get('SYNTH_RESEARCH_VARIANT','ml_vol')\nARTIFACTS=Path(__file__).resolve().parent/'artifacts/ml'\n\n@lru_cache(maxsize=1)\ndef manifest():\n    return json.loads((ARTIFACTS/'manifest.json').read_text())\n\n@lru_cache(maxsize=32)\ndef booster(filename):\n    model=xgb.Booster(params={'device':'cpu','nthread':1})\n    model.load_model(ARTIFACTS/filename)\n    model.set_param({'device':'cpu','nthread':1})\n    return model\n\ndef scale_adjustment(asset,start_time,time_length,context,kind='vol',blend=1.0):\n    date=str(context.index[-1].date())\n    fits=[x for x in manifest()['fits'] if x['cutoff']<=date and x['time_length']==time_length and x['kind']==kind]\n    if not fits:\n        return 1.0\n    fit=max(fits,key=lambda x:x['cutoff'])\n    x,_=one_features(asset,start_time,time_length,context)\n    x=x[[NAMES.index(k) for k in fit['features']]].reshape(1,-1)\n    x[~np.isfinite(x)]=np.nan\n    prediction=float(booster(fit['file']).inplace_predict(x)[0])\n    return float(np.exp(blend*np.clip(prediction,np.log(.25),np.log(3.0))))\n\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    rng=np.random.default_rng(seed)\n    last,stepvar=forecast_variance(asset,start_time,time_increment,time_length,context_prices)\n    kind='full' if 'full' in VARIANT else 'vol'\n    blend=.5 if 'blend' in VARIANT else 1.\n    adjustment=scale_adjustment(asset,start_time,time_length,context_prices,kind,blend)\n    steps=time_length//time_increment+1\n    z=rng.normal(size=(num_simulations,steps))\n    z[:,0]=0\n    z[:,1:]*=np.sqrt(stepvar)*adjustment\n    paths=last*np.exp(np.cumsum(z,axis=1))\n    return (start_time,time_increment,*paths.tolist())\nSPCX   86400 2026-08-24 CRPS=3896.16580 n=84 s/prompt=0.077\nSP500  86400 2026-08-24 CRPS=676.70486 n=84 s/prompt=0.080\nXAU    86400 2026-10-12 CRPS=1119.75000 n=84 s/prompt=0.071\nNVDAX  86400 2026-10-12 CRPS=1467.39950 n=84 s/prompt=0.071\nGOOGLX 86400 2026-10-12 CRPS=1321.50009 n=84 s/prompt=0.071\nTSLAX  86400 2026-10-12 CRPS=1578.64203 n=84 s/prompt=0.073\nAAPLX  86400 2026-10-12 CRPS=1172.98186 n=84 s/prompt=0.069\nWTIOIL 86400 2026-10-12 CRPS=2791.72838 n=84 s/prompt=0.070\n","exit_code":0,"status":"completed"}}
{"type":"item.started","item":{"id":"item_417","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport sys,pandas as pd,numpy as np\nsys.path.insert(0,'agent')\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices,context_slice\nfrom run_suite import ROOT\nfrom seasonal_models import forecast_variance,get_profile,seasonal_values\nfrom ml_models import scale_adjustment\nfrom vol_models import valid_returns,ewma\ncases=[('HYPE','2026-09-17 13:21',3600),('XRP','2026-08-27 08:01',3600),('SOL','2026-08-22 05:19',3600)]\nfor asset,t,h in cases:\n    start=pd.Timestamp(t,tz='UTC')\n    f=load_minute_prices(ROOT/'market_data',asset,start-pd.Timedelta(days=7),start+pd.Timedelta(seconds=h))\n    c=context_slice(f,start,h,7)\n    last,r,age=valid_returns(c)\n    tab=get_profile(asset,str(c.index[-1].date()),'America/New_York')\n    z=r/np.sqrt(seasonal_values(c.index[1:],tab,'America/New_York'))\n    fast,slow=ewma(z,age,60),ewma(z,age,720)\n    av=.75*ewma(z,age,60,True)+.25*ewma(z,age,720,True)\n    _,v=forecast_variance(asset,start,60,h,c)\n    adj=scale_adjustment(asset,start,h,c,'vol',1.)\n    future=f.close.loc[start:start+pd.Timedelta(seconds=h)]\n    target=np.log(future).diff().abs().mean()*np.sqrt(np.pi/2)*1e4\n    w=np.exp2(-age/60); w[~np.isfinite(z)]=0\n    contrib=np.nan_to_num(w*z*z); total=contrib.sum()\n    top=np.argsort(contrib)[-5:][::-1]\n    print(asset,start,'pred_bps',np.sqrt(v).mean()*adj*1e4,'actual_abs_bps',target,'mladj',adj,'absolute/RMS',np.sqrt(av/(.75*fast+.25*slow)))\n    print(pd.DataFrame({'time':c.index[1:][top],'return_bps':r[top]*1e4,'fast_variance_share':contrib[top]/total}).round(4).to_string(index=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
