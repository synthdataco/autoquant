{"type":"item.completed","item":{"id":"item_436","type":"command_execution","command":"/bin/bash -lc 'cat agent/plot_research.py && cat agent/profile_models.py'","aggregated_output":"\"\"\"Publication artifacts from saved official scores, without rescoring paths.\"\"\"\nfrom __future__ import annotations\n\nimport matplotlib\nmatplotlib.use('Agg')\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport pandas as pd\n\nfrom compare import load\nfrom run_suite import ROOT\n\n\ndef main():\n    dest = ROOT/'agent/figures'\n    dest.mkdir(parents=True, exist_ok=True)\n    plt.rcParams.update({'font.size': 11, 'axes.spines.top': False, 'axes.spines.right': False})\n    configurations = [('crypto24', 'Crypto · 24 hours'), ('other24', 'Commodities/equities · 24 hours'),\n                      ('crypto1', 'Crypto · 1 hour')]\n    models = [('season_ny', 'Seasonal EWMA'), ('ml_vol', 'Learned volatility')]\n    fig, axes = plt.subplots(1, 3, figsize=(12.8, 4.1), sharey=True, layout='constrained')\n    for ax, (config, title) in zip(axes, configurations):\n        for j, (suffix, label, color) in enumerate([('dev', 'Development', '#246B8E'), ('confirm', 'Confirmation', '#D58C32')]):\n            baseline = load('baseline_'+suffix).groupby('config').crps.mean()[config]\n            values = [100*(1-load(tag+'_'+suffix).groupby('config').crps.mean()[config]/baseline) for tag, _ in models]\n            x = np.arange(len(models))+(j-.5)*.34\n            bars = ax.bar(x, values, width=.32, label=label, color=color)\n            ax.bar_label(bars, fmt='%.2f%%', padding=3, fontsize=9)\n        ax.set_title(title)\n        ax.set_xticks(np.arange(len(models)), [label for _, label in models])\n        ax.grid(axis='y', alpha=.18)\n        ax.set_axisbelow(True)\n    axes[0].set_ylabel('CRPS reduction from the seeded starter (%)')\n    axes[0].legend(frameon=False)\n    fig.suptitle('Predictable seasonality is the largest durable improvement', fontsize=14)\n    fig.savefig(dest/'core_improvements.png', dpi=180)\n    fig.savefig(dest/'core_improvements.svg')\n    plt.close(fig)\n\n    data = pd.read_csv(ROOT/'agent/results/closures/crps_by_date.csv')\n    fig, ax = plt.subplots(figsize=(8.4, 4.2), layout='constrained')\n    bars = ax.bar(data.event_date, -data.pct, color='#246B8E', width=.6)\n    ax.bar_label(bars, fmt='%.2f%%', padding=3)\n    ax.set_ylim(0, 13)\n    ax.set_ylabel('CRPS reduction on closure-centered prompts (%)')\n    ax.set_xlabel('Supplied-calendar closure date')\n    ax.set_title('Holiday attenuation helps on every tested closure date')\n    ax.grid(axis='y', alpha=.18)\n    ax.set_axisbelow(True)\n    fig.savefig(dest/'closure_results.png', dpi=180)\n    fig.savefig(dest/'closure_results.svg')\n    plt.close(fig)\n    print('Wrote four PNG/SVG figure artifacts')\n\n\nif __name__ == '__main__':\n    main()\n\"\"\"Profile resolution, robustness and weekday pooling over a fixed ML correction.\"\"\"\nfrom __future__ import annotations\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom seasonal_models import seasonal_values\nfrom ml_models import scale_adjustment\nfrom vol_models import valid_returns,ewma\n\nCONTEXT_DAYS=7\nVARIANT=os.environ.get('SYNTH_RESEARCH_VARIANT','prof_abs')\n\n@lru_cache(maxsize=8)\ndef load_artifact(filename):\n    return json.loads((Path(__file__).resolve().parent/'artifacts'/filename).read_text())\n\n@lru_cache(maxsize=1024)\ndef table_for(asset,asof,variant):\n    filename={'prof_abs':'seasonality_abs.json','prof_5m':'seasonality_5m.json','prof_abs5m':'seasonality_abs5m.json'}.get(variant,'seasonality.json')\n    data=load_artifact(filename)\n    fits=data['assets'].get(asset,{})\n    dates=[d for d in fits if d<=asof]\n    if not dates:\n        return np.ones((7,data['bins']))\n    fit=fits[max(dates)]['clocks']['America/New_York']\n    raw=np.asarray(fit['raw'],dtype=float)\n    counts=np.asarray(fit['counts'],dtype=float)\n    individual={'prof_raw70':.7,'prof_raw100':1.}.get(variant,.35)\n    base=raw.copy()\n    groups=[slice(0,4)] if variant=='prof_week' else [slice(0,5),slice(5,7)]\n    for days in groups:\n        num=(raw[days]*counts[days]).sum(axis=0)\n        den=counts[days].sum(axis=0)\n        common=np.divide(num,den,out=np.ones_like(num),where=den>0)\n        base[days]=individual*raw[days]+(1-individual)*common\n    flat=base.ravel()\n    flat=.8*flat+.1*np.roll(flat,1)+.1*np.roll(flat,-1)\n    flat=np.clip(flat,.015,20)\n    return (flat/flat.mean()).reshape(raw.shape)\n\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    rng=np.random.default_rng(seed)\n    last,r,age=valid_returns(context_prices)\n    tab=table_for(asset,str(context_prices.index[-1].date()),VARIANT)\n    r=r/np.sqrt(seasonal_values(context_prices.index[1:],tab,'America/New_York'))\n    h1,h2=(60,720) if time_length<=3600 else (720,4320)\n    var=.75*ewma(r,age,h1)+.25*ewma(r,age,h2)\n    future=pd.date_range(pd.Timestamp(start_time)+pd.Timedelta(minutes=1),periods=time_length//60,freq='1min')\n    seasonal=seasonal_values(future,tab,'America/New_York')\n    stepvar=max(var,1e-14)*seasonal.reshape(-1,time_increment//60).sum(axis=1)\n    adjustment=scale_adjustment(asset,start_time,time_length,context_prices,'vol',1.)\n    z=rng.normal(size=(num_simulations,time_length//time_increment+1))\n    z[:,0]=0\n    z[:,1:]*=np.sqrt(stepvar)*adjustment\n    paths=last*np.exp(np.cumsum(z,axis=1))\n    return (start_time,time_increment,*paths.tolist())\n","exit_code":0,"status":"completed"}}
