{"type":"item.completed","item":{"id":"item_529","type":"command_execution","command":"/bin/bash -lc 'cat agent/modeling.py agent/candidate_models.py agent/audit_interface.py'","aggregated_output":"\"\"\"Current checkpoint: causal seasonal volatility with a learned scale.\n\nOnly artifacts trained before the context endpoint are selected. Current prices\ncome solely from the supplied context frame.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport numpy as np\nfrom ml_models import scale_adjustment\nfrom seasonal_models import forecast_variance\n\n# Days of minute history simulate() receives as context_prices: a plain int from 3 to 30.\nCONTEXT_DAYS = 7\n\n\ndef simulate(\n    asset: str,\n    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    seed = int(os.environ.get(\"SYNTH_BENCHMARK_SEED\", \"20261108\"))\n    rng = np.random.default_rng(seed)\n    last, stepvar = forecast_variance(asset, start_time, time_increment,\n                                     time_length, context_prices)\n    adjustment = scale_adjustment(asset, start_time, time_length,\n                                  context_prices, \"vol\", 1.0)\n    steps = time_length // time_increment + 1\n    shocks = rng.normal(size=(num_simulations, steps))\n    shocks[:, 0] = 0.0\n    shocks[:, 1:] *= np.sqrt(stepvar) * adjustment\n    paths = last * np.exp(np.cumsum(shocks, axis=1))\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"Candidate ablations: original state, separate future shape, and calendars.\"\"\"\nfrom __future__ import annotations\n\nimport os\nimport numpy as np\nimport pandas as pd\n\nfrom calendar_models import calendar, event_variance_factors\nfrom closure_models import closure_factors\nfrom integrated_models import draw_logpaths\nfrom ml_models import scale_adjustment\nfrom profile_models import table_for\nfrom seasonal_models import forecast_variance, get_profile, seasonal_values\nfrom separated_models import separated_forecast\n\nCONTEXT_DAYS = 7\nVARIANT = os.environ.get('SYNTH_RESEARCH_VARIANT', 'candidate_calendar')\nCRYPTO = frozenset(['BTC', 'ETH', 'SOL', 'XRP', 'HYPE'])\n\n\ndef candidate_forecast(asset, start, step, horizon, context, *, shape=True, events=True,\n                       profile_variant='prof_abs5m'):\n    use_shape = shape and horizon == 86400 and asset not in CRYPTO\n    if use_shape:\n        last, stepvar = separated_forecast(asset, start, step, horizon, context, 'separate_future', profile_variant)\n    else:\n        last, stepvar = forecast_variance(asset, start, step, horizon, context)\n        adjustment = scale_adjustment(asset, start, horizon, context, 'vol', 1.)\n        stepvar *= adjustment**2\n    if events:\n        supplied = calendar()\n        if supplied is not None:\n            asof = str(context.index[-1].date())\n            table = (table_for(asset, asof, profile_variant) if use_shape else\n                     get_profile(asset, asof, 'America/New_York'))\n            future = pd.date_range(pd.Timestamp(start)+pd.Timedelta(minutes=1),\n                                   periods=horizon//60, freq='1min')\n            seasonal = seasonal_values(future, table, 'America/New_York')\n            factors = event_variance_factors(asset, future, horizon, asof, supplied)\n            factors *= closure_factors(asset, future, asof, supplied)\n            k = step//60\n            stepvar *= ((seasonal*factors).reshape(-1, k).sum(axis=1) /\n                        seasonal.reshape(-1, k).sum(axis=1))\n    return last, stepvar\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    last, stepvar = candidate_forecast(asset, start_time, time_increment, time_length, context_prices,\n                                       shape=VARIANT != 'candidate_basic',\n                                       events=VARIANT == 'candidate_calendar')\n    logpaths = draw_logpaths(seed, num_simulations, stepvar, time_increment, mixture=.4)\n    paths = last*np.exp(logpaths)\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"Serving-contract, determinism, gap and latency audit against the real snapshot.\"\"\"\nfrom __future__ import annotations\nimport importlib\nimport json\nimport os\nfrom pathlib import Path\nimport socket\nfrom time import perf_counter\nimport numpy as np\nimport pandas as pd\n\nfrom synth_lib.benchmark.generate_predictions import context_days_of,context_slice,load_minute_prices\nfrom run_suite import ROOT,CRYPTO,OTHER\n\n\ndef main():\n    os.chdir(ROOT)\n    model=importlib.import_module(os.environ.get('AUDIT_MODULE','modeling'))\n    days=context_days_of(model)\n    start=pd.Timestamp('2026-11-07 13:17',tz='UTC')\n    rows=[]\n    def no_network(*args,**kwargs):\n        raise AssertionError('Serving attempted a network connection')\n    socket.socket.connect=no_network\n    os.environ['SYNTH_BENCHMARK_SEED']='71031'\n    for asset in CRYPTO+OTHER:\n        prices=load_minute_prices(ROOT/'market_data',asset,start-pd.Timedelta(days=days),start)\n        for horizon,step in ([(86400,300),(3600,60)] if asset in CRYPTO else [(86400,300)]):\n            raw=context_slice(prices,start,horizon,days)\n            cases={'normal':raw.copy(),'three_real_days':raw.copy(),'internal_two_day_gap':raw.copy(),'trailing_three_hour_gap':raw.copy()}\n            cases['three_real_days'].loc[cases['three_real_days'].index<start-pd.Timedelta(days=3),:]=np.nan\n            gap=(raw.index>=start-pd.Timedelta(days=4))&(raw.index<start-pd.Timedelta(days=2))\n            cases['internal_two_day_gap'].loc[gap,:]=np.nan\n            cases['trailing_three_hour_gap'].iloc[-180:,:]=np.nan\n            for case,context in cases.items():\n                before=context.copy(deep=True)\n                began=perf_counter()\n                out=model.simulate(asset,start.isoformat(),step,horizon,1000,context)\n                elapsed=perf_counter()-began\n                paths=np.asarray(out[2:],dtype=float)\n                assert paths.shape==(1000,horizon//step+1),(asset,case,paths.shape)\n                assert all(isinstance(p,list) for p in out[2:])\n                assert np.isfinite(paths).all() and (paths>0).all(),(asset,case,'nonfinite')\n                assert np.all(paths[:,0]==float(context.close.dropna().iloc[-1]))\n                assert out[0]==start.isoformat() and out[1]==step\n                pd.testing.assert_frame_equal(before,context)\n                assert elapsed<5,(asset,case,'slow',elapsed)\n                rows.append({'asset':asset,'time_length':horizon,'case':case,'seconds':elapsed,'paths':len(paths),'passed':True})\n            # An arbitrary odd path count and two different seeds detect hidden\n            # hardcoding without confusing reproducibility with identical fans.\n            a=model.simulate(asset,start.isoformat(),step,horizon,17,raw)\n            b=model.simulate(asset,start.isoformat(),step,horizon,17,raw)\n            assert len(a)==19 and np.array_equal(np.asarray(a[2:]),np.asarray(b[2:]))\n            os.environ['SYNTH_BENCHMARK_SEED']='71032'\n            c=model.simulate(asset,start.isoformat(),step,horizon,17,raw)\n            assert not np.array_equal(np.asarray(a[2:]),np.asarray(c[2:]))\n            os.environ['SYNTH_BENCHMARK_SEED']='71031'\n    out=ROOT/'agent/results/interface_audit.json'\n    out.write_text(json.dumps({'module':model.__name__,'context_days':days,'cases':rows,\n                               'seed_repeatability':True,'seed_changes_fan':True,'odd_path_count':17,\n                               'network_blocked':True,'max_seconds':max(r['seconds'] for r in rows)},indent=2)+'\\n')\n    print('Passed',len(rows),'1000-path cases, all 18 asset/configurations, odd counts, seed reproducibility, no input mutation and offline serving.')\n    print('Max seconds',max(r['seconds'] for r in rows))\n\nif __name__=='__main__':\n    main()\n","exit_code":0,"status":"completed"}}
