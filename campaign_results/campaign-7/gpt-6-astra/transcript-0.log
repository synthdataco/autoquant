{"type":"item.started","item":{"id":"item_444","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport sys,json\nimport pandas as pd,numpy as np\nfrom pathlib import Path\nsys.path.insert(0,'agent')\nfrom explore import load_asset\nfrom run_suite import CRYPTO,OTHER\nrows=[]\nfor a in CRYPTO+OTHER:\n f=load_asset(a)\n for name,start in [('all','2025-08-01'),('reported_baseline','2026-07-01')]:\n  c=f.loc[start:'2026-11-08']\n  p=c.close.to_numpy(dtype=float)\n  good=np.isfinite(p)&(p>0)\n  inside=good.argmax()<=np.arange(len(p))\n  inside &= np.arange(len(p))<=len(p)-1-good[::-1].argmax()\n  gaps=np.asarray((c.index[1:]-c.index[:-1]).total_seconds())\"'!=60\n  rows.append({'\"'asset':a,'period':name,'rows':len(c),'missing_closes':int((~good).sum()),'internal_bad_closes':int((~good&inside).sum()),'timestamp_gaps':int(gaps.sum())})\nprint(pd.DataFrame(rows).to_string(index=False))\nPath('agent/results/price_grid_audit.json').write_text(json.dumps(rows,indent=2)+'\\\\n')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
