{"type":"item.started","item":{"id":"item_461","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nfrom pathlib import Path\nimport sys,pandas as pd,numpy as np\nsys.path.insert(0,'agent')\nfrom ml_features import NAMES\nrows=[]\nfor original in sorted(Path('agent/cache').glob('ml_*.parquet')):\n new=original.with_name(original.name.replace('ml_','mlrisk_',1))\n if not new.exists():continue\n a,b=pd.read_parquet(original),pd.read_parquet(new)\n assert a[['start_time','label_end','asset','time_length']].equals(b[['start_time','label_end','asset','time_length']])\n assert np.array_equal(a[NAMES+['base_sigma']].to_numpy(),b[NAMES+['base_sigma']].to_numpy(),equal_nan=True)\n ratio=b.target_ratio/a.target_ratio\n rows.append({'asset':a.asset.iloc[0],'horizon':int(a.time_length.iloc[0]),'rows':len(a),'feature_max_difference':0.,'new_to_old_target_median':ratio.median(),'new_to_old_target_q10':ratio.quantile(.1),'new_to_old_target_q90':ratio.quantile(.9)})\nr=pd.DataFrame(rows)\nr.to_csv('agent/results/risk_label_parity.csv',index=False)\nprint(r.round(5).to_string(index=False))\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
