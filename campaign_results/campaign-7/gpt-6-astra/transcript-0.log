{"type":"item.started","item":{"id":"item_708","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport sys\nsys.path.insert(0,'agent')\nimport numpy as np\nimport pandas as pd\nimport modeling,combined_checkpoint,gaussian_checkpoint,cold_models\nfrom synth_lib.benchmark.generate_predictions import context_slice,load_minute_prices\nfrom synth_lib.preparation.config import MARKET_DATA_DIR\nstart=pd.Timestamp('2026-11-07 13:17',tz='UTC')\nfor asset,horizon,step in [('BTC',3600,60),('BTC',86400,300),('XAU',86400,300)]:\n frame=load_minute_prices(MARKET_DATA_DIR,asset,start-pd.Timedelta(days=7),start)\n context=context_slice(frame,start,horizon,7)\n a=modeling.simulate(asset,start.isoformat(),step,horizon,1000,context)\n b=combined_checkpoint.simulate(asset,start.isoformat(),step,horizon,1000,context)\n np.testing.assert_array_equal(np.asarray(a[2:]),np.asarray(b[2:]))\n c=gaussian_checkpoint.simulate(asset,start.isoformat(),step,horizon,1000,context)\n d=cold_models.simulate(asset,start.isoformat(),step,horizon,1000,context)\n np.testing.assert_array_equal(np.asarray(c[2:]),np.asarray(d[2:]))\nprint('Both frozen references reproduce their original formulas exactly in three 1000-path cases.')\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
