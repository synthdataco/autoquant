{"type":"item.started","item":{"id":"item_268","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport os,sys,numpy as np,pandas as pd\nsys.path.insert(0,'agent')\nfrom explore import load_asset\nfrom synth_lib.benchmark.generate_predictions import context_slice\nfrom sampling_models import simulate\nos.environ['SYNTH_RESEARCH_VARIANT']='sobol_rank_bridge_mix'\nimport sampling_models\nsampling_models.VARIANT='sobol_rank_bridge_mix'\nf=load_asset('BTC')\nt=pd.Timestamp('2026-11-05 09:17',tz='UTC')\nc=context_slice(f,t,3600,7)\nrows=[]\nfor n in [1,3,999,1000,1001]:\n    os.environ['SYNTH_BENCHMARK_SEED']='91117'\n    a=simulate('BTC',t,60,3600,n,c)\n    b=simulate('BTC',t,60,3600,n,c)\n    os.environ['SYNTH_BENCHMARK_SEED']='91118'\n    d=simulate('BTC',t,60,3600,n,c)\n    x=np.asarray(a[2:])\n    row={'paths':n,'shape':list(x.shape),'finite':bool(np.isfinite(x).all()),'positive':bool((x>0).all()),'start_correct':bool((x[:,0]==c.close.dropna().iloc[-1]).all()),'repeat':bool(np.array_equal(x,np.asarray(b[2:]))),'seed_changes':bool(not np.array_equal(x,np.asarray(d[2:])))}\n    assert all(row[k] for k in ['finite','positive','start_correct','repeat','seed_changes'])\n    assert x.shape==(n,61)\n    rows.append(row)\nfrom pathlib import Path\nimport json\nPath('agent/results/sampling_audit.json').write_text(json.dumps(rows,indent=2)+'\\\\n')\nprint('Sobol mixture passed count, finite, positive, start-price and seed checks at counts',[x['paths'] for x in rows])\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
