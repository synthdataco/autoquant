{"type":"item.completed","item":{"id":"item_755","type":"command_execution","command":"/bin/bash -lc 'cat agent/summarize_research.py agent/validate_results.py agent/run_suite.py'","aggregated_output":"\"\"\"Compact registry of completed suites, aggregating official saved CRPS only.\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport pandas as pd\nfrom run_suite import ROOT, CRYPTO, OTHER\n\n\ndef main():\n    rows = []\n    for file in sorted((ROOT/'agent/results').glob('*/suite.json')):\n        summaries = json.loads(file.read_text())\n        if any('error' in r for r in summaries):\n            continue\n        for name, horizon, assets in [('CRYPTO_24H', 86400, CRYPTO),\n                                      ('COM_EQU_24H', 86400, OTHER),\n                                      ('CRYPTO_1H', 3600, CRYPTO)]:\n            subset = [r for r in summaries if r['time_length'] == horizon and r['asset'] in assets]\n            if not subset:\n                continue\n            n = sum(r['num_prompts'] for r in subset)\n            rows.append({'tag': file.parent.name, 'configuration': name,\n                         'mean_crps': sum(r['mean_crps']*r['num_prompts'] for r in subset)/n,\n                         'prompts': n, 'asset_windows': len(subset),\n                         'ends': ','.join(sorted(set(r['eval_end'] for r in subset))),\n                         'paths': ','.join(sorted(set(str(r['num_simulations']) for r in subset))),\n                         'seed': ','.join(sorted(set(str(r.get('benchmark_seed', '20261108')) for r in subset))),\n                         'context_days': ','.join(sorted(set(str(r['context_days']) for r in subset))),\n                         'field_times': all(r.get('field_times', False) for r in subset),\n                         'generation_seconds_per_prompt': sum(r['generation_seconds'] for r in subset)/n})\n    out = pd.DataFrame(rows)\n    out.to_csv(ROOT/'agent/results/research_registry.csv', index=False)\n    print('Saved', len(out), 'configuration results from', out.tag.nunique(), 'complete suites')\n\n\nif __name__ == '__main__':\n    main()\n\"\"\"Audit saved official outputs for omissions, sentinels and invalid scores.\"\"\"\nfrom __future__ import annotations\n\nimport json\nimport numpy as np\nimport pandas as pd\nfrom run_suite import ROOT\n\n\ndef main():\n    files, prompts, issues = 0, 0, []\n    for suite in sorted((ROOT/'agent/results').glob('*/suite.json')):\n        rows = json.loads(suite.read_text())\n        if any('error' in r for r in rows):\n            issues.append({'suite': suite.parent.name, 'error': 'failed subprocess in suite'})\n            continue\n        for path in sorted(suite.parent.glob('*.parquet')):\n            summary = json.loads(path.with_suffix('.json').read_text())\n            frame = pd.read_parquet(path)\n            id_col = 'miner_id' if 'miner_id' in frame else ('miner_uid' if 'miner_uid' in frame else None)\n            if id_col:\n                frame = frame[frame[id_col] == 999]\n            invalid = int((~np.isfinite(frame.crps.to_numpy()) | (frame.crps.to_numpy() < 0)).sum())\n            if invalid or len(frame) != summary['num_prompts']:\n                issues.append({'file': str(path.relative_to(ROOT)), 'rows': len(frame),\n                               'summary_prompts': summary['num_prompts'], 'invalid_scores': invalid})\n            files += 1\n            prompts += len(frame)\n    result = {'completed_result_files': files, 'official_candidate_scores': prompts, 'issues': issues}\n    (ROOT/'agent/results/result_audit.json').write_text(json.dumps(result, indent=2)+'\\n')\n    print(json.dumps(result, indent=2))\n    if issues:\n        raise SystemExit(1)\n\n\nif __name__ == '__main__':\n    main()\n\"\"\"Bounded parallel runs of predict.py; every score uses synth-lib's backtester.\"\"\"\nfrom __future__ import annotations\n\nimport argparse\nfrom concurrent.futures import ThreadPoolExecutor, as_completed\nimport json\nimport os\nfrom pathlib import Path\nimport subprocess\nimport sys\n\nROOT = Path(__file__).resolve().parent.parent\nCRYPTO = [\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"]\nOTHER = [\"XAU\", \"NVDAX\", \"GOOGLX\", \"TSLAX\", \"AAPLX\", \"WTIOIL\", \"SPCX\", \"SP500\"]\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--model\", default=\"modeling\")\n    ap.add_argument(\"--tag\", required=True)\n    ap.add_argument(\"--ends\", nargs=\"+\", default=[\"2026-08-24\", \"2026-10-12\"])\n    ap.add_argument(\"--days\", type=int, default=7)\n    ap.add_argument(\"--cadence\", type=int, default=120)\n    ap.add_argument(\"--offset\", type=int, default=17)\n    ap.add_argument(\"--paths\", type=int, default=1000)\n    ap.add_argument(\"--workers\", type=int, default=6)\n    ap.add_argument(\"--configs\", nargs=\"+\", default=[\"crypto24\", \"other24\", \"crypto1\"])\n    ap.add_argument(\"--assets\", nargs=\"+\")\n    ap.add_argument(\"--field\", action=\"store_true\", help=\"CRPS-only at exact field times\")\n    ap.add_argument(\"--rank\", action=\"store_true\", help=\"full official backtest including field\")\n    ap.add_argument(\"--stride\", type=int, default=1)\n    ap.add_argument(\"--force\", action=\"store_true\")\n    ap.add_argument(\"--details\", action=\"store_true\")\n    ap.add_argument(\"--event-types\", nargs=\"+\")\n    ap.add_argument(\"--event-leads\", nargs=\"+\", type=int)\n    args = ap.parse_args()\n    directory = ROOT / \"agent/results\" / args.tag\n    directory.mkdir(parents=True, exist_ok=True)\n    jobs = []\n    for config in args.configs:\n        assets = OTHER if config == \"other24\" else CRYPTO\n        horizon, step = (3600, 60) if config == \"crypto1\" else (86400, 300)\n        for end in args.ends:\n            for asset in assets:\n                if args.assets and asset not in args.assets:\n                    continue\n                jobs.append((config, end, asset, horizon, step))\n\n    def run(job):\n        config, end, asset, horizon, step = job\n        prefix = directory / f\"{config}_{asset}_{end}\"\n        if prefix.with_suffix(\".json\").exists() and not args.force:\n            return json.loads(prefix.with_suffix(\".json\").read_text())\n        cmd = [\"uv\", \"run\", \"agent/predict.py\", \"--model-module\", args.model,\n               \"--asset\", asset, \"--eval-end\", end, \"--days\", str(args.days),\n               \"--time-length\", str(horizon), \"--time-increment\", str(step),\n               \"--num-simulations\", str(args.paths), \"--output\", str(prefix)]\n        if args.details:\n            cmd += [\"--details\"]\n        if args.event_types:\n            cmd += [\"--event-types\", *args.event_types]\n        if args.event_leads:\n            cmd += [\"--event-leads\", *map(str,args.event_leads)]\n        if not args.rank:\n            cmd += [\"--crps-only\"]\n            if args.field:\n                cmd += [\"--field-times\", \"--stride\", str(args.stride)]\n            else:\n                cmd += [\"--cadence-minutes\", str(args.cadence), \"--offset-minutes\", str(args.offset)]\n        env = os.environ.copy()\n        env.update({\"OMP_NUM_THREADS\": \"1\", \"OPENBLAS_NUM_THREADS\": \"1\", \"MKL_NUM_THREADS\": \"1\", \"NUMBA_NUM_THREADS\": \"1\"})\n        with prefix.with_suffix(\".log\").open(\"w\") as f:\n            proc = subprocess.run(cmd, cwd=ROOT, env=env, stdout=f, stderr=subprocess.STDOUT)\n        if proc.returncode:\n            return {\"error\": str(prefix.with_suffix('.log')), \"returncode\": proc.returncode}\n        return json.loads(prefix.with_suffix(\".json\").read_text())\n\n    rows = []\n    with ThreadPoolExecutor(max_workers=args.workers) as pool:\n        for future in as_completed([pool.submit(run, job) for job in jobs]):\n            row = future.result()\n            rows.append(row)\n            if \"error\" in row:\n                print(json.dumps(row), flush=True)\n            else:\n                print(f\"{row['asset']:6s} {row['time_length']:5d} {row['eval_end']} CRPS={row['mean_crps']:.5f} n={row['num_prompts']} s/prompt={row['seconds_per_prompt']:.3f}\", flush=True)\n    (directory / \"suite.json\").write_text(json.dumps(rows, indent=2) + \"\\n\")\n    if any(\"error\" in row for row in rows):\n        sys.exit(1)\n    for config in args.configs:\n        horizon = 3600 if config == \"crypto1\" else 86400\n        assets = OTHER if config == \"other24\" else CRYPTO\n        selected = [r for r in rows if r['time_length'] == horizon and r['asset'] in assets]\n        if selected:\n            n = sum(r['num_prompts'] for r in selected)\n            print(f\"{config}: mean CRPS={sum(r['mean_crps']*r['num_prompts'] for r in selected)/n:.6f}, n={n}\")\n\n\nif __name__ == \"__main__\":\n    main()\n","exit_code":0,"status":"completed"}}
