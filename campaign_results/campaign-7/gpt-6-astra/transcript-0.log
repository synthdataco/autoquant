{"type":"item.completed","item":{"id":"item_760","type":"command_execution","command":"/bin/bash -lc 'cat agent/ml_features.py agent/ml_models.py'","aggregated_output":"\"\"\"Identical causal feature definitions for volatility training and serving.\"\"\"\nfrom __future__ import annotations\nimport numpy as np\nimport pandas as pd\n\nfrom seasonal_models import get_profile, seasonal_values\nfrom vol_models import valid_returns, ewma\n\nASSETS=['BTC','ETH','SOL','XRP','HYPE','XAU','NVDAX','GOOGLX','TSLAX','AAPLX','WTIOIL','SPCX','SP500']\nHALVES=[15,60,240,720,1440,4320]\nCORE_NAMES=[f'{kind}_{h}' for kind in ('rms','abs') for h in HALVES]+['log_base']\nEXTRA_NAMES=[f'range_{h}' for h in (60,720,4320)]+['volume_60_1440','volume_240_4320','trades_60_1440','trades_240_4320','zero_60','zero_720']+[f'signed_{w}' for w in (30,120,360,1440)]\nTIME_NAMES=['hour_sin','hour_cos','week_sin','week_cos']\nNAMES=CORE_NAMES+EXTRA_NAMES+TIME_NAMES+['asset_'+a for a in ASSETS]\n\n\ndef finite_ewm(x, half, length):\n    \"\"\"Vectorized exactly truncated, NaN-aware exponential average.\"\"\"\n    x=np.asarray(x,dtype=float)\n    good=np.isfinite(x)\n    alpha=-np.expm1(-np.log(2)/half)\n    n=pd.Series(np.r_[0.,np.where(good,x,0.)]).ewm(alpha=alpha,adjust=False).mean().to_numpy(copy=True)[1:]\n    d=pd.Series(np.r_[0.,good.astype(float)]).ewm(alpha=alpha,adjust=False).mean().to_numpy(copy=True)[1:]\n    if len(x)>length:\n        tail=np.exp2(-length/half)\n        n[length:] -= tail*n[:-length].copy()\n        d[length:] -= tail*d[:-length].copy()\n    return np.divide(n,d,out=np.full_like(n,np.nan),where=d>1e-12)\n\n\ndef time_features(starts, asset):\n    idx=pd.DatetimeIndex(starts).tz_convert('America/New_York')\n    hour=np.asarray(idx.hour+idx.minute/60)\n    week=np.asarray(idx.day_of_week)+hour/24\n    time=np.column_stack([np.sin(hour*2*np.pi/24),np.cos(hour*2*np.pi/24),np.sin(week*2*np.pi/7),np.cos(week*2*np.pi/7)])\n    onehot=np.zeros((len(idx),len(ASSETS)))\n    if asset in ASSETS:\n        onehot[:,ASSETS.index(asset)]=1\n    return np.column_stack([time,onehot])\n\n\ndef _one_mean(x,age,half):\n    good=np.isfinite(x)\n    w=np.exp2(-age[good]/half)\n    return np.sum(w*x[good])/np.sum(w) if len(w) and w.sum()>1e-15 else np.nan\n\n\ndef one_features(asset,start_time,time_length,context,table=None):\n    last,r,age=valid_returns(context)\n    if table is None:\n        table=get_profile(asset,str(context.index[-1].date()),'America/New_York')\n    seas=seasonal_values(context.index,table,'America/New_York')\n    r=r/np.sqrt(seas[1:])\n    rms=np.array([ewma(r,age,h) for h in HALVES])\n    absolute=np.array([ewma(r,age,h,True) for h in HALVES])\n    base=np.sqrt(.75*rms[1]+.25*rms[3]) if time_length<=3600 else np.sqrt(.75*rms[3]+.25*rms[5])\n    base=max(base,1e-7)\n    core=np.r_[.5*np.log(np.maximum(rms,1e-14)/base**2),.5*np.log(np.maximum(absolute,1e-14)/base**2),np.log(base)]\n    high=np.asarray(context['high'],dtype=float)[1:]\n    low=np.asarray(context['low'],dtype=float)[1:]\n    ranges=(np.log(np.maximum(high,1e-12)/np.maximum(low,1e-12)))**2/(4*np.log(2))/seas[1:]\n    ranges[(high<=0)|(low<=0)]=np.nan\n    extras=[.5*np.log(max(_one_mean(ranges,age,h),1e-14)/base**2) for h in (60,720,4320)]\n    for col in ['volume','trade_count']:\n        x=np.asarray(context[col],dtype=float)[1:].copy()\n        x[~np.isfinite(r)]=np.nan\n        for fast,slow in [(60,1440),(240,4320)]:\n            a,b=_one_mean(x,age,fast),_one_mean(x,age,slow)\n            extras.append(np.log(max(a,1e-12)/max(b,1e-12)))\n    zeros=np.where(np.isfinite(r),(r==0).astype(float),np.nan)\n    extras += [_one_mean(zeros,age,h) for h in (60,720)]\n    for w in (30,120,360,1440):\n        mask=(age<w)&np.isfinite(r)\n        extras.append(np.sum(r[mask])/(base*np.sqrt(w)))\n    x=np.r_[core,extras,time_features([pd.Timestamp(start_time)],asset)[0]]\n    return x.astype(np.float32),base\n\n\ndef vector_features(frame,asset,table,time_length,context_days=7):\n    \"\"\"Every row is a possible context endpoint; future labels are separate.\"\"\"\n    p=np.asarray(frame.close,dtype=float)\n    r=np.diff(np.log(p),prepend=np.nan)\n    seas=seasonal_values(frame.index,table,'America/New_York')\n    r=r/np.sqrt(seas)\n    length=context_days*1440-(3 if time_length>3600 else 2)\n    rms=np.column_stack([finite_ewm(r*r,h,length) for h in HALVES])\n    av=np.column_stack([finite_ewm(np.abs(r),h,length)*np.sqrt(np.pi/2) for h in HALVES])\n    base=np.sqrt(.75*rms[:,1]+.25*rms[:,3]) if time_length<=3600 else np.sqrt(.75*rms[:,3]+.25*rms[:,5])\n    base=np.maximum(base,1e-7)\n    core=np.column_stack([.5*np.log(np.maximum(rms,1e-14)/base[:,None]**2),np.log(np.maximum(av,1e-7)/base[:,None]),np.log(base)])\n    high=np.asarray(frame.high,dtype=float)\n    low=np.asarray(frame.low,dtype=float)\n    ranges=np.log(np.maximum(high,1e-12)/np.maximum(low,1e-12))**2/(4*np.log(2))/seas\n    ranges[(high<=0)|(low<=0)]=np.nan\n    extras=[.5*np.log(np.maximum(finite_ewm(ranges,h,length),1e-14)/base**2) for h in (60,720,4320)]\n    for col in ['volume','trade_count']:\n        x=np.asarray(frame[col],dtype=float).copy()\n        x[~np.isfinite(r)]=np.nan\n        for fast,slow in [(60,1440),(240,4320)]:\n            a,b=finite_ewm(x,fast,length),finite_ewm(x,slow,length)\n            extras.append(np.log(np.maximum(a,1e-12)/np.maximum(b,1e-12)))\n    zeros=np.where(np.isfinite(r),(r==0).astype(float),np.nan)\n    extras += [finite_ewm(zeros,h,length) for h in (60,720)]\n    for w in (30,120,360,1440):\n        sums=pd.Series(r).rolling(w,min_periods=1).sum().to_numpy()\n        extras.append(sums/(base*np.sqrt(w)))\n    start=frame.index+pd.Timedelta(minutes=3 if time_length>3600 else 2)\n    out=np.column_stack([core,*extras,time_features(start,asset)])\n    return out.astype(np.float32),base,seas\n\"\"\"Learned scale adjustment; seasonal Gaussian paths otherwise unchanged.\"\"\"\nfrom __future__ import annotations\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport xgboost as xgb\nfrom ml_features import NAMES, one_features\nfrom seasonal_models import forecast_variance\n\nCONTEXT_DAYS=7\nVARIANT=os.environ.get('SYNTH_RESEARCH_VARIANT','ml_vol')\nARTIFACTS=Path(__file__).resolve().parent/'artifacts/ml'\n\n@lru_cache(maxsize=1)\ndef manifest():\n    return json.loads((ARTIFACTS/'manifest.json').read_text())\n\n@lru_cache(maxsize=32)\ndef booster(filename):\n    model=xgb.Booster(params={'device':'cpu','nthread':1})\n    model.load_model(ARTIFACTS/filename)\n    model.set_param({'device':'cpu','nthread':1})\n    return model\n\ndef scale_adjustment(asset,start_time,time_length,context,kind='vol',blend=1.0):\n    date=str(context.index[-1].date())\n    fits=[x for x in manifest()['fits'] if x['cutoff']<=date and x['time_length']==time_length and x['kind']==kind]\n    if not fits:\n        return 1.0\n    fit=max(fits,key=lambda x:x['cutoff'])\n    x,_=one_features(asset,start_time,time_length,context)\n    x=x[[NAMES.index(k) for k in fit['features']]].reshape(1,-1)\n    x[~np.isfinite(x)]=np.nan\n    prediction=float(booster(fit['file']).inplace_predict(x)[0])\n    return float(np.exp(blend*np.clip(prediction,np.log(.25),np.log(3.0))))\n\ndef simulate(asset,start_time,time_increment=300,time_length=86400,num_simulations=1000,context_prices=None):\n    seed=int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    rng=np.random.default_rng(seed)\n    last,stepvar=forecast_variance(asset,start_time,time_increment,time_length,context_prices)\n    kind='full' if 'full' in VARIANT else 'vol'\n    blend=.5 if 'blend' in VARIANT else 1.\n    adjustment=scale_adjustment(asset,start_time,time_length,context_prices,kind,blend)\n    steps=time_length//time_increment+1\n    z=rng.normal(size=(num_simulations,steps))\n    z[:,0]=0\n    z[:,1:]*=np.sqrt(stepvar)*adjustment\n    paths=last*np.exp(np.cumsum(z,axis=1))\n    return (start_time,time_increment,*paths.tolist())\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_761","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,240p' agent/seasonal_models.py\"","aggregated_output":"\"\"\"Causal clock-seasonality ablations on top of the EWMA mixture.\"\"\"\nfrom __future__ import annotations\nfrom functools import lru_cache\nimport json\nimport os\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\n\nfrom vol_models import valid_returns, ewma\n\nCONTEXT_DAYS = 7\nVARIANT = os.environ.get('SYNTH_RESEARCH_VARIANT', 'season_ny')\n\n\n@lru_cache(maxsize=1)\ndef artifact():\n    path = Path(__file__).resolve().parent/'artifacts/seasonality.json'\n    return json.loads(path.read_text()) if path.exists() else {'bins':96, 'assets':{}}\n\n\n@lru_cache(maxsize=1024)\ndef get_profile(asset, asof, clock, strength=1.0, individual=0.35):\n    data = artifact()\n    fits = data['assets'].get(asset, {})\n    keys = [key for key in fits if key <= asof]\n    bins = data['bins']\n    if not keys:\n        return np.ones((7,bins))\n    fit = fits[max(keys)]['clocks'][clock]\n    raw = np.asarray(fit['raw'], dtype=float)\n    counts = np.asarray(fit['counts'], dtype=float)\n    base = raw.copy()\n    for days in [slice(0,5),slice(5,7)]:\n        numerator = (raw[days]*counts[days]).sum(axis=0)\n        den = counts[days].sum(axis=0)\n        common = np.divide(numerator,den,out=np.ones_like(numerator),where=den>0)\n        base[days] = individual*raw[days] + (1-individual)*common\n    # Gentle circular smoothing on the whole week, not across unrelated hours.\n    flat = base.ravel()\n    flat = .8*flat + .1*np.roll(flat,1) + .1*np.roll(flat,-1)\n    flat = np.clip(flat, .015, 20)**strength\n    return (flat/np.mean(flat)).reshape(7,bins)\n\n\ndef seasonal_values(index, table, clock):\n    idx = pd.DatetimeIndex(index).tz_convert(clock)\n    bins = table.shape[1]\n    bucket = np.asarray((idx.hour*60+idx.minute)*bins//1440)\n    return table[np.asarray(idx.day_of_week),bucket]\n\n\ndef forecast_variance(asset, start_time, time_increment, time_length, context,\n                      clock='America/New_York', strength=1.0, robust=0.0):\n    last,r,age = valid_returns(context)\n    table = get_profile(asset, str(context.index[-1].date()), clock, strength)\n    history = seasonal_values(context.index[1:],table,clock)\n    r = r / np.sqrt(history)\n    h1,h2 = (60,720) if time_length<=3600 else (720,4320)\n    var = .75*ewma(r,age,h1)+.25*ewma(r,age,h2)\n    if robust:\n        avar = .75*ewma(r,age,h1,True)+.25*ewma(r,age,h2,True)\n        var = (1-robust)*var + robust*avar\n    future = pd.date_range(pd.Timestamp(start_time)+pd.Timedelta(minutes=1),periods=time_length//60,freq='1min')\n    seasonal = seasonal_values(future,table,clock)\n    stepvar = max(var,1e-14)*seasonal.reshape(-1,time_increment//60).sum(axis=1)\n    return last,stepvar\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED','20261108'))\n    rng = np.random.default_rng(seed)\n    clock = {'season_utc':'UTC','season_ldn':'Europe/London'}.get(VARIANT,'America/New_York')\n    strength = 0.0 if VARIANT=='season_none' else (0.7 if VARIANT=='season_shrink' else 1.0)\n    robust = 0.5 if VARIANT=='season_robust' else 0.0\n    last,stepvar = forecast_variance(asset,start_time,time_increment,time_length,context_prices,clock,strength,robust)\n    steps = time_length//time_increment+1\n    shocks = rng.normal(size=(num_simulations,steps))\n    shocks[:,0] = 0\n    shocks[:,1:] *= np.sqrt(stepvar)\n    paths = last*np.exp(np.cumsum(shocks,axis=1))\n    return (start_time,time_increment,*paths.tolist())\n","exit_code":0,"status":"completed"}}
