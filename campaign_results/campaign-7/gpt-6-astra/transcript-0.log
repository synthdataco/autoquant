{"type":"item.started","item":{"id":"item_87","type":"command_execution","command":"/bin/bash -lc \"OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 uv run python - <<'PY'\nfrom pathlib import Path\nimport numpy as np\nimport pandas as pd\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices, context_slice\nimport sys\nsys.path.insert(0,'agent')\nfrom ml_features import one_features, vector_features,NAMES\nfrom seasonal_models import get_profile\nfor a in ['BTC','AAPLX']:\n t=pd.Timestamp('2026-10-05 12:17',tz='UTC')\n f=load_minute_prices(Path('market_data'),a,t-pd.Timedelta(days=8),t)\n for h in ([3600,86400] if a=='BTC' else [86400]):\n  ctx=context_slice(f,t,h,7)\n  one,b=one_features(a,t,h,ctx)\n  table=get_profile(a,str(ctx.index[-1].date()),'America/New_York')\n  many,bases,_=vector_features(f,a,table,h)\n  i=f.index.get_loc(ctx.index[-1])\n  diff=np.nanmax(np.abs(one-many[i]))\n  print(a,h,'max feature discrepancy',diff,'base ratio',b/bases[i])\n  assert diff<1e-5\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
