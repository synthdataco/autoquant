{"type":"item.completed","item":{"id":"item_742","type":"command_execution","command":"/bin/bash -lc 'cat agent/modeling.py agent/combined_checkpoint.py agent/sparse_models.py'","aggregated_output":"\"\"\"Causal learned volatility, forward seasonality and scheduled-event uncertainty.\n\nOnly artifacts trained before the context endpoint are selected. Current prices\ncome solely from the supplied context frame. Research flags cannot select a\ndifferent serving model: all retained options are explicit below.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport os\nimport numpy as np\nfrom candidate_models import candidate_forecast\nfrom integrated_models import draw_logpaths\n\n# Days of minute history simulate() receives as context_prices: a plain int from 3 to 30.\nCONTEXT_DAYS = 7\n\n\ndef simulate(\n    asset: str,\n    start_time,\n    time_increment: int = 300,\n    time_length: int = 86_400,\n    num_simulations: int = 1000,\n    context_prices=None,\n):\n    seed = int(os.environ.get(\"SYNTH_BENCHMARK_SEED\", \"20261108\"))\n    last, stepvar = candidate_forecast(\n        asset, start_time, time_increment, time_length, context_prices,\n        shape=True, events=True, profile_variant=\"prof_abs5m\",\n    )\n    logpaths = draw_logpaths(\n        seed, num_simulations, stepvar, time_increment,\n        mixture=0.4, stochastic_vol=0.0,\n    )\n    paths = last * np.exp(logpaths)\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"Fixed separated-shape/calendar/.4-mixture reference, independent of serving updates.\"\"\"\nimport os\nimport numpy as np\nfrom candidate_models import candidate_forecast\nfrom integrated_models import draw_logpaths\n\nCONTEXT_DAYS = 7\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    last, variance = candidate_forecast(asset, start_time, time_increment, time_length,\n                                       context_prices, shape=True, events=True,\n                                       profile_variant='prof_abs5m')\n    paths = last*np.exp(draw_logpaths(seed, num_simulations, variance, time_increment,\n                                     mixture=.4, stochastic_vol=0.))\n    return (start_time, time_increment, *paths.tolist())\n\"\"\"Fresh-price stress tests with one price or ten real context minutes.\"\"\"\nimport os\nimport numpy as np\nfrom candidate_models import candidate_forecast\nfrom integrated_models import draw_logpaths\nfrom volatility_prior import prior_factor\n\nCONTEXT_DAYS = 7\nVARIANT = os.environ.get('SYNTH_RESEARCH_VARIANT', 'sparse_base1')\n\n\ndef simulate(asset, start_time, time_increment=300, time_length=86400,\n             num_simulations=1000, context_prices=None):\n    seed = int(os.environ.get('SYNTH_BENCHMARK_SEED', '20261108'))\n    context = context_prices.copy(deep=True)\n    minutes = 10 if VARIANT.endswith('10') else 1\n    context.iloc[:-minutes, :] = np.nan\n    last, variance = candidate_forecast(asset, start_time, time_increment, time_length,\n                                       context, shape=True, events=True)\n    if 'prior' in VARIANT:\n        variance *= prior_factor(asset, start_time, time_length, context)**2\n    paths = last*np.exp(draw_logpaths(seed, num_simulations, variance, time_increment, mixture=.4))\n    return (start_time, time_increment, *paths.tolist())\n","exit_code":0,"status":"completed"}}
