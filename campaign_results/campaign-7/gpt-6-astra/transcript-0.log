{"type":"item.started","item":{"id":"item_249","type":"command_execution","command":"/bin/bash -lc \"uv run python - <<'PY'\nimport sys\nsys.path.insert(0,'agent')\nfrom compare import load\nimport pandas as pd\nfor base_tag,tags in [('ml_vol_dev',['sobol_rank_bridge_mix_dev','context14_dev','context30_dev']),('ml_vol_confirm',['combo_t5_confirm','quant_mean_sv_confirm','sobol_rank_bridge_mix_confirm'])]:\n    base=load(base_tag)\n    for tag in tags:\n        from pathlib import Path\n        if not (Path('agent/results')/tag/'suite.json').exists():\n            continue\n        f=load(tag)\n        keys=['asset','time_length','start_time','window','config']\n        p=base[keys+['crps']].merge(f[keys+['crps']],on=keys,suffixes=('_base','_new'))\n        g=p.groupby('config')[['crps_base','crps_new']].mean()\n        g['pct']=100*(g.crps_new/g.crps_base-1)\n        print(tag,g.round(5).to_string())\nPY\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
