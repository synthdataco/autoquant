{"role":"tool","tool_call_id":"Read_183_df050457","content":"130\t    last = float(valid[-1]) if valid.size else 1.0\n131\t    steps = time_length // time_increment\n132\t    rets = _returns(context_prices)\n133\t    if time_length == 3600:\n134\t        minute_values = rets.dropna().to_numpy()\n135\t        sigma = np.sqrt(_fast_variance(minute_values) * time_increment / 60.0)\n136\t        sigmas = np.full(steps, sigma)\n137\t        if minute_values.size >= 100:\n138\t            residual = minute_values / max(float(np.std(minute_values)), 1e-8)\n139\t            residual = np.clip(residual - np.median(residual), -8.0, 8.0)\n140\t            shocks = residual[rng.integers(0, residual.size, size=(num_simulations, steps))] * sigmas\n141\t        else:\n142\t            shocks = rng.normal(size=(num_simulations, steps)) * sigmas\n143\t    else:\n144\t        sigmas = _seasonal_sigmas(rets, start_time, time_increment, steps)\n145\t        clean = context_prices[\"close\"].astype(float)\n146\t        clean = clean.where(np.isfinite(clean) & (clean > 0))\n147\t        five_minute = np.log(clean).diff(5).dropna().to_numpy()\n148\t        minute_values = rets.dropna().to_numpy()\n149\t        if five_minute.size >= 100 and minute_values.size >= 100:\n150\t            residual = five_minute / np.sqrt(5.0 * max(float(np.var(minute_values)), 1e-12))\n151\t            residual = np.clip(residual - np.median(residual), -8.0, 8.0)\n152\t            empirical = residual[rng.integers(0, residual.size, size=(num_simulations, steps))] * sigmas\n153\t            gaussian = rng.normal(size=(num_simulations, steps)) * sigmas\n154\t            shocks = np.where(rng.random((num_simulations, steps)) < 0.5, empirical, gaussian)\n155\t        else:\n156\t            shocks = rng.normal(size=(num_simulations, steps)) * sigmas\n157\t    log_paths = np.concatenate(\n158\t        [np.zeros((num_simulations, 1)), np.cumsum(shocks, axis=1)], axis=1\n159\t    )\n160\t    paths = last * np.exp(log_paths)\n161\t    return (start_time, time_increment, *[p.tolist() for p in paths])"}
