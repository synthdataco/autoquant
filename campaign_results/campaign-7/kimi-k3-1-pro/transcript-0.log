{"role":"tool","tool_call_id":"Read_306_2a51204a","content":"1\t\"\"\"Probabilistic price paths calibrated from the supplied minute context.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport os\n6\timport random\n7\t\n8\timport numpy as np\n9\timport pandas as pd\n10\t\n11\tCONTEXT_DAYS = 7\n12\tVOL_HALFLIFE_MINUTES = float(os.environ.get(\"SYNTH_VOL_HALFLIFE_MINUTES\", \"30\"))\n13\t\n14\t\n15\tdef _returns(context_prices) -> pd.Series:\n16\t    closes = context_prices[\"close\"].astype(float)\n17\t    closes = closes.where(np.isfinite(closes) & (closes > 0))\n18\t    return np.log(closes).diff()\n19\t\n20\t\n21\tdef _fast_variance(rets: np.ndarray) -> float:\n22\t    if rets.size < 10:\n23\t        return 5e-4**2\n24\t    alpha = 1.0 - np.exp(np.log(0.5) / VOL_HALFLIFE_MINUTES)\n25\t    initial = rets[: min(rets.size, 1440)]\n26\t    level = float(np.mean(initial * initial))\n27\t    for ret in rets:\n28\t        level += alpha * (ret * ret - level)\n29\t    return max(level, 1e-12)\n30\t\n31\t\n32\tdef _seasonal_sigmas(rets: pd.Series, start_time, time_increment: int, steps: int) -> np.ndarray:\n33\t    values = rets.to_numpy(dtype=float)\n34\t    valid = np.isfinite(values)\n35\t    values = values[valid]\n36\t    if values.size < 100:\n37\t        return np.full(steps, 5e-4 * np.sqrt(time_increment / 60.0))\n38\t    local = rets.index[valid].tz_convert(\"America/New_York\")\n39\t    weekend = local.day_of_week >= 5\n40\t    bins = (local.hour * 60 + local.minute) // 30\n41\t    future = pd.to_datetime(start_time) + pd.to_timedelta(\n42\t        (np.arange(steps) + 0.5) * time_increment, unit=\"s\"\n43\t    )\n44\t    future_local = future.tz_convert(\"America/New_York\")\n45\t    future_weekend = future_local.day_of_week >= 5\n46\t    future_bins = (future_local.hour * 60 + future_local.minute) // 30\n47\t    global_variance = max(float(np.var(values)), 1e-12)\n48\t    sigmas = np.empty(steps)\n49\t    for is_weekend in (False, True):\n50\t        future_mask = future_weekend == is_weekend\n51\t        if not future_mask.any():\n52\t            continue\n53\t        history_mask = weekend == is_weekend\n54\t        count = int(history_mask.sum())\n55\t        if count < 300:\n56\t            history_mask = np.ones(values.size, dtype=bool)\n57\t            count = values.size\n58\t        sample = values[history_mask]\n59\t        sample_bins = bins[history_mask]\n60\t        variance = float(np.mean(sample * sample))\n61\t        variance = (count * variance + 720 * global_variance) / (count + 720)\n62\t        mean_absolute = max(float(np.mean(np.abs(sample))), 1e-8)\n63\t        profile = np.ones(48)\n64\t        for bucket in range(48):\n65\t            bucket_values = np.abs(sample[sample_bins == bucket])\n66\t            if bucket_values.size >= 20:\n67\t                profile[bucket] = max(float(np.mean(bucket_values)) / mean_absolute, 0.25)\n68\t        profile = np.clip(profile, 0.25, 3.0)\n69\t        profile /= np.sqrt(np.mean(profile * profile))\n70\t        sigmas[future_mask] = np.sqrt(variance * time_increment / 60.0) * profile[\n71\t            future_bins[future_mask]\n72\t        ]\n73\t    return sigmas\n74\t\n75\t\n76\tdef _event_multipliers(asset: str, start_time, time_increment: int, steps: int) -> np.ndarray:\n77\t    multipliers = np.ones(steps)\n78\t    path = os.environ.get(\"SYNTH_BENCHMARK_CALENDAR\")\n79\t    if not path:\n80\t        return multipliers\n81\t    try:\n82\t        events = pd.read_parquet(path, columns=[\"time_utc\", \"event\", \"scope\"])\n83\t        events[\"time_utc\"] = pd.to_datetime(events[\"time_utc\"], utc=True)\n84\t        start = pd.Timestamp(start_time)\n85\t        if start.tzinfo is None:\n86\t            start = start.tz_localize(\"UTC\")\n87\t        else:\n88\t            start = start.tz_convert(\"UTC\")\n89\t        scope = events[\"scope\"].astype(str)\n90\t        relevant = events[\"event\"].isin([\"CPI\", \"NFP\", \"FOMC\", \"EARNINGS\"])\n91\t        relevant &= (scope == \"all\") | scope.str.split(\",\").apply(lambda values: asset in values)\n92\t        finish = start + pd.Timedelta(seconds=steps * time_increment)\n93\t        events = events[relevant & (events[\"time_utc\"] >= start) & (events[\"time_utc\"] <= finish)]\n94\t        ends = start + pd.to_timedelta(np.arange(1, steps + 1) * time_increment, unit=\"s\")\n95\t        starts = ends - pd.Timedelta(seconds=time_increment)\n96\t        profiles = {\n97\t            \"CPI\": [3.0, 1.7, 1.3],\n98\t            \"NFP\": [1.8, 2.0, 1.1],\n99\t            \"FOMC\": [2.0, 2.5, 1.75] + [1.4] * 10,\n100\t            \"EARNINGS\": [3.0, 4.0, 4.0] + [5.0] * 4 + [3.0] * 6,\n101\t        }\n102\t        for event in events.itertuples():\n103\t            containing = np.flatnonzero((starts < event.time_utc) & (ends >= event.time_utc))\n104\t            first = int(containing[0]) if containing.size else 0\n105\t            width = max(1, round(300 / time_increment))\n106\t            for offset, value in enumerate(profiles[event.event]):\n107\t                index = first + offset * width\n108\t                if index >= steps:\n109\t                    break\n110\t                multipliers[index : min(index + width, steps)] *= value\n111\t    except (OSError, ValueError, KeyError, TypeError, AttributeError):\n112\t        return np.ones(steps)\n113\t    return np.clip(multipliers, 1.0, 8.0)\n114\t\n115\t\n116\tdef simulate(\n117\t    asset: str,\n118\t    start_time,\n119\t    time_increment: int = 300,\n120\t    time_length: int = 86_400,\n121\t    num_simulations: int = 1000,\n122\t    context_prices=None,\n123\t):\n124\t    seed = int(os.environ.get(\"SYNTH_BENCHMARK_SEED\", \"20261108\"))\n125\t    random.seed(seed)\n126\t    np.random.seed(seed)\n127\t    rng = np.random.default_rng(seed)\n128\t\n129\t    if time_length == 3600:\n130\t        context_prices = context_prices.iloc[-7 * 1440 :]\n131\t    closes = context_prices[\"close\"].to_num