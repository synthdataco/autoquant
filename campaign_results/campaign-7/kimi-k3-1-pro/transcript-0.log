backtester/scoring.py-437-    trimmed = smoothed_scores.loc[smoothed_scores[\"updated_at\"] >= warmup_end]\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-438-    if trimmed.empty:\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-439-        return smoothed_scores\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-440-    return trimmed.reset_index(drop=True)"}
