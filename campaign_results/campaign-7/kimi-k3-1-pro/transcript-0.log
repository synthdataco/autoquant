s a miss, the same as no prediction at all: compute_prompt_scores\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-386-    # fills -1 with the prompt's 95th percentile. Scoring it would give a NaN CRPS, and the\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-387-    # percentile is taken over every miner on that prompt, so one NaN drops the prompt from the\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-388-    # whole field instead of costing the champion anything.\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-389-    if not np.isfinite(simulation_runs).all():\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py:390:        return {\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-391-            \"miner_uid\": miner_id,\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-392-            \"scored_time\": scored_time,\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-393-            \"crps\": -1,\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-394-            \"asset\": asset_val,\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-395-            \"start_time\": start_time,\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-396-            \"time_increment\": time_incr,\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-397-            \"time_length\": time_len,\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-398-            \"miner_id\": miner_id,\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-399-        }\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-400-    real_price_array = np.asarray(real_prices, dtype=float)\n.venv/lib/python3.12/site-packages/synth_lib/backtester/scoring.py-401-    if vol_scoring_blocks and (latest_formula or pd.Timestamp(scored_time) >= VOL_CRPS_1H_DATE):\n.venv