s/ETH/1m/date=2025-09-05.parquet\": \"01f01a69733d8268b7ed6d8e1e8277a9e175e24548666b9b63ed0323282857a5\",\n857\t  \"prices/ETH/1m/date=2025-09-06.parquet\": \"6ea2f4eff55db951a7f8170877749da3e565d61285a10880dc332f728f9e3e88\",\n858\t  \"prices/ETH/1m/date=2025-09-07.parquet\": \"e84ed4bc50f7643dbd99052330f4d02b5c801e60b3c1831b1bea7d380b1ac976\",\n859\t  \"prices/ETH/1m/date=2025-09-08.parquet\": \"b71c3a79dfbc892b50bac5e929f33d0ecad104f8f5a3bbd36737a52b621f1d2b\",\n860\t  \"prices/ETH/1m/date=2025-09-09.parquet\": \"da7e48069c8a26cb6da5f0c9695e20f1f679a9f6ef81d92fdde7032b5fbfcd9a\",\n861\t  \"prices/ETH/1m/date=2025-09-10.parquet\": \"405f4764484472d846801377ff7f595227bc645d9d412a2c98f633fc31392c38\",\n862\t  \"prices/ETH/1m/date=2025-09-11.parquet\": \"8be17f0f6f3295a4385271d2b9f7f85a99db040bfbbba9843cabc244f35f3e02\","}
{"role":"tool","tool_call_id":"Read_17_f2d39782","content":"1\tfrom dataclasses import dataclass\n2\t\n3\tSMOOTHED_SCORE_COEFFICIENT = 1 / 3\n4\t\n5\t# 1h score = price CRPS + VOL_CRPS_LAMBDA × the mean, over the block sizes,\n6\t# of the mean per-block volatility CRPS — so each weight below must stay\n7\t# VOL_CRPS_LAMBDA / (3 block sizes × the number of blocks of that size).\n8\tVOL_CRPS_LAMBDA = 5.25\n9\t\n10\t\n11\t@dataclass\n12\tclass CompetitionConfig:\n13\t    asset_list: list[str]\n14\t    label: str\n15\t    time_length: int\n16\t    time_increment: int\n17\t    scoring_intervals: dict[str, int]  # Define scoring intervals in seconds.\n18\t    # Volatility CRPS blocks: name -> (block duration in seconds, weight).\n19\t    # Empty means the competition scores on the price CRPS alone.\n20\t    vol_scoring_blocks: dict[str, tuple[int, float]]\n21\t    window_days: int\n22\t    softmax_beta: float\n23\t\n24\t\n25\tCOM_EQU_24H = CompetitionConfig(\n26\t    asset_list=[\n27\t        \"XAU\",\n28\t        \"NVDAX\",\n29\t        \"GOOGLX\",\n30\t        \"TSLAX\",\n31\t        \"AAPLX\",\n32\t        \"WTIOIL\",\n33\t        \"SPCX\",\n34\t        \"SP500\",\n35\t    ],\n36\t    label=\"Commodities/Equities 24h\",\n37\t    time_length=86400,\n38\t    time_increment=300,\n39\t    scoring_intervals={\n40\t        \"5min\": 300,  # 5 minutes\n41\t        \"30min\": 1800,  # 30 minutes\n42\t        \"3hour\": 10800,  # 3 hours\n43\t        \"24hour_abs\": 86400,  # 24 hours\n44\t    },\n45\t    vol_scoring_blocks={},\n46\t    window_days=10,\n47\t    softmax_beta=-0.15,\n48\t)\n49\t\n50\tCRYPTO_24H = CompetitionConfig(\n51\t    asset_list=[\n52\t        \"BTC\",\n53\t        \"ETH\",\n54\t        \"SOL\",\n55\t        \"XRP\",\n56\t        \"HYPE\",\n57\t    ],\n58\t    label=\"Crypto 24h\",\n59\t    time_length=86400,\n60\t    time_increment=300,\n61\t    scoring_intervals={\n62\t        \"5min\": 300,  # 5 minutes\n63\t        \"30min\": 1800,  # 30 minutes\n64\t        \"3hour\": 10800,  # 3 hours\n65\t        \"24hour_abs\": 86400,  # 24 hours\n66\t    },\n67\t    vol_scoring_blocks={},\n68\t    window_days=10,\n69\t    softmax_beta=-0.15,\n70\t)\n71\t\n72\tCRYPTO_1H = CompetitionConfig(\n73\t    asset_list=[\n74\t        \"BTC\",\n75\t        \"ETH\",\n76\t        \"SOL\",\n77\t        \"XRP\",\n78\t        \"HYPE\",\n79\t    ],\n80\t    label=\"Crypto 1h\",\n81\t    time_length=3600,\n82\t    time_increment=60,\n83\t    scoring_intervals={\n84\t        \"1min\": 60,\n85\t        \"2min\": 120,\n86\t        \"5min\": 300,\n87\t        \"15min\": 900,\n88\t        \"30min\": 1800,\n89\t        \"60min_abs\": 3600,\n90\t        \"0_5min_gaps\": 300,\n91\t        \"0_10min_gaps\": 600,\n92\t        \"0_15min_gaps\": 900,\n93\t        \"0_20min_gaps\": 1200,\n94\t        \"0_25min_gaps\": 1500,\n95\t        \"0_30min_gaps\": 1800,\n96\t        \"0_35min_gaps\": 2100,\n97\t        \"0_40min_gaps\": 2400,\n98\t        \"0_45min_gaps\": 2700,\n99\t        \"0_50min_gaps\": 3000,\n100\t        \"0_55min_gaps\": 3300,\n101\t        \"0_60min_gaps\": 3600,\n102\t    },\n103\t    vol_scoring_blocks={\n104\t        \"vol_60min\": (3600, VOL_CRPS_LAMBDA / 3),  # 1 block\n105\t        \"vol_15min\": (900, VOL_CRPS_LAMBDA / 12),  # 4 blocks\n106\t        \"vol_5min\": (300, VOL_CRPS_LAMBDA / 36),  # 12 blocks\n107\t    },\n108\t    window_days=5,\n109\t    softmax_beta=-0.3,\n110\t)\n111\t\n112\t\n113\t# Canonical list of competitions. Both the scoring cycle (neurons/validator.py)\n114\t# and the moving-average update (forward.py) iterate this, so a competition\n115\t# added/renamed/reordered here propagates to both — don't re-list elsewhere.\n116\tALL_COMPETITIONS = [\n117\t    COM_EQU_24H,\n118\t    CRYPTO_24H,\n119\t    CRYPTO_1H,\n120\t]\n121\t\n122\t# VHFT (Synth Ultra) — the 10-second BTC-microprice competition. Scored OFF-subnet\n123\t# and blended in via the external-ingestion path (vhft_score_provider +\n124\t# compute_vhft_smoothed_score), NOT through the inline-CRPS path — so it is\n125\t# deliberately kept OUT of ALL_COMPETITIONS. It reuses the same\n126\t# SMOOTHED_SCORE_COEFFICIENT and softmax as the other three, so after set_weights\n127\t# L1-normalizes, the four competitions split emissions equally (the coefficient\n128\t# value cancels; a *shared* coefficient is what makes the split equal).\n129\tVHFT_COMPETITION = CompetitionConfig(\n130\t    asset_list=[\"BTC\"],\n131\t    label=\"VHFT 10s\",\n132\t    time_length=10,\n133\t    time_increment=10,\n134\t    scoring_intervals={\"10s\": 10},\n135\t    vol_scoring_blocks={},\n136\t    # window_days is nominal — the external scorer already windows the scores, so\n137\t    # no per-window aggregation happens here.\n138\t    window_days=1,\n139\t    # softmax_beta is deliberately steeper than the other competitions': this\n140\t    # field is tightly bunched, so a gentler beta leaves rewards nearly flat\n141\t    # across it.\n142\t    #\n143\t    # Beta responds to the SPREAD between miners, not the absolute score level:\n144\t    # the scorer subtracts each prompt's winner and softmax is invariant to that\n145\t    # shared offset, so shifting every score changes nothing. A wider field\n146\t    # therefore concentrates rewards harder at a fixed beta. Re-measure before\n147\t    # changing this; do not reason from the score level.\n148\t    #\n149\t    # MUST stay negative (lower score = higher reward), same convention as the\n150\t    # other competitions.\n151\t    softmax_beta=-4.0,\n152\t)\n153\t\n154\t# Plausible size of the VHFT participant field, enforced in\n155\t# compute_vhft_smoothed_score — outside this range the blend is skipped for the\n156\t# cycle rather than trusted.\n157\t#\n158\t# The VHFT block is a fixed SMOOTHED_SCORE_COEFFICIENT however many uids share\n159\t# it, so each participant's cut scales as 1/N — at one participant that is the\n160\t# entire block. A round that scores only a handful of miners, whether from a\n161\t# degraded scorer or a field that has mostly dropped out, would otherwise hand\n162\t# one miner an outsized share, so require a floor. The ceiling is the other end\n163\t# of the same argument: a snapshot naming far more scored participants than the\n164\t# competition has is a malfunctioning scorer, not sudden popularity.\n165\tVHFT_MIN_PARTICIPANTS = 3\n166\tVHFT_MAX_PARTICIPANTS = 64"}
{"role":"tool","tool_call_id":"Read_16_642446d7","content":"1\timport numpy as np\n2\tfrom properscoring import crps_ensemble\n3\t\n4\t\n5\tdef get_interval_steps(scoring_interval: int, time_increment: int) -> int:\n6\t    \"\"\"\n7\t    Calculate the number of steps in the given scoring interval based on the time increment.\n8\t    \"\"\"\n9\t    return int(scoring_interval / time_increment)\n10\t\n11\t\n12\tdef calculate_crps_for_miner(\n13\t    simulation_runs: np.ndarray,\n14\t    real_price_path: np.ndarray,\n15\t    time_increment: int,\n16\t    scoring_intervals: dict[str, int],\n17\t) -> tuple[float, list[dict]]:\n18\t    \"\"\"\n19\t    Calculate the total CRPS score for a miner's simulations over specified intervals,\n20\t    Return the sum of the scores.\n21\t\n22\t    Parameters:\n23\t        simulation_runs (numpy.ndarray): Simulated price paths.\n24\t        real_price_path (numpy.ndarray): The real price path.\n25\t        time_increment (int): Time increment in seconds.\n26\t        scoring_intervals (dict): Dictionary of scoring intervals with their names and durations in seconds.\n27\t\n28\t    Returns:\n29\t        float: Sum of total CRPS scores over the intervals.\n30\t    \"\"\"\n31\t    # Initialize lists to store detailed CRPS data\n32\t    detailed_crps_data: list[dict] = []\n33\t    sum_all_scores = 0.0\n34\t    gap_total_crps = 0.0\n35\t\n36\t    for interval_name, interval_seconds in scoring_intervals.items():\n37\t        interval_steps = get_interval_steps(interval_seconds, time_increment)\n38\t        absolute_price = interval_name.endswith(\"_abs\")\n39\t        is_gap = interval_name.endswith(\"_gaps\")\n40\t\n41\t        # If we are considering absolute prices, adjust the interval steps for potential gaps:\n42\t        # if only the initial price is present, then decrease the interval step\n43\t        if absolute_price:\n44\t            while (\n45\t                real_price_path[::interval_steps].shape[0] == 1\n46\t                and interval_steps > 1\n47\t            ):\n48\t                interval_steps -= 1\n49\t\n50\t        # Make sure there are no zero prices in the simulation runs because it will cause a division by zero error\n51\t        if np.any(simulation_runs == 0):\n52\t            return -1.0, [\n53\t                {\"error\": \"Zero price encountered in simulation runs\"}\n54\t            ]\n55\t\n56\t        # Calculate price changes over intervals\n57\t        simulated_changes = calculate_price_changes_over_intervals(\n58\t            simulation_runs,\n59\t            interval_steps,\n60\t            absolute_price,\n61\t            is_gap,\n62\t        )\n63\t        real_changes = calculate_price_changes_over_intervals(\n64\t            real_price_path.reshape(1, -1),\n65\t            interval_steps,\n66\t            absolute_price,\n67\t            is_gap,\n68\t        )\n69\t        data_blocks = label_observed_blocks(real_changes[0])\n70\t\n71\t        # Not enough observed data -> continue\n72\t        if len(data_blocks) == 0:\n73\t            continue\n74\t\n75\t        # Calculate CRPS over intervals\n76\t        crps_values = sum_crps_over_blocks(\n77\t            simulated_changes,\n78\t            real_changes,\n79\t            data_blocks,\n80\t            absolute_price,\n81\t            real_price_path,\n82\t        )\n83\t\n84\t        # Total CRPS for this interval\n85\t        total_crps_interval = float(crps_values)\n86\t        sum_all_scores += total_crps_interval\n87\t        if is_gap:\n88\t            # Individual *_gaps intervals are folded into the single \"Gaps\"\n89\t            # Total appended below\n90\t            gap_total_crps += total_crps_interval\n91\t            continue\n92\t\n93\t        detailed_crps_data.append(\n94\t            {\n95\t                \"Interval\": interval_name,\n96\t                \"Increment\": \"Total\",\n97\t                \"CRPS\": total_crps_interval,\n98\t            }\n99\t        )\n100\t\n101\t    if gap_total_crps > 0:\n102\t        detailed_crps_data.append(\n103\t            {\"Interval\": \"Gaps\", \"Increment\": \"Total\", \"CRPS\": gap_total_crps}\n104\t        )\n105\t\n106\t    detailed_crps_data.append(\n107\t        {\"Interval\": \"Overall\", \"Increment\": \"Total\", \"CRPS\": sum_all_scores}\n108\t    )\n109\t\n110\t    return sum_all_scores, detailed_crps_data\n111\t\n112\t\n113\tdef calculate_vol_crps_for_miner(\n114\t    simulation_runs: np.ndarray,\n115\t    real_price_path: np.ndarray,\n116\t    time_increment: int,\n117\t    vol_scoring_blocks: dict[str, tuple[int, float]],\n118\t) -> tuple[float, list[dict]]:\n119\t    \"\"\"\n120\t    Calculate the weighted volatility CRPS for a miner's simulations.\n121\t\n122\t    The path is cut into consecutive blocks of each configured size, the\n123\t    realized volatility of every block is scored against the ensemble of\n124\t    simulated block volatilities, and the per-block CRPS values are summed\n125\t    and scaled by that block size's weight.\n126\t\n127\t    Parameters:\n128\t        simulation_runs (numpy.ndarray): Simulated price paths.\n129\t        real_price_path (numpy.ndarray): The real price path.\n130\t        time_increment (int): Time increment in seconds.\n131\t        vol_scoring_blocks (dict): Dictionary of block sizes with their names,\n132\t            durations in seconds and weights.\n133\t\n134\t    Returns:\n135\t        float: Sum of the weighted volatility CRPS over the block sizes.\n136\t    \"\"\"\n137\t    detailed_crps_data: list[dict] = []\n138\t    sum_all_scores = 0.0\n139\t\n140\t    for name, (block_seconds, weight) in vol_scoring_blocks.items():\n141\t        block_steps = get_interval_steps(block_seconds, time_increment)\n142\t\n143\t        simulated_vol = block_volatilities(simulation_runs, block_steps)\n144\t        real_vol = block_volatilities(\n145\t            real_price_path.reshape(1, -1), block_steps\n146\t        )[0]\n147\t        observed_blocks = np.flatnonzero(~np.isnan(real_vol))\n148\t\n149\t        # Not enough observed data -> continue\n150\t        if observed_blocks.size == 0:\n151\t            continue\n152\t\n153\t        crps_sum = float(\n154\t            sum(\n155\t                crps_ensemble(real_vol[block], simulated_vol[:, block])\n156\t                for block in observed_blocks\n157\t            )\n158\t        )\n159\t        sum_all_scores += weight * crps_sum\n160\t\n161\t        detailed_crps_data.append(\n162\t            {\n163\t                \"Interval\": name,\n164\t                \"Increment\": \"Total\",\n165\t                \"CRPS\": crps_sum,\n166\t                \"Weight\": weight,\n167\t            }\n168\t        )\n169\t\n170\t    detailed_crps_data.append(\n171\t        {\"Interval\": \"Vol\", \"Increment\": \"Total\", \"CRPS\": sum_all_scores}\n172\t    )\n173\t\n174\t    return sum_all_scores, detailed_crps_data\n175\t\n176\t\n177\tdef calculate_total_score_for_miner(\n178\t    simulation_runs: np.ndarray,\n179\t    real_price_path: np.ndarray,\n180\t    time_increment: int,\n181\t    scoring_intervals: dict[str, int],\n182\t    vol_scoring_blocks: dict[str, tuple[int, float]],\n183\t) -> tuple[float, list[dict]]:\n184\t    \"\"\"\n185\t    Calculate a miner's total score: the price CRPS plus the weighted\n186\t    volatility CRPS. A competition with no volatility blocks scores on the\n187\t    price CRPS alone.\n188\t\n189\t    Returns:\n190\t        float: The total score.\n191\t    \"\"\"\n192\t    price_score, detailed_crps_data = calculate_crps_for_miner(\n193\t        simulation_runs, real_price_path, time_increment, scoring_intervals\n194\t    )\n195\t\n196\t    # -1 is the rejection sentinel of the price pass, which also owns the\n197\t    # zero-price guard the volatility blocks depend on: never add to it.\n198\t    if not vol_scoring_blocks or price_score == -1.0:\n199\t        return price_score, detailed_crps_data\n200\t\n201\t    vol_score, detailed_vol_data = calculate_vol_crps_for_miner(\n202\t        simulation_runs, real_price_path, time_increment, vol_scoring_blocks\n203\t    )\n204\t    total_score = price_score + vol_score\n205\t\n206\t    # \"Overall\" holds the score actually returned and stays the last row.\n207\t    detailed_data = [\n208\t        row for row in detailed_crps_data if row[\"Interval\"] != \"Overall\"\n209\t    ]\n210\t    detailed_data += detailed_vol_data\n211\t    detailed_data.append(\n212\t        {\"Interval\": \"Overall\", \"Increment\": \"Total\", \"CRPS\": total_score}\n213\t    )\n214\t\n215\t    return total_score, detailed_data\n216\t\n217\t\n218\tdef sum_crps_over_blocks(\n219\t    simulated_changes: np.ndarray,\n220\t    real_changes: np.ndarray,\n221\t    data_blocks: np.ndarray,\n222\t    absolute_price: bool,\n223\t    real_price_path: np.ndarray,\n224\t) -> float:\n225\t    \"\"\"\n226\t    Sum the CRPS over the observed (non-missing) blocks of a single interval.\n227\t    \"\"\"\n228\t    crps_values = 0.0\n229\t    for block in np.unique(data_blocks):\n230\t        # skip missing value blocks\n231\t        if block == -1:\n232\t            continue\n233\t\n234\t        mask = data_blocks == block\n235\t        simulated_changes_block = simulated_changes[:, mask]\n236\t        real_changes_block = real_changes[0, mask]  # 1D array now\n237\t        num_intervals = simulated_changes_block.shape[1]\n238\t\n239\t        # Calculate all CRPS values at once\n240\t        crps_values_block = np.array(\n241\t            [\n242\t                crps_ensemble(\n243\t                    real_changes_block[t], simulated_changes_block[:, t]\n244\t                )\n245\t                for t in range(num_intervals)\n246\t            ]\n247\t        )\n248\t\n249\t        if absolute_price:\n250\t            crps_values_block = (\n251\t                crps_values_block / real_price_path[-1] * 10_000\n252\t            )\n253\t\n254\t        crps_values += float(crps_values_block.sum())\n255\t\n256\t    return float(crps_values)\n257\t\n258\t\n259\tdef label_observed_blocks(arr: np.ndarray) -> np.ndarray:\n260\t    \"\"\"\n261\t    Groups blocks of consecutive observed data together.\n262\t    Example input/output:\n263\t    [1.0, 2.0, np.nan, 4.0, np.nan, np.nan, 7.0, 8.0] -> [0, 0, -1, 1, -1, -1, 2, 2]\n264\t    \"\"\"\n265\t    not_nan = ~np.isnan(arr)\n266\t    block_start = not_nan & np.concatenate(([True], ~not_nan[:-1]))\n267\t    group_numbers = np.cumsum(block_start) - 1\n268\t    group_labels = np.where(not_nan, group_numbers, -1)\n269\t    return group_labels\n270\t\n271\t\n272\tdef calculate_price_changes_over_intervals(\n273\t    price_paths: np.ndarray,\n274\t    interval_steps: int,\n275\t    absolute_price=False,\n276\t    is_gap=False,\n277\t) -> np.ndarray:\n278\t    \"\"\"\n279\t    Calculate price changes over specified intervals.\n280\t\n281\t    Parameters:\n282\t        price_paths (numpy.ndarray): Array of simulated price paths.\n283\t        interval_steps (int): Number of steps that make up the interval.\n284\t        absolute_price (bool): If True, absolute price values (rather than price changes) are returned.\n285\t\n286\t    Returns:\n287\t        numpy.ndarray: Array of price changes over intervals.\n288\t    \"\"\"\n289\t    # Get the prices at the interval points\n290\t    # [1, 2, 3, 4, 5, 6, 7] -> [1, 3, 5, 7] if interval_steps is 2\n291\t    interval_prices = price_paths[:, ::interval_steps]\n292\t    if is_gap:\n293\t        # [1, 2, 3, 4, 5, 6, 7] -> [1, 3] if interval_steps is 2\n294\t        interval_prices = interval_prices[:, :2]\n295\t\n296\t    # Calculate price changes over intervals\n297\t    if absolute_price:\n298\t        return interval_prices[:, 1:]\n299\t\n300\t    return (\n301\t        np.diff(interval_prices, axis=1) / interval_prices[:, :-1]\n302\t    ) * 10_000\n303\t\n304\t\n305\tdef block_volatilities(\n306\t    price_paths: np.ndarray, block_steps: int\n307\t) -> np.ndarray:\n308\t    \"\"\"\n309\t    Calculate the volatility of each consecutive block of a price path.\n310\t\n311\t    Parameters:\n312\t        price_paths (numpy.ndarray): Array of price paths.\n313\t        block_steps (int): Number of steps that make up a block.\n314\t\n315\t    Returns:\n316\t        numpy.ndarray: Standard deviation, in basis points, of the step\n317\t        returns inside each block. A block with fewer than two observed\n318\t        returns is NaN so that it can be skipped; the steps left over after\n319\t        the last whole block are dropped.\n320\t    \"\"\"\n321\t    returns = (np.diff(price_paths, axis=1) / price_paths[:, :-1]) * 10_000\n322\t\n323\t    n_blocks = returns.shape[1] // block_steps\n324\t    blocks = returns[:, : n_blocks * block_steps].reshape(\n325\t        returns.shape[0], n_blocks, block_steps\n326\t    )\n327\t\n328\t    # Only the scorable blocks go through nanstd: it warns on a block with\n329\t    # fewer than two observed returns, which is the tolerated case here.\n330\t    scorable = np.sum(~np.isnan(blocks), axis=2) >= 2\n331\t    volatilities: np.ndarray = np.full(scorable.shape, np.nan)\n332\t    volatilities[scorable] = np.nanstd(blocks[scorable], axis=1, ddof=1)\n333\t\n334\t    return volatilities"}
{"role":"tool","tool_call_id":"Read_18_167e6d73","content":"1\t\"\"\"Backtest orchestration: one asset (backtest) and a whole competition (run_backtest).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\n6\tfrom datetime import datetime, timedelta\n7\tfrom pathlib import Path\n8\tfrom time import perf_counter\n9\tfrom typing import Any\n10\t\n11\timport numpy as np\n12\timport pandas as pd\n13\t\n14\tfrom synth.validator.competition_config import ALL_COMPETITIONS, CompetitionConfig\n15\t\n16\tfrom synth_lib.backtester.caveats import (\n17\t    _maybe_warn_competition_split,\n18\t    _maybe_warn_hf_crps_formula_change,\n19\t    _maybe_warn_latest_formula,\n20\t)\n21\tfrom synth_lib.backtester.config import (\n22\t    OUTLIER_CAP_DATE,\n23\t    DEFAULT_MINER_OUTPUT_ROOT,\n24\t    PREDICTION_MATCH_TOLERANCE_MINUTES,\n25\t    SCORING_INTERVALS,\n26\t    UTC,\n27\t    _COMBINED_EMPTY_COLS,\n28\t    competition_for,\n29\t    slug_for,\n30\t)\n31\tfrom synth_lib.backtester.loading import (\n32\t    download_price_data,\n33\t    get_miner_scores,\n34\t    get_rewards_history,\n35\t)\n36\tfrom synth_lib.backtester.preparation import (\n37\t    _fill_gaps_from_realized_paths,\n38\t    _find_prediction_file,\n39\t    _slice_real_prices,\n40\t    build_prediction_index,\n41\t)\n42\tfrom synth_lib.backtester.plots.crps import (\n43\t    plot_crps_by_day,\n44\t    plot_crps_by_hour,\n45\t    plot_crps_over_time,\n46\t    plot_crps_ratio_distribution,\n47\t    plot_weekly_percentile,\n48\t)\n49\tfrom synth_lib.backtester.plots.earnings import (\n50\t    plot_estimated_earnings,\n51\t    plot_grand_total_earnings,\n52\t)\n53\tfrom synth_lib.backtester.plots.rank import (\n54\t    plot_grand_total_rank_evolution,\n55\t    plot_rank_evolution,\n56\t    plot_total_rank_evolution,\n57\t)\n58\tfrom synth_lib.backtester.result import BacktestResult, NoScoresAvailable\n59\tfrom synth_lib.backtester.scoring import (\n60\t    Registrations,\n61\t    _compute_prompt_score_stats_for_group,\n62\t    _score_single_prompt,\n63\t    _trim_warmup,\n64\t    calculate_smoothed_scores,\n65\t    compute_combined_smoothed_scores,\n66\t)\n67\t\n68\t\n69\tdef _realized_coverage(prompts: list[dict]) -> dict[str, object]:\n70\t    \"\"\"How much of each prompt's realized path actually carries a price.\n71\t\n72\t    A prompt's CRPS is a sum over its scoring points and NaN points are dropped, so a realized path\n73\t    with holes yields a SMALLER sum — a better-looking score from a thinner reference, not a better\n74\t    model. The shrinkage does not show in mean_crps, which is why it is reported beside it: two runs\n75\t    of the same champion over the same window are comparable only at equal coverage.\n76\t    \"\"\"\n77\t    expected = scored = 0\n78\t    for prompt in prompts:\n79\t        if prompt[\"file_path\"] is None:\n80\t            continue  # no prediction at all — num_prompts already counts that, it is not coverage\n81\t        expected += prompt[\"time_length\"] // prompt[\"time_increment\"] + 1\n82\t        scored += int(np.isfinite(np.asarray(prompt[\"real_prices\"], dtype=float)).sum())\n83\t    return {\n84\t        \"realized_points_expected\": expected,\n85\t        \"realized_points_scored\": scored,\n86\t        \"realized_coverage\": (scored / expected) if expected else None,\n87\t    }\n88\t\n89\t\n90\tdef _score_prompts(\n91\t    prompts: list[dict[str, Any]],\n92\t    scoring_intervals: dict[str, int],\n93\t    competition: CompetitionConfig,\n94\t    miner_id: int,\n95\t    latest_formula: bool,\n96\t    scoring_executor: ProcessPoolExecutor | None,\n97\t) -> pd.DataFrame:\n98\t    \"\"\"One CRPS row per prompt, in parallel when an executor is given.\"\"\"\n99\t    work_items = [\n100\t        (\n101\t            prompt[\"file_path\"],\n102\t            prompt[\"start_time\"],\n103\t            prompt[\"asset\"],\n104\t            prompt[\"scored_time\"],\n105\t            prompt[\"time_length\"],\n106\t            prompt[\"time_increment\"],\n107\t            prompt[\"real_prices\"],\n108\t            scoring_intervals,\n109\t            competition.vol_scoring_blocks,\n110\t            miner_id,\n111\t            latest_formula,\n112\t        )\n113\t        for prompt in prompts\n114\t    ]\n115\t    if scoring_executor is not None:\n116\t        futures = [scoring_executor.submit(_score_single_prompt, *item) for item in work_items]\n117\t        raw_results = [f.result() for f in futures]\n118\t    else:\n119\t        raw_results = [_score_single_prompt(*item) for item in work_items]\n120\t    return pd.concat([pd.DataFrame(r, index=[0]) for r in raw_results], ignore_index=True)\n121\t\n122\t\n123\tdef backtest(\n124\t    miner_name: str = \"initial_research\",\n125\t    asset: str = \"BTC\",\n126\t    *,\n127\t    time_length: int,\n128\t    time_increment: int | None = None,\n129\t    n_backtest_days: int = 15,\n130\t    miner_id: int = 999,\n131\t    predictions_dir: Path | None = None,\n132\t    scoring_intervals: dict[str, int] | None = None,\n133\t    competition: CompetitionConfig | None = None,\n134\t    scoring_executor: ProcessPoolExecutor | None = None,\n135\t    eval_end: datetime | None = None,\n136\t    simulate_registration: datetime | None = None,\n137\t    simulate_deregistration: datetime | None = None,\n138\t    registrations: Registrations | None = None,\n139\t    match_tolerance_minutes: int = PREDICTION_MATCH_TOLERANCE_MINUTES,\n140\t    latest_formula: bool = False,\n141\t) -> BacktestResult:\n142\t    \"\"\"Backtest a local miner against Synth subnet scoring data.\n143\t    Loads predictions from predictions_dir (or miner_outputs/{miner_name}/predictions/).\n144\t    `registrations` (uid -> registration time(s) of its occupants inside the data, see\n145\t    `get_registrations`) scores each field uid that changed hands as the miners live sees.\n146\t    A scored prompt is answered by the latest prediction starting at or before it, at most\n147\t    `match_tolerance_minutes` earlier; predictions on a grid pass its cadence.\n148\t    `latest_formula` scores every prompt with the latest crypto-1h formula instead of the one live\n149\t    when it was scored: CRPS then compares across the change, field ranks before it do not.\n150\t    \"\"\"\n151\t    if competition is None:\n152\t        competition = competition_for(asset, time_length)\n153\t    if time_increment is None:\n154\t        time_increment = competition.time_increment\n155\t    if scoring_intervals is None:\n156\t        scoring_intervals = competition.scoring_intervals\n157\t\n158\t    # Discover predictions and their date range\n159\t    predictions_root = predictions_dir or (DEFAULT_MINER_OUTPUT_ROOT / miner_name / \"predictions\")\n160\t    prediction_index = build_prediction_index(predictions_root)\n161\t    pred_times = [t.to_pydatetime() for prompts in prediction_index.values() for t in prompts]\n162\t    if not pred_times:\n163\t        raise FileNotFoundError(\n164\t            f\"No predictions found in {predictions_root}. Expected the day layout \"\n165\t            \"<asset>/<time_length>_<time_increment>/date=*.npy, or one JSON per prompt \"\n166\t            \"named like 2026-03-28_00:00:00Z_BTC_86400.json\"\n167\t        )\n168\t    pred_start = min(pred_times)\n169\t    pred_end = max(pred_times)\n170\t\n171\t    # Constrain backtest window to prediction coverage, scored_time against the first prediction's\n172\t    # start less the default match tolerance, and the last one's horizon plus the match tolerance\n173\t    # (at least an hour): a prediction answers prompts up to that tolerance after its start.\n174\t    # Anchor priority: simulate_deregistration > eval_end > now. When the user passes\n175\t    # simulate_registration, the window's lower bound shifts to it (minus 10d for the\n176\t    # smoothed-score moving-average lookback) instead of `anchor − n_backtest_days`,\n177\t    # so the API actually fetches scored prompts in the simulated mining period.\n178\t    if simulate_deregistration is not None:\n179\t        anchor = pd.Timestamp(simulate_deregistration).to_pydatetime()\n180\t    elif eval_end is not None:\n181\t        anchor = eval_end\n182\t    else:\n183\t        anchor = datetime.now(UTC)\n184\t    if simulate_registration is not None:\n185\t        window_start = pd.Timestamp(simulate_registration).to_pydatetime() - timedelta(days=competition.window_days)\n186\t    else:\n187\t        window_start = anchor - timedelta(days=n_backtest_days)\n188\t    if simulate_registration is not None:\n189\t        # The field has to be fetched from before the candidate existed: its ABSENCE there is what\n190\t        # makes the moving average treat it as a late joiner. Clamping to prediction coverage would\n191\t        # shorten the lookback to one horizon, and the backfill with it.\n192\t        query_start = window_start\n193\t    else:\n194\t        query_start = max(\n195\t            pred_start - timedelta(minutes=PREDICTION_MATCH_TOLERANCE_MINUTES),\n196\t            window_start,\n197\t        )\n198\t    query_end = pred_end + timedelta(seconds=time_length) + timedelta(minutes=max(60, match_tolerance_minutes))\n199\t\n200\t    # Step 2: fetch existing miner scores\n201\t    asset_backtest = asset\n202\t    time_length_backtest = time_length\n203\t    prompt_label = slug_for(competition)\n204\t    log_prefix = f\"  [{prompt_label}/{asset_backtest}]\"\n205\t    t_start = perf_counter()\n206\t\n207\t    print(\n208\t        f\"{log_prefix} fetching scored prompts ({query_start.date()} → {min(query_end, anchor).date()})...\",\n209\t        flush=True,\n210\t    )\n211\t    asset_scores = get_miner_scores(\n212\t        start_time=query_start,\n213\t        end_time=min(query_end, anchor),\n214\t        asset=asset_backtest,\n215\t        time_length=time_length_backtest,\n216\t        time_increment=time_increment,\n217\t    )\n218\t    if asset_scores.empty:\n219\t        raise NoScoresAvailable(\n220\t            f\"no scored prompts for asset={asset_backtest}, \"\n221\t            f\"time_length={time_length_backtest}, range=[{query_start}, {query_end}]\"\n222\t        )\n223\t    print(\n224\t        f\"{log_prefix} {len(asset_scores)} score rows ({asset_scores['scored_time'].nunique()} prompts) \"\n225\t        f\"in {perf_counter()-t_start:.1f}s\",\n226\t        flush=True,\n227\t    )\n228\t    if latest_formula:\n229\t        _maybe_warn_latest_formula(competition, asset_scores[\"scored_time\"].min())\n230\t\n231\t    # Step 3: fetch rewards history\n232\t    prompt_name = None if not time_length_backtest else prompt_label\n233\t    t_rh = perf_counter()\n234\t    print(\n235\t        f\"{log_prefix} fetching rewards history (prompt_name={prompt_name})...\",\n236\t        flush=True,\n237\t    )\n238\t    rewards_history = get_rewards_history(\n239\t        asset_scores[\"scored_time\"].min() - pd.Timedelta(hours=24),\n240\t        asset_scores[\"scored_time\"].max() + pd.Timedelta(hours=24),\n241\t        prompt_name=prompt_name,\n242\t    )\n243\t    if rewards_history.empty:\n244\t        raise RuntimeError(\n245\t            f\"Synth API returned no rewards history for prompt_name={prompt_name}, \"\n246\t            f\"range=[{asset_scores['scored_time'].min()}, {asset_scores['scored_time'].max()}]\"\n247\t        )\n248\t    print(\n249\t        f\"{log_prefix} {len(rewards_history)} rewards rows \"\n250\t        f\"({rewards_history['updated_at'].nunique()} update rounds) in {perf_counter()-t_rh:.1f}s\",\n251\t        flush=True,\n252\t    )\n253\t\n254\t    # Step 4: align scores and rewards history time ranges\n255\t    if asset_backtest is not None:\n256\t        asset_scores = asset_scores.sort_values(\"scored_time\")\n257\t        rewards_history = rewards_history.sort_values(\"updated_at\")\n258\t\n259\t        result = pd.merge_asof(\n260\t            asset_scores[[\"scored_time\"]].drop_duplicates(),\n261\t            rewards_history[[\"updated_at\"]].drop_duplicates(),\n262\t            left_on=\"scored_time\",\n263\t            right_on=\"updated_at\",\n264\t            direction=\"forward\",\n265\t        )\n266\t        result = result[~result[\"updated_at\"].isna()]\n267\t        rewards_history = rewards_history.loc[rewards_history[\"updated_at\"].isin(result[\"updated_at\"])].copy()\n268\t        asset_scores = asset_scores.loc[asset_scores[\"scored_time\"].isin(result[\"scored_time\"])].copy()\n269\t    else:\n270\t        if rewards_history[\"updated_at\"].max() < asset_scores[\"scored_time\"].max():\n271\t            max_scored_time = asset_scores.loc[\n272\t                asset_scores[\"scored_time\"] <= rewards_history[\"updated_at\"].max(),\n273\t                \"scored_time\",\n274\t            ].max()\n275\t            asset_scores = asset_scores.loc[asset_scores[\"scored_time\"] <= max_scored_time].copy()\n276\t        elif rewards_history[\"updated_at\"].max() > asset_scores[\"scored_time\"].max():\n277\t            max_upd_at = rewards_history.loc[\n278\t                rewards_history[\"updated_at\"] >= asset_scores[\"scored_time\"].max(),\n279\t                \"updated_at\",\n280\t            ].min()\n281\t            rewards_history = rewards_history.loc[rewards_history[\"updated_at\"] <= max_upd_at].copy()\n282\t\n283\t    # Step 5: download asset price data, up to the last prompt's end\n284\t    asset_prices: dict[str, pd.DataFrame] = {}\n285\t    for asset_ in asset_scores[\"asset\"].unique():\n286\t        st_ = asset_scores[\"start_time\"].min() - pd.Timedelta(hours=2)\n287\t        en_ = asset_scores[\"start_time\"].max() + pd.Timedelta(seconds=time_length)\n288\t        asset_prices[asset_] = download_price_data(st_, en_, asset_, freq=\"1min\")\n289\t\n290\t    # Step 6: score LLM miner predictions\n291\t    start_times = asset_scores[\"start_time\"].sort_values().unique()\n292\t    t_score = perf_counter()\n293\t    print(\n294\t        f\"{log_prefix} scoring {len(start_times)} prompts against local predictions...\",\n295\t        flush=True,\n296\t    )\n297\t\n298\t    # Pre-build work items: resolve file paths and slice prices upfront\n299\t    prompts: list[dict[str, Any]] = []\n300\t\n301\t    for start_time in start_times:\n302\t        scores_subset = asset_scores.loc[asset_scores[\"start_time\"] == start_time].copy()\n303\t\n304\t        for _, asset_val, scored_time, time_len, time_incr in (\n305\t            scores_subset[[\"asset\", \"scored_time\", \"time_length\", \"time_increment\"]].drop_duplicates().itertuples()\n306\t        ):\n307\t            file_path = _find_prediction_file(\n308\t                prediction_index, start_time, asset_val, time_len, match_tolerance_minutes\n309\t            )\n310\t\n311\t            # Pre-slice real prices in the main process (avoids pickling DataFrames)\n312\t            real_prices: list[float] = []\n313\t            if file_path is not None:\n314\t                real_prices = _slice_real_prices(asset_prices[asset_val], start_time, time_len, time_incr)\n315\t\n316\t            prompts.append(\n317\t                {\n318\t                    \"file_path\": file_path,\n319\t                    \"start_time\": start_time,\n320\t                    \"asset\": asset_val,\n321\t                    \"scored_time\": scored_time,\n322\t                    \"time_length\": time_len,\n323\t                    \"time_increment\": time_incr,\n324\t                    \"real_prices\": real_prices,\n325\t                }\n326\t            )\n327\t\n328\t    _fill_gaps_from_realized_paths(prompts, log_prefix)\n329\t    realized_coverage = _realized_coverage(prompts)\n330\t\n331\t    # Step 7: concatenate LLM miner scores\n332\t    if not prompts:\n333\t        raise RuntimeError(\n334\t            \"No prediction files matched any scored prompt. \"\n335\t            \"Check that prediction filenames align with the scored time range.\"\n336\t        )\n337\t    new_scores = _score_prompts(prompts, scoring_intervals, competition, miner_id, latest_formula, scoring_executor)\n338\t    print(\n339\t        f\"{log_prefix} scored {len(new_scores)} prompts in {perf_counter()-t_score:.1f}s\",\n340\t        flush=True,\n341\t    )\n342\t\n343\t    # Step 8: trim to valid range\n344\t    new_scores = new_scores.sort_values(\"scored_time\")\n345\t    valid_scores = new_scores.loc[new_scores[\"crps\"] != -1]\n346\t    if valid_scores.empty:\n347\t        raise RuntimeError(\n348\t            \"All matched predictions resulted in crps=-1 (scoring failures). \" \"No valid backtest results to report.\"\n349\t        )\n350\t    end_backtest_time = valid_scores[\"scored_time\"].max()\n351\t    new_scores = new_scores.loc[new_scores[\"scored_time\"] <= end_backtest_time]\n352\t    asset_scores = asset_scores.loc[asset_scores[\"scored_time\"] <= end_backtest_time]\n353\t\n354\t    # Optional: simulate the miner registering on a specific date by dropping our\n355\t    # CRPS rows for the prompts issued before that date: a miner answers only the\n356\t    # prompts sent once it is registered, so its first score lands a horizon later.\n357\t    # synth.validator.prepare_df_for_moving_average then sees our miner's first\n358\t    # scored_time > global_min and applies the same worst-score backfill it gives\n359\t    # real late-joining miners — making rank comparisons symmetric instead of giving\n360\t    # us an unfair \"from-the-start\" boost.\n361\t    if simulate_registration is not None:\n362\t        sim_reg = pd.Timestamp(simulate_registration)\n363\t        new_scores = new_scores.loc[new_scores[\"start_time\"] >= sim_reg]\n364\t        if new_scores.empty:\n365\t            raise RuntimeError(\n366\t                f\"simulate_registration={sim_reg} drops all of our miner's CRPS rows; \" f\"no valid backtest results.\"\n367\t            )\n368\t    if simulate_deregistration is not None:\n369\t        sim_dereg = pd.Timestamp(simulate_deregistration)\n370\t        new_scores = new_scores.loc[new_scores[\"scored_time\"] <= sim_dereg]\n371\t        if new_scores.empty:\n372\t            raise RuntimeError(\n373\t                f\"simulate_deregistration={sim_dereg} drops all of our miner's CRPS rows; \"\n374\t                f\"no valid backtest results.\"\n375\t            )\n376\t\n377\t    # Step 9: merge LLM scores with all miner scores\n378\t    all_scores = pd.concat([asset_scores, new_scores], ignore_index=True)\n379\t    all_scores = all_scores.sort_values([\"scored_time\", \"miner_uid\"])\n380\t\n381\t    if rewards_history[\"updated_at\"].max() < all_scores[\"scored_time\"].max():\n382\t        max_scored_time = all_scores.loc[\n383\t            all_scores[\"scored_time\"] <= rewards_history[\"updated_at\"].max(),\n384\t            \"scored_time\",\n385\t        ].max()\n386\t        all_scores = all_scores.loc[all_scores[\"scored_time\"] <= max_scored_time].copy()\n387\t    elif rewards_history[\"updated_at\"].max() > all_scores[\"scored_time\"].max():\n388\t        max_upd_at = rewards_history.loc[\n389\t            rewards_history[\"updated_at\"] >= all_scores[\"scored_time\"].max(),\n390\t            \"updated_at\",\n391\t        ].min()\n392\t        rewards_history = rewards_history.loc[rewards_history[\"updated_at\"] <= max_upd_at].copy()\n393\t\n394\t    # Step 12: apply prompt score calculation across all scores. We also persist\n395\t    # percentile95 and lowest_score per group because prepare_df_for_moving_average\n396\t    # uses them to compute the worst-score backfill for new miners (silently\n397\t    # skips backfill when those columns are absent).\n398\t    # Split on the outlier-cap cutover before grouping. scored_time is a group key, so every row\n399\t    # in a group is on the same side and no group is ever split by this.\n400\t    keys = [\"scored_time\", \"asset\", \"time_length\", \"time_increment\"]\n401\t    capped_era = pd.to_datetime(all_scores[\"scored_time\"], utc=True) >= OUTLIER_CAP_DATE\n402\t    parts = [\n403\t        all_scores.loc[mask]\n404\t        .groupby(keys, group_keys=False)[\"crps\"]\n405\t        .apply(_compute_prompt_score_stats_for_group, capped_era=era)\n406\t        for era, mask in ((True, capped_era), (False, ~capped_era))\n407\t        if mask.any()\n408\t    ]\n409\t    _stats = pd.concat(parts).reindex(all_scores.index)\n410\t    all_scores[\"new_prompt_scores\"] = _stats[\"new_prompt_scores\"]\n411\t    all_scores[\"percentile95\"] = _stats[\"percentile95\"]\n412\t    all_scores[\"lowest_score\"] = _stats[\"lowest_score\"]\n413\t\n414\t    # Step 13: build rewards history entries for LLM miner\n415\t    new_miner_rewards_list = []\n416\t    for prompt_name_item in rewards_history[\"prompt_name\"].unique():\n417\t        new_miner_rewards_prompt = pd.DataFrame(\n418\t            {\n419\t                \"updated_at\": rewards_history.loc[rewards_history[\"prompt_name\"] == prompt_name_item, \"updated_at\"]\n420\t                .sort_values()\n421\t                .unique(),\n422\t                \"miner_uid\": miner_id,\n423\t                \"prompt_name\": prompt_name_item,\n424\t            }\n425\t        )\n426\t        new_miner_rewards_list.append(new_miner_rewards_prompt)\n427\t    new_miner_rewards = pd.concat(new_miner_rewards_list, ignore_index=True).sort_values(\"updated_at\")\n428\t\n429\t    # Step 14: merge LLM miner rewards into full rewards history\n430\t    rewards_history = pd.concat(\n431\t        [\n432\t            rewards_history,\n433\t            new_miner_rewards,\n434\t        ]\n435\t    ).sort_values([\"updated_at\", \"prompt_name\", \"miner_uid\"])\n436\t\n437\t    # Step 15: recalculate smoothed scores including LLM miner\n438\t    n_rounds = rewards_history[\"updated_at\"].nunique()\n439\t    t_smooth = perf_counter()\n440\t    print(\n441\t        f\"{log_prefix} computing smoothed scores over {n_rounds} reward rounds...\",\n442\t        flush=True,\n443\t    )\n444\t    recalculated_smoothed_scores = calculate_smoothed_scores(\n445\t        all_scores,\n446\t        rewards_history,\n447\t        cutoff_days=competition.window_days,\n448\t        scores_column=\"new_prompt_scores\",\n449\t        competition=competition,\n450\t        registrations=registrations,\n451\t    )\n452\t    print(\n453\t        f\"{log_prefix} smoothed scores done in {perf_counter()-t_smooth:.1f}s \"\n454\t        f\"(total backtest: {perf_counter()-t_start:.1f}s)\",\n455\t        flush=True,\n456\t    )\n457\t\n458\t    # Trim the first `competition.window_days` of smoothed_scores when no\n459\t    # simulate_registration is set. In that case the backfill artifact applies to\n460\t    # real late-joining miners and inflates our rank — we want to hide it.\n461\t    # When simulate_registration IS set, the backfill applies to OUR miner and\n462\t    # the warmup ramp-up is the whole point of the simulation — don't trim it.\n463\t    if simulate_registration is None:\n464\t        recalculated_smoothed_scores = _trim_warmup(\n465\t            recalculated_smoothed_scores,\n466\t            all_scores,\n467\t            warmup_days=competition.window_days,\n468\t        )\n469\t\n470\t    miner_smoothed = recalculated_smoothed_scores.loc[\n471\t        recalculated_smoothed_scores[\"miner_uid\"] == miner_id, \"new_smoothed_score\"\n472\t    ]\n473\t    summary: dict[str, Any] = {\n474\t        \"miner_name\": miner_name,\n475\t        \"miner_id\": miner_id,\n476\t        \"num_prompts\": int((new_scores[\"crps\"] != -1).sum()),\n477\t        \"mean_crps\": float(new_scores.loc[new_scores[\"crps\"] != -1, \"crps\"].mean()),\n478\t        \"final_smoothed_score\": (float(miner_smoothed.iloc[-1]) if not miner_smoothed.empty else None),\n479\t        **realized_coverage,\n480\t    }\n481\t\n482\t    return BacktestResult(\n483\t        miner_name=miner_name,\n484\t        prompt_df=all_scores,\n485\t        smoothed_scores=recalculated_smoothed_scores,\n486\t        summary=summary,\n487\t    )\n488\t\n489\t\n490\tdef score_crps(\n491\t    miner_name: str = \"initial_research\",\n492\t    asset: str = \"BTC\",\n493\t    *,\n494\t    time_length: int,\n495\t    time_increment: int | None = None,\n496\t    miner_id: int = 999,\n497\t    predictions_dir: Path | None = None,\n498\t    competition: CompetitionConfig | None = None,\n499\t    scoring_executor: ProcessPoolExecutor | None = None,\n500\t    latest_formula: bool = True,\n501\t) -> BacktestResult:\n502\t    \"\"\"Each prediction's CRPS against the local store's prices, without the field: no rank, no API.\n503\t\n504\t    Every prediction is a prompt at its own start time, scored one horizon later with the\n505\t    validator's CRPS, crypto-1h's latest formula unless `latest_formula` is False. It works on any\n506\t    window the store covers, including where no field scores exist. The reference is the store's\n507\t    closes only, never the validator's realized path: a minute without a price drops out of the\n508\t    sum, which `realized_coverage` reports, and a prediction whose path holds no price after its\n509\t    start is left out. `smoothed_scores` is empty.\n510\t    \"\"\"\n511\t    if competition is None:\n512\t        competition = competition_for(asset, time_length)\n513\t    if time_increment is None:\n514\t        time_increment = competition.time_increment\n515\t    predictions_root = predictions_dir or (DEFAULT_MINER_OUTPUT_ROOT / miner_name / \"predictions\")\n516\t    predictions = sorted(build_prediction_index(predictions_root).get((asset, time_length), {}).items())\n517\t    if not predictions:\n518\t        raise FileNotFoundError(f\"No {asset} predictions for time_length={time_length} in {predictions_root}\")\n519\t\n520\t    horizon = pd.Timedelta(seconds=time_length)\n521\t    prices = download_price_data(\n522\t        predictions[0][0] - pd.Timedelta(hours=2), predictions[-1][0] + horizon, asset, freq=\"1min\"\n523\t    )\n524\t    prompts = []\n525\t    for start, ref in predictions:\n526\t        real_prices = _slice_real_prices(prices, start, time_length, time_increment)\n527\t        # A reference with no price after its start scores 0, the best CRPS there is.\n528\t        if not np.isfinite(np.asarray(real_prices[1:], dtype=float)).any():\n529\t            continue\n530\t        prompts.append(\n531\t            {\n532\t                \"file_path\": ref,\n533\t                \"start_time\": start,\n534\t                \"asset\": asset,\n535\t                \"scored_time\": start + horizon,\n536\t                \"time_length\": time_length,\n537\t                \"time_increment\": time_increment,\n538\t                \"real_prices\": real_prices,\n539\t            }\n540\t        )\n541\t    if not prompts:\n542\t        raise ValueError(f\"The store has no {asset} price on the path of any prediction in {predictions_root}\")\n543\t    scores = _score_prompts(\n544\t        prompts, competition.scoring_intervals, competition, miner_id, latest_formula, scoring_executor\n545\t    )\n546\t    answered = scores.loc[scores[\"crps\"] != -1, \"crps\"]\n547\t    return BacktestResult(\n548\t        miner_name=miner_name,\n549\t        prompt_df=scores,\n550\t        smoothed_scores=pd.DataFrame(),\n551\t        summary={\n552\t            \"miner_name\": miner_name,\n553\t            \"miner_id\": miner_id,\n554\t            \"num_prompts\": len(answered),\n555\t            \"mean_crps\": float(answered.mean()),\n556\t            **_realized_coverage(prompts),\n557\t        },\n558\t    )\n559\t\n560\t\n561\tdef run_backtest(\n562\t    miner_name: str,\n563\t    competition: CompetitionConfig,\n564\t    n_backtest_days: int,\n565\t    predictions_dir: Path | None = None,\n566\t    miner_id: int = 999,\n567\t    scoring_executor: ProcessPoolExecutor | None = None,\n568\t    eval_end: datetime | None = None,\n569\t    simulate_registration: datetime | None = None,\n570\t    simulate_deregistration: datetime | None = None,\n571\t    registrations: Registrations | None = None,\n572\t) -> tuple[list[BacktestResult], pd.DataFrame]:\n573\t    \"\"\"Run the full backtest for all assets in a prompt config.\n574\t\n575\t    For each asset: runs backtest, prints rank summary, saves per-asset rank chart.\n576\t    After all assets: saves total rank evolution chart + estimated earnings chart\n577\t    when ≥2 assets succeed.\n578\t\n579\t    Returns (results, combined) where:\n580\t      - results: list of successful BacktestResult (one per asset)\n581\t      - combined: per-profile combined smoothed-scores DataFrame (empty when <2 assets)\n582\t    \"\"\"\n583\t    _maybe_warn_hf_crps_formula_change(\n584\t        competition=competition,\n585\t        n_backtest_days=n_backtest_days,\n586\t        eval_end=eval_end,\n587\t        simulate_registration=simulate_registration,\n588\t        simulate_deregistration=simulate_deregistration,\n589\t    )\n590\t    _maybe_warn_competition_split(\n591\t        competition=competition,\n592\t        n_backtest_days=n_backtest_days,\n593\t        eval_end=eval_end,\n594\t        simulate_registration=simulate_registration,\n595\t        simulate_deregistration=simulate_deregistration,\n596\t    )\n597\t\n598\t    assets = competition.asset_list\n599\t    max_workers = min(len(assets), 6)\n600\t    print(f\"  Dispatching {len(assets)} assets to {max_workers} backtest workers...\")\n601\t\n602\t    # Phase 1: run backtest() for each asset in parallel (I/O-bound: API calls + disk)\n603\t    asset_results: dict[str, BacktestResult] = {}\n604\t    with ThreadPoolExecutor(max_workers=max_workers) as executor:\n605\t        futures = {\n606\t            executor.submit(\n607\t                backtest,\n608\t                miner_name=miner_name,\n609\t                asset=asset,\n610\t                time_length=competition.time_length,\n611\t                time_increment=competition.time_increment,\n612\t                n_backtest_days=n_backtest_days,\n613\t                miner_id=miner_id,\n614\t                predictions_dir=predictions_dir,\n615\t                scoring_intervals=competition.scoring_intervals,\n616\t                competition=competition,\n617\t                scoring_executor=scoring_executor,\n618\t                eval_end=eval_end,\n619\t                simulate_registration=simulate_registration,\n620\t                simulate_deregistration=simulate_deregistration,\n621\t                registrations=registrations,\n622\t            ): asset\n623\t            for asset in assets\n624\t        }\n625\t        for future in as_completed(futures):\n626\t            asset = futures[future]\n627\t            try:\n628\t                asset_results[asset] = future.result()\n629\t            except NoScoresAvailable as e:\n630\t                # Not a failure — the validator isn't prompting this asset here.\n631\t                print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n632\t                print(f\"  SKIPPED: {e}\")\n633\t            except Exception as e:\n634\t                print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n635\t                print(f\"  FAILED: {e}\")\n636\t\n637\t    # Phase 2: print summaries + plot charts sequentially (matplotlib is not thread-safe)\n638\t    results: list[BacktestResult] = []\n639\t    for asset in assets:\n640\t        if asset not in asset_results:\n641\t            continue\n642\t        result = asset_results[asset]\n643\t        results.append(result)\n644\t        summary = result.summary\n645\t\n646\t        print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n647\t        ss = result.smoothed_scores.copy()\n648\t        if not ss.empty:\n649\t            last_ts = ss[\"updated_at\"].max()\n650\t            last_slice = ss.loc[ss[\"updated_at\"] == last_ts]\n651\t            total_miners = len(last_slice)\n652\t            miner_rw = last_slice.loc[last_slice[\"miner_uid\"] == miner_id]\n653\t            if not miner_rw.empty:\n654\t                rank = int(last_slice[\"reward_weight\"].rank(ascending=False, method=\"min\").loc[miner_rw.index[0]])\n655\t                rw = float(miner_rw[\"reward_weight\"].iloc[0])\n656\t                sm = float(summary.get(\"final_smoothed_score\", 0) or 0)\n657\t                print(f\"  rank: {rank}/{total_miners}  reward_weight: {rw:.6f}  smoothed_score: {sm:.2f}\")\n658\t            else:\n659\t                print(f\"  Miner {miner_id} not found in final smoothed scores.\")\n660\t        else:\n661\t            print(f\"  No smoothed scores computed.\")\n662\t\n663\t        print(\n664\t            f\"  Prompts scored: {summary['num_prompts']}  Mean CRPS: {summary['mean_crps']:.6f}\"\n665\t            + (\n666\t                f\"  realized coverage: {summary['realized_coverage'] * 100:.2f}%\"\n667\t                if summary.get(\"realized_coverage\") is not None\n668\t                else \"\"\n669\t            )\n670\t        )\n671\t\n672\t        try:\n673\t            chart_path = plot_rank_evolution(result)\n674\t            print(f\"  Rank chart saved to: {chart_path}\")\n675\t        except (RuntimeError, Exception) as e:\n676\t            print(f\"  Chart generation failed: {e}\")\n677\t\n678\t        try:\n679\t            crps_chart = plot_crps_over_time(result)\n680\t            print(f\"  CRPS chart saved to: {crps_chart}\")\n681\t        except (RuntimeError, Exception) as e:\n682\t            print(f\"  CRPS chart generation failed: {e}\")\n683\t\n684\t        for plot_fn, chart_name in [\n685\t            (plot_crps_by_hour, \"CRPS-by-hour\"),\n686\t            (plot_crps_by_day, \"CRPS-by-day\"),\n687\t            (plot_crps_ratio_distribution, \"CRPS-ratio-dist\"),\n688\t            (plot_weekly_percentile, \"Weekly-percentile\"),\n689\t        ]:\n690\t            try:\n691\t                path = plot_fn(result)\n692\t                print(f\"  {chart_name} chart saved to: {path}\")\n693\t            except (RuntimeError, Exception) as e:\n694\t                print(f\"  {chart_name} chart generation failed: {e}\")\n695\t\n696\t    # Cross-asset charts: compute combined smoothed scores once, share across both charts.\n697\t    combined = pd.DataFrame(columns=_COMBINED_EMPTY_COLS)\n698\t    if len(results) >= 2:\n699\t        try:\n700\t            combined = compute_combined_smoothed_scores(\n701\t                results,\n702\t                competition,\n703\t                simulate_registration=simulate_registration,\n704\t                registrations=registrations,\n705\t            )\n706\t        except Exception as e:\n707\t            print(f\"  Combined smoothed scores failed: {e}\")\n708\t\n709\t        if not combined.empty:\n710\t            try:\n711\t                total_chart = plot_total_rank_evolution(\n712\t                    results,\n713\t                    combined=combined,\n714\t                    profile_label=slug_for(competition),\n715\t                )\n716\t                print(f\"  Total rank chart saved to: {total_chart}\")\n717\t            except Exception as e:\n718\t                print(f\"  Total rank chart failed: {e}\")\n719\t\n720\t            try:\n721\t                earnings_chart = plot_estimated_earnings(\n722\t                    results,\n723\t                    competition=competition,\n724\t                    combined=combined,\n725\t                )\n726\t                print(f\"  Earnings chart saved to: {earnings_chart}\")\n727\t            except Exception as e:\n728\t                print(f\"  Earnings chart failed: {e}\")\n729\t\n730\t    return results, combined"}
{"role":"tool","tool_call_id":"Read_19_85298ac2","content":"1\t\"\"\"Backtester constants, competition slug maps and offline-mode helpers.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport os\n6\tfrom datetime import datetime, timedelta, timezone\n7\tfrom pathlib import Path\n8\t\n9\timport pandas as pd\n10\t\n11\tfrom synth.validator.competition_config import (\n12\t    ALL_COMPETITIONS,\n13\t    COM_EQU_24H,\n14\t    CRYPTO_1H,\n15\t    CRYPTO_24H,\n16\t    CompetitionConfig,\n17\t)\n18\t\n19\t# Miner-dashboard read API (shared host with the monitoring API, /v1 prefix).\n20\tMINER_DASHBOARD_API_BASE = \"https://monitoring.synthdata.co/v1\"\n21\t# Default 24h scoring intervals (crypto-24h / com-equ-24h); only used when no\n22\t# competition is passed to backtest().\n23\tSCORING_INTERVALS: dict[str, int] = {\n24\t    \"5min\": 300,\n25\t    \"30min\": 1_800,\n26\t    \"3hour\": 10_800,\n27\t    \"24hour_abs\": 86_400,\n28\t}\n29\tDEFAULT_MINER_OUTPUT_ROOT = Path(\"miner_outputs\")\n30\t# Unused; MinutePriceStore resolves its own root (preparation.config.default_store_root).\n31\tDEFAULT_MARKET_DATA_ROOT = Path(\"market_data/prices/BTC/1m\")\n32\t_LEGACY_FALLBACK_WINDOW_DAYS = 10  # only used when no competition is in scope\n33\t_COMBINED_EMPTY_COLS = [\n34\t    \"updated_at\",\n35\t    \"miner_uid\",\n36\t    \"new_smoothed_score\",\n37\t    \"reward_weight\",\n38\t]\n39\t\n40\tUTC = timezone.utc\n41\t\n42\t# -- HF CRPS formula change --\n43\t# On 2026-03-11 the Synth validator changed how it computes CRPS for the\n44\t# high-frequency competition (now crypto-1h). CRPS values stored in the API for\n45\t# prompts before that date were produced by the old formula and aren't directly\n46\t# comparable to ranks computed under the current formula. See README \"Known\n47\t# caveats\".\n48\tHF_CRPS_FORMULA_CHANGE_DATE = datetime(2026, 3, 11, tzinfo=UTC)\n49\t\n50\t# When the mainnet validator started adding the volatility term to crypto-1h. A prompt is scored\n51\t# one horizon after it starts, so the formula that applied to it is the one deployed at its\n52\t# `scored_time`, not at its `start_time`: a window containing this instant holds prompts of both\n53\t# kinds, and scoring them all one way puts the candidate and the archived field on different rules.\n54\tVOL_CRPS_1H_DATE = datetime(2026, 9, 22, 13, 16, 32, tzinfo=UTC)\n55\t\n56\t# When the mainnet validator started clipping raw CRPS above 10x the field median and taking\n57\t# the p95 that fills missed responses over the unclipped scores. Same rule as above: the\n58\t# formula that applied to a prompt is the one deployed at its `scored_time`. This one reaches\n59\t# every competition, not just crypto-1h, because it sits in compute_prompt_scores.\n60\tOUTLIER_CAP_DATE = datetime(2026, 9, 4, 9, 45, tzinfo=UTC)  # 11:45 GMT+2\n61\t\n62\t# On-chain emission normalization for the USD earnings estimate. A miner's\n63\t# realized emission is not exactly proportional to the reward_weight the\n64\t# validator sets: Yuma consensus (trust/clipping) and the presence of other\n65\t# neurons flatten realized emissions relative to set weight, so\n66\t# `reward_weight * pool` OVERESTIMATES the USD a competitive miner actually\n67\t# earns. This factor rescales the raw formula to realized emissions.\n68\t#\n69\t# Empirically calibrated against live on-chain data (validate_earnings_formula.py,\n70\t# window 2026-07-04→2026-07-06, all 3 competitions, top-15 miners by actual USD):\n71\t# raw bt/actual SUM = 1414.19/980.97 = 1.442 (a consistent +44-47% overestimate\n72\t# across the top miners), so factor = actual/bt = 0.6935. It is an approximation\n73\t# (per-miner spread ~±a few %; the tail of small miners is under-corrected since\n74\t# realized emission is flatter than set weight) and may drift over time — treat\n75\t# absolute USD as an estimate. 1.0 disables the correction (raw reward-weight USD).\n76\tEMISSION_NORMALIZATION_FACTOR = 0.6935\n77\t\n78\t# The subnet split into 3 competitions (crypto-24h, com-equ-24h, crypto-1h) on\n79\t# this date (first com-equ-24h appearance in /rewards/scores, verified live).\n80\t# Before it the reward structure was 2 profiles (each /2) and com-equ-24h did\n81\t# not exist, so a backtest window predating it mixes incompatible structures.\n82\tCOMPETITION_SPLIT_DATE = datetime(2026, 6, 23, tzinfo=UTC)\n83\t\n84\t# -- Pagination limits (empirical — not confirmed from API docs) --\n85\t# Synth API /validation/scores/historical has a 7-day max range.\n86\t# We use 6-day chunks to stay safely within the limit.\n87\tAPI_SCORES_PAGE_SIZE_DAYS = 1  # /validation/scores/historical: \"to\" = inclusive whole day; >2d spans 400. Endpoint thins crypto-1h prompts to ~10-min density (~144/day, full 256-miner field each) at ANY range size. 1-day pages + drop_duplicates = full accessible coverage.\n88\t\n89\t# /v1/miners/rewards/pool caps ranges at 366 days; 300-day chunks stay under it.\n90\tAPI_POOL_PAGE_SIZE_DAYS = 300\n91\t\n92\t# /miners/registrations/historical caps ranges at 31 days, \"to\" being an inclusive whole day.\n93\tAPI_REGISTRATIONS_PAGE_SIZE_DAYS = 30\n94\t\n95\t# -- Prediction file matching --\n96\t# How far before a scored prompt's start a prediction may start and still answer it; a prediction\n97\t# never answers an earlier prompt. backtest()'s default, so an hourly grid answers every prompt.\n98\tPREDICTION_MATCH_TOLERANCE_MINUTES = 60\n99\t\n100\t\n101\t# -- Offline mode --\n102\t# When SYNTH_BACKTESTER_OFFLINE_DATA_ROOT is set, read bundled parquets from that\n103\t# root instead of calling api.synthdata.co / Pyth. Required for reproducible /\n104\t# network-restricted use cases (e.g. concurrent benchmark rollouts that would\n105\t# otherwise rate-limit the Synth API, or sandboxes with internet disabled).\n106\t#\n107\t# Expected layout under the root (slug ∈ crypto-1h / crypto-24h / com-equ-24h), day partitions as\n108\t# described in synth_lib.backtester.field_store:\n109\t#   miner_scores/{slug}/{asset}/date=*.parquet    # legacy: miner_scores_{asset}_{slug}.parquet\n110\t#   rewards_history/{slug}/date=*.parquet         # legacy: rewards_history_{slug}.parquet\n111\t#   miner_pool_usd/date=*.parquet                 # columns: date, usd; legacy: miner_pool_usd.parquet\n112\t#   market_data/prices/{asset}/1m/date=*.parquet  # daily price partitions (legacy: pyth/)\n113\t_OFFLINE_ENV_VAR = \"SYNTH_BACKTESTER_OFFLINE_DATA_ROOT\"\n114\t\n115\t# comp.label -> API slug used by /rewards/scores?prompt_name=. synth does not\n116\t# define these slugs; they are the backtester's canonical competition keys and\n117\t# double as offline-parquet filename suffixes.\n118\tCOMPETITION_SLUGS: dict[str, str] = {\n119\t    \"Crypto 1h\": \"crypto-1h\",\n120\t    \"Crypto 24h\": \"crypto-24h\",\n121\t    \"Commodities/Equities 24h\": \"com-equ-24h\",\n122\t}\n123\t# Fail loudly at import if synth adds/renames a competition we haven't mapped,\n124\t# instead of a bare KeyError surfacing later deep in a call site.\n125\t_UNMAPPED_LABELS = [c.label for c in ALL_COMPETITIONS if c.label not in COMPETITION_SLUGS]\n126\tif _UNMAPPED_LABELS:\n127\t    raise RuntimeError(\n128\t        f\"COMPETITION_SLUGS has no slug for competition label(s) {_UNMAPPED_LABELS}; \"\n129\t        \"update it to match synth.validator.competition_config.ALL_COMPETITIONS.\"\n130\t    )\n131\tSLUG_TO_COMPETITION: dict[str, CompetitionConfig] = {COMPETITION_SLUGS[c.label]: c for c in ALL_COMPETITIONS}\n132\t\n133\t\n134\tdef slug_for(comp: CompetitionConfig) -> str:\n135\t    \"\"\"API slug / filename suffix for a competition.\"\"\"\n136\t    try:\n137\t        return COMPETITION_SLUGS[comp.label]\n138\t    except KeyError:\n139\t        raise ValueError(\n140\t            f\"No slug mapped for competition label {comp.label!r}; \" \"add it to COMPETITION_SLUGS.\"\n141\t        ) from None\n142\t\n143\t\n144\tdef competition_for(asset: str, time_length: int) -> CompetitionConfig:\n145\t    \"\"\"Resolve the competition owning (asset, time_length).\n146\t\n147\t    (time_length, time_increment) alone is ambiguous for the two 24h\n148\t    competitions (crypto-24h and com-equ-24h share 86400/300); the asset\n149\t    disambiguates because their asset_lists are disjoint.\n150\t    \"\"\"\n151\t    for comp in ALL_COMPETITIONS:\n152\t        if comp.time_length == time_length and asset in comp.asset_list:\n153\t            return comp\n154\t    raise ValueError(\n155\t        f\"No competition for asset={asset!r} time_length={time_length}. \"\n156\t        f\"Known: {[(c.label, c.asset_list) for c in ALL_COMPETITIONS]}\"\n157\t    )\n158\t\n159\t\n160\tdef _offline_root() -> Path | None:\n161\t    val = os.environ.get(_OFFLINE_ENV_VAR)\n162\t    return Path(val) if val else None\n163\t\n164\t\n165\tdef _filter_time_range(df: pd.DataFrame, col: str, start: datetime, end: datetime) -> pd.DataFrame:\n166\t    if df.empty:\n167\t        return df\n168\t    s = pd.to_datetime(df[col], utc=True)\n169\t    start_ts = pd.Timestamp(start) if start.tzinfo else pd.Timestamp(start, tz=\"UTC\")\n170\t    end_ts = pd.Timestamp(end) if end.tzinfo else pd.Timestamp(end, tz=\"UTC\")\n171\t    return df.loc[(s >= start_ts) & (s < end_ts)].copy()"}
{"role":"assistant","content":"The scoring code confirms that 24h CRPS is dominated by many short-horizon return forecasts, while crypto-1h also scores within-path realized volatility. I’m checking timestamp alignment and measuring volatility by asset, weekday, and local session time so the first model change targets the actual error structure.","tool_calls":[{"type":"function","id":"Read_22_4f47b22a","function":{"name":"Read","arguments":"{\"path\":\".venv/lib/python3.12/site-packages/synth_lib/backtester/preparation.py\",\"line_offset\":1,\"n_lines\":240}"}},{"type":"function","id":"Bash_23_d9aac5ee","function":{"name":"Bash","arguments":"{\"command\":\"uv run python -c \\\"import inspect, synth_lib.benchmark.generate_predictions as g, synth_lib.preparation.event_calendar.events as e; print(inspect.getfile(g)); print(inspect.getfile(e))\\\"\",\"cwd\":\"/workspace\",\"timeout\":60}"}},{"type":"function","id":"Bash_24_ce68cd0d","function":{"name":"Bash","arguments":"{\"command\":\"uv run python - <<'PY'\\nimport os\\nimport numpy as np\\nimport pandas as pd\\nfrom synth_lib.benchmark.generate_predictions import load_minute_prices\\nroot = '/workspace/market_data'\\nassets = ['BTC','ETH','SOL','XRP','HYPE','XAU','NVDAX','TSLAX','SP500','WTIOIL']\\nfor asset in assets:\\n    df = load_minute_prices(root, asset, pd.Timestamp('2026-08-01', tz='UTC'), pd.Timestamp('2026-11-08', tz='UTC'))\\n    close = df['close']\\n    r = np.log(close).diff()\\n    valid = r.dropna()\\n    local = valid.index.tz_convert('America/New_York')\\n    hour = local.hour + local.minute / 60\\n    weekend = local.dayofweek >= 5\\n    rms_hour = np.sqrt(valid.groupby(local.hour).apply(lambda x: np.mean(x*x)))\\n    weekday = np.sqrt(np.mean(valid[~weekend]**2))\\n    sat_sun = np.sqrt(np.mean(valid[weekend]**2))\\n    print(f'{asset:6s} n={len(valid):6d} rms={np.sqrt(np.mean(valid**2))*1e4:7.3f}bp zero={(valid==0).mean():6.1%} weekday/weekend={weekday/sat_sun:5.2f} NY_hour_max/min={rms_hour.max()/rms_hour.min():5.2f} peak={rms_hour.idxmax():02d}:00')\\nPY\",\"cwd\":\"/workspace\",\"timeout\":300}"}}]}
{"role":"tool","tool_call_id":"Read_22_4f47b22a","content":"1\t\"\"\"Turning raw scores and prices into per-prompt scoring inputs.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport bisect\n6\timport json\n7\timport warnings\n8\tfrom dataclasses import dataclass\n9\tfrom datetime import datetime, timedelta\n10\tfrom pathlib import Path\n11\tfrom typing import Any\n12\t\n13\timport numpy as np\n14\timport pandas as pd\n15\t\n16\tfrom synth_lib.backtester.config import (\n17\t    PREDICTION_MATCH_TOLERANCE_MINUTES,\n18\t    UTC,\n19\t    _offline_root,\n20\t)\n21\tfrom synth_lib.preparation.realized_path_store import (\n22\t    RealizedPathStore,\n23\t    prefetch_realized_paths,\n24\t)\n25\t\n26\t\n27\tdef _slice_real_prices(\n28\t    prices: pd.DataFrame,\n29\t    start_time: Any,\n30\t    time_length: int,\n31\t    time_increment: int,\n32\t) -> list[float]:\n33\t    \"\"\"Slice a prompt's realized prices out of the local minute frame.\n34\t\n35\t    Raises on a length mismatch (window doesn't cover the prompt — unrepairable);\n36\t    missing minutes come back as NaN for _fill_gaps_from_realized_paths.\n37\t    \"\"\"\n38\t    step_minutes = time_increment // 60\n39\t    window = prices[\"close\"].loc[start_time : start_time + pd.Timedelta(seconds=time_length) : step_minutes]\n40\t    # Coerce: older object-dtype partitions read back as None, which np.isfinite rejects.\n41\t    real_prices = pd.to_numeric(window, errors=\"coerce\").tolist()\n42\t    expected_steps = (time_length // time_increment) + 1\n43\t    if len(real_prices) != expected_steps:\n44\t        raise ValueError(\n45\t            f\"Price data length mismatch at {start_time}: got {len(real_prices)} prices, expected {expected_steps}\"\n46\t        )\n47\t    return real_prices\n48\t\n49\t\n50\tdef _has_missing_prices(real_prices: list[float]) -> bool:\n51\t    \"\"\"True when any price is missing or non-finite. Coerces None to NaN first.\"\"\"\n52\t    coerced = pd.to_numeric(pd.Series(real_prices), errors=\"coerce\")\n53\t    return not bool(np.isfinite(coerced).all())\n54\t\n55\t\n56\tdef _fill_gaps_from_realized_paths(\n57\t    prompts: list[dict[str, Any]],\n58\t    log_prefix: str,\n59\t) -> int:\n60\t    \"\"\"Score NaN-holed prompts from the validator's realized path instead.\n61\t\n62\t    Hyperliquid retains ~3.5 days of minute candles, so older days ingest as NaN\n63\t    for HYPE and every commodity/equity. Mutates `prompts` in place, returns the\n64\t    number substituted. NaN inside a realized path is left as-is.\n65\t    \"\"\"\n66\t    gaps = [prompt for prompt in prompts if prompt[\"real_prices\"] and _has_missing_prices(prompt[\"real_prices\"])]\n67\t    if not gaps:\n68\t        return 0\n69\t\n70\t    by_prompt_config: dict[tuple[str, int, int], list[dict[str, Any]]] = {}\n71\t    for prompt in gaps:\n72\t        key = (prompt[\"asset\"], prompt[\"time_length\"], prompt[\"time_increment\"])\n73\t        by_prompt_config.setdefault(key, []).append(prompt)\n74\t\n75\t    filled = 0\n76\t    for (asset, time_length, time_increment), group in by_prompt_config.items():\n77\t        store = RealizedPathStore(asset, time_length, time_increment)\n78\t        if _offline_root() is None:\n79\t            print(\n80\t                f\"{log_prefix} fetching the validator's realized paths for up to {len(group)} {asset} prompts \"\n81\t                f\"with price gaps, one request per prompt not cached in {store.root}\",\n82\t                flush=True,\n83\t            )\n84\t            prefetch_realized_paths(store, [p[\"start_time\"] for p in group], verbose=False)\n85\t        expected_steps = (time_length // time_increment) + 1\n86\t        for prompt in group:\n87\t            series = store.get(prompt[\"start_time\"])\n88\t            if series is None or len(series) != expected_steps:\n89\t                continue\n90\t            prompt[\"real_prices\"] = series.to_list()\n91\t            filled += 1\n92\t\n93\t    print(\n94\t        f\"{log_prefix} filled {filled}/{len(gaps)} price-gap prompts from validator realized paths\",\n95\t        flush=True,\n96\t    )\n97\t    if filled < len(gaps):\n98\t        warnings.warn(\n99\t            f\"{len(gaps) - filled} of {len(gaps)} price-gap prompts have no stored \"\n100\t            \"realized path either, and will score as NaN CRPS.\",\n101\t            UserWarning,\n102\t            stacklevel=2,\n103\t        )\n104\t    return filled\n105\t\n106\t\n107\tdef _parse_prediction_filename_time(path: Path) -> datetime | None:\n108\t    \"\"\"Extract start_time from a prediction filename like 2026-03-23_00:01:00Z_BTC_86400.json.\"\"\"\n109\t    parts = path.stem.split(\"_\")\n110\t    if len(parts) < 4:\n111\t        return None\n112\t    time_str = f\"{parts[0]}_{parts[1]}\"\n113\t    return datetime.strptime(time_str, \"%Y-%m-%d_%H:%M:%SZ\").replace(tzinfo=UTC)\n114\t\n115\t\n116\t@dataclass(frozen=True)\n117\tclass PredictionRef:\n118\t    \"\"\"Where one prompt's paths live. `row` indexes into a day file; None means the\n119\t    file is the prompt, which is how predictions were written before the day layout.\"\"\"\n120\t\n121\t    path: Path\n122\t    row: int | None = None\n123\t\n124\t\n125\tPredictionIndex = dict[tuple[str, int], dict[pd.Timestamp, PredictionRef]]\n126\t\n127\t\n128\tdef build_prediction_index(root: Path) -> PredictionIndex:\n129\t    \"\"\"Map (asset, time_length) -> {start_time: PredictionRef} over a predictions tree.\n130\t\n131\t    Reads the day layout written by generate_predictions\n132\t    (`<asset>/<time_length>_<time_increment>/date=*.npy` beside a `.json` index) and\n133\t    the one-JSON-per-prompt trees that predate it, so an archived champion still scores.\n134\t    \"\"\"\n135\t    index: PredictionIndex = {}\n136\t    for day_index in sorted(root.glob(\"*/*/date=*.json\")):\n137\t        meta = json.loads(day_index.read_text())\n138\t        paths_file = day_index.with_suffix(\".npy\")\n139\t        if not paths_file.exists():\n140\t            continue  # an index without its paths is an interrupted write, not a prompt\n141\t        key = (meta[\"asset\"], meta[\"time_length\"])\n142\t        for row, start in enumerate(meta[\"start_times\"]):\n143\t            index.setdefault(key, {})[pd.Timestamp(start)] = PredictionRef(paths_file, row)\n144\t    for prompt_file in sorted(root.glob(\"**/*.json\")):\n145\t        start = _parse_prediction_filename_time(prompt_file)\n146\t        if start is None or prompt_file.name.startswith(\"_\"):\n147\t            continue\n148\t        parts = prompt_file.stem.split(\"_\")\n149\t        key = (parts[2], int(parts[3]))\n150\t        index.setdefault(key, {})[pd.Timestamp(start)] = PredictionRef(prompt_file)\n151\t    return index\n152\t\n153\t\n154\tdef _find_prediction_file(\n155\t    index: PredictionIndex,\n156\t    start_time: datetime,\n157\t    asset: str,\n158\t    time_length: int,\n159\t    tolerance_minutes: int = PREDICTION_MATCH_TOLERANCE_MINUTES,\n160\t) -> PredictionRef | None:\n161\t    \"\"\"The latest prediction starting at or before start_time for this (asset, time_length), at most\n162\t    tolerance_minutes earlier, or None.\n163\t\n164\t    Never a later one: its context would hold prices from the path the prompt is scored on. Bisects\n165\t    the sorted start_times: a window holds thousands of prompts and this runs once per prompt.\n166\t    \"\"\"\n167\t    prompts = index.get((asset, time_length))\n168\t    if not prompts:\n169\t        return None\n170\t    starts = sorted(prompts)\n171\t    target = pd.Timestamp(start_time)\n172\t    position = bisect.bisect_right(starts, target)\n173\t    if position == 0:\n174\t        return None\n175\t    best = starts[position - 1]\n176\t    if target - best > timedelta(minutes=tolerance_minutes):\n177\t        return None\n178\t    return prompts[best]"}
