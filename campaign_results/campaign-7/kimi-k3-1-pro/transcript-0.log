{"role":"tool","tool_call_id":"Read_142_298630f9","content":"1\t\"\"\"Probabilistic price paths calibrated from the supplied minute context.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport os\n6\timport random\n7\t\n8\timport numpy as np\n9\timport pandas as pd\n10\t\n11\tCONTEXT_DAYS = 7\n12\tVOL_HALFLIFE_MINUTES = 30.0\n13\t\n14\t\n15\tdef _returns(context_prices) -> pd.Series:\n16\t    closes = context_prices[\"close\"].astype(float)\n17\t    closes = closes.where(np.isfinite(closes) & (closes > 0))\n18\t    return np.log(closes).diff()\n19\t\n20\t\n21\tdef _fast_variance(rets: np.ndarray) -> float:\n22\t    if rets.size < 10:\n23\t        return 5e-4**2\n24\t    alpha = 1.0 - np.exp(np.log(0.5) / VOL_HALFLIFE_MINUTES)\n25\t    initial = rets[: min(rets.size, 1440)]\n26\t    level = float(np.mean(initial * initial))\n27\t    for ret in rets:\n28\t        level += alpha * (ret * ret - level)\n29\t    return max(level, 1e-12)\n30\t\n31\t\n32\tdef _seasonal_sigmas(rets: pd.Series, start_time, time_increment: int, steps: int) -> np.ndarray:\n33\t    values = rets.to_numpy(dtype=float)\n34\t    valid = np.isfinite(values)\n35\t    values = values[valid]\n36\t    if values.size < 100:\n37\t        return np.full(steps, 5e-4 * np.sqrt(time_increment / 60.0))\n38\t    local = rets.index[valid].tz_convert(\"America/New_York\")\n39\t    weekend = local.day_of_week >= 5\n40\t    bins = (local.hour * 60 + local.minute) // 30\n41\t    future = pd.to_datetime(start_time) + pd.to_timedelta(\n42\t        (np.arange(steps) + 0.5) * time_increment, unit=\"s\"\n43\t    )\n44\t    future_local = future.tz_convert(\"America/New_York\")\n45\t    future_weekend = future_local.day_of_week >= 5\n46\t    future_bins = (future_local.hour * 60 + future_local.minute) // 30\n47\t    global_variance = max(float(np.var(values)), 1e-12)\n48\t    sigmas = np.empty(steps)\n49\t    for is_weekend in (False, True):\n50\t        future_mask = future_weekend == is_weekend\n51\t        if not future_mask.any():\n52\t            continue\n53\t        history_mask = weekend == is_weekend\n54\t        count = int(history_mask.sum())\n55\t        if count < 300:\n56\t            history_mask = np.ones(values.size, dtype=bool)\n57\t            count = values.size\n58\t        sample = values[history_mask]\n59\t        sample_bins = bins[history_mask]\n60\t        variance = float(np.mean(sample * sample))\n61\t        variance = (count * variance + 720 * global_variance) / (count + 720)\n62\t        mean_absolute = max(float(np.mean(np.abs(sample))), 1e-8)\n63\t        profile = np.ones(48)\n64\t        for bucket in range(48):\n65\t            bucket_values = np.abs(sample[sample_bins == bucket])\n66\t            if bucket_values.size >= 20:\n67\t                profile[bucket] = max(float(np.mean(bucket_values)) / mean_absolute, 0.25)\n68\t        profile = np.clip(profile, 0.25, 3.0)\n69\t        profile /= np.sqrt(np.mean(profile * profile))\n70\t        sigmas[future_mask] = np.sqrt(variance * time_increment / 60.0) * profile[\n71\t            future_bins[future_mask]\n72\t        ]\n73\t    return sigmas\n74\t\n75\t\n76\tdef simulate(\n77\t    asset: str,\n78\t    start_time,\n79\t    time_increment: int = 300,\n80\t    time_length: int = 86_400,\n81\t    num_simulations: int = 1000,\n82\t    context_prices=None,\n83\t):\n84\t    seed = int(os.environ.get(\"SYNTH_BENCHMARK_SEED\", \"20261108\"))\n85\t    random.seed(seed)\n86\t    np.random.seed(seed)\n87\t    rng = np.random.default_rng(seed)\n88\t\n89\t    closes = context_prices[\"close\"].to_numpy(dtype=float)\n90\t    valid = closes[np.isfinite(closes) & (closes > 0)]\n91\t    last = float(valid[-1]) if valid.size else 1.0\n92\t    steps = time_length // time_increment\n93\t    rets = _returns(context_prices)\n94\t    if time_length == 3600:\n95\t        minute_values = rets.dropna().to_numpy()\n96\t        sigma = np.sqrt(_fast_variance(minute_values) * time_increment / 60.0)\n97\t        sigmas = np.full(steps, sigma)\n98\t        if minute_values.size >= 100:\n99\t            residual = minute_values / max(float(np.std(minute_values)), 1e-8)\n100\t            residual = np.clip(residual - np.median(residual), -8.0, 8.0)\n101\t            shocks = residual[rng.integers(0, residual.size, size=(num_simulations, steps))] * sigmas\n102\t        else:\n103\t            shocks = rng.normal(size=(num_simulations, steps)) * sigmas\n104\t    else:\n105\t        sigmas = _seasonal_sigmas(rets, start_time, time_increment, steps)\n106\t        clean = context_prices[\"close\"].astype(float)\n107\t        clean = clean.where(np.isfinite(clean) & (clean > 0))\n108\t        five_minute = np.log(clean).diff(5).dropna().to_numpy()\n109\t        minute_values = rets.dropna().to_numpy()\n110\t        if five_minute.size >= 100 and minute_values.size >= 100:\n111\t            residual = five_minute / np.sqrt(5.0 * max(float(np.var(minute_values)), 1e-12))\n112\t            residual = np.clip(residual - np.median(residual), -8.0, 8.0)\n113\t            empirical = residual[rng.integers(0, residual.size, size=(num_simulations, steps))] * sigmas\n114\t            gaussian = rng.normal(size=(num_simulations, steps)) * sigmas\n115\t            shocks = np.where(rng.random((num_simulations, steps)) < 0.5, empirical, gaussian)\n116\t        else:\n117\t            shocks = rng.normal(size=(num_simulations, steps)) * sigmas\n118\t    log_paths = np.concatenate(\n119\t        [np.zeros((num_simulations, 1)), np.cumsum(shocks, axis=1)], axis=1\n120\t    )\n121\t    paths = last * np.exp(log_paths)\n122\t    return (start_time, time_increment, *[p.tolist() for p in paths])"}
{"role":"assistant","tool_calls":[{"type":"function","id":"Write_143_898ab878","function":{"name":"Write","arguments":"{\"path\":\"agent/seasonal_model.py\",\"content\":\"\\\"\\\"\\\"Seasonal Gaussian reference for paired 24h experiments.\\\"\\\"\\\"\\n\\nfrom __future__ import annotations\\n\\nimport os\\nimport random\\n\\nimport numpy as np\\nimport pandas as pd\\n\\nCONTEXT_DAYS = 7\\nVOL_HALFLIFE_MINUTES = 30.0\\n\\n\\ndef _returns(context_prices) -> pd.Series:\\n    closes = context_prices[\\\"close\\\"].astype(float)\\n    closes = closes.where(np.isfinite(closes) & (closes > 0))\\n    return np.log(closes).diff()\\n\\n\\ndef _fast_variance(rets: np.ndarray) -> float:\\n    if rets.size < 10:\\n        return 5e-4**2\\n    alpha = 1.0 - np.exp(np.log(0.5) / VOL_HALFLIFE_MINUTES)\\n    initial = rets[: min(rets.size, 1440)]\\n    level = float(np.mean(initial * initial))\\n    for ret in rets:\\n        level += alpha * (ret * ret - level)\\n    return max(level, 1e-12)\\n\\n\\ndef _seasonal_sigmas(rets: pd.Series, start_time, time_increment: int, steps: int) -> np.ndarray:\\n    values = rets.to_numpy(dtype=float)\\n    valid = np.isfinite(values)\\n    values = values[valid]\\n    if values.size < 100:\\n        return np.full(steps, 5e-4 * np.sqrt(time_increment / 60.0))\\n    local = rets.index[valid].tz_convert(\\\"America/New_York\\\")\\n    weekend = local.day_of_week >= 5\\n    bins = (local.hour * 60 + local.minute) // 30\\n    future = pd.to_datetime(start_time) + pd.to_timedelta(\\n        (np.arange(steps) + 0.5) * time_increment, unit=\\\"s\\\"\\n    )\\n    future_local = future.tz_convert(\\\"America/New_York\\\")\\n    future_weekend = future_local.day_of_week >= 5\\n    future_bins = (future_local.hour * 60 + future_local.minute) // 30\\n    global_variance = max(float(np.var(values)), 1e-12)\\n    sigmas = np.empty(steps)\\n    for is_weekend in (False, True):\\n        future_mask = future_weekend == is_weekend\\n        if not future_mask.any():\\n            continue\\n        history_mask = weekend == is_weekend\\n        count = int(history_mask.sum())\\n        if count < 300:\\n            history_mask = np.ones(values.size, dtype=bool)\\n            count = values.size\\n        sample = values[history_mask]\\n        sample_bins = bins[history_mask]\\n        variance = float(np.mean(sample * sample))\\n        variance = (count * variance + 720 * global_variance) / (count + 720)\\n        mean_absolute = max(float(np.mean(np.abs(sample))), 1e-8)\\n        profile = np.ones(48)\\n        for bucket in range(48):\\n            bucket_values = np.abs(sample[sample_bins == bucket])\\n            if bucket_values.size >= 20:\\n                profile[bucket] = max(float(np.mean(bucket_values)) / mean_absolute, 0.25)\\n        profile = np.clip(profile, 0.25, 3.0)\\n        profile /= np.sqrt(np.mean(profile * profile))\\n        sigmas[future_mask] = np.sqrt(variance * time_increment / 60.0) * profile[\\n            future_bins[future_mask]\\n        ]\\n    return sigmas\\n\\n\\ndef simulate(asset, start_time, time_increment=300, time_length=86_400, num_simulations=1000, context_prices=None):\\n    seed = int(os.environ.get(\\\"SYNTH_BENCHMARK_SEED\\\", \\\"20261108\\\"))\\n    random.seed(seed)\\n    np.random.seed(seed)\\n    rng = np.random.default_rng(seed)\\n    closes = context_prices[\\\"close\\\"].to_numpy(dtype=float)\\n    valid = closes[np.isfinite(closes) & (closes > 0)]\\n    last = float(valid[-1]) if valid.size else 1.0\\n    steps = time_length // time_increment\\n    rets = _returns(context_prices)\\n    if time_length == 3600:\\n        sigma = np.sqrt(_fast_variance(rets.dropna().to_numpy()) * time_increment / 60.0)\\n        sigmas = np.full(steps, sigma)\\n    else:\\n        sigmas = _seasonal_sigmas(rets, start_time, time_increment, steps)\\n    shocks = rng.normal(size=(num_simulations, steps)) * sigmas\\n    log_paths = np.concatenate([np.zeros((num_simulations, 1)), np.cumsum(shocks, axis=1)], axis=1)\\n    paths = last * np.exp(log_paths)\\n    return (start_time, time_increment, *[p.tolist() for p in paths])\\n\"}"}}]}
