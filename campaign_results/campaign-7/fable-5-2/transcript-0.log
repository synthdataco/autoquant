{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GHbUhfKE8stpRxjknoyiaQ","type":"tool_result","content":"1\t\"\"\"Backtest orchestration: one asset (backtest) and a whole competition (run_backtest).\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\n6\tfrom datetime import datetime, timedelta\n7\tfrom pathlib import Path\n8\tfrom time import perf_counter\n9\tfrom typing import Any\n10\t\n11\timport numpy as np\n12\timport pandas as pd\n13\t\n14\tfrom synth.validator.competition_config import ALL_COMPETITIONS, CompetitionConfig\n15\t\n16\tfrom synth_lib.backtester.caveats import (\n17\t    _maybe_warn_competition_split,\n18\t    _maybe_warn_hf_crps_formula_change,\n19\t    _maybe_warn_latest_formula,\n20\t)\n21\tfrom synth_lib.backtester.config import (\n22\t    OUTLIER_CAP_DATE,\n23\t    DEFAULT_MINER_OUTPUT_ROOT,\n24\t    PREDICTION_MATCH_TOLERANCE_MINUTES,\n25\t    SCORING_INTERVALS,\n26\t    UTC,\n27\t    _COMBINED_EMPTY_COLS,\n28\t    competition_for,\n29\t    slug_for,\n30\t)\n31\tfrom synth_lib.backtester.loading import (\n32\t    download_price_data,\n33\t    get_miner_scores,\n34\t    get_rewards_history,\n35\t)\n36\tfrom synth_lib.backtester.preparation import (\n37\t    _fill_gaps_from_realized_paths,\n38\t    _find_prediction_file,\n39\t    _slice_real_prices,\n40\t    build_prediction_index,\n41\t)\n42\tfrom synth_lib.backtester.plots.crps import (\n43\t    plot_crps_by_day,\n44\t    plot_crps_by_hour,\n45\t    plot_crps_over_time,\n46\t    plot_crps_ratio_distribution,\n47\t    plot_weekly_percentile,\n48\t)\n49\tfrom synth_lib.backtester.plots.earnings import (\n50\t    plot_estimated_earnings,\n51\t    plot_grand_total_earnings,\n52\t)\n53\tfrom synth_lib.backtester.plots.rank import (\n54\t    plot_grand_total_rank_evolution,\n55\t    plot_rank_evolution,\n56\t    plot_total_rank_evolution,\n57\t)\n58\tfrom synth_lib.backtester.result import BacktestResult, NoScoresAvailable\n59\tfrom synth_lib.backtester.scoring import (\n60\t    Registrations,\n61\t    _compute_prompt_score_stats_for_group,\n62\t    _score_single_prompt,\n63\t    _trim_warmup,\n64\t    calculate_smoothed_scores,\n65\t    compute_combined_smoothed_scores,\n66\t)\n67\t\n68\t\n69\tdef _realized_coverage(prompts: list[dict]) -> dict[str, object]:\n70\t    \"\"\"How much of each prompt's realized path actually carries a price.\n71\t\n72\t    A prompt's CRPS is a sum over its scoring points and NaN points are dropped, so a realized path\n73\t    with holes yields a SMALLER sum — a better-looking score from a thinner reference, not a better\n74\t    model. The shrinkage does not show in mean_crps, which is why it is reported beside it: two runs\n75\t    of the same champion over the same window are comparable only at equal coverage.\n76\t    \"\"\"\n77\t    expected = scored = 0\n78\t    for prompt in prompts:\n79\t        if prompt[\"file_path\"] is None:\n80\t            continue  # no prediction at all — num_prompts already counts that, it is not coverage\n81\t        expected += prompt[\"time_length\"] // prompt[\"time_increment\"] + 1\n82\t        scored += int(np.isfinite(np.asarray(prompt[\"real_prices\"], dtype=float)).sum())\n83\t    return {\n84\t        \"realized_points_expected\": expected,\n85\t        \"realized_points_scored\": scored,\n86\t        \"realized_coverage\": (scored / expected) if expected else None,\n87\t    }\n88\t\n89\t\n90\tdef _score_prompts(\n91\t    prompts: list[dict[str, Any]],\n92\t    scoring_intervals: dict[str, int],\n93\t    competition: CompetitionConfig,\n94\t    miner_id: int,\n95\t    latest_formula: bool,\n96\t    scoring_executor: ProcessPoolExecutor | None,\n97\t) -> pd.DataFrame:\n98\t    \"\"\"One CRPS row per prompt, in parallel when an executor is given.\"\"\"\n99\t    work_items = [\n100\t        (\n101\t            prompt[\"file_path\"],\n102\t            prompt[\"start_time\"],\n103\t            prompt[\"asset\"],\n104\t            prompt[\"scored_time\"],\n105\t            prompt[\"time_length\"],\n106\t            prompt[\"time_increment\"],\n107\t            prompt[\"real_prices\"],\n108\t            scoring_intervals,\n109\t            competition.vol_scoring_blocks,\n110\t            miner_id,\n111\t            latest_formula,\n112\t        )\n113\t        for prompt in prompts\n114\t    ]\n115\t    if scoring_executor is not None:\n116\t        futures = [scoring_executor.submit(_score_single_prompt, *item) for item in work_items]\n117\t        raw_results = [f.result() for f in futures]\n118\t    else:\n119\t        raw_results = [_score_single_prompt(*item) for item in work_items]\n120\t    return pd.concat([pd.DataFrame(r, index=[0]) for r in raw_results], ignore_index=True)\n121\t\n122\t\n123\tdef backtest(\n124\t    miner_name: str = \"initial_research\",\n125\t    asset: str = \"BTC\",\n126\t    *,\n127\t    time_length: int,\n128\t    time_increment: int | None = None,\n129\t    n_backtest_days: int = 15,\n130\t    miner_id: int = 999,\n131\t    predictions_dir: Path | None = None,\n132\t    scoring_intervals: dict[str, int] | None = None,\n133\t    competition: CompetitionConfig | None = None,\n134\t    scoring_executor: ProcessPoolExecutor | None = None,\n135\t    eval_end: datetime | None = None,\n136\t    simulate_registration: datetime | None = None,\n137\t    simulate_deregistration: datetime | None = None,\n138\t    registrations: Registrations | None = None,\n139\t    match_tolerance_minutes: int = PREDICTION_MATCH_TOLERANCE_MINUTES,\n140\t    latest_formula: bool = False,\n141\t) -> BacktestResult:\n142\t    \"\"\"Backtest a local miner against Synth subnet scoring data.\n143\t    Loads predictions from predictions_dir (or miner_outputs/{miner_name}/predictions/).\n144\t    `registrations` (uid -> registration time(s) of its occupants inside the data, see\n145\t    `get_registrations`) scores each field uid that changed hands as the miners live sees.\n146\t    A scored prompt is answered by the latest prediction starting at or before it, at most\n147\t    `match_tolerance_minutes` earlier; predictions on a grid pass its cadence.\n148\t    `latest_formula` scores every prompt with the latest crypto-1h formula instead of the one live\n149\t    when it was scored: CRPS then compares across the change, field ranks before it do not.\n150\t    \"\"\"\n151\t    if competition is None:\n152\t        competition = competition_for(asset, time_length)\n153\t    if time_increment is None:\n154\t        time_increment = competition.time_increment\n155\t    if scoring_intervals is None:\n156\t        scoring_intervals = competition.scoring_intervals\n157\t\n158\t    # Discover predictions and their date range\n159\t    predictions_root = predictions_dir or (DEFAULT_MINER_OUTPUT_ROOT / miner_name / \"predictions\")\n160\t    prediction_index = build_prediction_index(predictions_root)\n161\t    pred_times = [t.to_pydatetime() for prompts in prediction_index.values() for t in prompts]\n162\t    if not pred_times:\n163\t        raise FileNotFoundError(\n164\t            f\"No predictions found in {predictions_root}. Expected the day layout \"\n165\t            \"<asset>/<time_length>_<time_increment>/date=*.npy, or one JSON per prompt \"\n166\t            \"named like 2026-03-28_00:00:00Z_BTC_86400.json\"\n167\t        )\n168\t    pred_start = min(pred_times)\n169\t    pred_end = max(pred_times)\n170\t\n171\t    # Constrain backtest window to prediction coverage, scored_time against the first prediction's\n172\t    # start less the default match tolerance, and the last one's horizon plus the match tolerance\n173\t    # (at least an hour): a prediction answers prompts up to that tolerance after its start.\n174\t    # Anchor priority: simulate_deregistration > eval_end > now. When the user passes\n175\t    # simulate_registration, the window's lower bound shifts to it (minus 10d for the\n176\t    # smoothed-score moving-average lookback) instead of `anchor − n_backtest_days`,\n177\t    # so the API actually fetches scored prompts in the simulated mining period.\n178\t    if simulate_deregistration is not None:\n179\t        anchor = pd.Timestamp(simulate_deregistration).to_pydatetime()\n180\t    elif eval_end is not None:\n181\t        anchor = eval_end\n182\t    else:\n183\t        anchor = datetime.now(UTC)\n184\t    if simulate_registration is not None:\n185\t        window_start = pd.Timestamp(simulate_registration).to_pydatetime() - timedelta(days=competition.window_days)\n186\t    else:\n187\t        window_start = anchor - timedelta(days=n_backtest_days)\n188\t    if simulate_registration is not None:\n189\t        # The field has to be fetched from before the candidate existed: its ABSENCE there is what\n190\t        # makes the moving average treat it as a late joiner. Clamping to prediction coverage would\n191\t        # shorten the lookback to one horizon, and the backfill with it.\n192\t        query_start = window_start\n193\t    else:\n194\t        query_start = max(\n195\t            pred_start - timedelta(minutes=PREDICTION_MATCH_TOLERANCE_MINUTES),\n196\t            window_start,\n197\t        )\n198\t    query_end = pred_end + timedelta(seconds=time_length) + timedelta(minutes=max(60, match_tolerance_minutes))\n199\t\n200\t    # Step 2: fetch existing miner scores\n201\t    asset_backtest = asset\n202\t    time_length_backtest = time_length\n203\t    prompt_label = slug_for(competition)\n204\t    log_prefix = f\"  [{prompt_label}/{asset_backtest}]\"\n205\t    t_start = perf_counter()\n206\t\n207\t    print(\n208\t        f\"{log_prefix} fetching scored prompts ({query_start.date()} → {min(query_end, anchor).date()})...\",\n209\t        flush=True,\n210\t    )\n211\t    asset_scores = get_miner_scores(\n212\t        start_time=query_start,\n213\t        end_time=min(query_end, anchor),\n214\t        asset=asset_backtest,\n215\t        time_length=time_length_backtest,\n216\t        time_increment=time_increment,\n217\t    )\n218\t    if asset_scores.empty:\n219\t        raise NoScoresAvailable(\n220\t            f\"no scored prompts for asset={asset_backtest}, \"\n221\t            f\"time_length={time_length_backtest}, range=[{query_start}, {query_end}]\"\n222\t        )\n223\t    print(\n224\t        f\"{log_prefix} {len(asset_scores)} score rows ({asset_scores['scored_time'].nunique()} prompts) \"\n225\t        f\"in {perf_counter()-t_start:.1f}s\",\n226\t        flush=True,\n227\t    )\n228\t    if latest_formula:\n229\t        _maybe_warn_latest_formula(competition, asset_scores[\"scored_time\"].min())\n230\t\n231\t    # Step 3: fetch rewards history\n232\t    prompt_name = None if not time_length_backtest else prompt_label\n233\t    t_rh = perf_counter()\n234\t    print(\n235\t        f\"{log_prefix} fetching rewards history (prompt_name={prompt_name})...\",\n236\t        flush=True,\n237\t    )\n238\t    rewards_history = get_rewards_history(\n239\t        asset_scores[\"scored_time\"].min() - pd.Timedelta(hours=24),\n240\t        asset_scores[\"scored_time\"].max() + pd.Timedelta(hours=24),\n241\t        prompt_name=prompt_name,\n242\t    )\n243\t    if rewards_history.empty:\n244\t        raise RuntimeError(\n245\t            f\"Synth API returned no rewards history for prompt_name={prompt_name}, \"\n246\t            f\"range=[{asset_scores['scored_time'].min()}, {asset_scores['scored_time'].max()}]\"\n247\t        )\n248\t    print(\n249\t        f\"{log_prefix} {len(rewards_history)} rewards rows \"\n250\t        f\"({rewards_history['updated_at'].nunique()} update rounds) in {perf_counter()-t_rh:.1f}s\",\n251\t        flush=True,\n252\t    )\n253\t\n254\t    # Step 4: align scores and rewards history time ranges\n255\t    if asset_backtest is not None:\n256\t        asset_scores = asset_scores.sort_values(\"scored_time\")\n257\t        rewards_history = rewards_history.sort_values(\"updated_at\")\n258\t\n259\t        result = pd.merge_asof(\n260\t            asset_scores[[\"scored_time\"]].drop_duplicates(),\n261\t            rewards_history[[\"updated_at\"]].drop_duplicates(),\n262\t            left_on=\"scored_time\",\n263\t            right_on=\"updated_at\",\n264\t            direction=\"forward\",\n265\t        )\n266\t        result = result[~result[\"updated_at\"].isna()]\n267\t        rewards_history = rewards_history.loc[rewards_history[\"updated_at\"].isin(result[\"updated_at\"])].copy()\n268\t        asset_scores = asset_scores.loc[asset_scores[\"scored_time\"].isin(result[\"scored_time\"])].copy()\n269\t    else:\n270\t        if rewards_history[\"updated_at\"].max() < asset_scores[\"scored_time\"].max():\n271\t            max_scored_time = asset_scores.loc[\n272\t                asset_scores[\"scored_time\"] <= rewards_history[\"updated_at\"].max(),\n273\t                \"scored_time\",\n274\t            ].max()\n275\t            asset_scores = asset_scores.loc[asset_scores[\"scored_time\"] <= max_scored_time].copy()\n276\t        elif rewards_history[\"updated_at\"].max() > asset_scores[\"scored_time\"].max():\n277\t            max_upd_at = rewards_history.loc[\n278\t                rewards_history[\"updated_at\"] >= asset_scores[\"scored_time\"].max(),\n279\t                \"updated_at\",\n280\t            ].min()\n281\t            rewards_history = rewards_history.loc[rewards_history[\"updated_at\"] <= max_upd_at].copy()\n282\t\n283\t    # Step 5: download asset price data, up to the last prompt's end\n284\t    asset_prices: dict[str, pd.DataFrame] = {}\n285\t    for asset_ in asset_scores[\"asset\"].unique():\n286\t        st_ = asset_scores[\"start_time\"].min() - pd.Timedelta(hours=2)\n287\t        en_ = asset_scores[\"start_time\"].max() + pd.Timedelta(seconds=time_length)\n288\t        asset_prices[asset_] = download_price_data(st_, en_, asset_, freq=\"1min\")\n289\t\n290\t    # Step 6: score LLM miner predictions\n291\t    start_times = asset_scores[\"start_time\"].sort_values().unique()\n292\t    t_score = perf_counter()\n293\t    print(\n294\t        f\"{log_prefix} scoring {len(start_times)} prompts against local predictions...\",\n295\t        flush=True,\n296\t    )\n297\t\n298\t    # Pre-build work items: resolve file paths and slice prices upfront\n299\t    prompts: list[dict[str, Any]] = []\n300\t\n301\t    for start_time in start_times:\n302\t        scores_subset = asset_scores.loc[asset_scores[\"start_time\"] == start_time].copy()\n303\t\n304\t        for _, asset_val, scored_time, time_len, time_incr in (\n305\t            scores_subset[[\"asset\", \"scored_time\", \"time_length\", \"time_increment\"]].drop_duplicates().itertuples()\n306\t        ):\n307\t            file_path = _find_prediction_file(\n308\t                prediction_index, start_time, asset_val, time_len, match_tolerance_minutes\n309\t            )\n310\t\n311\t            # Pre-slice real prices in the main process (avoids pickling DataFrames)\n312\t            real_prices: list[float] = []\n313\t            if file_path is not None:\n314\t                real_prices = _slice_real_prices(asset_prices[asset_val], start_time, time_len, time_incr)\n315\t\n316\t            prompts.append(\n317\t                {\n318\t                    \"file_path\": file_path,\n319\t                    \"start_time\": start_time,\n320\t                    \"asset\": asset_val,\n321\t                    \"scored_time\": scored_time,\n322\t                    \"time_length\": time_len,\n323\t                    \"time_increment\": time_incr,\n324\t                    \"real_prices\": real_prices,\n325\t                }\n326\t            )\n327\t\n328\t    _fill_gaps_from_realized_paths(prompts, log_prefix)\n329\t    realized_coverage = _realized_coverage(prompts)\n330\t\n331\t    # Step 7: concatenate LLM miner scores\n332\t    if not prompts:\n333\t        raise RuntimeError(\n334\t            \"No prediction files matched any scored prompt. \"\n335\t            \"Check that prediction filenames align with the scored time range.\"\n336\t        )\n337\t    new_scores = _score_prompts(prompts, scoring_intervals, competition, miner_id, latest_formula, scoring_executor)\n338\t    print(\n339\t        f\"{log_prefix} scored {len(new_scores)} prompts in {perf_counter()-t_score:.1f}s\",\n340\t        flush=True,\n341\t    )\n342\t\n343\t    # Step 8: trim to valid range\n344\t    new_scores = new_scores.sort_values(\"scored_time\")\n345\t    valid_scores = new_scores.loc[new_scores[\"crps\"] != -1]\n346\t    if valid_scores.empty:\n347\t        raise RuntimeError(\n348\t            \"All matched predictions resulted in crps=-1 (scoring failures). \" \"No valid backtest results to report.\"\n349\t        )\n350\t    end_backtest_time = valid_scores[\"scored_time\"].max()\n351\t    new_scores = new_scores.loc[new_scores[\"scored_time\"] <= end_backtest_time]\n352\t    asset_scores = asset_scores.loc[asset_scores[\"scored_time\"] <= end_backtest_time]\n353\t\n354\t    # Optional: simulate the miner registering on a specific date by dropping our\n355\t    # CRPS rows for the prompts issued before that date: a miner answers only the\n356\t    # prompts sent once it is registered, so its first score lands a horizon later.\n357\t    # synth.validator.prepare_df_for_moving_average then sees our miner's first\n358\t    # scored_time > global_min and applies the same worst-score backfill it gives\n359\t    # real late-joining miners — making rank comparisons symmetric instead of giving\n360\t    # us an unfair \"from-the-start\" boost.\n361\t    if simulate_registration is not None:\n362\t        sim_reg = pd.Timestamp(simulate_registration)\n363\t        new_scores = new_scores.loc[new_scores[\"start_time\"] >= sim_reg]\n364\t        if new_scores.empty:\n365\t            raise RuntimeError(\n366\t                f\"simulate_registration={sim_reg} drops all of our miner's CRPS rows; \" f\"no valid backtest results.\"\n367\t            )\n368\t    if simulate_deregistration is not None:\n369\t        sim_dereg = pd.Timestamp(simulate_deregistration)\n370\t        new_scores = new_scores.loc[new_scores[\"scored_time\"] <= sim_dereg]\n371\t        if new_scores.empty:\n372\t            raise RuntimeError(\n373\t                f\"simulate_deregistration={sim_dereg} drops all of our miner's CRPS rows; \"\n374\t                f\"no valid backtest results.\"\n375\t            )\n376\t\n377\t    # Step 9: merge LLM scores with all miner scores\n378\t    all_scores = pd.concat([asset_scores, new_scores], ignore_index=True)\n379\t    all_scores = all_scores.sort_values([\"scored_time\", \"miner_uid\"])\n380\t\n381\t    if rewards_history[\"updated_at\"].max() < all_scores[\"scored_time\"].max():\n382\t        max_scored_time = all_scores.loc[\n383\t            all_scores[\"scored_time\"] <= rewards_history[\"updated_at\"].max(),\n384\t            \"scored_time\",\n385\t        ].max()\n386\t        all_scores = all_scores.loc[all_scores[\"scored_time\"] <= max_scored_time].copy()\n387\t    elif rewards_history[\"updated_at\"].max() > all_scores[\"scored_time\"].max():\n388\t        max_upd_at = rewards_history.loc[\n389\t            rewards_history[\"updated_at\"] >= all_scores[\"scored_time\"].max(),\n390\t            \"updated_at\",\n391\t        ].min()\n392\t        rewards_history = rewards_history.loc[rewards_history[\"updated_at\"] <= max_upd_at].copy()\n393\t\n394\t    # Step 12: apply prompt score calculation across all scores. We also persist\n395\t    # percentile95 and lowest_score per group because prepare_df_for_moving_average\n396\t    # uses them to compute the worst-score backfill for new miners (silently\n397\t    # skips backfill when those columns are absent).\n398\t    # Split on the outlier-cap cutover before grouping. scored_time is a group key, so every row\n399\t    # in a group is on the same side and no group is ever split by this.\n400\t    keys = [\"scored_time\", \"asset\", \"time_length\", \"time_increment\"]\n401\t    capped_era = pd.to_datetime(all_scores[\"scored_time\"], utc=True) >= OUTLIER_CAP_DATE\n402\t    parts = [\n403\t        all_scores.loc[mask]\n404\t        .groupby(keys, group_keys=False)[\"crps\"]\n405\t        .apply(_compute_prompt_score_stats_for_group, capped_era=era)\n406\t        for era, mask in ((True, capped_era), (False, ~capped_era))\n407\t        if mask.any()\n408\t    ]\n409\t    _stats = pd.concat(parts).reindex(all_scores.index)\n410\t    all_scores[\"new_prompt_scores\"] = _stats[\"new_prompt_scores\"]\n411\t    all_scores[\"percentile95\"] = _stats[\"percentile95\"]\n412\t    all_scores[\"lowest_score\"] = _stats[\"lowest_score\"]\n413\t\n414\t    # Step 13: build rewards history entries for LLM miner\n415\t    new_miner_rewards_list = []\n416\t    for prompt_name_item in rewards_history[\"prompt_name\"].unique():\n417\t        new_miner_rewards_prompt = pd.DataFrame(\n418\t            {\n419\t                \"updated_at\": rewards_history.loc[rewards_history[\"prompt_name\"] == prompt_name_item, \"updated_at\"]\n420\t                .sort_values()\n421\t                .unique(),\n422\t                \"miner_uid\": miner_id,\n423\t                \"prompt_name\": prompt_name_item,\n424\t            }\n425\t        )\n426\t        new_miner_rewards_list.append(new_miner_rewards_prompt)\n427\t    new_miner_rewards = pd.concat(new_miner_rewards_list, ignore_index=True).sort_values(\"updated_at\")\n428\t\n429\t    # Step 14: merge LLM miner rewards into full rewards history\n430\t    rewards_history = pd.concat(\n431\t        [\n432\t            rewards_history,\n433\t            new_miner_rewards,\n434\t        ]\n435\t    ).sort_values([\"updated_at\", \"prompt_name\", \"miner_uid\"])\n436\t\n437\t    # Step 15: recalculate smoothed scores including LLM miner\n438\t    n_rounds = rewards_history[\"updated_at\"].nunique()\n439\t    t_smooth = perf_counter()\n440\t    print(\n441\t        f\"{log_prefix} computing smoothed scores over {n_rounds} reward rounds...\",\n442\t        flush=True,\n443\t    )\n444\t    recalculated_smoothed_scores = calculate_smoothed_scores(\n445\t        all_scores,\n446\t        rewards_history,\n447\t        cutoff_days=competition.window_days,\n448\t        scores_column=\"new_prompt_scores\",\n449\t        competition=competition,\n450\t        registrations=registrations,\n451\t    )\n452\t    print(\n453\t        f\"{log_prefix} smoothed scores done in {perf_counter()-t_smooth:.1f}s \"\n454\t        f\"(total backtest: {perf_counter()-t_start:.1f}s)\",\n455\t        flush=True,\n456\t    )\n457\t\n458\t    # Trim the first `competition.window_days` of smoothed_scores when no\n459\t    # simulate_registration is set. In that case the backfill artifact applies to\n460\t    # real late-joining miners and inflates our rank — we want to hide it.\n461\t    # When simulate_registration IS set, the backfill applies to OUR miner and\n462\t    # the warmup ramp-up is the whole point of the simulation — don't trim it.\n463\t    if simulate_registration is None:\n464\t        recalculated_smoothed_scores = _trim_warmup(\n465\t            recalculated_smoothed_scores,\n466\t            all_scores,\n467\t            warmup_days=competition.window_days,\n468\t        )\n469\t\n470\t    miner_smoothed = recalculated_smoothed_scores.loc[\n471\t        recalculated_smoothed_scores[\"miner_uid\"] == miner_id, \"new_smoothed_score\"\n472\t    ]\n473\t    summary: dict[str, Any] = {\n474\t        \"miner_name\": miner_name,\n475\t        \"miner_id\": miner_id,\n476\t        \"num_prompts\": int((new_scores[\"crps\"] != -1).sum()),\n477\t        \"mean_crps\": float(new_scores.loc[new_scores[\"crps\"] != -1, \"crps\"].mean()),\n478\t        \"final_smoothed_score\": (float(miner_smoothed.iloc[-1]) if not miner_smoothed.empty else None),\n479\t        **realized_coverage,\n480\t    }\n481\t\n482\t    return BacktestResult(\n483\t        miner_name=miner_name,\n484\t        prompt_df=all_scores,\n485\t        smoothed_scores=recalculated_smoothed_scores,\n486\t        summary=summary,\n487\t    )\n488\t\n489\t\n490\tdef score_crps(\n491\t    miner_name: str = \"initial_research\",\n492\t    asset: str = \"BTC\",\n493\t    *,\n494\t    time_length: int,\n495\t    time_increment: int | None = None,\n496\t    miner_id: int = 999,\n497\t    predictions_dir: Path | None = None,\n498\t    competition: CompetitionConfig | None = None,\n499\t    scoring_executor: ProcessPoolExecutor | None = None,\n500\t    latest_formula: bool = True,\n501\t) -> BacktestResult:\n502\t    \"\"\"Each prediction's CRPS against the local store's prices, without the field: no rank, no API.\n503\t\n504\t    Every prediction is a prompt at its own start time, scored one horizon later with the\n505\t    validator's CRPS, crypto-1h's latest formula unless `latest_formula` is False. It works on any\n506\t    window the store covers, including where no field scores exist. The reference is the store's\n507\t    closes only, never the validator's realized path: a minute without a price drops out of the\n508\t    sum, which `realized_coverage` reports, and a prediction whose path holds no price after its\n509\t    start is left out. `smoothed_scores` is empty.\n510\t    \"\"\"\n511\t    if competition is None:\n512\t        competition = competition_for(asset, time_length)\n513\t    if time_increment is None:\n514\t        time_increment = competition.time_increment\n515\t    predictions_root = predictions_dir or (DEFAULT_MINER_OUTPUT_ROOT / miner_name / \"predictions\")\n516\t    predictions = sorted(build_prediction_index(predictions_root).get((asset, time_length), {}).items())\n517\t    if not predictions:\n518\t        raise FileNotFoundError(f\"No {asset} predictions for time_length={time_length} in {predictions_root}\")\n519\t\n520\t    horizon = pd.Timedelta(seconds=time_length)\n521\t    prices = download_price_data(\n522\t        predictions[0][0] - pd.Timedelta(hours=2), predictions[-1][0] + horizon, asset, freq=\"1min\"\n523\t    )\n524\t    prompts = []\n525\t    for start, ref in predictions:\n526\t        real_prices = _slice_real_prices(prices, start, time_length, time_increment)\n527\t        # A reference with no price after its start scores 0, the best CRPS there is.\n528\t        if not np.isfinite(np.asarray(real_prices[1:], dtype=float)).any():\n529\t            continue\n530\t        prompts.append(\n531\t            {\n532\t                \"file_path\": ref,\n533\t                \"start_time\": start,\n534\t                \"asset\": asset,\n535\t                \"scored_time\": start + horizon,\n536\t                \"time_length\": time_length,\n537\t                \"time_increment\": time_increment,\n538\t                \"real_prices\": real_prices,\n539\t            }\n540\t        )\n541\t    if not prompts:\n542\t        raise ValueError(f\"The store has no {asset} price on the path of any prediction in {predictions_root}\")\n543\t    scores = _score_prompts(\n544\t        prompts, competition.scoring_intervals, competition, miner_id, latest_formula, scoring_executor\n545\t    )\n546\t    answered = scores.loc[scores[\"crps\"] != -1, \"crps\"]\n547\t    return BacktestResult(\n548\t        miner_name=miner_name,\n549\t        prompt_df=scores,\n550\t        smoothed_scores=pd.DataFrame(),\n551\t        summary={\n552\t            \"miner_name\": miner_name,\n553\t            \"miner_id\": miner_id,\n554\t            \"num_prompts\": len(answered),\n555\t            \"mean_crps\": float(answered.mean()),\n556\t            **_realized_coverage(prompts),\n557\t        },\n558\t    )\n559\t\n560\t\n561\tdef run_backtest(\n562\t    miner_name: str,\n563\t    competition: CompetitionConfig,\n564\t    n_backtest_days: int,\n565\t    predictions_dir: Path | None = None,\n566\t    miner_id: int = 999,\n567\t    scoring_executor: ProcessPoolExecutor | None = None,\n568\t    eval_end: datetime | None = None,\n569\t    simulate_registration: datetime | None = None,\n570\t    simulate_deregistration: datetime | None = None,\n571\t    registrations: Registrations | None = None,\n572\t) -> tuple[list[BacktestResult], pd.DataFrame]:\n573\t    \"\"\"Run the full backtest for all assets in a prompt config.\n574\t\n575\t    For each asset: runs backtest, prints rank summary, saves per-asset rank chart.\n576\t    After all assets: saves total rank evolution chart + estimated earnings chart\n577\t    when ≥2 assets succeed.\n578\t\n579\t    Returns (results, combined) where:\n580\t      - results: list of successful BacktestResult (one per asset)\n581\t      - combined: per-profile combined smoothed-scores DataFrame (empty when <2 assets)\n582\t    \"\"\"\n583\t    _maybe_warn_hf_crps_formula_change(\n584\t        competition=competition,\n585\t        n_backtest_days=n_backtest_days,\n586\t        eval_end=eval_end,\n587\t        simulate_registration=simulate_registration,\n588\t        simulate_deregistration=simulate_deregistration,\n589\t    )\n590\t    _maybe_warn_competition_split(\n591\t        competition=competition,\n592\t        n_backtest_days=n_backtest_days,\n593\t        eval_end=eval_end,\n594\t        simulate_registration=simulate_registration,\n595\t        simulate_deregistration=simulate_deregistration,\n596\t    )\n597\t\n598\t    assets = competition.asset_list\n599\t    max_workers = min(len(assets), 6)\n600\t    print(f\"  Dispatching {len(assets)} assets to {max_workers} backtest workers...\")\n601\t\n602\t    # Phase 1: run backtest() for each asset in parallel (I/O-bound: API calls + disk)\n603\t    asset_results: dict[str, BacktestResult] = {}\n604\t    with ThreadPoolExecutor(max_workers=max_workers) as executor:\n605\t        futures = {\n606\t            executor.submit(\n607\t                backtest,\n608\t                miner_name=miner_name,\n609\t                asset=asset,\n610\t                time_length=competition.time_length,\n611\t                time_increment=competition.time_increment,\n612\t                n_backtest_days=n_backtest_days,\n613\t                miner_id=miner_id,\n614\t                predictions_dir=predictions_dir,\n615\t                scoring_intervals=competition.scoring_intervals,\n616\t                competition=competition,\n617\t                scoring_executor=scoring_executor,\n618\t                eval_end=eval_end,\n619\t                simulate_registration=simulate_registration,\n620\t                simulate_deregistration=simulate_deregistration,\n621\t                registrations=registrations,\n622\t            ): asset\n623\t            for asset in assets\n624\t        }\n625\t        for future in as_completed(futures):\n626\t            asset = futures[future]\n627\t            try:\n628\t                asset_results[asset] = future.result()\n629\t            except NoScoresAvailable as e:\n630\t                # Not a failure — the validator isn't prompting this asset here.\n631\t                print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n632\t                print(f\"  SKIPPED: {e}\")\n633\t            except Exception as e:\n634\t                print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n635\t                print(f\"  FAILED: {e}\")\n636\t\n637\t    # Phase 2: print summaries + plot charts sequentially (matplotlib is not thread-safe)\n638\t    results: list[BacktestResult] = []\n639\t    for asset in assets:\n640\t        if asset not in asset_results:\n641\t            continue\n642\t        result = asset_results[asset]\n643\t        results.append(result)\n644\t        summary = result.summary\n645\t\n646\t        print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n647\t        ss = result.smoothed_scores.copy()\n648\t        if not ss.empty:\n649\t            last_ts = ss[\"updated_at\"].max()\n650\t            last_slice = ss.loc[ss[\"updated_at\"] == last_ts]\n651\t            total_miners = len(last_slice)\n652\t            miner_rw = last_slice.loc[last_slice[\"miner_uid\"] == miner_id]\n653\t            if not miner_rw.empty:\n654\t                rank = int(last_slice[\"reward_weight\"].rank(ascending=False, method=\"min\").loc[miner_rw.index[0]])\n655\t                rw = float(miner_rw[\"reward_weight\"].iloc[0])\n656\t                sm = float(summary.get(\"final_smoothed_score\", 0) or 0)\n657\t                print(f\"  rank: {rank}/{total_miners}  reward_weight: {rw:.6f}  smoothed_score: {sm:.2f}\")\n658\t            else:\n659\t                print(f\"  Miner {miner_id} not found in final smoothed scores.\")\n660\t        else:\n661\t            print(f\"  No smoothed scores computed.\")\n662\t\n663\t        print(\n664\t            f\"  Prompts scored: {summary['num_prompts']}  Mean CRPS: {summary['mean_crps']:.6f}\"\n665\t            + (\n666\t                f\"  realized coverage: {summary['realized_coverage'] * 100:.2f}%\"\n667\t                if summary.get(\"realized_coverage\") is not None\n668\t                else \"\"\n669\t            )\n670\t        )\n671\t\n672\t        try:\n673\t            chart_path = plot_rank_evolution(result)\n674\t            print(f\"  Rank chart saved to: {chart_path}\")\n675\t        except (RuntimeError, Exception) as e:\n676\t            print(f\"  Chart generation failed: {e}\")\n677\t\n678\t        try:\n679\t            crps_chart = plot_crps_over_time(result)\n680\t            print(f\"  CRPS chart saved to: {crps_chart}\")\n681\t        except (RuntimeError, Exception) as e:\n682\t            print(f\"  CRPS chart generation failed: {e}\")\n683\t\n684\t        for plot_fn, chart_name in [\n685\t            (plot_crps_by_hour, \"CRPS-by-hour\"),\n686\t            (plot_crps_by_day, \"CRPS-by-day\"),\n687\t            (plot_crps_ratio_distribution, \"CRPS-ratio-dist\"),\n688\t            (plot_weekly_percentile, \"Weekly-percentile\"),\n689\t        ]:\n690\t            try:\n691\t                path = plot_fn(result)\n692\t                print(f\"  {chart_name} chart saved to: {path}\")\n693\t            except (RuntimeError, Exception) as e:\n694\t                print(f\"  {chart_name} chart generation failed: {e}\")\n695\t\n696\t    # Cross-asset charts: compute combined smoothed scores once, share across both charts.\n697\t    combined = pd.DataFrame(columns=_COMBINED_EMPTY_COLS)\n698\t    if len(results) >= 2:\n699\t        try:\n700\t            combined = compute_combined_smoothed_scores(\n701\t                results,\n702\t                competition,\n703\t                simulate_registration=simulate_registration,\n704\t                registrations=registrations,\n705\t            )\n706\t        except Exception as e:\n707\t            print(f\"  Combined smoothed scores failed: {e}\")\n708\t\n709\t        if not combined.empty:\n710\t            try:\n711\t                total_chart = plot_total_rank_evolution(\n712\t                    results,\n713\t                    combined=combined,\n714\t                    profile_label=slug_for(competition),\n715\t                )\n716\t                print(f\"  Total rank chart saved to: {total_chart}\")\n717\t            except Exception as e:\n718\t                print(f\"  Total rank chart failed: {e}\")\n719\t\n720\t            try:\n721\t                earnings_chart = plot_estimated_earnings(\n722\t                    results,\n723\t                    competition=competition,\n724\t                    combined=combined,\n725\t                )\n726\t                print(f\"  Earnings chart saved to: {earnings_chart}\")\n727\t            except Exception as e:\n728\t                print(f\"  Earnings chart failed: {e}\")\n729\t\n730\t    return results, combined\n731\t"}]},"parent_tool_use_id":null,"session_id":"b5de06de-0f9b-444f-a451-a2a51a4613ad","uuid":"25309bf6-669c-40c4-972d-a6a60d2c418b","timestamp":"2026-11-11T13:15:58.954Z","tool_use_result":{"type":"text","file":{"filePath":"/root/.claude/projects/-workspace/b5de06de-0f9b-444f-a451-a2a51a4613ad/tool-results/b2aelufz4.txt","content":"\"\"\"Backtest orchestration: one asset (backtest) and a whole competition (run_backtest).\"\"\"\n\nfrom __future__ import annotations\n\nfrom concurrent.futures import ProcessPoolExecutor, ThreadPoolExecutor, as_completed\nfrom datetime import datetime, timedelta\nfrom pathlib import Path\nfrom time import perf_counter\nfrom typing import Any\n\nimport numpy as np\nimport pandas as pd\n\nfrom synth.validator.competition_config import ALL_COMPETITIONS, CompetitionConfig\n\nfrom synth_lib.backtester.caveats import (\n    _maybe_warn_competition_split,\n    _maybe_warn_hf_crps_formula_change,\n    _maybe_warn_latest_formula,\n)\nfrom synth_lib.backtester.config import (\n    OUTLIER_CAP_DATE,\n    DEFAULT_MINER_OUTPUT_ROOT,\n    PREDICTION_MATCH_TOLERANCE_MINUTES,\n    SCORING_INTERVALS,\n    UTC,\n    _COMBINED_EMPTY_COLS,\n    competition_for,\n    slug_for,\n)\nfrom synth_lib.backtester.loading import (\n    download_price_data,\n    get_miner_scores,\n    get_rewards_history,\n)\nfrom synth_lib.backtester.preparation import (\n    _fill_gaps_from_realized_paths,\n    _find_prediction_file,\n    _slice_real_prices,\n    build_prediction_index,\n)\nfrom synth_lib.backtester.plots.crps import (\n    plot_crps_by_day,\n    plot_crps_by_hour,\n    plot_crps_over_time,\n    plot_crps_ratio_distribution,\n    plot_weekly_percentile,\n)\nfrom synth_lib.backtester.plots.earnings import (\n    plot_estimated_earnings,\n    plot_grand_total_earnings,\n)\nfrom synth_lib.backtester.plots.rank import (\n    plot_grand_total_rank_evolution,\n    plot_rank_evolution,\n    plot_total_rank_evolution,\n)\nfrom synth_lib.backtester.result import BacktestResult, NoScoresAvailable\nfrom synth_lib.backtester.scoring import (\n    Registrations,\n    _compute_prompt_score_stats_for_group,\n    _score_single_prompt,\n    _trim_warmup,\n    calculate_smoothed_scores,\n    compute_combined_smoothed_scores,\n)\n\n\ndef _realized_coverage(prompts: list[dict]) -> dict[str, object]:\n    \"\"\"How much of each prompt's realized path actually carries a price.\n\n    A prompt's CRPS is a sum over its scoring points and NaN points are dropped, so a realized path\n    with holes yields a SMALLER sum — a better-looking score from a thinner reference, not a better\n    model. The shrinkage does not show in mean_crps, which is why it is reported beside it: two runs\n    of the same champion over the same window are comparable only at equal coverage.\n    \"\"\"\n    expected = scored = 0\n    for prompt in prompts:\n        if prompt[\"file_path\"] is None:\n            continue  # no prediction at all — num_prompts already counts that, it is not coverage\n        expected += prompt[\"time_length\"] // prompt[\"time_increment\"] + 1\n        scored += int(np.isfinite(np.asarray(prompt[\"real_prices\"], dtype=float)).sum())\n    return {\n        \"realized_points_expected\": expected,\n        \"realized_points_scored\": scored,\n        \"realized_coverage\": (scored / expected) if expected else None,\n    }\n\n\ndef _score_prompts(\n    prompts: list[dict[str, Any]],\n    scoring_intervals: dict[str, int],\n    competition: CompetitionConfig,\n    miner_id: int,\n    latest_formula: bool,\n    scoring_executor: ProcessPoolExecutor | None,\n) -> pd.DataFrame:\n    \"\"\"One CRPS row per prompt, in parallel when an executor is given.\"\"\"\n    work_items = [\n        (\n            prompt[\"file_path\"],\n            prompt[\"start_time\"],\n            prompt[\"asset\"],\n            prompt[\"scored_time\"],\n            prompt[\"time_length\"],\n            prompt[\"time_increment\"],\n            prompt[\"real_prices\"],\n            scoring_intervals,\n            competition.vol_scoring_blocks,\n            miner_id,\n            latest_formula,\n        )\n        for prompt in prompts\n    ]\n    if scoring_executor is not None:\n        futures = [scoring_executor.submit(_score_single_prompt, *item) for item in work_items]\n        raw_results = [f.result() for f in futures]\n    else:\n        raw_results = [_score_single_prompt(*item) for item in work_items]\n    return pd.concat([pd.DataFrame(r, index=[0]) for r in raw_results], ignore_index=True)\n\n\ndef backtest(\n    miner_name: str = \"initial_research\",\n    asset: str = \"BTC\",\n    *,\n    time_length: int,\n    time_increment: int | None = None,\n    n_backtest_days: int = 15,\n    miner_id: int = 999,\n    predictions_dir: Path | None = None,\n    scoring_intervals: dict[str, int] | None = None,\n    competition: CompetitionConfig | None = None,\n    scoring_executor: ProcessPoolExecutor | None = None,\n    eval_end: datetime | None = None,\n    simulate_registration: datetime | None = None,\n    simulate_deregistration: datetime | None = None,\n    registrations: Registrations | None = None,\n    match_tolerance_minutes: int = PREDICTION_MATCH_TOLERANCE_MINUTES,\n    latest_formula: bool = False,\n) -> BacktestResult:\n    \"\"\"Backtest a local miner against Synth subnet scoring data.\n    Loads predictions from predictions_dir (or miner_outputs/{miner_name}/predictions/).\n    `registrations` (uid -> registration time(s) of its occupants inside the data, see\n    `get_registrations`) scores each field uid that changed hands as the miners live sees.\n    A scored prompt is answered by the latest prediction starting at or before it, at most\n    `match_tolerance_minutes` earlier; predictions on a grid pass its cadence.\n    `latest_formula` scores every prompt with the latest crypto-1h formula instead of the one live\n    when it was scored: CRPS then compares across the change, field ranks before it do not.\n    \"\"\"\n    if competition is None:\n        competition = competition_for(asset, time_length)\n    if time_increment is None:\n        time_increment = competition.time_increment\n    if scoring_intervals is None:\n        scoring_intervals = competition.scoring_intervals\n\n    # Discover predictions and their date range\n    predictions_root = predictions_dir or (DEFAULT_MINER_OUTPUT_ROOT / miner_name / \"predictions\")\n    prediction_index = build_prediction_index(predictions_root)\n    pred_times = [t.to_pydatetime() for prompts in prediction_index.values() for t in prompts]\n    if not pred_times:\n        raise FileNotFoundError(\n            f\"No predictions found in {predictions_root}. Expected the day layout \"\n            \"<asset>/<time_length>_<time_increment>/date=*.npy, or one JSON per prompt \"\n            \"named like 2026-03-28_00:00:00Z_BTC_86400.json\"\n        )\n    pred_start = min(pred_times)\n    pred_end = max(pred_times)\n\n    # Constrain backtest window to prediction coverage, scored_time against the first prediction's\n    # start less the default match tolerance, and the last one's horizon plus the match tolerance\n    # (at least an hour): a prediction answers prompts up to that tolerance after its start.\n    # Anchor priority: simulate_deregistration > eval_end > now. When the user passes\n    # simulate_registration, the window's lower bound shifts to it (minus 10d for the\n    # smoothed-score moving-average lookback) instead of `anchor − n_backtest_days`,\n    # so the API actually fetches scored prompts in the simulated mining period.\n    if simulate_deregistration is not None:\n        anchor = pd.Timestamp(simulate_deregistration).to_pydatetime()\n    elif eval_end is not None:\n        anchor = eval_end\n    else:\n        anchor = datetime.now(UTC)\n    if simulate_registration is not None:\n        window_start = pd.Timestamp(simulate_registration).to_pydatetime() - timedelta(days=competition.window_days)\n    else:\n        window_start = anchor - timedelta(days=n_backtest_days)\n    if simulate_registration is not None:\n        # The field has to be fetched from before the candidate existed: its ABSENCE there is what\n        # makes the moving average treat it as a late joiner. Clamping to prediction coverage would\n        # shorten the lookback to one horizon, and the backfill with it.\n        query_start = window_start\n    else:\n        query_start = max(\n            pred_start - timedelta(minutes=PREDICTION_MATCH_TOLERANCE_MINUTES),\n            window_start,\n        )\n    query_end = pred_end + timedelta(seconds=time_length) + timedelta(minutes=max(60, match_tolerance_minutes))\n\n    # Step 2: fetch existing miner scores\n    asset_backtest = asset\n    time_length_backtest = time_length\n    prompt_label = slug_for(competition)\n    log_prefix = f\"  [{prompt_label}/{asset_backtest}]\"\n    t_start = perf_counter()\n\n    print(\n        f\"{log_prefix} fetching scored prompts ({query_start.date()} → {min(query_end, anchor).date()})...\",\n        flush=True,\n    )\n    asset_scores = get_miner_scores(\n        start_time=query_start,\n        end_time=min(query_end, anchor),\n        asset=asset_backtest,\n        time_length=time_length_backtest,\n        time_increment=time_increment,\n    )\n    if asset_scores.empty:\n        raise NoScoresAvailable(\n            f\"no scored prompts for asset={asset_backtest}, \"\n            f\"time_length={time_length_backtest}, range=[{query_start}, {query_end}]\"\n        )\n    print(\n        f\"{log_prefix} {len(asset_scores)} score rows ({asset_scores['scored_time'].nunique()} prompts) \"\n        f\"in {perf_counter()-t_start:.1f}s\",\n        flush=True,\n    )\n    if latest_formula:\n        _maybe_warn_latest_formula(competition, asset_scores[\"scored_time\"].min())\n\n    # Step 3: fetch rewards history\n    prompt_name = None if not time_length_backtest else prompt_label\n    t_rh = perf_counter()\n    print(\n        f\"{log_prefix} fetching rewards history (prompt_name={prompt_name})...\",\n        flush=True,\n    )\n    rewards_history = get_rewards_history(\n        asset_scores[\"scored_time\"].min() - pd.Timedelta(hours=24),\n        asset_scores[\"scored_time\"].max() + pd.Timedelta(hours=24),\n        prompt_name=prompt_name,\n    )\n    if rewards_history.empty:\n        raise RuntimeError(\n            f\"Synth API returned no rewards history for prompt_name={prompt_name}, \"\n            f\"range=[{asset_scores['scored_time'].min()}, {asset_scores['scored_time'].max()}]\"\n        )\n    print(\n        f\"{log_prefix} {len(rewards_history)} rewards rows \"\n        f\"({rewards_history['updated_at'].nunique()} update rounds) in {perf_counter()-t_rh:.1f}s\",\n        flush=True,\n    )\n\n    # Step 4: align scores and rewards history time ranges\n    if asset_backtest is not None:\n        asset_scores = asset_scores.sort_values(\"scored_time\")\n        rewards_history = rewards_history.sort_values(\"updated_at\")\n\n        result = pd.merge_asof(\n            asset_scores[[\"scored_time\"]].drop_duplicates(),\n            rewards_history[[\"updated_at\"]].drop_duplicates(),\n            left_on=\"scored_time\",\n            right_on=\"updated_at\",\n            direction=\"forward\",\n        )\n        result = result[~result[\"updated_at\"].isna()]\n        rewards_history = rewards_history.loc[rewards_history[\"updated_at\"].isin(result[\"updated_at\"])].copy()\n        asset_scores = asset_scores.loc[asset_scores[\"scored_time\"].isin(result[\"scored_time\"])].copy()\n    else:\n        if rewards_history[\"updated_at\"].max() < asset_scores[\"scored_time\"].max():\n            max_scored_time = asset_scores.loc[\n                asset_scores[\"scored_time\"] <= rewards_history[\"updated_at\"].max(),\n                \"scored_time\",\n            ].max()\n            asset_scores = asset_scores.loc[asset_scores[\"scored_time\"] <= max_scored_time].copy()\n        elif rewards_history[\"updated_at\"].max() > asset_scores[\"scored_time\"].max():\n            max_upd_at = rewards_history.loc[\n                rewards_history[\"updated_at\"] >= asset_scores[\"scored_time\"].max(),\n                \"updated_at\",\n            ].min()\n            rewards_history = rewards_history.loc[rewards_history[\"updated_at\"] <= max_upd_at].copy()\n\n    # Step 5: download asset price data, up to the last prompt's end\n    asset_prices: dict[str, pd.DataFrame] = {}\n    for asset_ in asset_scores[\"asset\"].unique():\n        st_ = asset_scores[\"start_time\"].min() - pd.Timedelta(hours=2)\n        en_ = asset_scores[\"start_time\"].max() + pd.Timedelta(seconds=time_length)\n        asset_prices[asset_] = download_price_data(st_, en_, asset_, freq=\"1min\")\n\n    # Step 6: score LLM miner predictions\n    start_times = asset_scores[\"start_time\"].sort_values().unique()\n    t_score = perf_counter()\n    print(\n        f\"{log_prefix} scoring {len(start_times)} prompts against local predictions...\",\n        flush=True,\n    )\n\n    # Pre-build work items: resolve file paths and slice prices upfront\n    prompts: list[dict[str, Any]] = []\n\n    for start_time in start_times:\n        scores_subset = asset_scores.loc[asset_scores[\"start_time\"] == start_time].copy()\n\n        for _, asset_val, scored_time, time_len, time_incr in (\n            scores_subset[[\"asset\", \"scored_time\", \"time_length\", \"time_increment\"]].drop_duplicates().itertuples()\n        ):\n            file_path = _find_prediction_file(\n                prediction_index, start_time, asset_val, time_len, match_tolerance_minutes\n            )\n\n            # Pre-slice real prices in the main process (avoids pickling DataFrames)\n            real_prices: list[float] = []\n            if file_path is not None:\n                real_prices = _slice_real_prices(asset_prices[asset_val], start_time, time_len, time_incr)\n\n            prompts.append(\n                {\n                    \"file_path\": file_path,\n                    \"start_time\": start_time,\n                    \"asset\": asset_val,\n                    \"scored_time\": scored_time,\n                    \"time_length\": time_len,\n                    \"time_increment\": time_incr,\n                    \"real_prices\": real_prices,\n                }\n            )\n\n    _fill_gaps_from_realized_paths(prompts, log_prefix)\n    realized_coverage = _realized_coverage(prompts)\n\n    # Step 7: concatenate LLM miner scores\n    if not prompts:\n        raise RuntimeError(\n            \"No prediction files matched any scored prompt. \"\n            \"Check that prediction filenames align with the scored time range.\"\n        )\n    new_scores = _score_prompts(prompts, scoring_intervals, competition, miner_id, latest_formula, scoring_executor)\n    print(\n        f\"{log_prefix} scored {len(new_scores)} prompts in {perf_counter()-t_score:.1f}s\",\n        flush=True,\n    )\n\n    # Step 8: trim to valid range\n    new_scores = new_scores.sort_values(\"scored_time\")\n    valid_scores = new_scores.loc[new_scores[\"crps\"] != -1]\n    if valid_scores.empty:\n        raise RuntimeError(\n            \"All matched predictions resulted in crps=-1 (scoring failures). \" \"No valid backtest results to report.\"\n        )\n    end_backtest_time = valid_scores[\"scored_time\"].max()\n    new_scores = new_scores.loc[new_scores[\"scored_time\"] <= end_backtest_time]\n    asset_scores = asset_scores.loc[asset_scores[\"scored_time\"] <= end_backtest_time]\n\n    # Optional: simulate the miner registering on a specific date by dropping our\n    # CRPS rows for the prompts issued before that date: a miner answers only the\n    # prompts sent once it is registered, so its first score lands a horizon later.\n    # synth.validator.prepare_df_for_moving_average then sees our miner's first\n    # scored_time > global_min and applies the same worst-score backfill it gives\n    # real late-joining miners — making rank comparisons symmetric instead of giving\n    # us an unfair \"from-the-start\" boost.\n    if simulate_registration is not None:\n        sim_reg = pd.Timestamp(simulate_registration)\n        new_scores = new_scores.loc[new_scores[\"start_time\"] >= sim_reg]\n        if new_scores.empty:\n            raise RuntimeError(\n                f\"simulate_registration={sim_reg} drops all of our miner's CRPS rows; \" f\"no valid backtest results.\"\n            )\n    if simulate_deregistration is not None:\n        sim_dereg = pd.Timestamp(simulate_deregistration)\n        new_scores = new_scores.loc[new_scores[\"scored_time\"] <= sim_dereg]\n        if new_scores.empty:\n            raise RuntimeError(\n                f\"simulate_deregistration={sim_dereg} drops all of our miner's CRPS rows; \"\n                f\"no valid backtest results.\"\n            )\n\n    # Step 9: merge LLM scores with all miner scores\n    all_scores = pd.concat([asset_scores, new_scores], ignore_index=True)\n    all_scores = all_scores.sort_values([\"scored_time\", \"miner_uid\"])\n\n    if rewards_history[\"updated_at\"].max() < all_scores[\"scored_time\"].max():\n        max_scored_time = all_scores.loc[\n            all_scores[\"scored_time\"] <= rewards_history[\"updated_at\"].max(),\n            \"scored_time\",\n        ].max()\n        all_scores = all_scores.loc[all_scores[\"scored_time\"] <= max_scored_time].copy()\n    elif rewards_history[\"updated_at\"].max() > all_scores[\"scored_time\"].max():\n        max_upd_at = rewards_history.loc[\n            rewards_history[\"updated_at\"] >= all_scores[\"scored_time\"].max(),\n            \"updated_at\",\n        ].min()\n        rewards_history = rewards_history.loc[rewards_history[\"updated_at\"] <= max_upd_at].copy()\n\n    # Step 12: apply prompt score calculation across all scores. We also persist\n    # percentile95 and lowest_score per group because prepare_df_for_moving_average\n    # uses them to compute the worst-score backfill for new miners (silently\n    # skips backfill when those columns are absent).\n    # Split on the outlier-cap cutover before grouping. scored_time is a group key, so every row\n    # in a group is on the same side and no group is ever split by this.\n    keys = [\"scored_time\", \"asset\", \"time_length\", \"time_increment\"]\n    capped_era = pd.to_datetime(all_scores[\"scored_time\"], utc=True) >= OUTLIER_CAP_DATE\n    parts = [\n        all_scores.loc[mask]\n        .groupby(keys, group_keys=False)[\"crps\"]\n        .apply(_compute_prompt_score_stats_for_group, capped_era=era)\n        for era, mask in ((True, capped_era), (False, ~capped_era))\n        if mask.any()\n    ]\n    _stats = pd.concat(parts).reindex(all_scores.index)\n    all_scores[\"new_prompt_scores\"] = _stats[\"new_prompt_scores\"]\n    all_scores[\"percentile95\"] = _stats[\"percentile95\"]\n    all_scores[\"lowest_score\"] = _stats[\"lowest_score\"]\n\n    # Step 13: build rewards history entries for LLM miner\n    new_miner_rewards_list = []\n    for prompt_name_item in rewards_history[\"prompt_name\"].unique():\n        new_miner_rewards_prompt = pd.DataFrame(\n            {\n                \"updated_at\": rewards_history.loc[rewards_history[\"prompt_name\"] == prompt_name_item, \"updated_at\"]\n                .sort_values()\n                .unique(),\n                \"miner_uid\": miner_id,\n                \"prompt_name\": prompt_name_item,\n            }\n        )\n        new_miner_rewards_list.append(new_miner_rewards_prompt)\n    new_miner_rewards = pd.concat(new_miner_rewards_list, ignore_index=True).sort_values(\"updated_at\")\n\n    # Step 14: merge LLM miner rewards into full rewards history\n    rewards_history = pd.concat(\n        [\n            rewards_history,\n            new_miner_rewards,\n        ]\n    ).sort_values([\"updated_at\", \"prompt_name\", \"miner_uid\"])\n\n    # Step 15: recalculate smoothed scores including LLM miner\n    n_rounds = rewards_history[\"updated_at\"].nunique()\n    t_smooth = perf_counter()\n    print(\n        f\"{log_prefix} computing smoothed scores over {n_rounds} reward rounds...\",\n        flush=True,\n    )\n    recalculated_smoothed_scores = calculate_smoothed_scores(\n        all_scores,\n        rewards_history,\n        cutoff_days=competition.window_days,\n        scores_column=\"new_prompt_scores\",\n        competition=competition,\n        registrations=registrations,\n    )\n    print(\n        f\"{log_prefix} smoothed scores done in {perf_counter()-t_smooth:.1f}s \"\n        f\"(total backtest: {perf_counter()-t_start:.1f}s)\",\n        flush=True,\n    )\n\n    # Trim the first `competition.window_days` of smoothed_scores when no\n    # simulate_registration is set. In that case the backfill artifact applies to\n    # real late-joining miners and inflates our rank — we want to hide it.\n    # When simulate_registration IS set, the backfill applies to OUR miner and\n    # the warmup ramp-up is the whole point of the simulation — don't trim it.\n    if simulate_registration is None:\n        recalculated_smoothed_scores = _trim_warmup(\n            recalculated_smoothed_scores,\n            all_scores,\n            warmup_days=competition.window_days,\n        )\n\n    miner_smoothed = recalculated_smoothed_scores.loc[\n        recalculated_smoothed_scores[\"miner_uid\"] == miner_id, \"new_smoothed_score\"\n    ]\n    summary: dict[str, Any] = {\n        \"miner_name\": miner_name,\n        \"miner_id\": miner_id,\n        \"num_prompts\": int((new_scores[\"crps\"] != -1).sum()),\n        \"mean_crps\": float(new_scores.loc[new_scores[\"crps\"] != -1, \"crps\"].mean()),\n        \"final_smoothed_score\": (float(miner_smoothed.iloc[-1]) if not miner_smoothed.empty else None),\n        **realized_coverage,\n    }\n\n    return BacktestResult(\n        miner_name=miner_name,\n        prompt_df=all_scores,\n        smoothed_scores=recalculated_smoothed_scores,\n        summary=summary,\n    )\n\n\ndef score_crps(\n    miner_name: str = \"initial_research\",\n    asset: str = \"BTC\",\n    *,\n    time_length: int,\n    time_increment: int | None = None,\n    miner_id: int = 999,\n    predictions_dir: Path | None = None,\n    competition: CompetitionConfig | None = None,\n    scoring_executor: ProcessPoolExecutor | None = None,\n    latest_formula: bool = True,\n) -> BacktestResult:\n    \"\"\"Each prediction's CRPS against the local store's prices, without the field: no rank, no API.\n\n    Every prediction is a prompt at its own start time, scored one horizon later with the\n    validator's CRPS, crypto-1h's latest formula unless `latest_formula` is False. It works on any\n    window the store covers, including where no field scores exist. The reference is the store's\n    closes only, never the validator's realized path: a minute without a price drops out of the\n    sum, which `realized_coverage` reports, and a prediction whose path holds no price after its\n    start is left out. `smoothed_scores` is empty.\n    \"\"\"\n    if competition is None:\n        competition = competition_for(asset, time_length)\n    if time_increment is None:\n        time_increment = competition.time_increment\n    predictions_root = predictions_dir or (DEFAULT_MINER_OUTPUT_ROOT / miner_name / \"predictions\")\n    predictions = sorted(build_prediction_index(predictions_root).get((asset, time_length), {}).items())\n    if not predictions:\n        raise FileNotFoundError(f\"No {asset} predictions for time_length={time_length} in {predictions_root}\")\n\n    horizon = pd.Timedelta(seconds=time_length)\n    prices = download_price_data(\n        predictions[0][0] - pd.Timedelta(hours=2), predictions[-1][0] + horizon, asset, freq=\"1min\"\n    )\n    prompts = []\n    for start, ref in predictions:\n        real_prices = _slice_real_prices(prices, start, time_length, time_increment)\n        # A reference with no price after its start scores 0, the best CRPS there is.\n        if not np.isfinite(np.asarray(real_prices[1:], dtype=float)).any():\n            continue\n        prompts.append(\n            {\n                \"file_path\": ref,\n                \"start_time\": start,\n                \"asset\": asset,\n                \"scored_time\": start + horizon,\n                \"time_length\": time_length,\n                \"time_increment\": time_increment,\n                \"real_prices\": real_prices,\n            }\n        )\n    if not prompts:\n        raise ValueError(f\"The store has no {asset} price on the path of any prediction in {predictions_root}\")\n    scores = _score_prompts(\n        prompts, competition.scoring_intervals, competition, miner_id, latest_formula, scoring_executor\n    )\n    answered = scores.loc[scores[\"crps\"] != -1, \"crps\"]\n    return BacktestResult(\n        miner_name=miner_name,\n        prompt_df=scores,\n        smoothed_scores=pd.DataFrame(),\n        summary={\n            \"miner_name\": miner_name,\n            \"miner_id\": miner_id,\n            \"num_prompts\": len(answered),\n            \"mean_crps\": float(answered.mean()),\n            **_realized_coverage(prompts),\n        },\n    )\n\n\ndef run_backtest(\n    miner_name: str,\n    competition: CompetitionConfig,\n    n_backtest_days: int,\n    predictions_dir: Path | None = None,\n    miner_id: int = 999,\n    scoring_executor: ProcessPoolExecutor | None = None,\n    eval_end: datetime | None = None,\n    simulate_registration: datetime | None = None,\n    simulate_deregistration: datetime | None = None,\n    registrations: Registrations | None = None,\n) -> tuple[list[BacktestResult], pd.DataFrame]:\n    \"\"\"Run the full backtest for all assets in a prompt config.\n\n    For each asset: runs backtest, prints rank summary, saves per-asset rank chart.\n    After all assets: saves total rank evolution chart + estimated earnings chart\n    when ≥2 assets succeed.\n\n    Returns (results, combined) where:\n      - results: list of successful BacktestResult (one per asset)\n      - combined: per-profile combined smoothed-scores DataFrame (empty when <2 assets)\n    \"\"\"\n    _maybe_warn_hf_crps_formula_change(\n        competition=competition,\n        n_backtest_days=n_backtest_days,\n        eval_end=eval_end,\n        simulate_registration=simulate_registration,\n        simulate_deregistration=simulate_deregistration,\n    )\n    _maybe_warn_competition_split(\n        competition=competition,\n        n_backtest_days=n_backtest_days,\n        eval_end=eval_end,\n        simulate_registration=simulate_registration,\n        simulate_deregistration=simulate_deregistration,\n    )\n\n    assets = competition.asset_list\n    max_workers = min(len(assets), 6)\n    print(f\"  Dispatching {len(assets)} assets to {max_workers} backtest workers...\")\n\n    # Phase 1: run backtest() for each asset in parallel (I/O-bound: API calls + disk)\n    asset_results: dict[str, BacktestResult] = {}\n    with ThreadPoolExecutor(max_workers=max_workers) as executor:\n        futures = {\n            executor.submit(\n                backtest,\n                miner_name=miner_name,\n                asset=asset,\n                time_length=competition.time_length,\n                time_increment=competition.time_increment,\n                n_backtest_days=n_backtest_days,\n                miner_id=miner_id,\n                predictions_dir=predictions_dir,\n                scoring_intervals=competition.scoring_intervals,\n                competition=competition,\n                scoring_executor=scoring_executor,\n                eval_end=eval_end,\n                simulate_registration=simulate_registration,\n                simulate_deregistration=simulate_deregistration,\n                registrations=registrations,\n            ): asset\n            for asset in assets\n        }\n        for future in as_completed(futures):\n            asset = futures[future]\n            try:\n                asset_results[asset] = future.result()\n            except NoScoresAvailable as e:\n                # Not a failure — the validator isn't prompting this asset here.\n                print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n                print(f\"  SKIPPED: {e}\")\n            except Exception as e:\n                print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n                print(f\"  FAILED: {e}\")\n\n    # Phase 2: print summaries + plot charts sequentially (matplotlib is not thread-safe)\n    results: list[BacktestResult] = []\n    for asset in assets:\n        if asset not in asset_results:\n            continue\n        result = asset_results[asset]\n        results.append(result)\n        summary = result.summary\n\n        print(f\"\\n--- BACKTEST [{competition.label}/{asset}] ---\")\n        ss = result.smoothed_scores.copy()\n        if not ss.empty:\n            last_ts = ss[\"updated_at\"].max()\n            last_slice = ss.loc[ss[\"updated_at\"] == last_ts]\n            total_miners = len(last_slice)\n            miner_rw = last_slice.loc[last_slice[\"miner_uid\"] == miner_id]\n            if not miner_rw.empty:\n                rank = int(last_slice[\"reward_weight\"].rank(ascending=False, method=\"min\").loc[miner_rw.index[0]])\n                rw = float(miner_rw[\"reward_weight\"].iloc[0])\n                sm = float(summary.get(\"final_smoothed_score\", 0) or 0)\n                print(f\"  rank: {rank}/{total_miners}  reward_weight: {rw:.6f}  smoothed_score: {sm:.2f}\")\n            else:\n                print(f\"  Miner {miner_id} not found in final smoothed scores.\")\n        else:\n            print(f\"  No smoothed scores computed.\")\n\n        print(\n            f\"  Prompts scored: {summary['num_prompts']}  Mean CRPS: {summary['mean_crps']:.6f}\"\n            + (\n                f\"  realized coverage: {summary['realized_coverage'] * 100:.2f}%\"\n                if summary.get(\"realized_coverage\") is not None\n                else \"\"\n            )\n        )\n\n        try:\n            chart_path = plot_rank_evolution(result)\n            print(f\"  Rank chart saved to: {chart_path}\")\n        except (RuntimeError, Exception) as e:\n            print(f\"  Chart generation failed: {e}\")\n\n        try:\n            crps_chart = plot_crps_over_time(result)\n            print(f\"  CRPS chart saved to: {crps_chart}\")\n        except (RuntimeError, Exception) as e:\n            print(f\"  CRPS chart generation failed: {e}\")\n\n        for plot_fn, chart_name in [\n            (plot_crps_by_hour, \"CRPS-by-hour\"),\n            (plot_crps_by_day, \"CRPS-by-day\"),\n            (plot_crps_ratio_distribution, \"CRPS-ratio-dist\"),\n            (plot_weekly_percentile, \"Weekly-percentile\"),\n        ]:\n            try:\n                path = plot_fn(result)\n                print(f\"  {chart_name} chart saved to: {path}\")\n            except (RuntimeError, Exception) as e:\n                print(f\"  {chart_name} chart generation failed: {e}\")\n\n    # Cross-asset charts: compute combined smoothed scores once, share across both charts.\n    combined = pd.DataFrame(columns=_COMBINED_EMPTY_COLS)\n    if len(results) >= 2:\n        try:\n            combined = compute_combined_smoothed_scores(\n                results,\n                competition,\n                simulate_registration=simulate_registration,\n                registrations=registrations,\n            )\n        except Exception as e:\n            print(f\"  Combined smoothed scores failed: {e}\")\n\n        if not combined.empty:\n            try:\n                total_chart = plot_total_rank_evolution(\n                    results,\n                    combined=combined,\n                    profile_label=slug_for(competition),\n                )\n                print(f\"  Total rank chart saved to: {total_chart}\")\n            except Exception as e:\n                print(f\"  Total rank chart failed: {e}\")\n\n            try:\n                earnings_chart = plot_estimated_earnings(\n                    results,\n                    competition=competition,\n                    combined=combined,\n                )\n                print(f\"  Earnings chart saved to: {earnings_chart}\")\n            except Exception as e:\n                print(f\"  Earnings chart failed: {e}\")\n\n    return results, combined\n","numLines":731,"startLine":1,"totalLines":731}},"tool_result_meta":[{"id":"toolu_01GHbUhfKE8stpRxjknoyiaQ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
