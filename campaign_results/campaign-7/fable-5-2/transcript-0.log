{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0195uermAefUW3kweKx5tSRy","type":"tool_result","content":"1\tfrom datetime import datetime\n2\timport typing\n3\t\n4\t\n5\timport numpy as np\n6\timport pandas as pd\n7\tfrom pandas import DataFrame\n8\timport bittensor as bt\n9\t\n10\t\n11\tfrom synth.utils.logging import print_execution_time\n12\tfrom synth.validator.miner_data_handler import MinerDataHandler\n13\tfrom synth.validator.competition_config import CompetitionConfig\n14\tfrom synth.validator.competition_config import SMOOTHED_SCORE_COEFFICIENT\n15\tfrom synth.validator.competition_config import VHFT_MAX_PARTICIPANTS\n16\tfrom synth.validator.competition_config import VHFT_MIN_PARTICIPANTS\n17\tfrom synth.validator.reward import compute_softmax\n18\t\n19\t# Per-asset weighting coefficients for score normalization across assets.\n20\t# Higher coefficient = asset scores contribute more to the smoothed score.\n21\tASSET_COEFFICIENTS = {\n22\t    \"BTC\": 1.0,\n23\t    \"ETH\": 0.7064366394033871,\n24\t    \"XAU\": 1.7370922597118699,\n25\t    \"SOL\": 0.6310037175639559,\n26\t    \"SP500\": 3.437935601155441,\n27\t    \"NVDAX\": 1.6028217601617174,\n28\t    \"TSLAX\": 1.6068755936957768,\n29\t    \"AAPLX\": 2.0916380815843123,\n30\t    \"GOOGLX\": 1.6827392777257926,\n31\t    \"XRP\": 0.5658394110809131,\n32\t    \"HYPE\": 0.4784547133706857,\n33\t    \"WTIOIL\": 0.8475062847978935,\n34\t    \"SPCX\": 0.4329342627683478,\n35\t}\n36\t\n37\t\n38\t@print_execution_time\n39\tdef prepare_df_for_moving_average(df):\n40\t    \"\"\"Prepare miner scores for moving average computation.\n41\t\n42\t    For miners that joined after the earliest scored_time in the window,\n43\t    backfills missing earlier timestamps with the worst score (percentile95 - lowest_score)\n44\t    so they are not unfairly advantaged by having fewer data points.\n45\t\n46\t    Miners present from the start keep only their real scores (no backfill).\n47\t    \"\"\"\n48\t    df = df.copy()\n49\t    df[\"scored_time\"] = pd.to_datetime(df[\"scored_time\"])\n50\t\n51\t    global_min = df[\"scored_time\"].min()\n52\t    all_times = sorted(df[\"scored_time\"].unique())\n53\t\n54\t    # Build worst-score and asset mappings per scored_time (used for backfilling new miners)\n55\t    global_worst_score_mapping = {}\n56\t    global_score_asset_mapping = {}\n57\t    for t in all_times:\n58\t        sample = df.loc[df[\"scored_time\"] == t].iloc[0]\n59\t        p95 = sample.get(\"percentile95\")\n60\t        low = sample.get(\"lowest_score\")\n61\t        if p95 is None or low is None:\n62\t            continue\n63\t        global_worst_score_mapping[t] = p95 - low\n64\t        global_score_asset_mapping[t] = sample[\"asset\"]\n65\t\n66\t    # Identify new miners (first appearance after the window start)\n67\t    miner_first = df.groupby(\"miner_id\")[\"scored_time\"].min()\n68\t    new_miner_ids = miner_first[miner_first > global_min].index\n69\t\n70\t    if len(new_miner_ids) == 0:\n71\t        # No new miners - just return the real data (common fast path)\n72\t        out = df[\n73\t            [\"scored_time\", \"miner_id\", \"prompt_score_v3\", \"asset\"]\n74\t        ].copy()\n75\t        out[\"miner_id\"] = out[\"miner_id\"].astype(int)\n76\t        out = out.sort_values([\"scored_time\", \"miner_id\"]).reset_index(\n77\t            drop=True\n78\t        )\n79\t        return out\n80\t\n81\t    # Build backfill rows only for new miners at times before they joined\n82\t    backfill_rows = []\n83\t    backfill_times = [t for t in all_times if t in global_worst_score_mapping]\n84\t    for mid in new_miner_ids:\n85\t        first_time = miner_first[mid]\n86\t        for t in backfill_times:\n87\t            if t >= first_time:\n88\t                continue\n89\t            backfill_rows.append(\n90\t                {\n91\t                    \"scored_time\": t,\n92\t                    \"miner_id\": mid,\n93\t                    \"prompt_score_v3\": global_worst_score_mapping[t],\n94\t                    \"asset\": global_score_asset_mapping[t],\n95\t                }\n96\t            )\n97\t\n98\t    # Combine real data with backfill rows\n99\t    out = df[[\"scored_time\", \"miner_id\", \"prompt_score_v3\", \"asset\"]].copy()\n100\t    if backfill_rows:\n101\t        backfill_df = pd.DataFrame(backfill_rows)\n102\t        backfill_df[\"scored_time\"] = pd.to_datetime(backfill_df[\"scored_time\"])\n103\t        out = pd.concat([out, backfill_df], ignore_index=True)\n104\t\n105\t    out[\"miner_id\"] = out[\"miner_id\"].astype(int)\n106\t    out = out.sort_values([\"scored_time\", \"miner_id\"]).reset_index(drop=True)\n107\t    return out\n108\t\n109\t\n110\t@print_execution_time\n111\tdef compute_smoothed_score(\n112\t    miner_data_handler: MinerDataHandler,\n113\t    input_df: DataFrame,\n114\t    scored_time: datetime,\n115\t    comp: CompetitionConfig,\n116\t) -> typing.Optional[list[dict]]:\n117\t    \"\"\"Compute smoothed scores and reward weights for all miners.\n118\t\n119\t    1. Filters scores to the scoring window (scored_time cutoff)\n120\t    2. Applies per-asset coefficient weighting (vectorized)\n121\t    3. Sums weighted scores per miner\n122\t    4. Assigns inf to miners with no valid scores\n123\t    5. Computes softmax reward weights\n124\t    \"\"\"\n125\t    if input_df.empty:\n126\t        return None\n127\t\n128\t    # Filter to scoring window and drop NaN scores\n129\t    df = input_df.loc[\n130\t        pd.to_datetime(input_df[\"scored_time\"]) <= scored_time\n131\t    ].copy()\n132\t    df = df.dropna(subset=[\"prompt_score_v3\"])\n133\t\n134\t    if df.empty:\n135\t        return None\n136\t\n137\t    # Apply per-asset coefficients vectorized (single pass, no per-miner loop).\n138\t    # Normalization is per-miner: each miner's scores are divided by the sum of\n139\t    # coefficients for that miner's assets.\n140\t    coefs = df[\"asset\"].map(ASSET_COEFFICIENTS).fillna(1.0)\n141\t    df[\"weighted_score\"] = df[\"prompt_score_v3\"] * coefs\n142\t    miner_coef_sums = coefs.groupby(df[\"miner_id\"]).sum()\n143\t    df[\"weighted_score\"] /= df[\"miner_id\"].map(miner_coef_sums)\n144\t\n145\t    # Sum per miner in one groupby\n146\t    rolling_avgs = df.groupby(\"miner_id\")[\"weighted_score\"].sum()\n147\t\n148\t    # Miners present in input but with all NaN scores get inf (worst possible)\n149\t    all_miner_ids = input_df[\"miner_id\"].unique()\n150\t    missing_miners = set(all_miner_ids) - set(rolling_avgs.index)\n151\t    for miner_id in missing_miners:\n152\t        bt.logging.warning(\n153\t            f\"Miner ID {miner_id} has no valid scores in the window. Assigning infinite rolling average.\"\n154\t        )\n155\t        rolling_avgs.loc[miner_id] = float(\"inf\")\n156\t\n157\t    rolling_avg_data = [\n158\t        {\"miner_id\": int(mid), \"rolling_avg\": float(val)}\n159\t        for mid, val in rolling_avgs.items()\n160\t    ]\n161\t\n162\t    # Resolve miner_id -> miner_uid\n163\t    moving_averages_data = miner_data_handler.populate_miner_uid_in_miner_data(\n164\t        rolling_avg_data\n165\t    )\n166\t\n167\t    if moving_averages_data is None:\n168\t        return None\n169\t\n170\t    # Filter out miners with no UID (deregistered)\n171\t    filtered_moving_averages_data = [\n172\t        item for item in moving_averages_data if item[\"miner_uid\"] is not None\n173\t    ]\n174\t\n175\t    # Softmax: negative beta means lower score = higher reward\n176\t    rolling_avg_list = [\n177\t        r[\"rolling_avg\"] for r in filtered_moving_averages_data\n178\t    ]\n179\t    reward_weight_list = compute_softmax(\n180\t        np.array(rolling_avg_list), comp.softmax_beta\n181\t    )\n182\t\n183\t    rewards = []\n184\t    for item, reward_weight in zip(\n185\t        filtered_moving_averages_data, reward_weight_list\n186\t    ):\n187\t        if float(reward_weight) > 0:\n188\t            rewards.append(\n189\t                {\n190\t                    \"miner_id\": item[\"miner_id\"],\n191\t                    \"miner_uid\": item[\"miner_uid\"],\n192\t                    \"smoothed_score\": item[\"rolling_avg\"],\n193\t                    \"reward_weight\": float(reward_weight)\n194\t                    * SMOOTHED_SCORE_COEFFICIENT,\n195\t                    \"updated_at\": scored_time.isoformat(),\n196\t                    \"prompt_name\": comp.label,\n197\t                }\n198\t            )\n199\t\n200\t    return rewards\n201\t\n202\t\n203\t@print_execution_time\n204\tdef compute_vhft_smoothed_score(\n205\t    miner_data_handler: MinerDataHandler,\n206\t    vhft_scores: dict[int, float],\n207\t    scored_time: datetime,\n208\t    comp: CompetitionConfig,\n209\t) -> typing.Optional[list[dict]]:\n210\t    \"\"\"Shape external VHFT per-uid scores into reward-weight dicts.\n211\t\n212\t    `vhft_scores` is {miner_uid: mean_crps} for VHFT participants only (already\n213\t    windowed by the external scorer), so there is NO per-window aggregation here —\n214\t    we go straight to the same softmax x SMOOTHED_SCORE_COEFFICIENT tail as\n215\t    compute_smoothed_score, keeping shaping uniform across all four competitions.\n216\t\n217\t    Maps uid -> miner_id (the key combine_moving_averages merges on), dropping uids\n218\t    with no Postgres identity (unregistered). Returns None if nothing maps, or if\n219\t    the surviving field falls outside VHFT_MIN/MAX_PARTICIPANTS — the block is a\n220\t    fixed share however many miners split it, so too few is a concentration risk\n221\t    and too many is a malfunctioning scorer. Either way the caller skips VHFT for\n222\t    the cycle and the other three competitions still set weights.\n223\t    \"\"\"\n224\t    if not vhft_scores:\n225\t        return None\n226\t\n227\t    uid_to_miner_id = miner_data_handler.get_miner_uid_to_id_map()\n228\t    if not uid_to_miner_id:\n229\t        return None\n230\t\n231\t    scored = [\n232\t        {\n233\t            \"miner_id\": uid_to_miner_id[uid],\n234\t            \"miner_uid\": uid,\n235\t            \"rolling_avg\": crps,\n236\t        }\n237\t        for uid, crps in vhft_scores.items()\n238\t        if uid in uid_to_miner_id\n239\t    ]\n240\t    if not scored:\n241\t        return None\n242\t\n243\t    # Concentration guard. Checked AFTER the identity mapping above, on the\n244\t    # miners that will actually be paid: 9 scored uids of which only 1 is\n245\t    # registered concentrates exactly as hard as 1 scored uid, and a raw\n246\t    # len(vhft_scores) check would miss that.\n247\t    if not VHFT_MIN_PARTICIPANTS <= len(scored) <= VHFT_MAX_PARTICIPANTS:\n248\t        bt.logging.warning(\n249\t            f\"VHFT: {len(scored)} scored participant(s) outside the plausible \"\n250\t            f\"range [{VHFT_MIN_PARTICIPANTS}, {VHFT_MAX_PARTICIPANTS}] — \"\n251\t            f\"skipping the VHFT blend this cycle rather than concentrating \"\n252\t            f\"its share on too few miners\"\n253\t        )\n254\t        return None\n255\t\n256\t    # Same softmax tail as compute_smoothed_score: negative beta -> lower CRPS wins.\n257\t    reward_weight_list = compute_softmax(\n258\t        np.array([s[\"rolling_avg\"] for s in scored]), comp.softmax_beta\n259\t    )\n260\t\n261\t    rewards = []\n262\t    for item, reward_weight in zip(scored, reward_weight_list):\n263\t        if float(reward_weight) > 0:\n264\t            rewards.append(\n265\t                {\n266\t                    \"miner_id\": item[\"miner_id\"],\n267\t                    \"miner_uid\": item[\"miner_uid\"],\n268\t                    \"smoothed_score\": item[\"rolling_avg\"],\n269\t                    \"reward_weight\": float(reward_weight)\n270\t                    * SMOOTHED_SCORE_COEFFICIENT,\n271\t                    \"updated_at\": scored_time.isoformat(),\n272\t                    \"prompt_name\": comp.label,\n273\t                }\n274\t            )\n275\t\n276\t    return rewards\n277\t\n278\t\n279\tdef print_rewards_df(moving_averages_data: list[dict], label: str = \"\"):\n280\t    bt.logging.info(f\"Scored responses moving averages {label}\")\n281\t    df = pd.DataFrame.from_dict(moving_averages_data)\n282\t    bt.logging.info(df.to_string())\n283\t\n284\t\n285\t@print_execution_time\n286\tdef combine_moving_averages(\n287\t    moving_averages_data: dict[str, list[dict]],\n288\t) -> list[dict]:\n289\t    \"\"\"Combine reward weights from competitions.\n290\t\n291\t    Same miner appearing in multiple competitions gets their weights summed.\n292\t    \"\"\"\n293\t    map_miner_reward: dict[int, dict] = {}\n294\t\n295\t    for moving_averages in list(moving_averages_data.values()):\n296\t        for reward in moving_averages:\n297\t            miner_id = reward[\"miner_id\"]\n298\t            if miner_id in map_miner_reward:\n299\t                map_miner_reward[miner_id][\"reward_weight\"] += reward[\n300\t                    \"reward_weight\"\n301\t                ]\n302\t            else:\n303\t                map_miner_reward[miner_id] = reward\n304\t\n305\t    return list(map_miner_reward.values())\n306\t"}]},"parent_tool_use_id":null,"session_id":"b5de06de-0f9b-444f-a451-a2a51a4613ad","uuid":"3ae2b8fc-a78a-4ca6-9706-12ca86af9c26","timestamp":"2026-11-11T13:14:47.983Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/.venv/lib/python3.12/site-packages/synth/validator/moving_average.py","content":"from datetime import datetime\nimport typing\n\n\nimport numpy as np\nimport pandas as pd\nfrom pandas import DataFrame\nimport bittensor as bt\n\n\nfrom synth.utils.logging import print_execution_time\nfrom synth.validator.miner_data_handler import MinerDataHandler\nfrom synth.validator.competition_config import CompetitionConfig\nfrom synth.validator.competition_config import SMOOTHED_SCORE_COEFFICIENT\nfrom synth.validator.competition_config import VHFT_MAX_PARTICIPANTS\nfrom synth.validator.competition_config import VHFT_MIN_PARTICIPANTS\nfrom synth.validator.reward import compute_softmax\n\n# Per-asset weighting coefficients for score normalization across assets.\n# Higher coefficient = asset scores contribute more to the smoothed score.\nASSET_COEFFICIENTS = {\n    \"BTC\": 1.0,\n    \"ETH\": 0.7064366394033871,\n    \"XAU\": 1.7370922597118699,\n    \"SOL\": 0.6310037175639559,\n    \"SP500\": 3.437935601155441,\n    \"NVDAX\": 1.6028217601617174,\n    \"TSLAX\": 1.6068755936957768,\n    \"AAPLX\": 2.0916380815843123,\n    \"GOOGLX\": 1.6827392777257926,\n    \"XRP\": 0.5658394110809131,\n    \"HYPE\": 0.4784547133706857,\n    \"WTIOIL\": 0.8475062847978935,\n    \"SPCX\": 0.4329342627683478,\n}\n\n\n@print_execution_time\ndef prepare_df_for_moving_average(df):\n    \"\"\"Prepare miner scores for moving average computation.\n\n    For miners that joined after the earliest scored_time in the window,\n    backfills missing earlier timestamps with the worst score (percentile95 - lowest_score)\n    so they are not unfairly advantaged by having fewer data points.\n\n    Miners present from the start keep only their real scores (no backfill).\n    \"\"\"\n    df = df.copy()\n    df[\"scored_time\"] = pd.to_datetime(df[\"scored_time\"])\n\n    global_min = df[\"scored_time\"].min()\n    all_times = sorted(df[\"scored_time\"].unique())\n\n    # Build worst-score and asset mappings per scored_time (used for backfilling new miners)\n    global_worst_score_mapping = {}\n    global_score_asset_mapping = {}\n    for t in all_times:\n        sample = df.loc[df[\"scored_time\"] == t].iloc[0]\n        p95 = sample.get(\"percentile95\")\n        low = sample.get(\"lowest_score\")\n        if p95 is None or low is None:\n            continue\n        global_worst_score_mapping[t] = p95 - low\n        global_score_asset_mapping[t] = sample[\"asset\"]\n\n    # Identify new miners (first appearance after the window start)\n    miner_first = df.groupby(\"miner_id\")[\"scored_time\"].min()\n    new_miner_ids = miner_first[miner_first > global_min].index\n\n    if len(new_miner_ids) == 0:\n        # No new miners - just return the real data (common fast path)\n        out = df[\n            [\"scored_time\", \"miner_id\", \"prompt_score_v3\", \"asset\"]\n        ].copy()\n        out[\"miner_id\"] = out[\"miner_id\"].astype(int)\n        out = out.sort_values([\"scored_time\", \"miner_id\"]).reset_index(\n            drop=True\n        )\n        return out\n\n    # Build backfill rows only for new miners at times before they joined\n    backfill_rows = []\n    backfill_times = [t for t in all_times if t in global_worst_score_mapping]\n    for mid in new_miner_ids:\n        first_time = miner_first[mid]\n        for t in backfill_times:\n            if t >= first_time:\n                continue\n            backfill_rows.append(\n                {\n                    \"scored_time\": t,\n                    \"miner_id\": mid,\n                    \"prompt_score_v3\": global_worst_score_mapping[t],\n                    \"asset\": global_score_asset_mapping[t],\n                }\n            )\n\n    # Combine real data with backfill rows\n    out = df[[\"scored_time\", \"miner_id\", \"prompt_score_v3\", \"asset\"]].copy()\n    if backfill_rows:\n        backfill_df = pd.DataFrame(backfill_rows)\n        backfill_df[\"scored_time\"] = pd.to_datetime(backfill_df[\"scored_time\"])\n        out = pd.concat([out, backfill_df], ignore_index=True)\n\n    out[\"miner_id\"] = out[\"miner_id\"].astype(int)\n    out = out.sort_values([\"scored_time\", \"miner_id\"]).reset_index(drop=True)\n    return out\n\n\n@print_execution_time\ndef compute_smoothed_score(\n    miner_data_handler: MinerDataHandler,\n    input_df: DataFrame,\n    scored_time: datetime,\n    comp: CompetitionConfig,\n) -> typing.Optional[list[dict]]:\n    \"\"\"Compute smoothed scores and reward weights for all miners.\n\n    1. Filters scores to the scoring window (scored_time cutoff)\n    2. Applies per-asset coefficient weighting (vectorized)\n    3. Sums weighted scores per miner\n    4. Assigns inf to miners with no valid scores\n    5. Computes softmax reward weights\n    \"\"\"\n    if input_df.empty:\n        return None\n\n    # Filter to scoring window and drop NaN scores\n    df = input_df.loc[\n        pd.to_datetime(input_df[\"scored_time\"]) <= scored_time\n    ].copy()\n    df = df.dropna(subset=[\"prompt_score_v3\"])\n\n    if df.empty:\n        return None\n\n    # Apply per-asset coefficients vectorized (single pass, no per-miner loop).\n    # Normalization is per-miner: each miner's scores are divided by the sum of\n    # coefficients for that miner's assets.\n    coefs = df[\"asset\"].map(ASSET_COEFFICIENTS).fillna(1.0)\n    df[\"weighted_score\"] = df[\"prompt_score_v3\"] * coefs\n    miner_coef_sums = coefs.groupby(df[\"miner_id\"]).sum()\n    df[\"weighted_score\"] /= df[\"miner_id\"].map(miner_coef_sums)\n\n    # Sum per miner in one groupby\n    rolling_avgs = df.groupby(\"miner_id\")[\"weighted_score\"].sum()\n\n    # Miners present in input but with all NaN scores get inf (worst possible)\n    all_miner_ids = input_df[\"miner_id\"].unique()\n    missing_miners = set(all_miner_ids) - set(rolling_avgs.index)\n    for miner_id in missing_miners:\n        bt.logging.warning(\n            f\"Miner ID {miner_id} has no valid scores in the window. Assigning infinite rolling average.\"\n        )\n        rolling_avgs.loc[miner_id] = float(\"inf\")\n\n    rolling_avg_data = [\n        {\"miner_id\": int(mid), \"rolling_avg\": float(val)}\n        for mid, val in rolling_avgs.items()\n    ]\n\n    # Resolve miner_id -> miner_uid\n    moving_averages_data = miner_data_handler.populate_miner_uid_in_miner_data(\n        rolling_avg_data\n    )\n\n    if moving_averages_data is None:\n        return None\n\n    # Filter out miners with no UID (deregistered)\n    filtered_moving_averages_data = [\n        item for item in moving_averages_data if item[\"miner_uid\"] is not None\n    ]\n\n    # Softmax: negative beta means lower score = higher reward\n    rolling_avg_list = [\n        r[\"rolling_avg\"] for r in filtered_moving_averages_data\n    ]\n    reward_weight_list = compute_softmax(\n        np.array(rolling_avg_list), comp.softmax_beta\n    )\n\n    rewards = []\n    for item, reward_weight in zip(\n        filtered_moving_averages_data, reward_weight_list\n    ):\n        if float(reward_weight) > 0:\n            rewards.append(\n                {\n                    \"miner_id\": item[\"miner_id\"],\n                    \"miner_uid\": item[\"miner_uid\"],\n                    \"smoothed_score\": item[\"rolling_avg\"],\n                    \"reward_weight\": float(reward_weight)\n                    * SMOOTHED_SCORE_COEFFICIENT,\n                    \"updated_at\": scored_time.isoformat(),\n                    \"prompt_name\": comp.label,\n                }\n            )\n\n    return rewards\n\n\n@print_execution_time\ndef compute_vhft_smoothed_score(\n    miner_data_handler: MinerDataHandler,\n    vhft_scores: dict[int, float],\n    scored_time: datetime,\n    comp: CompetitionConfig,\n) -> typing.Optional[list[dict]]:\n    \"\"\"Shape external VHFT per-uid scores into reward-weight dicts.\n\n    `vhft_scores` is {miner_uid: mean_crps} for VHFT participants only (already\n    windowed by the external scorer), so there is NO per-window aggregation here —\n    we go straight to the same softmax x SMOOTHED_SCORE_COEFFICIENT tail as\n    compute_smoothed_score, keeping shaping uniform across all four competitions.\n\n    Maps uid -> miner_id (the key combine_moving_averages merges on), dropping uids\n    with no Postgres identity (unregistered). Returns None if nothing maps, or if\n    the surviving field falls outside VHFT_MIN/MAX_PARTICIPANTS — the block is a\n    fixed share however many miners split it, so too few is a concentration risk\n    and too many is a malfunctioning scorer. Either way the caller skips VHFT for\n    the cycle and the other three competitions still set weights.\n    \"\"\"\n    if not vhft_scores:\n        return None\n\n    uid_to_miner_id = miner_data_handler.get_miner_uid_to_id_map()\n    if not uid_to_miner_id:\n        return None\n\n    scored = [\n        {\n            \"miner_id\": uid_to_miner_id[uid],\n            \"miner_uid\": uid,\n            \"rolling_avg\": crps,\n        }\n        for uid, crps in vhft_scores.items()\n        if uid in uid_to_miner_id\n    ]\n    if not scored:\n        return None\n\n    # Concentration guard. Checked AFTER the identity mapping above, on the\n    # miners that will actually be paid: 9 scored uids of which only 1 is\n    # registered concentrates exactly as hard as 1 scored uid, and a raw\n    # len(vhft_scores) check would miss that.\n    if not VHFT_MIN_PARTICIPANTS <= len(scored) <= VHFT_MAX_PARTICIPANTS:\n        bt.logging.warning(\n            f\"VHFT: {len(scored)} scored participant(s) outside the plausible \"\n            f\"range [{VHFT_MIN_PARTICIPANTS}, {VHFT_MAX_PARTICIPANTS}] — \"\n            f\"skipping the VHFT blend this cycle rather than concentrating \"\n            f\"its share on too few miners\"\n        )\n        return None\n\n    # Same softmax tail as compute_smoothed_score: negative beta -> lower CRPS wins.\n    reward_weight_list = compute_softmax(\n        np.array([s[\"rolling_avg\"] for s in scored]), comp.softmax_beta\n    )\n\n    rewards = []\n    for item, reward_weight in zip(scored, reward_weight_list):\n        if float(reward_weight) > 0:\n            rewards.append(\n                {\n                    \"miner_id\": item[\"miner_id\"],\n                    \"miner_uid\": item[\"miner_uid\"],\n                    \"smoothed_score\": item[\"rolling_avg\"],\n                    \"reward_weight\": float(reward_weight)\n                    * SMOOTHED_SCORE_COEFFICIENT,\n                    \"updated_at\": scored_time.isoformat(),\n                    \"prompt_name\": comp.label,\n                }\n            )\n\n    return rewards\n\n\ndef print_rewards_df(moving_averages_data: list[dict], label: str = \"\"):\n    bt.logging.info(f\"Scored responses moving averages {label}\")\n    df = pd.DataFrame.from_dict(moving_averages_data)\n    bt.logging.info(df.to_string())\n\n\n@print_execution_time\ndef combine_moving_averages(\n    moving_averages_data: dict[str, list[dict]],\n) -> list[dict]:\n    \"\"\"Combine reward weights from competitions.\n\n    Same miner appearing in multiple competitions gets their weights summed.\n    \"\"\"\n    map_miner_reward: dict[int, dict] = {}\n\n    for moving_averages in list(moving_averages_data.values()):\n        for reward in moving_averages:\n            miner_id = reward[\"miner_id\"]\n            if miner_id in map_miner_reward:\n                map_miner_reward[miner_id][\"reward_weight\"] += reward[\n                    \"reward_weight\"\n                ]\n            else:\n                map_miner_reward[miner_id] = reward\n\n    return list(map_miner_reward.values())\n","numLines":306,"startLine":1,"totalLines":306}},"tool_result_meta":[{"id":"toolu_0195uermAefUW3kweKx5tSRy","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
