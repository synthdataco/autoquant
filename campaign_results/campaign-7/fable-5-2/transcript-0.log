ch.arange(self.H, device=DEV) + 0.5) * self.inc\n'''\nnew = '''        self.fast = torch.tensor(core.FAST_MASK, dtype=torch.float32, device=DEV)\n        ahead = (torch.arange(self.H, device=DEV) + 0.5) * self.inc\n'''\nassert old in s; s = s.replace(old, new)\nold = '''        if name == \"theta\": return 0.5 * torch.tanh(v)\n'''\nnew = '''        if name == \"theta\": return 0.5 * torch.tanh(v)\n        if name == \"gamma\": return torch.nn.functional.softplus(v)\n        if name == \"p\":\n            pv = 1.5 * torch.tanh(v)\n            return torch.where(pv.abs() < 0.02, torch.full_like(pv, 0.02), pv)\n'''\nassert old in s; s = s.replace(old, new)\nold = '''        for k in (\"b0\", \"b1\", \"kappa\", \"A0\", \"A1\", \"c\", \"rho\", \"theta\", \"gz\", \"gl\"): out[k] = float(self.c(k))\n'''\nnew = '''        for k in (\"b0\", \"b1\", \"kappa\", \"A0\", \"A1\", \"c\", \"rho\", \"theta\", \"gz\", \"gl\", \"p\", \"gamma\"): out[k] = float(self.c(k))\n        out[\"ce0\"], out[\"ce1\"] = g(self.dl(\"ce0\")), g(self.dl(\"ce1\"))\n'''\nassert old in s; s = s.replace(old, new)\nold = '''    def dl(self, name):\n        return self.p[name] * (0.0 if name in self.freeze else 1.0)\n'''\nnew = '''    def dl(self, name):\n        return self.p[name] * (0.0 if (name in self.freeze or name[:2] in self.freeze) else 1.0)\n'''\nassert old in s; s = s.replace(old, new)\na = s.index(\"    def variance(self, d, idx):\"); b = s.index(\"    def paths(self, v, lam, N, gen):\")\nnew = '''    def variance(self, d, idx):\n        x, xs, seas, sess = d.x[idx], d.xs[idx], d.seas[idx], d.sess[idx]\n        B = len(idx)\n        mv = seas * torch.exp(self.c(\"kappa\") * torch.gather(xs, 1, sess))\n        s = mv.view(B, self.H, self.inc).sum(-1)\n        z1 = torch.zeros(1, device=DEV)\n        fam = torch.cat([torch.zeros(core.N_HL, device=DEV), self.p[\"fam\"][0].repeat(core.N_HL), self.p[\"fam\"][1].repeat(core.N_HL), z1])\n        feat = torch.cat([(x + fam)[:, None, :].expand(B, self.H, NG), d.xsl[idx]], -1)          # [B,H,F]\n        logits = (self.p[\"alpha\"] + self.mask)[None, :] + self.p[\"beta\"][None, :] * self.phi[:, None]\n        lw_same = torch.log_softmax(logits, -1)\n        lw_cross = torch.log_softmax(logits - self.c(\"gamma\") * self.fast[None, :], -1)\n        lw = torch.where(d.cross[idx][:, :, None], lw_cross[None], lw_same[None])\n        p = self.c(\"p\")\n        level = torch.logsumexp(lw + p * feat, -1) / p + self.c(\"b0\") + self.c(\"b1\") * self.phi\n        ss = d.ss[idx]\n        level = level + torch.cat([z1, self.dl(\"dlt\")])[ss] + torch.cat([z1, self.dl(\"dlt1\")])[ss] * self.phi + self.c(\"gl\") * d.xzs[idx]\n        xe = d.xe[idx]\n        level = level + (xe @ self.dl(\"ce0\"))[:, None] + (xe @ self.dl(\"ce1\"))[:, None] * self.phi\n        return s * torch.exp(level)\n\n'''\ns = s[:a] + new + s[b:]\nold = '''              f\"fam={np.round(out['fam_bias'], 2)} ({time.time() - t0:.0f}s)\", flush=True)'''\nnew = '''              f\"fam={np.round(out['fam_bias'], 2)} p={out['p']:.2f} gamma={out['gamma']:.2f} ce0={np.round(out['ce0'], 3)} ce1={np.round(out['ce1'], 3)} ({time.time() - t0:.0f}s)\", flush=True)'''\nassert old in s; s = s.replace(old, new)\nold = '''    mask = [fams[f] * core.N_HL + i for f in args.mask_fam.split(\",\") if f for i in range(core.N_HL)] or None\n'''\nnew = '''    mask = [fams[f] * core.N_HL + i for f in args.mask_fam.split(\",\") if f in fams for i in range(core.N_HL)]\n    if \"sess\" in args.mask_fam.split(\",\"): mask += [NG, NG + 1]\n    mask = mask or None\n'''\nassert old in s; s = s.replace(old, new)\ns = s.replace('''    ap.add_argument(\"--seed\", type=int, default=0)''', '''    ap.add_argument(\"--seed\", type=int, default=0); ap.add_argument(\"--suffix\", default=\"\")''')\ns = s.replace('''(out / f\"model_{a}_{tag}.json\").write_text(json.dumps(res))''', '''(out / f\"model_{a}_{tag}{args.suffix}.json\").write_text(json.dumps(res))''')\nopen(p, \"w\").write(s)\nEOF\nuv run py