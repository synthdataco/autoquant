{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012XWuSQoyNFvH3SzFiZ6ion","type":"tool_result","content":"1\tfrom dataclasses import dataclass\n2\t\n3\t\n4\t@dataclass\n5\tclass PromptConfig:\n6\t    asset_list: list[str]\n7\t    label: str\n8\t    time_length: int\n9\t    time_increment: int\n10\t    cycle_interval_minutes: int\n11\t    timeout_extra_seconds: int\n12\t    cycle_offset_minutes: int | None = None\n13\t    num_simulations: int = 1000\n14\t    data_retention_days: int = 30\n15\t    # Density tapering: predictions on validator_requests whose start_time is\n16\t    # older than `thin_after_minutes` get soft-deleted down to one row per\n17\t    # (miner_id, asset, bucket of `thin_bucket_seconds`). Keeps short-term\n18\t    # density for the short scoring intervals while pruning the long tail.\n19\t    thin_after_minutes: int = 30\n20\t    thin_bucket_seconds: int = 3600\n21\t\n22\t\n23\tLOW_FREQUENCY = PromptConfig(\n24\t    asset_list=[\n25\t        \"BTC\",\n26\t        \"ETH\",\n27\t        \"SOL\",\n28\t        \"XRP\",\n29\t        \"HYPE\",\n30\t        \"XAU\",\n31\t        \"SP500\",\n32\t        \"NVDAX\",\n33\t        \"GOOGLX\",\n34\t        \"TSLAX\",\n35\t        \"AAPLX\",\n36\t        \"WTIOIL\",\n37\t        \"SPCX\",\n38\t    ],\n39\t    label=\"low\",\n40\t    time_length=86400,\n41\t    time_increment=300,\n42\t    cycle_interval_minutes=5,\n43\t    timeout_extra_seconds=60,\n44\t    data_retention_days=11,\n45\t    thin_after_minutes=30,\n46\t    thin_bucket_seconds=3600,\n47\t)\n48\t\n49\tHIGH_FREQUENCY = PromptConfig(\n50\t    asset_list=[\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"],\n51\t    label=\"high\",\n52\t    time_length=3600,\n53\t    time_increment=60,\n54\t    cycle_interval_minutes=2,\n55\t    timeout_extra_seconds=0,\n56\t    data_retention_days=6,\n57\t    thin_after_minutes=10,\n58\t    thin_bucket_seconds=600,\n59\t)\n60\t\n61\t\n62\tdef label_from_time_length(time_length: int) -> str:\n63\t    \"\"\"Return the prompt label ('low' or 'high') for a given time_length.\n64\t\n65\t    Raises ValueError on unknown values — Bigtable routes writes to one of\n66\t    two tables based on this label, so a silent fallback could mis-shelve\n67\t    a future third cycle.\n68\t    \"\"\"\n69\t    if time_length == HIGH_FREQUENCY.time_length:\n70\t        return HIGH_FREQUENCY.label\n71\t    if time_length == LOW_FREQUENCY.time_length:\n72\t        return LOW_FREQUENCY.label\n73\t    raise ValueError(\n74\t        f\"label_from_time_length: unknown time_length {time_length} \"\n75\t        f\"(known: {LOW_FREQUENCY.time_length}, {HIGH_FREQUENCY.time_length})\"\n76\t    )\n77\t"}]},"parent_tool_use_id":null,"session_id":"b5de06de-0f9b-444f-a451-a2a51a4613ad","uuid":"b5e586e0-577c-4de7-bfed-43520ca6b927","timestamp":"2026-11-11T13:14:30.687Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/.venv/lib/python3.12/site-packages/synth/validator/prompt_config.py","content":"from dataclasses import dataclass\n\n\n@dataclass\nclass PromptConfig:\n    asset_list: list[str]\n    label: str\n    time_length: int\n    time_increment: int\n    cycle_interval_minutes: int\n    timeout_extra_seconds: int\n    cycle_offset_minutes: int | None = None\n    num_simulations: int = 1000\n    data_retention_days: int = 30\n    # Density tapering: predictions on validator_requests whose start_time is\n    # older than `thin_after_minutes` get soft-deleted down to one row per\n    # (miner_id, asset, bucket of `thin_bucket_seconds`). Keeps short-term\n    # density for the short scoring intervals while pruning the long tail.\n    thin_after_minutes: int = 30\n    thin_bucket_seconds: int = 3600\n\n\nLOW_FREQUENCY = PromptConfig(\n    asset_list=[\n        \"BTC\",\n        \"ETH\",\n        \"SOL\",\n        \"XRP\",\n        \"HYPE\",\n        \"XAU\",\n        \"SP500\",\n        \"NVDAX\",\n        \"GOOGLX\",\n        \"TSLAX\",\n        \"AAPLX\",\n        \"WTIOIL\",\n        \"SPCX\",\n    ],\n    label=\"low\",\n    time_length=86400,\n    time_increment=300,\n    cycle_interval_minutes=5,\n    timeout_extra_seconds=60,\n    data_retention_days=11,\n    thin_after_minutes=30,\n    thin_bucket_seconds=3600,\n)\n\nHIGH_FREQUENCY = PromptConfig(\n    asset_list=[\"BTC\", \"ETH\", \"SOL\", \"XRP\", \"HYPE\"],\n    label=\"high\",\n    time_length=3600,\n    time_increment=60,\n    cycle_interval_minutes=2,\n    timeout_extra_seconds=0,\n    data_retention_days=6,\n    thin_after_minutes=10,\n    thin_bucket_seconds=600,\n)\n\n\ndef label_from_time_length(time_length: int) -> str:\n    \"\"\"Return the prompt label ('low' or 'high') for a given time_length.\n\n    Raises ValueError on unknown values — Bigtable routes writes to one of\n    two tables based on this label, so a silent fallback could mis-shelve\n    a future third cycle.\n    \"\"\"\n    if time_length == HIGH_FREQUENCY.time_length:\n        return HIGH_FREQUENCY.label\n    if time_length == LOW_FREQUENCY.time_length:\n        return LOW_FREQUENCY.label\n    raise ValueError(\n        f\"label_from_time_length: unknown time_length {time_length} \"\n        f\"(known: {LOW_FREQUENCY.time_length}, {HIGH_FREQUENCY.time_length})\"\n    )\n","numLines":77,"startLine":1,"totalLines":77}},"tool_result_meta":[{"id":"toolu_012XWuSQoyNFvH3SzFiZ6ion","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
