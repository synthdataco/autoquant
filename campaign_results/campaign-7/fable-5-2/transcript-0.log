{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MLddPgmN1tfNrz2nV611ZJ","type":"tool_result","content":"1\tfrom dataclasses import dataclass\n2\t\n3\tSMOOTHED_SCORE_COEFFICIENT = 1 / 3\n4\t\n5\t# 1h score = price CRPS + VOL_CRPS_LAMBDA × the mean, over the block sizes,\n6\t# of the mean per-block volatility CRPS — so each weight below must stay\n7\t# VOL_CRPS_LAMBDA / (3 block sizes × the number of blocks of that size).\n8\tVOL_CRPS_LAMBDA = 5.25\n9\t\n10\t\n11\t@dataclass\n12\tclass CompetitionConfig:\n13\t    asset_list: list[str]\n14\t    label: str\n15\t    time_length: int\n16\t    time_increment: int\n17\t    scoring_intervals: dict[str, int]  # Define scoring intervals in seconds.\n18\t    # Volatility CRPS blocks: name -> (block duration in seconds, weight).\n19\t    # Empty means the competition scores on the price CRPS alone.\n20\t    vol_scoring_blocks: dict[str, tuple[int, float]]\n21\t    window_days: int\n22\t    softmax_beta: float\n23\t\n24\t\n25\tCOM_EQU_24H = CompetitionConfig(\n26\t    asset_list=[\n27\t        \"XAU\",\n28\t        \"NVDAX\",\n29\t        \"GOOGLX\",\n30\t        \"TSLAX\",\n31\t        \"AAPLX\",\n32\t        \"WTIOIL\",\n33\t        \"SPCX\",\n34\t        \"SP500\",\n35\t    ],\n36\t    label=\"Commodities/Equities 24h\",\n37\t    time_length=86400,\n38\t    time_increment=300,\n39\t    scoring_intervals={\n40\t        \"5min\": 300,  # 5 minutes\n41\t        \"30min\": 1800,  # 30 minutes\n42\t        \"3hour\": 10800,  # 3 hours\n43\t        \"24hour_abs\": 86400,  # 24 hours\n44\t    },\n45\t    vol_scoring_blocks={},\n46\t    window_days=10,\n47\t    softmax_beta=-0.15,\n48\t)\n49\t\n50\tCRYPTO_24H = CompetitionConfig(\n51\t    asset_list=[\n52\t        \"BTC\",\n53\t        \"ETH\",\n54\t        \"SOL\",\n55\t        \"XRP\",\n56\t        \"HYPE\",\n57\t    ],\n58\t    label=\"Crypto 24h\",\n59\t    time_length=86400,\n60\t    time_increment=300,\n61\t    scoring_intervals={\n62\t        \"5min\": 300,  # 5 minutes\n63\t        \"30min\": 1800,  # 30 minutes\n64\t        \"3hour\": 10800,  # 3 hours\n65\t        \"24hour_abs\": 86400,  # 24 hours\n66\t    },\n67\t    vol_scoring_blocks={},\n68\t    window_days=10,\n69\t    softmax_beta=-0.15,\n70\t)\n71\t\n72\tCRYPTO_1H = CompetitionConfig(\n73\t    asset_list=[\n74\t        \"BTC\",\n75\t        \"ETH\",\n76\t        \"SOL\",\n77\t        \"XRP\",\n78\t        \"HYPE\",\n79\t    ],\n80\t    label=\"Crypto 1h\",\n81\t    time_length=3600,\n82\t    time_increment=60,\n83\t    scoring_intervals={\n84\t        \"1min\": 60,\n85\t        \"2min\": 120,\n86\t        \"5min\": 300,\n87\t        \"15min\": 900,\n88\t        \"30min\": 1800,\n89\t        \"60min_abs\": 3600,\n90\t        \"0_5min_gaps\": 300,\n91\t        \"0_10min_gaps\": 600,\n92\t        \"0_15min_gaps\": 900,\n93\t        \"0_20min_gaps\": 1200,\n94\t        \"0_25min_gaps\": 1500,\n95\t        \"0_30min_gaps\": 1800,\n96\t        \"0_35min_gaps\": 2100,\n97\t        \"0_40min_gaps\": 2400,\n98\t        \"0_45min_gaps\": 2700,\n99\t        \"0_50min_gaps\": 3000,\n100\t        \"0_55min_gaps\": 3300,\n101\t        \"0_60min_gaps\": 3600,\n102\t    },\n103\t    vol_scoring_blocks={\n104\t        \"vol_60min\": (3600, VOL_CRPS_LAMBDA / 3),  # 1 block\n105\t        \"vol_15min\": (900, VOL_CRPS_LAMBDA / 12),  # 4 blocks\n106\t        \"vol_5min\": (300, VOL_CRPS_LAMBDA / 36),  # 12 blocks\n107\t    },\n108\t    window_days=5,\n109\t    softmax_beta=-0.3,\n110\t)\n111\t\n112\t\n113\t# Canonical list of competitions. Both the scoring cycle (neurons/validator.py)\n114\t# and the moving-average update (forward.py) iterate this, so a competition\n115\t# added/renamed/reordered here propagates to both — don't re-list elsewhere.\n116\tALL_COMPETITIONS = [\n117\t    COM_EQU_24H,\n118\t    CRYPTO_24H,\n119\t    CRYPTO_1H,\n120\t]\n121\t\n122\t# VHFT (Synth Ultra) — the 10-second BTC-microprice competition. Scored OFF-subnet\n123\t# and blended in via the external-ingestion path (vhft_score_provider +\n124\t# compute_vhft_smoothed_score), NOT through the inline-CRPS path — so it is\n125\t# deliberately kept OUT of ALL_COMPETITIONS. It reuses the same\n126\t# SMOOTHED_SCORE_COEFFICIENT and softmax as the other three, so after set_weights\n127\t# L1-normalizes, the four competitions split emissions equally (the coefficient\n128\t# value cancels; a *shared* coefficient is what makes the split equal).\n129\tVHFT_COMPETITION = CompetitionConfig(\n130\t    asset_list=[\"BTC\"],\n131\t    label=\"VHFT 10s\",\n132\t    time_length=10,\n133\t    time_increment=10,\n134\t    scoring_intervals={\"10s\": 10},\n135\t    vol_scoring_blocks={},\n136\t    # window_days is nominal — the external scorer already windows the scores, so\n137\t    # no per-window aggregation happens here.\n138\t    window_days=1,\n139\t    # softmax_beta is deliberately steeper than the other competitions': this\n140\t    # field is tightly bunched, so a gentler beta leaves rewards nearly flat\n141\t    # across it.\n142\t    #\n143\t    # Beta responds to the SPREAD between miners, not the absolute score level:\n144\t    # the scorer subtracts each prompt's winner and softmax is invariant to that\n145\t    # shared offset, so shifting every score changes nothing. A wider field\n146\t    # therefore concentrates rewards harder at a fixed beta. Re-measure before\n147\t    # changing this; do not reason from the score level.\n148\t    #\n149\t    # MUST stay negative (lower score = higher reward), same convention as the\n150\t    # other competitions.\n151\t    softmax_beta=-4.0,\n152\t)\n153\t\n154\t# Plausible size of the VHFT participant field, enforced in\n155\t# compute_vhft_smoothed_score — outside this range the blend is skipped for the\n156\t# cycle rather than trusted.\n157\t#\n158\t# The VHFT block is a fixed SMOOTHED_SCORE_COEFFICIENT however many uids share\n159\t# it, so each participant's cut scales as 1/N — at one participant that is the\n160\t# entire block. A round that scores only a handful of miners, whether from a\n161\t# degraded scorer or a field that has mostly dropped out, would otherwise hand\n162\t# one miner an outsized share, so require a floor. The ceiling is the other end\n163\t# of the same argument: a snapshot naming far more scored participants than the\n164\t# competition has is a malfunctioning scorer, not sudden popularity.\n165\tVHFT_MIN_PARTICIPANTS = 3\n166\tVHFT_MAX_PARTICIPANTS = 64\n167\t"}]},"parent_tool_use_id":null,"session_id":"b5de06de-0f9b-444f-a451-a2a51a4613ad","uuid":"101a6126-b8ec-4250-9e95-255686d08246","timestamp":"2026-11-11T13:14:30.290Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/.venv/lib/python3.12/site-packages/synth/validator/competition_config.py","content":"from dataclasses import dataclass\n\nSMOOTHED_SCORE_COEFFICIENT = 1 / 3\n\n# 1h score = price CRPS + VOL_CRPS_LAMBDA × the mean, over the block sizes,\n# of the mean per-block volatility CRPS — so each weight below must stay\n# VOL_CRPS_LAMBDA / (3 block sizes × the number of blocks of that size).\nVOL_CRPS_LAMBDA = 5.25\n\n\n@dataclass\nclass CompetitionConfig:\n    asset_list: list[str]\n    label: str\n    time_length: int\n    time_increment: int\n    scoring_intervals: dict[str, int]  # Define scoring intervals in seconds.\n    # Volatility CRPS blocks: name -> (block duration in seconds, weight).\n    # Empty means the competition scores on the price CRPS alone.\n    vol_scoring_blocks: dict[str, tuple[int, float]]\n    window_days: int\n    softmax_beta: float\n\n\nCOM_EQU_24H = CompetitionConfig(\n    asset_list=[\n        \"XAU\",\n        \"NVDAX\",\n        \"GOOGLX\",\n        \"TSLAX\",\n        \"AAPLX\",\n        \"WTIOIL\",\n        \"SPCX\",\n        \"SP500\",\n    ],\n    label=\"Commodities/Equities 24h\",\n    time_length=86400,\n    time_increment=300,\n    scoring_intervals={\n        \"5min\": 300,  # 5 minutes\n        \"30min\": 1800,  # 30 minutes\n        \"3hour\": 10800,  # 3 hours\n        \"24hour_abs\": 86400,  # 24 hours\n    },\n    vol_scoring_blocks={},\n    window_days=10,\n    softmax_beta=-0.15,\n)\n\nCRYPTO_24H = CompetitionConfig(\n    asset_list=[\n        \"BTC\",\n        \"ETH\",\n        \"SOL\",\n        \"XRP\",\n        \"HYPE\",\n    ],\n    label=\"Crypto 24h\",\n    time_length=86400,\n    time_increment=300,\n    scoring_intervals={\n        \"5min\": 300,  # 5 minutes\n        \"30min\": 1800,  # 30 minutes\n        \"3hour\": 10800,  # 3 hours\n        \"24hour_abs\": 86400,  # 24 hours\n    },\n    vol_scoring_blocks={},\n    window_days=10,\n    softmax_beta=-0.15,\n)\n\nCRYPTO_1H = CompetitionConfig(\n    asset_list=[\n        \"BTC\",\n        \"ETH\",\n        \"SOL\",\n        \"XRP\",\n        \"HYPE\",\n    ],\n    label=\"Crypto 1h\",\n    time_length=3600,\n    time_increment=60,\n    scoring_intervals={\n        \"1min\": 60,\n        \"2min\": 120,\n        \"5min\": 300,\n        \"15min\": 900,\n        \"30min\": 1800,\n        \"60min_abs\": 3600,\n        \"0_5min_gaps\": 300,\n        \"0_10min_gaps\": 600,\n        \"0_15min_gaps\": 900,\n        \"0_20min_gaps\": 1200,\n        \"0_25min_gaps\": 1500,\n        \"0_30min_gaps\": 1800,\n        \"0_35min_gaps\": 2100,\n        \"0_40min_gaps\": 2400,\n        \"0_45min_gaps\": 2700,\n        \"0_50min_gaps\": 3000,\n        \"0_55min_gaps\": 3300,\n        \"0_60min_gaps\": 3600,\n    },\n    vol_scoring_blocks={\n        \"vol_60min\": (3600, VOL_CRPS_LAMBDA / 3),  # 1 block\n        \"vol_15min\": (900, VOL_CRPS_LAMBDA / 12),  # 4 blocks\n        \"vol_5min\": (300, VOL_CRPS_LAMBDA / 36),  # 12 blocks\n    },\n    window_days=5,\n    softmax_beta=-0.3,\n)\n\n\n# Canonical list of competitions. Both the scoring cycle (neurons/validator.py)\n# and the moving-average update (forward.py) iterate this, so a competition\n# added/renamed/reordered here propagates to both — don't re-list elsewhere.\nALL_COMPETITIONS = [\n    COM_EQU_24H,\n    CRYPTO_24H,\n    CRYPTO_1H,\n]\n\n# VHFT (Synth Ultra) — the 10-second BTC-microprice competition. Scored OFF-subnet\n# and blended in via the external-ingestion path (vhft_score_provider +\n# compute_vhft_smoothed_score), NOT through the inline-CRPS path — so it is\n# deliberately kept OUT of ALL_COMPETITIONS. It reuses the same\n# SMOOTHED_SCORE_COEFFICIENT and softmax as the other three, so after set_weights\n# L1-normalizes, the four competitions split emissions equally (the coefficient\n# value cancels; a *shared* coefficient is what makes the split equal).\nVHFT_COMPETITION = CompetitionConfig(\n    asset_list=[\"BTC\"],\n    label=\"VHFT 10s\",\n    time_length=10,\n    time_increment=10,\n    scoring_intervals={\"10s\": 10},\n    vol_scoring_blocks={},\n    # window_days is nominal — the external scorer already windows the scores, so\n    # no per-window aggregation happens here.\n    window_days=1,\n    # softmax_beta is deliberately steeper than the other competitions': this\n    # field is tightly bunched, so a gentler beta leaves rewards nearly flat\n    # across it.\n    #\n    # Beta responds to the SPREAD between miners, not the absolute score level:\n    # the scorer subtracts each prompt's winner and softmax is invariant to that\n    # shared offset, so shifting every score changes nothing. A wider field\n    # therefore concentrates rewards harder at a fixed beta. Re-measure before\n    # changing this; do not reason from the score level.\n    #\n    # MUST stay negative (lower score = higher reward), same convention as the\n    # other competitions.\n    softmax_beta=-4.0,\n)\n\n# Plausible size of the VHFT participant field, enforced in\n# compute_vhft_smoothed_score — outside this range the blend is skipped for the\n# cycle rather than trusted.\n#\n# The VHFT block is a fixed SMOOTHED_SCORE_COEFFICIENT however many uids share\n# it, so each participant's cut scales as 1/N — at one participant that is the\n# entire block. A round that scores only a handful of miners, whether from a\n# degraded scorer or a field that has mostly dropped out, would otherwise hand\n# one miner an outsized share, so require a floor. The ceiling is the other end\n# of the same argument: a snapshot naming far more scored participants than the\n# competition has is a malfunctioning scorer, not sudden popularity.\nVHFT_MIN_PARTICIPANTS = 3\nVHFT_MAX_PARTICIPANTS = 64\n","numLines":167,"startLine":1,"totalLines":167}},"tool_result_meta":[{"id":"toolu_01MLddPgmN1tfNrz2nV611ZJ","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
