{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JsZMz4bM1UWd5fhbfCHnTc","type":"tool_result","content":"1\timport numpy as np\n2\tfrom properscoring import crps_ensemble\n3\t\n4\t\n5\tdef get_interval_steps(scoring_interval: int, time_increment: int) -> int:\n6\t    \"\"\"\n7\t    Calculate the number of steps in the given scoring interval based on the time increment.\n8\t    \"\"\"\n9\t    return int(scoring_interval / time_increment)\n10\t\n11\t\n12\tdef calculate_crps_for_miner(\n13\t    simulation_runs: np.ndarray,\n14\t    real_price_path: np.ndarray,\n15\t    time_increment: int,\n16\t    scoring_intervals: dict[str, int],\n17\t) -> tuple[float, list[dict]]:\n18\t    \"\"\"\n19\t    Calculate the total CRPS score for a miner's simulations over specified intervals,\n20\t    Return the sum of the scores.\n21\t\n22\t    Parameters:\n23\t        simulation_runs (numpy.ndarray): Simulated price paths.\n24\t        real_price_path (numpy.ndarray): The real price path.\n25\t        time_increment (int): Time increment in seconds.\n26\t        scoring_intervals (dict): Dictionary of scoring intervals with their names and durations in seconds.\n27\t\n28\t    Returns:\n29\t        float: Sum of total CRPS scores over the intervals.\n30\t    \"\"\"\n31\t    # Initialize lists to store detailed CRPS data\n32\t    detailed_crps_data: list[dict] = []\n33\t    sum_all_scores = 0.0\n34\t    gap_total_crps = 0.0\n35\t\n36\t    for interval_name, interval_seconds in scoring_intervals.items():\n37\t        interval_steps = get_interval_steps(interval_seconds, time_increment)\n38\t        absolute_price = interval_name.endswith(\"_abs\")\n39\t        is_gap = interval_name.endswith(\"_gaps\")\n40\t\n41\t        # If we are considering absolute prices, adjust the interval steps for potential gaps:\n42\t        # if only the initial price is present, then decrease the interval step\n43\t        if absolute_price:\n44\t            while (\n45\t                real_price_path[::interval_steps].shape[0] == 1\n46\t                and interval_steps > 1\n47\t            ):\n48\t                interval_steps -= 1\n49\t\n50\t        # Make sure there are no zero prices in the simulation runs because it will cause a division by zero error\n51\t        if np.any(simulation_runs == 0):\n52\t            return -1.0, [\n53\t                {\"error\": \"Zero price encountered in simulation runs\"}\n54\t            ]\n55\t\n56\t        # Calculate price changes over intervals\n57\t        simulated_changes = calculate_price_changes_over_intervals(\n58\t            simulation_runs,\n59\t            interval_steps,\n60\t            absolute_price,\n61\t            is_gap,\n62\t        )\n63\t        real_changes = calculate_price_changes_over_intervals(\n64\t            real_price_path.reshape(1, -1),\n65\t            interval_steps,\n66\t            absolute_price,\n67\t            is_gap,\n68\t        )\n69\t        data_blocks = label_observed_blocks(real_changes[0])\n70\t\n71\t        # Not enough observed data -> continue\n72\t        if len(data_blocks) == 0:\n73\t            continue\n74\t\n75\t        # Calculate CRPS over intervals\n76\t        crps_values = sum_crps_over_blocks(\n77\t            simulated_changes,\n78\t            real_changes,\n79\t            data_blocks,\n80\t            absolute_price,\n81\t            real_price_path,\n82\t        )\n83\t\n84\t        # Total CRPS for this interval\n85\t        total_crps_interval = float(crps_values)\n86\t        sum_all_scores += total_crps_interval\n87\t        if is_gap:\n88\t            # Individual *_gaps intervals are folded into the single \"Gaps\"\n89\t            # Total appended below\n90\t            gap_total_crps += total_crps_interval\n91\t            continue\n92\t\n93\t        detailed_crps_data.append(\n94\t            {\n95\t                \"Interval\": interval_name,\n96\t                \"Increment\": \"Total\",\n97\t                \"CRPS\": total_crps_interval,\n98\t            }\n99\t        )\n100\t\n101\t    if gap_total_crps > 0:\n102\t        detailed_crps_data.append(\n103\t            {\"Interval\": \"Gaps\", \"Increment\": \"Total\", \"CRPS\": gap_total_crps}\n104\t        )\n105\t\n106\t    detailed_crps_data.append(\n107\t        {\"Interval\": \"Overall\", \"Increment\": \"Total\", \"CRPS\": sum_all_scores}\n108\t    )\n109\t\n110\t    return sum_all_scores, detailed_crps_data\n111\t\n112\t\n113\tdef calculate_vol_crps_for_miner(\n114\t    simulation_runs: np.ndarray,\n115\t    real_price_path: np.ndarray,\n116\t    time_increment: int,\n117\t    vol_scoring_blocks: dict[str, tuple[int, float]],\n118\t) -> tuple[float, list[dict]]:\n119\t    \"\"\"\n120\t    Calculate the weighted volatility CRPS for a miner's simulations.\n121\t\n122\t    The path is cut into consecutive blocks of each configured size, the\n123\t    realized volatility of every block is scored against the ensemble of\n124\t    simulated block volatilities, and the per-block CRPS values are summed\n125\t    and scaled by that block size's weight.\n126\t\n127\t    Parameters:\n128\t        simulation_runs (numpy.ndarray): Simulated price paths.\n129\t        real_price_path (numpy.ndarray): The real price path.\n130\t        time_increment (int): Time increment in seconds.\n131\t        vol_scoring_blocks (dict): Dictionary of block sizes with their names,\n132\t            durations in seconds and weights.\n133\t\n134\t    Returns:\n135\t        float: Sum of the weighted volatility CRPS over the block sizes.\n136\t    \"\"\"\n137\t    detailed_crps_data: list[dict] = []\n138\t    sum_all_scores = 0.0\n139\t\n140\t    for name, (block_seconds, weight) in vol_scoring_blocks.items():\n141\t        block_steps = get_interval_steps(block_seconds, time_increment)\n142\t\n143\t        simulated_vol = block_volatilities(simulation_runs, block_steps)\n144\t        real_vol = block_volatilities(\n145\t            real_price_path.reshape(1, -1), block_steps\n146\t        )[0]\n147\t        observed_blocks = np.flatnonzero(~np.isnan(real_vol))\n148\t\n149\t        # Not enough observed data -> continue\n150\t        if observed_blocks.size == 0:\n151\t            continue\n152\t\n153\t        crps_sum = float(\n154\t            sum(\n155\t                crps_ensemble(real_vol[block], simulated_vol[:, block])\n156\t                for block in observed_blocks\n157\t            )\n158\t        )\n159\t        sum_all_scores += weight * crps_sum\n160\t\n161\t        detailed_crps_data.append(\n162\t            {\n163\t                \"Interval\": name,\n164\t                \"Increment\": \"Total\",\n165\t                \"CRPS\": crps_sum,\n166\t                \"Weight\": weight,\n167\t            }\n168\t        )\n169\t\n170\t    detailed_crps_data.append(\n171\t        {\"Interval\": \"Vol\", \"Increment\": \"Total\", \"CRPS\": sum_all_scores}\n172\t    )\n173\t\n174\t    return sum_all_scores, detailed_crps_data\n175\t\n176\t\n177\tdef calculate_total_score_for_miner(\n178\t    simulation_runs: np.ndarray,\n179\t    real_price_path: np.ndarray,\n180\t    time_increment: int,\n181\t    scoring_intervals: dict[str, int],\n182\t    vol_scoring_blocks: dict[str, tuple[int, float]],\n183\t) -> tuple[float, list[dict]]:\n184\t    \"\"\"\n185\t    Calculate a miner's total score: the price CRPS plus the weighted\n186\t    volatility CRPS. A competition with no volatility blocks scores on the\n187\t    price CRPS alone.\n188\t\n189\t    Returns:\n190\t        float: The total score.\n191\t    \"\"\"\n192\t    price_score, detailed_crps_data = calculate_crps_for_miner(\n193\t        simulation_runs, real_price_path, time_increment, scoring_intervals\n194\t    )\n195\t\n196\t    # -1 is the rejection sentinel of the price pass, which also owns the\n197\t    # zero-price guard the volatility blocks depend on: never add to it.\n198\t    if not vol_scoring_blocks or price_score == -1.0:\n199\t        return price_score, detailed_crps_data\n200\t\n201\t    vol_score, detailed_vol_data = calculate_vol_crps_for_miner(\n202\t        simulation_runs, real_price_path, time_increment, vol_scoring_blocks\n203\t    )\n204\t    total_score = price_score + vol_score\n205\t\n206\t    # \"Overall\" holds the score actually returned and stays the last row.\n207\t    detailed_data = [\n208\t        row for row in detailed_crps_data if row[\"Interval\"] != \"Overall\"\n209\t    ]\n210\t    detailed_data += detailed_vol_data\n211\t    detailed_data.append(\n212\t        {\"Interval\": \"Overall\", \"Increment\": \"Total\", \"CRPS\": total_score}\n213\t    )\n214\t\n215\t    return total_score, detailed_data\n216\t\n217\t\n218\tdef sum_crps_over_blocks(\n219\t    simulated_changes: np.ndarray,\n220\t    real_changes: np.ndarray,\n221\t    data_blocks: np.ndarray,\n222\t    absolute_price: bool,\n223\t    real_price_path: np.ndarray,\n224\t) -> float:\n225\t    \"\"\"\n226\t    Sum the CRPS over the observed (non-missing) blocks of a single interval.\n227\t    \"\"\"\n228\t    crps_values = 0.0\n229\t    for block in np.unique(data_blocks):\n230\t        # skip missing value blocks\n231\t        if block == -1:\n232\t            continue\n233\t\n234\t        mask = data_blocks == block\n235\t        simulated_changes_block = simulated_changes[:, mask]\n236\t        real_changes_block = real_changes[0, mask]  # 1D array now\n237\t        num_intervals = simulated_changes_block.shape[1]\n238\t\n239\t        # Calculate all CRPS values at once\n240\t        crps_values_block = np.array(\n241\t            [\n242\t                crps_ensemble(\n243\t                    real_changes_block[t], simulated_changes_block[:, t]\n244\t                )\n245\t                for t in range(num_intervals)\n246\t            ]\n247\t        )\n248\t\n249\t        if absolute_price:\n250\t            crps_values_block = (\n251\t                crps_values_block / real_price_path[-1] * 10_000\n252\t            )\n253\t\n254\t        crps_values += float(crps_values_block.sum())\n255\t\n256\t    return float(crps_values)\n257\t\n258\t\n259\tdef label_observed_blocks(arr: np.ndarray) -> np.ndarray:\n260\t    \"\"\"\n261\t    Groups blocks of consecutive observed data together.\n262\t    Example input/output:\n263\t    [1.0, 2.0, np.nan, 4.0, np.nan, np.nan, 7.0, 8.0] -> [0, 0, -1, 1, -1, -1, 2, 2]\n264\t    \"\"\"\n265\t    not_nan = ~np.isnan(arr)\n266\t    block_start = not_nan & np.concatenate(([True], ~not_nan[:-1]))\n267\t    group_numbers = np.cumsum(block_start) - 1\n268\t    group_labels = np.where(not_nan, group_numbers, -1)\n269\t    return group_labels\n270\t\n271\t\n272\tdef calculate_price_changes_over_intervals(\n273\t    price_paths: np.ndarray,\n274\t    interval_steps: int,\n275\t    absolute_price=False,\n276\t    is_gap=False,\n277\t) -> np.ndarray:\n278\t    \"\"\"\n279\t    Calculate price changes over specified intervals.\n280\t\n281\t    Parameters:\n282\t        price_paths (numpy.ndarray): Array of simulated price paths.\n283\t        interval_steps (int): Number of steps that make up the interval.\n284\t        absolute_price (bool): If True, absolute price values (rather than price changes) are returned.\n285\t\n286\t    Returns:\n287\t        numpy.ndarray: Array of price changes over intervals.\n288\t    \"\"\"\n289\t    # Get the prices at the interval points\n290\t    # [1, 2, 3, 4, 5, 6, 7] -> [1, 3, 5, 7] if interval_steps is 2\n291\t    interval_prices = price_paths[:, ::interval_steps]\n292\t    if is_gap:\n293\t        # [1, 2, 3, 4, 5, 6, 7] -> [1, 3] if interval_steps is 2\n294\t        interval_prices = interval_prices[:, :2]\n295\t\n296\t    # Calculate price changes over intervals\n297\t    if absolute_price:\n298\t        return interval_prices[:, 1:]\n299\t\n300\t    return (\n301\t        np.diff(interval_prices, axis=1) / interval_prices[:, :-1]\n302\t    ) * 10_000\n303\t\n304\t\n305\tdef block_volatilities(\n306\t    price_paths: np.ndarray, block_steps: int\n307\t) -> np.ndarray:\n308\t    \"\"\"\n309\t    Calculate the volatility of each consecutive block of a price path.\n310\t\n311\t    Parameters:\n312\t        price_paths (numpy.ndarray): Array of price paths.\n313\t        block_steps (int): Number of steps that make up a block.\n314\t\n315\t    Returns:\n316\t        numpy.ndarray: Standard deviation, in basis points, of the step\n317\t        returns inside each block. A block with fewer than two observed\n318\t        returns is NaN so that it can be skipped; the steps left over after\n319\t        the last whole block are dropped.\n320\t    \"\"\"\n321\t    returns = (np.diff(price_paths, axis=1) / price_paths[:, :-1]) * 10_000\n322\t\n323\t    n_blocks = returns.shape[1] // block_steps\n324\t    blocks = returns[:, : n_blocks * block_steps].reshape(\n325\t        returns.shape[0], n_blocks, block_steps\n326\t    )\n327\t\n328\t    # Only the scorable blocks go through nanstd: it warns on a block with\n329\t    # fewer than two observed returns, which is the tolerated case here.\n330\t    scorable = np.sum(~np.isnan(blocks), axis=2) >= 2\n331\t    volatilities: np.ndarray = np.full(scorable.shape, np.nan)\n332\t    volatilities[scorable] = np.nanstd(blocks[scorable], axis=1, ddof=1)\n333\t\n334\t    return volatilities\n335\t"}]},"parent_tool_use_id":null,"session_id":"b5de06de-0f9b-444f-a451-a2a51a4613ad","uuid":"27bc2116-7a1c-4c33-b933-e7ee387eb54d","timestamp":"2026-11-11T13:14:29.747Z","tool_use_result":{"type":"text","file":{"filePath":"/workspace/.venv/lib/python3.12/site-packages/synth/validator/crps_calculation.py","content":"import numpy as np\nfrom properscoring import crps_ensemble\n\n\ndef get_interval_steps(scoring_interval: int, time_increment: int) -> int:\n    \"\"\"\n    Calculate the number of steps in the given scoring interval based on the time increment.\n    \"\"\"\n    return int(scoring_interval / time_increment)\n\n\ndef calculate_crps_for_miner(\n    simulation_runs: np.ndarray,\n    real_price_path: np.ndarray,\n    time_increment: int,\n    scoring_intervals: dict[str, int],\n) -> tuple[float, list[dict]]:\n    \"\"\"\n    Calculate the total CRPS score for a miner's simulations over specified intervals,\n    Return the sum of the scores.\n\n    Parameters:\n        simulation_runs (numpy.ndarray): Simulated price paths.\n        real_price_path (numpy.ndarray): The real price path.\n        time_increment (int): Time increment in seconds.\n        scoring_intervals (dict): Dictionary of scoring intervals with their names and durations in seconds.\n\n    Returns:\n        float: Sum of total CRPS scores over the intervals.\n    \"\"\"\n    # Initialize lists to store detailed CRPS data\n    detailed_crps_data: list[dict] = []\n    sum_all_scores = 0.0\n    gap_total_crps = 0.0\n\n    for interval_name, interval_seconds in scoring_intervals.items():\n        interval_steps = get_interval_steps(interval_seconds, time_increment)\n        absolute_price = interval_name.endswith(\"_abs\")\n        is_gap = interval_name.endswith(\"_gaps\")\n\n        # If we are considering absolute prices, adjust the interval steps for potential gaps:\n        # if only the initial price is present, then decrease the interval step\n        if absolute_price:\n            while (\n                real_price_path[::interval_steps].shape[0] == 1\n                and interval_steps > 1\n            ):\n                interval_steps -= 1\n\n        # Make sure there are no zero prices in the simulation runs because it will cause a division by zero error\n        if np.any(simulation_runs == 0):\n            return -1.0, [\n                {\"error\": \"Zero price encountered in simulation runs\"}\n            ]\n\n        # Calculate price changes over intervals\n        simulated_changes = calculate_price_changes_over_intervals(\n            simulation_runs,\n            interval_steps,\n            absolute_price,\n            is_gap,\n        )\n        real_changes = calculate_price_changes_over_intervals(\n            real_price_path.reshape(1, -1),\n            interval_steps,\n            absolute_price,\n            is_gap,\n        )\n        data_blocks = label_observed_blocks(real_changes[0])\n\n        # Not enough observed data -> continue\n        if len(data_blocks) == 0:\n            continue\n\n        # Calculate CRPS over intervals\n        crps_values = sum_crps_over_blocks(\n            simulated_changes,\n            real_changes,\n            data_blocks,\n            absolute_price,\n            real_price_path,\n        )\n\n        # Total CRPS for this interval\n        total_crps_interval = float(crps_values)\n        sum_all_scores += total_crps_interval\n        if is_gap:\n            # Individual *_gaps intervals are folded into the single \"Gaps\"\n            # Total appended below\n            gap_total_crps += total_crps_interval\n            continue\n\n        detailed_crps_data.append(\n            {\n                \"Interval\": interval_name,\n                \"Increment\": \"Total\",\n                \"CRPS\": total_crps_interval,\n            }\n        )\n\n    if gap_total_crps > 0:\n        detailed_crps_data.append(\n            {\"Interval\": \"Gaps\", \"Increment\": \"Total\", \"CRPS\": gap_total_crps}\n        )\n\n    detailed_crps_data.append(\n        {\"Interval\": \"Overall\", \"Increment\": \"Total\", \"CRPS\": sum_all_scores}\n    )\n\n    return sum_all_scores, detailed_crps_data\n\n\ndef calculate_vol_crps_for_miner(\n    simulation_runs: np.ndarray,\n    real_price_path: np.ndarray,\n    time_increment: int,\n    vol_scoring_blocks: dict[str, tuple[int, float]],\n) -> tuple[float, list[dict]]:\n    \"\"\"\n    Calculate the weighted volatility CRPS for a miner's simulations.\n\n    The path is cut into consecutive blocks of each configured size, the\n    realized volatility of every block is scored against the ensemble of\n    simulated block volatilities, and the per-block CRPS values are summed\n    and scaled by that block size's weight.\n\n    Parameters:\n        simulation_runs (numpy.ndarray): Simulated price paths.\n        real_price_path (numpy.ndarray): The real price path.\n        time_increment (int): Time increment in seconds.\n        vol_scoring_blocks (dict): Dictionary of block sizes with their names,\n            durations in seconds and weights.\n\n    Returns:\n        float: Sum of the weighted volatility CRPS over the block sizes.\n    \"\"\"\n    detailed_crps_data: list[dict] = []\n    sum_all_scores = 0.0\n\n    for name, (block_seconds, weight) in vol_scoring_blocks.items():\n        block_steps = get_interval_steps(block_seconds, time_increment)\n\n        simulated_vol = block_volatilities(simulation_runs, block_steps)\n        real_vol = block_volatilities(\n            real_price_path.reshape(1, -1), block_steps\n        )[0]\n        observed_blocks = np.flatnonzero(~np.isnan(real_vol))\n\n        # Not enough observed data -> continue\n        if observed_blocks.size == 0:\n            continue\n\n        crps_sum = float(\n            sum(\n                crps_ensemble(real_vol[block], simulated_vol[:, block])\n                for block in observed_blocks\n            )\n        )\n        sum_all_scores += weight * crps_sum\n\n        detailed_crps_data.append(\n            {\n                \"Interval\": name,\n                \"Increment\": \"Total\",\n                \"CRPS\": crps_sum,\n                \"Weight\": weight,\n            }\n        )\n\n    detailed_crps_data.append(\n        {\"Interval\": \"Vol\", \"Increment\": \"Total\", \"CRPS\": sum_all_scores}\n    )\n\n    return sum_all_scores, detailed_crps_data\n\n\ndef calculate_total_score_for_miner(\n    simulation_runs: np.ndarray,\n    real_price_path: np.ndarray,\n    time_increment: int,\n    scoring_intervals: dict[str, int],\n    vol_scoring_blocks: dict[str, tuple[int, float]],\n) -> tuple[float, list[dict]]:\n    \"\"\"\n    Calculate a miner's total score: the price CRPS plus the weighted\n    volatility CRPS. A competition with no volatility blocks scores on the\n    price CRPS alone.\n\n    Returns:\n        float: The total score.\n    \"\"\"\n    price_score, detailed_crps_data = calculate_crps_for_miner(\n        simulation_runs, real_price_path, time_increment, scoring_intervals\n    )\n\n    # -1 is the rejection sentinel of the price pass, which also owns the\n    # zero-price guard the volatility blocks depend on: never add to it.\n    if not vol_scoring_blocks or price_score == -1.0:\n        return price_score, detailed_crps_data\n\n    vol_score, detailed_vol_data = calculate_vol_crps_for_miner(\n        simulation_runs, real_price_path, time_increment, vol_scoring_blocks\n    )\n    total_score = price_score + vol_score\n\n    # \"Overall\" holds the score actually returned and stays the last row.\n    detailed_data = [\n        row for row in detailed_crps_data if row[\"Interval\"] != \"Overall\"\n    ]\n    detailed_data += detailed_vol_data\n    detailed_data.append(\n        {\"Interval\": \"Overall\", \"Increment\": \"Total\", \"CRPS\": total_score}\n    )\n\n    return total_score, detailed_data\n\n\ndef sum_crps_over_blocks(\n    simulated_changes: np.ndarray,\n    real_changes: np.ndarray,\n    data_blocks: np.ndarray,\n    absolute_price: bool,\n    real_price_path: np.ndarray,\n) -> float:\n    \"\"\"\n    Sum the CRPS over the observed (non-missing) blocks of a single interval.\n    \"\"\"\n    crps_values = 0.0\n    for block in np.unique(data_blocks):\n        # skip missing value blocks\n        if block == -1:\n            continue\n\n        mask = data_blocks == block\n        simulated_changes_block = simulated_changes[:, mask]\n        real_changes_block = real_changes[0, mask]  # 1D array now\n        num_intervals = simulated_changes_block.shape[1]\n\n        # Calculate all CRPS values at once\n        crps_values_block = np.array(\n            [\n                crps_ensemble(\n                    real_changes_block[t], simulated_changes_block[:, t]\n                )\n                for t in range(num_intervals)\n            ]\n        )\n\n        if absolute_price:\n            crps_values_block = (\n                crps_values_block / real_price_path[-1] * 10_000\n            )\n\n        crps_values += float(crps_values_block.sum())\n\n    return float(crps_values)\n\n\ndef label_observed_blocks(arr: np.ndarray) -> np.ndarray:\n    \"\"\"\n    Groups blocks of consecutive observed data together.\n    Example input/output:\n    [1.0, 2.0, np.nan, 4.0, np.nan, np.nan, 7.0, 8.0] -> [0, 0, -1, 1, -1, -1, 2, 2]\n    \"\"\"\n    not_nan = ~np.isnan(arr)\n    block_start = not_nan & np.concatenate(([True], ~not_nan[:-1]))\n    group_numbers = np.cumsum(block_start) - 1\n    group_labels = np.where(not_nan, group_numbers, -1)\n    return group_labels\n\n\ndef calculate_price_changes_over_intervals(\n    price_paths: np.ndarray,\n    interval_steps: int,\n    absolute_price=False,\n    is_gap=False,\n) -> np.ndarray:\n    \"\"\"\n    Calculate price changes over specified intervals.\n\n    Parameters:\n        price_paths (numpy.ndarray): Array of simulated price paths.\n        interval_steps (int): Number of steps that make up the interval.\n        absolute_price (bool): If True, absolute price values (rather than price changes) are returned.\n\n    Returns:\n        numpy.ndarray: Array of price changes over intervals.\n    \"\"\"\n    # Get the prices at the interval points\n    # [1, 2, 3, 4, 5, 6, 7] -> [1, 3, 5, 7] if interval_steps is 2\n    interval_prices = price_paths[:, ::interval_steps]\n    if is_gap:\n        # [1, 2, 3, 4, 5, 6, 7] -> [1, 3] if interval_steps is 2\n        interval_prices = interval_prices[:, :2]\n\n    # Calculate price changes over intervals\n    if absolute_price:\n        return interval_prices[:, 1:]\n\n    return (\n        np.diff(interval_prices, axis=1) / interval_prices[:, :-1]\n    ) * 10_000\n\n\ndef block_volatilities(\n    price_paths: np.ndarray, block_steps: int\n) -> np.ndarray:\n    \"\"\"\n    Calculate the volatility of each consecutive block of a price path.\n\n    Parameters:\n        price_paths (numpy.ndarray): Array of price paths.\n        block_steps (int): Number of steps that make up a block.\n\n    Returns:\n        numpy.ndarray: Standard deviation, in basis points, of the step\n        returns inside each block. A block with fewer than two observed\n        returns is NaN so that it can be skipped; the steps left over after\n        the last whole block are dropped.\n    \"\"\"\n    returns = (np.diff(price_paths, axis=1) / price_paths[:, :-1]) * 10_000\n\n    n_blocks = returns.shape[1] // block_steps\n    blocks = returns[:, : n_blocks * block_steps].reshape(\n        returns.shape[0], n_blocks, block_steps\n    )\n\n    # Only the scorable blocks go through nanstd: it warns on a block with\n    # fewer than two observed returns, which is the tolerated case here.\n    scorable = np.sum(~np.isnan(blocks), axis=2) >= 2\n    volatilities: np.ndarray = np.full(scorable.shape, np.nan)\n    volatilities[scorable] = np.nanstd(blocks[scorable], axis=1, ddof=1)\n\n    return volatilities\n","numLines":335,"startLine":1,"totalLines":335}},"tool_result_meta":[{"id":"toolu_01JsZMz4bM1UWd5fhbfCHnTc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
