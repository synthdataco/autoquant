# Local campaign machinery — never published
market_data/
offline_data/
campaign_runs/
champions/
metering/.env.proxy
.env

# Python / tooling
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
*.egg-info/

# An unpacked champion is a working tree, and a scratch file the agent left behind travels with it.
# These are noise in a published leg, not part of the model.
campaign_results/**/*.tmp
campaign_results/**/journal.md}*
campaign_results/**/tmp/

# OS
.DS_Store

# Verdict score frames: regenerated by every verdict run, ~50 MB per leg per window. The champion
# artifacts under campaign_results/**/results/ are tracked and must not be caught by these.
campaign_results/**/prompt_scores_*.parquet
campaign_results/**/field_rewards_*.parquet
campaign_results/**/live_rewards_*.parquet
